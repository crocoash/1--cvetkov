////////////////////////////////////////////////////////////////////////////////
// Вебхук Telegram: нажатия кнопок прилетают сюда сами, без опроса регламентом.
//
// Адрес после публикации базы на веб-сервере:
//   https://<хост>/<имя базы>/hs/tg/hook
//
// Включается на стороне Telegram вызовом setWebhook у бота 1С. ВАЖНО: вебхук
// и getUpdates взаимоисключающи - как только вебхук установлен, регламент
// ТелеграмОбмен нажатий больше не увидит (getUpdates начнёт отвечать 409
// Conflict). Сам регламент при этом остаётся нужен: очередь смен статуса
// и досылка отложенных с ночи уведомлений живут в нём.
//
// Пока вебхук не установлен, этот сервис просто никем не вызывается,
// и всё работает по-старому.
//
// Защита: Telegram шлёт заголовок X-Telegram-Bot-Api-Secret-Token со значением,
// которое задано при setWebhook. Сверяем его с ТелеграмБот.СекретВебхука().
// Без совпадения - 403 и ни строчки разбора: наружу торчит база, и пускать
// в неё кого попало нельзя.
//
// Отвечаем 200 на всё, что прошло проверку секрета, даже если разбор упал:
// на любой другой код Telegram будет слать это же обновление снова и снова.
////////////////////////////////////////////////////////////////////////////////

// Обработчик POST /hs/tg/hook.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - тело с JSON одного обновления Telegram.
//
// Возвращаемое значение:
//  HTTPСервисОтвет
//
Функция Принять(Запрос) Экспорт

	// Тело читаем РОВНО ОДИН раз: повторный ПолучитьТелоКакСтроку по уже
	// вычитанному потоку возвращает пустое значение, а то и исключение.
	ТелоЗапроса = "";

	Попытка
		ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		ТелоЗапроса = "";
	КонецПопытки;

	// Команды с сайта приходят СЮДА ЖЕ, а не на свой адрес. Отдельный шаблон
	// /cmd платформа знала (на несуществующий путь она отвечает 404, а на /cmd
	// отвечала 403), но обработчик не вызывала НИ РАЗУ: в журнале регистрации
	// не появилось ни одной записи "Телеграм.Команда", тогда как соседний /hook
	// на те же самые запросы честно писал "Запрос без правильного секрета
	// отклонён". Чем именно платформе не угодил новый шаблон, выяснить не вышло;
	// разбираться дальше дороже, чем не заводить второй адрес - этот
	// опубликован, работает и уже принимает POST с JSON.
	//
	// Перепутать потоки нельзя: у Telegram свой секрет в своём заголовке,
	// у сайта - свой токен (ТелеграмБот.ТокенСайта). Проверяем сайт первым,
	// потому что его признак строже: заголовок X-Site-Token либо поле token.
	Если ЭтоКомандаСайта(Запрос, ТелоЗапроса) Тогда
		Возврат ВыполнитьКоманду(ТелоЗапроса);
	КонецЕсли;

	Если Не СекретСовпадает(Запрос) Тогда

		ЗаписьЖурналаРегистрации("Телеграм.Вебхук",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Запрос без правильного секрета отклонён.");

		Возврат Новый HTTPСервисОтвет(403);

	КонецЕсли;

	Попытка

		ТелеграмБот.ПринятьОбновление(ТелоЗапроса);

	Исключение

		// Ошибку глотаем сознательно: ответь мы не 200 - Telegram начнёт
		// повторять это обновление, и одна кривая посылка встанет пробкой
		// перед всеми следующими. Разбираться идём в журнал.
		ЗаписьЖурналаРегистрации("Телеграм.Вебхук",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Не удалось разобрать обновление: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

	КонецПопытки;

	Возврат Новый HTTPСервисОтвет(200);

КонецФункции

// Пришла ли команда с сайта: токен в заголовке X-Site-Token либо полем token
// в теле. Два пути равноправны, достаточно одного - заголовки до сервиса
// доходят не всегда (веб-сервер, прокси, настройки публикации), а поймать это
// снаружи нечем: отказ выглядит одинаково.
Функция ЭтоКомандаСайта(Запрос, Знач ТелоЗапроса)

	Ожидаемый = ТелеграмБот.ТокенСайта();

	Если ПустаяСтрока(Ожидаемый) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Заголовок Из Запрос.Заголовки Цикл

		Если НРег(СокрЛП(Строка(Заголовок.Ключ))) = "x-site-token"
			И СокрЛП(Строка(Заголовок.Значение)) = Ожидаемый Тогда

			Возврат Истина;

		КонецЕсли;

	КонецЦикла;

	ИзТела = "";
	РазобратьТело(ТелоЗапроса).Свойство("token", ИзТела);

	Возврат СокрЛП(Строка(ИзТела)) = Ожидаемый;

КонецФункции

// Команда с сайта (админка, вкладка «Уведомления 1С»).
// Токен уже проверен в ЭтоКомандаСайта - сюда попадают только свои.
//
// Тело - JSON: {"action":"resend","order":"00000027660"}, {"action":"clearchat"},
// {"action":"resendall"} либо {"action":"ping"}.
//
// Особняком стоит {"action":"ttn"} - запись номера накладной в заказ, см.
// ЗаписатьНомераТТН. Это единственная команда, которая МЕНЯЕТ документ, поэтому
// разбор ошибок у неё построчный: пачку из двадцати номеров нельзя ронять
// целиком из-за одного ненайденного заказа.
//
// Чтение данных базы - {"action":"query","q":"ВЫБРАТЬ ..."} и справка по
// метаданным {"action":"meta","object":"Документ.ЗаказПокупателя"}; работу
// делает общий модуль ЧтениеДанныхБазы, там же разобрано, почему текст запроса
// произвольный.
//
// Изменение справочников - {"action":"edit","catalog":"Справочник.Склады",
// "items":[…]}, модуль ИзменениеСправочников. Без "apply":true работает
// в режиме проверки и не пишет ничего.
//
// Сигнал об онлайн-оплате - {"action":"pay","ref":"32797_1787049453_adv",
// "order":"32797"}: сайт узнаёт о платеже раньше 1С и просит не ждать
// расписания регламента. Работа уходит в фон, ответ отдаётся сразу.
//
// Заметка в комментарий заказа - {"action":"note","order":"32862",
// "text":"Клієнт просив передзвонити"}: экран выбора оплаты на сайте, клиент
// вместо оплаты попросил связаться с менеджером. Вторая после ttn команда,
// которая МЕНЯЕТ документ; сама запись - в БИАС, тоже фоном.
//
// Данные получателя от клиента - {"action":"delivery","order":"32975",
// "name":"…","phone":"…","city_ref":"…","wh_ref":"…"}: клиент заполнил форму
// на странице сайта вместо того, чтобы писать ПІБ и отделение текстом
// в мессенджер. Третья команда, которая МЕНЯЕТ документ.
//
// Параметры:
//  ТелоЗапроса - Строка - уже вычитанное тело.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - JSON с полем ok.
//
Функция ВыполнитьКоманду(Знач ТелоЗапроса)

	Данные = РазобратьТело(ТелоЗапроса);

	Действие = "";
	Данные.Свойство("action", Действие);
	Действие = НРег(СокрЛП(Строка(Действие)));

	// Проверка связи. Заодно отвечает на вопрос, ради которого иначе пришлось бы
	// лезть в базу руками: крутится ли регламент ТелеграмОбмен и когда он
	// отрабатывал в последний раз.
	Если Действие = "ping" Тогда
		Возврат ОтветJSON(200, СостояниеБазы());
	КонецЕсли;

	Если Действие = "resend" Тогда

		Номер = "";
		Данные.Свойство("order", Номер);

		Попытка
			Возврат ОтветJSON(200, ВернутьКарточку(Номер));
		Исключение
			ЗаписьЖурналаРегистрации("Телеграм.Команда",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось вернуть карточку заказа " + Строка(Номер) + ": "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь,
				"Ошибка в 1С, смотрите журнал регистрации, событие ""Телеграм.Команда""."));
		КонецПопытки;

	КонецЕсли;

	// Очистить чат: удалить из Telegram все живые сообщения бота разом.
	// Карточки заказов в работе регламент потом пришлёт заново свежими.
	Если Действие = "clearchat" Тогда

		Попытка

			Итог = ТелеграмБот.УбратьВсеСообщения();

			Ответ = Новый Структура;
			Ответ.Вставить("ok",      Итог.Успех);
			Ответ.Вставить("total",   Итог.Всего);
			Ответ.Вставить("deleted", Итог.Удалено);
			Ответ.Вставить("error",   Итог.Ошибка);

			Возврат ОтветJSON(200, Ответ);

		Исключение

			ЗаписьЖурналаРегистрации("Телеграм.Команда",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось очистить чат: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь,
				"Ошибка в 1С, смотрите журнал регистрации, событие ""Телеграм.Команда""."));

		КонецПопытки;

	КонецЕсли;

	// Перезалить чат: убрать всё и сразу отправить свежие карточки
	// по всем заказам в работе.
	Если Действие = "resendall" Тогда

		Попытка

			Итог = ТелеграмБот.ПерезалитьВсеКарточки();

			Ответ = Новый Структура;
			Ответ.Вставить("ok",      Итог.Успех);
			Ответ.Вставить("deleted", Итог.Убрано);
			Ответ.Вставить("sent",    Итог.Отправлено);
			Ответ.Вставить("error",   Итог.Ошибка);

			Возврат ОтветJSON(200, Ответ);

		Исключение

			ЗаписьЖурналаРегистрации("Телеграм.Команда",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось перезалить карточки: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь,
				"Ошибка в 1С, смотрите журнал регистрации, событие ""Телеграм.Команда""."));

		КонецПопытки;

	КонецЕсли;

	// Номера накладных от дропшиперов. Сайт разобрал сообщения вида
	// «032637, ТТН 20451512064046» и передал сюда парами; пишем их в
	// ЗаказПокупателя.НомерТТН. Обратно на сайт накладная уедет сама ближайшей
	// выгрузкой заказов (БИАС, тег delivery_post_code -> order_declaration) -
	// поле на сайте сайт заполняет и у себя, чтобы не ждать обмена.
	Если Действие = "ttn" Тогда

		Попытка

			Возврат ОтветJSON(200, ЗаписатьНомераТТН(Данные));

		Исключение

			ЗаписьЖурналаРегистрации("Сайт.ТТН",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось записать номера накладных: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь,
				"Ошибка в 1С, смотрите журнал регистрации, событие ""Сайт.ТТН""."));

		КонецПопытки;

	КонецЕсли;

	// Чтение данных базы запросом. Стоит особняком от остальных команд тем, что
	// текст ошибки уходит наружу как есть: почти всегда это синтаксическая
	// ошибка в самом запросе, и она нужна тому, кто его писал. Изменить данные
	// этим путём нельзя - в языке запросов нет ни INSERT, ни UPDATE
	// (разбор - в шапке общего модуля ЧтениеДанныхБазы).
	Если Действие = "query" Тогда

		Попытка

			Возврат ОтветJSON(200, ЧтениеДанныхБазы.ВыполнитьЗапрос(Данные));

		Исключение

			ЗаписьЖурналаРегистрации("База.Запрос",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось выполнить запрос: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь, ОписаниеОшибки()));

		КонецПопытки;

	КонецЕсли;

	// Справка по метаданным: имена таблиц, полей, значения перечислений.
	Если Действие = "meta" Тогда

		Попытка

			Возврат ОтветJSON(200, ЧтениеДанныхБазы.ОписаниеМетаданных(Данные));

		Исключение

			ЗаписьЖурналаРегистрации("База.Запрос",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось получить описание метаданных: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь, ОписаниеОшибки()));

		КонецПопытки;

	КонецЕсли;

	// Изменение справочников. Вторая после ttn команда, которая МОЖЕТ менять
	// данные, - и единственная, у которой есть режим проверки: без apply = true
	// она ничего не пишет, а показывает «было -> станет». Документы и регистры
	// ей недоступны намеренно, разбор - в шапке ИзменениеСправочников.
	Если Действие = "edit" Тогда

		Попытка

			Возврат ОтветJSON(200, ИзменениеСправочников.Изменить(Данные));

		Исключение

			ЗаписьЖурналаРегистрации("База.Запись",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось изменить справочник: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь, ОписаниеОшибки()));

		КонецПопытки;

	КонецЕсли;

	// Сигнал сайта: по заказу прошла онлайн-оплата (WayForPay, Approved).
	// Регламент «Загрузка Приват24» ходит за выпиской по расписанию, и оплата
	// до его следующего захода лежала бы непринятой — здесь запускаем ту же
	// работу немедленно. Ответ отдаётся сразу, до её окончания: это callback
	// WayForPay, держать его нельзя — он начнёт ретраиться.
	Если Действие = "pay" Тогда

		Реф   = "";
		Номер = "";

		Данные.Свойство("ref"  , Реф);
		Данные.Свойство("order", Номер);

		Попытка

			Состояние =
				БИАС.ЗапуститьПриемОплатыПоСигналуСайта(
					СокрЛП(Строка(Реф)));

			Ответ = Новый Структура;
			Ответ.Вставить("ok"    , Состояние <> "error");
			Ответ.Вставить("status", Состояние);
			Ответ.Вставить("ref"   , СокрЛП(Строка(Реф)));
			Ответ.Вставить("order" , СокрЛП(Строка(Номер)));

			Возврат ОтветJSON(200, Ответ);

		Исключение

			ЗаписьЖурналаРегистрации("Сайт.Оплата",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось принять сигнал об оплате (ref " + Лев(СокрЛП(Строка(Реф)), 100) + "): "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь,
				"Ошибка в 1С, смотрите журнал регистрации, событие ""Сайт.Оплата""."));

		КонецПопытки;

	КонецЕсли;

	// Заметка в комментарий заказа. Заказ создан секунды назад и в 1С мог ещё
	// не приехать, поэтому ищет его и дописывает строку фоновое задание, а не
	// этот вызов: клиент ждёт ответа в открытом окне браузера.
	Если Действие = "note" Тогда

		Номер = "";
		Текст = "";

		Данные.Свойство("order", Номер);
		Данные.Свойство("text" , Текст);

		Номер = СокрЛП(Строка(Номер));
		// Комментарий заказа - строка неограниченной длины, но канал наружу:
		// длинный текст в нём нужен не больше, чем в карточке менеджера.
		Текст = Лев(СокрЛП(Строка(Текст)), 300);

		Если ПустаяСтрока(Номер) Или ПустаяСтрока(Текст) Тогда
			Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь,
				"не передан номер заказа или текст заметки"));
		КонецЕсли;

		Попытка

			Состояние = БИАС.ЗапуститьЗаписьЗаметкиВЗаказ(Номер, Текст);

			Ответ = Новый Структура;
			Ответ.Вставить("ok"    , Состояние <> "error");
			Ответ.Вставить("status", Состояние);
			Ответ.Вставить("order" , Номер);

			Возврат ОтветJSON(200, Ответ);

		Исключение

			ЗаписьЖурналаРегистрации("Сайт.Заметка",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось принять заметку для заказа № " + Лев(Номер, 20) + ": "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь,
				"Ошибка в 1С, смотрите журнал регистрации, событие ""Сайт.Заметка""."));

		КонецПопытки;

	КонецЕсли;

	// Данные получателя, которые клиент заполнил сам на странице сайта
	// (assets/shop/delivery.php - ссылка вместо просьбы «пришлите ПІБ, телефон,
	// місто та відділення» текстом). Пишем в заказ: Получатель, телефон, город
	// и отделение Новой Почты. Город и отделение приходят ГУИДами Новой Почты -
	// теми же, что лежат в ЛМ_Города.ГУИД и ЛМ_Отделения.ГУИД, поэтому ссылки
	// ищем по ним, а не по названию.
	Если Действие = "delivery" Тогда

		Попытка

			Возврат ОтветJSON(200, ЗаписатьДанныеДоставки(Данные));

		Исключение

			ЗаписьЖурналаРегистрации("Сайт.Доставка",
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Не удалось записать данные получателя: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь,
				"Ошибка в 1С, смотрите журнал регистрации, событие ""Сайт.Доставка""."));

		КонецПопытки;

	КонецЕсли;

	Возврат ОтветJSON(200, Новый Структура("ok, error", Ложь,
		"bad action: " + Лев(Действие, 40)));

КонецФункции

// Записать номера накладных в заказы.
//
// Тело команды - одна пара либо пачка:
//   {"action":"ttn","order":"32637","ttn":"20451512064046"}
//   {"action":"ttn","dry":true,"items":[{"order":"32637","order1c":"00000027660",
//                                        "ttn":"20451512064046","force":true}]}
//
// Поля строки:
//  order   - номер заказа НА САЙТЕ (ЗаказПокупателя.НомерЗаказа2ССайта), как в
//            сообщении: с ведущими нулями или без;
//  order1c - номер документа 1С, если сайт его знает (колонка order_id_1c).
//            Ищем сначала по нему: нумераторы у сайта и 1С разные и в принципе
//            могут дать одинаковое число на разных заказах;
//  ttn     - номер накладной; всё, кроме цифр, отбрасываем;
//  force   - разрешение перезаписать НЕПУСТУЮ накладную. Без него заказ с уже
//            заполненной ТТН не трогаем: чаще это повторно пересланное
//            сообщение, а не исправление, и молча затирать чужой номер нельзя.
//
// dry на уровне команды - ничего не писать, только найти заказы. Этим сайт
// рисует предпросмотр: клиент, статус, дата, какая накладная стоит сейчас.
//
// Пачку не роняем целиком: у каждой строки свой ok/error, вызывающая сторона
// показывает их построчно. Иначе один ненайденный заказ отменял бы двадцать
// нормальных.
//
// Параметры:
//  Данные - Структура - разобранное тело команды.
//
// Возвращаемое значение:
//  Структура - ok, dry, saved, items (Массив структур по строкам).
//
Функция ЗаписатьНомераТТН(Знач Данные)

	// Пользователь публикации базы - не менеджер, прав на запись заказа у него
	// может не быть вовсе. Канал защищён общим токеном (ЭтоКомандаСайта), это
	// и есть проверка «свой - чужой»; ролями её не дублируем.
	УстановитьПривилегированныйРежим(Истина);

	ТолькоПроверка = Ложь;
	Данные.Свойство("dry", ТолькоПроверка);
	ТолькоПроверка = (ТолькоПроверка = Истина);

	Строки = Неопределено;
	Данные.Свойство("items", Строки);

	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Строки = Новый Массив;
		Строки.Добавить(Данные);
	КонецЕсли;

	Результаты = Новый Массив;
	Записано   = 0;

	Для Каждого СтрокаКоманды Из Строки Цикл

		Если ТипЗнч(СтрокаКоманды) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		// Потолок на пачку. Столько накладных за раз руками не приходит,
		// а случайный кривой вызов не должен перебирать документы часами.
		Если Результаты.Количество() >= 100 Тогда
			Прервать;
		КонецЕсли;

		Итог = ЗаписатьТТНПоЗаказу(СтрокаКоманды, ТолькоПроверка);

		Если Итог.changed Тогда
			Записано = Записано + 1;
		КонецЕсли;

		Результаты.Добавить(Итог);

	КонецЦикла;

	Ответ = Новый Структура;
	Ответ.Вставить("ok",    Истина);
	Ответ.Вставить("dry",   ТолькоПроверка);
	Ответ.Вставить("saved", Записано);
	Ответ.Вставить("items", Результаты);

	Возврат Ответ;

КонецФункции

// Одна строка команды ttn: найти заказ и записать ему номер накладной.
//
// Параметры:
//  СтрокаКоманды  - Структура - order, order1c, ttn, force.
//  ТолькоПроверка - Булево    - найти заказ, но ничего не писать.
//
// Возвращаемое значение:
//  Структура - ok, changed, error/note и данные найденного заказа.
//
Функция ЗаписатьТТНПоЗаказу(Знач СтрокаКоманды, Знач ТолькоПроверка)

	Итог = Новый Структура;
	Итог.Вставить("ok",      Ложь);
	Итог.Вставить("changed", Ложь);

	НомерСайта = "";
	СтрокаКоманды.Свойство("order", НомерСайта);
	НомерСайта = СокрЛП(Строка(НомерСайта));

	Номер1С = "";
	СтрокаКоманды.Свойство("order1c", Номер1С);
	Номер1С = СокрЛП(Строка(Номер1С));

	ТТН = "";
	СтрокаКоманды.Свойство("ttn", ТТН);
	ТТН = ТолькоЦифры(Строка(ТТН));

	Перезаписывать = Ложь;
	СтрокаКоманды.Свойство("force", Перезаписывать);
	Перезаписывать = (Перезаписывать = Истина);

	Итог.Вставить("order", НомерСайта);
	Итог.Вставить("ttn",   ТТН);

	Если ПустаяСтрока(НомерСайта) И ПустаяСтрока(Номер1С) Тогда
		Итог.Вставить("error", "не передан номер заказа");
		Возврат Итог;
	КонецЕсли;

	// Реквизит - строка(30). Платформа обрезала бы длинный номер МОЛЧА, и на
	// сайт уехала бы покалеченная накладная, поэтому отказываем явно.
	Если СтрДлина(ТТН) > 30 Тогда
		Итог.Вставить("error", "номер накладной длиннее 30 символов");
		Возврат Итог;
	КонецЕсли;

	Заказ = НайтиЗаказПоНомерам(НомерСайта, Номер1С);

	Если Заказ = Неопределено Тогда
		Итог.Вставить("error", "заказ № "
			+ ?(ПустаяСтрока(НомерСайта), Номер1С, НомерСайта) + " в 1С не найден");
		Возврат Итог;
	КонецЕсли;

	Итог.Вставить("order1c", СокрЛП(Строка(Заказ.Номер)));
	Итог.Вставить("site",    СокрЛП(Строка(Заказ.НомерЗаказа2ССайта)));
	Итог.Вставить("client",  СокрЛП(Строка(Заказ.Контрагент)));
	Итог.Вставить("status",  СокрЛП(Строка(Заказ.СтатусЗаказа)));
	Итог.Вставить("date",    Формат(Заказ.Дата, "ДФ='yyyy-MM-dd HH:mm'"));

	Было = СокрЛП(Заказ.НомерТТН);
	Итог.Вставить("was", Было);

	Если ТолькоПроверка Тогда
		Итог.Вставить("ok", Истина);
		Возврат Итог;
	КонецЕсли;

	Если ПустаяСтрока(ТТН) Тогда
		Итог.Вставить("error", "пустой номер накладной");
		Возврат Итог;
	КонецЕсли;

	// Повторно пересланное сообщение - не ошибка и не повод трогать документ.
	Если Было = ТТН Тогда
		Итог.Вставить("ok",   Истина);
		Итог.Вставить("note", "накладная уже записана");
		Возврат Итог;
	КонецЕсли;

	Если Не ПустаяСтрока(Было) И Не Перезаписывать Тогда
		Итог.Вставить("error", "в заказе уже стоит накладная " + Было
			+ " - перезапись не подтверждена");
		Возврат Итог;
	КонецЕсли;

	Попытка

		Объект = Заказ.ПолучитьОбъект();

		Если Объект = Неопределено Тогда
			Итог.Вставить("error", "заказ удалён из базы");
			Возврат Итог;
		КонецЕсли;

		Объект.НомерТТН = ТТН;
		Объект.Записать();

	Исключение

		ЗаписьЖурналаРегистрации("Сайт.ТТН",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЗаказПокупателя, Заказ,
			"Номер накладной " + ТТН + " не записан: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		Итог.Вставить("error", "заказ не записан: " + ОписаниеОшибки());
		Возврат Итог;

	КонецПопытки;

	ЗаписьЖурналаРегистрации("Сайт.ТТН",
		УровеньЖурналаРегистрации.Информация,
		Метаданные.Документы.ЗаказПокупателя, Заказ,
		"Номер накладной "
		+ ?(ПустаяСтрока(Было), "записан: " + ТТН, "изменён с " + Было + " на " + ТТН)
		+ " (команда с сайта).");

	Итог.Вставить("ok",      Истина);
	Итог.Вставить("changed", Истина);

	Возврат Итог;

КонецФункции

// Записать в заказ данные получателя, заполненные клиентом на сайте.
//
// Тело команды:
//   {"action":"delivery","order":"32975","order1c":"00000027985",
//    "name":"Світлана Антоненко","phone":"0501675723",
//    "city_ref":"e718a680-…","city_name":"Харків",
//    "wh_ref":"1ec09d88-…","wh_name":"Відділення № 1: вул. Гагаріна, 1",
//    "dry":true}
//
// dry - только найти заказ и показать, что стоит сейчас; ничего не пишем.
//
// Имя и телефон пишем всегда, когда переданы: клиент мог поправить их на
// странице. Город и отделение - только парой: отделение без города в заказе
// бессмысленно, накладную по нему не создать.
//
// Реквизиты-представления - строка(128), ТелефонКонтрагента - строка(200).
// Платформа обрезала бы длинное значение МОЛЧА, поэтому длину проверяем сами
// и отказываем явно (как в ttn).
//
// Параметры:
//  Данные - Структура - тело команды.
//
// Возвращаемое значение:
//  Структура - ok, changed, error/note и данные найденного заказа.
//
Функция ЗаписатьДанныеДоставки(Знач Данные)

	// Пользователь публикации базы - не менеджер, прав на чтение и запись
	// заказа у него может не быть вовсе: без этого падало уже на Заказ.Номер
	// («Нарушение прав доступа», заказ 033015, 02.09.2026), и клиент видел
	// «Не вдалося зберегти дані». Канал защищён общим токеном (ЭтоКомандаСайта),
	// это и есть проверка «свой - чужой» - так же, как в ЗаписатьНомераТТН.
	УстановитьПривилегированныйРежим(Истина);

	Итог = Новый Структура;
	Итог.Вставить("ok",      Ложь);
	Итог.Вставить("changed", Ложь);

	НомерСайта = "";
	Данные.Свойство("order", НомерСайта);
	НомерСайта = СокрЛП(Строка(НомерСайта));

	Номер1С = "";
	Данные.Свойство("order1c", Номер1С);
	Номер1С = СокрЛП(Строка(Номер1С));

	ТолькоПроверка = Ложь;
	Данные.Свойство("dry", ТолькоПроверка);
	ТолькоПроверка = (ТолькоПроверка = Истина);

	Имя = "";
	Данные.Свойство("name", Имя);
	Имя = СокрЛП(Строка(Имя));

	Телефон = "";
	Данные.Свойство("phone", Телефон);
	Телефон = СокрЛП(Строка(Телефон));

	ГуидГорода = "";
	Данные.Свойство("city_ref", ГуидГорода);
	ГуидГорода = НРег(СокрЛП(Строка(ГуидГорода)));

	ИмяГорода = "";
	Данные.Свойство("city_name", ИмяГорода);
	ИмяГорода = СокрЛП(Строка(ИмяГорода));

	ГуидОтделения = "";
	Данные.Свойство("wh_ref", ГуидОтделения);
	ГуидОтделения = НРег(СокрЛП(Строка(ГуидОтделения)));

	ИмяОтделения = "";
	Данные.Свойство("wh_name", ИмяОтделения);
	ИмяОтделения = СокрЛП(Строка(ИмяОтделения));

	Итог.Вставить("order", НомерСайта);

	Если ПустаяСтрока(НомерСайта) И ПустаяСтрока(Номер1С) Тогда
		Итог.Вставить("error", "не передан номер заказа");
		Возврат Итог;
	КонецЕсли;

	Если СтрДлина(Телефон) > 200
		Или СтрДлина(ИмяГорода) > 128
		Или СтрДлина(ИмяОтделения) > 128 Тогда

		Итог.Вставить("error", "значение длиннее реквизита - записывать не стали");
		Возврат Итог;

	КонецЕсли;

	Заказ = НайтиЗаказПоНомерам(НомерСайта, Номер1С);

	Если Заказ = Неопределено Тогда
		Итог.Вставить("error", "заказ № "
			+ ?(ПустаяСтрока(НомерСайта), Номер1С, НомерСайта) + " в 1С не найден");
		Возврат Итог;
	КонецЕсли;

	Итог.Вставить("order1c", СокрЛП(Строка(Заказ.Номер)));
	Итог.Вставить("site",    СокрЛП(Строка(Заказ.НомерЗаказа2ССайта)));
	Итог.Вставить("was", СокрЛП(Заказ.Получатель) + " | "
		+ СокрЛП(Заказ.ТелефонКонтрагента) + " | "
		+ СокрЛП(Заказ.ГородНовойПочтыПредставление) + " | "
		+ СокрЛП(Заказ.СкладНовойПочтыПредставление));

	// Что стоит в заказе сейчас, полями. Этим форма /dostavka на сайте
	// показывает клиенту уже записанный адрес и даёт его исправить: без
	// ГУИДов справочников подставить город и отделение в выпадающие списки
	// нечем, а «was» одной строкой годится только человеку в лог.
	Итог.Вставить("name",  СокрЛП(Заказ.Получатель));
	Итог.Вставить("phone", СокрЛП(Заказ.ТелефонКонтрагента));
	Итог.Вставить("city_name", СокрЛП(Заказ.ГородНовойПочтыПредставление));
	Итог.Вставить("wh_name",   СокрЛП(Заказ.СкладНовойПочтыПредставление));
	Итог.Вставить("city_ref", ?(ЗначениеЗаполнено(Заказ.ГородНовойПочтыЗначение),
		НРег(СокрЛП(Строка(Заказ.ГородНовойПочтыЗначение.ГУИД))), ""));
	Итог.Вставить("wh_ref",   ?(ЗначениеЗаполнено(Заказ.СкладНовойПочтыЗначение),
		НРег(СокрЛП(Строка(Заказ.СкладНовойПочтыЗначение.ГУИД))), ""));

	Если ТолькоПроверка Тогда
		Итог.Вставить("ok", Истина);
		Возврат Итог;
	КонецЕсли;

	Город     = СсылкаПоГУИДНовойПочты("Справочник.ЛМ_Города",    ГуидГорода);
	Отделение = СсылкаПоГУИДНовойПочты("Справочник.ЛМ_Отделения", ГуидОтделения);

	// Название из справочника 1С вернее присланного сайтом: справочники Новой
	// Почты на сайте и в 1С обновляются по-разному, а менеджер смотрит в 1С.
	Если Город <> Неопределено Тогда
		ИмяГорода = СокрЛП(Строка(Город));
	КонецЕсли;

	Если Отделение <> Неопределено Тогда
		ИмяОтделения = СокрЛП(Строка(Отделение));
	КонецЕсли;

	Изменения = Новый Массив;

	Попытка

		Объект = Заказ.ПолучитьОбъект();

		Если Объект = Неопределено Тогда
			Итог.Вставить("error", "заказ удалён из базы");
			Возврат Итог;
		КонецЕсли;

		Если Не ПустаяСтрока(Имя) И СокрЛП(Объект.Получатель) <> Имя Тогда
			Изменения.Добавить("получатель: """ + СокрЛП(Объект.Получатель)
				+ """ -> """ + Имя + """");
			Объект.Получатель = Имя;
		КонецЕсли;

		Если Не ПустаяСтрока(Телефон) И СокрЛП(Объект.ТелефонКонтрагента) <> Телефон Тогда
			Изменения.Добавить("телефон: """ + СокрЛП(Объект.ТелефонКонтрагента)
				+ """ -> """ + Телефон + """");
			Объект.ТелефонКонтрагента = Телефон;
		КонецЕсли;

		// Город и отделение - только парой и только когда оба опознаны в
		// справочниках: половина адреса хуже, чем его отсутствие - менеджер
		// решит, что адрес есть, а накладную создать не сможет.
		Если Город <> Неопределено И Отделение <> Неопределено Тогда

			Если Объект.ГородНовойПочтыЗначение <> Город
				Или Объект.СкладНовойПочтыЗначение <> Отделение Тогда

				Изменения.Добавить("адрес: """
					+ СокрЛП(Объект.ГородНовойПочтыПредставление) + ", "
					+ СокрЛП(Объект.СкладНовойПочтыПредставление) + """ -> """
					+ ИмяГорода + ", " + ИмяОтделения + """");

				Объект.ГородНовойПочтыЗначение      = Город;
				Объект.ГородНовойПочтыПредставление = ИмяГорода;
				Объект.СкладНовойПочтыЗначение      = Отделение;
				Объект.СкладНовойПочтыПредставление = ИмяОтделения;

			КонецЕсли;

		ИначеЕсли Не ПустаяСтрока(ГуидОтделения) Или Не ПустаяСтрока(ГуидГорода) Тогда

			Итог.Вставить("note", "отделение """ + ИмяГорода + ", " + ИмяОтделения
				+ """ в справочниках 1С не найдено - записаны только имя и телефон");

		КонецЕсли;

		Если Изменения.Количество() = 0 Тогда

			Итог.Вставить("ok", Истина);

			Если Не Итог.Свойство("note") Тогда
				Итог.Вставить("note", "данные в заказе уже такие");
			КонецЕсли;

			Возврат Итог;

		КонецЕсли;

		Объект.Записать();

	Исключение

		ЗаписьЖурналаРегистрации("Сайт.Доставка",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЗаказПокупателя, Заказ,
			"Данные получателя с сайта не записаны: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		Итог.Вставить("error", "заказ не записан: " + ОписаниеОшибки());
		Возврат Итог;

	КонецПопытки;

	ЗаписьЖурналаРегистрации("Сайт.Доставка",
		УровеньЖурналаРегистрации.Информация,
		Метаданные.Документы.ЗаказПокупателя, Заказ,
		"Клиент заполнил данные отправки на сайте. "
		+ СтрСоединить(Изменения, "; "));

	Итог.Вставить("ok",      Истина);
	Итог.Вставить("changed", Истина);

	Возврат Итог;

КонецФункции

// Элемент справочника по ГУИДу Новой Почты (реквизит ГУИД у ЛМ_Города и
// ЛМ_Отделения; там лежит тот же Ref, что отдаёт API Новой Почты и что хранит
// сайт в modx_a_newpost_city / modx_a_newpost_warehouse).
//
// Помеченные на удаление не отсеиваем намеренно: отметки в ЛМ_Отделения
// проставлены неаккуратно и вырезали бы больше половины живых отделений.
Функция СсылкаПоГУИДНовойПочты(Знач ИмяТаблицы, Знач ГУИД)

	Если ПустаяСтрока(ГУИД) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СправочникНП.Ссылка КАК Ссылка
		|ИЗ
		|	" + ИмяТаблицы + " КАК СправочникНП
		|ГДЕ
		|	СправочникНП.ГУИД = &ГУИД";
	Запрос.УстановитьПараметр("ГУИД", ГУИД);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Заказ по номеру сайта и/или номеру документа 1С. Порядок попыток: точный
// номер 1С, номер сайта, и только потом номер сайта КАК номер документа -
// менеджер вполне может прислать номер из 1С вместо сайтового.
Функция НайтиЗаказПоНомерам(Знач НомерСайта, Знач Номер1С)

	Если Не ПустаяСтрока(Номер1С) Тогда

		Заказ = ТелеграмБот.ЗаказПоНомеру(Номер1С);

		Если Заказ <> Неопределено Тогда
			Возврат Заказ;
		КонецЕсли;

	КонецЕсли;

	Если ПустаяСтрока(НомерСайта) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Заказ = ЗаказПоНомеруСайта(НомерСайта);

	Если Заказ <> Неопределено Тогда
		Возврат Заказ;
	КонецЕсли;

	Возврат ТелеграмБот.ЗаказПоНомеру(НомерСайта);

КонецФункции

// Заказ по номеру НА САЙТЕ. В сообщениях номер приходит и с ведущими нулями
// («032637»), и без них; в базе с 16.08.2026 он хранится так же, как показан
// покупателю (с нулями), а заказы до перехода лежат без них. Ищем все
// написания одним запросом, а не гадаем — список даёт
// ОбщегоНазначения.ВариантыПоискаНомераЗаказаССайта.
//
// Номер сайта бывает и НЕ числом: заказы маркетплейсов лежат тут же с их
// идентификаторами («S5T62D9»), поэтому исходную строку проверяем наравне
// с цифровыми вариантами. Пустая строка в поиск не идёт: НомерЗаказа2ССайта
// пуст у большинства заказов (у 80 из августовских), и по пустому параметру
// нашёлся бы первый попавшийся.
//
// Помеченные на удаление пропускаем, самый свежий - первым: один и тот же
// номер сайта может оказаться у отменённого дубля.
Функция ЗаказПоНомеруСайта(Знач Номер)

	Исходный = СокрЛП(Строка(Номер));

	Если ПустаяСтрока(Исходный) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чистый = ТолькоЦифры(Исходный);

	Если ПустаяСтрока(Чистый) Тогда
		Чистый = Исходный;
	КонецЕсли;

	Варианты = ОбщегоНазначения.ВариантыПоискаНомераЗаказаССайта(Чистый);

	Для Каждого Вариант Из ОбщегоНазначения.ВариантыПоискаНомераЗаказаССайта(Исходный) Цикл
		Если Варианты.Найти(Вариант) = Неопределено Тогда
			Варианты.Добавить(Вариант);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказПокупателя.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.НомерЗаказа2ССайта В (&Варианты)
		|	И НЕ ЗаказПокупателя.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказПокупателя.Дата УБЫВ";
	Запрос.УстановитьПараметр("Варианты", Варианты);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Только цифры из строки: номер накладной приходит из мессенджера и приносит с
// собой пробелы, дефисы и невидимые символы вроде неразрывного пробела.
Функция ТолькоЦифры(Знач Текст)

	Результат = "";

	Для Позиция = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Вернуть карточку заказа в чат по номеру документа.
Функция ВернутьКарточку(Знач Номер)

	Заказ = ТелеграмБот.ЗаказПоНомеру(Номер);

	Если Заказ = Неопределено Тогда
		Возврат Новый Структура("ok, error", Ложь,
			"Заказ № " + СокрЛП(Строка(Номер)) + " в 1С не найден.");
	КонецЕсли;

	Отправка = ТелеграмБот.ВернутьКарточку(Заказ);

	Итог = Новый Структура;
	Итог.Вставить("ok",    Отправка.Успех);
	Итог.Вставить("chats", Отправка.Чаты);
	Итог.Вставить("error", Отправка.Ошибка);

	Возврат Итог;

КонецФункции

// Что происходит в базе: время сервера и состояние регламента ТелеграмОбмен.
// Без этого «уведомления не приходят» разбирается только через просьбу открыть
// Конфигуратор, а состояние заданий - первое, что нужно проверить.
Функция СостояниеБазы()

	Итог = Новый Структура;
	Итог.Вставить("ok",   Истина);
	Итог.Вставить("time", Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm:ss'"));

	Попытка

		Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(
			Новый Структура("Метаданные", "ТелеграмОбмен"));

		Если Задания.Количество() = 0 Тогда

			Итог.Вставить("job", "регламент ТелеграмОбмен в базе не найден");

		Иначе

			Задание = Задания[0];

			Итог.Вставить("job_use",      Задание.Использование);
			Итог.Вставить("job_schedule", Строка(Задание.Расписание));

			Фоновые = ФоновыеЗадания.ПолучитьФоновыеЗадания(
				Новый Структура("ИдентификаторРегламентногоЗадания", Задание.УникальныйИдентификатор));

			Если Фоновые.Количество() = 0 Тогда
				Итог.Вставить("job_last", "запусков не было");
			Иначе
				Последнее = Фоновые[Фоновые.ВГраница()];
				Итог.Вставить("job_last",
					Формат(Последнее.Начало, "ДФ='yyyy-MM-dd HH:mm:ss'")
					+ " " + Строка(Последнее.Состояние));
			КонецЕсли;

		КонецЕсли;

	Исключение

		// Прав на чтение заданий может не быть у пользователя публикации -
		// это не повод отвечать ошибкой на проверку связи.
		Итог.Вставить("job", "прочитать состояние заданий не удалось: "
			+ ОписаниеОшибки());

	КонецПопытки;

	Возврат Итог;

КонецФункции

// Ответ JSON. Тело собираем всегда сами: HTTPСервисОтвет по умолчанию отдаёт
// пустое тело, а сайту нужен разбираемый ответ даже на отказ.
Функция ОтветJSON(Знач Код, Знач Данные)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Тело = ЗаписьJSON.Закрыть();

	Результат = Новый HTTPСервисОтвет(Код);
	Результат.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Результат.УстановитьТелоИзСтроки(Тело, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);

	Возврат Результат;

КонецФункции

// Совпадает ли секрет в заголовке с нашим.
//
// Заголовки от веб-сервера приходят в разном регистре, поэтому ищем перебором
// по нижнему регистру имени, а не обращением по ключу.
// Тело запроса структурой. Не JSON, битый JSON, пустое тело - пустая структура,
// а не исключение: разбирать приходится ДО проверки прав, то есть тело может
// быть каким угодно, в том числе от чужого, кто просто постучался.
Функция РазобратьТело(Знач ТелоЗапроса)

	Попытка

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

	Исключение

		Данные = Неопределено;

	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Новый Структура;
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция СекретСовпадает(Запрос)

	Ожидаемый = ТелеграмБот.СекретВебхука();

	// Секрет не задан - значит вебхуком не пользуемся, и принимать нечего.
	Если ПустаяСтрока(Ожидаемый) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Заголовок Из Запрос.Заголовки Цикл

		Если НРег(СокрЛП(Строка(Заголовок.Ключ))) = "x-telegram-bot-api-secret-token" Тогда
			Возврат СокрЛП(Строка(Заголовок.Значение)) = Ожидаемый;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции
