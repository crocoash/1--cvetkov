	Элементы.КнопкаПродолжить.КнопкаПоУмолчанию = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРаботу(Команда)
	
	ЗавершитьРаботуСистемы();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьКлюч(Команда)
	
	Элементы.ЛицензионныйКлюч.ТолькоПросмотр = Ложь;

	Элементы.ИзменитьКлюч.Видимость = Ложь;
	Элементы.СохранитьКлюч.Видимость = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьКлюч(Команда)
	
	ТекущийСтатус = "Получение информации по лицензированию...";
	
	СохранитьКлючНаСервере();
	
	Элементы.ЛицензионныйКлюч.ТолькоПросмотр = Истина;
	
	Элементы.ИзменитьКлюч.Видимость = Истина;
	Элементы.СохранитьКлюч.Видимость = Ложь;
	
	ОбновитьОтображениеДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура Зарегистрировать(Команда)
	
	ПоляКПроверке = Новый Соответствие;
	Если ЮрЛицо = Истина Тогда
		ПоляКПроверке.Вставить("НаименованиеОрганизации", 	"Введите наименование ораганизации.");
		ПоляКПроверке.Вставить("ИННОрганизации", 		 	"Введите ИНН юридического лица.");
	КонецЕсли;
	ПоляКПроверке.Вставить("ФИОКонтактногоЛица", 			"Введите ФИО контактного лица.");
	ПоляКПроверке.Вставить("НомерТелефона", 				"Укажите контактный номер телефона.");
	ПоляКПроверке.Вставить("ЭлектронныйАдрес", 				"Укажите адрес электронной почты.");
	
	Отказ = Ложь;
	ПроверитьЗаполнениеПолей(ПоляКПроверке, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗарегистрироватьНаСервере() Тогда
		ПерейтиКМеню(0);
	КонецЕсли;
	
	ПроверитьНаличиеОшибок();
КонецПроцедуры
&НаКлиенте
Процедура АктивироватьКупон(Команда)
	
	ПоляКПроверке = Новый Соответствие;
	ПоляКПроверке.Вставить("КлючКупон", "Укажите номер купона.");
	
	Отказ = Ложь;
	ПроверитьЗаполнениеПолей(ПоляКПроверке, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если АктивироватьКупонНаСервере() Тогда
		ПерейтиКМеню(0);
	КонецЕсли;
	
	ПроверитьНаличиеОшибок();
КонецПроцедуры
&НаКлиенте
Процедура ДобавитьПробнуюВерсиюПродукта(Команда)
	ДобавитьПробнуюВерсиюПродуктаНаСервере();
КонецПроцедуры
&НаСервере
Функция ПроверитьНаличиеОшибок()
	Данные = LastError; врСообщение = "";
	
	Если Найти(Данные, "1003")>0 Тогда
		врСообщение = врСообщение + "[1003] Для активации купона """+КлючКупон+""" необходимо ввести данные о компании и получить регистрационный номер по ссылке ""Регистрация в сервисе MIKO SaaS""." + Символы.ПС;	
	ИначеЕсли Найти(Данные,"1058")>0  Тогда 	
		// ERR Данный e-mail адрес уже зарегистрирован в системе [1058]	
		врСообщение = врСообщение + "[1058] E-mail """+ЭлектронныйАдрес+""" или ПК уже зарегистрирован в системе." + Символы.ПС;		
	ИначеЕсли Найти(Данные,"1053")>0  Тогда 	
		врСообщение = врСообщение + "[1053] Введен не корректный регистрационный номер """+ЛицензионныйКлюч+"""." + Символы.ПС;
	ИначеЕсли Найти(Данные,"1081")>0  Тогда 	
		врСообщение = врСообщение + "[1081] Введен не корректный код купона """+КлючКупон+"""." + Символы.ПС;
		КлючКупон = "";		
	ИначеЕсли Найти(Данные, "1082")>0 Тогда 	
		врСообщение = врСообщение + "[1082] Купон """+КлючКупон+""" уже был активирован ранее." + Символы.ПС;  
		КлючКупон = "";	
	ИначеЕсли Найти(Данные, "1012")>0 Тогда
		// ERR Сервер лицензирования не вернул ответ [1011]
		врСообщение = врСообщение + "[1012] Сервер лицензирования отклонил запрос." + Символы.ПС;	
	ИначеЕсли Найти(Данные, "1011")>0 Тогда
		// ERR Сервер лицензирования не вернул ответ [1011]
		врСообщение = врСообщение + "[1011] Сервер лицензирования не вернул ответ." + Символы.ПС;
		врСообщение = врСообщение + "Проверьте наличие доступа в интернет." + Символы.ПС;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(врСообщение) Тогда
		LastError = врСообщение;	
	КонецЕсли; 
	
	Возврат LastError;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Обработчики команд на стороне сервера.

&НаСервере
Процедура СохранитьКлючНаСервере()
	
	ЛицензионныйКлюч = СокрЛП(ЛицензионныйКлючВременный);
	МИКО_ЛицензированиеПереопределяемый.ПриЗаписиЛицензионногоКлюча(СведенияОПродукте.ИдентификаторКонфигурации, ЛицензионныйКлюч);
	
	ОбновитьСведенияОЛицензии();
	
КонецПроцедуры

// Регистрация клиента в системе.
// 
&НаСервере
Функция ЗарегистрироватьНаСервере()
	Попытка
		мМИКО_Лицензирование = Вычислить("МИКО_Лицензирование");	
	Исключение
		Возврат Ложь;	
	КонецПопытки; 
	Компонент = мМИКО_Лицензирование.ПодключитьКомпонент(СведенияОПродукте.ПрефиксКлюч, СведенияОПродукте.ИдентификаторКонфигурации);
	// Пример:
	//<reginfo>
	//	<param name = "Companyname" value = "МИКО ООО" />
	//	<param name = "Contact" value = "Лев Мышкин" />
	//	<param name = "Email" value = "l.mouse@miko.ru" />
	//	<param name = "Telefone" value = "+791278945623" />
	//	<param name = "INN" value = "7735518433" />
	//	<param name = "TypeOPF" value = "org" />
	//	<param name = "Description" value = "Активация из 1С" />
	//</reginfo>
	//.	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Companyname", ?(ЗначениеЗаполнено(НаименованиеОрганизации),НаименованиеОрганизации,ФИОКонтактногоЛица));
	СтруктураПараметров.Вставить("INN", 		ИННОрганизации);  		
	СтруктураПараметров.Вставить("Contact", 	ФИОКонтактногоЛица);
	СтруктураПараметров.Вставить("Email", 		ЭлектронныйАдрес);
	СтруктураПараметров.Вставить("Telefone", 	НомерТелефона);
	СтруктураПараметров.Вставить("Description", "");
	СтруктураПараметров.Вставить("TypeOPF", 	?(ЮрЛицо, "org", "ind"));
	Данные = "<reginfo>";
	Для Каждого ТекПараметр Из СтруктураПараметров Цикл
		Если ЗначениеЗаполнено(ТекПараметр.Значение) Тогда
			ДанныеКлюча = "";
			Компонент.UrlEncode(""+ТекПараметр.Значение, ДанныеКлюча);	
			Данные = Данные + Символы.ПС + м_СтрШаблон("<param name=""%1"" value=""%2""/>", ТекПараметр.Ключ, ДанныеКлюча);
		КонецЕсли; 
	КонецЦикла; 
	Данные = Данные + Символы.ПС + "</reginfo>";
														
	ИдентификаторПродукта = ""+СведенияОПродукте.ИдентификаторТриальногоПродукта;	
	Результат = ""; ТекущийСтатус="";
	Если Компонент.GetTrialLicense(ИдентификаторПродукта, Данные, Результат) Тогда
		
		Если ЗначениеЗаполнено(Результат) Тогда
			МИКО_ЛицензированиеПереопределяемый.ПриЗаписиЛицензионногоКлюча(
				СведенияОПродукте.ИдентификаторКонфигурации,
				Результат);
				
			ЛицензионныйКлюч = Результат;
				
			// Активируем купон.
			АктивироватьКупонНаСервере();
			
			ОбновитьСведенияОЛицензии();
				
			Возврат Истина;
		КонецЕсли; 
		
	КонецЕсли;
	LastError = Компонент.LastError();
 	Элементы.РезультатLastError1.Видимость = ЗначениеЗаполнено(LastError);
	
	Возврат Ложь;
КонецФункции

// Активация купона.
//
&НаСервере
Функция АктивироватьКупонНаСервере()
	ТекущийСтатус = "";
	Попытка
		мМИКО_Лицензирование = Вычислить("МИКО_Лицензирование");	
	Исключение
		Возврат Ложь;	
	КонецПопытки; 
	Если ПустаяСтрока(КлючКупон) Тогда
	  	Возврат Истина;
	КонецЕсли; 
	
	Компонент = мМИКО_Лицензирование.ПодключитьКомпонент(СведенияОПродукте.ПрефиксКлюч,
	                                                    СведенияОПродукте.ИдентификаторКонфигурации);
	Компонент.MikoLicense = ЛицензионныйКлюч;
	Результат = Компонент.ActivateCoupone(КлючКупон, "");
	Если Результат Тогда
		ОбновитьСведенияОЛицензии();
	КонецЕсли;
	LastError = Компонент.LastError();
	Элементы.РезультатLastError.Видимость = ЗначениеЗаполнено(LastError);
	
	Возврат Результат;
КонецФункции

// Активация купона.
//
&НаСервере
Функция ДобавитьПробнуюВерсиюПродуктаНаСервере()
	ТекущийСтатус = "";
	Попытка
		мМИКО_Лицензирование = Вычислить("МИКО_Лицензирование");	
	Исключение
		Возврат Ложь;	
	КонецПопытки; 
	
	Компонент = мМИКО_Лицензирование.ПодключитьКомпонент(СведенияОПродукте.ПрефиксКлюч, СведенияОПродукте.ИдентификаторКонфигурации);
	Компонент.MikoLicense = ЛицензионныйКлюч;
	Если ПустаяСтрока(ЛицензионныйКлюч) Тогда
	  	Возврат Ложь;
	КонецЕсли; 
	
	Результат = Компонент.AddTrialProduct(""+СведенияОПродукте.ИдентификаторТриальногоПродукта);
	Если Результат = Истина Тогда
		ОбновитьСведенияОЛицензии();
	Иначе
		СообщениеОбОшибкеСистемыЛицензирования(Компонент);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

