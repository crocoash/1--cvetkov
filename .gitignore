# Временные / служебные файлы
*.tmp
*.log
*.bak
~*
Thumbs.db
desktop.ini

# Логи и кэш конфигуратора / EDT
/.settings/
/.metadata/
*.pid

# Выгруженные базы и внешние обработки (кладите отдельно, если нужно)
# *.dt
# *.cf

# Вспомогательные скрипты (не часть конфигурации).
# Исключения ниже — то, без чего не работает правило про штрихкоды и снимки:
# они должны уезжать вместе с конфигурацией на другую машину.
/_tools/*
!/_tools/check-barcodes.ps1
!/_tools/fix-barcodes.ps1
!/_tools/barcode-object.xml
!/_tools/snapshot.ps1
# check-bsl.ps1 вызывается из snapshot.ps1 — без него снимок на машине с 1С
# падает. Раньше файл сюда не попал, и проверка жила только на одной машине.
!/_tools/check-bsl.ps1
!/_tools/ШтрихкодыВМакетах.md
!/_tools/ЗаданиеПубликацияВебхука.md
# Канал «запрос к базе снаружи»: адрес, параметры и грабли. Нужен на обеих
# машинах — на той стороне по нему разбирают, почему база не отвечает.
!/_tools/ЗапросыКБазе.md
# Настройка загрузки рекламного расхода нужна на машине с 1С: там заполняют
# константы и задают расписание регламентного задания.
!/_tools/РекламныйРасход.md
!/_tools/setup-tgsite.ps1
!/_tools/publish-tgbot.ps1
!/_tools/vrd-httpservices.ps1
# Пакетная загрузка конфигурации в базу — работает только на машине с 1С, туда и едет.
!/_tools/apply-config.ps1
!/_tools/Обновить базу.cmd

# Служебные файлы Claude Code
/.claude/

# Большой макет (правило не срабатывает — файл уже в индексе, оставлено как есть)
CommonTemplates/Простир_Процентовка/Ext/Template.xml
