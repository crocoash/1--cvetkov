
&НаКлиенте
Процедура ИмяФайлаЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие); 
	ДиалогВыбораФайла.ПолноеИмяФайла = ""; 
	
	ДиалогВыбораФайла.Фильтр = "(*.xlsx)|*.xlsx|(*.xls)|*.xls"; 
	ДиалогВыбораФайла.Заголовок = "Выберите файл для загрузки"; 
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ИмяФайлаЗагрузки = ДиалогВыбораФайла.ПолноеИмяФайла; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПерваяЗначимаяСтрока = 2; 
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗаказы(Команда)
	
	Если ПустаяСтрока(ИмяФайлаЗагрузки) Тогда
		Предупреждение("Не выбран файл. Загрузка прервана"); 
		Возврат; 
	КонецЕсли; 
	
	ЗагрузитьЗаказыНаСервере(); 
	
	Предупреждение("Заказы загружены",  , "Загрузка"); 
	
КонецПроцедуры

&НаСервере
Функция  ЧислоИз(СтрокаЧ)
	Чис = "";
	Для Стр = 1 По СтрДлина(СтрокаЧ) Цикл
		Сим =Сред(СтрокаЧ,Стр,1);
		Если Сим = "0" ИЛИ Сим = "1"  ИЛИ Сим = "2" ИЛИ Сим = "3" ИЛИ Сим = "4" ИЛИ Сим = "5" ИЛИ Сим = "6"
			ИЛИ Сим = "7" ИЛИ Сим = "8" ИЛИ Сим = "9" ИЛИ Сим = "." ИЛИ Сим = "," Тогда
			Чис = Чис+Сим;
		КонецЕсли;
	КонецЦикла;
	Попытка
		Возврат Число(Чис)
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Процедура ЗагрузитьЗаказыНаСервере()
	Попытка
		Эксель = Новый COMОбъект("Excel.Application"); 
	Исключение
		Сообщить(ОписаниеОшибки()); 
		Возврат;
	КонецПопытки;
	
	Книга = Эксель.WorkBooks.Open(ИмяФайлаЗагрузки);
	Лист = Книга.WorkSheets(1);
	
	ВсегоКолонок = Лист.Cells(1,1).SpecialCells(11).Column; 
	ВсегоСтрок = Лист.Cells(1,1).SpecialCells(11).Row;
	
	ТаблицаЗаказов = Новый ТаблицаЗначений; 
	ТаблицаЗаказов.Колонки.Добавить("Телефон"); 
	ТаблицаЗаказов.Колонки.Добавить("Город"); 
	ТаблицаЗаказов.Колонки.Добавить("Контрагент"); 
	ТаблицаЗаказов.Колонки.Добавить("НомерОтделения"); 
	ТаблицаЗаказов.Колонки.Добавить("Плательщик"); 
	ТаблицаЗаказов.Колонки.Добавить("ВидРасчетов"); 
	ТаблицаЗаказов.Колонки.Добавить("ОбратнаяДоставка"); 
	ТаблицаЗаказов.Колонки.Добавить("ТипОбратнойДоставки"); 
	ТаблицаЗаказов.Колонки.Добавить("Сумма"); 
	ТаблицаЗаказов.Колонки.Добавить("ПлательщикОбратнойДоставки"); 
	ТаблицаЗаказов.Колонки.Добавить("КоличествоМест"); 
	ТаблицаЗаказов.Колонки.Добавить("Вес"); 
	ТаблицаЗаказов.Колонки.Добавить("ОбъявленнаяСтоимость");
	ТаблицаЗаказов.Колонки.Добавить("Номенклатура");
	ТаблицаЗаказов.Колонки.Добавить("Количество");
	ТаблицаЗаказов.Колонки.Добавить("ОписаниеГруза");
	ТаблицаЗаказов.Колонки.Добавить("Организация");
	ТаблицаЗаказов.Колонки.Добавить("АдресДоставки");
	ТаблицаЗаказов.Колонки.Добавить("Комментарий");
	ТаблицаЗаказов.Колонки.Добавить("НомерТТН");



	
	Для Строка = ПерваяЗначимаяСтрока По ВсегоСтрок Цикл
		КонтрагентПроверки = Лист.Cells(Строка, 3).Value; 
		Если ПустаяСтрока(КонтрагентПроверки) Тогда
			Продолжить; //Пустая Строка 
		КонецЕсли; 
		НоваяСтрока = ТаблицаЗаказов.Добавить(); 
		НоваяСтрока.Телефон 					= Лист.Cells(Строка, 1).Value; 
		НоваяСтрока.Город 						= Лист.Cells(Строка, 2).Value; 
		НоваяСтрока.Контрагент 					= Лист.Cells(Строка, 3).Value; 
		НоваяСтрока.НомерОтделения 				= Лист.Cells(Строка, 4).Value;
		НоваяСтрока.Плательщик 					= Лист.Cells(Строка, 5).Value;
		НоваяСтрока.ВидРасчетов 				= Лист.Cells(Строка, 6).Value;
		НоваяСтрока.ОбратнаяДоставка 			= Лист.Cells(Строка, 7).Value;
		НоваяСтрока.ТипОбратнойДоставки 		= Лист.Cells(Строка, 8).Value;
		НоваяСтрока.Сумма 						= ЧислоИз(Лист.Cells(Строка, 9).Value);
		НоваяСтрока.ПлательщикОбратнойДоставки 	= Лист.Cells(Строка, 10).Value;
		НоваяСтрока.КоличествоМест 				= Лист.Cells(Строка, 11).Value;
		НоваяСтрока.Вес 						= Лист.Cells(Строка, 12).Value;
		НоваяСтрока.ОбъявленнаяСтоимость 		= Лист.Cells(Строка, 13).Value;
		НоваяСтрока.Номенклатура 				= Лист.Cells(Строка, 14).Value;
		НоваяСтрока.Количество	 				= Лист.Cells(Строка, 15).Value;
		НоваяСтрока.ОписаниеГруза 				= Лист.Cells(Строка, 16).Value;
		НоваяСтрока.Организация 				= Лист.Cells(Строка, 17).Value;
		НоваяСтрока.АдресДоставки 				= Лист.Cells(Строка, 18).Value;
		НоваяСтрока.Комментарий 				= Лист.Cells(Строка, 19).Value;
		НоваяСтрока.НомерТТН 					= Лист.Cells(Строка, 20).Value;

	КонецЦикла; 
	
	Эксель.Application.Quit();

	//Создание заказов
	
	Для Каждого Стр Из ТаблицаЗаказов Цикл
		ДокументОбъект = Документы.ЗаказПокупателя.СоздатьДокумент(); 
		ИнициализироватьДокументЗаказ(ДокументОбъект); 
		ДокументОбъект.Дата = ТекущаяДата(); 
		Орг = Справочники.Организации.НайтиПоНаименованию(Стр.Организация);
		Организация = Орг;
		Если Орг = Справочники.Организации.ПустаяСсылка() Тогда
			Сообщить("Строка пропущена, не найдена организация "+Стр.Организация);
			Продолжить;
		КонецЕсли;
		ДокументОбъект.Организация = Орг; 
		ДокументОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить(); 
		ДокументОбъект.КурсВзаиморасчетов = 1; 
		ДокументОбъект.КратностьВзаиморасчетов = 1;
		ДокументОбъект.НомерТТН = СтрЗаменить(Стр.НомерТТН,Символы.НПП,"");
		
		ДокументОбъект.Комментарий =  СокрЛП(Стр.Комментарий)+" Адрес: "+СокрЛП(Стр.АдресДоставки);
		
		ДокументОбъект.Контрагент = ПолучитьСоздатьКонтрагента(Стр); 
		ДокументОбъект.ДоговорКонтрагента = ПолучитьДоговор(ДокументОбъект.Контрагент); 
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
			ДокументОбъект.УстановитьНовыйНомер(Организация.Префикс); 
		КонецЕсли; 
		
		ДокументОбъект.Страховка200 = НЕ ЗначениеЗаполнено(Стр.Сумма); 
		ДокументОбъект.Вес = Стр.Вес; 
		ДокументОбъект.ТипОбратнойДоставки = ПолучитьТипОбратнойДоставки(Стр); 
		ДокументОбъект.Мест = Стр.КоличествоМест;
		ДокументОбъект.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоКоду("000000002"); //Ожидает отправки 
		ДокументОбъект.ВидРасчетов = ПолучитьВидРасчетов(Стр.ВидРасчетов); 
		ДокументОбъект.ПлательщикОбратнойДоставки = ПолучитьПлательщикаОбратнойДоставки(Стр.ПлательщикОбратнойДоставки); 
		ДокументОбъект.Плательщик = ПолучитьПлательщика(Стр.Плательщик); 
		ДокументОбъект.СпособОтправки = Справочники.СпособыОтправки.НоваяПочта; 
		//ДокументОбъект.СуммаНоваяПочта = Стр.ОбъявленнаяСтоимость; 
		ДокументОбъект.ТехнологияДоставки = Справочники.ЛМ_ТехнологииДоставки.НайтиПоКоду("000000003"); 
		ДокументОбъект.ГородНовойПочтыЗначение = ПолучитьГородНовойПочты(Стр.Город); 
		ДокументОбъект.СкладНовойПочтыЗначение = ПолучитьОтделениеНовойПочты(ДокументОбъект.ГородНовойПочтыЗначение, Стр.НомерОтделения); 
		ДокументОбъект.КонтрагентДоставки = ПолучитьСоздатьКонтрагентаДоставки(ДокументОбъект.Контрагент, ДокументОбъект.ГородНовойПочтыЗначение, ДокументОбъект.СкладНовойПочтыЗначение, Стр.Телефон); 
		ДокументОбъект.КонтактноеЛицоДоставки = ПолучитьСоздатьКонтактноеЛицоДоставки(ДокументОбъект.Контрагент, ДокументОбъект.КонтрагентДоставки, Стр.Телефон);                                                        
		//Таб часть 
		НоваяСтрока = ДокументОбъект.Товары.Добавить();
		
		НайденаНоменклатура =  Справочники.Номенклатура.НайтиПоНаименованию(Стр.Номенклатура);
		Если НайденаНоменклатура = Справочники.Номенклатура.ПустаяСсылка() Тогда
			Номенклатура = Справочники.Номенклатура.СоздатьЭлемент();
			Номенклатура.Наименование = Стр.Номенклатура;
			Номенклатура.НаименованиеПолное = Стр.Номенклатура;
			Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоКоду("000000001");
			Номенклатура.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт");
			Номенклатура.Записать();
			//единицы
			Ед = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
			Ед.Владелец = Номенклатура.Ссылка;
			Ед.Наименование = Номенклатура.БазоваяЕдиницаИзмерения.Наименование;
			Ед.Коэффициент = 1;
			Ед.Записать();
			Номенклатура.ЕдиницаДляОтчетов = Ед.Ссылка;
			Номенклатура.ЕдиницаИзмеренияМест = Ед.Ссылка;
			Номенклатура.ЕдиницаХраненияОстатков = Ед.Ссылка;
			Номенклатура.Записать();
			НайденаНоменклатура = Номенклатура.Ссылка;
		КонецЕсли;

		НоваяСтрока.Номенклатура = НайденаНоменклатура; 
		
		ДокументОбъект.ПриИзмененииНоменклатурыТоваров(НоваяСтрока);
		Попытка
			Кол = Число(Стр.Количество);
		Исключение
			Кол = 1;
		КонецПопытки;
		НоваяСтрока.Количество = Кол; 
		НоваяСтрока.Цена = ?(ЗначениеЗаполнено(Стр.Сумма), Стр.Сумма, 300); 
		НоваяСтрока.Сумма = ?(ЗначениеЗаполнено(Стр.Сумма), Стр.Сумма, 300); 
		
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, ДокументОбъект);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, ДокументОбъект); 
		
		ДокументОбъект.Записать(); 
	КонецЦикла;
	
	
КонецПроцедуры

Функция ПолучитьПлательщика(Плательщик)
	
	Если НЕ ЗначениеЗаполнено(Плательщик) Тогда
		Возврат Неопределено; 
	КонецЕсли; 
	
	Если Найти(Плательщик, "відправник") > 0 ИЛИ Найти(Плательщик, "отправитель") > 0 Тогда 
		Возврат Справочники.ЛМ_ВидыПлательщиков.НайтиПоКоду("000000001"); 
	Иначе 
		Возврат Справочники.ЛМ_ВидыПлательщиков.НайтиПоКоду("000000002"); 
	КонецЕсли;
КонецФункции
 
Функция ПолучитьТипОбратнойДоставки(СтрокаЗаказа)
	Если НЕ ЗначениеЗаполнено(СтрокаЗаказа.Сумма)Тогда
		Возврат Справочники.ЛМ_ВидыОбратнойДоставки.ПустаяСсылка(); 
	ИначеЕсли НРег(СтрокаЗаказа.ОбратнаяДоставка) = "ні" Тогда
		Возврат Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000007"); //Предоплата на карту 
	ИначеЕсли НРег(СтрокаЗаказа.ТипОбратнойДоставки) = "контроль оплати" Тогда 
		Возврат Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000005");
	Иначе 
		Возврат Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000002"); //Ценные бумаги
	КонецЕсли; 
КонецФункции
 
Функция ПолучитьСоздатьКонтактноеЛицоДоставки(Контрагент, КонтрагентДоставки, Телефон)
	
	Если Контрагент.Пустая() ИЛИ КонтрагентДоставки.Пустая() Тогда
		Возврат Ложь; 
	КонецЕсли; 
	
	ФИО = Контрагент.Наименование; 
	Фамилия = ВыделитьСлово(ФИО); 
	Имя = ВыделитьСлово(ФИО); 
	Отчество = ВыделитьСлово(ФИО); 
	
	Запрос = Новый Запрос; 
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_КонтактныеЛица.Ссылка
	|ИЗ
	|	Справочник.ЛМ_КонтактныеЛица КАК ЛМ_КонтактныеЛица
	|ГДЕ
	|	ЛМ_КонтактныеЛица.Владелец = &Владелец
	|	И ЛМ_КонтактныеЛица.Имя = &Имя
	|	И ЛМ_КонтактныеЛица.Фамилия = &Фамилия
	|	И ЛМ_КонтактныеЛица.Отчество = &Отчество"; 
	Запрос.УстановитьПараметр("Владелец", КонтрагентДоставки); 
	Запрос.УстановитьПараметр("Имя", Имя); 
	Запрос.УстановитьПараметр("Фамилия", Фамилия); 
	Запрос.УстановитьПараметр("Отчество", Отчество); 
	Результат = Запрос.Выполнить().Выбрать(); 
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка; 
	КонецЕсли; 
	
	Об = Справочники.ЛМ_КонтактныеЛица.СоздатьЭлемент();
	Об.Владелец = КонтрагентДоставки;
	Об.Имя = Имя;
	Об.Фамилия = Фамилия;
	Об.Отчество = Отчество;
	Об.Телефон = Телефон;
	Об.Записать();
	
	Возврат об.Ссылка; 

КонецФункции
 
Функция ПолучитьСоздатьКонтрагентаДоставки(Контрагент, Город, Склад, Телефон)
	
	Если Контрагент.Пустая() Тогда
		Возврат Ложь; 
	КонецЕсли; 
	
	//Поиск контрагента в регистре 
	
	Запрос = Новый Запрос; 
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_КонтрагентыДоставки.КонтрагентДоставки
	|ИЗ
	|	РегистрСведений.ЛМ_КонтрагентыДоставки КАК ЛМ_КонтрагентыДоставки
	|ГДЕ
	|	ЛМ_КонтрагентыДоставки.Контрагент = &Контрагент"; 
	Запрос.УстановитьПараметр("Контрагент", Контрагент); 
	Результат = Запрос.Выполнить().Выбрать(); 
	Если Результат.Следующий() Тогда
		Возврат Результат.КонтрагентДоставки; 
	КонецЕсли; 
	//Создание контрагента 
	ФИО = Контрагент.Наименование; 
	
	Фамилия = ВыделитьСлово(ФИО); 
	Имя = ВыделитьСлово(ФИО); 
	Отчество = ВыделитьСлово(ФИО); 
	
	ОбКонтрагент = Справочники.ЛМ_Контрагенты.СоздатьЭлемент();
	ОбКонтрагент.Город = Город;
	ОбКонтрагент.СкладПоУмолчанию = Склад;
	ОбКонтрагент.Наименование = Контрагент.Наименование;
	ОбКонтрагент.ВидКонтрагента = Справочники.ЛМ_ВидыПлательщиков.НайтиПоРеквизиту("ГУИД", "Recipient");
	ОбКонтрагент.Имя = Имя;
	ОбКонтрагент.Фамилия = Фамилия;
	ОбКонтрагент.Отчество = Отчество;
	ОбКонтрагент.Телефон = Телефон; 
	//Если ЮрФизЛицо =Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
	//	ОбКонтрагент.ЮрФизЛицо = Справочники.ЛМ_ТипыКонтрагентовОтправителей.НайтиПоРеквизиту("ГУИД", "Organization");
	//	ОбКонтрагент.ЕДРПОУ = КодЕДРПОУ;
	//	ОбКонтрагент.ФормаСобственности = ФормаСобственности;
	//Иначе	
		ОбКонтрагент.ЮрФизЛицо = Справочники.ЛМ_ТипыКонтрагентовОтправителей.НайтиПоРеквизиту("ГУИД", "PrivatePerson");
	//КонецЕсли;
//	ОбКонтрагент.Организация = Организация;
	ОбКонтрагент.Записать();
	
	НЗ = РегистрыСведений.ЛМ_КонтрагентыДоставки.СоздатьНаборЗаписей();
	НЗ.Отбор.Контрагент.Установить(Контрагент.Ссылка);
	НЗ.Отбор.КонтрагентДоставки.Установить(ОбКонтрагент.Ссылка);
	З = НЗ.Добавить();
	З.Контрагент = Контрагент.Ссылка;
	З.КонтрагентДоставки = ОбКонтрагент.Ссылка;
	НЗ.Записать();

	Возврат ОбКонтрагент.Ссылка; 
	
КонецФункции

Функция ВыделитьСлово(ИсходнаяСтрока)
	
	Буфер = СокрЛ(ИсходнаяСтрока);
	ПозицияПослПробела = Найти(Буфер, " ");

	Если ПозицияПослПробела = 0 Тогда
		ИсходнаяСтрока = "";
		Возврат Буфер;
	КонецЕсли;
	
	ВыделенноеСлово = СокрЛП(Лев(Буфер, ПозицияПослПробела));
	ИсходнаяСтрока  = СокрЛП(Сред(ИсходнаяСтрока, ПозицияПослПробела + 1));
	
	Возврат ВыделенноеСлово;
	
КонецФункции

