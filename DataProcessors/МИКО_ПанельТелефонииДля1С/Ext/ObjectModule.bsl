	// - SIP

КонецПроцедуры
 
// Подключаем компоненту связи из макета и логинимся под менеджером астериска
//
Процедура ПодключитьВК() Экспорт
	Если НЕ( ЗначениеЗаполнено(Хост) 
		И ЗначениеЗаполнено(Порт) 
		И ЗначениеЗаполнено(МенеджерЛогин) 
		И ЗначениеЗаполнено(МенеджерПароль)) 
		Тогда
		Сообщить("Не указаны параметры авторизации на сервере телефонии. Панель не будет подключена.");
		ФормаНастройки=мОбщийМодуль.ПолучитьФормуНастройки();
		Если ФормаНастройки.Открыта() Тогда
			ФормаНастройки.Открыть();
		КонецЕсли; 
		Возврат;
	КонецЕсли; 
	
	Состояние("Выполняется инициализация компоненты телефонии");
	
	// инициализируем компонент
	Если НЕ ПодключитьВнешнююКомпонентуAsterisk() Тогда
		СообщитьОтладочнуюИнформацию("Не удалось подключить внешнюю компоненту!","");
		Обозреватель = Обработки.Обозреватель.ПолучитьФорму("Форма");
		Обозреватель.СтартоваяСтраница = "http://wiki.miko.ru/doc:1cajam:install#reshenie_problem_s_texnologiej_zaschity";
		Обозреватель.Заголовок = "Иснтрукция по настройке системы защиты Sentinel HASP.";
		Обозреватель.ВладелецФормы = ФормаТелефон;
		Обозреватель.Открыть();
	КонецЕсли;
	
	// подключение к AJAM
	Если НЕ Компонент = Неопределено Тогда
		Попытка		                                                
			Компонент.MikoLicense = MikoLicense;
		Исключение
		КонецПопытки; 
		
		Компонент.Host					= Хост;
		Компонент.Port 					= Порт;
		Компонент.EventsTimeout			= 15;
		Компонент.UseHTTPS 				= РежимSSL;
		Компонент.DigestAutorization 	= DigestАвторизация;
		// настройка прокси
		Компонент.Proxy				 	= ПроксиСервер;
		Компонент.PorxyLogin		 	= ПроксиЛогин;
		Компонент.PorxySecret		 	= ПроксиПароль;
		// IP сервера лицензирования 127.0.0.1 для локального хоста.
		// Компонент.HaspLicenseServer		= "";
		
		// Если не используется прокси сервер то ХостAsterisk равен тому хосту к которому подключились.
		ХостAsterisk 					= Хост;	 		
		
		Результат="";
		Попытка
			ПодключениеУспешно = Компонент.Login(МенеджерЛогин,МенеджерПароль,Результат);
			ПозицияHost1	= Найти(Результат,"host='");
			ПозицияHost2 	= Найти(Результат,"' idenity='");
			ИспользоватьПрокси = (ПозицияHost1 > 0 И ПозицияHost2 > 0);
			Если ИспользоватьПрокси Тогда
				ХостAsterisk=Сред(Результат,ПозицияHost1+6,ПозицияHost2-ПозицияHost1-6);
			КонецЕсли;	
			СообщитьОтладочнуюИнформацию("Результат соединения ",Результат);
		Исключение
			ПодключениеУспешно = Ложь;
			СообщитьОтладочнуюИнформацию("Результат соединения ","Исключение при подключении к АТС, проверьте доступность Хост: " + Хост + ", Порт: " + Порт + ". Проверьте Логин и Пароль!");
		КонецПопытки; 
		
		Если НЕ ПодключениеУспешно Тогда
			// 0 < КолРеконнект < 15
			Если КоличествоПоследовательныхСбоевПриLogin < 15
				И КоличествоПоследовательныхСбоевПриLogin > 0 Тогда
				СообщитьОтладочнуюИнформацию("Связь с сервером телефонии потеряна!", "Аварийный реконнект будет произведен через "+(КоличествоПоследовательныхСбоевПриLogin*10)+" секунд.");
				ФормаТелефон.Реконнект();
				КоличествоПоследовательныхСбоевПриLogin = КоличествоПоследовательныхСбоевПриLogin + 1;
				// КолРеконнект = 0
			ИначеЕсли КоличествоПоследовательныхСбоевПриLogin = 0  Тогда 	
				// КолРеконнект >= 15
			Иначе
				Сообщить("Панель телефонии: потеряна связь с сервером телефонии, либо сетевое соединение не стабильно. Обратитесь к системному администратору!");
			КонецЕсли;
			
			Если Найти(Результат, "Success")>0 Тогда
				ПодключениеУспешно = Истина;
				ТекстСообщения = "Подключение к АТС произведено успешно." + Символы.ПС + "Не найдено свободной лицензии на панель телефонии!";
			Иначе
				ТекстСообщения = "Не вышло подключиться к АТС! Проверьте параметры подключения.";
			КонецЕсли;
			Сообщить(ТекстСообщения);
		Иначе
			// Обнуляем, если успешно подключились. Успешно - значит не было сбоев, исключений.
			КоличествоПоследовательныхСбоевПриLogin = 0;
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если Компонент = Неопределено  Тогда 
		Возврат;
	ИначеЕсли НЕ Компонент.Enabled 
		 	  И ПодключениеУспешно = Истина Тогда
		ПолучитьСведенияОЛицензировании();
	ИначеЕсли НЕ Компонент.Enabled Тогда
		Возврат;
	КонецЕсли;
	
	ИнициализацияПанели();
	РарусСофтФонЛайтКомпонента	= "МИКО софтфон вместо Рарус софтфон лайт"; // Подменим компонент Раруса.
	
КонецПроцедуры	

// Подключение компоненты.
// 
Функция ПодключитьВнешнююКомпонентуAsterisk()
	РезПодключение = Ложь;
	
	Если ХЭШ_Компонент = Неопределено Тогда
		СсылкаНаАрхив = ПоместитьВоВременноеХранилище(ЭтотОбъект.ПолучитьМакет("AsteriskAJAMConnector"), Новый УникальныйИдентификатор);
		Если ПодключитьВнешнююКомпоненту(СсылкаНаАрхив, "Comp", ТипВнешнейКомпоненты.Native) Тогда
			Попытка
				Компонент = Новый ("AddIn.Comp.MikoAjam");
				РезПодключение = Истина;
				
				ХЭШ_Компонент = Компонент;
			Исключение
				Компонент = Неопределено;
				Сообщить("Исключение при инициализации компоненты MIKO_AJAM, проверьте установлена ли система защиты.");
			КонецПопытки; 
		КонецЕсли;
	Иначе	
		Компонент 	   = ХЭШ_Компонент;
		РезПодключение = Истина;
	КонецЕсли; 
	
	Возврат РезПодключение;
КонецФункции // ПодключитьВнешнююКомпонентуAsterisk()
 

// Отключаем компоненту связи
//
Процедура ОтключитьВК() Экспорт
	Звонки.Очистить();
	ИсторияЗвонков.Очистить();
	ПропущенныеЗвонки.Очистить();
	Парковка.Очистить();
	СвязиКаналов.Очистить();                       
	ФаксимильныеСообщения.Очистить();
	Сотрудники.Очистить();
	
	СоответствиеАвтоподъем = Новый Соответствие;
	СтрокаАвтоподъема 	   = "";
	ВерсияДиалплана = Неопределено;                  
	ХостAsterisk 	= "";
	
	ОсвободитьДопМодули();
	
	Если ТипЗнч(ТаблицаХинтов) = Тип("ТаблицаЗначений") Тогда
		ТаблицаХинтов.Очистить(); 
	КонецЕсли; 
	
	Если мВнешняяПанель <> Неопределено Тогда
		мВнешняяПанель.Выгрузить();
	КонецЕсли; 
	
	Если Компонент = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	// Статусы / начало
	УстановитьСтатус("4", НашКаналФильтр, "Unavailable");
	// Статусы / конец
	Попытка
		Состояние("Разлогиниваемся на сервере телефонии...");
		Результат="";
		Компонент.Logoff(Результат);
		Состояние("Разлогинились успешно!");
		СообщитьОтладочнуюИнформацию("Результат разлогинивания: ",Результат);
		Сотрудники.Очистить();
	Исключение
		СообщитьОтладочнуюИнформацию("", "Исключение при разлогинивании");
	КонецПопытки; 
	Компонент 		= Неопределено;
	
КонецПроцедуры

// Для совместимости с Рарус софтфон проф 
// 
Процедура ЗавершитьСофтФон()Экспорт
	ОтключитьВК();	
КонецПроцедуры
// Базовая инициализация панели телефонии.
// 
Процедура УстановитьЗначенияПоУмолчанию() Экспорт
	ИнициализацияПанели();
