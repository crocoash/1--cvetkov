// Инициализация встроенного программного телефона
// 
Процедура ИнициализироватьSIP(Знач ВнутреннийНомер=Неопределено) Экспорт

	// + SIP
	МодульНаборНомера = Неопределено;
	Если ДопМодули.Свойство("НаборНомера", МодульНаборНомера) 
