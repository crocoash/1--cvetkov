// НЕ ИСПОЛЬЗУЕМ // Запрашивает на сервере Asterisk список внутренних номеров
//
Функция ЗапроситьСписокХинтовССервераAsterisk()
	
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("При получении списка Хинтов: Ошибка - ","Компонент не подключен");
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаХинтов = Новый ТаблицаЗначений;
	ТаблицаХинтов.Колонки.Добавить("ВнутреннийНомер",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(32)));
	ТаблицаХинтов.Колонки.Добавить("Канал",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30)));
	ТаблицаХинтов.Колонки.Добавить("Состояние",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30)));
	ТаблицаХинтов.Колонки.Добавить("Контекст",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	ТаблицаХинтов.Колонки.Добавить("UserAgent",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(50)));
	
	ПолучитьСписокDAHDIХинтовССервераAsterisk(ТаблицаХинтов);
	Попытка
		Результат="";
		ActionID	=	КлючУникальности;
		
		Path     = "/asterisk/core/hints";
		Search   = "";//"/hints/hint/context=internal";
		Filter   = "/hints/hint/state|application|extension";
		ActionID = КлючУникальности;
		
		Если Компонент.DataGet(Path, Search, Filter, ActionID, Результат) = Истина Тогда // проверено на Asterisk 1.8.4.4
			//<generic event='DataGet Tree' 
			//1_hints_hint_state='Idle' 
			//1_hints_hint_extension='102' 
			//1_hints_hint_application='DAHDI/22' 
			//2_hints_hint_state='Idle' 
			//2_hints_hint_extension='115' 
			//2_hints_hint_application='SIP/115' 
			//3_hints_hint_state='Idle' 
			//3_hints_hint_extension='*84115' 
			//3_hints_hint_application='ccss:SIP/115' 
			//4_hints_hint_state='Idle' 
			//4_hints_hint_extension='*84102' 
			//4_hints_hint_application='ccss:DAHDI/22' 
			///>
			СтруктураПолей = РазобратьОтветАстерискаБезЧтенияХМЛ(Результат);    // такая Структура не читается обычным чтением ХМЛ, ругается на имена атрибутов, наверное потому что они начинаются с цифер 
			Для к=1 По Цел(СтруктураПолей.Количество()/3) Цикл
				врСчетчик = Формат(к, "ЧГ=");
				ВнутреннийНомер = ""+СтруктураПолей.Получить(""+врСчетчик+"_hints_hint_extension");
				
				Если НЕ ЗначениеЗаполнено(ВнутреннийНомер) Тогда
					Продолжить; // поле не являющееся нужным значенмем, или за пределами массива				
				КонецЕсли; 
				Состояние	 	= СтруктураПолей.Получить(""+врСчетчик+"_hints_hint_state");
				Канал		 	= СтруктураПолей.Получить(""+врСчетчик+"_hints_hint_application");
				
				// хинт может прийти в формате, Custom:busystate132&amp;SIP/132
				КаналНайден = ПолучитьЗначениеХинта(Канал, ВнутреннийНомер);
				Если КаналНайден = Ложь Тогда
					Продолжить;
				КонецЕсли; 
				
				Если Найти(НРег(Канал), "park")>0 Тогда
				 	Продолжить;
				КонецЕсли; 

				НайденныеСтроки = ТаблицаХинтов.НайтиСтроки(Новый Структура("ВнутреннийНомер,Канал",ВнутреннийНомер,Канал));
				Если НайденныеСтроки.Количество()>0 Тогда
				    СтрокаТаблицыХинтов = НайденныеСтроки[0];
				Иначе	
					СтрокаТаблицыХинтов	 = ТаблицаХинтов.Добавить();
				КонецЕсли;
				
				СтрокаТаблицыХинтов.ВнутреннийНомер	=	ВнутреннийНомер;
				СтрокаТаблицыХинтов.Канал			=	Канал;
				СтрокаТаблицыХинтов.Состояние		= 	Состояние;
			КонецЦикла; 
		КонецЕсли;
		
		Если ТаблицаХинтов.Количество()=0 
			И Компонент.Command( "Core Show Hints", ActionID, Результат) = Истина 
			Тогда // работает для большинства версий Asterisk
			ТаблицаХинтов = РазобратьCoreShowHints(Результат);
		Иначе
			Если Найти(Результат,"message='Permission denied'") > 0 Тогда
				СообщитьОтладочнуюИнформацию("Права досутпа: ", "Для менеджера " + МенеджерЛогин + " не хватает привелегии command!");
			КонецЕсли;
		КонецЕсли;
		
		Если ТаблицаХинтов.Количество()=0 Тогда
			СообщитьОтладочнуюИнформацию("При получении списка Хинтов: Ошибка - ","Сервер телефонии не вернул список. " + Символы.ПС + Результат);
			Возврат Неопределено; // ошибка выполнения команды, дальше не пойдем.
		ИначеЕсли Отладка Тогда 
			//ТаблицаХинтов.ВыбратьСтроку("Список номеров которые найдены на серерве телефонии.");
			СимволТАБ =Символы.Таб+Символы.Таб+Символы.Таб+Символы.Таб+Символы.Таб+Символы.Таб;
			Сообщить("ВнутреннийНомер"+Символы.Таб+Символы.Таб+Символы.Таб+"Канал"+СимволТАБ+"Состояние");
			Для каждого СтрокаТаблицыХинтов Из ТаблицаХинтов Цикл
				Сообщить(СтрокаТаблицыХинтов.ВнутреннийНомер+СимволТАБ+СтрокаТаблицыХинтов.Канал+СимволТАБ+СтрокаТаблицыХинтов.Состояние);
			КонецЦикла; 
		КонецЕсли;
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение при выполнении DataGet: ",Результат);
		Возврат Неопределено; // ошибка выполнения команды, дальше не пойдем.
	КонецПопытки; 
	
	Возврат ТаблицаХинтов;
КонецФункции

// Запрашивает от ASTERISK выполнить подготовку файла факсимильного сообщения для скачивания 
//
Процедура ЗапроситьФайлФаксаНаСкачивание(ИдентификаторЗвонка)
	// Звоним на номер 10000666, используя контекст для служебных команд. Звонок длится не более 10 секунд.
	// для канала 10000666 устанавливаем переменные необходимые для разбора файла истории звонков
	ИдентификаторЗвонка = СокрЛП(ИдентификаторЗвонка);
	
	Если ЗначениеЗаполнено(НашКаналФильтр) 
		И ЗначениеЗаполнено(ИдентификаторЗвонка)  Тогда
		
		Channel		=	"Local/10000666@"+КонтекстНабораСлужебныхКоманд; //	Channel: Название канала, с которого совершается исходящий вызов (В том же формате, как если бы Вы совершали вызов этому абоненту командой Dial.)
		Variable	=	
		"v1="		+URLEncode(НашКаналФильтр)
		+",v2="		+URLEncode(ИдентификаторЗвонка)
		+",v6=FAX";
		
		//	Variable: Установка переменных канала (максимум 32). Переменные будут установлены для обоих каналов, участвующих в соединении (локального, для абонента от которого совершается вызов и для вызываемого канала).
		
		Результат="";
		Попытка
			OriginateНаКаналСПередачейПараметров(Channel, Variable, Результат);			
			СообщитьОтладочнуюИнформацию("Инициирован запрос имени файла записи CDR",Результат);
		Исключение
			СообщитьОтладочнуюИнформацию("Ошибка при запросе имени файла записи CDR ",Результат);
		КонецПопытки;	
		
	КонецЕсли;
	
КонецПроцедуры //ЗапроситьФайлФаксаНаСкачивание

// Запрашивает от ASTERISK выполнить подготовку файла записи разговора для скачивания 
//
Процедура ЗапроситьФайлЗаписиНаСкачивание(ИдентификаторЗвонка,ИмяФайлаЗаписи="")
	// Звоним на номер 10000666, используя контекст для служебных команд. Звонок длится не более 10 секунд.
	// для канала 10000666 устанавливаем переменные необходимые для разбора файла истории звонков
	ИдентификаторЗвонка = СокрЛП(ИдентификаторЗвонка);
	Если ЗначениеЗаполнено(НашКаналФильтр) Тогда
		
		Channel		=	"Local/10000666@"+КонтекстНабораСлужебныхКоманд; //	Channel: Название канала, с которого совершается исходящий вызов (В том же формате, как если бы Вы совершали вызов этому абоненту командой Dial.)
		Variable	=	
		"v1="		+URLEncode(НашКаналФильтр)
		+",v2="		+URLEncode(ИдентификаторЗвонка)
		+",v3="		+ИмяФайлаЗаписи
		+",v6=Records";
		//	Variable: Установка переменных канала (максимум 32). Переменные будут установлены для обоих каналов, участвующих в соединении (локального, для абонента от которого совершается вызов и для вызываемого канала).
		
		Результат="";
		Попытка
			OriginateНаКаналСПередачейПараметров(Channel, Variable, Результат);			
			СообщитьОтладочнуюИнформацию("Инициирован запрос имени файла записи CDR",Результат);
		Исключение
			СообщитьОтладочнуюИнформацию("Ошибка при запросе имени файла записи CDR ",Результат);
		КонецПопытки;	
	КонецЕсли;
	
КонецПроцедуры //ЗапроситьФайлФаксаНаСкачивание

// Проверка загружен ли модуль переданный строкой в параметр ИмяМодуля на сервере Asterisk
//
Функция ПроверитьЗагрузкуМодуляAsterisk (ИмяМодуля)
	
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("При проверки загрузки модуля ошибка: ","Компонент не подключен");
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Результат   = "";
		Если Компонент.ModuleCheck( ИмяМодуля , , Результат) = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение при выполнении ModuleCheck: ",Результат);
	КонецПопытки; 
	
	Возврат Ложь;
КонецФункции	

// Запрос дополнительных настроек с сервера Asterisk
//
Функция ПолучитьНастройкиССервераAsterisk() Экспорт
	НашКаналФильтр = "";
	Если ТипЗнч(ТаблицаХинтов) = Тип("ТаблицаЗначений") Тогда
		ТаблицаХинтов.очистить();
	КонецЕсли; 
	
	//Звоним на номер 10000111, для получения вспомогательных настроек с сервера Asterisk
	v1=?(ЗначениеЗаполнено(НашКаналФильтр),НашКаналФильтр,КлючУникальности);
	Channel		=	"Local/10000111@"+КонтекстНабораСлужебныхКоманд; //	Channel: Название канала, с которого совершается исходящий вызов (В том же формате, как если бы Вы совершали вызов этому абоненту командой Dial.)
	Variable	=	
	"v1="		+URLEncode(v1);		//	Variable: Установка переменных канала (максимум 32). Переменные будут установлены для обоих каналов, участвующих в соединении (локального, для абонента от которого совершается вызов и для вызываемого канала).
	
	Результат="";
	Попытка
		// для диалплана 1.0.0.6
		OriginateНаКаналСПередачейПараметров(Channel, Variable, Результат);			
		СообщитьОтладочнуюИнформацию("Инициирован запрос настроек с сервера Asterisk",Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Ошибка при запросе настроек с сервера Asterisk.",Результат);
	КонецПопытки;	
	
КонецФункции // ПроверитьУстановкуGhostScriptНаСервереAsterisk()

// Запрос контекста с сервера Asterisk
//
Процедура ПолучитьКонтекстССервераAsterisk()
	Если Не ЗначениеЗаполнено(НашКаналФильтр) Тогда
		Возврат;
	КонецЕсли; 
	прПозицияСимвола = Найти(НашКаналФильтр, "/");
	
	Технология = ВРег(Лев(НашКаналФильтр, прПозицияСимвола - 1));
	Технология = ?(Технология="IAX2","IAX",Технология);
	
	Номер	   = Прав(НашКаналФильтр, СтрДлина(НашКаналФильтр) - прПозицияСимвола);
	//Звоним на номер 10000109, для получения вспомогательных настроек с сервера Asterisk
	Channel		=	"Local/10000109@"+КонтекстНабораСлужебныхКоманд; //	Channel: Название канала, с которого совершается исходящий вызов (В том же формате, как если бы Вы совершали вызов этому абоненту командой Dial.)
	Variable	=	
		"tehnology=" +URLEncode(Технология)+ "," +
		"number=" +URLEncode(Номер);		
	//	Variable: Установка переменных канала (максимум 32). Переменные будут установлены для обоих каналов, участвующих в соединении (локального, для абонента от которого совершается вызов и для вызываемого канала).
	
	Результат="";
	Попытка
		// для диалплана 1.0.0.6
		OriginateНаКаналСПередачейПараметров(Channel, Variable, Результат);			
		СообщитьОтладочнуюИнформацию("Инициирован запрос настроек с сервера Asterisk",Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Ошибка при запросе настроек с сервера Asterisk.",Результат);
	КонецПопытки;	
	
КонецПроцедуры // ПроверитьУстановкуGhostScriptНаСервереAsterisk()


// Получаем параметры пира по внутреннему номеру с сервера Asterisk для заполнения настроек панели
//
Процедура ПолучитьПараметрыSIPПира(ВнутреннийНомер, Технология = "SIP") Экспорт 
	Если Компонент = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	// Определим используемую пиром технологию
	Если НЕ ЗначениеЗаполнено(ВнутреннийНомер) Тогда
		Возврат;	
	КонецЕсли;
	
    Для каждого ТекущийНомер Из мСписокНомеровПользователяДляОбработки Цикл
		ОсновнойНомер = (ВнутреннийНомер = ТекущийНомер);
		Если ОсновнойНомер = Истина Тогда
			ИнициализироватьSIP(ВнутреннийНомер);
		КонецЕсли;
		
		Если Технология = "SIP" И Лев(НашКаналФильтр, 3)=Технология Тогда
			Результат="";
			Попытка
				Компонент.SIPshowPeer(ТекущийНомер, "", Результат);
				РазобратьПараметрыSIPПира(ТекущийНомер, Результат, ОсновнойНомер);
				СообщитьОтладочнуюИнформацию("Инициирован запрос настроек пира "+ВнутреннийНомер+" с сервера Asterisk.",Результат);
			Исключение
				СообщитьОтладочнуюИнформацию("Ошибка при запросе настроек SIP пира "+ВнутреннийНомер+" с сервера Asterisk.",Результат);
			КонецПопытки;	
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

// Разбор ответа сервера по запросу параметров пира
// 
Процедура РазобратьПараметрыSIPПира(ВнутреннийНомер, Результат, ОсновнойНомер)
		
	УзелХМЛ=ПолучитьЧтениеXML(Результат);
	Если УзелХМЛ<>Неопределено Тогда
		Пока УзелХМЛ.Прочитать() Цикл
			Если УзелХМЛ.Имя="generic" И УзелХМЛ.ТипУзла =	ТипУзлаXML.НачалоЭлемента Тогда    // нужный нам узел в котором респонсили Эвент
				Событие	= УзелХМЛ.ЗначениеАтрибута("response");
				Если Событие="Success" Тогда   
					
					sip_useragent		= УзелХМЛ.ЗначениеАтрибута("sip_useragent"); // линксис или еалинк или циско
					Строка_auto_answer  = ВернутьСтрокуАвтоподъемаТрубки(sip_useragent);
					Если ОсновнойНомер = Истина Тогда
						КонтекстНабораПоУмолчанию		= УзелХМЛ.ЗначениеАтрибута("context");
						ВидСофтфонаПользователя			= sip_useragent; // линксис или еалинк или циско
						НашКаналФильтр					= УзелХМЛ.ЗначениеАтрибута("channeltype")+"/"+УзелХМЛ.ЗначениеАтрибута("objectname"); 
						НомерГолосовойПочтыПользователя	= УзелХМЛ.ЗначениеАтрибута("voicemailbox");
						СтрокаАвтоподъема 				= Строка_auto_answer;
					КонецЕсли;
					
					СоответствиеАвтоподъем.Вставить(""+ВнутреннийНомер, Строка_auto_answer);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли; 

КонецПроцедуры

// Получения информации по DAHDI линиям для Askozia
// Askozia не использует команду "hint: <DAHDI/3>" в плане набора
// потому информация по каналам не попадает в вывод команды "core show hint"
Функция ПолучитьСписокDAHDIХинтовССервераAsterisk(ТаблицаХинтов)
	ActionID = "" + КлючУникальности;
	Результат= "";
	Попытка
		Если ПроверитьЗагрузкуМодуляAsterisk("chan_dahdi.so") 
			И Компонент.Command( "dahdi Show channels", ActionID, Результат) = Истина Тогда
			МассивНомеровКаналовDAHDI = РазобратьDAHDIShowChannels(Результат);
			Для каждого КаналDAHDI Из МассивНомеровКаналовDAHDI Цикл
				Компонент.Command( "dahdi Show channel " + КаналDAHDI, ActionID, Результат);
				ОписаниеНомера = РазобратьDAHDIShowChannel(Результат);
				Если НЕ ОписаниеНомера = Неопределено Тогда
					СтрокаТаблицыХинтов	 = ТаблицаХинтов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТаблицыХинтов, ОписаниеНомера);
				КонецЕсли; 
			КонецЦикла; 
		Иначе
			Если Найти(Результат,"message='Permission denied'") Тогда
				СообщитьОтладочнуюИнформацию("Права доступа: ", "Для менеджера " + МенеджерЛогин + " не хватает привелегии command!");
			КонецЕсли;
		КонецЕсли;
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение при выполнении DataGet: ",Результат);
		Возврат Неопределено; // ошибка выполнения команды, дальше не пойдем.
	КонецПопытки; 
	
КонецФункции // ПолучитьСписокDAHDIХинтовССервераAsterisk()

// Оптимизация GetVar
// Проверка наличия сервиса получения переменных.
// 
Функция HTTP_GetVarPing() 
	
	Если НазваниеPBX = "ASKOZIA" Тогда
		Ресурс = "/cfe/wallboard/1c/getvar.php?event=Ping";
	ИначеЕсли НазваниеPBX = "MIKOPBX" Тогда
		Ресурс = "/pbxcore/api/miko_ajam/getvar?event=Ping";
	ИначеЕсли НазваниеPBX = "MYPBX" Тогда
		ПортGetVar = 0;
		Возврат Ложь;
	Иначе	
		Ресурс = "/admin/1c/getvar/index.php?event=Ping";
	КонецЕсли; 
	
	ПортGetVar = 23600;
	Ответ = HTTP_Get(Ресурс);
	Если Ответ = "true" Тогда
	  	Возврат Истина;
	КонецЕсли;

	ПортGetVar = 443;
	Ответ = HTTP_Get(Ресурс);
	Если Ответ = "true" Тогда
	  	Возврат Истина;
	КонецЕсли; 
	
	ПортGetVar = 80;
	Ответ = HTTP_Get(Ресурс);
	Если Ответ = "true" Тогда
	  	Возврат Истина;
	КонецЕсли; 
	
	Если НазваниеPBX <> "ASKOZIA" Тогда
		ПортGetVar = 0;
		Возврат Ложь;
	КонецЕсли; 
		
	ПортGetVar = 0;
	Возврат Ложь;
КонецФункции // ПолучитьФайлССервера()

// Проверка наличия сервиса получения переменных.
// 
Функция HTTP_GetVar(Знач channel, список_variables, Знач УточнениеПеременных="") 
	Если ПортGetVar = 0 Тогда
		Возврат Ложь;	
	КонецЕсли;
	Переменные = Неопределено;
	variables="";
	Если НЕ ЗначениеЗаполнено(УточнениеПеременных) Тогда
		Для каждого тек_var Из список_variables Цикл
			Если ЗначениеЗаполнено(variables) Тогда
				variables = variables + ",";
			КонецЕсли; 
			variables = variables + тек_var.Представление;
		КонецЦикла; 
	Иначе	
		variables =  УточнениеПеременных;	
	КонецЕсли; 
	
	Если НазваниеPBX = "ASKOZIA" Тогда
		Ресурс = "/cfe/wallboard/1c/getvar.php?event=GetVar&";
	ИначеЕсли НазваниеPBX = "MIKOPBX" Тогда
		Ресурс = "/pbxcore/api/miko_ajam/getvar?event=GetVar&";
	Иначе	
		Ресурс = "/admin/1c/getvar/index.php?event=GetVar&";
	КонецЕсли; 
	
	Ресурс = Ресурс + "actionid=" + КлючУникальности + "&channel=" + channel + "&variables=" + variables + "&";
	
	врВыражение = HTTP_Get(Ресурс);
	Если НЕ ЗначениеЗаполнено(врВыражение) Тогда
	  	Возврат Ложь;
	КонецЕсли; 
	
	Попытка
		Переменные = Вычислить(врВыражение);
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение метода ""HTTP_GetVar"": ",врВыражение);
		Возврат Ложь;	
	КонецПопытки; 
	
	Если НЕ ТипЗнч(Переменные) = Тип("Структура") Тогда
	 	Возврат Ложь;
	КонецЕсли; 
	
	Для каждого тек_var Из список_variables Цикл
		врИмя = СтрЗаменить(тек_var.Представление, "(", "_");
		врИмя = СтрЗаменить(врИмя, ")", "_");
		врИмяПолное = "p_"+врИмя;
		// Служебные поля.
		врИмя = СтрЗаменить(врИмя, "channel1_", "");
		врИмя = СтрЗаменить(врИмя, "channel2_", "_");
		врИмя = "p_"+врИмя;

		врЗначение = "";
		Если Переменные.Свойство(врИмя, врЗначение) 
			 ИЛИ Переменные.Свойство(врИмяПолное, врЗначение) Тогда
			тек_var.Значение= Строка(врЗначение);
			тек_var.Пометка = Истина;
		КонецЕсли; 
	КонецЦикла; 
	 
	Возврат Истина;	

КонецФункции // ПолучитьФайлССервера()

&НаКлиенте
Функция HTTP_Get(Ресурс)
	
	ЗащищенноеСоединение = Неопределено;
	Ответ = "";
	Попытка
		HTTPЗапрос = Новый HTTPЗапрос(Ресурс);
		HTTP = Новый HTTPСоединение(ХостAsterisk, ПортGetVar, ПользовательСтатистики, ПарольПользователяСтатистики,,1,ЗащищенноеСоединение);
		Результат = HTTP.Получить(HTTPЗапрос);
		Если Результат.КодСостояния = 200 Тогда
			Ответ = СокрЛП(Результат.ПолучитьТелоКакСтроку());
		КонецЕсли; 
		Если Ответ = "" И ПортGetVar = 443 Тогда
			ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
			HTTPЗапрос = Новый HTTPЗапрос(Ресурс);
			HTTP = Новый HTTPСоединение(ХостAsterisk, ПортGetVar, ПользовательСтатистики, ПарольПользователяСтатистики,,1,ЗащищенноеСоединение);
			Результат = HTTP.Получить(HTTPЗапрос);
			Если Результат.КодСостояния = 200 Тогда
				Ответ = СокрЛП(Результат.ПолучитьТелоКакСтроку());
			КонецЕсли; 
		КонецЕсли; 
	Исключение
	КонецПопытки; 
	
	Возврат Ответ;
	
КонецФункции // HTTP_Get()
 
