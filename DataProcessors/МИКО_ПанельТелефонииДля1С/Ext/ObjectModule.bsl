// ПРОЦЕДУРЫ И ФУНКЦИИ ВСПОМОГАТЕЛЬНЫЕ


// В конфигурации Трактиръ пользователь может быть из справочника сотрудники.
//
Функция ПолучитьИмяТекущегоПользователя() Экспорт
	
	Если Метаданные.Имя = "ТрактиръFrontOffice" И мОбщийМодуль <> Неопределено Тогда
		Возврат  Строка(мОбщийМодуль.ПолучитьТекущегоПользователя().Наименование);
	КонецЕсли;	
		
	Возврат ИмяПользователя();
		
КонецФункции

// По переданному вноутреннему номеру определяем пользователя и возвращаем, иначе Неопределено.
//
Функция ВернутьПользователяПоНомеруТелефона(НомерТелефона)
	
	Запрос = 	мОбщийМодуль.ПолучитьЗапросПользователяПоНомеруТелефона();
	Запрос.УстановитьПараметр("CRM_НомерТелефона",НомерТелефона );
	Запрос.УстановитьПараметр("ТипКИ", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда	
		Возврат Выборка.Пользователь;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ВернутьПользователяПоНомеруТелефона()

// Определяем принадлежит ли указанный номер текущему пользователю системы. Номер пытаемся найти по подстроке.
//
Функция ЭтоНомерТекущегоПользователя(Знач СтрокаЗвонка,Знач СписокНомеровПользователяДляОбработки, УровеньРекурсии=0) Экспорт
	УровеньРекурсии = УровеньРекурсии + 1;
	Если УровеньРекурсии > 20 Тогда Возврат Ложь; КонецЕсли; 
	
	СтрокаЗвонка = ВРег(СтрокаЗвонка);	
	пНомер = ПолучитьНомерВызываемогоАбонентаИзАтрибутаDialstring(СтрокаЗвонка);
	Для каждого Номер Из СписокНомеровПользователяДляОбработки Цикл
		Если (СтрДлина(Номер) > 5 И Найти(СтрокаЗвонка,"/"+Номер)>0)
			ИЛИ Найти(Прав(СтрокаЗвонка, СтрДлина(Номер)+1), "/" + Номер) > 0
			ИЛИ ( Найти(СтрокаЗвонка, "/" + Номер + "@") > 0 И НЕ Найти(СтрокаЗвонка, "LOCAL/" + Номер + "@") > 0) 
			ИЛИ Найти(СтрокаЗвонка, "/" + Номер + "-") > 0
			ИЛИ Найти(СтрокаЗвонка,"/"+Номер+",") > 0 
			ИЛИ Найти(СтрокаЗвонка,"@@"+Номер+"@@") > 0
			Тогда
			
			Возврат Истина;
		ИначеЕсли пНомер = Номер И (Найти(СтрокаЗвонка, "SIP/" + Номер) ИЛИ Найти(СтрокаЗвонка, "IAX/" + Номер) 
					 				ИЛИ Найти(СтрокаЗвонка, "DAHDI/" + Номер) ИЛИ Найти(СтрокаЗвонка, "PJSIP/" + Номер)) Тогда
			Возврат Истина;
		КонецЕсли; 
	КонецЦикла;
	
	Если ТипЗнч(ТаблицаХинтов) <> Тип("ТаблицаЗначений") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	// для DAHDI особый подход
	Если ВРЕГ(Лев(СтрокаЗвонка, 6)) = "DAHDI/"  Тогда
		КаналDAHDI = Лев(СтрокаЗвонка,ПолучитьПозициюБлижнегоСимвола(СтрокаЗвонка, "@-,")-1);
	   	Хинт = ТаблицаХинтов.Найти(КаналDAHDI);
		Если НЕ Хинт = Неопределено Тогда
			Номер = Хинт.ВнутреннийНомер;
			Возврат ЭтоНомерТекущегоПользователя("@@"+Номер+"@@",СписокНомеровПользователяДляОбработки, УровеньРекурсии);
		КонецЕсли; 
	КонецЕсли; 
	
	// прочие, внутренние каналы, описанные в хинтах
	// Пример: SIP/160-32-00000ce, где SIP/160-32 - hint, 160-32 - имя учетной записи SIP 
	Для каждого Хинт Из ТаблицаХинтов Цикл
		Если НЕ ЗначениеЗаполнено(Хинт.Канал) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Найти(СтрокаЗвонка, Врег(Хинт.Канал))>0 Тогда
			Номер = Хинт.ВнутреннийНомер;
			Возврат ЭтоНомерТекущегоПользователя("@@"+Номер+"@@",СписокНомеровПользователяДляОбработки, УровеньРекурсии);
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат Ложь;
КонецФункции // ЭтоНомерТекущегоПользователя()

// Определяем принадлежит ли указанный номер текущему пользователю системы. Номер пытаемся найти по подстроке.
//
Функция ЭтоЛокальныйНомерТекущегоПользователя(Знач СтрокаЗвонка,СписокНомеровПользователяДляОбработки)
	СтрокаЗвонка = ВРег(СтрокаЗвонка);	
	Для каждого Номер Из СписокНомеровПользователяДляОбработки Цикл
		Если Найти(СтрокаЗвонка, "LOCAL/" + Номер + "@") > 0 Тогда
			Возврат Истина;
		КонецЕсли; 
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции // 

// Функция разбирает переданный номер телефона или структуру содержащую поля номера телефона в зависимости
//  от того какой это звонок входящий или исходящих. Если входящий звонок, то передается строка с номером телефона
//  а возвращаем структуру содержащую поля номера телефона. Так же проверяем если звонок внутренний, то сохраняем номер
//  как внутренний, иначе передаем его как есть, пользователь разберет номер в ручную.
//  Если звонок исходящий то получаем структуру в качестве номера, 
//а возвращаем преобразованную строку которую будет набирать станция.
Функция ПреобразоватьНомерСУчетомПрефиксов(Знач НомерТелефона, Знач ВходящийЗвонок) Экспорт 
	
	// Подготавливаем структуру номера телефона который будем возвращать при входящем звонке
	// при исходящем будем возвращать строку с номером телефона
	РезультатНомер = мОбработкаДанных.СформироватьСтруктуруНомераИзПолей();
	
	// Обрабатываем входящий звонок
	Если ВходящийЗвонок И ТипЗнч(НомерТелефона) = Тип("Строка") Тогда
		
		НомерТелефона = мОбработкаДанных.УбратьИзНомераТелефонаВсеПрефиксы(НомерТелефона);
		// Если состояние звонка является внутренним номером, то никаких префиксов подставлять не нужно 
		//  просто сразу возвращаем номер телефона, структуру смотрим в ВидыВходящихИсходящихСобытий
		Если ОпределитьВнутреннийВнешнийЗвонок(НомерТелефона) = ТипВнутреннийВнешнийЗвонок.Внутренний Тогда
			РезультатНомер.Внутренний = НомерТелефона;
		Иначе
			// Если длина телефона не равна 7 цифрам, то номер разложим следующим
			// образом, 7 последних это телефон, остальное код.
			Если СтрДлина(НомерТелефона) <= 7 Тогда
				РезультатНомер.НомерТелефона = НомерТелефона;
			Иначе
				РезультатНомер.НомерТелефона = Прав(НомерТелефона, 7);
				РезультатНомер.КодГорода	 = Лев(НомерТелефона, СтрДлина(НомерТелефона) - 7);
				Если Лев(РезультатНомер.КодГорода,1)="7" тогда
					РезультатНомер.КодГорода	 = Прав(РезультатНомер.КодГорода, СтрДлина(РезультатНомер.КодГорода) - 1); 
				КонецЕсли;
				
				врДлинаНомера = СтрДлина(РезультатНомер.НомерТелефона + РезультатНомер.КодГорода);
				РезультатНомер.КодСтраны = Лев(НомерТелефона, СтрДлина(НомерТелефона) - врДлинаНомера);
				
				Если НЕ ЗначениеЗаполнено(РезультатНомер.КодСтраны) Тогда
					РезультатНомер.КодСтраны     = ГлобальныеПеременные.глКодСтраны;
				КонецЕсли; 
			КонецЕсли;
		КонецЕсли;
		
		// Сформируем представление
		мОбработкаДанных.СформироватьПредставлениеТелефонаПоСтруктуре(РезультатНомер);
		
		// Обрабатываем исходящий звонок
	ИначеЕсли НЕ ВходящийЗвонок И ТипЗнч(НомерТелефона) = Тип("Структура") Тогда 
		// "чистый" номер телефона без префпксов и доп кодов
		врНомерТелефона = мОбработкаДанных.УбратьИзНомераТелефонаВсеПрефиксы(НомерТелефона.НомерТелефона);
		// Необходимо позвонить по внутреннему номер, префиксы не нужны
		Если (ЗначениеЗаполнено(НомерТелефона.Внутренний) И НЕ ЗначениеЗаполнено(врНомерТелефона))
			Или (ЗначениеЗаполнено(врНомерТелефона) И НЕ ЗначениеЗаполнено(НомерТелефона.Внутренний) 
			И СтрДлина(врНомерТелефона) <= ГлобальныеПеременные.глМаксимальнаяДлинаВнутреннегоНомера) Тогда
			
			РезультатНомер = ?(НЕ ЗначениеЗаполнено(НомерТелефона.Внутренний), врНомерТелефона, НомерТелефона.Внутренний);
		Иначе
			Если ЗначениеЗаполнено(врНомерТелефона) Тогда
				КодСтраныНомера = ?(СокрЛП(НомерТелефона.КодСтраны) = "8", "7", СтрЗаменить(НомерТелефона.КодСтраны, "+", ""));
				КодГородаНомера = НомерТелефона.КодГорода;
				КодСтраныБезПлюса = СтрЗаменить(ГлобальныеПеременные.глКодСтраны, "+", "");
				
				// если не внутренний то необходимо использовать префиксы, либо выхода в город либо выхода на межгород
				// 1. Если это наш город и страна, то просто префикс выхода в город
				Если (КодСтраныНомера = КодСтраныБезПлюса ИЛИ ПустаяСтрока(КодСтраныНомера)) // наша страна 
					И (КодГородаНомера = ГлобальныеПеременные.глКодГорода ИЛИ ПустаяСтрока(КодГородаНомера)) // нащ город 
					Тогда
					РезультатНомер = ГлобальныеПеременные.глПрефиксВыходаВГород + КодСтраныНомера + КодГородаНомера + врНомерТелефона;
					// 2. Если это не наш город, но наша страна, то выход на межгород
				ИначеЕсли (НЕ КодГородаНомера = ГлобальныеПеременные.глКодГорода И НЕ ПустаяСтрока(КодГородаНомера)) // Чужой город
					И (КодСтраныНомера = КодСтраныБезПлюса ИЛИ ПустаяСтрока(КодСтраныНомера))                  // наша страна
					Тогда
					РезультатНомер = ГлобальныеПеременные.глПрефиксВыходаНаМежгород + КодСтраныНомера + КодГородаНомера + врНомерТелефона;
					// 3. Если это не наша страна, то международный звонок.
				Иначе
					РезультатНомер = ГлобальныеПеременные.глПрефиксВыходаНаМежгород + КодСтраныНомера + КодГородаНомера + врНомерТелефона;
				КонецЕсли;
			Иначе
				РезультатНомер = "";		
			КонецЕсли;
		КонецЕсли;
		
		РезультатНомер = мОбработкаДанных.УбратьИзНомераТелефонаВсеПрефиксы(РезультатНомер);
	КонецЕсли;
	Возврат РезультатНомер;
КонецФункции

// Функция определяет и возвращает какой это звонок внутренний или внешний.
//
Функция ОпределитьВнутреннийВнешнийЗвонок(НомерТелефона) Экспорт
	Если мОбработкаДанных.ОпределитьВнутреннийЗвонокПоНомеру(НомерТелефона, ГлобальныеПеременные.глМаксимальнаяДлинаВнутреннегоНомера) Тогда
		Возврат ТипВнутреннийВнешнийЗвонок.Внутренний; // 1
	Иначе
		Возврат ТипВнутреннийВнешнийЗвонок.Внешний;    // 0
	КонецЕсли; 
КонецФункции

// Анализ строки, поиск имен файлов записей разговоров.
// 
Функция ПолучитьИменаФайловИзстроки(ИмяФайлаЗаписиРазговора) Экспорт

	врИменаФайлов = мОбработкаДанных.мРазложитьСтрокуВМассивПодстрок(ИмяФайлаЗаписиРазговора, "@.@");
	ИменаФайлов = Новый Массив;
	Для каждого текИмя Из врИменаФайлов Цикл
		Если ИменаФайлов.Найти(текИмя)=Неопределено Тогда
			ИменаФайлов.Добавить(текИмя);
		КонецЕсли; 
	КонецЦикла; 
	Возврат ИменаФайлов;
КонецФункции // ПолучитьИменаФайловИзстроки()
 
// Для переданного звонка определяем контрагента и контактное лицо по номеру, и заполняем
//соответсвующие строки в таблице звонков
Процедура ОпределитьКонтрагентаКонтактногоЛицаПоНомеру(ТекущийЗвонок = Неопределено) Экспорт 
	Если ТекущийЗвонок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаКЭШ = ТЗ_КЭШ_КИ.Найти(ТекущийЗвонок.CallerID, "CallerID");
	Если НЕ СтрокаКЭШ = Неопределено И СтрокаКЭШ.ДатаАктуальности > ТекущаяДата() Тогда
		ЗаполнитьЗначенияСвойств(ТекущийЗвонок, СтрокаКЭШ);
		Возврат;	
	ИначеЕсли НЕ СтрокаКЭШ = Неопределено Тогда
		// Кэш не аткуален
		ТЗ_КЭШ_КИ.Удалить(СтрокаКЭШ);	
	КонецЕсли; 
	
	CallerID = СокрЛП(ТекущийЗвонок.CallerID);
	Если "CDR_RECORDS" = CallerID Тогда	
		ТекущийЗвонок.Контрагент		=	"Прослушивание записи";
		ТекущийЗвонок.КонтактноеЛицо	=	"";
	  	Возврат;
	КонецЕсли; 
	// Город абонента / начало
	Если НЕ ОпределитьВнутреннийВнешнийЗвонок(CallerID) = ТипВнутреннийВнешнийЗвонок.Внутренний Тогда
		СтруктураОтвета 	= ПолучитьДанныеОбАбоненте(CallerID);
		ЗаполнитьЗначенияСвойств(ТекущийЗвонок, СтруктураОтвета);
	КонецЕсли;
	// Город абонента / конец
	
	Запрос = мОбщийМодуль.ПолучитьЗапросОпределитьКонтрагентаКонтактногоЛицаПоНомеру(ТекущийЗвонок.Контрагент);
	Если Найти(ТекущийЗвонок.Контрагент, "Skype:") Тогда
		ТелДляПоиска= СтрЗаменить(CallerID,"Skype:","");
	Иначе	
		ТелДляПоиска = мОбработкаДанных.ПреобразоватьНомерДляСохранения(CallerID, ГлобальныеПеременные.глКоличествоХранимыхЦифрТелефона);
		Если ТелДляПоиска = 0 Тогда Возврат; КонецЕсли; 
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТипКИ", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("ТелефонДляПоиска", ТелДляПоиска);
	Результат 	= Запрос.Выполнить();
	Выборка 	= Результат.Выбрать();
	
	РезультатНайден = Выборка.Следующий();
	Если НЕ РезультатНайден 		
		 И СтрДлина(CallerID) > 4 И СтрДлина(CallerID) < 8 
		 И ЗначениеЗаполнено(ГлобальныеПеременные.глКодГорода) Тогда
		 
		врCallerID = "" + ГлобальныеПеременные.глКодСтраны + ГлобальныеПеременные.глКодГорода + CallerID;
		ТелДляПоиска = мОбработкаДанных.ПреобразоватьНомерДляСохранения(врCallerID, ГлобальныеПеременные.глКоличествоХранимыхЦифрТелефона);
		Запрос.УстановитьПараметр("ТелефонДляПоиска", ТелДляПоиска);
		Результат 		= Запрос.Выполнить();
		Выборка 		= Результат.Выбрать();
		РезультатНайден = Выборка.Следующий();
	
	КонецЕсли; 
	
	
	ТекущийЗвонок.Контрагент		=	"Неизвестный контрагент";
	ТекущийЗвонок.КонтактноеЛицо	=	"";
	
	Если РезультатНайден Тогда 
		ДанныеЗаполнения = мОбщийМодуль.ПолучитьДанныеЗаполненияОпределитьКонтрагентаКонтактногоЛицаПоНомеру(Выборка);
		ЗаполнитьЗначенияСвойств(ТекущийЗвонок, ДанныеЗаполнения);
	Иначе
		// Для внутренних номеров поищим в таблице сотрудников
		Для каждого ТекущийСотрудник Из Сотрудники Цикл
			Если ТекущийСотрудник.ВнутреннийНомер = CallerID
				ИЛИ Найти(ТекущийСотрудник.КаналСотрудника, СокрЛП(CallerID))>0 Тогда
				ТекущийЗвонок.Контрагент		=	ТекущийСотрудник.Сотрудник;
				ТекущийЗвонок.КонтактноеЛицо	=	"-< сотрудник >-";
				Прервать;
			КонецЕсли; 			
		КонецЦикла; 
	КонецЕсли; 
	
	СтрокаКЭШ = ТЗ_КЭШ_КИ.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаКЭШ, ТекущийЗвонок);
	СтрокаКЭШ.ДатаАктуальности = ТекущаяДата()+120; // Две минуты актуальность ХЭШ.
	
Конецпроцедуры	

// Поиск абонента по части наименования.
// 
Функция НайтиАбонентаПоИмени(ИмяАбонента)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ЗапросПоискПоИмени();
	Запрос.УстановитьПараметр("ЗначениеОтбора", "%" + ИмяАбонента + "%");
	РезультатЗапроса = Запрос.Выполнить();
	
	Список = Новый Массив;
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.НомерТелефона <> "" Тогда
				Список.Добавить(Новый Структура("Абонент,НомерТелефона,Владелец", Выборка.Ссылка, Выборка.НомерТелефона, Выборка.Владелец));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Список;
	
КонецФункции // НайтиАбонентаПоИмени()
// Формирует текст запроса для поиска контакта по части имени абонента.
// Параметры
//   ПараметрыКонфигурации - текущие настройки / свойства конфигурации
// Возвращаемое значение
//   Текст запроса к базе данных. Тип - строка.
//
Функция ЗапросПоискПоИмени()
	ТекстОбъединить = "		
					  |ОБЪЕДИНИТЬ ВСЕ
					  |";

	ТекстЗапроса = 	"ВЫБРАТЬ ПЕРВЫЕ 5
		|	СпрКонтакт.Ссылка,
		|	"""" КАК Владелец
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Справочник.Контрагенты КАК СпрКонтакт
		|ГДЕ
		|	СпрКонтакт.ПометкаУдаления = ЛОЖЬ
		|	И СпрКонтакт.Наименование ПОДОБНО &ЗначениеОтбора
		|";
	
	КонтактныеЛицаКонтрагентов = Метаданные.Справочники.Найти("КонтактныеЛицаКонтрагентов");
	Если КонтактныеЛицаКонтрагентов <> Неопределено Тогда
		Если ТекстЗапроса <> "" Тогда ТекстЗапроса = ТекстЗапроса+ТекстОбъединить; КонецЕсли; 
		
		ТекстЗапроса = ТекстЗапроса +
			"ВЫБРАТЬ ПЕРВЫЕ 5
			|	СпрКонтакт.Ссылка,
			|	СпрКонтакт.Владелец КАК Владелец
			|ИЗ
			|	Справочник.КонтактныеЛицаКонтрагентов КАК СпрКонтакт
			|ГДЕ
			|	СпрКонтакт.ПометкаУдаления = ЛОЖЬ
			|	И СпрКонтакт.Наименование ПОДОБНО &ЗначениеОтбора
			|";
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("Пользователи") <> Неопределено Тогда
		Если ТекстЗапроса <> "" Тогда ТекстЗапроса = ТекстЗапроса+ТекстОбъединить; КонецЕсли; 
		ТекстЗапроса = ТекстЗапроса +
			"ВЫБРАТЬ ПЕРВЫЕ 5
			|	СпрКонтакт.Ссылка,
			|	"""" КАК Владелец
			|ИЗ
			|	Справочник.Пользователи КАК СпрКонтакт
			|ГДЕ
			|	СпрКонтакт.ПометкаУдаления = ЛОЖЬ
			|	И СпрКонтакт.Наименование ПОДОБНО &ЗначениеОтбора
			|";
	КонецЕсли;
	
	КонтактныеЛица = Метаданные.Справочники.Найти("КонтактныеЛица");
	Если КонтактныеЛица <> Неопределено 
		 И КонтактныеЛица.Реквизиты.Найти("ОбъектВладелец")<>Неопределено Тогда
		Если ТекстЗапроса <> "" Тогда ТекстЗапроса = ТекстЗапроса+ТекстОбъединить; КонецЕсли; 
		ТекстЗапроса = ТекстЗапроса +
			"ВЫБРАТЬ ПЕРВЫЕ 5
			|	СпрКонтакт.Ссылка,
			|	СпрКонтакт.ОбъектВладелец КАК Владелец
			|ИЗ
			|	Справочник.КонтактныеЛица КАК СпрКонтакт
			|ГДЕ
			|	СпрКонтакт.ПометкаУдаления = ЛОЖЬ
			|	И СпрКонтакт.Наименование ПОДОБНО &ЗначениеОтбора
			|";
	КонецЕсли;

	КонтактныеЛица = Метаданные.Справочники.Найти("Организации");
	Если КонтактныеЛица <> Неопределено Тогда
		Если ТекстЗапроса <> "" Тогда ТекстЗапроса = ТекстЗапроса+ТекстОбъединить; КонецЕсли; 
		ТекстЗапроса = ТекстЗапроса +
			"ВЫБРАТЬ ПЕРВЫЕ 5
			|	СпрКонтакт.Ссылка,
			|	"""" КАК Владелец
			|ИЗ
			|	Справочник.Организации КАК СпрКонтакт
			|ГДЕ
			|	СпрКонтакт.ПометкаУдаления = ЛОЖЬ
			|	И СпрКонтакт.Наименование ПОДОБНО &ЗначениеОтбора
			|";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса +  
		";
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Ссылка,
		|	ВТ.Владелец,
		|	"""" + КонтактнаяИнформация.Поле1 + КонтактнаяИнформация.Поле2 + КонтактнаяИнформация.Поле3 КАК НомерТелефона
		|ИЗ
		|	ВТ КАК ВТ
		|		Внутреннее СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
		|		ПО ВТ.Ссылка = КонтактнаяИнформация.Объект
		|ГДЕ
		|	КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)";
	
	Возврат ТекстЗапроса;
КонецФункции // ЗапросПоискПоИмени()

// По номеру строки определяет текущий актривный канал абонента, пользователя 1С:CRM
//
Функция ПолучитьАктивныйКанал(НомерСтроки)
	ТекСтрокаЗвоноков=Звонки[НомерСтроки-1];
	Если ТекСтрокаЗвоноков.ВходящийЗвонок Тогда
		Возврат ТекСтрокаЗвоноков.Канал2;
	Иначе	
		Возврат ТекСтрокаЗвоноков.Канал1;
	КонецЕсли;
КонецФункции	

// По переданному уникальному идентификатору производится поиск звонков в табличной части звонки, 
// при условии, что совпадает левая часть идентификатора перед точкой.
//
// Параметры:
// 			УИД	-	Строка	-	Уникальный идентификатор звонка
//		
//Возвращаемое значение:
//			Строка из табличной части звонки или Неопределено
//
Функция ПолучитьСтрокиЗвонкаПоУникальномуИдентификатору(УИД)
	
	МассивЗвонков=Новый Массив;
	Для каждого Звонок Из Звонки Цикл
		Если 	Найти(Звонок.UniqueID1, УИД) 
			ИЛИ Найти(Звонок.UniqueID2, УИД) Тогда
			МассивЗвонков.Добавить(Звонок);
		КонецЕсли; 
	КонецЦикла;    	
	
	Возврат МассивЗвонков;
КонецФункции // ПолучитьСтрокиЗвонкаПоУникальномуИдентификатору()

// Добавляет строку в таблицу звонков, после чего оповещяет основную форму обработки 
// 
Функция ДобавитьСтрокуЗвонка() Экспорт
	СтрокаЗвонка = Звонки.Добавить();
	СтрокаЗвонка.АвтоПодъемВозможен = Истина;	
	// передаем управление в основную форму обработки
	Оповестить("ОбновитьТаблицуПропущенных");
	Возврат СтрокаЗвонка;
КонецФункции // ДобавитьСтрокуЗвонка()

// Удаляет строку из таблицы звонков, после чеого оповещает основную форму обработки
//
Процедура УдалитьСтрокуЗвонкаПоИндексу(ИндексСтроки) Экспорт
	Если ТипЗнч(ИндексСтроки) = Тип("Число") Тогда
		МаксимальныйИндекс = Звонки.Количество() - 1;
		Если ИндексСтроки > МаксимальныйИндекс Тогда
			// ошибочная ситуация
			Возврат;
		КонецЕсли;
		СтрочкаЗвонка = Звонки.Получить(ИндексСтроки);
	Иначе
		СтрочкаЗвонка = ИндексСтроки;
	КонецЕсли;
	Звонки.Удалить(СтрочкаЗвонка);
	// передаем управление в основную форму обработки
	Оповестить("ОбновитьТаблицуПропущенных");
		
КонецПроцедуры

