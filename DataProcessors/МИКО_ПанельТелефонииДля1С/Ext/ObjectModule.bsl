// Инициализация вспомогательных модулей панели телефонии.
// 
Процедура ИнициализироватьОсновныеДопМодули() Экспорт
	// общий для всех модуль
	мОбработкаДанных = ЭтотОбъект.ПолучитьФорму("мОбработкаДанных");
	
	// 
	// подключение дополнительных модулей
	Если ДопМодули = Неопределено Тогда
		ДопМодули = Новый Структура;
		ДопМодули.Вставить("НаборНомера", ЭтотОбъект.ПолучитьФорму("МодульSIP"));
	КонецЕсли; 
	
	// Этап 1: подключаем первичные доп модули
	ИмяОбщегоМодуля = ПолучитьИмяОбщегоМодуля();
	Если ИмяОбщегоМодуля = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	ИнициализироватьОбщийМодуль(ИмяОбщегоМодуля);
	
	// первоначальное заполнение глобальных переменных	
	ГлобальныеПеременные = мОбщийМодуль.ПолучитьГлобальныеПеременные();
	ГлобальныеПеременные.Вставить("глИспользоватьПанельТелефонии", БезИнтеграционныйРежим);	
	
КонецПроцедуры

// Инициализация общего модуля - специфичного для конкретной кофнигурации
// 
Функция ИнициализироватьОбщийМодуль(ИмяОбщегоМодуля) Экспорт
	Попытка
		мОбщийМодуль 	 = ЭтотОбъект.ПолучитьФорму(ИмяОбщегоМодуля);
	    мПользователь 	 = мОбщийМодуль.ПолучитьТекущегоПользователя();
	 	Возврат Истина;
	Исключение
	 	Возврат Ложь;
	КонецПопытки; 
КонецФункции

// Получение имени основного вспомогательного модуля панели телефонии.
// 
Функция ПолучитьИмяОбщегоМодуля() Экспорт
	ИмяМодуля = Неопределено; 
	
	тмпИмяКонфигурации = мОбработкаДанных.ПолучитьНастройкиИзХранилища("MIKO","ИмяКонфигурации",,ИмяТекущегоПользователя);
	ИмяТекущейКонфигурации = ?(ЗначениеЗаполнено(тмпИмяКонфигурации),тмпИмяКонфигурации,Метаданные.Имя); 
	ВерсияК = Метаданные.Версия;
	
	Если ИмяТекущейКонфигурации = "Автосалон5" Тогда
		ИмяМодуля = "мОбщийМодуль_АльфаАвто";
	ИначеЕсли ИмяТекущейКонфигурации = "Автоматизация_1СФранчайзи"
		ИЛИ ИмяТекущейКонфигурации = "УправлениеТорговлей_CRMПроф"
		ИЛИ ИмяТекущейКонфигурации = "CRM"
		ИЛИ ЭтоCRMКонфигурация() Тогда
		ИмяМодуля = "мОбщийМодуль_CRM";
	ИначеЕсли (ИмяТекущейКонфигурации = "УправлениеТорговлей" И Лев(ВерсияК, 4) = "10.3")
		ИЛИ ИмяТекущейКонфигурации = "УправлениеПроизводственнымПредприятием"
		ИЛИ ИмяТекущейКонфигурации = "КомплекснаяАвтоматизация"
		ИЛИ ИмяТекущейКонфигурации = "УправлениеТорговымПредприятиемДляУкраины"
		ИЛИ ИмяТекущейКонфигурации = "УправлениеТорговымПредприятиемДляКазахстана"
		ИЛИ (ИмяТекущейКонфигурации = "УправлениеТорговлейДляУкраины" И Лев(ВерсияК, 3) = "2.3") 
		ИЛИ ИмяТекущейКонфигурации = "УправлениеПроизводственнымПредприятиемДляУкраины" Тогда
		ИмяМодуля = "мОбщийМодуль_УТ10_3";
	ИначеЕсли ИмяТекущейКонфигурации = "УправлениеТорговлей" И Лев(ВерсияК, 4) = "10.2" Тогда	
		ИмяМодуля = "мОбщийМодуль_УТ10_2";
	ИначеЕсли ИмяТекущейКонфигурации = "БухгалтерияПредприятия"
		ИЛИ ИмяТекущейКонфигурации = "БухгалтерияДляУкраины" Тогда
		ИмяМодуля = "мОбщийМодуль_БП2_0";
	ИначеЕсли ИмяТекущейКонфигурации = "ТрактиръFrontOffice" Тогда
		ИмяМодуля = "мОбщийМодуль_ТрактиръFrontOffice";					
	Иначе
		// Это не известная конфигурация
		// следует запустить стартовый помощник
		// и определить параметры запуска
		Если КонтрольПервогоЗапуска() Тогда
			ПолучитьИмяОбщегоМодуля();
		
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИмяМодуля;
КонецФункции // ПолучитьИмяОбщегоМодуля()
// Является ли текущая конфигурация CRM от Рарус.
// 
Функция ЭтоCRMКонфигурация() Экспорт
	ЭтоCRM = (НЕ Метаданные.Константы.Найти("CRM_ИспользуемыйСофтФон") = Неопределено);	
	Возврат ЭтоCRM;
КонецФункции // ЭтоCRMКонфигурация()

// Удаление временных фалов дополнительных модулей
// 
Процедура ОсвободитьДопМодули() Экспорт
	Если НЕ ТипЗнч(ДопМодули) = Тип("Структура") Тогда
		Возврат;	
	КонецЕсли;  
	
	// чистим временные файлы
	Для каждого Модуль Из ДопМодули Цикл
		Если НЕ ДопМодули[Модуль.Ключ] = Неопределено
			И НЕ ТипЗнч(ДопМодули[Модуль.Ключ]) = Тип("Строка") Тогда
			ДопМодули[Модуль.Ключ].Деструктор();
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

// Поиск исходного канала. Если имеется локальный канал, то необходимо найти действительный.
// С локальным каналом можно производить не все операции AMI.
// Поиск производится по таблице связей каналов.
// 
// Параметры 
//   ИмяКанала - <Строка>, имя локального канала
// 
Функция ПоискРеальногоКанала(ИмяКанала, cid_chan=Неопределено, cid_sob=Неопределено, БезDial=Истина)
	врИсхКанал = ИмяКанала;
	
	КоличествоИтераций = 10;
	сч = 0;
	
	Пока сч < КоличествоИтераций И ИмяКанала <> Неопределено Цикл
		
		ИмяКанала = ПоискПоСвязямКаналов(ИмяКанала, cid_chan, cid_sob, БезDial);
		
		Если Найти(ВРЕГ(ИмяКанала), "LOCAL") <> 0 Тогда
			сч = сч+1;
			Продолжить;
		Иначе
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;
	
	// ничего не нашли
	ИмяКанала = врИсхКанал;
	cid_chan  = "";
	cid_sob   = "";
	
	Возврат Ложь;
КонецФункции // ПоискРеальногоКанала()

// Поиск нашего канала.
Функция НайтиИсходныеКаналы(Channel)
	вр_Каналы = Новый Структура("chan1,chan2",Неопределено, Неопределено);
	// Ищем СВОЙ Канал
	Если Найти(ВРЕГ(Channel), "LOCAL")>0 Тогда
		врChannel  = мОбработкаДанных.ОтсечьПлечоВLocal(Channel, Ложь);
		п1_Channel = врChannel + ";2";
		п2_Channel = врChannel + ";1";
		
		ПоискРеальногоКанала(п1_Channel, Неопределено, Неопределено, Ложь);
		ПоискРеальногоКанала(п2_Channel, Неопределено, Неопределено, Ложь);
		// НАШ канал
		Если Найти(ВРЕГ(п1_Channel), "LOCAL")=0 Тогда
			вр_Каналы.chan1 = п1_Channel;			
		КонецЕсли; 
		Если Найти(ВРЕГ(п2_Channel), "LOCAL")=0 Тогда
			вр_Каналы.chan2 = п2_Channel;			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат вр_Каналы;
КонецФункции // НайтиНашКанал()
 

// <Описание процедуры>
//
Функция ПоискПоСвязямКаналов(Знач ИмяКанала, cid_chan=Неопределено, cid_sob=Неопределено, БезDial=Истина)

	// допустим имеем канал  Local/04@internal-caller-transfer-000001f0;2
	Если Найти(ВРЕГ(ИмяКанала), "LOCAL")=0 Тогда
	 	Возврат Неопределено;
	КонецЕсли; 
	
	// базовое имя канала  Local/04@internal-caller-transfer-000001f0
	LocalКанал = мОбработкаДанных.ОтсечьПлечоВLocal(ИмяКанала, Ложь);
	
	// нам надо найти, с каким каналом связано его второе плечо
	// Local/04@internal-caller-transfer-000001f0;1
	ИмяПлеча = ?(Найти(ИмяКанала, ";2"), ";1", ";2");
	КаналДляПоиска = ""+LocalКанал+ИмяПлеча;
	
	Если БезDial = Истина Тогда
		// найдем связь канала
		МассивСтрок  = СвязиКаналов.НайтиСтроки(Новый Структура("Канал1,Dial", КаналДляПоиска, Ложь));
		МассивСтрок2 = СвязиКаналов.НайтиСтроки(Новый Структура("Канал2,Dial", КаналДляПоиска, Ложь));
		Для Каждого Элм Из МассивСтрок2 Цикл
			МассивСтрок.Добавить(Элм);
		КонецЦикла;
		Если МассивСтрок.Количество() = 0 Тогда
		 	Возврат Неопределено;
		Иначе
			СтрокаСвязи = МассивСтрок[0];
		КонецЕсли; 

	Иначе	
		СтрокаСвязи = СвязиКаналов.Найти(КаналДляПоиска, "Канал1,Канал2");
		
		Если СтрокаСвязи = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли; 
	КонецЕсли; 
	
	Если СтрокаСвязи.Канал1 = КаналДляПоиска Тогда
		cid_chan = СтрокаСвязи.cid1;
		cid_sob =  СтрокаСвязи.cid2;
		Возврат СтрокаСвязи.Канал2;
	Иначе
		cid_chan = СтрокаСвязи.cid2;
		cid_sob =  СтрокаСвязи.cid1;
		Возврат СтрокаСвязи.Канал1;
	КонецЕсли;

КонецФункции // ПоискПоСвязямКаналов()

