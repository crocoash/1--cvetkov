		КонецЕсли; 
		Оповестить("ОбновитьТаблицуПропущенных");
	ИначеЕсли CDR.disposition = "ANSWERED" Тогда	
		мОбработкаДанных.УдалитьСтрокуПропущенного(CDR.uniqueid);
	КонецЕсли; 
	
КонецПроцедуры

// Вычисление шестнадцатиричного значения числа
//
Функция hex(Знач Значение)
	Значение=Число(Значение);
	Если Значение<=0 Тогда
		Результат="0";
	Иначе
		Значение=Цел(Значение);
		Результат="";
		Пока Значение>0 Цикл
			Результат=Сред("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ",Значение%16 + 1,1)+Результат;
			Значение=Цел(Значение/16) ;
		КонецЦикла;
	КонецЕсли;
	Если СтрДлина(Результат) < 2 Тогда
		
		Результат = "0" + Результат;
		
	КонецЕсли;
	Возврат "%" + Результат;
КонецФункции

// Преобразование переданной строки в URLencoded версию
//
Функция URLEncode(URL)
    Рез = "";
    Для Сч = 1 По СтрДлина(URL) Цикл

        ch = Сред(URL,Сч,1);
        vch = КодСимвола(ch);
        Если (vch = 8470)  Тогда                            //Number    
            Рез = Рез + "%E2%84%96";    
        ИначеЕсли ("A" <= ch ) И ( ch <= "Z") Тогда        // "A".."Z" 
            Рез = Рез + ch;
        ИначеЕсли ("a" <= ch ) И ( ch <= "z") Тогда    // "a".."z" 
            Рез = Рез + ch;
        ИначеЕсли ("0" <= ch ) И ( ch <= "9") Тогда    // "0".."9" 
            Рез = Рез + ch;
        ИначеЕсли (ch = " ") ИЛИ ( ch = "+") Тогда            // space
            Рез = Рез + "%20";
        ИначеЕсли (ch = "-" ) ИЛИ ( ch = "_") Тогда        // unreserved
            // ch == '.' || ch == '!'
            // ch == '~' || ch == '*'
            // ch == '\'' || ch == '('
            // ch == ')') Тогда
            Рез = Рез + ch;
        ИначеЕсли (vch <= 127) Тогда        // other ASCII
            Рез = Рез + hex(vch);
        ИначеЕсли (vch <= 2047) Тогда        // non-ASCII <= 0x7FF
            Рез = Рез + hex(192 + Цел(vch / 64));
            Рез = Рез + hex(128 + (vch % 64));
        Иначе                    // 0x7FF < ch <= 0xFFFF
            Рез = Рез + hex(224 + Цел(vch / 4096));
            Рез = Рез + hex(128 + (Цел(vch / 64) % 64));
            Рез = Рез + hex(128 + (vch % 64));
        КонецЕсли;
    КонецЦикла;

    Возврат Рез;
КонецФункции // URLEncode()

// Отправка статистической информации в МИКО
// 
Процедура SendMetrikaStat(врКомпонент) Экспорт
	Если врКомпонент = Неопределено Тогда
		SDK = Компонент;
	Иначе
		SDK = врКомпонент;
	КонецЕсли;
	Если ОтправилиМетрику = Истина ИЛИ SDK=Неопределено Тогда
	 	Возврат;
	КонецЕсли; 
	
	Metrika = Новый Структура;
    Metrika.Вставить("Конфигурация", Метаданные.Имя);
    Metrika.Вставить("РежимЗапуска", Метаданные.ОсновнойРежимЗапуска);
	
	Система = Новый СистемнаяИнформация;
    Metrika.Вставить("Платформа", 	  	Система.ВерсияПриложения);
	Metrika.Вставить("ТипПлатформы", 	Система.ТипПлатформы);
	Metrika.Вставить("ВерсияОС",  	  	Система.ВерсияОС);
	
	ДанныеСтатистики = Новый Соответствие;
	ДанныеСтатистики.Вставить("platform1c",		Metrika.Платформа);
	ДанныеСтатистики.Вставить("PBXname",		НазваниеPBX);
	ДанныеСтатистики.Вставить("DialplanVer",	ВерсияДиалплана);
	ДанныеСтатистики.Вставить("SoftPhone",  	ВидСофтфонаПользователя);
	ДанныеСтатистики.Вставить("config1c",		Metrika.Конфигурация);
	ДанныеСтатистики.Вставить("DefaultRunMode",	Metrika.РежимЗапуска);
	ДанныеСтатистики.Вставить("PlatformType",	Metrika.ТипПлатформы);
	ДанныеСтатистики.Вставить("OSVersion",		Metrika.ВерсияОС);
	ДанныеСтатистики.Вставить("pt1c_Version",	Версия());
	
	Если ИспользоватьСофтфон = Истина Тогда
		ДанныеСтатистики.Вставить("SIPMode","On");
	Иначе
		ДанныеСтатистики.Вставить("SIPMode","Off");
	КонецЕсли;
	Если ИспользоватьAsterisk Тогда
		ДанныеСтатистики.Вставить("AsteriskMode","On");
	Иначе
		ДанныеСтатистики.Вставить("AsteriskMode","Off");
	КонецЕсли;
	Если ИспользоватьБаннер = Истина Тогда
		ДанныеСтатистики.Вставить("webkit_mode","On");
	Иначе	
		ДанныеСтатистики.Вставить("webkit_mode","Off");
	КонецЕсли; 
	ДанныеСтатистики.Вставить("other","");
	
	Данные = "<metrika>";
	Для каждого ТекПараметр Из ДанныеСтатистики Цикл
		Если ЗначениеЗаполнено(ТекПараметр.Значение) Тогда
			Данные = Данные+Символы.ПС+"<param name="""+ТекПараметр.Ключ+""" value="""+ЭкранироватьСпецСимволыXML(ТекПараметр.Значение)+"""/>";
		КонецЕсли; 
	КонецЦикла; 

	Данные = Данные+"</metrika>";
	Данные = URLEncode(Данные);
	
	Попытка
		SDK.SendMetrika(Данные);
		ОтправилиМетрику = Истина;
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Ищем в списке сотрудника с соответсвующим каналом и устанавливаем ему состояние
//
Процедура ОбновитьСостояниеСотрудника(Канал,Состояние) Экспорт
	Для каждого СтрочкаСотрудники Из Сотрудники Цикл
		
		Если ЗначениеЗаполнено(СтрочкаСотрудники.КаналСотрудника)
			И Найти(Канал,СтрочкаСотрудники.КаналСотрудника)>0	Тогда
			
			Если Состояние = СостояниеЭкстеншена.Свободен
				 ИЛИ Состояние = СостояниеЭкстеншена.Недоступен Тогда
				СтрочкаСотрудники.Собеседник = "";
			КонецЕсли;
			                                         
			Если НЕ ИспользоватьAsterisk И (Состояние = СостояниеЭкстеншена.ИдетВхЗвонок) Тогда
				СтрочкаСотрудники.Ringing = Истина;
				Продолжить;
			ИначеЕсли ИспользоватьAsterisk 
					  И (Состояние = СостояниеЭкстеншена.ИдетВхЗвонок ИЛИ Состояние = СостояниеЭкстеншена.Разговаривает) Тогда
				СтрочкаСотрудники.Ringing = Истина;
				Продолжить;
			КонецЕсли;
			
			СтрочкаСотрудники.Ringing = Ложь;
			СтрочкаСотрудники.Состояние=Состояние;
			
			// Оповестим формы об изменении
			Если СтрочкаСотрудники.Сотрудник = мПользователь Тогда
				// Обновление состояние нащего номера
				Оповестить("ОбновитьОтображениеСтатусов");
			КонецЕсли;

		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

// Отправить файл Источник на виртуальный принтер и 
// сохранить результат (tiff grayscale) его преобразования в Назначение
// Ждать создания файла 10 циклов.
Функция ПодготовитьPDFФайлДляОтправки(ИмяФайлаТабДок)
	
	ТекущаяДатаВФормате=Формат(ТекущаяДата(),"ДФ=ddMMyyhhmmss");
	ИмяФайла = КаталогВременныхФайлов()+СтрЗаменить(НашКаналФильтр,"/","-")+ТекущаяДатаВФормате+"-fax";
	
	Если ТипЗнч(ИмяФайлаТабДок)=Тип("Строка") Тогда
		Если Прав(ИмяФайлаТабДок, 4) = ".tif" Тогда
			// перобразование tif To pdf не требуется
			ИмяФайла = ИмяФайла+".tif";
		Иначе
			ИмяФайла = ИмяФайла+".pdf";
			ИмяФайлаДляОтправки	= ПреобразоватьPDFвTIF(ИмяФайла);                     
		КонецЕсли;
		
		КопироватьФайл(ИмяФайлаТабДок,ИмяФайла);
		Возврат ИмяФайла;
	ИначеЕсли ТипЗнч(ИмяФайлаТабДок)=Тип("ТабличныйДокумент")
		ИЛИ ТипЗнч(ИмяФайлаТабДок)=Тип("ПолеТабличногоДокумента") Тогда
		ИмяФайла = ИмяФайла+".pdf";
		ИмяФайлаТабДок.Записать(ИмяФайла,ТипФайлаТабличногоДокумента.PDF);
		Возврат ИмяФайла;
	Иначе
		Возврат Неопределено;
	КонецЕсли; 
	
КонецФункции // ПодготовитьPDFФайлДляОтправки()

// При помощи библиотеки GHOSTSCRIPT конвертируем PDF в Tif 
// рекомендуется использование последней версии библиотеки ghostscript 
// программа для установки доступна по ссылке 
//  Для 32 битной системы
//  	http://downloads.ghostscript.com/public/gs905w32.exe 
//  Для 64 битной системы
//		http://downloads.ghostscript.com/public/gs905w64.exe
//
Функция ПреобразоватьPDFвTIF(ИмяФайлаPDF)
	
	Если GhostScriptУстановленНаAsterisk  Тогда  //конвертация на стороне сервера Asterisk
		Возврат ИмяФайлаPDF;
	КонецЕсли; 
	
	Система = Новый СистемнаяИнформация;
	Shell = Новый COMОбъект("WScript.Shell");
	ПапкаProgramFiles = Shell.ExpandEnvironmentStrings("%ProgramFiles%");
	
	ИмяФайлаGhostScript = ПолучитьПутьКИсполняемомуфайлуGhostScript(ПапкаProgramFiles);
	Если ИмяФайлаGhostScript = "" Тогда
		СообщитьОтладочнуюИнформацию("Отправка факсов: ", "в каталоге ""%ProgramFiles%\gs\"" найден исполняемый файл GhostScript.");
		Возврат Неопределено;
	КонецЕсли; 
	ИмяФайлаTif = мОбработкаДанных.УбратьРасширениеВФайлеЗаписи(ИмяФайлаPDF)+".tif";
	
	// При использовании КомандаСистемы и ЗапуститьПриложение уходит фокус с окна 1С,
	// WScript  позволяет выполнить все в фоне.
	Shell.Run("cmd /c """+ИмяФайлаGhostScript+""" -q -dNOPAUSE -dBATCH -dSAFER -sDEVICE=tiffg3 -sOutputFile="+ИмяФайлаTif+" -f "+ИмяФайлаPDF, 0);
	
	ФС=Новый Файл(ИмяФайлаTif);
	
	СтопКран = 0;
	Пока НЕ ФС.Существует() И СтопКран<50000  Цикл // если ваша система очень медленно создает нужный tif то можно попробовать увеличить цифру 50000
		СтопКран=СтопКран+1; 
	КонецЦикла;
	
	Если ФС.Существует() Тогда
		Возврат ИмяФайлаTif;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции //ПреобразоватьPDFвTIFF()

// Поиск исполняемого файла GhostScript в файловой системе
//
Функция ПолучитьПутьКИсполняемомуфайлуGhostScript(ПапкаProgramFiles)
	ИмяФайлаGhostScript = "";
	МассивФайлов = НайтиФайлы(ПапкаProgramFiles + "\gs", "gswin??c.exe", Истина);
	Если МассивФайлов.Количество() > 0 Тогда
		Возврат МассивФайлов[0].ПолноеИмя;
	КонецЕсли; 
	
	МассивФайлов = НайтиФайлы(СтрЗаменить(ПапкаProgramFiles," (x86)","") + "\gs", "gswin??c.exe", Истина);
	Если МассивФайлов.Количество() > 0 Тогда
		Возврат МассивФайлов[0].ПолноеИмя;
	КонецЕсли;
	
	Возврат ИмяФайлаGhostScript;
КонецФункции // ПолучитьПутьКИсполняемомуфайлуGhostScript()

// По переданному названию используемого софтфона возвращает строку автоподъема трубки.
//
Функция ВернутьСтрокуАвтоподъемаТрубки(НазваниеСофтфона, ТолькоЗаголовок=Ложь) Экспорт
	Результат = ?(ТолькоЗаголовок=Ложь, "SIPADDHEADER=", "");
	Заголовок="";
	
	Если ИспользоватьСофтфон Тогда
		Заголовок = """Call-Info:\;answer-after=0""";
	ИначеЕсли Найти(НазваниеСофтфона,"Linksys")>0
		ИЛИ Найти(НазваниеСофтфона,"Cisco")>0
		ИЛИ Найти(НазваниеСофтфона,"MIKO Lab SoftPhone")>0
		ИЛИ Найти(НазваниеСофтфона,"Telephone-PT1C")>0 
		ИЛИ Найти(НазваниеСофтфона,"Grandstream")>0 Тогда
		Заголовок = """Call-Info:\;answer-after=0""";
    ИначеЕсли Найти(НазваниеСофтфона,"Yealink")>0 ИЛИ Найти(НазваниеСофтфона,"VP530P")>0 Тогда
        Заголовок = """Call-Info:answer-after=0""";
	ИначеЕсли Найти(НазваниеСофтфона,"Aastra")>0 Тогда
		Заголовок = """Alert-Info: info=alert-autoanswer""";
	ИначеЕсли Найти(НазваниеСофтфона,"Polycom")>0 Тогда
		Заголовок = """Alert-Info: Ring Answer""";
	ИначеЕсли Найти(НазваниеСофтфона, "Jitsi") > 0 Тогда
		Заголовок = """Alert-Info:Auto Answer""";
	ИначеЕсли Найти(Нрег(НазваниеСофтфона),"microsip")>0 Тогда
		Заголовок = """Call-Info:\;answer-after=0""";
	ИначеЕсли Найти(НазваниеСофтфона,"Snom")>0 Тогда
		Заголовок = """Call-Info: sip:"+Хост+"\;answer-after=0""";
	КонецЕсли; 	
	
	Результат = ?(Заголовок="","",""+Результат+Заголовок);
	Возврат Результат;
КонецФункции // ВернутьСтрокуАвтоподъемаТрубки()

// Найти строку существующего звонка по переданным атртибутам
//
Функция НайтиСтрочкуЗвонка(XMLУзел, Знач channel1 = Неопределено, Знач channel2 = Неопределено)
	channel 	  = ВРег(ПолучитьЗначениеКнала(XMLУзел, "channel"));
	channel1 	  = ВРег(?(channel1 = Неопределено, ПолучитьЗначениеКнала(XMLУзел, "channel1"), channel1));
	channel2	  = ВРег(?(channel2 = Неопределено, ПолучитьЗначениеКнала(XMLУзел, "channel2"), channel2));
	targetchannel = ВРег(ПолучитьЗначениеКнала(XMLУзел, "targetchannel")); // Для Pickup
	destination   = ВРег(ПолучитьЗначениеКнала(XMLУзел, "destination"));
	
	destchannel   = ПолучитьЗначениеКнала(XMLУзел, "destchannel");   // Для Dial Ast13
	Если НЕ ЗначениеЗаполнено(channel2) И ЗначениеЗаполнено(destchannel) Тогда
		channel2 = ВРег(destchannel);	
	КонецЕсли; 	
	
	Результат = Неопределено;
	
	Для каждого Звонок Из Звонки Цикл
		Канал1 = ВРег(Звонок.Канал1);
		Канал2 = ВРег(Звонок.Канал2);
		
		КаналНайден = Ложь;
		
		Если Звонок.ВходящийЗвонок // входящий ищем в канале 2
			И ( (ЗначениеЗаполнено(channel1) И Найти(Канал2, channel1) > 0) 
			ИЛИ (ЗначениеЗаполнено(channel2) И Найти(Канал2, channel2) > 0)
			ИЛИ (ЗначениеЗаполнено(targetchannel) И Найти(Канал2, targetchannel) > 0)
			) Тогда	
			КаналНайден = Истина;
		ИначеЕсли НЕ Звонок.ВходящийЗвонок // исходящий ищем в канале 1
			И ( (ЗначениеЗаполнено(channel1) И Найти(Канал1, channel1) > 0) 
			ИЛИ (ЗначениеЗаполнено(channel2) И Найти(Канал1, channel2) > 0)) Тогда
			КаналНайден = Истина;
		ИначеЕсли ЗначениеЗаполнено(channel)
			И Найти(Канал1 + Канал2, channel) > 0 Тогда
			// при обратном звонке на мобильный каналы могут быть перетасованы	  
			КаналНайден = Истина;
		ИначеЕсли ЗначениеЗаполнено(destchannel)
			И Канал1 = channel2 Тогда
			// при обратном звонке на мобильный каналы могут быть перетасованы	  
			КаналНайден = Истина;
		ИначеЕсли ЗначениеЗаполнено(destination)
			И Найти(Канал1 + Канал2, destination) > 0 Тогда
			// при обратном звонке на мобильный каналы могут быть перетасованы	  
			КаналНайден = Истина;
		ИначеЕсли Звонок.ВходящийЗвонок 
			И ЭтоЛокальныйНомерТекущегоПользователя(Канал1, мСписокНомеровПользователяДляОбработки)
			И ЗначениеЗаполнено(channel2) 
			И Найти(Канал1, channel2) > 0 Тогда
			// клиент через провайдера позвонил на группу вызовов Local/04, через группу пошел dial на SIP/104
			КаналНайден = Истина;
		КонецЕсли;
		
		Если ПолучитьЗначениеКнала(XMLУзел, "event") = "DialBegin" И Найти(НашКаналФильтр, "PJSIP")=1
			 И (НЕ channel = "" И Звонки.Найти(channel) = Неопределено)
			 И Звонок.ВходящийЗвонок И КаналНайден = Истина
			 И Найти(Звонок.Канал2, НашКаналФильтр) = 1 И Звонок.Канал2 <> destchannel Тогда
			 // Звонок на PJSIP множественная регистрация. Создается несколько каналов на входящий.
			КаналНайден = Ложь;
		 	Продолжить;
		ИначеЕсли КаналНайден = Истина Тогда
			Результат = Звонок;
			Прервать;
		КонецЕсли; 
	КонецЦикла;   
	
	Возврат Результат;
	
КонецФункции // НайтиСтрочкуЗвонка()
// для Local каналов отсекает значение после ";"
// возвращает модифицированное значение
Функция ПолучитьЗначениеКнала(XMLУзел, ИмяАтрибута)
	channel 	  = XMLУзел.ЗначениеАтрибута(ИмяАтрибута);
	channel = мОбработкаДанных.ОтсечьПлечоВLocal(channel, Найти(ВРег(channel), "LOCAL")>0);
	Возврат channel;
КонецФункции // ПолучитьЗначениеКнала()

// разбирает строку XML в соответсвие ключ - значение
//
Функция РазобратьОтветАстерискаБезЧтенияХМЛ(Данные)
	
	МассивПодстрок = мОбработкаДанных.мРазложитьСтрокуВМассивПодстрок(Данные," ");
	
	ПараметрыОтвета=Новый Соответствие;
	Для к=0 по МассивПодстрок.Количество()-1 Цикл
		СтрокаДляРазбора	= СокрЛП(МассивПодстрок[к]);
		ПозицияРазделителя	= Найти(СтрокаДляРазбора,"=");
		ДлинаСтроки			= СтрДлина(СтрокаДляРазбора);
		Если ПозицияРазделителя<>0 Тогда
			Параметр=Лев(СтрокаДляРазбора,ПозицияРазделителя-1);
			Значение=Прав(СтрокаДляРазбора,ДлинаСтроки-ПозицияРазделителя-1);
			Значение=Лев(Значение,СтрДлина(Значение)-1);
			ПараметрыОтвета.Вставить(Параметр,Значение);
		КонецЕсли;	
		
	КонецЦикла;	
	Возврат ПараметрыОтвета;
КонецФункции	

// Функция парсит результат команды CLICommand
// Возаращает таблицу значений с колонками : ВнутреннийНомер, Канал, Состояние
Функция РазобратьCoreShowHints(ИсходныйТекст)
	
	// Пример команды
	//<ajax-response>
	//<response type='object' id='unknown'><generic response='Follows' privilege='Command' actionid='118' /></response>
	//<response type='object' id='unknown'><generic opaque_data='    -= Registered Asterisk Dial Plan Hints =-
	//					 40@ext-local           : SIP/40                State:Idle            Watchers  0
	//					126@ext-local           : DAHDI/22              State:Idle            Watchers  0
	//					 04@ext-local           : SIP/04                State:Idle            Watchers  0
	//					 06@ext-local           : SIP/06                State:Unavailable     Watchers  0
	//					 02@ext-local           : SIP/02                State:Unavailable     Watchers  0
	//					 17@ext-local           : SIP/17                State:Unavailable     Watchers  0
	//					 10@ext-local           : SIP/10                State:Unavailable     Watchers  0
	//					 12@ext-local           : SIP/12                State:Idle            Watchers  0
	//					 13@ext-local           : SIP/13                State:Unavailable     Watchers  0
	//					 26@ext-local           : SIP/26                State:Unavailable     Watchers  0
	//					 29@ext-local           : SIP/29                State:Unavailable     Watchers  0
	//					 32@ext-local           : SIP/32                State:Idle            Watchers  0
	//					326@ext-local           : DAHDI/24              State:Idle            Watchers  0
	//					226@ext-local           : IAX2/226              State:Unavailable     Watchers  0
	//----------------
	//- 14 hints registered
	//--END COMMAND--' /></response>
	//</ajax-response>
	
	ТаблицаХинтов = Новый ТаблицаЗначений;
	ТаблицаХинтов.Колонки.Добавить("ВнутреннийНомер",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(32)));
	ТаблицаХинтов.Колонки.Добавить("Канал",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30)));
	ТаблицаХинтов.Колонки.Добавить("Состояние",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30)));
	ТаблицаХинтов.Колонки.Добавить("Контекст",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	ТаблицаХинтов.Колонки.Добавить("UserAgent",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(50)));
	
	// 1_hints_hint_state='Idle' 
	// 1_hints_hint_extension='102' 
	// 1_hints_hint_application='DAHDI/22' 
	Для Х = 1 по СтрЧислоСтрок(ИсходныйТекст) Цикл
		СтрокаДляРазбора = ВРЕГ(СокрЛП(СтрПолучитьСтроку(ИсходныйТекст, Х)));
		
		// 1. Получим внутрений номер
		ВнутреннийНомер = Лев(СтрокаДляРазбора, Найти(СтрокаДляРазбора,"@") - 1);
		
		// 2. Получим канал пользователя
		Канал = "";
		// необходимо отсеч все буквы справа после добавочного
		длинаВремКанала = СтрДлина(СтрокаДляРазбора); ЧислоСимволовКанала = 0;
		ПозицияСпецСимволаSIP 	= Найти(СтрокаДляРазбора, "SIP/");
		ПозицияСпецСимволаIAX 	= Найти(СтрокаДляРазбора, "IAX/");
		ПозицияСпецСимволаIAX2 	= Найти(СтрокаДляРазбора, "IAX2/");
		ПозицияСпецСимволаDAHDI = Найти(СтрокаДляРазбора, "DAHDI/");
		
		Если НЕ ПозицияСпецСимволаSIP = 0 Тогда
			ЧислоСимволовКанала = ПозицияСпецСимволаSIP + 4;
			Канал = "SIP/"
		ИначеЕсли НЕ ПозицияСпецСимволаDAHDI = 0 Тогда 	
			ЧислоСимволовКанала = ПозицияСпецСимволаDAHDI + 6;
			Канал = "DAHDI/"
		ИначеЕсли НЕ ПозицияСпецСимволаIAX = 0 Тогда 	
			ЧислоСимволовКанала = ПозицияСпецСимволаIAX + 4;
			Канал = "IAX/"
		ИначеЕсли НЕ ПозицияСпецСимволаIAX2 = 0 Тогда 	
			ЧислоСимволовКанала = ПозицияСпецСимволаIAX2 + 5;
			Канал = "IAX2/"
		КонецЕсли; 
		
		сч = ЧислоСимволовКанала;
		Пока сч <= длинаВремКанала Цикл
			ОчереднойСимвол = Сред(СтрокаДляРазбора, сч, 1);
			Если СтрЧислоВхождений("1234567890",ОчереднойСимвол) > 0 Тогда
				Канал = Канал + ОчереднойСимвол;
			Иначе
				Прервать;
			КонецЕсли;
			
			сч = сч + 1;	
		КонецЦикла;
		
		// 3. Получим состояние канала
		Если Найти(СтрокаДляРазбора, "Idle") Тогда
			Состояние = "Idle";
		ИначеЕсли Найти(СтрокаДляРазбора, "Unavailable") Тогда	
			Состояние = "Unavailable";
		ИначеЕсли Найти(СтрокаДляРазбора, "In Use") Тогда	
			Состояние = "In Use"
		Иначе 
			Состояние = "---";
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(ВнутреннийНомер) И ЗначениеЗаполнено(Канал) Тогда
			СтрокаHint = ТаблицаХинтов.Добавить();
			СтрокаHint.ВнутреннийНомер = ВнутреннийНомер;
			СтрокаHint.Канал = Канал;
			СтрокаHint.Состояние = Состояние;
		КонецЕсли; 
	КонецЦикла;
	
	Возврат ТаблицаХинтов;
КонецФункции

// Разбор ответа Asterisk по команде DAHDIShowChannels
// функция возвращает массив каналов DAHDI (числовой номер канала)
// 
//<ajax-response>
//<response type='object' id='unknown'><generic response='Follows' privilege='Command' actionid='dd294' opaque_data='   
//   Chan Extension  Context         Language   MOH Interpret        Blocked    State' 
//  pseudo         default                    default                         In Service
//	  2            ANALOG-PHONE-11 en-us      default                         In Service
//	  3            ANALOG-PHONE-11 en-us      default                         In Service
//	  4            ANALOG-PHONE-60 en-us      default                         In Service
//--END COMMAND--
//' /></response>
//</ajax-response>
Функция РазобратьDAHDIShowChannels(ИсходныйТекст)
	МассивНомеровКаналов = Новый Массив;
	
	// предварительно обрежем лишнее из исходного текста
	СпецСимвол = "State";
	ПозицияСпецСимвола = Найти(ИсходныйТекст, СпецСимвол) + СтрДлина(СпецСимвол);
	Если ПозицияСпецСимвола = СтрДлина(СпецСимвол) Тогда
		// это ошибочная ситуация, ответ со стороны АТС возвращен не корректный
		Возврат МассивНомеровКаналов;
	КонецЕсли; 
	ИсходныйТекст = Прав(ИсходныйТекст, СтрДлина(ИсходныйТекст) - ПозицияСпецСимвола);
	
	// парсинг результата
	ЧислоСтрок = СтрЧислоСтрок(ИсходныйТекст);
	Для Х = 1 по ЧислоСтрок Цикл
		СтрокаДляРазбора = СокрЛП(СтрПолучитьСтроку(ИсходныйТекст, Х));
		Если Найти(СтрокаДляРазбора, "END COMMAND")  Тогда
			Прервать;
		КонецЕсли; 
		
		// в номере канала нет пробелов, нас интересует только первая колонка
		МассивПодстрок = мОбработкаДанных.мРазложитьСтрокуВМассивПодстрок(СтрокаДляРазбора, " ");
		Если МассивПодстрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли; 
		// нас интересует значение первого элемента массивы - номер канала
		НомерКанала  = мОбработкаДанных.УбратьИзНомераТелефонаВсеБуквы(МассивПодстрок[0]);
		Если НЕ НомерКанала = "" 
			И МассивНомеровКаналов.Найти(НомерКанала) = Неопределено Тогда
			// добавляем номер канала во временный массив 
			МассивНомеровКаналов.Добавить(НомерКанала);
		КонецЕсли; 
	КонецЦикла;	
	
	Возврат МассивНомеровКаналов;
КонецФункции // РазобратьОтвет(Результат)

// Разбор ответа Asterisk по команде DAHDIShowChannel
// функция возвращает структуру с полями "ВнутреннийНомер,Канал,Состояние,Контекст" тип полей "Строка"
Функция РазобратьDAHDIShowChannel(ИсходныйТекст)
	ОписаниеНомера = Новый Структура("ВнутреннийНомер,Канал,Состояние,Контекст","","","","");
	//<ajax-response>
	//<response type='object' id='unknown'><generic response='Follows' privilege='Command' actionid='727e8' channel='2' file_descriptor='12' span='1' extension='' dialing='no' context='ANALOG-PHONE-11772858565051fbbd422ee' caller_id='101' calling_ton='0' caller_id_subaddress='' caller_id_name='101' mailbox='none' destroy='0' inalarm='0' signalling_type='FXO Kewlstart' radio='0' owner='&lt;None&gt;' real='&lt;None&gt;' callwait='&lt;None&gt;' threeway='&lt;None&gt;' confno='-1' propagated_conference='-1' real_in_conference='0' dsp='no' busy_detection='yes' ____busy_count='3' ____busy_pattern='0,0' tdd='no' relax_dtmf='no' dialing_callwaitcas='0/0' default_law='ulaw' fax_handled='no' pulse_phone='no' gains__rx_tx_='0.00/0.00' dynamic_range_compression__rx_tx_='0.00/0.00' dnd='no' echo_cancellation='' opaque_data='	128 taps'	(unless TDM bridged) currently OFF
	//Wait for dialtone: 0ms
	//Actual Confinfo: Num/0, Mode/0x0000
	//Actual Confmute: No
	//Hookstate (FXS only): Onhook
	//--END COMMAND--
	//' /></response>
	//</ajax-response>
	
	ЧислоСтрок = СтрЧислоСтрок(ИсходныйТекст);
	Для Х = 1 по ЧислоСтрок Цикл
		СтрокаДляРазбора = СокрЛП(СтрПолучитьСтроку(ИсходныйТекст, Х));
		Если Найти(СтрокаДляРазбора, "Follows") = 0 Тогда
			Продолжить;
		КонецЕсли;
		МассивПодстрок = мОбработкаДанных.мРазложитьСтрокуВМассивПодстрок(СтрокаДляРазбора, "' ");
		Для каждого СтрокаПараметра Из МассивПодстрок Цикл
			Если НЕ Найти(СтрокаПараметра, "context=")=0 Тогда
				context = СтрЗаменить(СтрокаПараметра,"context=", "");
				ОписаниеНомера.Контекст = СокрЛП(СтрЗаменить(context,"'", ""));
				Продолжить;
			КонецЕсли; 
			Если НЕ Найти(СтрокаПараметра, "caller_id=")=0 Тогда
				caller_id = СтрЗаменить(СтрокаПараметра, "caller_id=", "");
				ОписаниеНомера.ВнутреннийНомер = СокрЛП(СтрЗаменить(caller_id, "'", ""));
				Продолжить;
			КонецЕсли; 
			Если НЕ Найти(СтрокаПараметра, "channel=")=0 Тогда
				channel = СтрЗаменить(СтрокаПараметра, "channel=", "");
				ОписаниеНомера.Канал = "DAHDI/" + СокрЛП(СтрЗаменить(channel, "'", ""));
				Продолжить;
			КонецЕсли;
			Если НЕ Найти(СтрокаПараметра, "dialing=")=0 Тогда
				dialing = СтрЗаменить(СтрокаПараметра, "dialing=", "");
				ОписаниеНомера.Состояние = ?(СокрЛП(СтрЗаменить(dialing, "'", "")) = "no", "", "InUse");
				Продолжить;
			КонецЕсли;
		КонецЦикла; 
		
		Прервать;
	КонецЦикла;
	Если ЗначениеЗаполнено(ОписаниеНомера.ВнутреннийНомер) Тогда
		Возврат ОписаниеНомера;
	Иначе	
		Возврат Неопределено;
	КонецЕсли; 	
КонецФункции // РазобратьDAHDIShowChannel()

//Получаем параметры пира по внутреннему номеру с сервера Asterisk для заполнения настроек панели
//
Процедура ПолучитьПараметрыDAHDIПира(ТаблицаХинтов)
	МассивСтрок = ТаблицаХинтов.НайтиСтроки(Новый Структура("Канал", НашКаналФильтр));
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	КонтекстНабораПоУмолчанию = МассивСтрок[0].Контекст; 	
КонецПроцедуры

// Проверка прав доступа для текущего пользователя к ключевым объектам
// 
Процедура ВыполнитьПроверкуПравПользователя()
	Если НЕ ЗначениеЗаполнено(ИмяТекущегоПользователя) Тогда
		Сообщить("Для использования панели телефонии необходимо авторизоваться.", СтатусСообщения.ОченьВажное);	
	КонецЕсли; 	
	
	ИнформацияПоПравамДоступа = "";
	Права = Новый Массив;
	Права.Добавить("Чтение");
	Права.Добавить("Добавление");
	Права.Добавить("Проведение");
	Права.Добавить("Использование");
	Права.Добавить("Просмотр");
	Права.Добавить("Редактирование");
		
	Если НЕ ИнформацияПоПравамДоступа = "" Тогда
		Сообщить("У пользователя не хватает прав доступа для использования модуля ""Панель телефонии для 1С"".");
		СообщитьОтладочнуюИнформацию("Права доступа:", ИнформацияПоПравамДоступа);
	КонецЕсли; 
КонецПроцедуры

