// Обработка события ChanSpyStop компонента miko_ajam (Подслушивание или конференция с другим разговором окончание)
//
Процедура onChanSpyStop(Знач XMLУзел)
	//<generic event="ChanSpyStop" privilege="call,all" spyeechannel="SIP/104-00000751" />
	XMLУзел=ПолучитьЧтениеXML(XMLУзел);
	Если XMLУзел=Неопределено Тогда
		Возврат;
	КонецЕсли; 
	КаналДляПоиска	=	XMLУзел.ЗначениеАтрибута("spyeechannel");
	СтрочкаЗвонка	=	Звонки.Найти(КаналДляПоиска,"Канал1,Канал2");
	Если СтрочкаЗвонка<>Неопределено и ЗначениеЗаполнено(КаналДляПоиска) Тогда
		Если СтрочкаЗвонка.СейчасПодслушивают Тогда
			СтрочкаЗвонка.СейчасПодслушивают = Ложь; //Это нас подслушивали
		Иначе		
			// отбой вызова выполняем в onHandUp
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры	

// Обработка события Newstate компонента miko_ajam (При изменении состояния канала)
//
Процедура onNewstate(Знач XMLУзел)
	
	XMLУзел=ПолучитьЧтениеXML(XMLУзел);
	Если XMLУзел=Неопределено ИЛИ НЕ ЗначениеЗаполнено(НашКаналФильтр) Тогда
		Возврат;
	КонецЕсли; 
	
	channel		 = XMLУзел.ЗначениеАтрибута("channel");
	Если ЭтоСлужебныйКанал(channel) Тогда
		Возврат;
	КонецЕсли; 
	
	СтрочкаЗвонка=	НайтиСтрочкуЗвонка(XMLУзел);
	channelstate = XMLУзел.ЗначениеАтрибута("channelstate");
	calleridname = XMLУзел.ЗначениеАтрибута("calleridname");
	// Получим переменную канала
	врСписокПеременных = Новый СписокЗначений;
	// МИКО / Портнов / Оптипизация.
	врСписокПеременных.Добавить("", "extenfrom1c", Истина);
	// HTTP_GetVar(channel,врСписокПеременных);
	// МИКО / Портнов / Оптипизация.
	Для каждого врТекущаяПеременная Из врСписокПеременных Цикл
		Если врТекущаяПеременная.Пометка Тогда
			ПеремКаналовСтруктура.Вставить(channel+"_"+врТекущаяПеременная.Представление,врТекущаяПеременная.Значение);
		КонецЕсли; 
	КонецЦикла;	
	
	Если channelstate = "4"
		И ЭтоНомерТекущегоПользователя(channel,мСписокНомеровПользователяДляОбработки) Тогда 
		// Исходящий "Ring".
		Если СтрочкаЗвонка = Неопределено Тогда
			СтрочкаЗвонка =	ДобавитьСтрокуЗвонка();
		КонецЕсли; 
		
		connectedlinenum = XMLУзел.ЗначениеАтрибута("connectedlinenum");
		Если Найти(connectedlinenum, "unknown")>0 Тогда
			connectedlinenum = XMLУзел.ЗначениеАтрибута("exten")
		КонецЕсли; 
		СтрочкаЗвонка.CallerID			  =   connectedlinenum;
		СтрочкаЗвонка.Контрагент		  =   XMLУзел.ЗначениеАтрибута("connectedlinename");
		СтрочкаЗвонка.Канал1			  =   channel;
		СтрочкаЗвонка.UniqueID1 		  =   XMLУзел.ЗначениеАтрибута("uniqueid");

		СтрочкаЗвонка.our_cidname 	  	  =	  calleridname;
		СтрочкаЗвонка.ВходящийЗвонок 	  =	  Ложь;
		СтрочкаЗвонка.СейчасРазговаривают =   Ложь;       
		СтрочкаЗвонка.СейчасПодслушивают  =	  Ложь;
		
	ИначеЕсли channelstate = "6"
		И ЭтоНомерТекущегоПользователя(channel,мСписокНомеровПользователяДляОбработки)
		И НЕ СтрочкаЗвонка = Неопределено И НЕ СтрочкаЗвонка.ВходящийЗвонок Тогда 
		// Подняли трубку "Up" при исходящем звонке.
		
		новый_CallerID = XMLУзел.ЗначениеАтрибута("connectedlinenum");
		Если Найти(новый_CallerID, "unknown")>0 Тогда
			новый_CallerID = "";
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(новый_CallerID) Тогда
			СтрочкаЗвонка.CallerID		  =   новый_CallerID;
		ИначеЕсли НЕ ЗначениеЗаполнено(""+новый_CallerID+СтрочкаЗвонка.CallerID) Тогда 
			СтрочкаЗвонка.CallerID		  =   XMLУзел.ЗначениеАтрибута("calleridnum");
		КонецЕсли; 
		СтрочкаЗвонка.Контрагент		  =   XMLУзел.ЗначениеАтрибута("connectedlinename");
		СтрочкаЗвонка.Канал1			  =   channel;

		СтрочкаЗвонка.UniqueID1 		  =   XMLУзел.ЗначениеАтрибута("uniqueid");
		СтрочкаЗвонка.our_cidname 	  	  =	  calleridname;
		СтрочкаЗвонка.ВходящийЗвонок 	  =	  Ложь; 
		СтрочкаЗвонка.СейчасРазговаривают =   Истина;
		СтрочкаЗвонка.СейчасПодслушивают  =	  Ложь;
		
	ИначеЕсли channelstate = "6"
		И ЭтоНомерТекущегоПользователя(channel,мСписокНомеровПользователяДляОбработки)
		И СтрочкаЗвонка = Неопределено Тогда 
		// Подняли трубку "Up" при исходящем звонке, при использовании автоподъема.
		
		СтрочкаЗвонка =	ДобавитьСтрокуЗвонка();
		новый_CallerID = XMLУзел.ЗначениеАтрибута("connectedlinenum");
		Если Найти(новый_CallerID, "unknown")>0 Тогда
			новый_CallerID = "";
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(новый_CallerID) Тогда
			СтрочкаЗвонка.CallerID		  =   новый_CallerID;
		ИначеЕсли НЕ ЗначениеЗаполнено(""+новый_CallerID+СтрочкаЗвонка.CallerID) Тогда 
			СтрочкаЗвонка.CallerID		  =   XMLУзел.ЗначениеАтрибута("calleridnum");
		КонецЕсли; 
		СтрочкаЗвонка.Контрагент		  =   XMLУзел.ЗначениеАтрибута("connectedlinename");
		Если НЕ ЗначениеЗаполнено(СтрочкаЗвонка.Контрагент) Тогда
			СтрочкаЗвонка.Контрагент		  =	  XMLУзел.ЗначениеАтрибута("calleridname");
		КонецЕсли; 
		
		СтрочкаЗвонка.Канал1			  =   channel;

		СтрочкаЗвонка.UniqueID1 		  =   XMLУзел.ЗначениеАтрибута("uniqueid");
		СтрочкаЗвонка.our_cidname 	  	  =	  calleridname;
		СтрочкаЗвонка.ВходящийЗвонок 	  =	  Ложь; 
		СтрочкаЗвонка.СейчасРазговаривают =   Истина;
		СтрочкаЗвонка.СейчасПодслушивают  =	  Ложь;
	ИначеЕсли НЕ СтрочкаЗвонка = Неопределено
			  И НазваниеPBX = "MIKOPBX" И channelstate = "5"
			  И ЭтоНомерТекущегоПользователя(channel,мСписокНомеровПользователяДляОбработки)
			  И Найти(channel,НашКаналФильтр) > 0 И Найти(СтрочкаЗвонка.Канал2, "internal-originate")>0 Тогда
		
		Если XMLУзел.ЗначениеАтрибута("connectedlinenum")<>Неопределено Тогда
			// для Asterisk 1.8+
			СтрочкаЗвонка.CallerID			  =   XMLУзел.ЗначениеАтрибута("connectedlinenum");	
			СтрочкаЗвонка.Контрагент		  =   XMLУзел.ЗначениеАтрибута("connectedlinename");
		ИначеЕсли НЕ ЭтоНомерТекущегоПользователя("@@"+XMLУзел.ЗначениеАтрибута("calleridnum")+"@@",мСписокНомеровПользователяДляОбработки) Тогда
			// Для Asterisk 1.6 нет поля "connectedlinenum", при статусе "Ringing" необходимый номер может быть найден в поле "calleridnum".
			СтрочкаЗвонка.CallerID			  =   XMLУзел.ЗначениеАтрибута("calleridnum");	
			// Для Asterisk 1.6 нет поля "connectedlinename", при статусе "Ringing" необходимый номер может быть найден в поле "calleridname". 
			СтрочкаЗвонка.Контрагент		  =   XMLУзел.ЗначениеАтрибута("calleridname");
		Иначе
			СтрочкаЗвонка.CallerID			  =   XMLУзел.ЗначениеАтрибута("calleridnum");	
			СтрочкаЗвонка.ВходящийЗвонок 	  =   Ложь;
		КонецЕсли; 
		
		СтрочкаЗвонка.UniqueID2 		  =   XMLУзел.ЗначениеАтрибута("uniqueid");
		СтрочкаЗвонка.our_cidname 	  	  =	  calleridname;
		СтрочкаЗвонка.СейчасРазговаривают =   Ложь;
		СтрочкаЗвонка.СейчасПодслушивают  =   Ложь;
	ИначеЕсли channelstate = "5" 
			  И ЭтоНомерТекущегоПользователя(channel,мСписокНомеровПользователяДляОбработки) Тогда 
		// TODO // MYPBX (+)
		// При входящем звонке на группу вызовов, не корректно определяется CallerID.
		Если НЕ СтрочкаЗвонка = Неопределено 
			 И НазваниеPBX = "MYPBX" И ЗначениеЗаполнено(СтрочкаЗвонка.CallerID) Тогда
			// Номер телефона уже определен ранее в Dial.
			Возврат;
		КонецЕсли; 
		// TODO // MYPBX (-)
		
		// Входящий "Ringing".
		Если СтрочкаЗвонка = Неопределено Тогда
			СтрочкаЗвонка =	ДобавитьСтрокуЗвонка();
		КонецЕсли;
		
		Если НазваниеPBX = "MIKOPBX" Тогда
			IS_ORIGINATE = СвязиКаналов.НайтиСтроки(Новый Структура("linkedid,IS_ORIGINATE",XMLУзел.ЗначениеАтрибута("linkedid"), Истина)).Количество()>0;
			Если IS_ORIGINATE Тогда
				Входящий = Ложь;
			Иначе	
				Входящий = Истина;
			КонецЕсли; 
		Иначе	
			Входящий = Истина;
		КонецЕсли; 			
		
		СтрочкаЗвонка.ВходящийЗвонок 	  =   Входящий;
		Если XMLУзел.ЗначениеАтрибута("connectedlinenum")<>Неопределено Тогда
			// для Asterisk 1.8+
			СтрочкаЗвонка.CallerID			  =   XMLУзел.ЗначениеАтрибута("connectedlinenum");	
			СтрочкаЗвонка.Контрагент		  =   XMLУзел.ЗначениеАтрибута("connectedlinename");
		ИначеЕсли НЕ ЭтоНомерТекущегоПользователя("@@"+XMLУзел.ЗначениеАтрибута("calleridnum")+"@@",мСписокНомеровПользователяДляОбработки) Тогда
			// Для Asterisk 1.6 нет поля "connectedlinenum", при статусе "Ringing" необходимый номер может быть найден в поле "calleridnum".
			СтрочкаЗвонка.CallerID			  =   XMLУзел.ЗначениеАтрибута("calleridnum");	
			// Для Asterisk 1.6 нет поля "connectedlinename", при статусе "Ringing" необходимый номер может быть найден в поле "calleridname". 
			СтрочкаЗвонка.Контрагент		  =   XMLУзел.ЗначениеАтрибута("calleridname");
		Иначе
			СтрочкаЗвонка.CallerID			  =   XMLУзел.ЗначениеАтрибута("calleridnum");	
			СтрочкаЗвонка.ВходящийЗвонок 	  =   Ложь;
		КонецЕсли; 
		
		СтрочкаЗвонка.Канал2			  =   channel;
		СтрочкаЗвонка.UniqueID2 		  =   XMLУзел.ЗначениеАтрибута("uniqueid");
		СтрочкаЗвонка.our_cidname 	  	  =	  calleridname;
		СтрочкаЗвонка.СейчасРазговаривают =   Ложь;
		СтрочкаЗвонка.СейчасПодслушивают  =   Ложь;
	КонецЕсли;
	
	Если НЕ СтрочкаЗвонка = Неопределено Тогда
		Если "CDR_RECORDS" <> СтрочкаЗвонка.our_cidname Тогда
			ОпределитьКонтрагентаКонтактногоЛицаПоНомеру(СтрочкаЗвонка);
		КонецЕсли; 
		// Банер / Начало
		// Открывается на все при звонке на наш номер
		// при исходящем звонке, откытие формы тоже происходит, 
		// но форма будет закрыта в событии "Dial"
		// найдем строчку звонка, в которой возможен автоподъем			
		Если ИспользоватьБаннер Тогда
			Банер_ДобавитьСтрокуЗвонка(СтрочкаЗвонка);  //TODO
		КонецЕсли;
		
		Если channelstate = "5"
			 И ЭтоНомерТекущегоПользователя(channel, мСписокНомеровПользователяДляОбработки) Тогда
			 
			Если Не ЗначениеЗаполнено(СтрочкаЗвонка.CallerID) Тогда
				СтрочкаЗвонка.CallerID = ПеремКаналовСтруктура.Получить(channel+"_extenfrom1c");
				Если НЕ ЗначениеЗаполнено(СтрочкаЗвонка.CallerID) Тогда
					СтрочкаЗвонка.CallerID = ПолучитьПеременнуюКанала(channel,"extenfrom1c");
				КонецЕсли;
			КонецЕсли; 
		ИначеЕсли channelstate = "6" Тогда  // "Up" - подняли трубку	
			СтрочкаЗвонка.АвтоПодъемВозможен = Ложь;
		КонецЕсли; 
		// Банер / Конец 
	КонецЕсли; 
	
КонецПроцедуры

// Обработка события Pickup компонента miko_ajam (При изменении состояния канала)
//
Процедура onPickup(Знач XMLУзел)
	// <generic event="Pickup" privilege="call,all" channel="SIP/112-000001eb" targetchannel="SIP/126-000001ea" />
	XMLУзел=ПолучитьЧтениеXML(XMLУзел);
	Если XMLУзел=Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	channel		  =  XMLУзел.ЗначениеАтрибута("channel");       // этот наш новый канал
	targetchannel =  XMLУзел.ЗначениеАтрибута("targetchannel"); // этот канал пропадет
	Если Найти(channel, НашКаналФильтр)>0 И Найти(targetchannel, НашКаналФильтр)=0 Тогда
		// Мы перехватываем чужой канал (*8).
		Возврат;
	КонецЕсли; 
	ЗвонокКУдалению = Неопределено;
	Для каждого Звонок Из Звонки Цикл
		Если Звонок.ВходящийЗвонок // входящий ищем в канале 2
			 И (ЗначениеЗаполнено(targetchannel) 
			 И Найти(Звонок.Канал2, targetchannel) > 0) Тогда	
			// обновляем значение канала  
			Звонок.Канал2 = channel;
		ИначеЕсли ЗначениеЗаполнено(channel)
			  	  И Найти(channel, НашКаналФильтр)>0 // Удаляем только звонок по нашему каналу.
				  И Найти(Звонок.Канал1 + Звонок.Канал2, channel) > 0 Тогда
			// при обратном звонке на мобильный каналы могут быть перетасованы	  
			ЗвонокКУдалению = Звонок;
		КонецЕсли;
		Если Найти(Звонок.Канал1 + Звонок.Канал2, НашКаналФильтр) = 0 Тогда
			// Это больше не наш звонок. Вызов перехвачен другим сотрудником.
			ЗвонокКУдалению = Звонок;
		КонецЕсли; 
	КонецЦикла;   
	Если НЕ ЗвонокКУдалению = Неопределено Тогда
		УдалитьСтрокуЗвонкаПоИндексу(ЗвонокКУдалению);	
	КонецЕсли; 
	
КонецПроцедуры

