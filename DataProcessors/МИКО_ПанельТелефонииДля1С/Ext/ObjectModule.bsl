// Активация купона.
// 
Функция ActivateCoupone(sCoupone) Экспорт 
	Если НЕ ЗначениеЗаполнено(sCoupone) Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если Компонент <> Неопределено Тогда
		врКомпонент = Компонент;
	ИначеЕсли ДопМодули.Свойство("НаборНомера")
		 И НЕ (ДопМодули.НаборНомера = Неопределено) Тогда
		 врКомпонент = ДопМодули.НаборНомера.ПолучитьКомпонентSIP();	
	Иначе
		Возврат Ложь;
	КонецЕсли; 
	
	Если врКомпонент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("sCoupone", Строка(sCoupone));
	СтруктураПараметров.Вставить("result", "");

	Попытка
		врКомпонент.ActivateCoupone(СтруктураПараметров.sCoupone, СтруктураПараметров.result);
		ОтработанаУспешно = Истина;
	Исключение
		ОтработанаУспешно = Ложь;
	КонецПопытки; 
	Оповестить("MIKOLIC_Coupone", СтруктураПараметров.result, "");

	Возврат ОтработанаУспешно;
КонецФункции // ActivateCoupone()

Функция ЭкранироватьСпецСимволыXML(Знач ИсхСтрока)
	Результат = ИсхСтрока;
	Результат = СтрЗаменить(Результат, "&"," ");
	Результат = СтрЗаменить(Результат, """","&quot;");
	Результат = СтрЗаменить(Результат, "'","&apos;");	
	Результат = СтрЗаменить(Результат, "<","&lt;");	
	Результат = СтрЗаменить(Результат, ">","&gt;");	
	
	Возврат Результат;
КонецФункции // ЭкранироватьСпецСимволыXML()

