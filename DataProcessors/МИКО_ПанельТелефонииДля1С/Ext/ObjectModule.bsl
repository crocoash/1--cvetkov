// СВЯЗИ КАНАЛОВ 

// Обработка информации о парковке вызова
// Параметры 
//   СтрокаXMLУзел - тип - строка, XML структура в строковом представлении
Процедура onParkedCall(СтрокаXMLУзел)

	СтруктураАтрибутов = ПолучитьСтруктуруАтрибутов(СтрокаXMLУзел);
	Если СтруктураАтрибутов = Неопределено 
		 ИЛИ НЕ СтруктураАтрибутов.Получить("event")="ParkedCall" Тогда
		Возврат;
	КонецЕсли;
	channel 	= СтруктураАтрибутов.Получить("channel");	
	Если channel = Неопределено Тогда
	 	// Это скорее всего Asterisk 13 / 12
		channel 	= СтруктураАтрибутов.Получить("parkeechannel");
		exten 		= СтруктураАтрибутов.Получить("parkingspace");
		parkinglot	= СтруктураАтрибутов.Получить("parkingspace");
		from 		= СтруктураАтрибутов.Получить("parkerdialstring");
	    calleridnum = СтруктураАтрибутов.Получить("parkeecalleridnum");
	Иначе
		exten 		= СтруктураАтрибутов.Получить("exten");
		parkinglot	= СтруктураАтрибутов.Получить("exten");
		from 		= СтруктураАтрибутов.Получить("from");
		calleridnum = "";
	КонецЕсли; 
	
	СлотПарковки = Парковка.Найти(channel, "Канал");;
	Если СлотПарковки = Неопределено 
		 И Найти(from, НашКаналФильтр)>0 
		 Тогда
		СлотПарковки = Парковка.Добавить();
		СлотПарковки.Канал 		 = channel;
		СлотПарковки.calleridnum = calleridnum;
		СлотПарковки.Слот 		 = exten;
	ИначеЕсли НЕ СлотПарковки = Неопределено 
			  И СлотПарковки.Автоподъем = Истина Тогда
		НабратьНомер(СлотПарковки.Слот, КонтекстНабораПоУмолчанию, "", calleridnum);
	КонецЕсли;
	
	Если НЕ СлотПарковки = Неопределено Тогда
		СлотПарковки.Слот  = exten;
		Банер_ДобавитьЗапаркованныйВызов(СлотПарковки);
		Оповестить("ОбновитьОтображениеПарковки");
	КонецЕсли; 
КонецПроцедуры

// Обработка события снятия вызова с парковки
// Параметры 
//   СтрокаXMLУзел - тип - строка, XML структура в строковом представлении
Процедура onUnParkedCall(СтрокаXMLУзел)
	//  <generic event="ParkedCallGiveUp" privilege="call,all" systemname="mikopbx" parkeechannel="SIP/204-00000032" parkeechannelstate="6" parkeechannelstatedesc="Up" parkeecalleridnum="204" parkeecalleridname="204" parkeeconnectedlinenum="212" parkeeconnectedlinename="212" parkeelanguage="ru-ru" parkeeaccountcode="" parkeecontext="peer_212" parkeeexten="204" parkeepriority="1" parkeeuniqueid="mikopbx-1532943596.248" parkeelinkedid="mikopbx-1532943595.247" parkerdialstring="SIP/212" parkinglot="default" parkingspace="807" parkingtimeout="595" parkingduration="5" />

	СтруктураАтрибутов = ПолучитьСтруктуруАтрибутов(СтрокаXMLУзел);
	Если СтруктураАтрибутов = Неопределено Тогда
		Возврат;
	КонецЕсли;                                            
	channel 	= СтруктураАтрибутов.Получить("channel");
	Если channel = Неопределено Тогда
	 	// Это скорее всего Asterisk 13 / 12
		channel 	= СтруктураАтрибутов.Получить("parkeechannel");
		exten 		= СтруктураАтрибутов.Получить("parkingspace");
		parkinglot	= СтруктураАтрибутов.Получить("parkingspace");
	Иначе
		exten 		= СтруктураАтрибутов.Получить("exten");
		parkinglot	= СтруктураАтрибутов.Получить("exten");
	КонецЕсли; 
	
	СлотПарковки = Парковка.Найти(exten, "Слот");
	Если НЕ СлотПарковки = Неопределено Тогда
		Если НазваниеPBX = "ASKOZIA" ИЛИ НазваниеPBX = "MIKOPBX" Тогда
			// Gри звонке на "внешний" номер сотрудника callerid может быть назначен внутренним 
			// номером вызывающего абонента.
			// Установим верный CALLERID(num).
			УстановитьПеременнуюКанала(channel,"CALLERID(num)",СлотПарковки.calleridnum);
		КонецЕсли; 
		
		Банер_УдалитьЗапаркованныйВызов(СлотПарковки);
		Парковка.Удалить(СлотПарковки);
		Оповестить("ОбновитьОтображениеПарковки");
	КонецЕсли; 

КонецПроцедуры 

// Дополнительная процедура обработки onBridge. Производит обновление таблицы связей каналов. 
// Параметры 
//   СтрокаXMLУзел - тип - строка, XML структура в строковом представлении
Функция onBridgeОбновитьСвязиКаналов(СтрокаXMLУзел)
	ДанныеСвязи = Новый Структура("Канал1,Канал2,cid1,cid2");
		
    Если Не ЗначениеЗаполнено(СтрокаXMLУзел) Тогда
		Возврат ДанныеСвязи;
	КонецЕсли;
	
	СтруктураАтрибутов = ПолучитьСтруктуруАтрибутов(СтрокаXMLУзел);
	Если СтруктураАтрибутов = Неопределено 
		 ИЛИ НЕ СтруктураАтрибутов.Получить("event")="Bridge" Тогда
		Возврат ДанныеСвязи;
	КонецЕсли;
		
	// получение строки с каналом	
	массСтрок = СвязиКаналов.НайтиСтроки(Новый Структура("Канал1,Канал2",
										 СтруктураАтрибутов.Получить("channel1"),
										 СтруктураАтрибутов.Получить("channel2")));
	// поиск строки связи
	Если массСтрок.Количество()=0 Тогда
		СтрокаСвязи = СвязиКаналов.Добавить();
		СтрокаСвязи.Канал1		= "" + СтруктураАтрибутов.Получить("channel1");  
		СтрокаСвязи.Канал2		= "" + СтруктураАтрибутов.Получить("channel2"); 
		
	Иначе
		СтрокаСвязи = массСтрок[0];
	КонецЕсли;
	
	СтрокаСвязи.cid1  		= "" + СтруктураАтрибутов.Получить("callerid1");
	СтрокаСвязи.cid2   		= "" + СтруктураАтрибутов.Получить("callerid2");
	СтрокаСвязи.Dial 		= Ложь;
	СтрокаСвязи.bridgestate = "" + СтруктураАтрибутов.Получить("bridgestate");
	
	Если (Найти(ВРЕГ(СтрокаСвязи.Канал1), "LOCAL")>0 И Найти(СтрокаСвязи.Канал2, Лев(СтрокаСвязи.Канал1, Найти(СтрокаСвязи.Канал1, ";")))>0) Тогда
		// зомбирование канала
		// после этого LOCAL отмирает ZOMBIрование
		// удаление связи произойдет по hangup - событию
		Возврат ДанныеСвязи;
	КонецЕсли; 
	
	Если СтрокаСвязи.bridgestate = "Link" Тогда
		Канал1 = Лев(СтрокаСвязи.Канал1,ПолучитьПозициюБлижнегоСимвола(СтрокаСвязи.Канал1, "@-,")-1);
		Канал2 = Лев(СтрокаСвязи.Канал2,ПолучитьПозициюБлижнегоСимвола(СтрокаСвязи.Канал2, "@-,")-1);
		
		// иногда в brige приходят одинаковые callerid
		// в случае dial на "внешний" ноемер для Askozia
		// попытаемся получить номер абонента из переменной DIALEDPEERNUMBER
		Если Найти(СтрокаСвязи.Канал2, СтрокаСвязи.cid1)>0 Тогда
			DIALEDPEERNUMBER = ПеремКаналовСтруктура.Получить(СтрокаСвязи.Канал2+"_DIALEDPEERNUMBER");
			Если НЕ ЗначениеЗаполнено(DIALEDPEERNUMBER) Тогда
				DIALEDPEERNUMBER = ПолучитьПеременнуюКанала(СтрокаСвязи.Канал2, "DIALEDPEERNUMBER");
			КонецЕсли; 
			СтрокаСвязи.cid1 = ПолучитьНомерВызываемогоАбонентаИзАтрибутаDialstring(DIALEDPEERNUMBER);
		КонецЕсли; 
		Если Найти(СтрокаСвязи.Канал1, СтрокаСвязи.cid2)>0 Тогда
			DIALEDPEERNUMBER = ПеремКаналовСтруктура.Получить(СтрокаСвязи.Канал1+"_DIALEDPEERNUMBER");
			Если НЕ ЗначениеЗаполнено(DIALEDPEERNUMBER) Тогда
				DIALEDPEERNUMBER = ПолучитьПеременнуюКанала(СтрокаСвязи.Канал1, "DIALEDPEERNUMBER");
			КонецЕсли; 
			СтрокаСвязи.cid2 = ПолучитьНомерВызываемогоАбонентаИзАтрибутаDialstring(DIALEDPEERNUMBER);
		КонецЕсли; 
		
		Если Найти(ВРЕГ(СтрокаСвязи.Канал1), "LOCAL")>0 Тогда

			ИмяКанала = СтрокаСвязи.Канал1; cid_chan=Неопределено; cid_sob1=Неопределено;
			ПоискРеальногоКанала(ИмяКанала, cid_chan, cid_sob1);
			ДанныеСвязи.Канал1 = ИмяКанала;
			ДанныеСвязи.cid1 = cid_sob1;
			
			ИмяКанала = Лев(ИмяКанала,ПолучитьПозициюБлижнегоСимвола(ИмяКанала, "@-,")-1);
			СтрокаСвязи.ПсевдоКанал = ИмяКанала;
		Иначе
			ИмяКанала = Канал1;
		КонецЕсли; 
		врКанал1 = ИмяКанала;
		
		Если Найти(ВРЕГ(СтрокаСвязи.Канал2), "LOCAL")>0 Тогда 

			ИмяКанала = СтрокаСвязи.Канал2; cid_chan=Неопределено; cid_sob=Неопределено;
			ПоискРеальногоКанала(ИмяКанала, cid_chan, cid_sob);
			ДанныеСвязи.Канал2 = ИмяКанала;
			ДанныеСвязи.cid2 = cid_sob;
			ИмяКанала = Лев(ИмяКанала,ПолучитьПозициюБлижнегоСимвола(ИмяКанала, "@-,")-1);
			
			СтрокаСвязи.ПсевдоКанал = ИмяКанала;
		Иначе
			ИмяКанала = Канал2;
		КонецЕсли; 
		
		врКанал2 = ИмяКанала;
		ОбновитьСобеседникаДляСотрудника(врКанал1, СтрокаСвязи.cid2, врКанал2);
		Хинт = ?(ТаблицаХинтов = Неопределено, Неопределено, ТаблицаХинтов.найти(врКанал2, "Канал"));
		
		Если Хинт=Неопределено ИЛИ cid_sob1 = Неопределено Тогда
			ДанныеСвязи.cid2 = СтрокаСвязи.cid1;
			ОбновитьСобеседникаДляСотрудника(врКанал2, СтрокаСвязи.cid1, врКанал1);
		Иначе	
			// доверяем только строке с "Внешним" каналом
			ОбновитьСобеседникаДляСотрудника(врКанал2, cid_sob1, врКанал1);
		КонецЕсли; 
	КонецЕсли; 
	Возврат ДанныеСвязи;
КонецФункции

// Дополнительная процедура обработки onHangUp. Производит обновление таблицы связей каналов.
//
Процедура onHangUpОбвновитьСвязиКаналов(СтрокаXMLУзел)
    Если Не ЗначениеЗаполнено(СтрокаXMLУзел) Тогда
		Возврат;
	КонецЕсли;
	СтруктураАтрибутов = ПолучитьСтруктуруАтрибутов(СтрокаXMLУзел);
	Если СтруктураАтрибутов = Неопределено 
		 ИЛИ НЕ СтруктураАтрибутов.Получить("event")="Hangup" Тогда
		Возврат;
	КонецЕсли;
	
	Канал = СтруктураАтрибутов.Получить("channel");
	СтрокаСвязи = СвязиКаналов.Найти(Канал, "Канал1,Канал2");
	Пока Истина Цикл
		СтрокаСвязи = СвязиКаналов.Найти(Канал, "Канал1,Канал2");
		Если СтрокаСвязи = Неопределено Тогда
			Прервать;	
		Иначе
			СвязиКаналов.Удалить(СтрокаСвязи);
		КонецЕсли; 
	КонецЦикла; 
КонецПроцедуры

// Установка собеседника сотрудника
// Обновление информации, с кем говорит сотрудник
// Параметры 
//   peer - тип  - строка, идентификатор канала в формате (Технология)/(номер), пример SIP/104, IAX/105
//   calleridnum - тип  - строка, Номер абонента - собеседника для "peer"
//   КаналСвязи  - тип  - строка, Канал абонента - собеседника для "peer" - уточнение (не обязателен)
Процедура ОбновитьСобеседникаДляСотрудника(Знач peer, Знач calleridnum,Знач КаналСвязи="")
    Если ЗначениеЗаполнено(КаналСвязи) И ТипЗнч(ТаблицаХинтов)=Тип("ТаблицаЗначений") Тогда
        // Попробуем определить внутренний номер по таблице хинтов.
        Хинт = ТаблицаХинтов.найти(КаналСвязи, "Канал");
        calleridnum = ?(Хинт=Неопределено,calleridnum,Хинт.ВнутреннийНомер);
    ИначеЕсли ТипЗнч(ТаблицаХинтов) <> Тип("ТаблицаЗначений") Тогда 
        СообщитьОтладочнуюИнформацию("Исключительная ситуация таблицы хинтов", "peer -"+peer+", calleridnum - "+calleridnum+", КаналСвязи - "+КаналСвязи);
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(calleridnum)
		 ИЛИ НЕ ЗначениеЗаполнено(peer) Тогда
		Возврат;	
	КонецЕсли; 
	
	СтрокаСотрудника = Сотрудники.Найти(peer,"КаналСотрудника");
	Если НЕ СтрокаСотрудника = Неопределено Тогда
		// проверия канал собеседника
		Если ЗначениеЗаполнено(КаналСвязи)
			 И ТипЗнч(КаналСвязи) = Тип("Строка") 
			 И Найти(ВРЕГ(КаналСвязи), "LOCAL")=0
			 И Найти(КаналСвязи, calleridnum)=0 Тогда
		  	// если в канале собеседника не найден его номер телефона, то попробуем
			// проанализировать канал на наличие другого номера
			
			Если Найти(КаналСвязи, "DAHDI")>0 Тогда
				Хинт = ТаблицаХинтов.найти(КаналСвязи, "Канал");
				cid_from_chan = ?(Хинт=Неопределено, calleridnum, Хинт.ВнутреннийНомер);
			Иначе
				cid_from_chan = ПолучитьНомерВызываемогоАбонентаИзАтрибутаDialstring(КаналСвязи);
			КонецЕсли; 
			Если мОбработкаДанных.ЭтоНеЧисловойНомер(cid_from_chan) Тогда
				// ТОЛЬКо числовое представение номера
				cid_from_chan = "";
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(cid_from_chan) Тогда
				// дополнительная проверка
				Если НЕ мОбработкаДанных.ЭтоНеЧисловойНомер(calleridnum) И СтрДлина(calleridnum)>5 Тогда
					// calleridnum = calleridnum;
				Иначе	
					calleridnum = cid_from_chan;
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
		
		// очистим
		СтрокаСотрудника.Собеседник = "";
		// ХЭШ // Смотрим всегда.
		Если ЗначениеЗаполнено(calleridnum) Тогда
			СтрокаКЭШ = ТЗ_КЭШ_КИ.Найти(calleridnum, "CallerID");
			Если НЕ СтрокаКЭШ = Неопределено 
				 И СтрокаКЭШ.ДатаАктуальности > ТекущаяДата() Тогда
				СтрокаСотрудника.Собеседник = ?(СтрокаКЭШ.Контрагент = "Неизвестный контрагент", calleridnum, СтрокаКЭШ.Контрагент);
			ИначеЕсли НЕ СтрокаКЭШ = Неопределено Тогда
				// Кэш не аткуален
				ТЗ_КЭШ_КИ.Удалить(СтрокаКЭШ);	
			КонецЕсли; 
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(calleridnum) И НЕ ЗначениеЗаполнено(СтрокаСотрудника.Собеседник) Тогда		
			Запрос = Новый Запрос;
			// получим текст запроса
			Если мОбработкаДанных.ЭтоНеЧисловойНомер(calleridnum) Тогда
				Запрос = мОбщийМодуль.ПолучитьЗапросОпределитьКонтрагентаКонтактногоЛицаПоНомеру("Skype:"+calleridnum);
				ТелефонДляПоиска = calleridnum;
			Иначе	
				ТелефонДляПоиска = мОбработкаДанных.ПреобразоватьНомерДляСохранения(calleridnum,  ГлобальныеПеременные.глКоличествоХранимыхЦифрТелефона);
				Запрос = мОбщийМодуль.ПолучитьЗапросОпределитьКонтрагентаКонтактногоЛицаПоНомеру(calleridnum);
			КонецЕсли; 
			// контроль заполнения параметра запроса
			Если ЗначениеЗаполнено(ТелефонДляПоиска) Тогда
				Запрос.УстановитьПараметр("ТипКИ", Перечисления.ТипыКонтактнойИнформации.Телефон);
				Запрос.УстановитьПараметр("ТелефонДляПоиска", ТелефонДляПоиска);
				// выполняем
				Результат = Запрос.Выполнить();
				Если НЕ Результат.Пустой() Тогда
					ВыборкаДетальныеЗаписи = Результат.Выбрать();
					ВыборкаДетальныеЗаписи.Следующий();
					
					ДанныеЗаполнения = мОбщийМодуль.ПолучитьДанныеЗаполненияОпределитьКонтрагентаКонтактногоЛицаПоНомеру(ВыборкаДетальныеЗаписи);
					СтрокаСотрудника.Собеседник = ДанныеЗаполнения.Контрагент;
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли;
		
		// назначим, если не нашли по базе
		Если НЕ ЗначениеЗаполнено(СтрокаСотрудника.Собеседник) Тогда
		 	СтрокаСотрудника.Собеседник = calleridnum;
		КонецЕсли;
		
		// ХЭШ // Добавляем всегда, даже если не нашли собеседника.
		Если ЗначениеЗаполнено(calleridnum) 
			 И ТЗ_КЭШ_КИ.Найти(calleridnum, "CallerID")=Неопределено Тогда
			СтрокаКЭШ = ТЗ_КЭШ_КИ.Добавить();
			СтрокаКЭШ.Контрагент = СтрокаСотрудника.Собеседник;                     
	        СтрокаКЭШ.CallerID	 = calleridnum;                                               
			СтрокаКЭШ.ДатаАктуальности = ТекущаяДата()+120; // две минуты актуальность ХЭШ.
		КонецЕсли; 

		Если ЗначениеЗаполнено(СтрокаСотрудника.Собеседник) Тогда
			СтрокаСотрудника.Состояние  = СостояниеЭкстеншена.Разговаривает;
		КонецЕсли;  
	КонецЕсли;

КонецПроцедуры

// Формирует ЧтениеXML из строки XML 
// Возвращает соответствие с атрибутами корневого элемента
// Параметры 
//   СтрокаXMLУзел - тип - строка, XML структура в строковом представлении
// Возвращаемое значение
//   Тип - Соответствие, Имя атрибута - ключ, Значение атрибута - значение
Функция ПолучитьСтруктуруАтрибутов(СтрокаХМЛ)
	Попытка
		XMLУзел = Новый ЧтениеXML;
		XMLУзел.УстановитьСтроку(СтрокаХМЛ);
		Если XMLУзел.Прочитать() Тогда
			СтруктураАтрибутов = Новый Соответствие;
			Если XMLУзел.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				// атрибуты можно получить только для начала элемента 
				// ЧтениеXML.Прочитать()
				Пока XMLУзел.ПрочитатьАтрибут() Цикл
					Если НЕ XMLУзел.ТипУзла = ТипУзлаXML.Атрибут Тогда
					 	Продолжить;
					КонецЕсли; 
					
					СтруктураАтрибутов.Вставить(XMLУзел.ЛокальноеИмя,XMLУзел.Значение);
				КонецЦикла; 
			КонецЕсли;
			
			// завершили разбор
			Возврат СтруктураАтрибутов;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	СообщитьОтладочнуюИнформацию("Невозможно разобрать данные XML. ",СтрокаХМЛ);
	Возврат Неопределено;
КонецФункции // ПолучитьЧтениеXML()

// Обработка парковки вызова. 
// Наполнение таблицы парковки
// Параметры 
//   СтрокаЗвонка - строка табличной части "Звонки"
//   timeout      - тип - строка,время, в милисекудах, только числа, без пробелов
//   Автоподъем   - НЕ Используется, булево, флаг о необходимости автоподъема (снятия с парковки)
Процедура ЗапарковатьНаСвободныйСлот(СтрокаЗвонка, timeout="600000", Автоподъем = Ложь) Экспорт 
	Если Компонент = Неопределено 
		ИЛИ НЕ ЗначениеЗаполнено(НашКаналФильтр) Тогда
		Возврат;			
	КонецЕсли; 
	
	Если СтрокаЗвонка.ВходящийЗвонок = Истина Тогда
		Channel		=	СтрокаЗвонка.Канал1; // кого паркуем	
		channel2	=	СтрокаЗвонка.Канал2; // куда сообщить о парковке
	Иначе
		Channel		=	СтрокаЗвонка.Канал2;	
		channel2	=	СтрокаЗвонка.Канал1;
	КонецЕсли; 	
	
	Если  Найти(ВРЕГ(Channel), "LOCAL")>0 Тогда
		// нет возможности парковать локальный канал 
		// необходимо найти реальный
		Связь = мОбработкаДанных.НайтиСвязьКанала(Channel);
		КаналСвязи = Неопределено;
		Если НЕ Связь = Неопределено
			 И Связь.Свойство("КаналСвязи", КаналСвязи) 
			 И ЗначениеЗаполнено(КаналСвязи) Тогда
			Channel = КаналСвязи;	
		КонецЕсли;
		
		Если Найти(ВРЕГ(Channel), "LOCAL")>0 Тогда
			// Попробуем найти исходный канал.
			// Если получилится, процедура переопрелит переменную Channel.
			ПоискРеальногоКанала(Channel);
		КонецЕсли; 
		
		Если Найти(ВРЕГ(Channel), "LOCAL")>0 Тогда
		   	// нет возможности запарковать вызов
			Сообщить("Нет возможности запарковать этот вызов!");
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	
	элКанал = КаналыКПарковке.Получить(Channel);
	Если НЕ элКанал = Неопределено Тогда
		КаналыКПарковке.Удалить(Channel);
	КонецЕсли; 
	
	parkinglot	=	"";					// Слот паркови, пустой - запарковать на свободный
	actionid	=	КлючУникальности;   //
	result		=	"";                 // в переменную будет помещен result выполнения команды
	
	Попытка
		Компонент.Park(channel,channel2,timeout,parkinglot,actionid,result);
		СообщитьОтладочнуюИнформацию("Парковка абонента " + Channel, result);
		
		Если Найти(result, "Park successful")>0 Тогда
			СлотПарковки 			 = Парковка.Добавить();
			СлотПарковки.Канал 		 = channel;
			СлотПарковки.Слот  		 = parkinglot;
			СлотПарковки.calleridnum = СтрокаЗвонка.CallerID;
			СлотПарковки.Контакт 	 = ?(ЗначениеЗаполнено(СтрокаЗвонка.КонтактноеЛицо), СтрокаЗвонка.КонтактноеЛицо, СтрокаЗвонка.Контрагент);
			СлотПарковки.Автоподъем  = Автоподъем;
		ИначеЕсли Найти(result, "Error")>0
				  И Найти(result, channel)>0 Тогда	
			Сообщить("Нет возможности запарковать текущую линию!");
			СообщитьОтладочнуюИнформацию("Парковка абонента", result);
		ИначеЕсли Найти(result, "Error")>0
				  И Найти(result, channel2)>0 Тогда	
			// Нет возможности оповестить паркующему абоненту: куда запарковали клиента.
			// Позже придет event с оповещением.
			СообщитьОтладочнуюИнформацию("Парковка абонента", result);
		Иначе
			Сообщить("Нет возможности запарковать текущую линию!");
			СообщитьОтладочнуюИнформацию("Парковка абонента channel = " + channel + ", channel2 = " + channel2, result);
		КонецЕсли; 
	Исключение
		СообщитьОтладочнуюИнформацию("Парковка абонента, ошибка " + Channel, result);
	КонецПопытки;	

КонецПроцедуры

/// 
// Asterisk 13 

// Дополнительная процедура обработки onBridge. Производит обновление таблицы связей каналов. 
// Параметры 
//   СтрокаXMLУзел - тип - строка, XML структура в строковом представлении.
Функция onBridgeОбновитьСвязиКаналов13_v2(Знач ДанныеXML)
	Результат = Неопределено;
	
	УзелХМЛ = ПолучитьЧтениеXML(ДанныеXML);
	СтруктураАтрибутов = ПолучитьСтруктуруАтрибутов(ДанныеXML);
	Если ТипЗнч(СтруктураАтрибутов) <> Тип("Соответствие") Тогда
		Возврат Результат;
	КонецЕсли;
	БриджУстановлен = Ложь;
	
	event  			= СтруктураАтрибутов.Получить("event");
	channel		 	= СтруктураАтрибутов.Получить("channel");
	bridgeuniqueid  = СтруктураАтрибутов.Получить("bridgeuniqueid");
	connectedlinenum= СтруктураАтрибутов.Получить("connectedlinenum");
	calleridnum     = СтруктураАтрибутов.Получить("calleridnum");
	linkedid 		= СтруктураАтрибутов.Получить("linkedid");
	
	врСтроки = СвязиКаналов13.НайтиСтроки(Новый Структура("bridgeuniqueid,channel", bridgeuniqueid, channel));
	Если event = "BridgeEnter" Тогда
		Если врСтроки.Количество()=0 Тогда
			врСвязь = СвязиКаналов13.Добавить();
			врСвязь.bridgeuniqueid 	 = СтруктураАтрибутов.Получить("bridgeuniqueid");
			врСвязь.channel 		 = СтруктураАтрибутов.Получить("channel");
		Иначе
			врСвязь = врСтроки[0];
		КонецЕсли; 
		врСвязь.calleridnum 	 = calleridnum;
		врСвязь.calleridname 	 = СтруктураАтрибутов.Получить("calleridname");
		врСвязь.linkedid 		 = СтруктураАтрибутов.Получить("linkedid");
		врСвязь.connectedlinenum = connectedlinenum;
		врСвязь.connectedlinename= СтруктураАтрибутов.Получить("connectedlinename");
		
		ПервоеПлечо = НайтиСвязьКанала13_v2(врСвязь.bridgeuniqueid, channel);
		Если Найти(ВРЕГ(channel), "LOCAL")>0 Тогда
			ВтороеПлечо = НайтиСвязьКанала13_v2(врСвязь.bridgeuniqueid, channel, 0, Ложь, Ложь);
			Если НЕ ВтороеПлечо = Неопределено Тогда
				СтруктураАтрибутов.Вставить("connectedchannel1", ВтороеПлечо.channel);			
			КонецЕсли;
		Иначе
			ВтороеПлечо = врСвязь;
			СтруктураАтрибутов.Вставить("connectedchannel1", ВтороеПлечо.channel);
		КонецЕсли; 
		
		Если ПервоеПлечо<>Неопределено И ВтороеПлечо<>Неопределено Тогда
			БриджУстановлен = Истина;
			// Переопределяем канал.
			СтруктураАтрибутов.Вставить("connectedchannel2", ПервоеПлечо.channel);			
			Если Найти(connectedlinenum, "unknown")>0 Тогда
				// Правим номер телефона в данных звонка.
				СтруктураАтрибутов.Вставить("connectedlinenum", ПервоеПлечо.calleridnum);
			КонецЕсли; 
			Если Найти(ВтороеПлечо.connectedlinenum, "unknown")>0 Тогда
				ВтороеПлечо.connectedlinenum = ПервоеПлечо.calleridnum;
			КонецЕсли;
			Если Найти(ПервоеПлечо.connectedlinenum, "unknown")>0 Тогда
				ПервоеПлечо.connectedlinenum = ВтороеПлечо.calleridnum;
			КонецЕсли;
			
			врКанал1 = Лев(ПервоеПлечо.channel,НайтиСправаОдинИзСимволов(ПервоеПлечо.channel, "-")-1);
			ОбновитьСобеседникаДляСотрудника(врКанал1, ПервоеПлечо.connectedlinenum);
			
			врКанал2 = Лев(ВтороеПлечо.channel,НайтиСправаОдинИзСимволов(ВтороеПлечо.channel, "-")-1);
			ОбновитьСобеседникаДляСотрудника(врКанал2, ВтороеПлечо.connectedlinenum);
			
			Если ЗначениеЗаполнено(ПервоеПлечо.channel) И ЗначениеЗаполнено(ВтороеПлечо.channel)
				 И Найти(ВРЕГ(ПервоеПлечо.channel+ВтороеПлечо.channel), "LOCAL")=0 Тогда			 
				 
				СтрочкаЗвонка =	НайтиСтрочкуЗвонка(УзелХМЛ);
				IS_ORIGINATE = СвязиКаналов.НайтиСтроки(Новый Структура("linkedid,IS_ORIGINATE",СтруктураАтрибутов.Получить("linkedid"), Истина)).Количество()>0;
				Если НЕ СтрочкаЗвонка = Неопределено Тогда
					Входящий = СтрочкаЗвонка.ВходящийЗвонок;
				ИначеЕсли IS_ORIGINATE И НазваниеPBX = "MIKOPBX" Тогда
					Входящий = Ложь
				Иначе
				 	Входящий = Истина;
				КонецЕсли; 
 
				Результат = Новый Структура();
				Если Найти(ПервоеПлечо.channel, НашКаналФильтр)>0 Тогда
					Если Входящий Тогда
						Результат.Вставить("channel", 			ВтороеПлечо.channel);								 
						Результат.Вставить("calleridnum", 		ВтороеПлечо.calleridnum);								 
						Результат.Вставить("dstchannel", 		ПервоеПлечо.channel);								 
						Результат.Вставить("connectedlinenum", 	ПервоеПлечо.calleridnum);								 						
					Иначе	
						Результат.Вставить("channel", 			ПервоеПлечо.channel);								 
						Результат.Вставить("calleridnum", 		ПервоеПлечо.calleridnum);								 
						Результат.Вставить("dstchannel", 		ВтороеПлечо.channel);								 
						Результат.Вставить("connectedlinenum", 	ВтороеПлечо.calleridnum);								 
					КонецЕсли; 
				Иначе
					// ПервоеПлечо.channel - чужой канал.
					Если Входящий Тогда
						Результат.Вставить("channel", 			ПервоеПлечо.channel);								 
						Результат.Вставить("calleridnum", 		ПервоеПлечо.calleridnum);								 
						Результат.Вставить("dstchannel", 		ВтороеПлечо.channel);								 
						Результат.Вставить("connectedlinenum", 	ВтороеПлечо.calleridnum);								 
					Иначе	
						Результат.Вставить("channel", 			ВтороеПлечо.channel);								 
						Результат.Вставить("calleridnum", 		ВтороеПлечо.calleridnum);								 
						Результат.Вставить("dstchannel", 		ПервоеПлечо.channel);								 
						Результат.Вставить("connectedlinenum", 	ПервоеПлечо.calleridnum);								 						
					КонецЕсли; 
				КонецЕсли;
				
				Результат.Вставить("linkedid", 			linkedid);
				Результат.Вставить("БриджУстановлен", 	БриджУстановлен);
			КонецЕсли; 
		КонецЕсли; 
		
	ИначеЕсли event = "BridgeLeave" И врСтроки.Количество()>0 Тогда	
		Для каждого врСтрока Из врСтроки Цикл
			СвязиКаналов13.Удалить(врСтрока);
		КонецЦикла; 
	КонецЕсли; 
	
	Возврат Результат;
КонецФункции

// Поиск канала, связанного с текущим.
// Помогает определить собеседника.
Функция НайтиСвязьКанала13_v2(Знач bridgeuniqueid, Знач channel, УровеньРекурсии=0, ИскатьПоLocal=Ложь, МенятьПлечоLocal = Истина)
	Результат = Неопределено; УровеньРекурсии = УровеньРекурсии + 1;
	Если УровеньРекурсии > 100 Тогда Возврат Неопределено; КонецЕсли; 
	
	Если Найти(ВРЕГ(channel), "LOCAL")>0 И ИскатьПоLocal=Ложь Тогда
 		Если МенятьПлечоLocal = Истина Тогда
			// Базовое имя канала  Local/04@internal-caller-transfer-000001f0
			LocalКанал = мОбработкаДанных.ОтсечьПлечоВLocal(channel, Ложь);
			// Необходимо найти, с каким каналом связано его второе плечо
			ИмяПлеча = ?(Найти(channel, ";2"), ";1", ";2");
			КаналДляПоиска = ""+LocalКанал+ИмяПлеча;
		Иначе
			КаналДляПоиска = ""+channel;
		КонецЕсли; 
		врСтроки = СвязиКаналов13.НайтиСтроки(Новый Структура("channel", КаналДляПоиска));
		Если врСтроки.Количество()=0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		// Идентификатор bridgeuniqueid будет отличаться от исходного.
		Возврат НайтиСвязьКанала13_v2(врСтроки[0].bridgeuniqueid, КаналДляПоиска, УровеньРекурсии, Истина);
	КонецЕсли;
	
	// Не более двух каналов в бридж.
	врСтроки = СвязиКаналов13.НайтиСтроки(Новый Структура("bridgeuniqueid", bridgeuniqueid));
	Для каждого врТекСтрока Из врСтроки Цикл
		Если врТекСтрока.channel = channel Тогда
			// В одном бридже только два канала.
		 	Продолжить;
		КонецЕсли; 
		
		Если Найти(ВРЕГ(врТекСтрока.channel), "LOCAL")>0 Тогда
			Возврат НайтиСвязьКанала13_v2(bridgeuniqueid, врТекСтрока.channel, УровеньРекурсии);
		КонецЕсли; 
		
		Результат = врТекСтрока;		
		Прервать;
	КонецЦикла;
	
	
	Возврат Результат;
КонецФункции // НайтиСвязьКанала13()

/////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ И ПРОЦЕДУРЫ ОТПРАВКИ КОММАНД ASTERISK серверу

// Экспериментальныя процедура. 
// Проверено ТОЛЬКО с телефонами Linksys.
Функция ОтветитьНаЗвонок(СтрочкаЗвонка) Экспорт
	Если СтрочкаЗвонка.СейчасРазговаривают = Истина Тогда
		// Подъем трубки не требуется.
		Возврат Истина;
	КонецЕсли; 
	
	Результат = Ложь;
	
	ЛинияSIP = ЗвонкиSIP.Найти(СтрочкаЗвонка.CallerID, "CallerID");        
	Если ИспользоватьСофтфон 
		 И ДопМодули.Свойство("НаборНомера")
		 И НЕ (ДопМодули.НаборНомера = Неопределено)
		 И ЛинияSIP <> Неопределено Тогда
		ДопМодули.НаборНомера.ВыполнитьДействиеНадЗвонком(ЛинияSIP.Канал, "КнопкаПринятьПоID");
	ИначеЕсли НЕ ИспользоватьAsterisk
		 И ДопМодули.Свойство("НаборНомера")
		 И НЕ (ДопМодули.НаборНомера = Неопределено) Тогда
		ДопМодули.НаборНомера.ВыполнитьДействиеНадЗвонком(СтрочкаЗвонка, "КнопкаПринять");
		Результат = Истина;
	ИначеЕсли ИспользоватьАвтоподъем = Истина
		 И СтрочкаЗвонка.АвтоПодъемВозможен Тогда 
			  
		Channel = ?(СтрочкаЗвонка.ВходящийЗвонок,СтрочкаЗвонка.Канал2,СтрочкаЗвонка.Канал1);	
		Если PickupChan(СтрочкаЗвонка.CallerID, Channel) Тогда
			Результат = Истина;
			СтрочкаЗвонка.СейчасРазговаривают = Истина;
		Иначе
			Сообщить("Автоматический подъем не возможен!");
		КонецЕсли; 
		
		// Запрещаем автоводъем для сторки звонка.
		СтрочкаЗвонка.АвтоПодъемВозможен = Ложь;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Инициализируем исходящий звонок
//
Функция НабратьНомер(НомерАбонента, КонтекстНабора=Неопределено, CallerID = "", ConnectedCID = "") Экспорт
	Если НаборНомераРазрешен
		 И ЗначениеЗаполнено(НомерАбонента) Тогда
		// временный запрет набора
		параметрНабора = НомерАбонента;
		мОбработкаДанных.ЗапретитьНаборНомера(параметрНабора);
	Иначе
		Возврат Ложь;
	КонецЕсли;
	Рез = Ложь;
	
	Если НЕ ИспользоватьAsterisk
		 И ДопМодули.Свойство("НаборНомера")
		 И НЕ (ДопМодули.НаборНомера = Неопределено) Тогда
		ДопМодули.НаборНомера.ВыполнитьДействиеНадЗвонком(НомерАбонента, "НабратьНомер");
		Возврат Истина;	
	КонецЕсли;
	
	Если КонтекстНабора=Неопределено Тогда	
		КонтекстНабора=КонтекстНабораПоУмолчанию;	
	КонецЕсли; 
	
	СтрокаТекущегоСотрудника = Сотрудники.Найти(мПользователь,"Сотрудник");
	Если СтрокаТекущегоСотрудника<>Неопределено Тогда
		НомерТекущегоПользователя = СтрокаТекущегоСотрудника.ВнутреннийНомер;	
	Иначе
		НомерТекущегоПользователя = мОбработкаДанных.УбратьИзНомераТелефонаВсеБуквы(НашКаналФильтр);
	КонецЕсли;                                         
	
	Если ФормаТелефон<>Неопределено Тогда             
		Если НЕ ФормаТелефон.Открыта() Тогда
			ФормаТелефон.Открыть();
		КонецЕсли;
		ФормаТелефон.Панель.ТекущаяСтраница=ФормаТелефон.Панель.Страницы.Панель;
	КонецЕсли;
	
	Если (НЕ ПустаяСтрока(НомерАбонента)) И (НЕ ПустаяСтрока(НашКаналФильтр)) И (НЕ ПустаяСтрока(КонтекстНабора)) тогда
		Если НазваниеPBX = "MIKOPBX" Тогда
		 	Channel = "Local/"+НашНомерТелефона+"@internal-originate/n";
		Иначе
			Channel		=	НашКаналФильтр;		
		КонецЕсли;  
		Context		=	КонтекстНабора;			//	Context: Название контекста для совершения исходящего вызова (используется только совместно с параметрами Exten и Priority)
		Exten		=	НомерАбонента;			//	Exten: Extension to use on connect (используется только совместно с параметрами Context и Priority)
		Priority	=	"1";					//	Priority: Priority to use on connect (используется только совместно с параметрами Context и Exten)
		Timeout		=	"";						//	Timeout: Таймаут (в миллисекундах) для соединения с инициатором исходящего вызова (значение по умолчанию: 30000 миллисекунд).
		
		Если НЕ ЗначениеЗаполнено(CallerID) Тогда
			CallerID	=	"""" + мОбработкаДанных.Транслитерация(мПользователь.Наименование) + """" + " <" + НомерТекущегоПользователя + ">"; //	CallerID: Значение CallerID, используемое для совершения исходящего вызова.
		Иначе
			CallerID= Строка(CallerID);
		КонецЕсли; 
		IS_ORGNT    =  Формат(ТекущаяДата() - НачалоДня(ТекущаяДата()), "ЧДЦ=0; ЧГ=0");
		pt1c_cid 	= ?(ЗначениеЗаполнено(ConnectedCID), ConnectedCID, НомерАбонента);
		Variable	=	"_IS_ORGNT="+IS_ORGNT+",pt1c_cid="+pt1c_cid+",extenfrom1c="+URLEncode(НомерАбонента)+","
						+"from_1C=true,"
						+?(ИспользоватьАвтоподъем,URLEncode(СтрокаАвтоподъема),"");   // Linksys SPA-942 точно умеет автоподьем
		//	Variable: Установка переменных канала (максимум 32). Переменные будут установлены для обоих каналов, участвующих в соединении (локального, для абонента от которого совершается вызов и для вызываемого канала).
		Account		=	"";						//	Account: Значение для “Account code” исходящего вызова.
		Application	=	"";						//	Application: Команда плана набора, используемая для совершения исходящего вызова (используется параметр “Data”, для указания ее параметров)
		Data		=	"";						//	Data : Параметры команды плана набора, используемой для совершения исходящего вызова.
		Async		=	"1";					//	Async: Если указано “true” исходящий вызов будет производиться асинхронно. Результат ее выполнения будет возвращен позже, в пакете типа “Event” (позволяет осуществлять несколько вызовов без ожидания результата предыдущей команды, совершающей исходящий вызов)
		Codecs		=	"";						//  Используемый кодек
		ActionID	=	КлючУникальности;		//	ActionID: Не обязательный идентификатор запроса. Позволяет сопоставить результат выполнения конкретному запросу. В качестве значения можно использовать или номер или строку. Очень полезно использовать, когда выполняется несколько асинхронных запросов одновременно.
		
		Результат="";
		Попытка
			Компонент.Originate(Channel, Context, Exten, Priority, Timeout, CallerID, Variable, Account, Application, Data, Async, Codecs, "", ActionID, Результат);
			СообщитьОтладочнуюИнформацию("Инициирован звонок с "+НашКаналФильтр+" на номер "+НомерАбонента,Результат);
			Рез=Истина;
		Исключение
			СообщитьОтладочнуюИнформацию("Ошибка при инициализации звонка на номер "+НомерАбонента,Результат);
		КонецПопытки;	
		
	КонецЕсли;
	Возврат Рез;
КонецФункции

// Пробуем перехватить звонок на наш номер
// с автоматически подъемом трубки
// 
Функция PickupChan(Знач CallerIDЗвонка, Знач Канал)
	
	НомерПользователя = ПолучитьНомерВызываемогоАбонентаИзАтрибутаDialstring(Канал);
	стр_auto_answer = СоответствиеАвтоподъем.Получить(НомерПользователя);	
	стр_auto_answer = ?(ЗначениеЗаполнено(стр_auto_answer), стр_auto_answer, СтрокаАвтоподъема);
	// автоматический подъем трубки возможне ТОЛЬКО на SIP устройствах
	// переданный в функцию канал - должен быть нашим каналом
	// НомерПрямойПарковки - параметр должен быть получен с АТС
	Если НЕ ЭтоНомерТекущегоПользователя(Канал, мСписокНомеровПользователяДляОбработки)
		 ИЛИ НЕ ЗначениеЗаполнено(НомерПрямойПарковки)
		 ИЛИ НЕ ЗначениеЗаполнено(стр_auto_answer) Тогда
		Возврат Ложь;
	КонецЕсли; 
	
    Упех = Ложь; 
	Если ИспользоватьАвтоподъем тогда
		ЭтоMYPBX_U  = (НазваниеPBX = "MYPBX" И НЕ Лев(НашКаналФильтр,5)="PJSIP");
		ЭтоMIKOPBX  = (НазваниеPBX = "MIKOPBX");
	
		Channel		=	НашКаналФильтр;			
		Context		=	КонтекстНабораПоУмолчанию;
		Exten		=	""+НомерПрямойПарковки+НомерПользователя;		
		Priority	=	?(ЭтоMYPBX_U,"7","1");					
		Timeout		=	"30000";				
		CallerID	=	CallerIDЗвонка; 	
		Variable	=	"from_1C=true,CTICHANNEL="+
						URLEncode(Канал)+","+
						URLEncode(стр_auto_answer);
		Account		=	"";						
		Application	=	?(ЭтоMYPBX_U ИЛИ ЭтоMIKOPBX,"","PickupChan");
		Data		=	?(ЭтоMYPBX_U ИЛИ ЭтоMIKOPBX,"",""+Канал);
		Async		=	"";
		Codecs		=	"";
		ActionID	=	КлючУникальности;
		
		Результат="";
		Попытка
			Компонент.Originate(Channel, Context, Exten, Priority, Timeout, CallerID, Variable, Account, Application, Data, Async, Codecs, "", ActionID, Результат);
			Упех = ?(Найти(Результат,"Success")>0,Истина,Ложь);
		Исключение
			СообщитьОтладочнуюИнформацию("Ошибка при инициализации автоподъема! ",Результат);
		КонецПопытки;	
	КонецЕсли;
   	Возврат Упех;
КонецФункции // PickupChan()

// Подслушиваем разговор другого пользователя
//
Процедура ПодслушатьРазговор(КаналАбонента,НомерАбонента=Неопределено) Экспорт
	Если НаборНомераРазрешен
		 И ЗначениеЗаполнено(КаналАбонента) И ЗначениеЗаполнено(НашКаналФильтр) Тогда
		// временный запрет набора
		параметрНабора = НомерАбонента;
		мОбработкаДанных.ЗапретитьНаборНомера(параметрНабора);
	Иначе
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НомерАбонента)
		ИЛИ НЕ ЗначениеЗаполнено(НашКаналФильтр)
		Тогда
		Возврат;			
	КонецЕсли; 
	
	Channel		=	НашКаналФильтр;			//	Channel: Название канала, с которого совершается исходящий вызов (В том же формате, как если бы Вы совершали вызов этому абоненту командой Dial.)
	CallerID	=	"Spy-" + НомерАбонента + " <"+НомерАбонента+">";
	Application	=	"ChanSpy";				//	Application: Команда плана набора, используемая для совершения исходящего вызова (используется параметр “Data”, для указания ее параметров)
	Data		=	КаналАбонента+",qx";	//	Data : Параметры команды плана набора, используемой для совершения исходящего вызова.
	Variable	=	"from_1C=true,1с_ChanSpy="+НашКаналФильтр+","+?(ИспользоватьАвтоподъем,URLEncode(СтрокаАвтоподъема),"");   // Linksys SPA-942 точно умеет автоподьем
	ActionID	=	КлючУникальности;
	
	Результат="";
	Попытка
		Компонент.Originate(Channel,,,,, CallerID,Variable,, Application, Data,"1",,"",ActionID, Результат);
		СообщитьОтладочнуюИнформацию("Начало прослушивания номера "+НомерАбонента,Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Ошибка при прослушивании номера "+НомерАбонента,Результат);
	КонецПопытки;	
	
КонецПроцедуры
 
