// Функция преобразует параметры в строковый вид в виде 
// [Параметр1]          [Параметр2]         [Параметр3][Параметр4][Параметр5]    [Параметр6]
// [ИдентификаторЗвонка][Входящий/Исходящий][КодСтраны][КодГорода][НомерТелефона][Внутренний]
Функция ПреобразоватьПараметрыВСтроку(ТекущаяСтрока) Экспорт
	
	Результат="";
	
	Номер = "";
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.КодСтраны) И НЕ ЗначениеЗаполнено(ТекущаяСтрока.КодГорода) Тогда
		Номер = СокрЛП(ТекущаяСтрока.Внутренний);
	Иначе
		Номер = ?(НЕ ЗначениеЗаполнено(ТекущаяСтрока.НомерТелефона), СокрЛП(ТекущаяСтрока.КодГорода), СокрЛП(ТекущаяСтрока.НомерТелефона));
	КонецЕсли;
	
	ТипЗвонка = СокрЛП(ОпределитьВнутреннийВнешнийЗвонок(Номер));
	Результат = Результат + "["+ТипЗвонка+"]";
	
	Если Число(ТипЗвонка) = ТипВнутреннийВнешнийЗвонок.Внутренний Тогда
		ТмпКодСтраны 	= "";
		ТмпКодГорода 	= "";
		ТмпНомер 		= "";
		ТмпВнутренний 	= Номер;
	Иначе
		ТмпКодСтраны 	= ТекущаяСтрока.КодСтраны;
		ТмпКодГорода 	= ТекущаяСтрока.КодГорода;
		ТмпНомер 		= Номер;
		ТмпВнутренний 	= "";
	КонецЕсли;
	
	Результат = Результат + "["+ТмпКодСтраны+"]"+
	"["+ТмпКодГорода+"]"+
	"["+ТмпНомер+"]"+
	"["+ТмпВнутренний+"]";
	
	Возврат Результат;
КонецФункции

// Заполняет таблицу сотрудников компании с внутренними номерами и полом, для правильного отображения картинки
//
Процедура ЗаполнитьТаблицуСотрудников() Экспорт
	Если Компонент=Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	// получаем таблицу зарегистрированных номеров с АТС
	Если ТаблицаХинтов=Неопределено
		 ИЛИ ТаблицаХинтов.Количество()=0 Тогда
		ТаблицаХинтов = ЗапроситьСписокХинтовССервераAsterisk();
		Если ТаблицаХинтов=Неопределено Тогда
			Сообщить("Сервер телефонии не вернул список внутренних номеров, проверяйте настройки!" );
			Возврат;
		КонецЕсли; 
	КонецЕсли; 
	Попытка
		// подготавливаем таблицу контактной информации пользователей
		Запрос = мОбщийМодуль.ПолучитьЗапросЗаполнитьТаблицуСотрудников();
		КИ = Запрос.Выполнить().Выгрузить();
		Для каждого СтрокаКИ Из КИ Цикл
			СтрокаКИ.ВнутреннийНомер = мОбработкаДанных.УбратьИзНомераТелефонаВсеБуквы(СтрокаКИ.ВнутреннийНомер);	
			СтрокаКИ.Мобильный 		 = мОбработкаДанных.УбратьИзНомераТелефонаВсеБуквы(СтрокаКИ.Мобильный);	
		КонецЦикла; 
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Запрос = мОбработкаДанных.ПолучитьЗапросЗаполнитьТаблицуСотрудников();
	Запрос.УстановитьПараметр("Контакты", КИ);
	Запрос.УстановитьПараметр("ТаблицаХинтов",ТаблицаХинтов);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Сотрудники.Очистить();
	Пока Выборка.СледующийПоЗначениюПоля("Пользователь") Цикл
		Пока Выборка.СледующийПоЗначениюПоля("ЗначениеПоУмолчанию") Цикл
			Если не ЗначениеЗаполнено(Выборка.ВнутреннийНомер) Тогда 
				Продолжить;	 //зачем нам сотрудник без номера
			КонецЕсли; 
			
			СотрудникиСтрока=Сотрудники.Найти(Выборка.Пользователь,"Сотрудник");
			Если СотрудникиСтрока=Неопределено Тогда
				СотрудникиСтрока=Сотрудники.Добавить();	
			ИначеЕсли Не Выборка.ЗначениеПоУмолчанию тогда
				Продолжить;
			КонецЕсли; 
			
			СотрудникиСтрока.Сотрудник			= Выборка.Пользователь;
			СотрудникиСтрока.ВнутреннийНомер	= мОбработкаДанных.УбратьИзНомераТелефонаВсеБуквы(Выборка.ВнутреннийНомер);
			СотрудникиСтрока.КаналСотрудника 	= Выборка.Канал;
			
			врСтрока = КИ.Найти(Выборка.Пользователь, "Объект");
		    Если врСтрока<>Неопределено Тогда
				СотрудникиСтрока.МобильныйНомер = врСтрока.Мобильный;	
			КонецЕсли; 
			// Вдруг у нас комплекная или УПП. Там есть реквизит физлицо.
			Если ЗначениеЗаполнено(Выборка.ФизЛицо) 
				И Выборка.ФизЛицо.Метаданные().Реквизиты.Найти("Пол")<> Неопределено Тогда
				Попытка
					Пол = Выборка.ФизЛицо["Пол"] 
				Исключение
					СообщитьОтладочнуюИнформацию("Исключительная ситуация: ", "Не хватает прав на просмотр справочника ""Физические лица"".", ИнформацияОбОшибке());
				КонецПопытки; 
			Иначе
				Пол	= Выборка.Пол;
			КонецЕсли;
			
			Если Найти(Пол,"Муж")>0 Тогда
				СотрудникиСтрока.Пол	=	0;
			ИначеЕсли Найти(Пол,"Жен")>0 Тогда
				СотрудникиСтрока.Пол	=	3;
			Иначе
				СотрудникиСтрока.Пол	=	6; 
			КонецЕсли;
			
			Если Найти(Выборка.Состояние,"InUse")>0 Тогда
				СотрудникиСтрока.Состояние	=	СостояниеЭкстеншена.Разговаривает;
			ИначеЕсли Найти(Выборка.Состояние,"Unavailable")>0 Тогда
				СотрудникиСтрока.Состояние	=	СостояниеЭкстеншена.Недоступен;
			Иначе
				СотрудникиСтрока.Состояние	=	СостояниеЭкстеншена.Свободен; 
			КонецЕсли;
			
			// Определим канал текущего пользователя панели телефонии
			Если СотрудникиСтрока.Сотрудник = мПользователь 
				И НЕ ЗначениеЗаполнено(НашКаналФильтр) Тогда
				НашКаналФильтр  = (СотрудникиСтрока.КаналСотрудника);
				НашНомерТелефона = ""+Выборка.ВнутреннийНомерПира;
				ТаблицаХинтов.Найти(НашКаналФильтр);
				
				хинт = ТаблицаХинтов.Найти(НашКаналФильтр);
				Если НЕ хинт = Неопределено И ЗначениеЗаполнено(хинт.UserAgent) Тогда
					ВидСофтфонаПользователя = хинт.UserAgent;	
					СтрокаАвтоподъема  		= ВернутьСтрокуАвтоподъемаТрубки(ВидСофтфонаПользователя);
				КонецЕсли; 
				
				НашDAHDIПорт = ПолучитьНомерВызываемогоАбонентаИзАтрибутаDialstring(НашКаналФильтр);
				
				ПолучитьКонтекстССервераAsterisk();
				Если Найти(НашКаналФильтр,"PJSIP")>0 И ИспользоватьАвтоподъем Тогда
					ПолучитьПараметрыSIPПира(НашНомерТелефона, "PJSIP");
				ИначеЕсли Найти(НашКаналФильтр,"SIP")>0 Тогда
					ПолучитьПараметрыSIPПира(НашНомерТелефона, "SIP");
				КонецЕсли;
				// Статусы / начало
				УстановитьСтатус("0", НашКаналФильтр, "Idle");
				// Статусы / конец
				Банер_УстановитьПараметрыТП();

			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;
	ПрочитатьСтатусыИзБД();
	
	Если Сотрудники.Количество()=0 Тогда
		Сообщить("В справочнике пользователей не прописаны внтуренние номера или не выделены как основные, таблица сотрудников не будет заполнена!",СтатусСообщения.Важное);
	КонецЕсли;		
КонецПроцедуры // ЗаполнитьТаблицуСотрудников()

// Заполнить таблицу истории звонков 
//
// Параметры
//  ДатаЗаполнения  -Дата - Дата за которую выбираем историю звонков с астериск сервера
//
Процедура ЗаполнитьТаблицуИсторииЗвонков(ДатаЗаполнения='00010101', врИсторияЗвонков=Неопределено) Экспорт
	Если НЕ ИспользоватьAsterisk Тогда
	    Оповестить("ЗаполнитьТаблицуИсторииЗвонков_SIP", ДатаЗаполнения, врИсторияЗвонков);
		Возврат;
	КонецЕсли; 
		
	Если врИсторияЗвонков = Неопределено Тогда
		ТЗИсторииЗвонковВременная.Очистить();
		ЗапроситьЗаписиCDRДляТекущегоПользователя(ДатаЗаполнения);
		ИсторияЗвонков.Очистить();
		
		Банер_ЗаполнитьИсториюЗвонков();
		Возврат;
	ИначеЕсли ТипЗнч(врИсторияЗвонков)<>Тип("Массив") ИЛИ врИсторияЗвонков.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоMYPBX_U  = (НазваниеPBX = "MYPBX" И НЕ Лев(НашКаналФильтр,5)="PJSIP");
	Колонка_id = ?(ЭтоMYPBX_U, "recordingfile", "uniqueid");
	Для Каждого Вызов Из врИсторияЗвонков Цикл
		
		// Наполняем таблицу с именами файлов записей разговоров.
		врОтбор = Новый Структура("uniqueid,recordingfile");
		ЗаполнитьЗначенияСвойств(врОтбор, Вызов);
		Если ЗначениеЗаполнено(врОтбор.recordingfile) Тогда
		  	врСтроки = ЗаписиРазговоров.НайтиСтроки(врОтбор);
			Если врСтроки.Количество()=0 Тогда
				врЗапись = ЗаписиРазговоров.Добавить();
				ЗаполнитьЗначенияСвойств(врЗапись, врОтбор);
				врЗапись.Представление = "Длительность: " + Вызов.ПродолжительностьВызова + ", """ + Вызов.ArrayDialers + """"; 
			КонецЕсли; 
		КонецЕсли; 
		
		НомерТелефона = ?(Вызов.Входящий, Вызов.КтоЗвонит, Вызов.КомуЗвонит);
		Если Вызов.Пропущен = Истина И ЭтоMYPBX_U Тогда
			id = Вызов["uniqueid"]; // Имя файла записи не заполнено.
		Иначе	
		 	id = Вызов[Колонка_id];
		КонецЕсли; 
		
		// Проверим не было ли среди списка дозвонов звонка с ответом, если был, надо его подменить.
		СтрокаТаблицыCDR = НайтиСтрокуИсторииПоКолонкам(id, "uniqueid");
		Если СтрокаТаблицыCDR = Неопределено Тогда
			НовыйЗвонок = ТЗИсторииЗвонковВременная.Вставить(0);
			НовыйЗвонок.channel					= Вызов.channel;
			НовыйЗвонок.dstchannel				= Вызов.dstchannel;
			НовыйЗвонок.calldate 	 			= Вызов.Начало;
			НовыйЗвонок.ArrayDialers 		    = Вызов.ArrayDialers;
			НовыйЗвонок.ПропущенныйЗвонок 		= Истина;
			НовыйЗвонок.ВходящийЗвонок	 		= Вызов.Входящий;
		Иначе
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицыCDR.callerid) И ЗначениеЗаполнено(Вызов.dstchannel) Тогда
				СтрокаТаблицыCDR.callerid = НомерТелефона;
			КонецЕсли;

			НовыйЗвонок = СтрокаТаблицыCDR;
			
			// дополняем значениями
			МассивПриемник = мОбработкаДанных.мРазложитьСтрокуВМассивПодстрок(НовыйЗвонок.ArrayDialers, ",");
			МассивИсточник = мОбработкаДанных.мРазложитьСтрокуВМассивПодстрок(Вызов.ArrayDialers, ",");
			мОбработкаДанных.ДополнитьМассив(МассивПриемник,МассивИсточник,Истина);
			
			НовыйЗвонок.ArrayDialers = МассивПриемник;
			// Установка даты начала звонка.
			СтараяДата 					= НовыйЗвонок.calldate;
			СтарНаправление 			= НовыйЗвонок.ВходящийЗвонок;
			НовыйЗвонок.calldate		= Вызов.Начало;
			// Скорректируем направление и начало звонка.
			Если НЕ СтараяДата = Дата("00010101")
				 ИЛИ (СтараяДата < СтрокаТаблицыCDR.calldate И НЕ СтараяДата = Дата("00010101"))  Тогда
				НовыйЗвонок.calldate  		= СтараяДата;      // Дата начала вызова.
				НовыйЗвонок.ВходящийЗвонок	= СтарНаправление; // Исходное направление звонка верное.
			КонецЕсли;
		КонецЕсли;
		
		врChanSpy = Ложь;
		Если СтрокаТаблицыCDR = Неопределено И ЗначениеЗаполнено(Вызов.dstchannel) Тогда
			// Номер заполняем из первой записи истории звонков.
			// Исключение - запись, где нет канала назначения.
			НовыйЗвонок.callerid			= НомерТелефона;
		ИначеЕсли Вызов.КтоЗвонит = "Conference_Room" Тогда
			НовыйЗвонок.callerid			= Вызов.КтоЗвонит;
		ИначеЕсли "ChanSpy" = Вызов.LastApp И "" = Вызов.dstchannel Тогда
			НовыйЗвонок.callerid			= Вызов.КтоЗвонит;
			врChanSpy = Истина;	
		ИначеЕсли НЕ ЗначениеЗаполнено(НовыйЗвонок.callerid) Тогда	
			НовыйЗвонок.callerid			= НомерТелефона;
		КонецЕсли; 
		
		НовыйЗвонок.uniqueid	   = id;
		Если НазваниеPBX = "MYPBX" Тогда
			НовыйЗвонок.uid        = Вызов["uniqueid"];
		КонецЕсли; 
		НовыйЗвонок.ПропущенныйЗвонок	= МИН(Вызов.Пропущен, НовыйЗвонок.ПропущенныйЗвонок);
		
		Попытка
			Длительность = Число(Вызов.ПродолжительностьВызова);
		Исключение
			Длительность = 0;            
		КонецПопытки; 
		НовыйЗвонок.СекундДлился = НовыйЗвонок.СекундДлился + Длительность;
		НовыйЗвонок.recordingfile= ?(ЗначениеЗаполнено(НовыйЗвонок.recordingfile),НовыйЗвонок.recordingfile,Вызов.recordingfile);
		НовыйЗвонок.did			 = ?(ЗначениеЗаполнено(НовыйЗвонок.did),НовыйЗвонок.did,Вызов.did);
		НовыйЗвонок.врChanSpy    = врChanSpy;	
	КонецЦикла;
	
	// Найдем список объектов подходящих для номеров в графах  dst и src.
	Состояние("Определяем соответствие номеров телефонов и контактов из CRM.");
	
	врТаб = ТЗИсторииЗвонковВременная.Скопировать();
	врТаб.Свернуть("uniqueid");

	ТЗУчастникиЗвонков = Новый Соответствие;
    Для каждого стр_врТаб Из врТаб Цикл
		ArrayDialers = Новый Массив;
		строкиЗвонка = ТЗИсторииЗвонковВременная.НайтиСтроки(Новый Структура("uniqueid", стр_врТаб.uniqueid));
		Для каждого текЗвонок Из строкиЗвонка Цикл
			мОбработкаДанных.ДополнитьМассив(ArrayDialers,текЗвонок.ArrayDialers,Истина);
		КонецЦикла;
		ТЗУчастникиЗвонков.Вставить(СокрЛП(стр_врТаб.uniqueid), ArrayDialers);
	КонецЦикла; 
	
	ТЗ=ТЗИсторииЗвонковВременная;
	НазначенияВызововdst=ТЗ.ВыгрузитьКолонку("callerid");
	
	ВремМассивНомеровЧислом = Новый Массив;
	Для каждого Вызов Из ТЗИсторииЗвонковВременная Цикл
		Номер1 = мОбработкаДанных.ПреобразоватьНомерДляСохранения(Вызов.callerid, ГлобальныеПеременные.глКоличествоХранимыхЦифрТелефона);
		Если Номер1<>0 Тогда
			ВремМассивНомеровЧислом.Добавить(Номер1);
		КонецЕсли; 
	КонецЦикла; 
	
	Запрос = мОбщийМодуль.ПолучитьЗапросЗаполнитьТаблицуИстории();
	Запрос.УстановитьПараметр("ТипКИ", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("НазначенияВызововdst", НазначенияВызововdst);
	Запрос.УстановитьПараметр("НазначенияВызововsrc", Новый Массив);
	Запрос.УстановитьПараметр("ВремМассивНомеровЧислом", ВремМассивНомеровЧислом);
	
	Результат 	    = Запрос.Выполнить();
	СписокКонтактов = Результат.Выгрузить();
	
	// Найдем документы события привязанные к истории звонков по GUID
	Колонка_id = ?(НазваниеPBX = "MYPBX", "recordingfile", "uniqueid");
	МассивГуидов = ТЗ.ВыгрузитьКолонку(Колонка_id);
	СпиосокДокументовСобытие = мОбщийМодуль.ПолучитьТаблицуСобытийПоGUID(МассивГуидов);
	
	ИсторияЗвонков.Очистить();

	Для к=0 по ТЗ.Количество()-1 Цикл
		Если ИсторияЗвонков.Найти(ТЗ[к].uniqueid,"ИдентификаторЗвонка")<> Неопределено тогда  // уже есть такая строчка
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока = ИсторияЗвонков.Добавить();
		НоваяСтрока.Когда				= ТЗ[к].calldate;
		НоваяСтрока.СекундДлился 		= ТЗ[к].СекундДлился;  
		// информация об имени файла записи разговоров 
		НоваяСтрока.ИдентификаторЗвонка	= ТЗ[к].uniqueid;
		НоваяСтрока.ПропущенныйЗвонок 	= ТЗ[к].ПропущенныйЗвонок;
		НоваяСтрока.ИмяФайла			= ?(НоваяСтрока.ПропущенныйЗвонок=Истина,"",ТЗ[к].recordingfile);
		
		НоваяСтрока.НомерТелефона 		= ТЗ[к].callerid;
		НоваяСтрока.ВходящийЗвонок		= ТЗ[к].ВходящийЗвонок;			
		НоваяСтрока.врChanSpy			= ТЗ[к].врChanSpy;			
		НоваяСтрока.did					= ТЗ[к].did;			

		// Попробуем заполнить контрагента и контактного лица
		// поиск по строковому представлению номера (для Skype)
		СтрокаСКонтактом =  Неопределено;
		ЭтоSkype 		  = мОбработкаДанных.ЭтоНеЧисловойНомер(НоваяСтрока.НомерТелефона);			
		Если НЕ ЭтоSkype Тогда
			// рализован поиск строки по числовому номеру
			ИскомыйНомер = мОбработкаДанных.ПреобразоватьНомерДляСохранения(НоваяСтрока.НомерТелефона, ГлобальныеПеременные.глКоличествоХранимыхЦифрТелефона);
			Если ИскомыйНомер > 0 Тогда
				СтрокаСКонтактом = СписокКонтактов.Найти(ИскомыйНомер,"CRM_ЧисловоеПолеТелефона");
			КонецЕсли;
		Иначе
			СтрокаСКонтактом = СписокКонтактов.Найти(НоваяСтрока.НомерТелефона,"НомерТелефона");
		КонецЕсли; 
		
		Если СтрокаСКонтактом<>Неопределено Тогда
			ДанныеЗаполнения = мОбщийМодуль.ПолучитьДанныеЗаполненияСтрокиИстории(СтрокаСКонтактом);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаполнения);
			ОбъектКонтакта = СтрокаСКонтактом.Объект;
		КонецЕсли;
		Колонка_id = ?(НазваниеPBX = "MYPBX", "ИмяФайла", "ИдентификаторЗвонка");
		Если НЕ ЗначениеЗаполнено(НоваяСтрока[Колонка_id]) Тогда
			Продолжить;
		КонецЕсли; 
		// Попробуем заполнить событие к текущему звонку	
		СтрокаССобытием=СпиосокДокументовСобытие.Найти(НоваяСтрока[Колонка_id],"ИдентификаторЗвонка");
		Если СтрокаССобытием<>Неопределено Тогда
			НоваяСтрока.ДокументСобытие 		=	СтрокаССобытием.Ссылка;
		КонецЕсли;	
		
	КонецЦикла;			
	ИсторияЗвонков.Сортировать("Когда Убыв");
	
	Банер_ЗаполнитьИсториюЗвонков();
КонецПроцедуры // ЗаполнитьТаблицуИсторииЗвонков()

// Поиск строки по колонкам.
// 
Функция НайтиСтрокуИсторииПоКолонкам(Значение, Колонки, ИмяТаблицы = "ТЗИсторииЗвонковВременная")
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	МассивКолонов = мОбработкаДанных.мРазложитьСтрокуВМассивПодстрок("" + Колонки);	
	Для каждого Звонок Из ЭтотОбъект[ИмяТаблицы] Цикл
		// обход имен колонок
		Для каждого текКолонка Из МассивКолонов Цикл
			// проверка совпадения
			Если ЗначениеЗаполнено(текКолонка) И СокрЛП(Звонок[текКолонка]) = СокрЛП(Значение) Тогда
				Возврат Звонок;
			КонецЕсли; 
		КонецЦикла; 
	КонецЦикла;    	
	
	Возврат Неопределено;
КонецФункции // НайтиСтрокуИсторииПоКолонкам()

// Получаем с сервера список отправленных принятных факсимильных сообщений
//
Процедура ЗаполнитьТаблицуФаксимильныхСообщений(ДатаНачала='00010101',ДатаОкончания='00010101',ТЗ=Неопределено) Экспорт
	Если ТЗ=Неопределено  
		И Метаданные.ОбщиеМодули.Найти("МИКО_Астериск_Сервер")<>Неопределено 
		Тогда  //Есть серверный модуль для прямой связи с базой данных астериска через ODBC
		ТЗ=Вычислить("МИКО_Астериск_Сервер.ВернутьЗаписиCDRПоФаксимильнымСообщениям(НачалоДня(ДатаНачала),КонецДня(ДатаОкончания))");
	ИначеЕсли ТЗ=Неопределено Тогда 	// используем последовательное чтение данных через userevent
		ТЗФаксовВременная.Очистить();
		ЗапроситьЗаписиCDRПоФаксимильнымСообщениям(НачалоДня(ДатаНачала),КонецДня(ДатаОкончания)+1);
		Состояние("Запрашиваем историю факсимильных сообщений на сервере.");
		Возврат;
	ИначеЕсли ТЗ.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	//Найдем список объектов подходящих для номеров в графах  dst и src
	Состояние("Определяем соответствие номеров телефонов и контактов из CRM.");
	
	НазначенияВызововdst=ТЗ.ВыгрузитьКолонку("dst");
	НазначенияВызововsrc=ТЗ.ВыгрузитьКолонку("src");
	
	ВремМассивНомеровЧислом = Новый Массив;
	Для каждого Вызов Из ТЗИсторииЗвонковВременная Цикл
		Номер1 = мОбработкаДанных.ПреобразоватьНомерДляСохранения(Вызов.dst, ГлобальныеПеременные.глКоличествоХранимыхЦифрТелефона);
		Номер2 = мОбработкаДанных.ПреобразоватьНомерДляСохранения(Вызов.src, ГлобальныеПеременные.глКоличествоХранимыхЦифрТелефона);
		Если Номер1<>0 Тогда
			ВремМассивНомеровЧислом.Добавить(Номер1);
		КонецЕсли; 
		Если Номер2<>0 Тогда
			ВремМассивНомеровЧислом.Добавить(Номер2);
		КонецЕсли; 
	КонецЦикла; 
	
	Запрос = мОбщийМодуль.ПолучитьЗапросЗаполнитьТаблицуИстории();
	Запрос.УстановитьПараметр("ТипКИ", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("НазначенияВызововdst", НазначенияВызововdst);
	Запрос.УстановитьПараметр("НазначенияВызововsrc", НазначенияВызововsrc);
	Запрос.УстановитьПараметр("ВремМассивНомеровЧислом", ВремМассивНомеровЧислом);
	
	Результат 	    = Запрос.Выполнить();
	СписокКонтактов = Результат.Выгрузить();
	
	// Найдем документы события привязанные к истории звонков по GUID
	МассивГуидов = ТЗ.ВыгрузитьКолонку("uniqueid");
	СпиосокДокументовСобытие = 	мОбщийМодуль.ПолучитьТаблицуСобытийПоGUID(МассивГуидов);
	
	ФаксимильныеСообщения.Очистить();
	
	Для к=0 по ТЗ.Количество()-1 Цикл
		Если ФаксимильныеСообщения.Найти(ТЗ[к].uniqueid,"ИдентификаторЗвонка")<> Неопределено тогда  // уже есть такая строчка
			Продолжить;
		КонецЕсли;	
		
		НоваяСтрока = ФаксимильныеСообщения.Добавить();
		НоваяСтрока.Когда				=	ТЗ[к].calldate;
		НоваяСтрока.ФайлФакса 			=	ТЗ[к].lastdata;  
		НоваяСтрока.ИдентификаторЗвонка	=	ТЗ[к].uniqueid;  
		Если ТЗ[к].lastapp="SendFAX" Тогда
			НоваяСтрока.ВходящийЗвонок=Ложь;	
			НоваяСтрока.НомерТелефона	=	ТЗ[к].dst;
		ИначеЕсли ТЗ[к].lastapp="ReceiveFAX"	Тогда
			НоваяСтрока.ВходящийЗвонок=Истина;
			НоваяСтрока.НомерТелефона	=	ТЗ[к].src;
		Иначе // чаще всего входящие 
			НоваяСтрока.ВходящийЗвонок=Истина;
			НоваяСтрока.НомерТелефона	=	ТЗ[к].src;
		КонецЕсли;
		
		// Попробуем заполнить контрагента и контактного лица
		СтрокаСКонтактом=СписокКонтактов.Найти(НоваяСтрока.НомерТелефона,"НомерТелефона");
		
		Если СтрокаСКонтактом<>Неопределено Тогда
			ДанныеЗаполнения = мОбщийМодуль.ПолучитьДанныеЗаполненияСтрокиИстории(СтрокаСКонтактом);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеЗаполнения);
		КонецЕсли;
		
		// Попробуем заполнить событие к текущему звонку	
		СтрокаССобытием=СпиосокДокументовСобытие.Найти(НоваяСтрока.ИдентификаторЗвонка,"ИдентификаторЗвонка");
		Если СтрокаССобытием<>Неопределено Тогда
			НоваяСтрока.ДокументСобытие 		=	СтрокаССобытием.Ссылка;
		КонецЕсли;	
		
	КонецЦикла;			
	ФаксимильныеСообщения.Сортировать("Когда Убыв");
	
КонецПроцедуры //ЗаполнитьТаблицуФаксимильныхСообщений()

// В процедуре заполняется массив номеров для перевода звонков на текущего менеджера
//
Процедура ЗаполнитьСписокТелефоновДляПереводаНаОтветственного() Экспорт
	Если Не ПерехватЗвонкаОтветственным Тогда
		Возврат;	
	КонецЕсли; 
	
	мНомераТелефоновПоОтветственному = мОбщийМодуль.ПолучитьСписокНомеровДляПереводаНаОтветственного();
КонецПроцедуры	//ЗаполнитьСписокТелефоновДляПереводаНаОтветственного()

// Обработка события - оповещения о возможности перезвата
// Параметры
//   XMLУзел - тип - ЧтениеXML
// Возвращаемое значение
//   нет
Процедура ОбработатьПерехватНаОтветственного(XMLУзел)
	// Interception
	// При входящем звонке на АТС должно генерироваться пользовательское сообщение
	// UserEvent(Interception,CALLERID: ${CALLERID(num)},CHANNEL: ${CHANNEL},UNIQUEID: ${UNIQUEID},CONTEXT: ${CONTEXT}) //.
	channel = XMLУзел.ЗначениеАтрибута("channel");
	КаналВызывающегоАбонента = ?(ЗначениеЗаполнено(channel),channel,XMLУзел.ЗначениеАтрибута("chan1c"));
	Если НЕ ЗначениеЗаполнено(КаналВызывающегоАбонента) Тогда
		Возврат;
	КонецЕсли; 
	calleridnum				 = XMLУзел.ЗначениеАтрибута("callerid");
	context					 = XMLУзел.ЗначениеАтрибута("context");
	
	врНомерДляПоискаВТаблицеМаршрутизации = мОбработкаДанных.ПреобразоватьНомерДляСохранения(calleridnum, ГлобальныеПеременные.глКоличествоХранимыхЦифрТелефона);
	врНомерДляПоискаВТаблицеМаршрутизации = ?(врНомерДляПоискаВТаблицеМаршрутизации = 0,calleridnum,врНомерДляПоискаВТаблицеМаршрутизации);
	// Сопоставлять будем по последним 9ти символам.
	НомерДляПоискаВТаблицеМаршрутизации   = врНомерДляПоискаВТаблицеМаршрутизации;
	СтрокаСотрудника=Сотрудники.Найти(мПользователь,"Сотрудник");
	
	Если СтрокаСотрудника = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаСотрудника.ВнутреннийНомер) Тогда
		Возврат;
	КонецЕсли;
	
	НомерПерехвата = ?(Звонки.Количество() = 0, СтрокаСотрудника.ВнутреннийНомер, RedirectNumber);
	Если ПерехватЗвонкаОтветственным 
		  И Найти(КаналВызывающегоАбонента,НашКаналФильтр)= 0									    	// 	
		  И ЗначениеЗаполнено(calleridnum)                            									// у звонка есть CallerID
		  И мНомераТелефоновПоОтветственному.Найти(НомерДляПоискаВТаблицеМаршрутизации)<>Неопределено  	// есть запись в личной таблице машрутизации
		  И Найти(context,КонтекстНабораПоУмолчанию)= 0													// звонок из внешнего транка	
		  И НЕ ЗначениеЗаполнено(ПолучитьПеременнуюКанала(КаналВызывающегоАбонента,"interception")) 	// пустое значение переменной перехвата
		 Тогда 
		 
		БезКонсультативныйПеревод_10000104(КаналВызывающегоАбонента, "10000104", КонтекстНабораСлужебныхКоманд);
		СообщитьОтладочнуюИнформацию("Перехват звонка из на ответственного менеджера ",calleridnum);
	КонецЕсли;	

КонецПроцедуры
 
// У текущего пользователя может быть несколько отслеживаемых номеров
//эти номера заносятся в массив и используются для отображения истории зыонков.
Процедура ЗаполнитьСписокНомеровТекущегоПользователя() Экспорт
	Запрос = мОбщийМодуль.ПолучитьЗапросЗаполнитьСписокНомеровТекущегоПользователя();
	
	Запрос.УстановитьПараметр("Объект",мПользователь);
	Запрос.УстановитьПараметр("ТипКИ", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	мСписокНомеровПользователяДляОбработки.Очистить();
	мСписокНомеровПользователяДляИстории.Очистить();
	
	Пока Выборка.Следующий() Цикл
		НомерТелефона = мОбработкаДанных.УбратьИзНомераТелефонаВсеБуквы(Выборка.НомерТелефона);
		Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
			Продолжить;	
		КонецЕсли; 
		
		Если Выборка.Основной Тогда
			мСписокНомеровПользователяДляОбработки.Добавить(НомерТелефона);	
		КонецЕсли; 
		мСписокНомеровПользователяДляИстории.Добавить(НомерТелефона);	
	КонецЦикла; 
	
КонецПроцедуры  //ЗаполнитьСписокНомеровТекущегоПользователя()

// По переданной строке подбирает список из 20 похожих абонентов 
//
Функция НайтиСписокПодходящихОбъектовВызова(НомерАбонента) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ ПЕРВЫЕ 20
	|	КонтактнаяИнформация.Объект
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект.Наименование ПОДОБНО &Наименование";
	
	Запрос.УстановитьПараметр("Наименование","%"+НомерАбонента+"%");
	
	Результат = Запрос.Выполнить();
	ТЗ   = Результат.Выгрузить();
	
	СписокОбъектов = Новый СписокЗначений;
	СписокОбъектов.ЗагрузитьЗначения(ТЗ.ВыгрузитьКолонку("Объект"));
	
	Возврат СписокОбъектов;
	
КонецФункции

// Сообщить отладочную информацию если включен режим отладки
//
// Параметры
//  Заголовок  - Строка - Заголовок информации для идентификации сообщения
//	Сообщение - Строка - Выводимое сообщение
//  ОписаниеОшибки  - Строка - Результат работы функции ИнформацияОбОшибке()
//
Процедура СообщитьОтладочнуюИнформацию(Заголовок,Сообщение,ОписаниеОшибки="")Экспорт
	
	Если Отладка Тогда
		Сообщить(Заголовок+" "+СокрЛП(Сообщение)+?(ЗначениеЗаполнено(ОписаниеОшибки)," ошибка: "+ОписаниеОшибки,""));		
	КонецЕсли; 
	
КонецПроцедуры // СообщитьОтладочнуюИнформацию()

// Если передан идентификатор звонка, то производится попытка поиска документа Событие с сохраненным идентификатором.
// Если событие не найдено, то по переданной структуре звонка (соответсвует табличной части история звонков) создается документ Событие.
// В любом случае, созданный или найденный документ открывается для заполнения пользователем.
//
// Параметры: 
//			 ИдентификаторЗвонка	-	Тип Строка 	- Строка с уникальным идентификатором звонка присваеваемым сервером телефонии при каждом новом 
// входящем или исходящем звонке
//           СтруктураЗвонка	-	Тип Структура 	- Соответствует одной строке из табличной части ИсторияЗвонков
//
// 
// Возвращаемое значение - НЕТ
//
Процедура ОткрытьСоздатьСобытие(ИдентификаторЗвонка,СтруктураЗвонка=Неопределено) Экспорт
	СсылкаНаДок = Неопределено;
	
	Если НЕ ИспользоватьAsterisk Тогда
		Если мОбщийМодуль.ЕстьДокументСобытие() И НЕ ИдентификаторЗвонка = Неопределено Тогда
			СсылкаНаДок = ИдентификаторЗвонка;
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	Событие.Ссылка
				|ИЗ
				|	Документ.Событие КАК Событие
				|ГДЕ
				|	Событие.Ссылка = &Ссылка";
			Запрос.УстановитьПараметр("Ссылка", СсылкаНаДок);
			РезультатЗапроса = Запрос.Выполнить();
			Если РезультатЗапроса.Пустой() Тогда
			    СсылкаНаДок = Неопределено
			КонецЕсли; 
		КонецЕсли; 
	Иначе
		Запрос = мОбщийМодуль.ПолучитьЗапросСобытиеПоGUIDЗвонка();
		Если ЗначениеЗаполнено(Запрос.Текст) Тогда
			Запрос.УстановитьПараметр("CRM_GUIDЗвонка",ИдентификаторЗвонка);
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			Если Выборка.Следующий() Тогда
			 	СсылкаНаДок = Выборка.Ссылка;
			КонецЕсли; 
		КонецЕсли; 	
	КонецЕсли; 
	
	Если НЕ СсылкаНаДок = Неопределено Тогда
		ФормаДок=СсылкаНаДок.ПолучитьФорму();	  	  
		ФормаДок.Открыть();
	ИначеЕсли СтруктураЗвонка<>Неопределено тогда
		
		Попытка
			СтруктураТелефона = ПреобразоватьНомерСУчетомПрефиксов(СтруктураЗвонка.НомерТелефона, Истина);
			ДанныеЗаполнения  = мОбщийМодуль.ПолучитьДанныеЗаполненияСобытия(СтруктураЗвонка, ГлобальныеПеременные, СтруктураТелефона);
			
			// строго указываю 1 как входящий звонок, иначе номер не преобразуется в структуру
			СтруктураПараметров	=	ПреобразоватьНомерСУчетомПрефиксов(СтруктураЗвонка.НомерТелефона, 1);
			СтрокаПараметров	=	ПреобразоватьПараметрыВСтроку(СтруктураПараметров);
			
			ФормаСобытия = мОбщийМодуль.ПолучитьФормуСобытия(ФормаТелефон, СтрокаПараметров);
			Если мОбщийМодуль.ЕстьДокументСобытие() И ТипЗнч(ИдентификаторЗвонка) = Тип("ДокументСсылка.Событие") Тогда
				ФормаСобытия.ЭтотОбъект.УстановитьСсылкуНового(ИдентификаторЗвонка);
			КонецЕсли; 
			
			ФормаСобытия.Открыть();
			// Документ "Событие" / Начало
			Если ТипЗнч(СтруктураЗвонка) = Тип("Структура")
				И СтруктураЗвонка.Свойство("onBridge") Тогда
				СтруктураЗвонка.Канал1 = мОбработкаДанных.ОтсечьПлечоВLocal(СтруктураЗвонка.Канал1);
				СтруктураЗвонка.Канал2 = мОбработкаДанных.ОтсечьПлечоВLocal(СтруктураЗвонка.Канал2);
				КлючиУникальностиСобытий.Вставить(СтрокаПараметров, СтруктураЗвонка);
			КонецЕсли; 
			// Документ "Событие" / Конец
			ЗаполнитьЗначенияСвойств(ФормаСобытия, ДанныеЗаполнения);
			//
			ФормаСобытия.КлючУникальности = СтрокаПараметров;
			
			мОбщийМодуль.ОбновитьОтображениеФормыСобытия(ФормаСобытия);
			
		Исключение
			СообщитьОтладочнуюИнформацию("Исключение","Не удалось создать документ Событие: "+ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры //ОткрытьСоздатьСобытие()

// По переданной строке табличной части ФаксимильныеСообщения открывает на просмотр файл факсимильного сообщения
//
Процедура ПросмотретьТекущийФаксФайл(ТекущаяСтрока) Экспорт
	Если ТекущаяСтрока=Неопределено Тогда
		Возврат;
	КонецЕсли;
	СообщитьОтладочнуюИнформацию("Просматриваем файл ",ТекущаяСтрока.ФайлФакса);
	
	ЗапроситьФайлФаксаНаСкачивание(ТекущаяСтрока.ИдентификаторЗвонка);
	// результат придет в USEREVENT и если файл есть, он откроется.		
	
КонецПроцедуры //ПросмотретьТекущийФаксФайл()

// По переданной строке табличной части История звонков открывает на файл записи разговора
//
Процедура СкачатьЗаписьРазговора(ТекущаяСтрока) Экспорт
	
	Если ТекущаяСтрока=Неопределено Тогда
		Возврат;
	КонецЕсли;
	СообщитьОтладочнуюИнформацию("Просматриваем файл записи для разговора с идентификатором",ТекущаяСтрока.ИдентификаторЗвонка);
	Если НазваниеPBX = "MYPBX"
		 И ЗначениеЗаполнено(ТекущаяСтрока.ИмяФайла) Тогда
		 
		врСтроки = ЗаписиРазговоров.НайтиСтроки(Новый Структура("uniqueid", ТекущаяСтрока.ИдентификаторЗвонка));
		Если врСтроки.Количество()>1 Тогда
			ИменаФайлов = Новый Массив;
			Для каждого текСтрока Из врСтроки Цикл
				ИменаФайлов.Добавить(текСтрока.recordingfile)
			КонецЦикла; 
			
			ФормаВыбораФайлаЗаписи = ЭтотОбъект.ПолучитьФорму("ФормаВыбораФайлаЗаписи");
			ФормаВыбораФайлаЗаписи.Инициализировать(ИменаФайлов, Неопределено, "");
			Возврат;
		КонецЕсли; 
 
		ПолучитьФорму("custom_MyPBX").ПолучитьФайлЗаписи(ТекущаяСтрока.ИмяФайла);
	Иначе	
		ЗапроситьФайлЗаписиНаСкачивание(ТекущаяСтрока.ИдентификаторЗвонка);
	КонецЕсли;
	// результат придет в USEREVENT и если файл есть, он откроется.		
	
КонецПроцедуры	//СкачатьЗаписьРазговора()

// Производит заполнение всех номеров пользователей, табличной части сотрудников
// получает настройки Asterisk и устанавливает значения статусов сотрудников
Процедура ИнициализацияПанели() Экспорт
	
	Если  НЕ Компонент = Неопределено
		И НЕ Компонент.Enabled Тогда // не смогли залогиниться
		ОтключитьВК();	
	Иначе
		ПолучитьСведенияОЛицензировании();
		
		Состояние("Соединение с сервером телефнии " + Хост + ". Установлено!");
		НашКаналФильтр = "";
		
		// Узнаем с каким сервером Asterisk мы имеем дело 
		// установим контексты по умолчанию.
		УстановитьКонтекстыПоУмолчанию();
		
		// Для асинхронного получения хинтов с АТС
		ПолучитьНастройкиССервераAsterisk();
		ЗаполнитьСписокНомеровТекущегоПользователя();
		// Инициализируем список телефонов клиентов для перевода на текущего ответственного
		ЗаполнитьСписокТелефоновДляПереводаНаОтветственного();
	КонецЕсли; 
	Оповестить("ОбновитьОтображениеСтатусов");
	
КонецПроцедуры

// установка значений контекстов "по умолчанию"
// зависит от имени АТС
Процедура УстановитьКонтекстыПоУмолчанию() Экспорт
	
	НазваниеPBX =  ВРЕГ(ПолучитьПеременнуюКанала("","SYSTEMNAME"));
	Если Найти(НазваниеPBX,"ASKOZIA")>0 Тогда
		КонтекстНабораСлужебныхКоманд = "internal";
		КонтекстНабораПоУмолчанию	  = "internal";
		КонтекстДляКонсультативногоПеревода = КонтекстДляКонсультативногоПеревода;
	ИначеЕсли ВРЕГ(ПолучитьПеременнуюКанала("","MIKO_MyPBX")) = "MYPBX" Тогда
		НазваниеPBX = "MYPBX";
		КонтекстНабораСлужебныхКоманд = "miko_ajam";
		КонтекстНабораПоУмолчанию	  = "Local_Default_CallingRules";
		КонтекстДляКонсультативногоПеревода = "";
	Иначе
		КонтекстНабораСлужебныхКоманд = "miko_ajam";
		КонтекстНабораПоУмолчанию	  = "from-internal";
		КонтекстДляКонсультативногоПеревода = "from-internal-xfer";
	КонецЕсли; 
		
	врем_КонтекстДляКонсультативногоПеревода = ПолучитьПеременнуюКанала("", "TRANSFER_CONTEXT");
	Если ЗначениеЗаполнено(врем_КонтекстДляКонсультативногоПеревода) 
		 И НЕ врем_КонтекстДляКонсультативногоПеревода = "(null)" Тогда
		КонтекстДляКонсультативногоПеревода = врем_КонтекстДляКонсультативногоПеревода;
	КонецЕсли; 
	
КонецПроцедуры
 
