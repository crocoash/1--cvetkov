// Заполняет историю звонков во внешней панеле - дублере.
// 
Процедура Банер_ЗаполнитьИсториюЗвонков() Экспорт
	Если мВнешняяПанель = Неопределено Тогда
		Возврат;	
	КонецЕсли;	
	
	Если ИсторияЗвонков.Количество()=0 Тогда
		мВнешняяПанель.ВП_ОчиститьИсториюЗвонков();
		Возврат;
	КонецЕсли; 

	врИстория = Новый Массив;
	Для каждого ТекСтрокаИстории Из ИсторияЗвонков Цикл
	    врЗапись = Новый Структура;
		врЗапись.Вставить("НомерТелефона", 	ТекСтрокаИстории.НомерТелефона);
		врЗапись.Вставить("Id", 		    СокрЛП(ТекСтрокаИстории.ИдентификаторЗвонка));
		
		пДанныеЗаписи = ЗаписиРазговоров.Найти(СокрЛП(ТекСтрокаИстории.ИдентификаторЗвонка), "recordingfile");
		Если НЕ пДанныеЗаписи = Неопределено Тогда
			врЗапись.Вставить("Id", 		пДанныеЗаписи.uniqueid);
		КонецЕсли; 
		
		врЗапись.Вставить("Начало", 		ТекСтрокаИстории.Когда);
		врЗапись.Вставить("Входящий", 		ТекСтрокаИстории.ВходящийЗвонок);
		врЗапись.Вставить("Организация", 	ТекСтрокаИстории.Контрагент);
		врЗапись.Вставить("Абонент", 		ТекСтрокаИстории.КонтактноеЛицо);
		врЗапись.Вставить("ЕстьЗапись", 	ЗначениеЗаполнено(ТекСтрокаИстории.ИмяФайла));
		врЗапись.Вставить("Пропущен", 		ТекСтрокаИстории.ПропущенныйЗвонок И ТекСтрокаИстории.ВходящийЗвонок);
		врЗапись.Вставить("ПродолжительностьРазговора", ТекСтрокаИстории.СекундДлился);
		
		врИстория.Добавить(врЗапись);
	КонецЦикла; 
	
	мВнешняяПанель.ВП_ЗаполнитьТаблицуЗвонковНаСегодня(врИстория);
КонецПроцедуры
 

// Обрабатываем нажатие на кнопки банера
// 
Процедура onОбработкаКомандБанера(Источник, Событие, Данные)
	Перем ДанныеСобытия, Действие;
	// Выполним разбор данных
	// Пример данных: "new Structure("action","reloadcallhistory")";
	Если мВнешняяПанель = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	мВнешняяПанель.ДобавитьТекстОтладки("// " + Событие + ": " + Данные);
	Если "HASP_ERROR" = Событие Тогда
		Возврат;	
	КонецЕсли; 
	Попытка
	ДанныеСобытия = Вычислить(Данные);
	Исключение
	КонецПопытки; 
	
	Если Событие = "LoadFinished" Тогда
		мВнешняяПанель.hВыполнитьОчередьСкриптов();
	  	Возврат;
	ИначеЕсли НЕ ТипЗнч(ДанныеСобытия) = Тип("Структура") Тогда		
	  	Возврат;
	КонецЕсли;
	
	ДанныеСобытия.Свойство("action", Действие);
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		Возврат;	
	КонецЕсли;
	
	// Найдем данные звонка с указанным id
	Если ДанныеСобытия.Свойство("id") Тогда
		UID = СтрЗаменить(ДанныеСобытия.id, "_", "/");						
		UID = СтрЗаменить(UID, "$", "_");						
		
		Отбор = Новый Структура("НомерЛинии", UID);
		РезультатОтбора = Звонки.Найти(UID, "Канал1,Канал2,Канал");
		Если РезультатОтбора<>Неопределено Тогда
			ТекущийВызов = РезультатОтбора;
		ИначеЕсли НЕ (ИспользоватьAsterisk И Действие = "unhold") Тогда
			// Нет такого звонка, обрабатывать дальше нечего
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// Действие "позвонить на номер"
	Если Действие = "dial" Тогда
		Если Звонки.Количество()=0 Тогда
			НабратьНомер(ДанныеСобытия.Number);
		Иначе	
			врСотрудник = Сотрудники.Найти(ДанныеСобытия.Number, "ВнутреннийНомер"); 
			Если врСотрудник <> Неопределено И врСотрудник.Состояние=СостояниеЭкстеншена.Свободен Тогда
				ПереводЗвонка(Звонки[Звонки.Количество() - 1],врСотрудник.ВнутреннийНомер);
			КонецЕсли; 
		КонецЕсли; 
	ИначеЕсли Действие = "openpanelsettings" Тогда
		ФормаНастройки=мОбщийМодуль.ПолучитьФормуНастройки();
		Если ФормаНастройки.Открыта() Тогда
			ФормаНастройки.Активизировать();
		Иначе
			ФормаНастройки.Открыть();
		КонецЕсли; 
	// Действие "овтетить на звонок"
	ИначеЕсли Действие = "answer" Тогда
		Если ИмяТекущейКонфигурации = "ТрактиръFrontOffice" И ОтветитьНаЗвонок(ТекущийВызов) Тогда
			мОбщийМодуль.ОтветилиНаЗвонок(ТекущийВызов);
		Иначе	
			ОтветитьНаЗвонок(ТекущийВызов);
		КонецЕсли; 
	// Действие "завершить звонок"
	ИначеЕсли Действие = "hangup" Тогда
		ОтбойЗвонка(ТекущийВызов);
	// Действие "Удержать вызов"	
	ИначеЕсли Действие = "hold" Тогда
		ПоставитьНаУдежание(ТекущийВызов);
	// Действие "Вернуть с удержания вызов с id="	
	ИначеЕсли Действие = "unhold" Тогда
		врЗапаркованныйВызов = Парковка.Найти(ДанныеСобытия.id, "Слот");
		Если ИспользоватьAsterisk И НЕ врЗапаркованныйВызов = Неопределено Тогда			
			НабратьНомер(ДанныеСобытия.id,, врЗапаркованныйВызов.calleridnum);
		ИначеЕсли ИспользоватьСофтфон И НЕ ТекущийВызов = Неопределено Тогда	
			ПоставитьНаУдежание(ТекущийВызов);
		КонецЕсли; 
	// Смена режима SPY.	
	ИначеЕсли Действие = "changechanspymode" Тогда
		number = ТекущийВызов.CallerID;     
		Канал  = ТекущийВызов.ChanSpyКанал;
		ОтбойЗвонка(ТекущийВызов);
		Если ДанныеСобытия.mode = "conference" Тогда
			ВмешатьсяВРазговор(Канал, number);
		ИначеЕсли ДанныеСобытия.mode = "whisper" Тогда 	
			ШепнутьКоллеге(Канал 	, number);
		ИначеЕсли ДанныеСобытия.mode = "listen" Тогда 	
			ПодслушатьРазговор(Канал, number);
		КонецЕсли; 
	ИначеЕсли Действие = "transfercall" Тогда
		ПереводЗвонка(ТекущийВызов, ДанныеСобытия.Number);
	// Действие "Отправить DTMF команду в переменной symbol, которая урлэнкодится, проблема с символом #"	
	ИначеЕсли Действие = "senddtmf" И Звонки.Количество()>0 Тогда					
		врТекущийВызов = Звонки[0];
		symbol = ?(ДанныеСобытия.symbol = "%23","#",ДанныеСобытия.symbol);
		ДонаборНомера(врТекущийВызов, symbol, Истина);
	// Действие "подслушать разговор"
	ИначеЕсли Супервизор И Действие = "listencall" Тогда
		Хинт = Сотрудники.найти(ДанныеСобытия.number, "ВнутреннийНомер");
		Если Хинт = Неопределено Тогда Возврат; КонецЕсли; 
		ПодслушатьРазговор(Хинт.КаналСотрудника, ДанныеСобытия.number);
	// Действие "вмешаться в разговор"
	ИначеЕсли Супервизор И Действие = "join2call" Тогда
		Хинт = Сотрудники.найти(ДанныеСобытия.number, "ВнутреннийНомер");
		Если Хинт = Неопределено Тогда Возврат; КонецЕсли; 
		ВмешатьсяВРазговор(Хинт.КаналСотрудника, ДанныеСобытия.number);
	// Действие "шепнуть коллеге"
	ИначеЕсли Супервизор И Действие = "wisper2call" Тогда
		Хинт = Сотрудники.найти(ДанныеСобытия.number, "ВнутреннийНомер");
		Если Хинт = Неопределено Тогда Возврат; КонецЕсли; 
		ШепнутьКоллеге(Хинт.КаналСотрудника, ДанныеСобытия.number);
	ИначеЕсли Действие = "reloadcallhistory" Тогда	
		ЗаполнитьТаблицуИсторииЗвонков(ТекущаяДата());
	ИначеЕсли Действие = "getcallrecordsfiles" Тогда
		historyid = СокрЛП(ДанныеСобытия.historyid);
		ЗаписиДляВнешнейПанели.Добавить(historyid);
		Если НазваниеPBX = "MYPBX" Тогда
			пДанныеЗаписи = ЗаписиРазговоров.Найти(historyid, "uniqueid");
			Если НЕ пДанныеЗаписи = Неопределено Тогда
				historyid = пДанныеЗаписи.recordingfile; 
			КонецЕсли; 
			ИменаФайлов = ПолучитьИменаФайловИзстроки(historyid);		
		  	ПолучитьФорму("custom_MyPBX").ПолучитьФайлЗаписи(ИменаФайлов, ДанныеСобытия.historyid);
		Иначе	
			ЗапроситьИмяФайлаЗаписиCDRПоИдентификатору(historyid);
		КонецЕсли;
	// Действие "Скачать запись разговоров для записи истории с id="
	ИначеЕсли Действие = "downloadcallrecord" Тогда
		мВнешняяПанель.ВП_ОткрытьЗагруженныйФайл(ДанныеСобытия.historyid);
	// Действие "Прослушать запись разговоров обратным вызовом для записи истории с id="
	ИначеЕсли Действие = "callbackcallrecord" Тогда
		мВнешняяПанель.ВП_ПрослушатьЗаписьОбратнымЗвонком(ДанныеСобытия.historyid);
	ИначеЕсли Действие = "searchclientsbystring"
			  И СтрДлина(ДанныеСобытия.value)>3 Тогда
		// WebKitEvent:new Structure("action, value","searchclientsbystring", "МИКО")
		РезультатПоиска = НайтиАбонентаПоИмени(""+ДанныеСобытия.value);
		мВнешняяПанель.ВП_ОтобразитьНайденныеКонтакты(РезультатПоиска);
	// Действие "Сохранить положение кнопки вызова панели телефонии, передаются параметры top и left"	
	ИначеЕсли Действие = "storemenubuttonposition" Тогда 
		врНастройки = Новый Структура("ПикселейСлева,ПикселейСверху", ДанныеСобытия.left, ДанныеСобытия.top);
		мВнешняяПанель.ВП_СохранитьНастройки(врНастройки);
	ИначеЕсли Действие = "storelasthistorybrowse" Тогда 
		врНастройки = Новый Структура("lasthistoryviewed", ТекущаяДата());
		мВнешняяПанель.ВП_СохранитьНастройки(врНастройки);
	ИначеЕсли Действие = "storepanelwindowstate" Тогда 
		врНастройки = Новый Структура("visible,width,pinned", ДанныеСобытия.visible, ДанныеСобытия.width, ДанныеСобытия.pinned);
		мВнешняяПанель.ВП_СохранитьНастройки(врНастройки);
	КонецЕсли;	
КонецПроцедуры

Процедура РазобратьСобытиеHWindow(Данные, Результат_Данные)
	
	Результат_Данные = Новый Структура;
	
	МассивПараметровСобытия = мОбработкаДанных.мРазложитьСтрокуВМассивПодстрок(Данные, "&");
	Для Каждого ПараметрЗначение Из МассивПараметровСобытия Цикл
		ПозицияРазделителя = Найти(ПараметрЗначение, "=");
		Если ПозицияРазделителя > 0 Тогда
			Параметр = Лев(ПараметрЗначение, ПозицияРазделителя - 1);
			Значение = Сред(ПараметрЗначение, ПозицияРазделителя + 1);
		
			Результат_Данные.Вставить(Параметр, Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Установка вызова на удержание или его парковка
// Параметры
//   СтрочкаЗвонка - активный вызов, строка таблицы "Звонки"
// 
Процедура ПоставитьНаУдежание(СтрочкаЗвонка) Экспорт

	Если НЕ ИспользоватьAsterisk
		 И ДопМодули.Свойство("НаборНомера")
		 И НЕ (ДопМодули.НаборНомера = Неопределено) Тогда
		ДопМодули.НаборНомера.ВыполнитьДействиеНадЗвонком(СтрочкаЗвонка, "Удержание");
		Возврат;	
	КонецЕсли;
	
	// перед парковой требется ответить на звонок
	Если СтрочкаЗвонка.СейчасРазговаривают = Истина Тогда
		ЗапарковатьНаСвободныйСлот(СтрочкаЗвонка);
	ИначеЕсли ОтветитьНаЗвонок(СтрочкаЗвонка) Тогда
		// при ответе на звонок средствами пикапа изменяется имя нашего канал
		// необходимо дождаться бридж (соединения двух абонентов) и запарковать вызов
		Канал = ?(СтрочкаЗвонка.ВходящийЗвонок = Истина, СтрочкаЗвонка.Канал1, СтрочкаЗвонка.Канал2);
		КаналыКПарковке.Вставить(Канал,СтрочкаЗвонка.CallerID);
	Иначе	
	   	// нет возможности запарковать вызов
		Сообщить("Нет возможности запарковать этот вызов!");
	КонецЕсли; 	

КонецПроцедуры 

// Ищем нащ канал вызова в связях каналов.
// 
Функция ПолучитьНашКанал(СтрочкаЗвонка)
	КаналСвязи = "";
	Если НЕ ИспользоватьAsterisk И ИспользоватьСофтфон И НЕ СтрочкаЗвонка = Неопределено  Тогда
		Возврат СтрочкаЗвонка.Канал;
	ИначеЕсли Не ЗначениеЗаполнено(НашКаналФильтр) ИЛИ СтрочкаЗвонка = Неопределено Тогда
	 	Возврат КаналСвязи;
	КонецЕсли; 
	
	Если Найти(СтрочкаЗвонка.Канал1, НашКаналФильтр)>0 Тогда
		Возврат СтрочкаЗвонка.Канал1;
	ИначеЕсли Найти(СтрочкаЗвонка.Канал2, НашКаналФильтр)>0 Тогда	
		Возврат СтрочкаЗвонка.Канал2;
	КонецЕсли; 
	
	Связь = мОбработкаДанных.НайтиСвязьКанала(СтрочкаЗвонка.Канал1);
	Если НЕ Связь = Неопределено
		 И Связь.Свойство("КаналСвязи", КаналСвязи) 
		 И Найти(КаналСвязи, НашКаналФильтр)>0 Тогда
		 
		Возврат КаналСвязи;	
	КонецЕсли;
	Связь = мОбработкаДанных.НайтиСвязьКанала(СтрочкаЗвонка.Канал2);
	Если НЕ Связь = Неопределено
		 И Связь.Свойство("КаналСвязи", КаналСвязи) 
		 И Найти(КаналСвязи, НашКаналФильтр)>0 Тогда
		 
		Возврат КаналСвязи;	
	КонецЕсли;
	
	Возврат КаналСвязи;
КонецФункции // ПолучитьНашКанал()
 

