			СтрокаПропущенного.ИдентификаторЗвонка  = мОбработкаДанных.УбратьРасширениеВФайлеЗаписи(СокрЛП(CDR.uniqueid));
			СтрокаПропущенного.Количество			= 1;
			ОпределитьКонтрагентаКонтактногоЛицаПоНомеру(СтрокаПропущенного);
		ИначеЕсли Найти(МассивПропущенного[0].Когда, ДатаЗвонка) = 0 Тогда
			СтрокаПропущенного = МассивПропущенного[0];
			
			uniqueid = мОбработкаДанных.УбратьРасширениеВФайлеЗаписи(CDR.uniqueid);
			ОтборUniqueid = Новый Структура("ИдентификаторЗвонка",uniqueid);
			Если ПропущенныеЗвонки.НайтиСтроки(ОтборUniqueid).Количество() = 0 Тогда
				СтрокаПропущенного.Когда 				= СтрокаПропущенного.Когда + ", " + ДатаЗвонка;
				СтрокаПропущенного.Количество			= СтрокаПропущенного.Количество + 1;
				СтрокаПропущенного.ИдентификаторЗвонка  = uniqueid;
			КонецЕсли;
			ОпределитьКонтрагентаКонтактногоЛицаПоНомеру(СтрокаПропущенного);
