	Если ВхПропущенный Тогда
		
		CallerID = СокрЛП(CDR.src);
		МассивПропущенного = ПропущенныеЗвонки.НайтиСтроки(Новый Структура("НомерТелефона",CallerID));
		
		ДатаЗвонка = Формат(ТекущаяДата(), "ДФ=HH:mm");
