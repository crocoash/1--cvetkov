// Получить информацию о ключах HASP доступных текущей панели
//
Процедура ПолучитьСведенияОЛицензировании() 
	Если Компонент <> Неопределено Тогда
		врКомпонент = Компонент;
	ИначеЕсли ДопМодули.Свойство("НаборНомера")
		 И НЕ (ДопМодули.НаборНомера = Неопределено) Тогда
		 врКомпонент = ДопМодули.НаборНомера.ПолучитьКомпонентSIP();	
	КонецЕсли; 
	
	Если НЕ врКомпонент = Неопределено Тогда 			
		ИнформацияПоЛицензиям = мОбработкаДанных.ПолучитьТаблицуКлючейЗащиты(врКомпонент);
	КонецЕсли; 
	
	ОбновитьТекстЛицензии();
КонецПроцедуры

// Формирует текст свведений по ключам защиты.
// 
Процедура ОбновитьТекстЛицензии(Знач MIKO_Error = Неопределено) Экспорт
	Если ТипЗнч(ИнформацияПоЛицензиям) <> Тип("Структура")
		 ИЛИ НЕ ИнформацияПоЛицензиям.Свойство("РегистрационныйНомер") Тогда
	  	Возврат;
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(MIKO_Error) Тогда
		нТекстЛицензии = MIKO_Error;
	Иначе	
		// Отобразим информацию по остатку дней лицензии.
		Если ЗначениеЗаполнено(ИнформацияПоЛицензиям.РегистрационныйНомер) Тогда
			Если ИнформацияПоЛицензиям.ОстатокДнейЛицензии = 0 Тогда
				нТекстЛицензии 	= 	""; // безсрочная.
			ИначеЕсли ИнформацияПоЛицензиям.ОстатокДнейЛицензии < 0 Тогда
				нТекстЛицензии 	= 	"Срок действия лицензии истек.";
			Иначе	
				ДатаОкончания = ТекущаяДата() + 60*60*24*ИнформацияПоЛицензиям.ОстатокДнейЛицензии;
			    нТекстЛицензии 	= 	"Лицензия действует до "+ Формат(ДатаОкончания,"ДЛФ=DD") + ".";
			КонецЕсли; 
		Иначе
			нТекстЛицензии 	= 	"Не найден ключ защиты.";
		КонецЕсли;
	КонецЕсли; 
	
	ИнформацияПоЛицензиям.Вставить("нТекстЛицензии", нТекстЛицензии);
	Оповестить("MIKO_ТекстЛицензииAsterisk", ИнформацияПоЛицензиям, ЭтотОбъект);
КонецПроцедуры

// Обновление информации по лицензиям.
