// Получение пробного ключа / установка значения ключа
// 
Процедура GetSetTrialLicense(Параметр) Экспорт
	Если ТипЗнч(Параметр) = Тип("Строка") Тогда
		Если Компонент = Неопределено И НЕ ИспользоватьСофтфон Тогда
			ПодключитьВнешнююКомпонентуAsterisk();
		КонецЕсли; 
		
		Если Компонент <> Неопределено Тогда
			Попытка
				Компонент.MikoLicense	= Параметр;
			Исключение
			КонецПопытки; 
		КонецЕсли;
		// + SIP
		МодульНаборНомера = Неопределено;
		Если ДопМодули.Свойство("НаборНомера", МодульНаборНомера) 
			 И НЕ МодульНаборНомера = Неопределено Тогда
			МодульНаборНомера.GetSetTrialLicense_SIP(Параметр);
		КонецЕсли; 
		// - SIP
	Иначе	
		GetTrialLicense(Параметр);		
	КонецЕсли; 
КонецПроцедуры
 
// Получение временной лицензии на 30 деней. 
//
Функция GetTrialLicense(Данные)
	Если Компонент <> Неопределено Тогда
		врКомпонент = Компонент;
	ИначеЕсли Неопределено <> ХЭШ_Компонент Тогда
		врКомпонент = ХЭШ_Компонент;
	ИначеЕсли ДопМодули.Свойство("НаборНомера")
		 И НЕ (ДопМодули.НаборНомера = Неопределено) Тогда
		 врКомпонент = ДопМодули.НаборНомера.ПолучитьКомпонентSIP();	
	Иначе
		Возврат Ложь;
	КонецЕсли; 
	
	Если врКомпонент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли; 
	// <reginfo>
	//|<param name = "Companyname" value = "МИКО ООО" / >
	//|<param name = "Contact" value = "Бекетов Николай" / >
	//|<param name = "Email" value = "nbek@mko.ru" / >
	//|<param name = "Telefone" value = "+79265244742" / >
	//|<param name = "INN" value = "773512312" / >
	//|<param name = "TypeOPF" value = "org" / >
	//|<param name = "Description" value = "Активация из 1С" / >
	//< / reginfo>
	врПараметры = Новый Структура("sLicenseKey,sContact,sCompanyname,sEmail,sTel,sDescription,ЮрЛицо,INN");
	ЗаполнитьЗначенияСвойств(врПараметры, Данные);

	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("Contact", 	врПараметры.sContact);
	СтруктураПараметров.Вставить("Companyname", врПараметры.sCompanyname);
	СтруктураПараметров.Вставить("Email", 		врПараметры.sEmail);
	СтруктураПараметров.Вставить("Telefone", 	врПараметры.sTel);
	СтруктураПараметров.Вставить("Description", врПараметры.sDescription);
	СтруктураПараметров.Вставить("TypeOPF", 	?(врПараметры.ЮрЛицо = Истина, "org", "ind"));
	СтруктураПараметров.Вставить("INN", 		врПараметры.INN);  		
	  	
	Данные = "<reginfo>";
	Для каждого ТекПараметр Из СтруктураПараметров Цикл
		Если ЗначениеЗаполнено(ТекПараметр.Значение) Тогда
			Данные = Данные+Символы.ПС+"<param name="""+ТекПараметр.Ключ+""" value="""+ЭкранироватьСпецСимволыXML(ТекПараметр.Значение)+"""/>";
		КонецЕсли; 
	КонецЦикла; 
	Данные = Данные+Символы.ПС+"</reginfo>";
	
	Данные 	  = URLEncode(Данные);
	ProductID = "3";
	Результат = "";
	Попытка
		Если ЭтоWindows() Тогда
			врКомпонент.GetTrialLicense(ProductID, Данные, Результат);
		Иначе	
			врКомпонент.GetTrialLicense(Данные, Результат);
		КонецЕсли; 
		ОтработанаУспешно = Истина;
	Исключение
		ОтработанаУспешно = Ложь;
	КонецПопытки; 
	
	Если ЗначениеЗаполнено(Результат) Тогда
		Оповестить("MIKOLIC_Trial", Результат, "");
		GetSetTrialLicense(""+Результат);
	Иначе
		Оповестить("MIKOLIC_Trial_Error", Результат, "");
	КонецЕсли; 
	Возврат ОтработанаУспешно;
КонецФункции // GetTrialLicense()
