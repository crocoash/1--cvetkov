// Очистка кэш
// 
Процедура ОчиститьКешПеременныхКанала(ИмяКанала = "")

	Если ЗначениеЗаполнено(ИмяКанала) Тогда
		УдалитьЗаписьПеременнойПоКлючу(ИмяКанала+"_MIXMONITOR_FILENAME");
		УдалитьЗаписьПеременнойПоКлючу(ИмяКанала+"_CDR(linkedid)");
		УдалитьЗаписьПеременнойПоКлючу(ИмяКанала+"_extenfrom1c");
		УдалитьЗаписьПеременнойПоКлючу(ИмяКанала+"_DIALEDPEERNUMBER");		
	Иначе
		ПеремКаналовСтруктура.Очистить();
	КонецЕсли; 

КонецПроцедуры // ОчиститьКешПеременныхКанала()

// Очистка кэш
//
Процедура УдалитьЗаписьПеременнойПоКлючу(КлючПерменной)

	ЗначениеПеремКанала = ПеремКаналовСтруктура.Получить(КлючПерменной);
	Если ЗначениеПеремКанала <> Неопределено Тогда
		ПеремКаналовСтруктура.Удалить(КлючПерменной);
	КонецЕсли; 

КонецПроцедуры // УдалитьЗаписьПеременнойПоКлючу()


