// Статусы // начало // Взаимодействие с AstDB

// Меняет статус пользователя и оповещает об этом других пользователей панели
//
Процедура УстановитьСтатус(Статус, НомерТелефона, ТекстСтатуса) Экспорт
	Если ИспользоватьAsterisk Тогда
	
		Если Компонент = Неопределено ИЛИ НЕ Компонент.Enabled ИЛИ НЕ ЗначениеЗаполнено(НашКаналФильтр) Тогда
			Возврат;	
		КонецЕсли;

		Channel		=	"Local/10000222@"+КонтекстНабораСлужебныхКоманд; //	Channel: Название канала, с которого совершается исходящий вызов (В том же формате, как если бы Вы совершали вызов этому абоненту командой Dial.)
		Variable	=	"dbFamily=UserBuddyStatus,command=put"
						+",key=" + URLEncode(НомерТелефона)
						+",val=" + URLEncode(Статус)
						+",chan="+URLEncode(НашКаналФильтр);
		
		Результат="";
		Попытка
			OriginateНаКаналСПередачейПараметров(Channel, Variable, Результат);			
			СообщитьОтладочнуюИнформацию("Инициирован статусов пользователей:",Результат);
		Исключение
			СообщитьОтладочнуюИнформацию("Ошибка при запросе статусов пользователей:",Результат);
			Возврат;
		КонецПопытки;
		// корректировка статуса DND
		УстановитьРежимНеБеспокоить(ТекстСтатуса, мОбработкаДанных.УбратьИзНомераТелефонаВсеБуквы(НомерТелефона));
	Иначе
		sip_status = ?(ТекстСтатуса = "DND", ""+ТекстСтатуса, ""+Статус);
		Оповестить("set_sip_status", sip_status);
	КонецЕсли; 
	
КонецПроцедуры // СменитьСтатус()

// Установка статуса для номер телефона 
// 
Процедура УстановитьРежимНеБеспокоить(Статус = "DND", НомерТелефона) Экспорт
	Если Компонент = Неопределено ИЛИ НЕ Компонент.Enabled ИЛИ НЕ ЗначениеЗаполнено(НашКаналФильтр) Тогда
		Возврат;	
	КонецЕсли;
	dbFamily = "DND";
	dbKey	 = НомерТелефона;
	dbValue	 = ?(Статус = "DND", "1", "");

	Channel		=	"Local/10000222@"+КонтекстНабораСлужебныхКоманд; //	Channel: Название канала, с которого совершается исходящий вызов (В том же формате, как если бы Вы совершали вызов этому абоненту командой Dial.)
	Variable	=	"dbFamily=DND,command=put"
					+",key=" + URLEncode(НомерТелефона)
					+",val=" + URLEncode(dbValue)
					+",chan="+URLEncode(НашКаналФильтр);
	
	Результат="";
	Попытка
		OriginateНаКаналСПередачейПараметров(Channel, Variable, Результат);			
		СообщитьОтладочнуюИнформацию("Инициирован статусов пользователей:",Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Ошибка при запросе статусов пользователей:",Результат);
	КонецПопытки;	
	
КонецПроцедуры

// Читает список пользовательских статусов из БД Asterisk
//
Процедура ПрочитатьСтатусыИзБД()
	// статусы:
	//  0 - Idle
	//  1 - In use
	//  2 - Busy
	//  4 - Unavailable
	//  8 - Ringing
	// 16 - On Hold
	// ============
	// 32 - Away
	// Звоним на номер 10000222, используя контекст для служебных команд. Звонок длится не более 10 секунд.
	// для канала 10000222 устанавливаем переменные необходимые для разбора файла истории звонков
	
	Если НЕ ЗначениеЗаполнено(НашКаналФильтр) Тогда
		Возврат;
	КонецЕсли;
	Channel		=	"Local/10000222@"+КонтекстНабораСлужебныхКоманд; //	Channel: Название канала, с которого совершается исходящий вызов (В том же формате, как если бы Вы совершали вызов этому абоненту командой Dial.)
	Variable	=	"dbFamily=UserBuddyStatus,command=show"
					+",key="
					+",val="
					+",chan="+URLEncode(НашКаналФильтр);
	
	Результат="";
	Попытка
		OriginateНаКаналСПередачейПараметров(Channel, Variable, Результат);			
		СообщитьОтладочнуюИнформацию("Инициирован статусов пользователей:",Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Ошибка при запросе статусов пользователей:",Результат);
	КонецПопытки;	
	
КонецПроцедуры // ПрочитатьСтатусыИзБД()

// формирование муршурта переадресации вызова
// 
Процедура НазначитьПереадресацию(ИсходныйНомер, НомерНазначения = "", ВключитьПереадресацию) Экспорт
	Если НЕ ЗначениеЗаполнено(ИсходныйНомер) Тогда
		Возврат;	
	КонецЕсли; 
	dbKey	 = "" + ИсходныйНомер;
	dbValue	 = ?(ВключитьПереадресацию = Истина, ""+НомерНазначения, "");
	Если НЕ ЗначениеЗаполнено(НашКаналФильтр) Тогда
		Возврат;
	КонецЕсли;
	Channel		=	"Local/10000222@"+КонтекстНабораСлужебныхКоманд; //	Channel: Название канала, с которого совершается исходящий вызов (В том же формате, как если бы Вы совершали вызов этому абоненту командой Dial.)
	Variable	=	"dbFamily=CF" 
					+",command=put"
					+",key="	+ URLEncode(dbKey)
					+",val=" 	+ URLEncode(dbValue)
					+",chan="	+ URLEncode(НашКаналФильтр);
	
	Результат="";
	Попытка
		OriginateНаКаналСПередачейПараметров(Channel, Variable, Результат);			
		СообщитьОтладочнуюИнформацию("Инициирован статусов пользователей:",Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Ошибка при запросе статусов пользователей:",Результат);
	КонецПопытки;	
	
	// статусы / начало
	Если ВключитьПереадресацию Тогда
		УстановитьСтатус("4", НашКаналФильтр, "Unavailable");
	Иначе	
		УстановитьСтатус("0", НашКаналФильтр, "Idle");
	КонецЕсли; 
	// статусы / конец
КонецПроцедуры

