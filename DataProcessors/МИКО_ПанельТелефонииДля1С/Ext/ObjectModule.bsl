// При использовании прокси сервера телефонии MIKO, можно установить активную фильтрацию на получаемые от Asterisk пакеты
// Фильтр белый, при установке фильтра нужно описать все необходимые нам события. При необходимости используем спецсимволы
// ! - отрицание
// * - любая строка вначале
// все условия перечисленные внутри тега <ajam-filter> имеют конкатенацию с признаком ИЛИ
// все условия перечисленные внутри тега <filter .../> имеют конкатенацию с признаком И
//
Процедура УстановитьАктивнуюФильтрациюСобытийНаПрокси()
	Если ИспользоватьПрокси=Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если Компонент = Неопределено Тогда
		Сообщить("Компонент не подключен");
		Возврат;
	КонецЕсли;                               
	Фильтр ="<ajam-filter>
			|	<filter event='MeetmeJoin' />
			|	<filter event='MeetmeLeave' />
			|	<filter event='MeetmeEnd' />
			|	<filter event='MeetmeMute' />
			|	<filter event='MeetmeTalking' />
			|	<filter event='Hangup' />
			|	<filter event='Bridge' />
			|	<filter event='BridgeEnter' />
			|	<filter event='BridgeLeave' />
			|	<filter event='ParkedCall' />
			|	<filter event='ChanSpyStart' />
			|	<filter event='ChanSpyStop' />
			|	<filter event='UnParkedCall' />
			|	<filter event='ParkedCallGiveUp' />
			|	<filter event='SendFAX' />
			|	<filter event='UserEvent'/>
			|	<filter event='Newchannel'/>
			|	<filter event='Cdr' />
			|	<filter event='OriginateResponse' />
			|	<filter event='ExtensionStatus'/>
			|	<filter event='Dial'/>
			|	<filter event='DialBegin'/>
			|	<filter event='DialEnd'/>
			|	<filter event='Newstate' />
			|	<filter event='Pickup'/>
			|</ajam-filter>";
	Результат = "";

	Попытка
		Command = "Action=ajam_filter&xml=" + URLEncode(Фильтр);
		Компонент.RawCommand(Command, Результат);
		СообщитьОтладочнуюИнформацию("Установлен фильтр ", Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Ошибка установки фильтра ", Результат);
	КонецПопытки; 
	
КонецПроцедуры

