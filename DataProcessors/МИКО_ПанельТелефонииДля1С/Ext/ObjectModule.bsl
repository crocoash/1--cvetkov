КонецФункции // ПолучитьНазначениеПереадресации()

// Смена статуса сотрудника.
//
Процедура ОбновитьСтатусСотрудника(КаналСотрудника, Статус)
	Попытка
		НовыйСтатус = Число(Статус);
	Исключение
		НовыйСтатус = 0;
	КонецПопытки; 
	
	Для каждого СтрокаСотрудника Из Сотрудники Цикл
		Если Найти(СтрокаСотрудника.КаналСотрудника, КаналСотрудника)<=0 Тогда
			Продолжить;
		КонецЕсли; 
		СтрокаСотрудника.Статус = НовыйСтатус;
	КонецЦикла;
	Оповестить("ОбновитьОтображениеСтатусов");
