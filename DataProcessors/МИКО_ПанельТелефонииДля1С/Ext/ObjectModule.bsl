		 И ПравоДоступа("Чтение", Метаданные.РегистрыСведений.МИКО_опИндексНомераТелефонов)
		 И ПравоДоступа("Чтение", Метаданные.РегистрыСведений.МИКО_опИндексНомераТелефоновБуквенные) Тогда
		ИспользоватьОптимизацию = Истина;
	Иначе
		ИспользоватьОптимизацию = Ложь;
	КонецЕсли; 
	
	КоличествоЦифрАК = 0;
	Если ИспользоватьОптимизацию Тогда
		Попытка
		врМИКО_опЗаписьКИ = Вычислить("МИКО_опЗаписьКИ");
		КоличествоЦифрАК  = врМИКО_опЗаписьКИ.ПолучитьКоличествоХранимыхЦифрТелефона();
		Исключение
		КонецПопытки; 
	КонецЕсли; 	

	Если НЕ ИспользоватьОптимизацию Тогда
		ЗагрузитьКодыГородов();
	КонецЕсли; 

КонецПроцедуры

// Инициируем таблицу кодов городов для расбора номера
// 
Функция ЗагрузитьКодыГородов()
	// Загрузим список городов
	КодыГородовВСтр = ПолучитьМакет("КодыГородовТаблица").ПолучитьТекст();
	ТЗ_КодыГородов = ЗначениеИзСтрокиВнутр(КодыГородовВСтр);
	АдресТЗКодыГородов = ПоместитьВоВременноеХранилище(ТЗ_КодыГородов);
	Возврат ТЗ_КодыГородов;
КонецФункции	
// Определяет информацию об абоненте по номеру телфона.
//
//  НомерТелефона   [Строка]           Номер телефона абонента в формате URI.
//  ТелефоннаяКнига [ТабличнаяЧасть]   Таблица номеров телефонной книги.
//  КодСтраны       [Строка]           Телефонный код страны.
//  КодГорода       [Строка]           Телефонный код города.
//
//  Возвращаемое значение [Структура]   Содержит информацию об абоненте.
//
//&НаКлиенте
Функция ПолучитьДанныеОбАбоненте(Знач НомерТелефона) Экспорт
	// поиск среди городских номеров
	ПервыйСимвол = Лев(НомерТелефона, 1);
	Если ПервыйСимвол="8" И СтрДлина(НомерТелефона) = 11 Тогда
	  	НомерТелефона = "7" + Прав(НомерТелефона, СтрДлина(НомерТелефона)-1); 	
	КонецЕсли; 
	
	НомерТелефона = мОбработкаДанных.УбратьИзНомераТелефонаВсеПрефиксы(НомерТелефона);
	
	Результат = Новый Структура("Город,Область,Страна,НомерТелефона,КодСтраны,КодГорода,Номер");
	Результат.Вставить("НомерТелефона", НомерТелефона);
	Если ИспользоватьОптимизацию Тогда
	
		Попытка
			врМодуль = Вычислить("МИКО_опЗаписьКИ");
		Исключение
		    врМодуль = Неопределено;
		КонецПопытки; 
		
		врНомерТелефона = НомерТелефона;
		
		ВыборкаКодГорода = врМодуль.РазложитьНомерТелефона(НомерТелефона);
		
		Если НЕ ВыборкаКодГорода = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат, ВыборкаКодГорода);
			Страна = "";
			Если Найти(Врег(ВыборкаКодГорода.Страна), "УКРАИНА")>0  Тогда
			 	Страна = "Украина";	
			ИначеЕсли ВыборкаКодГорода.Страна = "РФ" ИЛИ Найти(Врег(ВыборкаКодГорода.Страна), "РОСС")>0 Тогда	
			 	Страна = "Россия";
			ИначеЕсли Врег(ВыборкаКодГорода.Страна) = "БЕЛАРУСЬ" Тогда
				Страна = "Беларусь";
			КонецЕсли; 
			врНомерТелефона 	= ""+ВыборкаКодГорода.КодСтраны + " (" + ВыборкаКодГорода.КодГорода + ") " 
							  + Сред(НомерТелефона, СтрДлина(""+ВыборкаКодГорода.КодСтраны + ВыборкаКодГорода.КодГорода) + 1);
			ДлинаНомера 	= СтрДлина(НомерТелефона) - СтрДлина(""+ВыборкаКодГорода.КодСтраны+ВыборкаКодГорода.КодГорода);
			
			Результат.Страна 		= Страна;
			Результат.НомерТелефона = врНомерТелефона;
			Результат.КодСтраны 	= ВыборкаКодГорода.КодСтраны;
			Результат.КодГорода 	= ВыборкаКодГорода.КодГорода;
			Результат.Номер 		= Прав(НомерТелефона,ДлинаНомера);
			Результат.Город 		= ?(ЗначениеЗаполнено(Результат.Город),Результат.Город,Результат.Область);
			
		КонецЕсли;
		
		Возврат Результат;
		
	КонецЕсли; 
	// поиск среди мобильных 	
	Запрос = Новый Запрос();
	// Найдем информацию о номере по базе кодов городов
	Запрос.Текст = "ВЫБРАТЬ
                  |	ТабКодыГородов.ШаблонПоиска КАК ШаблонПоиска,
                  |	ТабКодыГородов.КодСтраны,
                  |	ТабКодыГородов.КодГорода,
                  |	ТабКодыГородов.Город,
                  |	ТабКодыГородов.Область,
                  |	ТабКодыГородов.Страна
                  |ПОМЕСТИТЬ втКодыГородов
                  |ИЗ
                  |	&ТабКодыГородов КАК ТабКодыГородов
                  |
                  |ИНДЕКСИРОВАТЬ ПО
                  |	ШаблонПоиска
                  |;
                  |
                  |////////////////////////////////////////////////////////////////////////////////
                  |ВЫБРАТЬ ПЕРВЫЕ 1
                  |	КодыГородов.ШаблонПоиска,
                  |	КодыГородов.Город,
                  |	КодыГородов.Область,
                  |	КодыГородов.Страна,
                  |	КодыГородов.КодГорода,
                  |	КодыГородов.КодСтраны
                  |ИЗ
                  |	втКодыГородов КАК КодыГородов
                  |ГДЕ
                  |	&НомерДляПоискаГорода ПОДОБНО КодыГородов.ШаблонПоиска
                  |
                  |УПОРЯДОЧИТЬ ПО
                  |	КодыГородов.ШаблонПоиска УБЫВ";
	ТЗ_КодыГородов = ПолучитьИзВременногоХранилища(АдресТЗКодыГородов);
	Если ТЗ_КодыГородов = Неопределено Тогда
	 	ТЗ_КодыГородов = ЗагрузитьКодыГородов();   
	КонецЕсли; 
	Запрос.УстановитьПараметр("ТабКодыГородов", ТЗ_КодыГородов);
	Запрос.УстановитьПараметр("НомерДляПоискаГорода", НомерТелефона);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Если Не РезультатЗапроса[1].Пустой() Тогда
		Выборка = РезультатЗапроса[1].Выбрать();
		Выборка.Следующий();
		
		Номер = Сред(НомерТелефона, СтрДлина(Выборка.КодСтраны + Выборка.КодГорода) + 1);
		Результат.КодСтраны = Выборка.КодСтраны;
		Результат.КодГорода = Выборка.КодГорода;
		Результат.Номер 	= Сред(НомерТелефона, СтрДлина(Выборка.КодСтраны + Выборка.КодГорода) + 1);
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		
		Если Не ЗначениеЗаполнено(Результат.Город) Тогда
			Результат.Город   = Результат.Область;
			Результат.Область = "";
		КонецЕсли; 
	КонецЕсли;
	
	Возврат Результат;
КонецФункции // ПолучитьДанныеОбАбоненте()

// Из строки вида XXXXXXXXXX@Context или Provider/XXXXXXXXXX или Provider/SIP_namber/XXXXXXXXXX, выделяет номер
// Параметры 
//   СтрокаНабораНомера - тип значения "строка" передается по значению, строка: содержащая номер телефона
// Возвращаемое значение
//   НомерТелефона - тип значения "строка"
Функция ПолучитьНомерВызываемогоАбонентаИзАтрибутаDialstring(Знач СтрокаНабораНомера) Экспорт
	Если Найти(ВРЕГ(СтрокаНабораНомера),"LOCAL")>0 Тогда
		СтрокаНабораНомера = СтрЗаменить(СтрокаНабораНомера,"/n", "");	
	КонецЕсли; 
	// Получим позицию начала номера
	НачалоНомера = ПолучитьПозициюДальнегоСимвола(СтрокаНабораНомера,"/") + 1; // если > 0 то начало номера найдено
	
	// учтем формат DIAL
	Если СтрЧислоВхождений(СтрокаНабораНомера,"@")=1 Тогда
		СимволыПоиска = "@";
	ИначеЕсли СтрЧислоВхождений(СтрокаНабораНомера,"/")=2 Тогда	
	 	СимволыПоиска = ",";
	Иначе
		СимволыПоиска = "-,";
	КонецЕсли;
	
	// Получим позицию конца номера
	ДальнийСимвол = ПолучитьПозициюБлижнегоСимвола(СтрокаНабораНомера, СимволыПоиска);
	
	// НачалоНомера - если < 0, то Сред воспринимает параметр как "НачалоСтроки") 
	НачалоНомера = ?(НачалоНомера<=0,0,НачалоНомера);
	// ДлинаНомера  - Если < 0, то Сред воспринимает параметр как "ДоКонцаСтроки"
	КонецНомера  = ?(ДальнийСимвол<=0,СтрДлина(СтрокаНабораНомера)+1,ДальнийСимвол);
	
	НачалоНомера = ?(НачалоНомера<=0,1,НачалоНомера);
	ДлинаНомера  = КонецНомера - НачалоНомера ;
	НомерТелефона = Сред(СтрокаНабораНомера, НачалоНомера, ДлинаНомера);
	
	НомерТелефона = СтрЗаменить(НомерТелефона, "sip:", "");
	Возврат НомерТелефона;
КонецФункции

// Поиск позиции ближнего символа с строке.
// 
Функция ПолучитьПозициюБлижнегоСимвола(Знач ИсхСтрока, СтрокаСимволов) Экспорт
	Позиция = 0;

	Для а=1 По СтрДлина(СтрокаСимволов) Цикл
		ТекПоз = Найти(ИсхСтрока,Сред(СтрокаСимволов,а,1));
		// не учитываем нулевые позиции
		Если ТекПоз = 0 Тогда Продолжить; КонецЕсли;
		Позиция = ?( Позиция = 0,ТекПоз,МИН(Позиция, ТекПоз) );		
	КонецЦикла;
	Возврат Позиция;
КонецФункции

// Поиск позиции дальнего символа с строке.
// 
Функция ПолучитьПозициюДальнегоСимвола(Знач ИсхСтрока, СтрокаСимволов) Экспорт
	
	ДлинаСтроки = СтрДлина(ИсхСтрока);
	Для к=0 по ДлинаСтроки Цикл 
		НомерСимвола = ДлинаСтроки-к; 
		Символ = Сред(ИсхСтрока,НомерСимвола,1);
		
		Если Найти(СтрокаСимволов,Символ)>0 Тогда 
			Возврат НомерСимвола; 
		КонецЕсли; 
	КонецЦикла;	

	Возврат -1;	
КонецФункции // ПолучитьПозициюДальнегоСимвола()

// Находит первое вхождение одного из искомых символов в исходной строке.
// Поиск осуществлюяется справа.
//
Функция НайтиСправаОдинИзСимволов(Знач Строка, Знач Символы)
	
	ДлинаСтроки = СтрДлина(Строка);
	Позиция = ДлинаСтроки;
	Пока Позиция > 0 Цикл
		Если Найти(Символы, Сред(Строка, Позиция, 1)) > 0 Тогда
			Возврат Позиция;
		КонецЕсли;
		Позиция = Позиция - 1;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции // НайтиСправаОдинИзСимволов()

// хинт может прийти в формате, Custom:busystate132&amp;SIP/132
// функция анализирует строку hint, отсекает из нее лишнее
// возвращает ИСТИНА: если хинт найден
Функция ПолучитьЗначениеХинта(hint, Знач НомерТелефона)
    Перем КаналНайден, МассивКаналов, ТекКанал;
    hint = СтрЗаменить(hint, "&amp;", "&");
    hint = СтрЗаменить(hint, ",", "&");
	Если Найти(hint, "&")<=0 Тогда
		Возврат	Истина;
	КонецЕсли;	
		
	КаналНайден = Ложь;
    
    МассивКаналов = мОбработкаДанных.мРазложитьСтрокуВМассивПодстрок(hint,"&");
    Для каждого ТекКанал Из МассивКаналов Цикл
        ТекКанал = Врег(ТекКанал);
        Если Найти(ТекКанал, "/" + НомерТелефона)>0
            ИЛИ  Найти(ТекКанал, "DAHDI/")>0 Тогда
            hint = ТекКанал;
            КаналНайден = Истина;
            Прервать;
        КонецЕсли; 
    КонецЦикла;
    Возврат КаналНайден;

КонецФункции

Функция ЭтоСлужебныйКанал(Знач Канал)
