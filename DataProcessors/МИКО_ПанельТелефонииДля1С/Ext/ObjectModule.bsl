// Получаем значения режима работы панели телефонии
// 
Функция ПолучитьРежимРаботы(РежимРаботы) Экспорт
	
	Если РежимРаботы = 0 Тогда	
		врИспользоватьСофтфон  = Истина;
		врИспользоватьAsterisk = Ложь;
	ИначеЕсли РежимРаботы = 1 Тогда	
		врИспользоватьСофтфон  = Ложь;
		врИспользоватьAsterisk = Истина;
	ИначеЕсли РежимРаботы = 2 Тогда	
		врИспользоватьСофтфон  = Истина;
		врИспользоватьAsterisk = Истина;
	КонецЕсли;
	
	Режим = Новый Структура("ИспользоватьСофтфон,ИспользоватьAsterisk",врИспользоватьСофтфон, врИспользоватьAsterisk);
	Возврат Режим;
КонецФункции

// Назначает / снимает права доступа на использование панели телефонии.
// 
Процедура НазначитьСнятьРольИспользоватьСофтфон(КодПользователя, Использовать) Экспорт

	// установим роль для пользователя
	Если НЕ БезИнтеграционныйРежим
		И Метаданные.Роли.Найти("МИКО_ИспользованиеСофтфона")<>Неопределено Тогда
		РольМИКО_ИспользованиеСофтфона = Метаданные.Роли.МИКО_ИспользованиеСофтфона;
		
		Пользователь1С = ПользователиИнформационнойБазы.НайтиПоИмени(КодПользователя);
		// если такой пользователь сущействует, то установим/удалим для него роль "МИКО_ИспользованиеСофтфона"
		Если НЕ Пользователь1С = Неопределено Тогда
			// редактирование списка ролей пользователя ИБ
			РолиПользователя1С = Пользователь1С.Роли; ЗаписатьДаныеПользователя = Истина;
			Если Использовать И НЕ РолиПользователя1С.Содержит(РольМИКО_ИспользованиеСофтфона) Тогда
				РолиПользователя1С.Добавить(РольМИКО_ИспользованиеСофтфона);
			ИначеЕсли НЕ Использовать И РолиПользователя1С.Содержит(РольМИКО_ИспользованиеСофтфона)Тогда
				РолиПользователя1С.Удалить(РольМИКО_ИспользованиеСофтфона);
			Иначе
				ЗаписатьДаныеПользователя = Ложь;
			КонецЕсли; 
			// перезапись пользователя ИБ
			Если ЗаписатьДаныеПользователя = Истина Тогда
				Попытка
					Пользователь1С.Записать();
				Исключение 
					СообщитьОтладочнуюИнформацию("Панель телефонии Asterisk:", "Не вышло установить пользователю " + Пользователь1С + " роль ""МИКО_ИспользованиеСофтфона"", " + ИнформацияОбОшибке());	
				КонецПопытки;
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли;

КонецПроцедуры

// Возвращает имя текущего пользователя.
// 
Функция ПолучитьИмяПользователя(СсылкаНаПользователя) Экспорт
    
	КодПользователя = СокрЛП(СсылкаНаПользователя.Код);
	Если ТипЗнч(СсылкаНаПользователя) <> Тип("СправочникСсылка.Пользователи") Тогда
		Возврат КодПользователя;
	КонецЕсли;
	
	Если СсылкаНаПользователя.Метаданные().Реквизиты.Найти("ИдентификаторПользователяИБ")<>Неопределено Тогда
		Попытка
			ПользотвательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(СсылкаНаПользователя.ИдентификаторПользователяИБ);
			Если ПользотвательИБ <> Неопределено Тогда
				КодПользователя = ПользотвательИБ.Имя;
			КонецЕсли; 
		Исключение
		КонецПопытки; 
	КонецЕсли; 
	
	Возврат КодПользователя;
	
КонецФункции // ПолучитьИмяПользователя()

