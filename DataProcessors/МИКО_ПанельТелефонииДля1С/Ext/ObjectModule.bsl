// Подключает вненюю компоненту банера
// Комопнента должна быть зарегистрирована в операционной системе как COM объект
Процедура Банер_ПодключитьКомпонент(ЗакрыватьФормуПриДействии = Истина, Opacity = 1) Экспорт
	
	Если Не ИспользоватьБаннер Тогда
		мВнешняяПанель = Неопределено;
		Возврат;
	КонецЕсли;	
	
	Если мВнешняяПанель = Неопределено Тогда		
		Попытка
			мВнешняяПанель = ЭтотОбъект.ПолучитьФорму("ВнешняяПанель");
		Исключение
			СообщитьОтладочнуюИнформацию("Банер", "Не вышло установить значения свойств компонента банера!");
			Возврат;
		КонецПопытки;		
	КонецЕсли;
	мВнешняяПанель.ВП_ВывестиНаЭкран();
	
КонецПроцедуры

// Инициализация банера.
// 
Процедура Банер_УстановитьПараметрыТП() Экспорт
	Если НЕ ИспользоватьБаннер ИЛИ мВнешняяПанель = Неопределено Тогда		
		Возврат;	
	КонецЕсли;	
	
	НастройкиВП = Новый Соответствие;
	НастройкиВП.Вставить("Пользователь", 		 мПользователь);
	НастройкиВП.Вставить("URI", 				 НашНомерТелефона+"@"+?(ЗначениеЗаполнено(ХостAsterisk),ХостAsterisk, Хост));
	НастройкиВП.Вставить("РежимСупервизора", 	 Супервизор=Истина);
	НастройкиВП.Вставить("ВозможенАвтоподъем",   ИспользоватьАвтоподъем);
	НастройкиВП.Вставить("number", 	 		 	 НашНомерТелефона);
	
	//TODO
	НастройкиВП.Вставить("Статус",				 0);
	НастройкиВП.Вставить("coference_exists", 	 Ложь);
	НастройкиВП.Вставить("ИгровойРежим", 	 	 Ложь);
	НастройкиВП.Вставить("АктивизироватьИзТрея", Ложь);
	мВнешняяПанель.ВП_УстановитьПараметрыТекущегоПользователя(НастройкиВП);

КонецПроцедуры
 
// Открывает окно банера, окно содержит поле HTML документа. Отображается всегда поверх всех окон
// При нажатии на гиперссылки в поле HTML в 1С возвращается внешнее событие 
Процедура Банер_ДобавитьСтрокуЗвонка(СтрочкаЗвонка) Экспорт
	Если мВнешняяПанель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	UID = ПолучитьНашКанал(СтрочкаЗвонка);
	Если НЕ ЗначениеЗаполнено(UID) Тогда
	  	Возврат;
	КонецЕсли; 
	UID = СтрЗаменить(UID, "_", "$");						
	UID = СтрЗаменить(UID, "/","_");						
	Вызов = Новый Структура;
	Вызов.Вставить("НомерТелефона", 	СтрочкаЗвонка.CallerID);
	Вызов.Вставить("Партнер", 			СтрочкаЗвонка.Контрагент);
	Вызов.Вставить("Абонент", 			СтрочкаЗвонка.КонтактноеЛицо);
	Вызов.Вставить("НомерЛинии", 		UID);
	Вызов.Вставить("Город", 			СтрочкаЗвонка.Город);
	Вызов.Вставить("ChanSpyКанал", 		СтрочкаЗвонка.ChanSpyКанал);
	Вызов.Вставить("our_cidname", 		СтрочкаЗвонка.our_cidname);
	
	Вызов.Вставить("ЗвонокНаМобильный", Ложь); //TODO
	Вызов.Вставить("ЭтоКонференция", 	Ложь); //TODO
	
	Если СтрочкаЗвонка.СейчасРазговаривают Тогда
		Вызов.Вставить("Статус", 		"current");
	ИначеЕсли СтрочкаЗвонка.ВходящийЗвонок Тогда
		Вызов.Вставить("Статус", 		"ringing");
	Иначе
		Вызов.Вставить("Статус", 		"calling");
	КонецЕсли; 	
	Вызов.Вставить("Входящий", 		СтрочкаЗвонка.ВходящийЗвонок);
	Попытка
		мВнешняяПанель.ВП_ДобавитьСтрокуЗвонка(Вызов);		
	Исключение
		СообщитьОтладочнуюИнформацию("Банер", ИнформацияОбОшибке());	
	КонецПопытки;  
КонецПроцедуры

// По переданному униклаьному идентификатору производится поиск формы. 
// Если форма найдена, то производится ее закрытие
Процедура Банер_УдалитьСтрочкуЗвонка(КаналHangup) Экспорт
	Если мВнешняяПанель = Неопределено
		 ИЛИ Найти(КаналHangup, НашКаналФильтр)=0 Тогда
		Возврат;
	КонецЕсли;
	UID = СтрЗаменить(КаналHangup, "/","_");						
	UID = СтрЗаменить(UID, "&lt;ZOMBIE&gt;","");						
	Вызов = Новый Структура;
	Вызов.Вставить("НомерЛинии", 	UID);
	Попытка
		мВнешняяПанель.ВП_УдалитьСтрокуЗвонка(Вызов);
	Исключение
		СообщитьОтладочнуюИнформацию("Банер", ИнформацияОбОшибке());	
	КонецПопытки;  
КонецПроцедуры

// Заполнение таблицы сотрудников во внешней панели.
// 
Процедура Банер_ЗаполнитьТаблицуСотрудинков() Экспорт
	Если Не ИспользоватьБаннер Тогда
		мВнешняяПанель = Неопределено;
		Возврат;
	КонецЕсли;	
	
	врСписок = Новый Массив; врНомера = Новый Массив;
	Для каждого текСотрудник Из Сотрудники Цикл
		Если врНомера.Найти(текСотрудник.ВнутреннийНомер)<>Неопределено Тогда
		 	Продолжить;
		КонецЕсли; 
		врНомера.Добавить(текСотрудник.ВнутреннийНомер);
		
		нЭлемент = Новый Структура;
		нЭлемент.Вставить("НомерТелефона",	текСотрудник.ВнутреннийНомер);
		нЭлемент.Вставить("Абонент",		""+текСотрудник.Сотрудник);
		нЭлемент.Вставить("АбонентСсылка",	текСотрудник.Сотрудник);
		нЭлемент.Вставить("Видимость",		текСотрудник.ВнутреннийНомер <> НашНомерТелефона);
		нЭлемент.Вставить("Собеседник",		текСотрудник.Собеседник);
		нЭлемент.Вставить("МобильныйНомер",	текСотрудник.МобильныйНомер);
		нЭлемент.Вставить("СтатусКод",		текСотрудник.Состояние); //TODO
		врСписок.Добавить(нЭлемент);
		
	КонецЦикла; 

	Попытка
		мВнешняяПанель.ВП_ЗаполнитьСписокСотрудников(врСписок);
	Исключение
	КонецПопытки; 
