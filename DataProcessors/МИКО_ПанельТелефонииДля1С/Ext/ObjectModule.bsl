// Разрываем соединение для канала в выбранной строке
//
Процедура ОтбойЗвонка(ТекущийЗвонок, Знач Cause = "") Экспорт
	Если ТекущийЗвонок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЛинияSIP = ЗвонкиSIP.Найти(ТекущийЗвонок.CallerID, "CallerID");        
	
	Если ИспользоватьСофтфон 
		 И ДопМодули.Свойство("НаборНомера") И НЕ (ДопМодули.НаборНомера = Неопределено) И ЛинияSIP <> Неопределено Тогда
		ДопМодули.НаборНомера.ВыполнитьДействиеНадЗвонком(ЛинияSIP.Канал, "КнопкаЗавершитьПоID");
	ИначеЕсли НЕ ИспользоватьAsterisk
		 	  И ДопМодули.Свойство("НаборНомера") И НЕ (ДопМодули.НаборНомера = Неопределено) Тогда
		ДопМодули.НаборНомера.ВыполнитьДействиеНадЗвонком(ТекущийЗвонок, "ОтбойЗвонка");
		Возврат;	
	КонецЕсли;
	Если Компонент = Неопределено Тогда Возврат; КонецЕсли; 
	
	Если Найти(ТекущийЗвонок.Канал1, НашКаналФильтр)>0 Тогда 
		Channel = ТекущийЗвонок.Канал1;
	ИначеЕсли Найти(ТекущийЗвонок.Канал2, НашКаналФильтр) Тогда
		Channel = ТекущийЗвонок.Канал2;
	Иначе
		Channel		=	""+ПолучитьАктивныйКанал(ТекущийЗвонок.НомерСтроки);	
	КонецЕсли;
	
	ActionID	=	""+КлючУникальности;
	Результат	= 	"";
 	Cause	 	= 	Строка(Cause);
	Попытка
		Компонент.Hangup(Channel,Cause,ActionID,Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение завершения вызова ",Результат);
	КонецПопытки; 
	
КонецПроцедуры

// Для текущего звонка осуществляет перевод звонка в зависимости от соотояния,
// если для выбранной строки оператор уже общается с клиентом то будет использоваться 
// консультативный перевод, иначе звонок переадресуется безконсультативно.
//
Процедура ПереводЗвонка(ТекущийЗвонок,НомерПеревода) Экспорт
	Если НЕ ЗначениеЗаполнено(ТекущийЗвонок) Тогда
		Возврат;
	КонецЕсли; 
	
	КонтекстДляПеревода = ?(ЗначениеЗаполнено(КонтекстДляКонсультативногоПеревода),КонтекстДляКонсультативногоПеревода, КонтекстНабораПоУмолчанию);	
	
	Если ТекущийЗвонок.СейчасРазговаривают Тогда
		КонсультативныйПеревод(ТекущийЗвонок,НомерПеревода,КонтекстДляПеревода);
	Иначе
		БезКонсультативныйПеревод(ТекущийЗвонок,НомерПеревода,КонтекстДляПеревода);
	КонецЕсли; 
КонецПроцедуры	

// Инициирование консультативного перевода звонка из текущей строки.
//
Процедура КонсультативныйПеревод(ТекущийЗвонок,НомерКудаПереводимЗвонокAtxfer,КонтекстПеревода) Экспорт
	
	Если ТекущийЗвонок = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	Если НЕ ИспользоватьAsterisk
		 И ДопМодули.Свойство("НаборНомера")
		 И НЕ (ДопМодули.НаборНомера = Неопределено) Тогда
		ДопМодули.НаборНомера.ВыполнитьДействиеНадЗвонком(ТекущийЗвонок, "КонсультативныйПеревод", НомерКудаПереводимЗвонокAtxfer);
		Возврат;	
	КонецЕсли;
	
	Channel		=	?(ТекущийЗвонок.ВходящийЗвонок,ТекущийЗвонок.Канал2,ТекущийЗвонок.Канал1); // Channel - Название канала, для которого производиться перевод вызова (обязательный параметр)
	// ищем СВОЙ Канал
	Если Найти(ВРЕГ(Channel), "LOCAL")>0 Тогда
		врChannel = мОбработкаДанных.ОтсечьПлечоВLocal(Channel, Ложь);
		п1_Channel = врChannel + ";2";
		п2_Channel = врChannel + ";1";
		
		ПоискРеальногоКанала(п1_Channel, Неопределено, Неопределено, Ложь);
		ПоискРеальногоКанала(п2_Channel, Неопределено, Неопределено, Ложь);
		// НАШ канал
		Если Найти(п1_Channel, НашКаналФильтр)>0 Тогда
			Channel = п1_Channel;
		Иначе
			Channel = п2_Channel;
		КонецЕсли;
	КонецЕсли; 
	
	Context		=	КонтекстПеревода;					 //	Context - Название контекста в плане набора, куда переводиться вызов (обязательный параметр)
	Exten		=	НомерКудаПереводимЗвонокAtxfer;		 //	Exten -Название екстеншена в плане набора, куда переводиться вызов (обязательный параметр)
	Priority	=	"1";								 //	Priority - Номер приоритета в плане набора, куда переводиться вызов (обязательный параметр)
	ActionID	=	КлючУникальности;					 //	ActionID -Не обязательный ID команды, который будет возвращен в ответе.
	
	Если Компонент = Неопределено Тогда
		Сообщить("Компонент не подключен");
		Возврат;
	КонецЕсли; 
	
	Попытка
		Результат="";
		Компонент.Atxfer(Channel,Exten,Context,Priority,ActionID,Результат);
		Сообщить("Переводим звонок консультативно "+ТекущийЗвонок.CallerID+" на номер "+НомерКудаПереводимЗвонокAtxfer);
		СообщитьОтладочнуюИнформацию("Результат консультативного перевода звонка ",Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение консультативного перевода звонка ",Результат);
	КонецПопытки; 
КонецПроцедуры	

// Инициирование безусловного перевода звонка из текущей строки.
//
Процедура БезКонсультативныйПеревод(ТекущийЗвонок,НомерКудаПереводимЗвонокRedirect,КонтекстПеревода) Экспорт
	Если ТекущийЗвонок = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	Если НЕ ИспользоватьAsterisk
		 И ДопМодули.Свойство("НаборНомера")
		 И НЕ (ДопМодули.НаборНомера = Неопределено) Тогда
		ДопМодули.НаборНомера.ВыполнитьДействиеНадЗвонком(ТекущийЗвонок, "БезКонсультативныйПеревод", НомерКудаПереводимЗвонокRedirect);
		Возврат;	
	КонецЕсли;
	
	Channel		=	?(ТекущийЗвонок.ВходящийЗвонок,ТекущийЗвонок.Канал1,ТекущийЗвонок.Канал2);	//	Channel: Название канала, для которого производиться перевод вызова (обязательный параметр).
	// ищем канал СОБЕСЕДНИКА
	Если Найти(ВРЕГ(Channel), "LOCAL")>0 Тогда
		врChannel = мОбработкаДанных.ОтсечьПлечоВLocal(Channel, Ложь);
		п1_Channel = врChannel + ";2";
		п2_Channel = врChannel + ";1";
		
		ПоискРеальногоКанала(п1_Channel, Неопределено, Неопределено, Ложь);
		ПоискРеальногоКанала(п2_Channel, Неопределено, Неопределено, Ложь);
		// Канал СОБЕСЕДНИК
		Если Найти(п1_Channel, НашКаналФильтр)>0 Тогда
			Channel = п2_Channel;
		Иначе
			Channel = п1_Channel;
		КонецЕсли;
	КонецЕсли; 
	
	Exten		=	НомерКудаПереводимЗвонокRedirect;											//	Exten: Название екстеншена в плане набора, куда переводиться вызов (обязательный параметр).
	Context		=	КонтекстПеревода;															//	Context: Название контекста в плане набора, куда переводиться вызов (обязательный параметр)
	Priority	=	"1";																		//	Priority: Номер приоритета в плане набора, куда переводиться вызов (обязательный параметр)
	
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("При безусловном переводе ","Компонент не подключен");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Channel) Тогда
		врChannel = ?(НЕ ТекущийЗвонок.ВходящийЗвонок, ТекущийЗвонок.Канал1, ТекущийЗвонок.Канал2);
		Если Найти(ВРЕГ(врChannel), "LOCAL")>0 Тогда
			ПоискРеальногоКанала(врChannel, Неопределено, Неопределено, Ложь);		
		КонецЕсли;
		Channel = ПолучитьПеременнуюКанала(врChannel,"INTERCHANNEL");
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(Channel) Тогда
		Возврат;
	КонецЕсли; 
	
	Если Exten = "10000333" Тогда
		Попытка
			Компонент.Redirect(Channel,"",Exten,"",Context,"","1","","", "");
		Исключение
		КонецПопытки;
	Иначе
		БезКонсультативныйПеревод_10000104(Channel, Exten, Context);
	КонецЕсли; 

КонецПроцедуры	

Процедура БезКонсультативныйПеревод_10000104(Знач Канал, Знач врНомерТелефона, Знач врКонтекстНабораСлужебныхКоманд = Неопределено, Знач Канал2="")
	
	Если НЕ ЗначениеЗаполнено(ChanTimeOut) ИЛИ НЕ ЗначениеЗаполнено(RedirectNumber) Тогда
		// устанавливаем значения "по умолчанию"
		ChanTimeOut 	= "900";
		RedirectNumber 	= НашНомерТелефона;
	КонецЕсли; 
	КонтекстПереадресации = ?(ЗначениеЗаполнено(КонтекстДляКонсультативногоПеревода),КонтекстДляКонсультативногоПеревода, КонтекстНабораПоУмолчанию);	
	
	// Таймаут времени звонка для перехвата.
	УстановитьПеременнуюКанала(Канал, "ChanTimeOut", 	СокрЛП(ChanTimeOut)); 	
	// Контекст для набора внутрнних номеров.
	УстановитьПеременнуюКанала(Канал, "MIKO_VMX_CONTEXT", КонтекстПереадресации);
	Если врНомерТелефона = "10000104" Тогда
		// Скажем всем что это наш звонок.
		УстановитьПеременнуюКанала(Канал, "interception",	НашНомерТелефона);
		// Резервный номер для перевода (наш номер).
		УстановитьПеременнуюКанала(Канал, "RedirectNumber", СокрЛП(RedirectNumber));
	Иначе	
		// Скажем всем что это наш звонок.
		УстановитьПеременнуюКанала(Канал, "interception",	врНомерТелефона);
		// Резервный номер для перевода (наш номер).
		УстановитьПеременнуюКанала(Канал, "RedirectNumber", СокрЛП(НашНомерТелефона));
	КонецЕсли; 
	
	// Переводим звонок.
	Channel		=	""+Канал;				
	Channel2	=   ""+Канал2;
	Exten		=	"10000104";			
	Context		=	""+КонтекстНабораСлужебныхКоманд;	
	Priority	=	"1";					
	
	Если ЗначениеЗаполнено(Channel2) Тогда
		Exten2	= Exten;
	    Context2= Context;	
	Иначе
		Exten2  = "";
	    Context2= "";
	КонецЕсли;
	
	Попытка
		Результат="";
		Компонент.Redirect(Channel,Channel2,Exten,Exten2,Context,Context2,Priority,"","", Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение безусловного перевода ",Результат);
	КонецПопытки;
	
КонецПроцедуры	// БезКонсультативныйПеревод();



// В текущий канал отправляется подготовленный для отправки факсом файл tif
// инициируется отправка факсимильного сообщения.
Процедура ОтправитьФакс(ТекущийЗвонок, ИмяФайлаТабДок) Экспорт 
	Если ТекущийЗвонок = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("При отправке факса","Компонент не подключен");
		Возврат;
	КонецЕсли;
	
	Результат="";
	Попытка
		ИмяФайлаДляОтправки = ПодготовитьPDFФайлДляОтправки(ИмяФайлаТабДок);
		
		Если ИмяФайлаДляОтправки = Неопределено Тогда
			Сообщить("Не удалось сформировать файл для отправки факса.");
			Возврат;
		КонецЕсли;	
		ФайлОтправленНаСерверAsterisk=Ложь;
		Если ЗначениеЗаполнено(УРЛСервераДляОтправкиФакса)
			 И PostFile(ИмяФайлаДляОтправки,Результат)
			 И Найти(Результат, "success")>0 Тогда 
			ФайлОтправленНаСерверAsterisk=Истина;
		ИначеЕсли ПроверитьЗагрузкуМодуляAsterisk("res_http_post") 
			И Компонент.PostFile(ИмяФайлаДляОтправки,,,,Результат) Тогда 
			ФайлОтправленНаСерверAsterisk=Истина;
		КонецЕсли;
		
		Если ФайлОтправленНаСерверAsterisk Тогда
			ПозицияНачалаИмениФайла=Найти(ИмяФайлаДляОтправки,СтрЗаменить(НашКаналФильтр,"/","-"));
			ИмяФайлаБезРасширенияИПути=Сред(ИмяФайлаДляОтправки,ПозицияНачалаИмениФайла,СтрДлина(ИмяФайлаДляОтправки)-ПозицияНачалаИмениФайла-3);
			
			КаналКудаСлатьФакс=?(ТекущийЗвонок.ВходящийЗвонок,ТекущийЗвонок.Канал1,ТекущийЗвонок.Канал2);	
			Если ЗначениеЗаполнено(КаналКудаСлатьФакс) Тогда
				Сообщить("Отправляем факс абоненту "+ТекущийЗвонок.CallerID);	
				
			   	Хинт = ТаблицаХинтов.Найти(НашКаналФильтр);
				Если НЕ Хинт = Неопределено Тогда
					УстановитьПеременнуюКанала(КаналКудаСлатьФакс,"cid_user",Хинт.ВнутреннийНомер);
				КонецЕсли; 
				// установим переменные для канала
				УстановитьПеременнуюКанала(КаналКудаСлатьФакс,"_faxfile",ИмяФайлаБезРасширенияИПути);
				УстановитьПеременнуюКанала(КаналКудаСлатьФакс,"_faxcallerid",ТекущийЗвонок.CallerID);
				УстановитьПеременнуюКанала(КаналКудаСлатьФакс,"_chan",НашКаналФильтр);
				// переведем вызов на приложение отправки факса
				БезКонсультативныйПеревод(ТекущийЗвонок,"10000333",КонтекстНабораСлужебныхКоманд);
			КонецЕсли;	
		Иначе
			Сообщить("Не удалось загрузить файл факса на сервер Asteriisk.");
		КонецЕсли; 
		
		СообщитьОтладочнуюИнформацию("Результат отправки факса ",Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение отправки факса ",Результат);
	КонецПопытки; 
КонецПроцедуры

// Передача файла факса на сервер АТС
// 
Функция PostFile(ИмяФайлаДляОтправки,Результат)
	Успех = Ложь;
	Попытка
	    Если НазваниеPBX = "ASKOZIA" Тогда
			// Попробуем сперва отправить файл на порт
			АдресHTTP = СтрЗаменить(УРЛСервераДляОтправкиФакса, "23600", "80");
			Компонент.PostFile(ИмяФайлаДляОтправки,АдресHTTP,ПользовательСтатистики,ПарольПользователяСтатистики,Результат);
			Успех = Найти(НРег(Результат),"success")>0;
			Если Успех = Истина Тогда
				// возвращаем: если успех
				Возврат Успех;
			КонецЕсли; 
		КонецЕсли; 
		// пробуем отправить факс по стандартному порту
		Компонент.PostFile(ИмяФайлаДляОтправки,УРЛСервераДляОтправкиФакса,ПользовательСтатистики,ПарольПользователяСтатистики,Результат);
		Успех = Найти(НРег(Результат),"success")>0;
		Возврат Успех;
	Исключение
	КонецПопытки; 	

	Возврат Успех;
КонецФункции // PostFile()

// Процедуру следует вызывать в блоке "попытка" она НЕ безопасна 
// 
Функция OriginateНаКаналСПередачейПараметров(Channel, Variable, Результат)
	Если Компонент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	// Описание работы
	// http://wiki.miko.ru/doc:panel1ccrm:asterisk_config:environments
	ЭтоПолучениеНастроек = Найти(Channel, "10000111")>0;
	Асинхронно = ?(ЭтоПолучениеНастроек,"","1");
	result = Компонент.Originate(Channel,,,,,, Variable,, "NoCDR",,Асинхронно,,"",КлючУникальности, Результат);
	Если ЭтоПолучениеНастроек И Найти(Результат, "'Error'")>0 Тогда
		// ошибка при оригинации 
		ВерсияДиалплана = "1.?.?.?";
		ФормаНастройки=мОбщийМодуль.ПолучитьФормуНастройки();
		Если ФормаНастройки.Открыта() Тогда
			ФормаНастройки.Активизировать()
		Иначе
			ФормаНастройки.Открыть();
		КонецЕсли;
		ФормаНастройки.ЭлементыФормы.ПанельНастроекТелефонии.ТекущаяСтраница = ФормаНастройки.ЭлементыФормы.ПанельНастроекТелефонии.Страницы.Основные;
		Сообщить("Не вышло получить настройки с АТС. Версия dialplan не определена!", СтатусСообщения.ОченьВажное);
	КонецЕсли; 
	Возврат result;
КонецФункции // OriginateНаКаналСПередачейПараметров()

// Для переданного имени файла записи инициируется процедура прослушивания записи звонка.
//
Процедура ПрослушатьЗвонок(ИмяФайлаЗаписи) Экспорт 
	Если ЗначениеЗаполнено(ИмяФайлаЗаписи)
		 И ЗначениеЗаполнено(НашКаналФильтр) Тогда
		// временный запрет набора
		параметрНабора = "";
		мОбработкаДанных.ЗапретитьНаборНомера(параметрНабора);
	Иначе
		Возврат;
	КонецЕсли;
	
	ИмяФайлаБезРасширения = мОбработкаДанных.УбратьРасширениеВФайлеЗаписи(ИмяФайлаЗаписи); // в файле не должно быть указано расширение
		
	Channel		=	НашКаналФильтр;
	Priority	=	"";					
	Timeout		=	"";				
	CallerID	=	"CDR_RECORDS <"+НашНомерТелефона+">"; 				//	CallerID: Значение CallerID, используемое для совершения исходящего вызова.
	Variable	=	"from_1C=true,"+ 
					"recfile="+ URLEncode(ИмяФайлаБезРасширения)+ ","+
					СтрокаАвтоподъема;
	Account		=	"";											//	Account: Значение для “Account code” исходящего вызова.
	Async		=	"1";						//	Async: Если указано “1” исходящий вызов будет производиться асинхронно. Результат ее выполнения будет возвращен позже, в пакете типа “Event” (позволяет осуществлять несколько вызовов без ожидания результата предыдущей команды, совершающей исходящий вызов)
	Codecs		=	"";							//  Используемый кодек
	ActionID	=	КлючУникальности;				//	ActionID: Не обязательный идентификатор запроса. Позволяет сопоставить результат выполнения конкретному запросу. В качестве значения можно использовать или номер или строку. Очень полезно использовать, когда выполняется несколько асинхронных запросов одновременно.
	Результат="";

	
	Если НазваниеPBX = "MYPBX" Тогда
		Context		=	КонтекстНабораСлужебныхКоманд;
		Exten		=	"Records";
		Application	=	"";						//	Application: Команда плана набора, используемая для совершения исходящего вызова (используется параметр “Data”, для указания ее параметров)
		Data		=	"";						//	Data : Параметры команды плана набора, используемой для совершения исходящего вызова.
		Priority    =   "1";	
	ИначеЕсли НазваниеPBX = "MIKOPBX" Тогда
		IS_ORGNT    =   Формат(ТекущаяДата() - НачалоДня(ТекущаяДата()), "ЧДЦ=0; ЧГ=0");
	 	Channel = "Local/"+НашНомерТелефона+"@internal-originate/n";
		Variable	= "__NOCDR=1,_IS_ORGNT="+IS_ORGNT+",pt1c_cid=CDR_RECORDS,extenfrom1c="+НашНомерТелефона+",_FROM_PEER="+НашНомерТелефона+","
						+СтрокаАвтоподъема; // Linksys SPA-942 точно умеет автоподьем
		Context	    = "";
		Exten		= "";
		Application = "MP3Player";
		Data 		= ИмяФайлаЗаписи;
	Иначе
		Context	    = 	"";
		Exten		=	"";
		Application = ?(UseMp3Player=Истина, "MP3Player", "Playback");
		Data 		= ""+?(UseMp3Player=Истина, ИмяФайлаЗаписи, ИмяФайлаБезРасширения);
	КонецЕсли; 
	
	Попытка
		Компонент.Originate(Channel, Context, Exten, Priority, Timeout, CallerID, Variable, Account, Application, Data, Async, Codecs, "", ActionID, Результат);
		СообщитьОтладочнуюИнформацию("CDR_RECORDS","Начало прослушивания разговора "+ИмяФайлаБезРасширения);
	Исключение
		СообщитьОтладочнуюИнформацию("CDR_RECORDS","Ошибка при прослушивании разговора "+ИмяФайлаБезРасширения);
	КонецПопытки;	
	
	
КонецПроцедуры

// Запускается принудительная записть текущего разговора в файл 
//
Процедура ЗаписьЗвонкаНачать(ТекущийЗвонок) Экспорт
	Если ТекущийЗвонок = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Сообщить("Пишем звонок "+ТекущийЗвонок.CallerID);
	
	Channel		=	ПолучитьАктивныйКанал(ТекущийЗвонок.НомерСтроки);	//	Channel: Канал, для которого нужно прекратить запись вызова, например: SIP/1310-089e1000 (обязательный параметр)
	File		=	ТекущийЗвонок.UniqueID1;	//	File: Не обязательный параметр. Имя файла, которое будет создано в директории spool/asterisk/monitor/. По умолчанию, совпадает с именем канала, на котором производиться запись. (символы косой черты заменены на черточки)
	Format1C	=	"gsm";						//	Format: Не обязательный параметр. Формат, в котором будет сохранен звуковой файл. По умолчанию: ”wav”.
	Mix			=	"1";						//	Mix: Не обязательный булевой параметр. Определяет, миксировать или нет поступающий и исходящий из канала аудиопоток после окончания записи.
	ActionID	=	КлючУникальности; 			//	ActionID: Необязательный ID команды, который будет возвращен в ответе.
	
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("При записи звонка ","Компонент не подключен");
		Возврат;
	КонецЕсли;
	
	Попытка
		Результат="";
		Компонент.Monitor(Channel,File,Format1C,Mix,ActionID,Результат);
		СообщитьОтладочнуюИнформацию("Результат записи звонка ",Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение записи звонка ",Результат);
	КонецПопытки; 
КонецПроцедуры

// Останавливается запись текущего разговора и в файл записи закрывается
//
Процедура ЗаписьЗвонкаОстановить (ТекущийЗвонок) Экспорт
	Если ТекущийЗвонок = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Channel		=	ПолучитьАктивныйКанал(ТекущийЗвонок.НомерСтроки);	//	Channel: Канал, для которого нужно прекратить запись вызова, например: SIP/1310-089e1000 (обязательный параметр)
	ActionID	=	КлючУникальности;									//	ActionID: Необязательный ID команды, который будет возвращен в ответе.
	
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("При остановки записи звонка ","Компонент не подключен");
		Возврат;
	КонецЕсли;
	
	Попытка                                         
		Результат="";
		Компонент.StopMonitor(Channel,ActionID,Результат);
		ЗапроситьФайлЗаписиНаСкачивание(,ТекущийЗвонок.UniqueID1+".gsm");
		Сообщить("Останавливаем запись звонка "+ТекущийЗвонок.CallerID);
		СообщитьОтладочнуюИнформацию("Результат остановки записи звонка ",Результат);
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение остановки записи звонка ",Результат);
	КонецПопытки; 
КонецПроцедуры

// Устанавливаем произвольную переменную локального канала или глобально.
//
Процедура УстановитьПеременнуюКанала(Канал,ИмяПеременной,ЗначениеПеременной) 
	
	Channel		=	""+Канал;				//	Channel: Канал, для которого устанавливается переменная. Если не указано, то устанавливается глобальная переменная.
	Variable	=	""+ИмяПеременной;		// 	Variable: Имя переменной.
	Value		=	""+ЗначениеПеременной;	//	Value: Значение переменной.
	ActionID	=	""+КлючУникальности;	//	ActionID: Необязательный ID команды, который будет возвращен в ответе.
	
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("При установке переменной ","Компонент не подключен");
		Возврат;
	КонецЕсли;
	
	Попытка
		Результат="";
		Компонент.SetVar(Channel,Variable,Value,ActionID,Результат);
		СообщитьОтладочнуюИнформацию("Результат установки переменной """ + ИмяПеременной + """ в значение """ + ЗначениеПеременной + """",Результат);	
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение при установке переменной канала " + ИмяПеременной,Результат);
	КонецПопытки; 
КонецПроцедуры	

// Получаем произвольную переменную локального канала.
//
Функция ПолучитьПеременнуюКанала(Канал,ИмяПеременной) 

	Channel		=	Канал;				//	Channel: Канал, для которого устанавливается переменная. Если не указано, то устанавливается глобальная переменная.
	Variable	=	ИмяПеременной;		// 	Variable: Имя переменной.
	ActionID	=	КлючУникальности;	//	ActionID: Необязательный ID команды, который будет возвращен в ответе.
	
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("При получении переменной канала ","Компонент не подключен");
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Результат="";
		Компонент.GetVar(Channel,Variable,ActionID,Результат);
		// <AJAX-RESPONSE>
		// <RESPONSE TYPE='OBJECT' ID='UNKNOWN'><GENERIC RESPONSE='SUCCESS' ACTIONID='974FC' VARIABLE='SYSTEMNAME' VALUE='' /></RESPONSE>
		// </AJAX-RESPONSE>
		
		// <ajax-response>
		// <response type='object' id='unknown'><generic response='Success' actionid='098b8' variable='SYSTEMNAME' value='askozia' /></response>
		// </ajax-response>
		
		УзелХМЛ=ПолучитьЧтениеXML(Результат);
		Если УзелХМЛ<>Неопределено Тогда
			Пока УзелХМЛ.Прочитать() Цикл
				Если УзелХМЛ.Имя="generic" И УзелХМЛ.ТипУзла =	ТипУзлаXML.НачалоЭлемента Тогда    // нужный нам узел в котором респонсили Эвент
					Событие	= УзелХМЛ.ЗначениеАтрибута("response");
					Если Событие="Success" Тогда 
						value = УзелХМЛ.ЗначениеАтрибута("value");
						Если value = "(null)" Тогда
							Возврат "";
						Иначе
							Возврат УзелХМЛ.ЗначениеАтрибута("value");
						КонецЕсли; 
												
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли; 
		СообщитьОтладочнуюИнформацию("Результат установки переменной ",Результат);	
		
		Возврат Неопределено;
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение получении переменной канала",Результат);
		Возврат Неопределено;
	КонецПопытки; 
КонецФункции	

// Тоновый донабор номера для текущего кнала
//
Процедура ДонаборНомера(ТекущийЗвонок, ДонаборНомер, Непосредственно=Ложь) Экспорт
	Если ТекущийЗвонок = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если НЕ ИспользоватьAsterisk
		 И ДопМодули.Свойство("НаборНомера")
		 И НЕ (ДопМодули.НаборНомера = Неопределено) Тогда
		ДопМодули.НаборНомера.ВыполнитьДействиеНадЗвонком(ТекущийЗвонок, "ДонабратьНомер", ДонаборНомер);
		Возврат;	
	КонецЕсли;

	Channel		=	?(ТекущийЗвонок.ВходящийЗвонок,ТекущийЗвонок.Канал1,ТекущийЗвонок.Канал2);	//	Channel: Имя канала, в который нужно отправить DTMF последовательность. (Обязательный параметр)
	Digit		=	Строка(ДонаборНомер);	//	Digit: DTMF последовательность, которую нужно отправить. (Обязательный параметр)
	ActionID	=	КлючУникальности;		//	ActionID: Необязательный ID команды, который будет возвращен в ответе.
	
	Если Компонент = Неопределено Тогда
		СообщитьОтладочнуюИнформацию("При донаборе номера ошибка ","Компонент не подключен");
		Возврат;
	КонецЕсли;
	
	Результат=""; РезультатИтог="";
	Состояние("Будет произведен набор добавочного номера " + Digit);
	
	Если Непосредственно=Ложь Тогда
		КнопкиДиалога = Новый СписокЗначений;
		КнопкиДиалога.Добавить(КодВозвратаДиалога.Отмена, "Отменить...");

		ПроизвестиЛиДонабор = Вопрос("Будет произведен набор добавочного номера " + Digit, КнопкиДиалога, 5,КодВозвратаДиалога.Отмена,"Донабор номера...");
		Если ПроизвестиЛиДонабор = КодВозвратаДиалога.Отмена Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли; 
	
	Попытка
		Для к=1 по СтрДлина(Digit) Цикл
			НабираемаяЦифра=Сред(Digit,к,1);
			Компонент.PlayDTMF(Channel, НабираемаяЦифра, ActionID, Результат);
			РезультатИтог=РезультатИтог+Результат;
		КонецЦикла;
		СообщитьОтладочнуюИнформацию("Результат команды PlayDTMF ",РезультатИтог);	
	Исключение
		СообщитьОтладочнуюИнформацию("Исключение при выполнении PlayDTMF: ",РезультатИтог);
	КонецПопытки; 
КонецПроцедуры	

// Запрос к серверу астериск для получения истории звонков для указанного канала и период
//
// Параметры
//  <ДатаНачала>  	 - <Тип.Дата> - Дата начала выборки записей
//  <ДатаОкончания>  - <Тип.Дата> - Дата окончания выборки записей
//
Процедура ЗапроситьЗаписиCDRДляТекущегоПользователя(ДатаЗвонков) Экспорт
	
	// Получим все отслеживаемые номера сотрудника
	СтрокаСНомерами="";
	Для каждого Номер Из мСписокНомеровПользователяДляИстории Цикл
		Если СтрокаСНомерами="" Тогда
			СтрокаСНомерами=СтрокаСНомерами + Номер;
		Иначе	
			СтрокаСНомерами=СтрокаСНомерами +"-"+ Номер;
		КонецЕсли; 
	КонецЦикла; 
	
	// Звоним на номер 10000555, используя контекст для служебных команд. Звонок длится не более 10 секунд.
	// для канала 10000555 устанавливаем переменные необходимые для разбора файла истории звонков
	
	Если ЗначениеЗаполнено(ДатаЗвонков)
		И ЗначениеЗаполнено(НашКаналФильтр)
		И ЗначениеЗаполнено(СтрокаСНомерами)
		Тогда
		
		Channel		=	"Local/10000555@"+КонтекстНабораСлужебныхКоманд;  //	Channel: Название канала, с которого совершается исходящий вызов (В том же формате, как если бы Вы совершали вызов этому абоненту командой Dial.)
		Variable	=
		"v1="	+URLEncode(НашКаналФильтр)
		+",v2="	+Формат(ДатаЗвонков,"ДФ=гггг-ММ-дд")
		+",v3="	+Формат(ДатаЗвонков+24*60*60,"ДФ=гггг-ММ-дд")
		+",v4="	+СтрокаСНомерами;
		
		//	Variable: Установка переменных канала (максимум 32). Переменные будут установлены для обоих каналов, участвующих в соединении (локального, для абонента от которого совершается вызов и для вызываемого канала).
		
		Результат="";
		Попытка
			OriginateНаКаналСПередачейПараметров(Channel, Variable, Результат);			
			СообщитьОтладочнуюИнформацию("Инициирован запрос CDR ",Результат);
		Исключение
			СообщитьОтладочнуюИнформацию("Ошибка при запросе CDR ",Результат);
		КонецПопытки;	
		
	КонецЕсли;
	
КонецПроцедуры // ВернутьЗаписиCDRДляТекущегоПользователя()

// Запрос к серверу астериск для получения имя файла записи для уникального идентификатора звонка
//
// Параметры
//  <ДатаНачала>  	 - <Тип.Дата> - Дата начала выборки записей
//  <ДатаОкончания>  - <Тип.Дата> - Дата окончания выборки записей
//
Процедура ЗапроситьИмяФайлаЗаписиCDRПоИдентификатору(Знач ИдентификаторЗвонка, Знач ИмяФайлаЗаписи = "") Экспорт
	// Звоним на номер 10000777, используя контекст для служебных команд. Звонок длится не более 10 секунд.
	// для канала 10000777 устанавливаем переменные необходимые для разбора файла истории звонков
	ИдентификаторЗвонка = СокрЛП(ИдентификаторЗвонка);
	Если НаборНомераРазрешен 
		 И ЗначениеЗаполнено(НашКаналФильтр) 
		 И ЗначениеЗаполнено(ИдентификаторЗвонка)
		 Тогда
		параметрНабора = "";
		мОбработкаДанных.ЗапретитьНаборНомера(параметрНабора);
		
		Channel		=	"Local/10000777@"+КонтекстНабораСлужебныхКоманд;			//	Channel: Название канала, с которого совершается исходящий вызов (В том же формате, как если бы Вы совершали вызов этому абоненту командой Dial.)
		Variable	=	
		"chan="			+URLEncode(НашКаналФильтр)
		+",uniqueid1c="	+URLEncode(ИдентификаторЗвонка)
		+",recordingfile=" +URLEncode(ИмяФайлаЗаписи);
		//	Variable: Установка переменных канала (максимум 32). Переменные будут установлены для обоих каналов, участвующих в соединении (локального, для абонента от которого совершается вызов и для вызываемого канала).
		
		Результат="";
		Попытка
			OriginateНаКаналСПередачейПараметров(Channel, Variable, Результат);			
			СообщитьОтладочнуюИнформацию("Инициирован запрос имени файла записи CDR",Результат);
		Исключение
			СообщитьОтладочнуюИнформацию("Ошибка при запросе имени файла записи CDR ",Результат);
		КонецПопытки;	
		
	КонецЕсли;
	
КонецПроцедуры // ЗапроситьИмяФайлаЗаписиCDRПоИдентификатору()

