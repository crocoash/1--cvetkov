
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	MIKO_Asterisk_Подключена = Метаданные.Обработки.Найти("MIKO_Asterisk")<>Неопределено;
	МИКО_ПанельТелефонииДля1С_Подключена = Метаданные.Обработки.Найти("МИКО_ПанельТелефонииДля1С")<>Неопределено;
	ПанельТелефонииЕсть = (MIKO_Asterisk_Подключена ИЛИ МИКО_ПанельТелефонииДля1С_Подключена);
	Элементы.дПрослушатьЗапись.Видимость	= ПанельТелефонииЕсть;
	Элементы.дСкачатьЗапись.Видимость 		= ПанельТелефонииЕсть;
	Элементы.ОткрытьСобытие.Видимость 		= ПанельТелефонииЕсть;
	Элементы.ДобавитьНомерКонтакту.Видимость= ПанельТелефонииЕсть;
	Элементы.Позвонить.Видимость 			= ПанельТелефонииЕсть;
	
	// Получим системную информацию
	СтруктураДанных = МИКО_стСлужебный.ПолучитьСлужебнуюИнформацию();
	ВерсияПлатформы = СтруктураДанных.ВерсияПлатформы;
	ИспользоватьРежимМодальности = СтруктураДанных.ИспользоватьРежимМодальности;

	Период.Вариант = ВариантСтандартногоПериода.Последние7Дней;
	ВосстановитьНастройки();
	Элементы.представениеПериод.Заголовок = Период;
	
	СформироватьОтчет();

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	ПриЗакрытииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриЗакрытииНаСервере()
    Настройки    = Новый Структура;
	Настройки.Вставить("ОтборДлительность", ОтборДлительность);
	Настройки.Вставить("Период", Период);
    ХранилищеОбщихНастроек.Сохранить("MIKO",  "НеобработанныеВызовы", Настройки, , ИмяПользователя());	
КонецПроцедуры
&НаСервере
Процедура ВосстановитьНастройки()
	Попытка
	СтанцияMyPBX = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.СтанцияMyPBX();
	Исключение
	СтанцияMyPBX = Ложь;
	КонецПопытки; 
	
	СтруктураНастроек = ХранилищеОбщихНастроек.Загрузить("MIKO","НеобработанныеВызовы",,ИмяПользователя());
	Если ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураНастроек);
	КонецЕсли;

КонецПроцедуры
 
