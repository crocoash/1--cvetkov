// Основная команда формы.
// 
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
// Подготовка таблицы пропущенных вызовов.
// 
Процедура СформироватьНаСервере()
	
	врПропущенныеВызовы = Обработки.МИКО_стАнализПропущенныхВызовов.ПолучитьПропущенные(ДатаОтсчета, КлиентаНетВБазе);
	ПропущенныеВызовы.Загрузить(врПропущенныеВызовы);
	НаложитьФильтрНаТаблицуПропущенных();
	
КонецПроцедуры

// Накладываем пользовательские фильтры.
// 
&НаСервере
Процедура НаложитьФильтрНаТаблицуПропущенных()
	
	СтруктураОтбора = Новый Структура();
	
	Если КлиентаНетВБазе Тогда
		СтруктураОтбора.Вставить("КлиентаНетВБазе", КлиентаНетВБазе);
	КонецЕсли;
	Если БезПоследующегоКонтакта Тогда
		СтруктураОтбора.Вставить("КоличествоОтвеченных", 0);
	КонецЕсли;
	Если ЗначениеЗаполнено(НомерТелефона) Тогда
		СтруктураОтбора.Вставить("НомерТелефона", НомерТелефона);
	КонецЕсли;
	
	Элементы.ПропущенныеВызовыОтвеченныйПредставление.Видимость = НЕ БезПоследующегоКонтакта;
	Элементы.ПропущенныеВызовыКлиент.Видимость 					= НЕ КлиентаНетВБазе;
	
	Если СтруктураОтбора.Количество()=0 Тогда
	    Отбор = Неопределено;
	Иначе
		Отбор = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	КонецЕсли; 
	
	Элементы.ПропущенныеВызовы.ОтборСтрок = Отбор;

КонецПроцедуры // НаложитьФильтрНаТаблицуПропущенных()

&НаКлиенте
// Открываем значение, если выбрана строка.
// 
Процедура ОткрытьЗначениеКолонки(ИмяКолонки)

	ТекущиеДанные = Элементы.ПропущенныеВызовы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Если ИмяКолонки = "ПропущенныеВызовыПропущенныйПредставление" Тогда
		унОткрытьЗначение(ТекущиеДанные.СсылкаНаПропущенный);	
	ИначеЕсли ИмяКолонки = "ПропущенныеВызовыОтвеченныйПредставление" Тогда 	
		унОткрытьЗначение(ТекущиеДанные.СсылкаНаОтвеченный);
	ИначеЕсли ИмяКолонки = "ПропущенныеВызовыКлиент" И ЗначениеЗаполнено(ТекущиеДанные.Клиент) Тогда 	
		унОткрытьЗначение(ТекущиеДанные.Клиент);
	КонецЕсли; 

КонецПроцедуры
 
&НаКлиенте
// Открывает значение, выбирает метод в зависимости от версии платформы.
// 
Процедура унОткрытьЗначение(Значение)

	Если ВерсияПлатформы = "8.3" Тогда
	
		Если НЕ ИспользоватьРежимМодальности Тогда
			Попытка
				Выполнить("ПоказатьЗначение(,Значение)");
			Исключение
				Возврат;
			КонецПопытки; 
		Иначе	
			ОткрытьЗначение(Значение);
		КонецЕсли; 

	ИначеЕсли ВерсияПлатформы = "8.2" Тогда
		ОткрытьЗначение(Значение);
	КонецЕсли; 	

КонецПроцедуры

&НаКлиенте
Процедура ПропущенныеВызовыПриАктивизацииСтроки(Элемент)
	УстановитьДоступностьДействий();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьДействий()

	ТекущиеДанные = Элементы.ПропущенныеВызовы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;

	Элементы.ОткрытьПропущенный.Доступность = ЗначениеЗаполнено(ТекущиеДанные.СсылкаНаПропущенный);
	Элементы.ОткрытьОтвеченный.Доступность 	= ЗначениеЗаполнено(ТекущиеДанные.СсылкаНаОтвеченный);
	Элементы.ОткрытьКлиента.Доступность 	= ЗначениеЗаполнено(ТекущиеДанные.Клиент);
	
	Элементы.ПропущенныеВызовыКонтекстноеМенюОткрытьПропущенный.Доступность = ЗначениеЗаполнено(ТекущиеДанные.СсылкаНаПропущенный);
	Элементы.ПропущенныеВызовыКонтекстноеМенюОткрытьОтвеченный.Доступность 	= ЗначениеЗаполнено(ТекущиеДанные.СсылкаНаОтвеченный);
	Элементы.ПропущенныеВызовыКонтекстноеМенюОткрытьКлиента.Доступность 	= ЗначениеЗаполнено(ТекущиеДанные.Клиент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоНомеру(Команда)
	ТекущиеДанные = Элементы.ПропущенныеВызовы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	НомерТелефона = ТекущиеДанные.НомерТелефона;
	НаложитьФильтрНаТаблицуПропущенных();
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

