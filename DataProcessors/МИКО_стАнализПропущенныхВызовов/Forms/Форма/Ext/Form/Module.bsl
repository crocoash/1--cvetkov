// #Область СлужебныеПроцедурыИФункции

&НаСервере 
Перем МТ;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Видимость элементов формы
	MIKO_Asterisk_Подключена = Метаданные.Обработки.Найти("MIKO_Asterisk")<>Неопределено;
	МИКО_ПанельТелефонииДля1С_Подключена = Метаданные.Обработки.Найти("МИКО_ПанельТелефонииДля1С")<>Неопределено;
	ПанельТелефонииЕсть = (MIKO_Asterisk_Подключена ИЛИ МИКО_ПанельТелефонииДля1С_Подключена);
	Элементы.ОткрытьСобытие.Видимость 		= ПанельТелефонииЕсть;
	Элементы.ДобавитьНомерКонтакту.Видимость= ПанельТелефонииЕсть;
	Элементы.Позвонить.Видимость 			= ПанельТелефонииЕсть;
	
	Параметры.Свойство("НомерТелефона", НомерТелефона);
	Параметры.Свойство("Клиент"       , Клиент);
	
	Если Не ЗначениеЗаполнено(НомерТелефона) И
		 Не ЗначениеЗаполнено(Клиент) Тогда
		
		БезПоследующегоКонтакта = Истина;
		
	КонецЕсли;
	
	Если Не Параметры.Свойство("ДатаОтсчета", ДатаОтсчета) Тогда
		
		ДатаОтсчета = НачалоДня(ТекущаяДата() - 60 * 60 * 24 * 3);
		
	КонецЕсли;
	
	// Получим системную информацию
	СтруктураДанных = МИКО_стСлужебный.ПолучитьСлужебнуюИнформацию();
	ВерсияПлатформы = СтруктураДанных.ВерсияПлатформы;
	ИспользоватьРежимМодальности = СтруктураДанных.ИспользоватьРежимМодальности;
	
	СформироватьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОтсчетаПриИзменении(Элемент)
	СформироватьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	НаложитьФильтрНаТаблицуПропущенных();
КонецПроцедуры

&НаКлиенте
// Обработка выбора строки таблицы. Открытие значения.
// 
Процедура ПропущенныеВызовыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОткрытьЗначениеКолонки(Поле.Имя);
	
КонецПроцедуры
