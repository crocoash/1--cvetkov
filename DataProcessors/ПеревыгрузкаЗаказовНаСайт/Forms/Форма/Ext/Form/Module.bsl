// Повторная передача заказов на сайт за период.
//
// Файл заказа кладётся на FTP (каталог orders_1c) тем же кодом, что и обычная
// выгрузка при записи заказа: БИАС.ВыгрузитьЗаказНаСайт. Файлы резервов
// контрагентов при массовой перевыгрузке не формируются - перевыгружаются
// заказы, а не резервы.
//
// Флаг "Только обновление" добавляет в файл атрибут mode="update": сайт обновляет
// свои заказы, но не создаёт новых. Без него заказы, которых на сайте никогда не
// было (заведены в 1С до интеграции или вручную), приехали бы как новые, и
// клиентам ушли бы письма о давно закрытых заказах.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаОкончания = НачалоДня(ТекущаяДата());
	ДатаНачала    = НачалоМесяца(ДатаОкончания);

	ТолькоСНомеромСайта = Истина;
	ТолькоОбновление    = Истина;

КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)

	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Сообщить("Не заполнен период.");
		Возврат;
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		Сообщить("Дата начала больше даты окончания.");
		Возврат;
	КонецЕсли;

	ЗаполнитьНаСервере();

	Сообщить("Подобрано заказов: " + Формат(Заказы.Количество(), "ЧН=0; ЧГ=0") + ".");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателя.Ссылка КАК Заказ,
	|	ЗаказПокупателя.Номер КАК Номер,
	|	ЗаказПокупателя.Дата КАК Дата,
	|	ЗаказПокупателя.НомерЗаказа2ССайта КАК НомерСайта,
	|	ЗаказПокупателя.СтатусЗаказа КАК Статус,
	|	ЗаказПокупателя.Контрагент КАК Контрагент
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ ЗаказПокупателя.ПометкаУдаления
	|	И (&БезОтбораПоСтатусу ИЛИ ЗаказПокупателя.СтатусЗаказа = &СтатусЗаказа)
	|	И (НЕ &ТолькоСНомеромСайта ИЛИ ЗаказПокупателя.НомерЗаказа2ССайта <> """")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Запрос.УстановитьПараметр("ДатаНачала"         , НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания"      , КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("СтатусЗаказа"       , СтатусЗаказа);
	Запрос.УстановитьПараметр("БезОтбораПоСтатусу" , Не ЗначениеЗаполнено(СтатусЗаказа));
	Запрос.УстановитьПараметр("ТолькоСНомеромСайта", ТолькоСНомеромСайта);

	Заказы.Очистить();

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		НоваяСтрока = Заказы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Пометка = Истина;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Отмечать = Истина;

	Для Каждого СтрокаТаблицы Из Заказы Цикл
		Если СтрокаТаблицы.Пометка Тогда
			Отмечать = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из Заказы Цикл
		СтрокаТаблицы.Пометка = Отмечать;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПоставитьВОчередь(Команда)

	Если ТолькоОбновление Тогда
		ПоставитьВОчередьПродолжение();
	Иначе
		ПоказатьВопрос(
			Новый ОписаниеОповещения("ПоставитьВОчередьЗавершение", ЭтотОбъект),
			ТекстВопросаОРежимеСоздания(),
			РежимДиалогаВопрос.НетДа);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоставитьВОчередьЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПоставитьВОчередьПродолжение();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоставитьВОчередьПродолжение()

	Поставлено = ПоставитьВОчередьНаСервере();

	Если Поставлено = 0 Тогда
		Сообщить("Не отмечено ни одного заказа.");
		Возврат;
	КонецЕсли;

	Сообщить("Поставлено в очередь: " + Формат(Поставлено, "ЧН=0; ЧГ=0")
		+ ". Заказы уйдут на сайт регламентным заданием ""Выгрузка заказов на сайт (очередь)"".");

КонецПроцедуры

&НаСервере
Функция ПоставитьВОчередьНаСервере()

	Поставлено = 0;

	Для Каждого СтрокаТаблицы Из Заказы Цикл

		Если Не СтрокаТаблицы.Пометка Или Не ЗначениеЗаполнено(СтрокаТаблицы.Заказ) Тогда
			Продолжить;
		КонецЕсли;

		БИАС.ЗарегистрироватьЗаказКВыгрузкеНаСайт(СтрокаТаблицы.Заказ, ТолькоОбновление);

		СтрокаТаблицы.Результат = ?(ТолькоОбновление, "В очереди (обновление)", "В очереди");
		Поставлено = Поставлено + 1;

	КонецЦикла;

	Возврат Поставлено;

КонецФункции

&НаКлиенте
Процедура ВыгрузитьСейчас(Команда)

	Если ТолькоОбновление Тогда
		ВыгрузитьСейчасПродолжение();
	Иначе
		ПоказатьВопрос(
			Новый ОписаниеОповещения("ВыгрузитьСейчасЗавершение", ЭтотОбъект),
			ТекстВопросаОРежимеСоздания(),
			РежимДиалогаВопрос.НетДа);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьСейчасЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыгрузитьСейчасПродолжение();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьСейчасПродолжение()

	Результат = ВыгрузитьСейчасНаСервере();

	Если ЗначениеЗаполнено(Результат.ОшибкаПодключения) Тогда
		Сообщить("Не удалось подключиться к FTP сайта: " + Результат.ОшибкаПодключения);
		Возврат;
	КонецЕсли;

	Если Результат.Выгружено = 0 И Результат.Ошибок = 0 Тогда
		Сообщить("Не отмечено ни одного заказа.");
		Возврат;
	КонецЕсли;

	Сообщить("Выгружено заказов: " + Формат(Результат.Выгружено, "ЧН=0; ЧГ=0")
		+ ", с ошибками: " + Формат(Результат.Ошибок, "ЧН=0; ЧГ=0") + ".");

КонецПроцедуры

&НаСервере
Функция ВыгрузитьСейчасНаСервере()

	Результат = Новый Структура("Выгружено, Ошибок, ОшибкаПодключения", 0, 0, "");

	ЕстьОтмеченные = Ложь;

	Для Каждого СтрокаТаблицы Из Заказы Цикл
		Если СтрокаТаблицы.Пометка И ЗначениеЗаполнено(СтрокаТаблицы.Заказ) Тогда
			ЕстьОтмеченные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьОтмеченные Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		FTPСоединение = БИАС.ПодключитьсяКFTPЗаказовСайта();
	Исключение
		Результат.ОшибкаПодключения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Для Каждого СтрокаТаблицы Из Заказы Цикл

		Если Не СтрокаТаблицы.Пометка Или Не ЗначениеЗаполнено(СтрокаТаблицы.Заказ) Тогда
			Продолжить;
		КонецЕсли;

		Попытка

			БИАС.ВыгрузитьЗаказНаСайт(СтрокаТаблицы.Заказ, FTPСоединение, Ложь, ТолькоОбновление);
			// Если заказ ждал в очереди, повторять его уже не нужно.
			БИАС.УдалитьЗаказИзОчередиВыгрузкиНаСайт(СтрокаТаблицы.Заказ);

			СтрокаТаблицы.Результат = "Выгружен";
			Результат.Выгружено = Результат.Выгружено + 1;

		Исключение

			СтрокаТаблицы.Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Результат.Ошибок = Результат.Ошибок + 1;

			ЗаписьЖурналаРегистрации(
				"ВыгрузкаЗаказовНаСайт",
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Документы.ЗаказПокупателя,
				СтрокаТаблицы.Заказ,
				"Перевыгрузка заказа не удалась: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ТекстВопросаОРежимеСоздания()

	Возврат "Снят флаг ""Только обновление"": заказы, которых нет на сайте, будут созданы там заново,
		|и клиентам могут уйти письма о давно закрытых заказах.
		|
		|Продолжить?";

КонецФункции

&НаКлиенте
Процедура ЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.Заказы.ТекущиеДанные;

	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Заказ) Тогда
		ОткрытьЗначение(ТекущиеДанные.Заказ);
	КонецЕсли;

КонецПроцедуры
