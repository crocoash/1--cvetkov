	Если ТипЗнч(ВладелецФормы) = Тип("ПолеВвода") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		//Если ЗначениеЗаполнено(Элемент.ТекущиеДанные.Клиент) Тогда
		//	
		//	Закрыть(Элемент.ТекущиеДанные.Клиент);
		//	
		//ИначеЕсли ЗначениеЗаполнено(Элемент.ТекущиеДанные.Контакт) Тогда
		//	
		//	Закрыть(Элемент.ТекущиеДанные.Контакт);
		//	
		//КонецЕсли;
		
		Закрыть(ПолучитьМассивКлиентов());
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивКлиентов()
	
	ТЗКлиентов = ТаблицаКлиентов.Выгрузить(, "Клиент");
	
	ТЗКлиентов.Свернуть("Клиент");
	
	Возврат ТЗКлиентов.ВыгрузитьКолонку("Клиент");
	
КонецФункции

#КонецОбласти
