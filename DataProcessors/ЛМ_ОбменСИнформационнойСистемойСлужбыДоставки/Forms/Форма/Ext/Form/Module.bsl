&НаСервере
Процедура ВосстановитьСохраненныеЗначенияСервер()
	СтруктураНастройки = Константы.ЛМ_НастройкиЗаполненияЭкспрессНакладнойПоУмолчанию.Получить().Получить();
	Если ТипЗнч(СтруктураНастройки) = Тип("Структура") Тогда
		Если СтруктураНастройки.Свойство("Отправитель") Тогда
			ОтправительПоУмолчанию = СтруктураНастройки.Отправитель;
		КонецЕсли;	
		Если СтруктураНастройки.Свойство("КонтактноеЛицоОтправителя") Тогда
			КонтактноеЛицоОтправителяПоУмолчанию = СтруктураНастройки.КонтактноеЛицоОтправителя;
		КонецЕсли;	
		Если СтруктураНастройки.Свойство("СкладОтправителя") Тогда
			СкладОтправителяПоУмолчанию = СтруктураНастройки.СкладОтправителя;
		КонецЕсли;	
		Если СтруктураНастройки.Свойство("АдресОтправителя") Тогда
			АдресОтправителяПоУмолчанию = СтруктураНастройки.АдресОтправителя;
		КонецЕсли;	
		Если СтруктураНастройки.Свойство("ТехнологияДоставки") Тогда
			ТехнологияДоставкиПоУмолчанию = СтруктураНастройки.ТехнологияДоставки;
		КонецЕсли;	
		Если СтруктураНастройки.Свойство("ТипГруза") Тогда
			ТипГрузаПоУмолчанию = СтруктураНастройки.ТипГруза;
		КонецЕсли;	
		Если СтруктураНастройки.Свойство("ОписаниеГруза") Тогда
			ОписаниеГрузаПоУмолчанию = СтруктураНастройки.ОписаниеГруза;
		КонецЕсли;	
		Если СтруктураНастройки.Свойство("ФормаОплаты") Тогда
			ФормаОплатыПоУмолчанию = СтруктураНастройки.ФормаОплаты;
		КонецЕсли;	
		Если СтруктураНастройки.Свойство("ПлательщикДоставки") Тогда
			ПлательщикДоставкиПоУмолчанию = СтруктураНастройки.ПлательщикДоставки;
		КонецЕсли;	
		Если СтруктураНастройки.Свойство("ВидОбратнойДоставки") Тогда
			ВидОбратнойДоставкиПоУмолчанию = СтруктураНастройки.ВидОбратнойДоставки;
		КонецЕсли;	
		Если СтруктураНастройки.Свойство("ПлательщикОбратнойДоставки") Тогда
			ПлательщикОбратнойДоставкиПоУмолчанию = СтруктураНастройки.ПлательщикОбратнойДоставки;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

