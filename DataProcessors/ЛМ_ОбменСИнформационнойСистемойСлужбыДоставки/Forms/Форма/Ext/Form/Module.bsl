Функция ГородОтправителя()
	Если ЗначениеЗаполнено(ОтправительПоУмолчанию.Город) Тогда
		Возврат ОтправительПоУмолчанию.Город;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции 	

&НаКлиенте
Процедура СкладОтправителяПоУмолчаниюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ГородОтправителя = ГородОтправителя();
	Если НЕ ГородОтправителя = Неопределено ТОгда
		СтандартнаяОбработка = Ложь;
		Форма_ = ПолучитьФорму("Справочник.ЛМ_Отделения.Форма.ФормаВыбора",,Элемент);
		Эл = Форма_.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Эл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
		Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Эл.правоеЗначение = ГородОтправителя;
		Эл.Использование = Истина;
		Форма_.Открыть();
	КонецЕсли;
КонецПроцедуры

