	СтруктураНастройки.Вставить("Отправитель", ОтправительПоУмолчанию);
	СтруктураНастройки.Вставить("КонтактноеЛицоОтправителя", КонтактноеЛицоОтправителяПоУмолчанию);
	СтруктураНастройки.Вставить("СкладОтправителя", СкладОтправителяПоУмолчанию);
	СтруктураНастройки.Вставить("АдресОтправителя", АдресОтправителяПоУмолчанию);
	СтруктураНастройки.Вставить("ТехнологияДоставки", ТехнологияДоставкиПоУмолчанию);
	СтруктураНастройки.Вставить("ТипГруза", ТипГрузаПоУмолчанию);
	СтруктураНастройки.Вставить("ОписаниеГруза", ОписаниеГрузаПоУмолчанию);
	СтруктураНастройки.Вставить("ФормаОплаты", ФормаОплатыПоУмолчанию);
	СтруктураНастройки.Вставить("ПлательщикДоставки", ПлательщикДоставкиПоУмолчанию);
	СтруктураНастройки.Вставить("ВидОбратнойДоставки", ВидОбратнойДоставкиПоУмолчанию);
	СтруктураНастройки.Вставить("ПлательщикОбратнойДоставки", ПлательщикОбратнойДоставкиПоУмолчанию);
	Константы.ЛМ_НастройкиЗаполненияЭкспрессНакладнойПоУмолчанию.Установить(Новый ХранилищеЗначения(СтруктураНастройки));
