	//|	ЛМ_ВидыОбратнойДоставки.Ссылка
	//|ИЗ
	//|	Справочник.ЛМ_ВидыОбратнойДоставки КАК ЛМ_ВидыОбратнойДоставки
	//|ГДЕ
	//|	НЕ ЛМ_ВидыОбратнойДоставки.Ссылка В (&Ссылка)
	//|	И НЕ ЛМ_ВидыОбратнойДоставки.ПометкаУдаления";
	//Запрос.УстановитьПараметр("Ссылка", ВидыОбратнойДоставки.ВыгрузитьКолонку("ВидОбратнойДоставки"));
	//Выборка = Запрос.Выполнить().Выбрать();
