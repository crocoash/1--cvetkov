Перем ХТТПСоединение;
// Ложь означает: список отделений от Новой Почты в этом прогоне заведомо неполный,
// и помечать "отсутствующие" по нему нельзя - пометка ляжет на живые отделения.
Перем МожноПометитьОтсутствующиеОтделения Экспорт;

Процедура  ИнициализироватьСоединение()
	Если ХТТПСоединение = Неопределено Тогда
		ssl = Новый ЗащищенноеСоединениеOpenSSL;
		ХТТПСоединение = Новый HTTPСоединение("api.novaposhta.ua",,,,,,ssl);
	КонецЕсли;
КонецПроцедуры


Процедура ПолучитьТаблицуВидовОбратнойДоставки() Экспорт
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("apiKey", КлючAPI);
	СтруктураЗапроса.Вставить("modelName", "Common");
	СтруктураЗапроса.Вставить("calledMethod", "getBackwardDeliveryCargoTypes");
	СтруктураЗапроса.Вставить("methodProperties", Новый Структура);
	Если Константы.ЛМ_ЯзыкИнтерфейсаОбмена.Получить() = Перечисления.ЛМ_ЯзыкиИнтерфейсаОбмена.Украинский Тогда
		СтруктураЗапроса.Вставить("language", "ua");
	Иначе
		СтруктураЗапроса.Вставить("language", "ru");
	КонецЕсли;
	ДеревоОтвета = ОтправитьЗапрос(СтруктураЗапроса);
	
	ТаблЭлементов = ПолучитьТаблицуЭлементовПоДереву(ДеревоОтвета);
	Если ТаблЭлементов.Колонки.Найти("Description") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Description.Имя = "Наименование";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("Ref") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Ref.Имя = "ГУИД";
	КонецЕсли;	
	СтрокаКонтроляОплаты = ТаблЭлементов.Добавить();
	СтрокаКонтроляОплаты.Наименование = "КонтрольОплаты";
	СтрокаКонтроляОплаты.ГУИД = "КонтрольОплаты";
	
    ВидыОбратнойДоставки.Загрузить(ТаблЭлементов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_ВидыОбратнойДоставки.Ссылка,
	|	ЛМ_ВидыОбратнойДоставки.ГУИД
	|ИЗ
	|	Справочник.ЛМ_ВидыОбратнойДоставки КАК ЛМ_ВидыОбратнойДоставки";
	Табл = Запрос.Выполнить().Выгрузить();
	Для Каждого ТекСтр Из ВидыОбратнойДоставки Цикл
		Если ЗначениеЗаполнено(ТекСтр.ГУИД) Тогда
			СтрокаТабл = Табл.Найти(ТекСтр.ГУИД, "ГУИД");
			Если СтрокаТабл <> Неопределено Тогда
				ТекСтр.ВидОбратнойДоставки = СтрокаТабл.Ссылка;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

Функция СохранитьВидыОбратнойДоставки() Экспорт
