	|	И НЕ ЛМ_КонтактныеЛица.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка", КонтактныеЛица.ВыгрузитьКолонку("КонтактноеЛицо"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Об = Выборка.Ссылка.ПолучитьОбъект();
