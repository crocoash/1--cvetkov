Процедура ЗаписатьХМЛЗапроса(Запись, СтруктураЗапроса)
	
	Для каждого ТекКлючЗначение Из СтруктураЗапроса Цикл
		Запись.ЗаписатьНачалоЭлемента(ТекКлючЗначение.Ключ);
		Если ТипЗнч(ТекКлючЗначение.Значение) = Тип("Структура") Тогда
			ЗаписатьХМЛЗапроса(Запись, ТекКлючЗначение.Значение);
		Иначе	
			Запись.ЗаписатьТекст(ТекКлючЗначение.Значение);
		КонецЕсли;	
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;	
	
КонецПроцедуры	

Функция ОтправитьЗапрос(СтруктураЗапроса)
	
	Запись = Новый ЗаписьXML;
	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла("xml");
	ИмяФайлаОтвета = ПолучитьИмяВременногоФайла("xml");
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("utf-8", , Ложь);
	Запись.ОткрытьФайл(ИмяФайлаЗапроса, ПараметрыЗаписиXML);
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("file");
	ЗаписатьХМЛЗапроса(Запись, СтруктураЗапроса);
	Запись.ЗаписатьКонецЭлемента();
	Запись.Закрыть();
	ИнициализироватьСоединение();
	ХТТПЗапрос = Новый HTTPЗапрос("/v2.0/xml/");
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "text/xml");
	ХТТПЗапрос.УстановитьИмяФайлаТела(ИмяФайлаЗапроса);
	ХТТПЗапрос.Заголовки = Заголовки;
	Ответ = ХТТПСоединение.ОтправитьДляОбработки(ХТТПЗапрос, ИмяФайлаОтвета);
	Если Ответ.КодСостояния = 200 Тогда
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ИмяФайлаОтвета);
		ДеревоОтвета = ___обРазобратьXML(Чтение);
		Чтение.Закрыть();
		Возврат ДеревоОтвета;
	КонецЕсли;

	// В регламенте отказ API иначе не виден вообще: форма показала бы пустую таблицу,
	// фоновое задание не показывает и её.
	ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
		УровеньЖурналаРегистрации.Ошибка, , ,
		"Новая Почта ответила кодом " + Ответ.КодСостояния
		+ " на метод " + СтруктураЗапроса.calledMethod);
	Возврат Неопределено;

КонецФункции

Функция ___обРазобратьXML(Ч)
	
	Дерево = Новый ДеревоЗначений();
	Дерево.Колонки.Добавить("Тег");
	Дерево.Колонки.Добавить("Тело");
	ТекСтроки = Дерево.Строки;
	___обРазобратьXMLСлуж(Ч, ТекСтроки, Неопределено);	
	
	Возврат Дерево;
КонецФункции

Функция ПолучитьТаблицуЭлементовПоДереву(ДеревоОтвета)
	Табл = Новый ТаблицаЗначений;
	// ОтправитьЗапрос возвращает Неопределено на любом ответе, кроме 200. Без этой проверки
	// обращение к .Строки роняло всю загрузку с невнятным "Значение не является значением
	// объектного типа" вместо того, чтобы просто вернуть пустую таблицу.
	Если ДеревоОтвета = Неопределено Тогда
		Возврат Табл;
	КонецЕсли;
	Для Каждого ТекСтрока из ДеревоОтвета.Строки Цикл
		Если ТекСтрока.Тег = "root" тогда
			Для Каждого ТекСтрока1 Из ТекСтрока.Строки цикл
				Если ТекСтрока1.Тег = "success" Тогда
					Если НЕ ТекСтрока1.Тело = "true" Тогда
						Возврат Табл;
					КонецЕсли; 	
				ИначеЕсли ТекСтрока1.Тег = "data" Тогда
					Для Каждого ТекСтрока2 Из ТекСтрока1.Строки Цикл
						Если ТекСтрока2.Тег = "item" Тогда
							СтрТабл = Табл.Добавить();
							Для каждого ТекСтрока3 Из ТекСтрока2.Строки цикл
								Если Табл.Колонки.Найти(ТекСтрока3.Тег) = Неопределено Тогда
									Табл.Колонки.Добавить(ТекСтрока3.Тег);
								КонецЕсли;	
								СтрТабл[ТекСтрока3.Тег] = ТекСтрока3.Тело;
							КонецЦикла;
						КонецЕсли;	
					КонецЦикла;	
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;		
	КонецЦикла;	
	Возврат Табл;
КонецФункции	
//Служебная функция для разбора XML в дерево
Функция ___обРазобратьXMLСлуж(Ч, ТекСтроки, Знач ТекСтрока)
	Атрибуты = Новый Структура();
	Пока Ч.Прочитать() Цикл
		Если Ч.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ТекСтрока = ТекСтроки.Добавить();
			ТекСтрока.Тег = Ч.Имя;
			___обРазобратьXMLСлуж(Ч, ТекСтрока.Строки, ТекСтрока);
		ИначеЕсли Ч.ТипУзла = ТипУзлаXML.Текст Тогда
			ТекСтрока.Тело = Ч.Значение;
		ИначеЕсли Ч.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции


