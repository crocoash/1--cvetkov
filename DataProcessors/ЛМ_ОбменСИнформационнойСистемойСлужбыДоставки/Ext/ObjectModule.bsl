	Если Области.Количество() = 0 ТОгда
		Возврат ЛОЖЬ;
	КонецЕсли;	
	Для Каждого ТекСтр Из Области Цикл
		Если ЗначениеЗаполнено(ТекСтр.Область) тогда
			Если ТекСтр.Область.ГУИД = ТекСтр.ГУИД И ТекСтр.Область.Наименование = ТекСтр.Наименование И ТекСтр.Область.ОбластнойЦентр = ТекСтр.ОбластнойЦентр Тогда
				Продолжить;
			Иначе
				Об = ТекСтр.Область.ПолучитьОбъект();
				Об.Наименование = ТекСтр.Наименование;
				Об.ГУИД = ТекСтр.ГУИД;
				Об.ОбластнойЦентр = ТекСтр.ОбластнойЦентр;
				Об.Записать();
			КонецЕсли;
		Иначе
			Об = Справочники.ЛМ_Области.СоздатьЭлемент();
			Об.Наименование = ТекСтр.Наименование;
			Об.ГУИД = ТекСтр.ГУИД;
			Об.ОбластнойЦентр = ТекСтр.ОбластнойЦентр;
			Об.Записать();
			ТекСтр.Область = Об.Ссылка;
		КонецЕсли;	
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_Области.Ссылка
	|ИЗ
	|	Справочник.ЛМ_Области КАК ЛМ_Области
	|ГДЕ
	|	НЕ ЛМ_Области.Ссылка В (&Ссылка)
	|	И НЕ ЛМ_Области.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка", Области.ВыгрузитьКолонку("Область"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Об.ПометкаУдаления = Истина;
		Об.Записать();
	КонецЦикла;	
	Возврат Истина;
КонецФункции	

Процедура ПолучитьТаблицуГородов() Экспорт
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("apiKey", КлючAPI);
	СтруктураЗапроса.Вставить("modelName", "Address");
	СтруктураЗапроса.Вставить("calledMethod", "getCities");
	СтруктураЗапроса.Вставить("methodProperties", Новый Структура);
	Если Константы.ЛМ_ЯзыкИнтерфейсаОбмена.Получить() = Перечисления.ЛМ_ЯзыкиИнтерфейсаОбмена.Украинский Тогда
		СтруктураЗапроса.Вставить("language", "ua");
	Иначе
		СтруктураЗапроса.Вставить("language", "ru");
	КонецЕсли;
	ДеревоОтвета = ОтправитьЗапрос(СтруктураЗапроса);
	
	ТаблЭлементов = ПолучитьТаблицуЭлементовПоДереву(ДеревоОтвета);
	Если ТаблЭлементов.Колонки.Найти("Description") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Description.Имя = "Наименование";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("DescriptionRu") <> Неопределено Тогда
		ТаблЭлементов.Колонки.DescriptionRu.Имя = "НаименованиеРусское";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("Ref") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Ref.Имя = "ГУИД";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("Area") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Area.Имя = "ГУИДОбласти";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("Delivery1") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Delivery1.Имя = "ДоставкаВПонедельник";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("Delivery2") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Delivery2.Имя = "ДоставкаВоВторник";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("Delivery3") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Delivery3.Имя = "ДоставкаВСреду";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("Delivery4") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Delivery4.Имя = "ДоставкаВЧетверг";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("Delivery5") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Delivery5.Имя = "ДоставкаВПятницу";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("Delivery6") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Delivery6.Имя = "ДоставкаВСубботу";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("Delivery7") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Delivery7.Имя = "ДоставкаВВоскресенье";
	КонецЕсли;	
	
	Для Каждого ТекСТр Из ТаблЭлементов Цикл
		ТекСТр.ДоставкаВПонедельник = ТекСТр.ДоставкаВПонедельник = "1";
		ТекСТр.ДоставкаВоВторник = ТекСТр.ДоставкаВоВторник = "1";
		ТекСТр.ДоставкаВСреду = ТекСТр.ДоставкаВСреду = "1";
		ТекСТр.ДоставкаВЧетверг = ТекСТр.ДоставкаВЧетверг = "1";
		ТекСТр.ДоставкаВПятницу = ТекСТр.ДоставкаВПятницу = "1";
		ТекСТр.ДоставкаВСубботу = ТекСТр.ДоставкаВСубботу = "1";
		ТекСТр.ДоставкаВВоскресенье = ТекСТр.ДоставкаВВоскресенье = "1";
	КонецЦикла;	
	
	Города.Загрузить(ТаблЭлементов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_Области.Ссылка,
	|	ЛМ_Области.ГУИД
	|ИЗ
	|	Справочник.ЛМ_Области КАК ЛМ_Области";
	КартаОбластей = КартаГУИДов(Запрос.Выполнить().Выгрузить());

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЛМ_Города.Ссылка,
	|	ЛМ_Города.ГУИД
	|ИЗ
	|	Справочник.ЛМ_Города КАК ЛМ_Города";
	КартаГородов = КартаГУИДов(Запрос.Выполнить().Выгрузить());


	Для Каждого ТекСтр Из Города Цикл
		Если ЗначениеЗаполнено(ТекСтр.ГУИД) Тогда
			СсылкаГорода = КартаГородов.Получить(ТекСтр.ГУИД);
			Если СсылкаГорода <> Неопределено Тогда
				ТекСтр.Город = СсылкаГорода;
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(ТекСтр.ГУИДОбласти) Тогда
			СсылкаОбласти = КартаОбластей.Получить(ТекСтр.ГУИДОбласти);
			Если СсылкаОбласти <> Неопределено Тогда
				ТекСтр.Область = СсылкаОбласти;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция СохранитьГорода() Экспорт
	Если Города.Количество() = 0 ТОгда
		Возврат ЛОЖЬ;
	КонецЕсли;	
	// Пометка удаления в сравнении и снятие её при обновлении - по той же причине, что и у
	// отделений: город, пришедший в ответе Новой Почты, живой. Ниже по тексту города, которых
	// в ответе нет, наоборот помечаются, так что цикл работает в обе стороны.
	Для Каждого ТекСтр Из Города Цикл
		Если ЗначениеЗаполнено(ТекСтр.Город) тогда
			Если ТекСтр.Город.ГУИД = ТекСтр.ГУИД И ТекСтр.Город.Наименование = ТекСтр.Наименование И ТекСтр.Город.НаименованиеРусское = ТекСтр.НаименованиеРусское И ТекСтр.Город.Область = ТекСтр.Область
				И ТекСтр.Город.ДоставкаВПонедельник = ТекСтр.ДоставкаВПонедельник И ТекСтр.Город.ДоставкаВоВторник = ТекСтр.ДоставкаВоВторник
				И ТекСтр.Город.ДоставкаВСреду = ТекСтр.ДоставкаВСреду И ТекСтр.Город.ДоставкаВЧетверг = ТекСтр.ДоставкаВЧетверг 
				И ТекСтр.Город.ДоставкаВПятницу = ТекСтр.ДоставкаВПятницу И ТекСтр.Город.ДоставкаВСубботу = ТекСтр.ДоставкаВСубботу
				И ТекСтр.Город.ДоставкаВВоскресенье = ТекСтр.ДоставкаВВоскресенье
				И НЕ ТекСтр.Город.ПометкаУдаления
				Тогда
				Продолжить;
			Иначе
				Об = ТекСтр.Город.ПолучитьОбъект();
				Об.Наименование = ТекСтр.Наименование;
				Об.НаименованиеРусское = ТекСтр.НаименованиеРусское;
				Об.ГУИД = ТекСтр.ГУИД;
				Об.Область = ТекСтр.Область;
				Об.ДоставкаВПонедельник = ТекСтр.ДоставкаВПонедельник;
				Об.ДоставкаВоВторник = ТекСтр.ДоставкаВоВторник;
				Об.ДоставкаВСреду = ТекСтр.ДоставкаВСреду;
				Об.ДоставкаВЧетверг = ТекСтр.ДоставкаВЧетверг;
				Об.ДоставкаВПятницу = ТекСтр.ДоставкаВПятницу;
				Об.ДоставкаВСубботу = ТекСтр.ДоставкаВСубботу;
				Об.ДоставкаВВоскресенье = ТекСтр.ДоставкаВВоскресенье;
				Об.ПометкаУдаления = Ложь;
				Об.Записать();
			КонецЕсли;
		Иначе
			Об = Справочники.ЛМ_Города.СоздатьЭлемент();
			Об.Наименование = ТекСтр.Наименование;
			Об.НаименованиеРусское = ТекСтр.НаименованиеРусское;
			Об.ГУИД = ТекСтр.ГУИД;
			Об.Область = ТекСтр.Область;
			Об.ДоставкаВПонедельник = ТекСтр.ДоставкаВПонедельник;
			Об.ДоставкаВоВторник = ТекСтр.ДоставкаВоВторник;
			Об.ДоставкаВСреду = ТекСтр.ДоставкаВСреду;
			Об.ДоставкаВЧетверг = ТекСтр.ДоставкаВЧетверг;
			Об.ДоставкаВПятницу = ТекСтр.ДоставкаВПятницу;
			Об.ДоставкаВСубботу = ТекСтр.ДоставкаВСубботу;
			Об.ДоставкаВВоскресенье = ТекСтр.ДоставкаВВоскресенье;
			Об.Записать();
			ТекСтр.Город = Об.Ссылка;
		КонецЕсли;	
	КонецЦикла;
	ПометитьОтсутствующие("ЛМ_Города", Города.Выгрузить( , "Город"), "Город");
	Возврат Истина;
КонецФункции

// Строит соответствие ГУИД -> Ссылка по таблице с этими двумя колонками.
//
// ЗАЧЕМ. Сопоставление шло через ТаблицаЗначений.Найти в цикле по всем строкам: на отделениях
// это 61 тысяча поисков по таблице в 61 тысячу строк - порядка четырёх миллиардов сравнений,
// то есть загрузка не заканчивалась в разумное время даже после получения данных.
Функция КартаГУИДов(Табл)

	Карта = Новый Соответствие;
	Для Каждого ТекСтр Из Табл Цикл
		Если ЗначениеЗаполнено(ТекСтр.ГУИД) Тогда
			Карта.Вставить(ТекСтр.ГУИД, ТекСтр.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Карта;

КонецФункции

// Помечает на удаление элементы справочника, которых нет в полученном от Новой Почты списке.
// ТаблицаСсылок - выгрузка колонки ТЧ со ссылками на уже сопоставленные элементы.
// Возвращает число помеченных или -1, если пометка пропущена по порогу.
//
// ЗАЧЕМ временная таблица, а не "НЕ Ссылка В (&Ссылка)". Список здесь - десятки тысяч
// ссылок, таким параметром СУБД давится; на городах это ещё как-то проходило, на
// шестидесяти тысячах отделений - уже нет.
//
// ЗАЧЕМ порог. Частичный ответ API (обрыв связи, лимит запросов) выглядит для этого кода
// как "всё остальное удалено". Один такой прогон похоронил бы справочник целиком, а снять
// пометку обратно некому, пока Новая Почта снова не пришлёт этот элемент.
Функция ПометитьОтсутствующие(ИмяСправочника, ТаблицаСсылок, ИмяКолонки)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Полученные.@Колонка КАК Ссылка
	|ПОМЕСТИТЬ ВтПолученные
	|ИЗ
	|	&Полученные КАК Полученные
	|ГДЕ
	|	Полученные.@Колонка <> ЗНАЧЕНИЕ(Справочник.@Справочник.ПустаяСсылка)
	|;
	|
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Спр.Ссылка) КАК Живых
	|ИЗ
	|	Справочник.@Справочник КАК Спр
	|ГДЕ
	|	НЕ Спр.ПометкаУдаления
	|;
	|
	|ВЫБРАТЬ
	|	Спр.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.@Справочник КАК Спр
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВтПолученные КАК ВтПолученные
	|		ПО Спр.Ссылка = ВтПолученные.Ссылка
	|ГДЕ
	|	ВтПолученные.Ссылка ЕСТЬ NULL
	|	И НЕ Спр.ПометкаУдаления";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "@Справочник", ИмяСправочника);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "@Колонка", ИмяКолонки);
	Запрос.УстановитьПараметр("Полученные", ТаблицаСсылок);
	Результаты = Запрос.ВыполнитьПакет();

	ВыборкаЖивых = Результаты[1].Выбрать();
	ВыборкаЖивых.Следующий();
	Живых = ВыборкаЖивых.Живых;

	Если Живых > 0 И ТаблицаСсылок.Количество() < Живых * 0.8 Тогда
		ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			ИмяСправочника + ": получено " + ТаблицаСсылок.Количество()
			+ " при " + Живых + " живых в базе - пометка удаления пропущена как подозрительная");
		Возврат -1;
	КонецЕсли;

	Помечено = 0;
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Об.ПометкаУдаления = Истина;
		Об.Записать();
		Помечено = Помечено + 1;
	КонецЦикла;

	Если Помечено > 0 Тогда
		ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
			УровеньЖурналаРегистрации.Информация, , ,
			ИмяСправочника + ": помечено на удаление " + Помечено);
	КонецЕсли;

	Возврат Помечено;

КонецФункции

Процедура ПереименоватьКолонку(Табл, ИмяВОтвете, ИмяВБазе)

	Если Табл.Колонки.Найти(ИмяВОтвете) <> Неопределено
		И Табл.Колонки.Найти(ИмяВБазе) = Неопределено Тогда
		Табл.Колонки[ИмяВОтвете].Имя = ИмяВБазе;
	КонецЕсли;

КонецПроцедуры

// Один вызов Address.getWarehouses с готовыми к загрузке в ТЧ именами колонок.
Функция ЗапроситьОтделения(СвойстваМетода)

	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("apiKey", КлючAPI);
	СтруктураЗапроса.Вставить("modelName", "Address");
	СтруктураЗапроса.Вставить("calledMethod", "getWarehouses");
	СтруктураЗапроса.Вставить("methodProperties", СвойстваМетода);
	Если Константы.ЛМ_ЯзыкИнтерфейсаОбмена.Получить() = Перечисления.ЛМ_ЯзыкиИнтерфейсаОбмена.Украинский Тогда
		СтруктураЗапроса.Вставить("language", "ua");
	Иначе
		СтруктураЗапроса.Вставить("language", "ru");
	КонецЕсли;

	ТаблЭлементов = ПолучитьТаблицуЭлементовПоДереву(ОтправитьЗапрос(СтруктураЗапроса));
	ПереименоватьКолонку(ТаблЭлементов, "Description", "Наименование");
	ПереименоватьКолонку(ТаблЭлементов, "DescriptionRu", "НаименованиеРусское");
	ПереименоватьКолонку(ТаблЭлементов, "Ref", "ГУИД");
	ПереименоватьКолонку(ТаблЭлементов, "Longitude", "Долгота");
	ПереименоватьКолонку(ТаблЭлементов, "Latitude", "Широта");
	ПереименоватьКолонку(ТаблЭлементов, "Number", "Номер");

	Возврат ТаблЭлементов;

КонецФункции

// Сколько отделений у Новой Почты всего (тег info/totalCount в ответе getWarehouses).
// Нужно, чтобы отличить конец списка от пустой страницы посреди выборки. Возвращает 0,
// если счётчик получить не удалось - тогда обход работает по старым признакам конца.
Функция ЗапроситьВсегоОтделений()

	СвойстваМетода = Новый Структура;
	СвойстваМетода.Вставить("Page", "1");
	СвойстваМетода.Вставить("Limit", "1");

	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("apiKey", КлючAPI);
	СтруктураЗапроса.Вставить("modelName", "Address");
	СтруктураЗапроса.Вставить("calledMethod", "getWarehouses");
	СтруктураЗапроса.Вставить("methodProperties", СвойстваМетода);

	ДеревоОтвета = ОтправитьЗапрос(СтруктураЗапроса);
	Если ДеревоОтвета = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Для Каждого ТекСтрока Из ДеревоОтвета.Строки Цикл
		Если ТекСтрока.Тег <> "root" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ТекСтрока1 Из ТекСтрока.Строки Цикл
			Если ТекСтрока1.Тег <> "info" Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ТекСтрока2 Из ТекСтрока1.Строки Цикл
				Если ТекСтрока2.Тег = "totalCount" Тогда
					Попытка
						Возврат Число(СокрЛП(ТекСтрока2.Тело));
					Исключение
						Возврат 0;
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Возврат 0;

КонецФункции

// Отделения страницами общего списка. Возвращает Ложь, если постраничный режим не сработал.
//
// ЗАЧЕМ. Раньше на каждый город шёл свой запрос getWarehouses с CityRef. Городов в базе
// больше десяти тысяч, то есть один прогон - это десять тысяч обращений к API Новой Почты
// и часы работы; регламентом такое не запустишь, и оно не запускалось. Тот же объём
// (шестьдесят с лишним тысяч отделений) страницами по 500 укладывается в полторы сотни
// запросов. Город берётся из поля CityRef самого отделения.
Функция ЗаполнитьОтделенияСтраницами(КартаГородов)

	РазмерСтраницы = 500;
	ПредыдущийПервыйГУИД = "";
	БезГорода = 0;
	Получено = 0;

	// Сколько отделений обещает сама Новая Почта. Без этого числа конец списка не отличить
	// от сбоя: см. ниже про пустую страницу.
	ВсегоУНП = ЗапроситьВсегоОтделений();

	Для Страница = 1 По 400 Цикл

		СвойстваМетода = Новый Структура;
		СвойстваМетода.Вставить("Page", Формат(Страница, "ЧГ=0"));
		СвойстваМетода.Вставить("Limit", Формат(РазмерСтраницы, "ЧГ=0"));
		ТаблЭлементов = ЗапроситьОтделения(СвойстваМетода);

		// Пустую страницу посреди списка Новая Почта отдаёт и просто так. Раньше загрузчик
		// принимал её за конец и уходил с неполной выборкой - в журнале это "ЛМ_Отделения:
		// получено 1 000 при 41 198 живых в базе". Пока по счётчику отделения не выбраны,
		// повторяем ту же страницу, а не верим первой пустоте.
		Попыток = 0;
		Пока ТаблЭлементов.Количество() = 0 И Получено < ВсегоУНП И Попыток < 3 Цикл
			Попыток = Попыток + 1;
			ТаблЭлементов = ЗапроситьОтделения(СвойстваМетода);
		КонецЦикла;

		Если ТаблЭлементов.Количество() = 0 Тогда
			// Пустая первая страница - постраничный режим не принят, уходим на путь по городам.
			// Пустая следующая - конец списка либо отказ, который повторы не пробили.
			Если Страница = 1 Тогда
				Возврат Ложь;
			КонецЕсли;
			Прервать;
		КонецЕсли;

		Если ТаблЭлементов.Колонки.Найти("ГУИД") = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		// Страховка от API, которое проигнорировало Page и отдаёт одну и ту же страницу:
		// иначе цикл крутится до упора и набивает ТЧ дублями.
		Если ТаблЭлементов[0].ГУИД = ПредыдущийПервыйГУИД Тогда
			Возврат Ложь;
		КонецЕсли;
		ПредыдущийПервыйГУИД = ТаблЭлементов[0].ГУИД;

		ЕстьCityRef = ТаблЭлементов.Колонки.Найти("CityRef") <> Неопределено;
		Если НЕ ЕстьCityRef Тогда
			Возврат Ложь;
		КонецЕсли;

		Получено = Получено + ТаблЭлементов.Количество();

		Для Каждого ТекСтр Из ТаблЭлементов Цикл
			СсылкаГорода = КартаГородов.Получить(ТекСтр.CityRef);
			Если СсылкаГорода = Неопределено Тогда
				// Города нет в справочнике - класть отделение некуда: ЛМ_Отделения подчинены
				// городу, и элемент с пустым владельцем в выборе заказа только мешает.
				БезГорода = БезГорода + 1;
				Продолжить;
			КонецЕсли;
			СтрокаОтделения = Отделения.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОтделения, ТекСтр);
			СтрокаОтделения.Город = СсылкаГорода;
		КонецЦикла;

		// Неполная страница тоже бывает в середине списка, поэтому конец определяем по
		// счётчику Новой Почты, и лишь без него - по-старому, по неполной странице.
		Если ВсегоУНП > 0 Тогда
			Если Получено >= ВсегоУНП Тогда
				Прервать;
			КонецЕсли;
		ИначеЕсли ТаблЭлементов.Количество() < РазмерСтраницы Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если БезГорода > 0 Тогда
		ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Пропущено отделений с неизвестным городом: " + БезГорода);
	КонецЕсли;

	// Неполную выборку принимаем (обновить то, что пришло, полезно), но помечать по ней
	// отсутствующие нельзя: пометка ляжет на живые отделения, которые просто не доехали.
	Если ВсегоУНП > 0 И Получено < ВсегоУНП Тогда
		МожноПометитьОтсутствующиеОтделения = Ложь;
		ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Отделения получены не полностью: " + Получено + " из " + ВсегоУНП
			+ " - пометка отсутствующих пропущена");
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Запасной путь: по одному запросу на город. Медленно, но проверено годами.
Процедура ЗаполнитьОтделенияПоГородам(КартаГородов)

	НетОтделений = 0;
	Для Каждого ЭлементКарты Из КартаГородов Цикл

		СвойстваМетода = Новый Структура("CityRef", ЭлементКарты.Ключ);
		ТаблЭлементов = ЗапроситьОтделения(СвойстваМетода);

		Если ТаблЭлементов.Количество() = 0 Тогда
			НетОтделений = НетОтделений + 1;
			Продолжить;
		КонецЕсли;

		Для Каждого ТекСтр Из ТаблЭлементов Цикл
			СтрокаОтделения = Отделения.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОтделения, ТекСтр);
			СтрокаОтделения.Город = ЭлементКарты.Значение;
		КонецЦикла;

	КонецЦикла;

	Если НетОтделений > 0 Тогда
		// Раньше здесь был Сообщить() на каждый город - в фоновом задании он уходит в никуда,
		// а в форме давал тысячи строк подряд.
		ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Городов без списка отделений: " + НетОтделений);
	КонецЕсли;

КонецПроцедуры

// Добор: города, где остались помеченные отделения, спрашиваются поимённо.
//
// ЗАЧЕМ. Ни постраничный обход, ни проход по всем городам не приносят список целиком -
// в журнале это "получено 25 943 при 54 325 живых". Живое отделение при этом висит
// помеченным сколько угодно долго: пометку снимает только приезд отделения от Новой
// Почты, а в выборе заказа помеченное уже не показывается. Помеченных мало (на
// 24.08.2026 - 9 604 в 2 113 городах), поэтому спросить их адресно дешевле, чем
// добиваться полноты общего списка: это примерно две тысячи запросов вместо десяти.
//
// Добор только снимает пометки: полноту списка он не восстанавливает, и на решение
// "можно ли помечать отсутствующие" не влияет.
Процедура ДобратьОтделенияПоПомеченным()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЛМ_Отделения.Владелец.ГУИД КАК ГУИДГорода,
	|	ЛМ_Отделения.Владелец КАК Город
	|ИЗ
	|	Справочник.ЛМ_Отделения КАК ЛМ_Отделения
	|ГДЕ
	|	ЛМ_Отделения.ПометкаУдаления
	|	И ЛМ_Отделения.Владелец.ГУИД <> """"";
	Выборка = Запрос.Выполнить().Выбрать();

	// ГУИДы, приехавшие в основном проходе: спрашивать их второй раз незачем, а класть
	// в таблицу дублями - тем более.
	Пришедшие = Новый Соответствие;
	Для Каждого ТекСтр Из Отделения Цикл
		Пришедшие.Вставить(ТекСтр.ГУИД, Истина);
	КонецЦикла;

	Добрано = 0;
	ГородовМолчит = 0;

	Пока Выборка.Следующий() Цикл

		СвойстваМетода = Новый Структура("CityRef", Выборка.ГУИДГорода);
		ТаблЭлементов = ЗапроситьОтделения(СвойстваМетода);
		Если ТаблЭлементов.Количество() = 0 Тогда
			// Пустой ответ - вторая попытка: Новая Почта отдаёт пустоту и на живом городе,
			// на этом же спотыкался постраничный обход.
			ТаблЭлементов = ЗапроситьОтделения(СвойстваМетода);
		КонецЕсли;

		Если ТаблЭлементов.Количество() = 0 Тогда
			ГородовМолчит = ГородовМолчит + 1;
			Продолжить;
		КонецЕсли;

		Если ТаблЭлементов.Колонки.Найти("ГУИД") = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого ТекСтр Из ТаблЭлементов Цикл
			Если Пришедшие.Получить(ТекСтр.ГУИД) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Пришедшие.Вставить(ТекСтр.ГУИД, Истина);
			СтрокаОтделения = Отделения.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОтделения, ТекСтр);
			СтрокаОтделения.Город = Выборка.Город;
			Добрано = Добрано + 1;
		КонецЦикла;

	КонецЦикла;

	ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
		УровеньЖурналаРегистрации.Информация, , ,
		"Добор по городам с помеченными отделениями: добрано " + Добрано
		+ ", городов без ответа " + ГородовМолчит);

КонецПроцедуры

Процедура ПолучитьТаблицуОтделений() Экспорт

	Отделения.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЛМ_Города.ГУИД,
	|	ЛМ_Города.Ссылка
	|ИЗ
	|	Справочник.ЛМ_Города КАК ЛМ_Города
	|ГДЕ
	|	ЛМ_Города.ГУИД <> """"";
	// Помеченные города здесь не отсекаются намеренно: если Новая Почта прислала отделение,
	// город живой, и СохранитьОтделения снимет пометку заодно с ним.
	КартаГородов = КартаГУИДов(Запрос.Выполнить().Выгрузить());

	МожноПометитьОтсутствующиеОтделения = Истина;
	Если НЕ ЗаполнитьОтделенияСтраницами(КартаГородов) Тогда
		Отделения.Очистить();
		ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Постраничная выборка отделений не сработала, идём по городам");
		ЗаполнитьОтделенияПоГородам(КартаГородов);
	КонецЕсли;

	ДобратьОтделенияПоПомеченным();

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЛМ_Отделения.Ссылка,
	|	ЛМ_Отделения.ГУИД
	|ИЗ
	|	Справочник.ЛМ_Отделения КАК ЛМ_Отделения";
	КартаОтделений = КартаГУИДов(Запрос.Выполнить().Выгрузить());

	Для Каждого ТекСтр Из Отделения Цикл
		Если ЗначениеЗаполнено(ТекСтр.ГУИД) Тогда
			СсылкаОтделения = КартаОтделений.Получить(ТекСтр.ГУИД);
			Если СсылкаОтделения <> Неопределено Тогда
				ТекСтр.Отделение = СсылкаОтделения;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СохранитьОтделения() Экспорт
	Если Отделения.Количество() = 0 ТОгда
		Возврат ЛОЖЬ;
	КонецЕсли;	
	// Пометка удаления входит в сравнение и снимается при обновлении: отделение, которое
	// Новая Почта прислала в текущем ответе, живое по определению. Без этого пометка вечная -
	// снять её было некому, и в заказе платформа спрашивала "Элемент помечен на удаление!"
	// на отделении, которое давно работает.
	Для Каждого ТекСтр Из Отделения Цикл
		Если ЗначениеЗаполнено(ТекСтр.Отделение) тогда
			Если ТекСтр.Отделение.ГУИД = ТекСтр.ГУИД И ТекСтр.Отделение.Наименование = ТекСтр.Наименование  И ТекСтр.Отделение.НаименованиеРусское = ТекСтр.НаименованиеРусское И ТекСтр.Отделение.Владелец = ТекСтр.Город
				И ТекСтр.Отделение.Широта = ТекСтр.Широта И ТекСтр.Отделение.Долгота = ТекСтр.Долгота И ТекСтр.Отделение.Номер = ТекСтр.Номер
				И НЕ ТекСтр.Отделение.ПометкаУдаления
				Тогда
				Продолжить;
			Иначе
				Об = ТекСтр.Отделение.ПолучитьОбъект();
				Об.Наименование = ТекСтр.Наименование;
				Об.НаименованиеРусское = ТекСтр.НаименованиеРусское;
				Об.ГУИД = ТекСтр.ГУИД;
				Об.Владелец = ТекСтр.Город;
				Об.Широта = ТекСтр.Широта;
				Об.Долгота = ТекСтр.Долгота;
				Об.Номер = ТекСтр.Номер;
				Об.ПометкаУдаления = Ложь;
				Об.Записать();
			КонецЕсли;
		Иначе
			Об = Справочники.ЛМ_Отделения.СоздатьЭлемент();
			Об.Наименование = ТекСтр.Наименование;
			Об.НаименованиеРусское = ТекСтр.НаименованиеРусское;
			Об.ГУИД = ТекСтр.ГУИД;
			Об.Владелец = ТекСтр.Город;
			Об.Широта = ТекСтр.Широта;
			Об.Долгота = ТекСтр.Долгота;
			Об.Номер = ТекСтр.Номер;
			Об.Записать();
			ТекСтр.Отделение = Об.Ссылка;
		КонецЕсли;	
	КонецЦикла;
	
	// Отделения, которых Новая Почта не прислала, помечаются на удаление. Пометка была
	// закомментирована, а Записать() под ней осталась: цикл вхолостую переписывал объекты,
	// поднимая версию записи, и не помечал ничего.
	Если МожноПометитьОтсутствующиеОтделения = Ложь Тогда
		Возврат Истина;
	КонецЕсли;

	ПометитьОтсутствующие("ЛМ_Отделения", Отделения.Выгрузить( , "Отделение"), "Отделение");
	Возврат Истина;
КонецФункции

Процедура ПолучитьТаблицуУлиц(Город) Экспорт
	
	Если Не ЗначениеЗаполнено(Город) Тогда
		Возврат;
	КонецЕсли;
	ном=0;
	Для Страница=1 По 10 Цикл		
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("apiKey", КлючAPI);
		СтруктураЗапроса.Вставить("modelName", "Address");
		СтруктураЗапроса.Вставить("calledMethod", "getStreet");
		СтруктураЗапроса.Вставить("methodProperties", Новый Структура("CityRef,Page", Город.ГУИД,Строка(Страница)));
		Если Константы.ЛМ_ЯзыкИнтерфейсаОбмена.Получить() = Перечисления.ЛМ_ЯзыкиИнтерфейсаОбмена.Украинский Тогда
			СтруктураЗапроса.Вставить("language", "ua");
		Иначе
			СтруктураЗапроса.Вставить("language", "ru");
		КонецЕсли;
		
		ДеревоОтвета = ОтправитьЗапрос(СтруктураЗапроса);
		
		ТаблЭлементов = ПолучитьТаблицуЭлементовПоДереву(ДеревоОтвета);
		Если ТаблЭлементов.Колонки.Найти("Description") <> Неопределено Тогда
			ТаблЭлементов.Колонки.Description.Имя = "Наименование";
		КонецЕсли;	
		Если ТаблЭлементов.Колонки.Найти("Ref") <> Неопределено Тогда
			ТаблЭлементов.Колонки.Ref.Имя = "ГУИД";
		КонецЕсли;	
		
		Если ТаблЭлементов.Колонки.Найти("StreetsType") <> Неопределено Тогда
			Для Каждого ТекСтр Из ТаблЭлементов Цикл
				ТекСтр.Наименование = ТекСтр.Наименование + " " + ТекСтр.StreetsType;
			КонецЦикла;	
		КонецЕсли;	
	    	
		//Улицы.Загрузить(ТаблЭлементов);
		Для Каждого ТекСтр Из ТаблЭлементов Цикл
			Улицы.Добавить();
		//	Улицы[0].Улица=Текстр.Улица;
			Улицы[ном].ГУИД=Текстр.ГУИД;
			Улицы[ном].Наименование=Текстр.Наименование;
			Улицы[ном].Город=Город;
			ном=ном+1; 
		КонецЦикла;	
		
		Для Каждого ТекСтр Из Улицы Цикл
			ТекСтр.Город = Город;
		КонецЦикла;	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛМ_Улицы.Ссылка,
		|	ЛМ_Улицы.ГУИД
		|ИЗ
		|	Справочник.ЛМ_Улицы КАК ЛМ_Улицы";
		Табл = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ТекСтр Из Улицы Цикл
			Если ЗначениеЗаполнено(ТекСтр.ГУИД) Тогда
				СтрокаТабл = Табл.Найти(ТекСтр.ГУИД, "ГУИД");
				Если СтрокаТабл <> Неопределено Тогда
					ТекСтр.Улица = СтрокаТабл.Ссылка;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
КонецПроцедуры

Функция СохранитьУлицы(Город) Экспорт
	Если Улицы.Количество() = 0 ТОгда
		Возврат ЛОЖЬ;
	КонецЕсли;	
	Если не ЗначениеЗаполнено(Город) тогда
		Возврат Ложь;
	КонецЕсли;	
	Для Каждого ТекСтр Из Улицы Цикл
		Если ЗначениеЗаполнено(ТекСтр.Улица) тогда
			Если ТекСтр.Улица.ГУИД = ТекСтр.ГУИД И ТекСтр.Улица.Наименование = ТекСтр.Наименование и ТекСтр.Улица.Владелец = ТекСтр.Город Тогда
				Продолжить;
			Иначе
				Об = ТекСтр.Улица.ПолучитьОбъект();
				Об.Наименование = ТекСтр.Наименование;
				Об.ГУИД = ТекСтр.ГУИД;
				Об.Владелец = ТекСтр.Город;
				Об.Записать();
			КонецЕсли;
		Иначе
			Об = Справочники.ЛМ_Улицы.СоздатьЭлемент();
			Об.Наименование = ТекСтр.Наименование;
			Об.ГУИД = ТекСтр.ГУИД;
			Об.Владелец = ТекСтр.Город;
			Об.Записать();
			ТекСтр.Улица = Об.Ссылка;
		КонецЕсли;	
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_Улицы.Ссылка
	|ИЗ
	|	Справочник.ЛМ_Улицы КАК ЛМ_Улицы
	|ГДЕ
	|	НЕ ЛМ_Улицы.Ссылка В (&Ссылка)
	|	И НЕ ЛМ_Улицы.ПометкаУдаления
	|	И ЛМ_Улицы.Владелец = &Город";
	
	Запрос.УстановитьПараметр("Ссылка", Улицы.ВыгрузитьКолонку("Улица"));
	Запрос.УстановитьПараметр("Город", Город);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Об.ПометкаУдаления = Истина;
		Об.Записать();
	КонецЦикла;	
	Возврат Истина;
КонецФункции	

Процедура ПолучитьТаблицуВременныхИнтервалов(Город) Экспорт
	
	Если Не ЗначениеЗаполнено(Город) Тогда
		Возврат;
	КонецЕсли;	
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("apiKey", КлючAPI);
	СтруктураЗапроса.Вставить("modelName", "Common");
	СтруктураЗапроса.Вставить("calledMethod", "getTimeIntervals");
	СтруктураЗапроса.Вставить("methodProperties", Новый Структура("RecipientCityRef", Город.ГУИД));
	Если Константы.ЛМ_ЯзыкИнтерфейсаОбмена.Получить() = Перечисления.ЛМ_ЯзыкиИнтерфейсаОбмена.Украинский Тогда
		СтруктураЗапроса.Вставить("language", "ua");
	Иначе
		СтруктураЗапроса.Вставить("language", "ru");
	КонецЕсли;
	ДеревоОтвета = ОтправитьЗапрос(СтруктураЗапроса);
	
	ТаблЭлементов = ПолучитьТаблицуЭлементовПоДереву(ДеревоОтвета);
	Если ТаблЭлементов.Колонки.Найти("Number") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Number.Имя = "ГУИД";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("Start") <> Неопределено Тогда
		ТаблЭлементов.Колонки.Start.Имя = "Начало";
	КонецЕсли;	
	Если ТаблЭлементов.Колонки.Найти("End") <> Неопределено Тогда
		ТаблЭлементов.Колонки.End.Имя = "Конец";
	КонецЕсли;	
	
	ТаблЭлементов.Колонки.Добавить("Город");
	ТаблЭлементов.Колонки.Добавить("Наименование");
	
	Для Каждого ТекСтрока Из ТаблЭлементов Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Начало) Тогда
			ПоложениеДвоеточия = Найти(ТекСтрока.Начало, ":");
			Если ПоложениеДвоеточия > 0 Тогда
				Часы = Лев(ТекСтрока.Начало, ПоложениеДвоеточия - 1);
				Минуты = Сред(ТекСтрока.Начало, ПоложениеДвоеточия + 1);
				ТекСтрока.Начало = Дата(1,1,1,Часы,Минуты,0);
			КонецЕсли;	
		КонецЕсли;	
		Если ЗначениеЗаполнено(ТекСтрока.Конец) Тогда
			ПоложениеДвоеточия = Найти(ТекСтрока.Конец, ":");
			Если ПоложениеДвоеточия > 0 Тогда
				Часы = Лев(ТекСтрока.Конец, ПоложениеДвоеточия - 1);
				Минуты = Сред(ТекСтрока.Конец, ПоложениеДвоеточия + 1);
				ТекСтрока.Конец = Дата(1,1,1,Часы,Минуты,0);
			КонецЕсли;	
		КонецЕсли;
		ТекСтрока.Город = Город;
		ТекСтрока.Наименование = Формат(ТекСтрока.Начало, "ДФ=ЧЧ:мм") + "-" + Формат(ТекСтрока.Конец, "ДФ=ЧЧ:мм");
	КонецЦикла;	
	
	ВременныеИнтервалы.Загрузить(ТаблЭлементов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_ВременныеИнтервалы.Ссылка,
	|	ЛМ_ВременныеИнтервалы.ГУИД
	|ИЗ
	|	Справочник.ЛМ_ВременныеИнтервалы КАК ЛМ_ВременныеИнтервалы
	|ГДЕ
	|	ЛМ_ВременныеИнтервалы.Владелец = &Город";
	Запрос.УстановитьПараметр("Город", Город);
	Табл = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ТекСтр Из ВременныеИнтервалы Цикл
		Если ЗначениеЗаполнено(ТекСтр.ГУИД) Тогда
			СтрокаТабл = Табл.Найти(ТекСтр.ГУИД, "ГУИД");
			Если СтрокаТабл <> Неопределено Тогда
				ТекСтр.ВременнойИнтервал = СтрокаТабл.Ссылка;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

Функция СохранитьВременныеИнтервалы(Город) Экспорт
	Если ВременныеИнтервалы.Количество() = 0 ТОгда
		Возврат ЛОЖЬ;
	КонецЕсли;	
	Если не ЗначениеЗаполнено(Город) тогда
		Возврат Ложь;
	КонецЕсли;	
	Для Каждого ТекСтр Из ВременныеИнтервалы Цикл
		Если ЗначениеЗаполнено(ТекСтр.ВременнойИнтервал) тогда
			Если ТекСтр.ВременнойИнтервал.Наименование = ТекСтр.Наименование и ТекСтр.ВременнойИнтервал.ГУИД = ТекСтр.ГУИД 
				И ТекСтр.ВременнойИнтервал.Владелец = ТекСтр.Город
				И ТекСтр.ВременнойИнтервал.Начало = ТекСтр.Начало И ТекСтр.ВременнойИнтервал.Конец = ТекСтр.Конец Тогда
				Продолжить;
			Иначе
				Об = ТекСтр.ВременнойИнтервал.ПолучитьОбъект();
				Об.Наименование = ТекСтр.Наименование;
				Об.ГУИД = ТекСтр.ГУИД;
				Об.Владелец = ТекСтр.Город;
				Об.Начало = ТекСтр.Начало;
				Об.Конец = ТекСтр.Конец;
				Об.Записать();
			КонецЕсли;
		Иначе
			Об = Справочники.ЛМ_ВременныеИнтервалы.СоздатьЭлемент();
			Об.Наименование = ТекСтр.Наименование;
			Об.Владелец = ТекСтр.Город;
			Об.ГУИД = ТекСтр.ГУИД;
			Об.Начало = ТекСтр.Начало;
			Об.Конец = ТекСтр.Конец;
			Об.Записать();
			ТекСтр.ВременнойИнтервал = Об.Ссылка;
		КонецЕсли;	
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_ВременныеИнтералы.Ссылка
	|ИЗ
	|	Справочник.ЛМ_ВременныеИнтервалы КАК ЛМ_ВременныеИнтералы
	|ГДЕ
	|	НЕ ЛМ_ВременныеИнтералы.Ссылка В (&Ссылка)
	|	И НЕ ЛМ_ВременныеИнтералы.ПометкаУдаления
	|	И ЛМ_ВременныеИнтералы.Владелец = &Город";
	
	Запрос.УстановитьПараметр("Ссылка", ВременныеИнтервалы.ВыгрузитьКолонку("ВременнойИнтервал"));
	Запрос.УстановитьПараметр("Город", Город);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Об.ПометкаУдаления = Истина;
		Об.Записать();
	КонецЦикла;	
	Возврат Истина;
КонецФункции	

Процедура ПолучитьТаблицуКонтрагентов() Экспорт
	
	ЗапросТиповКонтрагента = Новый Запрос;
	ЗапросТиповКонтрагента.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_ВидыПлательщиков.ГУИД,
	|	ЛМ_ВидыПлательщиков.Ссылка
	|ИЗ
	|	Справочник.ЛМ_ВидыПлательщиков КАК ЛМ_ВидыПлательщиков
	|ГДЕ
	|	ЛМ_ВидыПлательщиков.ПометкаУдаления = ЛОЖЬ";
	
	Выборка = ЗапросТиповКонтрагента.Выполнить().Выбрать();
	Контрагенты.Очистить();
	Пока Выборка.Следующий() Цикл
	
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("apiKey", КлючAPI);
		СтруктураЗапроса.Вставить("modelName", "Counterparty");
		СтруктураЗапроса.Вставить("calledMethod", "getCounterparties");
		СтруктураЗапроса.Вставить("methodProperties", Новый Структура("CounterpartyProperty", Выборка.ГУИД));
		Если Константы.ЛМ_ЯзыкИнтерфейсаОбмена.Получить() = Перечисления.ЛМ_ЯзыкиИнтерфейсаОбмена.Украинский Тогда
			СтруктураЗапроса.Вставить("language", "ua");
		Иначе
			СтруктураЗапроса.Вставить("language", "ru");
		КонецЕсли;
		ДеревоОтвета = ОтправитьЗапрос(СтруктураЗапроса);
		
		ТаблЭлементов = ПолучитьТаблицуЭлементовПоДереву(ДеревоОтвета);
		
		Если ТаблЭлементов.Колонки.Найти("Ref") <> Неопределено Тогда
			ТаблЭлементов.Колонки.Ref.Имя = "ГУИД";
		КонецЕсли;	
		
		Если ТаблЭлементов.Колонки.Найти("Description") <> Неопределено Тогда
			ТаблЭлементов.Колонки.Description.Имя = "Наименование";
		КонецЕсли;	
		Если ТаблЭлементов.Колонки.Найти("FirstName") <> Неопределено Тогда
			ТаблЭлементов.Колонки.FirstName.Имя = "Имя";
		КонецЕсли;	
		Если ТаблЭлементов.Колонки.Найти("LastName") <> Неопределено Тогда
			ТаблЭлементов.Колонки.LastName.Имя = "Фамилия";
		КонецЕсли;	
		Если ТаблЭлементов.Колонки.Найти("MiddleName") <> Неопределено Тогда
			ТаблЭлементов.Колонки.MiddleName.Имя = "Отчество";
		КонецЕсли;	
		Если ТаблЭлементов.Колонки.Найти("Phone") <> Неопределено Тогда
			ТаблЭлементов.Колонки.Phone.Имя = "Телефон";
		КонецЕсли;	
		Если ТаблЭлементов.Колонки.Найти("City") <> Неопределено Тогда
			ТаблЭлементов.Колонки.City.Имя = "ГУИДГорода";
		КонецЕсли;	
		Если ТаблЭлементов.Колонки.Найти("EDRPOU") <> Неопределено Тогда
			ТаблЭлементов.Колонки.EDRPOU.Имя = "ЕДРПОУ";
		КонецЕсли;	
	 	Если ТаблЭлементов.Колонки.Найти("CounterpartyType") <> Неопределено Тогда
			ТаблЭлементов.Колонки.CounterpartyType.Имя = "ГУИДТипаКонтрагента";
		КонецЕсли;	

		Если ТаблЭлементов.Колонки.Найти("OwnershipFormRef") <> Неопределено Тогда
			ТаблЭлементов.Колонки.OwnershipFormRef.Имя = "ГУИДФормыСобственности";
		КонецЕсли;	
		
		Для Каждого ТекСтрока Из ТаблЭлементов Цикл
			СтрТЧ = Контрагенты.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТЧ, ТекСтрока);
			СтрТЧ.ВидКонтрагента = Выборка.Ссылка;
		КонецЦикла;	
			
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_Контрагенты.Ссылка,
	|	ЛМ_Контрагенты.ГУИД
	|ИЗ
	|	Справочник.ЛМ_Контрагенты КАК ЛМ_Контрагенты";
	Табл = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_Города.Ссылка,
	|	ЛМ_Города.ГУИД
	|ИЗ
	|	Справочник.ЛМ_Города КАК ЛМ_Города";
	ТаблГорода = Запрос.Выполнить().Выгрузить();

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_ТипыКонтрагентовОтправителей.Ссылка,
	|	ЛМ_ТипыКонтрагентовОтправителей.ГУИД
	|ИЗ
	|	Справочник.ЛМ_ТипыКонтрагентовОтправителей КАК ЛМ_ТипыКонтрагентовОтправителей";
	ТаблТиповКонтрагентов = Запрос.Выполнить().Выгрузить();

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_ФормыСобственности.Ссылка,
	|	ЛМ_ФормыСобственности.ГУИД
	|ИЗ
	|	Справочник.ЛМ_ФормыСобственности КАК ЛМ_ФормыСобственности";
	ТаблФормСобственности = Запрос.Выполнить().Выгрузить();
 	
	Для Каждого ТекСтр Из Контрагенты Цикл
		Если ЗначениеЗаполнено(ТекСтр.ГУИД) Тогда
			СтрокаТабл = Табл.Найти(ТекСтр.ГУИД, "ГУИД");
			Если СтрокаТабл <> Неопределено Тогда
				ТекСтр.Контрагент = СтрокаТабл.Ссылка;
			КонецЕсли;	
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекСтр.ГУИДГорода) Тогда
			СтрокаТабл = ТаблГорода.Найти(ТекСтр.ГУИДГорода, "ГУИД");
			Если СтрокаТабл <> Неопределено Тогда
				ТекСтр.Город = СтрокаТабл.Ссылка;
			КонецЕсли;	
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекСтр.ГУИДТипаКонтрагента) Тогда
			СтрокаТабл = ТаблТиповКонтрагентов.Найти(ТекСтр.ГУИДТипаКонтрагента, "ГУИД");
			Если СтрокаТабл <> Неопределено Тогда
				ТекСтр.ТипКонтрагента = СтрокаТабл.Ссылка;
			КонецЕсли;	
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекСтр.ГУИДФормыСобственности) Тогда
			СтрокаТабл = ТаблТиповКонтрагентов.Найти(ТекСтр.ГУИДФормыСобственности, "ГУИД");
			Если СтрокаТабл <> Неопределено Тогда
				ТекСтр.ФормаСобственности = СтрокаТабл.Ссылка;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СохранитьКонтрагентов() Экспорт
	Если Контрагенты.Количество() = 0 ТОгда
		Возврат ЛОЖЬ;
	КонецЕсли;	
	Для Каждого ТекСтр Из Контрагенты Цикл
		Если ЗначениеЗаполнено(ТекСтр.ГУИДГорода) И НЕ ЗначениеЗаполнено(ТекСтр.Город) тогда
			Сообщить("Не найден город с идентификатором " + ТекСтр.ГУИДГорода);
		КонецЕсли;	
		Если ЗначениеЗаполнено(ТекСтр.ГУИДТипаКонтрагента) И НЕ ЗначениеЗаполнено(ТекСтр.ТипКонтрагента) тогда
			Сообщить("Не найден тип контрагента с идентификатором " + ТекСтр.ГУИДТипаКонтрагента);
		КонецЕсли;	
		Если ЗначениеЗаполнено(ТекСтр.ГУИДФормыСобственности) И НЕ ЗначениеЗаполнено(ТекСтр.ФормаСобственности) И ТекСтр.ГУИДТипаКонтрагента = "Organization" тогда
			Сообщить("Не найдена форма собственности с идентификатором " + ТекСтр.ГУИДФормыСобственности);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ТекСтр.Контрагент) тогда
			Если ТекСтр.Контрагент.Наименование = ТекСтр.Наименование и ТекСтр.Контрагент.ГУИД = ТекСтр.ГУИД 
				И ТекСтр.Контрагент.ЮрФизЛицо = ТекСтр.ТипКонтрагента
				И ТекСтр.Контрагент.Город = ТекСтр.Город
				И ТекСтр.Контрагент.ВидКонтрагента = ТекСтр.ВидКонтрагента
				И ТекСтр.Контрагент.Имя = ТекСтр.Имя И ТекСтр.Контрагент.Фамилия = ТекСтр.Фамилия 
				И ТекСтр.Контрагент.Отчество = ТекСтр.Отчество
				И ТекСтр.Контрагент.ФормаСобственности = ТекСтр.ФормаСобственности И ТекСтр.Контрагент.ЕДРПОУ = ТекСтр.ЕДРПОУ 
				Тогда
				Продолжить;
			Иначе
				Об = ТекСтр.Контрагент.ПолучитьОбъект();
				Об.Наименование = ТекСтр.Наименование;
				Об.ГУИД = ТекСтр.ГУИД;
				Об.ЮрФизЛицо = ТекСтр.ТипКонтрагента;
				Об.Имя = ТекСтр.Имя;
				Об.Фамилия = ТекСтр.Фамилия;
				Об.Отчество = ТекСтр.Отчество;
				//Об.Телефон = ТекСтр.Телефон;
				Об.ФормаСобственности = ТекСтр.ФормаСобственности;
				Об.ЕДРПОУ = ТекСтр.ЕДРПОУ;
				Об.Город = ТекСтр.Город;
				Об.ВидКонтрагента = ТекСтр.ВидКонтрагента;
				Об.НеОбновлятьВИССлужбыДоставки = Истина;
				Об.Записать();
			КонецЕсли;
		Иначе
			Об = Справочники.ЛМ_Контрагенты.СоздатьЭлемент();
			Об.Наименование = ТекСтр.Наименование;
			Об.ГУИД = ТекСтр.ГУИД;
			Об.ЮрФизЛицо = ТекСтр.ТипКонтрагента;
			Об.Имя = ТекСтр.Имя;
			Об.Фамилия = ТекСтр.Фамилия;
			Об.Отчество = ТекСтр.Отчество;
			//Об.Телефон = ТекСтр.Телефон;
			Об.ФормаСобственности = ТекСтр.ФормаСобственности;
			Об.ЕДРПОУ = ТекСтр.ЕДРПОУ;
			Об.Город = ТекСтр.Город;
			Об.ВидКонтрагента = ТекСтр.ВидКонтрагента;
			Об.НеОбновлятьВИССлужбыДоставки = Истина;
			Об.Записать();
			ТекСтр.Контрагент = Об.Ссылка;
		КонецЕсли;	
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_Контрагенты.Ссылка
	|ИЗ
	|	Справочник.ЛМ_Контрагенты КАК ЛМ_Контрагенты
	|ГДЕ
	|	НЕ ЛМ_Контрагенты.Ссылка В (&Ссылка)
	|	И НЕ ЛМ_Контрагенты.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Ссылка", Контрагенты.ВыгрузитьКолонку("Контрагент"));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Об.ПометкаУдаления = Истина;
		Об.Записать();
	КонецЦикла;	
	Возврат Истина;
КонецФункции	

Процедура ПолучитьТаблицуКонтактныхЛиц() Экспорт
	
	ЗапросКонтрагентов = Новый Запрос;
	ЗапросКонтрагентов.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_Контрагенты.Ссылка,
	|	ЛМ_Контрагенты.ГУИД
	|ИЗ
	|	Справочник.ЛМ_Контрагенты КАК ЛМ_Контрагенты
	|ГДЕ
	|	ЛМ_Контрагенты.ПометкаУдаления = ЛОЖЬ
	|	И НЕ ЛМ_Контрагенты.ГУИД = """"";
	
	ВыборкаКонтрагентов = ЗапросКонтрагентов.Выполнить().Выбрать();
	КонтактныеЛица.Очистить();
	Пока ВыборкаКонтрагентов.Следующий() Цикл
	
		СтруктураЗапроса = Новый Структура;
		СтруктураЗапроса.Вставить("apiKey", КлючAPI);
		СтруктураЗапроса.Вставить("modelName", "Counterparty");
		СтруктураЗапроса.Вставить("calledMethod", "getCounterpartyContactPersons");
		СтруктураЗапроса.Вставить("methodProperties", Новый Структура("Ref", ВыборкаКонтрагентов.ГУИД));
		Если Константы.ЛМ_ЯзыкИнтерфейсаОбмена.Получить() = Перечисления.ЛМ_ЯзыкиИнтерфейсаОбмена.Украинский Тогда
			СтруктураЗапроса.Вставить("language", "ua");
		Иначе
			СтруктураЗапроса.Вставить("language", "ru");
		КонецЕсли;
		ДеревоОтвета = ОтправитьЗапрос(СтруктураЗапроса);
		
		ТаблЭлементов = ПолучитьТаблицуЭлементовПоДереву(ДеревоОтвета);
		
	    Если ТаблЭлементов.Колонки.Найти("Ref") <> Неопределено Тогда
	    	ТаблЭлементов.Колонки.Ref.Имя = "ГУИД";
	    КонецЕсли;	
	    Если ТаблЭлементов.Колонки.Найти("Description") <> Неопределено Тогда
	    	ТаблЭлементов.Колонки.Description.Имя = "Наименование";
	    КонецЕсли;	
	    Если ТаблЭлементов.Колонки.Найти("FirstName") <> Неопределено Тогда
	    	ТаблЭлементов.Колонки.FirstName.Имя = "Имя";
	    КонецЕсли;	
	    Если ТаблЭлементов.Колонки.Найти("LastName") <> Неопределено Тогда
	    	ТаблЭлементов.Колонки.LastName.Имя = "Фамилия";
	    КонецЕсли;	
	    Если ТаблЭлементов.Колонки.Найти("MiddleName") <> Неопределено Тогда
	    	ТаблЭлементов.Колонки.MiddleName.Имя = "Отчество";
	    КонецЕсли;	
	    Если ТаблЭлементов.Колонки.Найти("Phones") <> Неопределено Тогда
	    	ТаблЭлементов.Колонки.Phones.Имя = "Телефон";
	    КонецЕсли;	
		
		Для Каждого ТекСтр Из ТаблЭлементов цикл
			СтрТЧ = КонтактныеЛица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТЧ, ТекСтр);
			СтрТЧ.Контрагент = ВыборкаКонтрагентов.Ссылка;
		КонецЦикла;	
	КонецЦикла;	
	
	Запрос = новый Запрос;
	Запрос.Текст = 
    "ВЫБРАТЬ
    |	ЛМ_КонтактныеЛица.Ссылка,
    |	ЛМ_КонтактныеЛица.ГУИД
    |ИЗ
    |	Справочник.ЛМ_КонтактныеЛица КАК ЛМ_КонтактныеЛица";
    Табл = Запрос.Выполнить().Выгрузить();
  
    Для Каждого ТекСтр Из КонтактныеЛица Цикл
    	Если ЗначениеЗаполнено(ТекСтр.ГУИД) Тогда
    		СтрокаТабл = Табл.Найти(ТекСтр.ГУИД, "ГУИД");
    		Если СтрокаТабл <> Неопределено Тогда
    			ТекСтр.КонтактноеЛицо = СтрокаТабл.Ссылка;
    		КонецЕсли;	
    	КонецЕсли;
    КонецЦикла;	
	
КонецПроцедуры

