

Процедура ЗаписатьХМЛЗапроса(Запись, СтруктураЗапроса) Экспорт
	Если ТипЗнч(СтруктураЗапроса) = Тип("Строка") тогда
		Запись.ЗаписатьТекст(СтруктураЗапроса);
		Возврат;
	КонецЕсли;	
	Для каждого ТекКлючЗначение Из СтруктураЗапроса Цикл
		Запись.ЗаписатьНачалоЭлемента(ТекКлючЗначение.Ключ);
		Если ТипЗнч(ТекКлючЗначение.Значение) = Тип("Структура") Тогда
			ЗаписатьХМЛЗапроса(Запись, ТекКлючЗначение.Значение);
		ИначеЕсли ТипЗнч(ТекКлючЗначение.Значение) = Тип("Массив") Тогда
			Для Каждого ТекЭлементМассива из ТекКлючЗначение.Значение Цикл
				Запись.ЗаписатьНачалоЭлемента("item");
				ЗаписатьХМЛЗапроса(Запись, ТекЭлементМассива);
				Запись.ЗаписатьКонецЭлемента();
			КонецЦикла;	
		Иначе	
			Запись.ЗаписатьТекст(ТекКлючЗначение.Значение);
		КонецЕсли;	
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;	
	
КонецПроцедуры	

Функция ПолучитьЗапрос_getStatusDocuments(ПараметрыМетода)
	
	ТекстЗапроса = 
	"<?xml version=""1.0"" encoding=""UTF-8""?>
	|<root>
	|<apiKey>"+ ПараметрыМетода.API20+"</apiKey>
	|<modelName>TrackingDocument</modelName>
	|<calledMethod>getStatusDocuments</calledMethod>
	|<methodProperties>
	|<Documents>" + Символы.ПС;  
	Для каждого Реф Из ПараметрыМетода.ТабРеф Цикл
		ТекстЗапроса = ТекстЗапроса + "<item>" + Символы.ПС;
		ТекстЗапроса = ТекстЗапроса + "<DocumentNumber>" + СокрЛП(Реф.НомерДок) + "</DocumentNumber>" + Символы.ПС;
		ТекстЗапроса = ТекстЗапроса + "<Phone>" + СокрЛП(Реф.Телефон) + "</Phone>" + Символы.ПС;
		ТекстЗапроса = ТекстЗапроса + "</item>" + Символы.ПС;
	КонецЦикла; 
	ТекстЗапроса = ТекстЗапроса	+
	"</Documents>
	|<Language>UA</Language>
	|</methodProperties>
	|</root>";
	Возврат ТекстЗапроса;
	
КонецФункции


