Функция ___обРазобратьXML(Ч) Экспорт
	
	Дерево = Новый ДеревоЗначений();
	Дерево.Колонки.Добавить("Тег");
	Дерево.Колонки.Добавить("Тело");
	ТекСтроки = Дерево.Строки;
	___обРазобратьXMLСлуж(Ч, ТекСтроки, Неопределено);	
	
	Возврат Дерево;
КонецФункции

Функция ПолучитьТаблицуЭлементовПоДереву(ДеревоОтвета) Экспорт
	Табл = Новый ТаблицаЗначений;
	Для Каждого ТекСтрока из ДеревоОтвета.Строки Цикл
		Если ТекСтрока.Тег = "root" тогда
			Для Каждого ТекСтрока1 Из ТекСтрока.Строки цикл
				Если ТекСтрока1.Тег = "success" Тогда
					Если НЕ ТекСтрока1.Тело = "true" Тогда
						Возврат Табл;
					КонецЕсли; 	
				ИначеЕсли ТекСтрока1.Тег = "data" Тогда
					Для Каждого ТекСтрока2 Из ТекСтрока1.Строки Цикл
						Если ТекСтрока2.Тег = "item" Тогда
							СтрТабл = Табл.Добавить();
							Для каждого ТекСтрока3 Из ТекСтрока2.Строки цикл
								Если Табл.Колонки.Найти(ТекСтрока3.Тег) = Неопределено Тогда
									Табл.Колонки.Добавить(ТекСтрока3.Тег);
								КонецЕсли;	
								СтрТабл[ТекСтрока3.Тег] = ТекСтрока3.Тело;
							КонецЦикла;
						КонецЕсли;	
					КонецЦикла;	
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;		
	КонецЦикла;	
	Возврат Табл;
КонецФункции	
//Служебная функция для разбора XML в дерево
Функция ___обРазобратьXMLСлуж(Ч, ТекСтроки, Знач ТекСтрока) Экспорт
	Атрибуты = Новый Структура();
	Пока Ч.Прочитать() Цикл
		Если Ч.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ТекСтрока = ТекСтроки.Добавить();
			ТекСтрока.Тег = Ч.Имя;
			___обРазобратьXMLСлуж(Ч, ТекСтрока.Строки, ТекСтрока);
		ИначеЕсли Ч.ТипУзла = ТипУзлаXML.Текст Тогда
			ТекСтрока.Тело = Ч.Значение;
		ИначеЕсли Ч.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьСтруктуруОтвета(ДеревоОтвета,ПолучатьОшибки = Ложь) Экспорт
	
	СтруктураОтвета = Новый Структура;
	Для Каждого ТекСтрока из ДеревоОтвета.Строки Цикл
		Если ТекСтрока.Тег = "root" тогда
			Для Каждого ТекСтрока1 Из ТекСтрока.Строки цикл
				Если ТекСтрока1.Тег = "success" Тогда
					Если ПолучатьОшибки = Ложь И НЕ ТекСтрока1.Тело = "true" Тогда
						Возврат СтруктураОтвета;
					КонецЕсли; 	
				ИначеЕсли ТекСтрока1.Тег = "data" Тогда
					Для Каждого ТекСтрока2 Из ТекСтрока1.Строки Цикл
						Если ТекСтрока2.Тег = "item" Тогда
							Для Каждого ТекСтрока3 Из ТекСтрока2.Строки Цикл
								Если ЗначениеЗаполнено(ТекСтрока3.Тег) и ЗначениеЗаполнено(ТекСтрока3.Тело) Тогда
									СтруктураОтвета.Вставить(ТекСтрока3.Тег,ТекСтрока3.Тело);
								КонецЕсли;	
							КонецЦикла;
						КонецЕсли;	
					КонецЦикла;	
					
				ИначеЕсли ТекСтрока1.Тег = "errors" Тогда
					Ошибки = Новый Структура;
					итераторОшибок = 0;
					Для Каждого ТекСтрока2 Из ТекСтрока1.Строки Цикл
						Если ЗначениеЗаполнено(ТекСтрока2.Тег) и ЗначениеЗаполнено(ТекСтрока2.Тело) Тогда
							Если Ошибки.Свойство(ТекСтрока2.Тег) Тогда
								итераторОшибок = итераторОшибок + 1;
								Ошибки.Вставить(ТекСтрока2.Тег + "Итератор" + Формат(итераторОшибок,"ЧГ="),ТекСтрока2.Тело)
							Иначе	
								Ошибки.Вставить(ТекСтрока2.Тег,ТекСтрока2.Тело);
							КонецЕсли;	
						КонецЕсли;	
					КонецЦикла;	
					
					СтруктураОтвета.Вставить("Ошибки",Ошибки);
					
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;		
	КонецЦикла;	
	Возврат СтруктураОтвета;
	
КонецФункции	
