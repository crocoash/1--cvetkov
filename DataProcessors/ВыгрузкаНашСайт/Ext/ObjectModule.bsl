Процедура ВыполнитьВыгрузкуНК(ПутьКФайлу, Номенкл = Неопределено,ВыбХарактеристика = Неопределено ,Тест = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВариантВыгрузки = Константы.ВариантВыгрузкиНашСайт.Получить();
	ВыгружатьБезЦен = Истина;
	ВыгружатьБезФото = Истина;
	
	ВариантВыгрузки = Справочники.ВариантыВыгрузкиХарактеристик.НайтиПоКоду(000000003);
	Таблица = ОбщегоНазначения.ПолучитьТаблицуНк(Номенкл, ВыбХарактеристика,ВариантВыгрузки, ВыгружатьБезЦен, ВыгружатьБезФото);	
	
	Если СтрЧислоВхождений(ПутьКФайлу, ".xml") = 0 Тогда
		
		ПутьКФайлу = ПутьКФайлу + ".xml";
		
	КонецЕсли;
	
		
	ТД = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	
	Врем = Формат(ТекущаяДата(), "ДЛФ=T");                                 
	
	Если СтрДлина(Врем) = 7 Тогда
		
		Врем = Лев(Врем, 4);
		
	//Иначе
		
		Врем = Лев(Врем, 5);
		
	КонецЕсли;
	
	ТД.ЗаписатьСтроку("<?xml version=""1.0"" encoding=""UTF-8""?>
					  |<!DOCTYPE yml_catalog SYSTEM ""shops.dtd"">
					  |<yml_catalog date=""" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd") + " " + Врем + """>
					  |<shop>
					  |<name>Cvetkov</name>
					  |<url>http://www.cvetkovtm.com/</url>
					  |<currencies>
					  |<currency id=""UAH"" rate=""1""/>
					  |</currencies>");
	
	ТД.ЗаписатьСтроку("<offers>");
	
	Для Каждого Стр Из Таблица Цикл  
		
		ХарактеристикаНк = Стр.ХарактеристикаНк;
		ИД = ХарактеристикаНк.Код;  
		
		ХарактеристикаОбъект = ХарактеристикаНк.ПолучитьОбъект();
		КомплНК = ХарактеристикаОбъект.Комплектующие_НК();	
		
		Если КомплНК.Количество() = 0 Тогда Продолжить; КонецЕсли;

		Ростовка = Стр.Ростовка;
		
		Скрыта = Стр.Скрыта;
		available = Стр.available;
		
		ХарактеристикаКомпл = КомплНК[0].ХарактеристикаКомплектующей;
		ХарактеристикаКомплОбъект = ХарактеристикаКомпл.ПолучитьОбъект();
		
		ИДГР      = ХарактеристикаКомпл.Владелец.ПолучитьОбъект().КодБезНоликов() + ХарактеристикаКомплОбъект.ПолучитьКодЦвета() + ХарактеристикаКомплОбъект.ПолучитьКодТкани();
		ИдМод     = ХарактеристикаКомпл.Владелец.Код;
		
		Предзаказ = Стр.Предзаказ;
		СкидкаРостовка = Стр.СкидкаРостовка;
		ДоступныйОстатокОпт = Стр.ДоступныйОстатокОпт; 
		ЦенаОпт = Стр.ЦенаОпт;
		
		КодКомплектующих = "";
		Ном  = 1;
				
		Для Каждого Стр1 Из КомплНК Цикл
			Для i = 1 По Стр1.Количество Цикл
			
					
				МассивСкладов = Новый Массив;
				МассивСкладов.Добавить(Справочники.Склады.НайтиПоКоду("000000014"));
				МассивСкладов.Добавить(Справочники.Склады.НайтиПоКоду("000000038"));
	
								
				КодКомплектующих = КодКомплектующих + ОбщегоНазначения.УбратьНоликиСлева(Стр1.ХарактеристикаКомплектующей.Владелец.Код) + ОбщегоНазначения.УбратьНоликиСлева(Стр1.ХарактеристикаКомплектующей.Код);
				
				Если Не Ном = КомплНК.Количество() * Стр1.Количество Тогда
					
					КодКомплектующих = КодКомплектующих + ",";
					
				КонецЕсли;
				
	 			Ном = Ном + 1;
			
			КонецЦикла; 
		КонецЦикла;
		
		Если КодКомплектующих = "" Тогда
			Продолжить;
		КонецЕсли;
				
		ТД.ЗаписатьСтроку("<offer  id=""" + ИД + """ model_id=""" + ОбщегоНазначения.УбратьНоликиСлева(ИдМод) + """ group_id=""" + ИДГР + """>");
		
		
	    Наименование = СтрЗаменить(Стр.НК.Наименование, "(Рост-ка)", "");

		ТД.ЗаписатьСтроку("<name>" + Наименование + "</name>");

		

		ТД.ЗаписатьСтроку("<isHidden>"+ Скрыта  +"</isHidden>");   
		ТД.ЗаписатьСтроку("<available>"+ available  +"</available>");   	
		ТД.ЗаписатьСтроку("<group_creation>" + ?(ЗначениеЗаполнено(Ростовка.ДатаСоздания), Формат(Ростовка.ДатаСоздания, "ДФ='yyyy-MM-dd HH:mm:ss'"), "") + "</group_creation>");

		
		
		//РамзерыНаименование = СтрЗаменить(Сред(Ростовка.Наименование, Найти(Ростовка.Наименование, ",") + 1, Найти(Ростовка.Наименование, "р") - Найти(Ростовка.Наименование, ",") - 1), " ", "");  
		
		МинРазмер = 0;
		МаксРазмер = 0;
		КолРазмеров = 0;
		СписокРазмеровСтрокой = Новый СписокЗначений;
		
		Для Каждого СтрХар Из Ростовка.Характеристики Цикл
			
			ИмяХар = Строка(СтрХар.Характеристика);
			
			// Берём часть после последней запятой
			МассивЧастей = СтрРазделить(ИмяХар, ",");
			РазмерСтрокой = СокрЛП(МассивЧастей[МассивЧастей.Количество() - 1]);
			
			РазмерЧисло = РазмерВЧисло(РазмерСтрокой);
			
			Если РазмерЧисло = Неопределено Тогда
				// размер не числовой (пусто, "XL", диапазон и т.п.) — пропускаем,
				// но запоминаем для текстового наименования
				Если НЕ ПустаяСтрока(РазмерСтрокой)
					И СписокРазмеровСтрокой.НайтиПоЗначению(РазмерСтрокой) = Неопределено Тогда
					СписокРазмеровСтрокой.Добавить(РазмерСтрокой);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			Если МинРазмер = 0 Или РазмерЧисло < МинРазмер Тогда
				МинРазмер = РазмерЧисло;
			КонецЕсли;
			
			Если МаксРазмер = 0 Или РазмерЧисло > МаксРазмер Тогда
				МаксРазмер = РазмерЧисло;
			КонецЕсли;
			
			КолРазмеров = КолРазмеров + 1;
			
		КонецЦикла;
		
		Кол = Ростовка.Характеристики.Количество();
		
		Если КолРазмеров = 0 Тогда
			// числовых размеров нет — используем текстовые значения ("XL", "XL-XXL")
			РазмерыНаименование = СтрСоединить(СписокРазмеровСтрокой.ВыгрузитьЗначения(), "-");
		ИначеЕсли МинРазмер = МаксРазмер Тогда
			РазмерыНаименование = Строка(МинРазмер) + "р";
		Иначе
			РазмерыНаименование = Строка(МинРазмер) + "-" + Строка(МаксРазмер) + "р";
		КонецЕсли;	
		
		
		
		
		// КодЦвета RGB
		КодЦвета = ХарактеристикаОбъект.ПолучитьКодаЦвета();	
		Если ЗначениеЗаполнено(КодЦвета.colorCode) Тогда 				
			ТД.ЗаписатьСтроку("<colorCode>"+КодЦвета.colorCode+"</colorCode>");
		КонецЕсли;
		Если ЗначениеЗаполнено(КодЦвета.colorPath) Тогда
			ТД.ЗаписатьСтроку("<colorPath>"+КодЦвета.colorPath+"</colorPath>");
		КонецЕсли;

		
		
		ТД.ЗаписатьСтроку("<sizeName>"+РазмерыНаименование+"</sizeName>");
		ТД.ЗаписатьСтроку("<stock_quantity>"+ДоступныйОстатокОпт+"</stock_quantity>"); 
		ТД.ЗаписатьСтроку("<price>"+ Формат(ЦенаОпт,"ЧГ=")+"</price>");		
			
		СкладРезерваОпт     = ХарактеристикаОбъект.ПолучитьСкладРезерва(Истина);		
		СтатусОпт = Справочники.Склады.ПолучитьСтатус(Истина,СкладРезерваОпт, Предзаказ);
		Вналичии = СтатусОпт = "1";			  

		ТД.ЗаписатьСтроку("<status_Opt>" + СтатусОпт + "</status_Opt>");				

 	
		Если Не Вналичии Тогда
			ТД.ЗаписатьСтроку("<fabrik_date>" + ХарактеристикаОбъект.ПолучитьДиапазонИзготовления(Истина) + "</fabrik_date>");
		Иначе 
			ТД.ЗаписатьСтроку("<fabrik_date></fabrik_date>");
		КонецЕсли;
		
		ТД.ЗаписатьСтроку("<products>" + КодКомплектующих + "</products>");           
		ТД.ЗаписатьСтроку("<discount_groap>" +  Строка(СкидкаРостовка) + "</discount_groap>");		
	
		ТД.ЗаписатьСтроку("</offer>");                              
		
	КонецЦикла;
	
	ТД.ЗаписатьСтроку("</offers>
					  |</shop>
					  |</yml_catalog>");
	
	ТД.Закрыть();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры 


Функция РазмерВЧисло(Знач Текст)
	
	Текст = СтрЗаменить(Текст, Символ(160), " "); // неразрывный пробел
	Текст = СтрЗаменить(Текст, ",", ".");
	
	Цифры = "0123456789";
	Результат = "";
	ТочкаБыла = Ложь;
	
	Для НомерСимвола = 1 По СтрДлина(Текст) Цикл
		
		ТекСимвол = Сред(Текст, НомерСимвола, 1);
		
		Если СтрНайти(Цифры, ТекСимвол) > 0 Тогда
			Результат = Результат + ТекСимвол;
		ИначеЕсли ТекСимвол = "." И НЕ ТочкаБыла И НЕ ПустаяСтрока(Результат) Тогда
			Результат = Результат + ТекСимвол;
			ТочкаБыла = Истина;
		ИначеЕсли НЕ ПустаяСтрока(Результат) Тогда
			Прервать; // первое число извлечено, дальше не идём
		КонецЕсли;
		
	КонецЦикла;
	
	Если Прав(Результат, 1) = "." Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЕсли;
	
	Если ПустаяСтрока(Результат) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат Число(Результат);
	Исключение
		Попытка
			Возврат Число(СтрЗаменить(Результат, ".", ","));
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

Функция НайтиСимвол(стр,символ)
   позиция=Найти(стр,символ);
   Если СтрЧислоВхождений(стр,символ)<2 Тогда
      Возврат позиция
   Иначе
      Возврат позиция+НайтиСимвол(Прав(стр,СтрДлина(стр)-позиция),символ);
   КонецЕсли;
КонецФункции


	              










