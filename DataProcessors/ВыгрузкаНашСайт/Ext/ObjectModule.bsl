
Перем ТЗНоменклатуры Экспорт;
Перем Комплектующие;


Процедура ВыполнитьВыгрузку(ПутьКФайлу, Номенклатура = Неопределено, новая = Истина, ХарактеритсикаВыбранная = NUll) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если СтрЧислоВхождений(ПутьКФайлу, ".xml") = 0 Тогда
		
		ПутьКФайлу = ПутьКФайлу + ".xml";
		
	КонецЕсли;
	
	
	ТД = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	
	Врем = Формат(ТекущаяДата(), "ДЛФ=T");
	
	Если СтрДлина(Врем) = 7 Тогда
		
		Врем = Лев(Врем, 4);
		
	Иначе
		
		Врем = Лев(Врем, 5);
		
	КонецЕсли;
	
	ТД.ЗаписатьСтроку("<?xml version=""1.0"" encoding=""UTF-8""?>
					  |<!DOCTYPE yml_catalog SYSTEM ""shops.dtd"">
					  |<yml_catalog date=""" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd") + " " + Врем + """>
					  |<shop>
					  |<name>Cvetkov</name>
					  |<url>http://www.cvetkovtm.com/</url>
					  |<currencies>
					  |<currency id=""UAH"" rate=""1""/>
					  |</currencies>");
	
	// Категории
	СпрКат = Справочники.КатегорияНашСайт.Выбрать();	
	ТД.ЗаписатьСтроку("<categories>");
	Пока СпрКат.Следующий() Цикл
		
		Если СпрКат.ПометкаУдаления Или Не СпрКат.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		ТД.ЗаписатьСтроку("<category id=""" + ОбщегоНазначения.УбратьНоликиСлева(СпрКат.Код) + """  parentid=""" + ОбщегоНазначения.УбратьНоликиСлева(СпрКат.Родитель.Код) + """>" + СокрЛП(СпрКат.Наименование) + "</category>");
		
	КонецЦикла;	
	ТД.ЗаписатьСтроку("</categories>");
	
	
	ТипЦены                   = Константы.ТипЦенНашСайт                   .Получить();
	ПроверятьРазбитиеРостовок = Константы.ПроверятьРазбитиеРостовокНашСайт.Получить();
	ГруппаСклада              = Константы.СкладНашСайтРозница             .Получить();
	ГруппаСкладаРозн          = Справочники.Склады                        .ПолучитьСкладыРозн();	
	ВариантВыгрузки           = Константы.ВариантВыгрузкиНашСайт          .Получить();
	
	ВыгружатьТолькоВНаличии = Истина;
	
	ТД.ЗаписатьСтроку("<offers>");	
	Если не новая Тогда   
		ОстаткиКВыгрузке = ОбщегоНазначения.ПолучитьОстаткиКВыгрузке(Номенклатура, ГруппаСклада,,,ВыгружатьТолькоВНаличии,ХарактеритсикаВыбранная);
		Остатки = ОстаткиКВыгрузке.Остатки;
		Комплектующие = ОстаткиКВыгрузке.Комплектующие;

		
		//оферы
		Контрагент = Справочники.Контрагенты.НайтиПоКоду("000000258");
		Договор = Справочники.ДоговорыКонтрагентов.НайтиПоКоду("000000281");
		

		ТаблицаХарактеристик = ОбщегоНазначения.ПолучитьТаблицуХарактеристикДляВыгрузки(Остатки, ТипЦены, "КатегорияНашСайт", ПроверятьРазбитиеРостовок, ВариантВыгрузки, ГруппаСклада,Истина,,ВыгружатьТолькоВНаличии,Контрагент,Договор,Истина);
		
		Для Каждого Стр из ТаблицаХарактеристик Цикл 		
			ЗаписатьНоменклатуру(Стр, ТД, ГруппаСкладаРозн);
		КонецЦикла;

	Иначе 
		ВыгружатьБезЦен = Истина;
		ВыгружатьБезФото = Истина;
		ТаблицаХарактеристик = ОбщегоНазначения.ПолучитьТаблицуОстатков(Номенклатура,ХарактеритсикаВыбранная,ВыгружатьБезЦен,,ВариантВыгрузки,ВыгружатьБезФото); 
		
		Замеры = Новый Соответствие; 	 	
	 	Описание = Новый Соответствие;
    	Текст = "";	
		Пока ТаблицаХарактеристик.Следующий() Цикл 		
			ЗаписатьНоменклатуру1(Текст, ТаблицаХарактеристик, ТД, ГруппаСкладаРозн, Замеры, Описание);
		КонецЦикла;
		
		ТД.ЗаписатьСтроку(Текст);
	КонецЕсли;	
		
	ТД.ЗаписатьСтроку("</offers>
					  |</shop>
					  |</yml_catalog>");
	
	ТД.Закрыть();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

/// Новая выгрузка
 Процедура ЗаписатьНоменклатуру1(Текст, Стр, ТД, ГруппаСкладаРозн, Замеры, Описание)

	 
	Группа                 = стр.Группа;
	Номенклатура           = стр.Номенклатура;
	ЭтоНаборКомплектРучной = стр.ЭтоНаборКомплектРучной;
	Характеристика         = стр.Характеристика;
	СкидкаГруппы           = стр.СкидкаРостовка;
	СкидкаХарактеристики   = СкидкаГруппы;//стр.СкидкаХарактеристики; 
	
	СкидкаРозницы          = стр.СкидкаРозница;
	ЦветЗначение           = стр.Цвет;
	available              = стр.available;

	Ростовка               = стр.Ростовка;
	Штрихкод               = стр.Штрихкод;
	Ткань                  = стр.Ткань;
	ОстатокРозница         = стр.ДоступныйОстатокРозн;
	ОстатокОпт             = стр.ДоступныйОстатокОпт;
	Фото                   = стр.Фото;
	фотоЗамеров            = стр.фотоЗамеров;
	ЦенаОпт                = стр.ЦенаОпт;
	ЦенаДроп               = стр.ЦенаДроп;
	ценаРозница            = стр.ценаРозница;
	ЦенаМелкийОпт          = стр.ЦенаМелкоОпт;
	ЦенаМерчант            = стр.ЦенаМерчант;          
	ЦенаСп                 = стр.ЦенаСп;
	ЦенаРелик              = стр.ЦенаРелик; 
	available_one          = стр.available_one;
                          

	ДатаОкончанияСкидки    = стр.ДатаОкончанияСкидки;
	Сортировка             = стр.Сортировка; 
	показыватьЦенуРостовки = стр.показыватьЦенуРостовки;
	
	
	ПредзаказОпт  = Стр.ПредзаказОпт;
	ПредзаказРозн = Стр.ПредзаказРозн;
	
	
	// Доп информация
	ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
	НоменклатураОбъект   = Номенклатура.ПолучитьОбъект();	

	СкладРезерваОпт     = ХарактеристикаОбъект.ПолучитьСкладРезерва(Истина);
	СкладРезерваРозница = ХарактеристикаОбъект.ПолучитьСкладРезерва(Ложь);
	
	СтатусОпт = Справочники.Склады.ПолучитьСтатус(Истина,СкладРезерваОпт, ПредзаказОпт);
	СтатусРозн = Справочники.Склады.ПолучитьСтатус(Ложь,СкладРезерваРозница, ПредзаказРозн);
	
		
	МассивСкладаОпт = Справочники.Склады.ПолучитьСкладыОпт(); 	
		
	Сообщить("Выгружаем номенклатуру" + Номенклатура + "  " +  Характеристика);
	 
		
	РусскийЯзык = Истина;
	Переводить = Ложь;

				
	//Не в наявності 0
	//в наявності 1
	//На виробництві 2	
	//Предзамовлення 3
	                                           
	ЦветРус         = ЦветЗначение.НаименованиеРус;
	ЦветУкр         = ЦветЗначение.Наименование;  
	ЦветАнг         = ЦветЗначение.Транслитирация;  
	
	ЦветЗначениеОбъект = ЦветЗначение.ПолучитьОбъект();
	
	НужноЗаписатьЦает = Ложь;
	
	Если Не ЗначениеЗаполнено(ЦветРус) тогда
		НужноЗаписатьЦает = Истина;
		ЦветЗначениеОбъект.НаименованиеРус = ОбщегоНазначения.Транслитерация(ЦветЗначение.Наименование);
	КонецЕсли; 
	
	
	Если Не ЗначениеЗаполнено(ЦветУкр)  тогда
		НужноЗаписатьЦает = Истина;
		ЦветЗначениеОбъект.Наименование = ОбщегоНазначения.Транслитерация(ЦветЗначение.НаименованиеРус);
	КонецЕсли; 	
	
	
	Если Не ЗначениеЗаполнено(ЦветАнг) И  ЗначениеЗаполнено(ЦветЗначение.НаименованиеРус) тогда
		НужноЗаписатьЦает = Истина;
		ЦветЗначениеОбъект.Транслитирация = ОбщегоНазначения.Транслитерация(ЦветЗначение.НаименованиеРус);
	КонецЕсли; 
	
	
	Если Не ЗначениеЗаполнено(ЦветАнг) И ЗначениеЗаполнено(ЦветЗначение.Наименование) тогда
		НужноЗаписатьЦает = Истина;
		ЦветЗначениеОбъект.Транслитирация = ОбщегоНазначения.Транслитерация(ЦветЗначение.Наименование);
	КонецЕсли;
	
	
	Если НужноЗаписатьЦает Тогда
		ЦветЗначениеОбъект.Записать();
	КонецЕсли;
	
	ЦветРус         = ЦветЗначение.НаименованиеРус;
	ЦветУкр         = ЦветЗначение.Наименование;  
	ЦветАнг         = ЦветЗначение.Транслитирация; 
	
	
	//ДобавитьСтроку(Текст,("<offer  group_id="""+group_id+""" selling_type=""r"" type=""vendor.model"" id="""+Ид+ """ model_id="""+model_id+ """ available="""+ available +""">"); 
	
	 
	Ид = ХарактеристикаОбъект.ИдДляВыгрузки();
	ЦветКод        = ХарактеристикаОбъект.ПолучитьКодЦвета(); 
	ТканьКод       = ХарактеристикаОбъект.ПолучитьКодТкани(); 
	
	group_id = НоменклатураОбъект.КодБезНоликов()+ЦветКод+ТканьКод;
	model_id = НоменклатураОбъект.КодБезНоликов();
	ДобавитьСтроку(Текст,("<offer  group_id="""+group_id+""" selling_type=""r"" type=""vendor.model"" id="""+Ид+ """ model_id="""+model_id+ """ available="""+ available +""" available_one="""+ available_one +""">")); 
	
	color_group_id = model_id+ЦветКод ;   
	ДобавитьСтроку(Текст,("<color_group_id>"+color_group_id+"</color_group_id>"));
	
	//Категория
	КодКатегории = ОбщегоНазначения.УбратьНоликиСлева(Номенклатура.КатегорияНашСайт.Родитель.Код);
	ДобавитьСтроку(Текст,("<categoryId>"+КодКатегории+"</categoryId>"));
			
	// Наименование
	Наим = НоменклатураОбъект.Наименование(Истина);
	НаимУкр =  НоменклатураОбъект.Наименование(Ложь);
	НаимАнгл = НоменклатураОбъект.Наименование();
	
	ДобавитьСтроку(Текст,("<model>"+Наим+"</model>"));
	ДобавитьСтроку(Текст,("<model_ua>"+НаимУкр+"</model_ua>"));
	ДобавитьСтроку(Текст,("<model_en>"+НаимАнгл+"</model_en>"));
	
	ДобавитьСтроку(Текст,("<sort>"+ Сортировка +"</sort>"));
	ДобавитьСтроку(Текст,("<currencyId>UAH</currencyId>"));	
	ДобавитьСтроку(Текст,("<year>" + Прав(Номенклатура.Родитель.Наименование,4)+ "</year>"));
	//ДобавитьСтроку(Текст,("<param name=""Страна производитель"">Украина</param>");
	ДобавитьСтроку(Текст,("<article>" + Номенклатура.Артикул + " " + ОбщегоНазначения.УбратьНоликиСлева(Характеристика.Код) + "</article>"));
	ДобавитьСтроку(Текст,("<product_image_alt>" + НоменклатураОбъект.ПолучитьНаименованиеДляВыгрузки(Истина) + "</product_image_alt>"));
	ДобавитьСтроку(Текст,("<product_image_title>" + НоменклатураОбъект.ПолучитьНаименованиеДляВыгрузки(Ложь) + "</product_image_title>"));
	ДобавитьСтроку(Текст,("<product_image_single_title>" + НоменклатураОбъект.ПолучитьНаименованиеДляВыгрузки(Ложь, Истина) + "</product_image_single_title>"));

	
	Попытка
		product_visible = ?(Номенклатура.НеПоказыватьОпт,"1","2");
		ДобавитьСтроку(Текст,("<product_visible>" + product_visible + "</product_visible>"));
	Исключение
		ДобавитьСтроку(Текст,("<product_visible>2</product_visible>"));
	КонецПопытки;

	Попытка
		ДобавитьСтроку(Текст,("<accessLevel>" + КатегоризацияКлиентов.КодУровня(Номенклатура.КатегорияВидимости) + "</accessLevel>"));
	Исключение
		ДобавитьСтроку(Текст,("<accessLevel>Всем</accessLevel>"));
	КонецПопытки;

	ДобавитьСтроку(Текст,("<barcode>" + ОбщегоНазначения.ШтрихкодХарактеристики(Характеристика) + "</barcode>"));		
	ДобавитьСтроку(Текст,("<alt_teg>" + Номенклатура.АльтТеги + "</alt_teg>"));		
	ДобавитьСтроку(Текст,("<group_creation>" + ?(ЗначениеЗаполнено(Ростовка.ДатаСоздания), Формат(Ростовка.ДатаСоздания, "ДФ='yyyy-MM-dd HH:mm:ss'"), Формат(Дата(2015, 1, 1, 0, 0, 0), "ДФ='yyyy-MM-dd HH:mm:ss'")) + "</group_creation>"));
		
		 
	ДобавитьСтроку(Текст,("<stock_quantity_opt>"  + ОстатокОпт + "</stock_quantity_opt>"));
	ДобавитьСтроку(Текст,("<stock_quantity_rozn>" + ОстатокРозница + "</stock_quantity_rozn>"));
	
	ДобавитьСтроку(Текст,("<status_Rozn>" + СтатусРозн  + "</status_Rozn>"));
	ДобавитьСтроку(Текст,("<status_Opt>" + СтатусОпт  + "</status_Opt>"));
	
	Если СтатусРозн <> "1" Тогда
		ДобавитьСтроку(Текст,("<fabrik_date_rozn>" + ХарактеристикаОбъект.ПолучитьДиапазонИзготовления(Ложь) + "</fabrik_date_rozn>"));
	Иначе 
		ДобавитьСтроку(Текст,("<fabrik_date_rozn></fabrik_date_rozn>"));
	КонецЕсли;
	
	Если СтатусОпт <> "1" Тогда
		ДобавитьСтроку(Текст,("<fabrik_date_opt>" + ХарактеристикаОбъект.ПолучитьДиапазонИзготовления(Истина) + "</fabrik_date_opt>"));
	Иначе 
		ДобавитьСтроку(Текст,("<fabrik_date_opt></fabrik_date_opt>"));
	КонецЕсли;
	 
	//Предзаказ
	//Если Предзаказ Тогда
	//	ДобавитьСтроку(Текст,("<pro_label>10</pro_label>");
	//КонецЕсли;
	
	// Ключевые слова
	КлючевыйСловаГруппы = ОбщегоНазначения.КлючевыйСловаГруппы(Номенклатура.НоменклатурнаяГруппа);
	ДобавитьСтроку(Текст,("<keywords>"+КлючевыйСловаГруппы+"</keywords>"));
	
	
	ДобавитьСтроку(Текст,("<showOptPrice>" + показыватьЦенуРостовки + "</showOptPrice>"));
	
	ЭтоСкладРозница = Ложь;
	Если СкладРезерваРозница <> Неопределено Тогда
		ЭтоСкладРозница = СкладРезерваРозница.Розница;
	КонецЕсли; 
	
	//Цены 
	ДобавитьСтроку(Текст,("<priceOpt>"      +  Формат(ЦенаОпт,"ЧГ=") + "</priceOpt>"));
	ДобавитьСтроку(Текст,("<priceMOpt>"     +  Формат(?(ЭтоСкладРозница,ценаРозница,ЦенаМелкийОпт),"ЧГ=")+ "</priceMOpt>"));
	ДобавитьСтроку(Текст,("<priceRoz>"      +  Формат(ценаРозница,"ЧГ=") + "</priceRoz>"));
	ДобавитьСтроку(Текст,("<pricedrop>"     +  Формат(ЦенаДроп,"ЧГ=") + "</pricedrop>"));
	ДобавитьСтроку(Текст,("<priceRelik>"    +  Формат(ЦенаРелик,"ЧГ=") + "</priceRelik>"));
	ДобавитьСтроку(Текст,("<priceSP>"       +  Формат(ЦенаСп,"ЧГ=") + "</priceSP>"));
	ДобавитьСтроку(Текст,("<priceMerchant>" +  Формат(ЦенаМерчант,"ЧГ=")  + "</priceMerchant>")); 
	
	ДобавитьСтроку(Текст,("<discount_rozn>"  +  СкидкаРозницы  + "</discount_rozn>"));	
	ДобавитьСтроку(Текст,("<discount_groap>" +  СкидкаГруппы  + "</discount_groap>"));
	ДобавитьСтроку(Текст,("<discount_character>" + СкидкаХарактеристики + "</discount_character>"));  //Скидка мелко оптовой
		
	//фото
	ЗаписатьПустойТег_picture = Истина;	
	Если ЗначениеЗаполнено(фото) Тогда
		
		ТабФото = ОбщегоНазначения.ФотографииГруппыЦветов(фото, Ложь,Истина);
		
		Для Каждого Фот Из ТабФото Цикл
			
			Если Фот.НеВыгружать Тогда
				Продолжить;
			КонецЕсли;
			ЗаписатьПустойТег_picture = Ложь;
			
			ИмяФото = Фот.НаименованиеWebp;
			ИмяФото = Лев(ИмяФото, НайтиСимвол(ИмяФото, ".")-1);
						
			Если Фот.Название = "Video" Тогда
				ДобавитьСтроку(Текст,("<video>" + Фот.Наименование + "</video>"));
			Иначе 
				Если Фот.Главная тогда 
					ДобавитьСтроку(Текст,("<cover"+?(Фот.НеВыгружатьРозница," isOptOnly=""1"""," isOptOnly=""0""")+">"  + ИмяФото + "</cover>"));
				КонецЕсли;           	
				ДобавитьСтроку(Текст,("<picture"+?(Фот.НеВыгружатьРозница," isOptOnly=""1"""," isOptOnly=""0""")+">"  + ИмяФото + "</picture>"));
			КонецЕсли;
									
		КонецЦикла;	
	КонецЕсли;
	
	Если ЗаписатьПустойТег_picture Тогда
		
		ДобавитьСтроку(Текст,("<picture></picture>"));
	
	КонецЕсли;
			
	// КодЦвета RGB
	КодЦвета = ХарактеристикаОбъект.ПолучитьКодаЦвета();	
	Если ЗначениеЗаполнено(КодЦвета.colorCode) Тогда 				
		ДобавитьСтроку(Текст,("<colorCode>"+КодЦвета.colorCode+"</colorCode>"));
	КонецЕсли;
	Если ЗначениеЗаполнено(КодЦвета.colorPath) Тогда
		ДобавитьСтроку(Текст,("<colorPath>"+КодЦвета.colorPath+"</colorPath>"));
	КонецЕсли;
	

	
	//ДобавитьСтроку(Текст,("<discount_date_end>" + ?(ЗначениеЗаполнено(ДатаОкончанияСкидки), Формат(ДатаОкончанияСкидки, "ДФ='yyyy-MM-dd HH:mm:ss'"), "") + "</discount_date_end>");
	
	Если ЗначениеЗаполнено(ДатаОкончанияСкидки) Тогда
			ДобавитьСтроку(Текст,("<discount_date_end>" +  Формат(ДатаОкончанияСкидки, "ДФ='yyyy-MM-dd HH:mm:ss'") + "</discount_date_end>"));
	КонецЕсли;
	ДобавитьСтроку(Текст,("<color_ru>"+ЦветРус+"</color_ru>"));
	ДобавитьСтроку(Текст,("<color_ua>"+ЦветУкр+"</color_ua>"));	 
	ДобавитьСтроку(Текст,("<color_en>"+ЦветАнг+"</color_en>"));	 
	
	//Параметры
	ИсключениеСвойств = Новый Массив;
	ИсключениеСвойств.Добавить("000000069");
	ИсключениеСвойств.Добавить("000000072");
	ТабПараметры = ОбщегоНазначения.ПараметрыКВыгрузке("НашСайт");
	Свойства = ОбщегоНазначения.ЗаписатьСвойстваДляХарактеритси(ТабПараметры ,Номенклатура.КатегорияНашСайт ,Характеристика,"name","paramid","valueid",ИсключениеСвойств); 
	ДобавитьСтроку(Текст, Свойства);
		
	//Описание
	//ОписаниеРус = ОбщегоНазначения.ОписаниеДляХарактеристики(Характеристика,РусскийЯзык, Истина);
	
	//ОписаниеРус = "<![CDATA["+ОписаниеРус+"]]>";
	
	ЗамерыЗначение = Замеры.Получить(Номенклатура);
	Если Не ЗначениеЗаполнено(ЗамерыЗначение) Тогда
		ЗамерыЗначение ="<measurements><![CDATA["+ОбщегоНазначения.ЗамерыТовара(Характеристика)+"]]></measurements>"; 
		Замеры.Вставить(Номенклатура,ЗамерыЗначение);
	КонецЕсли;   
	ДобавитьСтроку(Текст, ЗамерыЗначение);
	
	ОписаниеЗначение = Описание.Получить(Номенклатура);  	
	Если Не ЗначениеЗаполнено(ОписаниеЗначение) Тогда	
		ОписаниеЗначение = "<description><![CDATA["+ОбщегоНазначения.ОписаниеДляХарактеристики(Характеристика,НЕ РусскийЯзык)+"]]></description>";
		Описание.Вставить(Номенклатура,ОписаниеЗначение);
	КонецЕсли; 
	ДобавитьСтроку(Текст,ОписаниеЗначение); 
	ДобавитьСтроку(Текст,"</offer>"); 		
КонецПроцедуры

Процедура ДобавитьСтроку(Текст, Строка) 
	  Текст = Текст + Строка + Символы.ПС;
КонецПроцедуры

Процедура ЗаписатьНоменклатуру(Стр, ТД, ГруппаСкладаРозн)
	
	// Из Строки 
	Цена                 = Стр.Цена;	
	ПерваяЦена           = стр.ПерваяЦена;
	СпрГруппыЦветов	     = Стр.ГруппаЦвета;
	Номенклатура         = Стр.Номенклатура;	
	Характеристика       = Стр.Характеристика;
	Ид                   = Стр.ИД;
	ИдГуппы              = Стр.ИдГуппы;
	Доступна             = Стр.Доступна;
	ШтрихКод             = Стр.ШтрихКод;
	Скидка               = Стр.Скидка;
	ДатаОкончанияСкидки  = Стр.ДатаОкончанияСкидки;
	
	Ростовка             = Стр.Ростовка;
	Предзаказ            = Стр.Предзаказ;
	ЦветКод              = Стр.ЦветКод; 
	ТканьКод             = Стр.ТканьКод; 
	Наценка              = Стр.Наценка;
	markup               = Стр.markup;
	
	
	
	// Доп информация
	ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
	НоменклатураОбъект   = Номенклатура.ПолучитьОбъект();	
	ЦветЗначение = ХарактеристикаОбъект.ПолучитьЗначениеЦвета();

	СкладРезерваОпт     = ХарактеристикаОбъект.ПолучитьСкладРезерва(Истина);
	СкладРезерваРозница = ХарактеристикаОбъект.ПолучитьСкладРезерва(Ложь);
	
	СтатусОпт = Справочники.Склады.ПолучитьСтатус(Истина,СкладРезерваОпт, Предзаказ);
	СтатусРозн = Справочники.Склады.ПолучитьСтатус(Ложь,СкладРезерваРозница, Предзаказ);
	
	ОстатокРозница = Стр.Остаток;
	
	МассивСкладаОпт = Справочники.Склады.ПолучитьСкладыОпт(); 	
	ОстатокОпт      = ХарактеристикаОбъект.СвободныйОстаток(МассивСкладаОпт);
		
	Доступна        = (Доступна Или Предзаказ Или ОстатокОпт>0); 
	available       = ?(Доступна,"true","false");
	
	НКХар = ХарактеристикаОбъект.ХарактеристикаРостовки();
	НКНом = НКХар.Владелец;
	СкидкаГруппы    =  ЦеноОбразование.ПолучитьОбщуюСкидку(НКНом, НКХар).ПроцентСкидкиНаценки; //Ростовка.ПолучитьОбъект().ПолучитьСкидку();
	
	РусскийЯзык = Истина;
	Переводить = Ложь;

				
	//Не в наявності 0
	//в наявності 1
	//На виробництві 2	
	//Предзамовлення 3
	                                           
	ЦветРус         = ХарактеристикаОбъект.ЦветХарактеристики(РусскийЯзык, Переводить);
	ЦветУкр         = ХарактеристикаОбъект.ЦветХарактеристики(НЕ РусскийЯзык, Переводить);  
	ЦветАнг         = ХарактеристикаОбъект.ПолучитьЗначениеЦвета().Транслитирация;  
	
	
	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	
	group_id = НоменклатураОбъект.КодБезНоликов()+ЦветКод+ТканьКод; 
	
	Если Не ЗначениеЗаполнено(group_id) Тогда
		Возврат;
	КонецЕсли;
	
	ТД.ЗаписатьСтроку("<offer  group_id="""+group_id+""" selling_type=""r"" type=""vendor.model"" id="""+Ид+ """ model_id="""+НоменклатураОбъект.КодБезНоликов()+ """ available="""+ available +""">"); 

	colorId = НоменклатураОбъект.КодБезНоликов()+ЦветКод; 
	ТД.ЗаписатьСтроку("<colorId>"+colorId+"</colorId>");
	
	//Категория
	КодКатегории = ОбщегоНазначения.УбратьНоликиСлева(Стр.Номенклатура.КатегорияНашСайт.Родитель.Код);
	ТД.ЗаписатьСтроку("<categoryId>"+КодКатегории+"</categoryId>");
			
	// Наименование
	Наим = НоменклатураОбъект.Наименование(Истина);
	НаимУкр =  НоменклатураОбъект.Наименование(Ложь);
	НаимАнгл = НоменклатураОбъект.Наименование();
	
	ТД.ЗаписатьСтроку("<model>"+Наим+"</model>");
	ТД.ЗаписатьСтроку("<model_ua>"+НаимУкр+"</model_ua>");
	ТД.ЗаписатьСтроку("<model_en>"+НаимАнгл+"</model_en>");
	
	Попытка
		ТД.ЗаписатьСтроку("<sort>"+ ЦветЗначение.Сортировка +"</sort>");
	Исключение
		ТД.ЗаписатьСтроку("<sort></sort>");
	КонецПопытки;
	
	ТД.ЗаписатьСтроку("<currencyId>UAH</currencyId>");
		
	ТД.ЗаписатьСтроку("<year>" + Прав(Номенклатура.Родитель.Наименование,4)+ "</year>");
	//ТД.ЗаписатьСтроку("<param name=""Страна производитель"">Украина</param>");
	ТД.ЗаписатьСтроку("<article>" + Номенклатура.Артикул + " " + ОбщегоНазначения.УбратьНоликиСлева(Характеристика.Код) + "</article>");
	ТД.ЗаписатьСтроку("<product_image_alt>" + НоменклатураОбъект.ПолучитьНаименованиеДляВыгрузки(Истина) + "</product_image_alt>");
	ТД.ЗаписатьСтроку("<product_image_title>" + НоменклатураОбъект.ПолучитьНаименованиеДляВыгрузки(Ложь) + "</product_image_title>");
	ТД.ЗаписатьСтроку("<product_image_single_title>" + НоменклатураОбъект.ПолучитьНаименованиеДляВыгрузки(Ложь, Истина) + "</product_image_single_title>");

	
	Попытка
		product_visible = ?(Номенклатура.НеПоказыватьОпт,"1","2");
		ТД.ЗаписатьСтроку("<product_visible>" + product_visible + "</product_visible>");
	Исключение
		ТД.ЗаписатьСтроку("<product_visible>2</product_visible>");
	КонецПопытки;
	
	ТД.ЗаписатьСтроку("<barcode>" + ОбщегоНазначения.ШтрихкодХарактеристики(Характеристика) + "</barcode>");		
	ТД.ЗаписатьСтроку("<alt_teg>" + Номенклатура.АльтТеги + "</alt_teg>");		
	ТД.ЗаписатьСтроку("<group_creation>" + ?(ЗначениеЗаполнено(Ростовка.ДатаСоздания), Формат(Ростовка.ДатаСоздания, "ДФ='yyyy-MM-dd HH:mm:ss'"), "") + "</group_creation>");
		
	// Наличие и остатки
	
	Попытка 
		ОстатокОп = ?(ЦветЗначение.НеПоказыватьОпт,0,(?(Предзаказ,?(ростовка.ИнКоличество=0,10,ОстатокОпт + ростовка.ИнКоличество),ОстатокОпт)));
		ТД.ЗаписатьСтроку("<stock_quantity_opt>"  + Формат(?(ОстатокОп<0,0,ОстатокОп), "ЧН=0; ЧГ=0") + "</stock_quantity_opt>");
	Исключение
		ОстатокОп =  ?(Предзаказ,?(ростовка.ИнКоличество=0,10,ОстатокОпт + ростовка.ИнКоличество),ОстатокОпт);
		ТД.ЗаписатьСтроку("<stock_quantity_opt>"  + Формат( ?(ОстатокОп<0,0,ОстатокОп), "ЧН=0; ЧГ=0") + "</stock_quantity_opt>");
	КонецПопытки;
	
	ОстатокРо = ?(Предзаказ,?(ростовка.ИнКоличество=0,5,ОстатокРозница + ростовка.ИнКоличество),ОстатокРозница);
	ТД.ЗаписатьСтроку("<stock_quantity_rozn>" + Формат(?(ОстатокРо<0,0,ОстатокРо), "ЧН=0; ЧГ=0") + "</stock_quantity_rozn>");
	
	ТД.ЗаписатьСтроку("<status_Rozn>" + СтатусРозн  + "</status_Rozn>");
	ТД.ЗаписатьСтроку("<status_Opt>" + СтатусОпт  + "</status_Opt>");
	
	Если СтатусРозн <> "1" Тогда
		ТД.ЗаписатьСтроку("<fabrik_date_rozn>" + ХарактеристикаОбъект.ПолучитьДиапазонИзготовления(Ложь) + "</fabrik_date_rozn>");
	Иначе 
		ТД.ЗаписатьСтроку("<fabrik_date_rozn></fabrik_date_rozn>");
	КонецЕсли;
	
	Если СтатусОпт <> "1" Тогда
		ТД.ЗаписатьСтроку("<fabrik_date_opt>" + ХарактеристикаОбъект.ПолучитьДиапазонИзготовления(Истина) + "</fabrik_date_opt>");
	Иначе 
		ТД.ЗаписатьСтроку("<fabrik_date_opt></fabrik_date_opt>");
	КонецЕсли;
	 
	//Предзаказ
	//Если Предзаказ Тогда
	//	ТД.ЗаписатьСтроку("<pro_label>10</pro_label>");
	//КонецЕсли;
	
	// Ключевые слова
	КлючевыйСловаГруппы = ОбщегоНазначения.КлючевыйСловаГруппы(Номенклатура.НоменклатурнаяГруппа);
	ТД.ЗаписатьСтроку("<keywords>"+КлючевыйСловаГруппы+"</keywords>");

	//Цены 
	ЗаписатьЦены(Характеристика,Скидка,Тд, Наценка,СкладРезерваРозница );
	
	ТД.ЗаписатьСтроку("<discount_groap>" + ОбщегоНазначения.НормальноеЧисло(СкидкаГруппы) + "</discount_groap>");
	ТД.ЗаписатьСтроку("<markup>" +  ОбщегоНазначения.НормальноеЧисло(markup) + "</markup>");  //Скидка мелко оптовой

	//фото
	ЗаписатьПустойТег_picture = Истина;	
	Если ЗначениеЗаполнено(СпрГруппыЦветов) Тогда
		
		ТабФото = ОбщегоНазначения.ФотографииГруппыЦветов(СпрГруппыЦветов, Ложь, );
		
		Для Каждого Фот Из ТабФото Цикл
			
			Если Фот.НеВыгружать Тогда
				Продолжить;
			КонецЕсли;
			ЗаписатьПустойТег_picture = Ложь;
			
			ИмяФото = Фот.НаименованиеWebp;
			ИмяФото = Лев(ИмяФото, НайтиСимвол(ИмяФото, ".")-1);
						
			Если Фот.Название = "Video" Тогда
				ТД.ЗаписатьСтроку("<video>" + Фот.Наименование + "</video>");
			Иначе 
				Если Фот.Главная тогда 
					ТД.ЗаписатьСтроку("<cover"+?(Фот.НеВыгружатьРозница," isOptOnly=""1"""," isOptOnly=""0""")+">"  + ИмяФото + "</cover>");
				КонецЕсли;           
				
				
				ТД.ЗаписатьСтроку("<picture"+?(Фот.НеВыгружатьРозница," isOptOnly=""1"""," isOptOnly=""0""")+">"  + ИмяФото + "</picture>");
			
		КонецЕсли;
				
						
		КонецЦикла;	
	КонецЕсли;
	
	Если ЗаписатьПустойТег_picture Тогда
		
		ТД.ЗаписатьСтроку("<picture></picture>");
	
	КонецЕсли;
			
	// КодЦвета RGB
	КодЦвета = ХарактеристикаОбъект.ПолучитьКодаЦвета();	
	Если ЗначениеЗаполнено(КодЦвета.colorCode) Тогда 				
		ТД.ЗаписатьСтроку("<colorCode>"+КодЦвета.colorCode+"</colorCode>");
	КонецЕсли;
	Если ЗначениеЗаполнено(КодЦвета.colorPath) Тогда
		ТД.ЗаписатьСтроку("<colorPath>"+КодЦвета.colorPath+"</colorPath>");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЦветРус) тогда 
		сообщить("пустой цвет" + Характеристика);
	КонецЕсли;
	
	//ТД.ЗаписатьСтроку("<discount_date_end>" + ?(ЗначениеЗаполнено(ДатаОкончанияСкидки), Формат(ДатаОкончанияСкидки, "ДФ='yyyy-MM-dd HH:mm:ss'"), "") + "</discount_date_end>");
	
	Если ЗначениеЗаполнено(ДатаОкончанияСкидки) Тогда
			ТД.ЗаписатьСтроку("<discount_date_end>" +  Формат(ДатаОкончанияСкидки, "ДФ='yyyy-MM-dd HH:mm:ss'") + "</discount_date_end>");
	КонецЕсли;
	ТД.ЗаписатьСтроку("<color_ru>"+ЦветРус+"</color_ru>");
	ТД.ЗаписатьСтроку("<color_ua>"+ЦветУкр+"</color_ua>");	 
	ТД.ЗаписатьСтроку("<color_en>"+ЦветАнг+"</color_en>");	 
	
	//Параметры
	ИсключениеСвойств = Новый Массив;
	ИсключениеСвойств.Добавить("000000069");
	ИсключениеСвойств.Добавить("000000072");
	ТабПараметры = ОбщегоНазначения.ПараметрыКВыгрузке("НашСайт");
	Свойства = ОбщегоНазначения.ЗаписатьСвойстваДляХарактеритси(ТабПараметры ,Номенклатура.КатегорияНашСайт ,Характеристика,"name","paramid","valueid",ИсключениеСвойств);
	ТД.ЗаписатьСтроку(Свойства);	
	//Описание
	//ОписаниеРус = ОбщегоНазначения.ОписаниеДляХарактеристики(Характеристика,РусскийЯзык, Истина);
	ОписаниеУкр = ОбщегоНазначения.ОписаниеДляХарактеристики(Характеристика,НЕ РусскийЯзык);
	//ОписаниеРус = "<![CDATA["+ОписаниеРус+"]]>";
	
	ТД.ЗаписатьСтроку("<measurements><![CDATA["+ОбщегоНазначения.ЗамерыТовара(Характеристика)+"]]></measurements>"); 
	ТД.ЗаписатьСтроку("<description><![CDATA["+ОписаниеУкр+"]]></description>");
	//ТД.ЗаписатьСтроку("<description_ua>"+ОписаниеУкр+"</description_ua>");
	
	ТД.ЗаписатьСтроку("</offer>");
	
КонецПроцедуры

Процедура ЗаписатьЦены(Характеристика,Скидка, Тд, Наценка, СкладРезерваРозница)
	
	ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
	НеИспользоватьПервыеЦены = Характеристика.Владелец.НеИспользоватьПервыеЦены;
	ОптЦ    = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000001");
	МОптЦ  = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000014");   
	
	
	Если СкладРезерваРозница.Розница Тогда
		МОптЦ  = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000020");  
	Иначе 
		МОптЦ  = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000014");  
	КонецЕсли;
	
	РознЦ  = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000020");
	ДропЦ  = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000002");
	РеликЦ  = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000005");
	СПЦ     = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000022");
	мерчант = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000018");	
	
	//Если Наценка > 70 Тогда
	Если (Не ( Наценка < 70 И Наценка <= 100)) ИЛИ НеИспользоватьПервыеЦены Тогда
		ЦенаРозн  = ХарактеристикаОбъект.ПолучитьЦену(РознЦ);
		//ЦенаМОпт  = ХарактеристикаОбъект.ПолучитьЦену(МОптЦ);
	Иначе
		
		//ЦенаДроп    = ХарактеристикаОбъект.ПолучитьЦенуПервую(ДропЦ);			
		//ЦенаРелик   = ХарактеристикаОбъект.ПолучитьЦенуПервую(РеликЦ);
		
		//ЦенаСП      = ХарактеристикаОбъект.ПолучитьЦенуПервую(СПЦ);
		//ЦенаМерчант = ХарактеристикаОбъект.ПолучитьЦенуПервую(мерчант);

		ЦенаРозн    = ХарактеристикаОбъект.ПолучитьЦенуПервую(РознЦ);
		//ЦенаМОпт  = ХарактеристикаОбъект.ПолучитьЦенуПервую(МОптЦ);
	КонецЕсли;
	
	ЦенаДроп  = ХарактеристикаОбъект.ПолучитьЦену(ДропЦ); 
	ЦенаРелик = ХарактеристикаОбъект.ПолучитьЦену(РеликЦ);
	
	ЦенаСП      = ХарактеристикаОбъект.ПолучитьЦену(СПЦ);  
	ЦенаМерчант = ХарактеристикаОбъект.ПолучитьЦену(мерчант);
	  		
		
	ЦенаОпт   = ХарактеристикаОбъект.ПолучитьЦену(ОптЦ);   
	ЦенаМОпт  = ХарактеристикаОбъект.ПолучитьЦену(МОптЦ);

		
	ТД.ЗаписатьСтроку("<priceOpt>"      + Формат(ЦенаОпт,  "ЧГ=") + "</priceOpt>");
	ТД.ЗаписатьСтроку("<priceMOpt>"     + Формат(ЦенаМОпт, "ЧГ=") + "</priceMOpt>");
	ТД.ЗаписатьСтроку("<priceRoz>"      + Формат(ЦенаРозн, "ЧГ=") + "</priceRoz>");
	ТД.ЗаписатьСтроку("<pricedrop>"     + Формат(ЦенаДроп, "ЧГ=") + "</pricedrop>");
	ТД.ЗаписатьСтроку("<priceRelik>"    + Формат(ЦенаРелик,"ЧГ=") + "</priceRelik>");
	ТД.ЗаписатьСтроку("<priceSP>"       + Формат(ЦенаСП,   "ЧГ=") + "</priceSP>");
	ТД.ЗаписатьСтроку("<priceMerchant>" + Формат(Окр(ЦенаМерчант * (100 - скидка) / 100,0)   ,   "ЧГ=") + "</priceMerchant>");
	
	//скидка
