// Разовое выравнивание НомерЗаказа2ССайта: номер заказа с сайта приводится
// к тому виду, в каком его видит покупатель - шесть знаков с ведущими нулями.
//
// Зачем. Сайт показывает «032760», а в 1С до 16.08.2026 лежало «32760»: номер
// брался прямо из атрибута id выгрузки. Менеджер копировал номер из письма и
// не находил заказ поиском по строке. С 16.08.2026 новые заказы с нашего сайта
// пишутся уже нормализованными (ОбменПокупателямиНашСайт), эта обработка
// доводит до того же вида старые.
//
// Что НЕ трогается: номера маркетплейсов. Розетка, Каста и Пром кладут в этот
// же реквизит свои идентификаторы - девятизначные, иногда буквенные. Правило
// нормализации (ОбщегоНазначения.НомерЗаказаССайтаНормализованный) дополняет
// только чисто цифровые значения короче шести знаков, всё остальное возвращает
// как есть, поэтому такие заказы в список просто не попадут.
//
// Порядок работы: «Показать изменения» -> глазами по списку «было -> станет»
// -> «Записать». Само по себе нажатие первой кнопки ничего не меняет.

&НаКлиенте
Процедура ПоказатьИзменения(Команда)

	ПоказатьИзмененияНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПоказатьИзмененияНаСервере()

	Строки.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка КАК Заказ,
	|	ЗаказПокупателя.НомерЗаказа2ССайта КАК Было
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.НомерЗаказа2ССайта <> """"
	|	И ЗаказПокупателя.Дата МЕЖДУ &ДатаС И &ДатаПо
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата";

	// Пустая дата - без ограничения с этой стороны, а не «за 0001 год»
	Запрос.УстановитьПараметр("ДатаС",
		?(ЗначениеЗаполнено(ДатаНачала), НачалоДня(ДатаНачала), '00010101'));
	Запрос.УстановитьПараметр("ДатаПо",
		?(ЗначениеЗаполнено(ДатаОкончания), КонецДня(ДатаОкончания), '39991231235959'));

	Выборка = Запрос.Выполнить().Выбрать();

	Просмотрено = 0;

	Пока Выборка.Следующий() Цикл

		Просмотрено = Просмотрено + 1;

		Станет = ОбщегоНазначения.НомерЗаказаССайтаНормализованный(Выборка.Было);

		Если Станет = СокрЛП(Выборка.Было) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.Заказ  = Выборка.Заказ;
		НоваяСтрока.Было   = Выборка.Было;
		НоваяСтрока.Станет = Станет;

	КонецЦикла;

	Итого = "Заказов с номером сайта за период: " + Просмотрено
		+ Символы.ПС
		+ "Из них поменяют номер: " + Строки.Количество()
		+ Символы.ПС
		+ "Ничего ещё не записано - для записи нажмите «Записать».";

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИзменения(Команда)

	Если Строки.Количество() = 0 Тогда
		ПоказатьПредупреждение(,
			"Список пуст. Сначала нажмите «Показать изменения».");
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ЗаписатьИзмененияЗавершение", ЭтотОбъект),
		"Дописать нули в номерах " + Строки.Количество() + " заказов?"
			+ Символы.ПС
			+ "Обратно это только вручную.",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИзмененияЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьИзмененияНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаписатьИзмененияНаСервере()

	Записано = 0;
	Ошибок   = 0;

	Для Каждого СтрокаСписка Из Строки Цикл

		Если Не ЗначениеЗаполнено(СтрокаСписка.Заказ)
			Или СтрокаСписка.Было = СтрокаСписка.Станет Тогда

			Продолжить;

		КонецЕсли;

		Попытка

			ДокументОбъект = СтрокаСписка.Заказ.ПолучитьОбъект();

			// Заказ мог быть удалён другим сеансом, пока список висел на экране
			Если ДокументОбъект = Неопределено Тогда
				Ошибок = Ошибок + 1;
				Продолжить;
			КонецЕсли;

			ДокументОбъект.НомерЗаказа2ССайта = СтрокаСписка.Станет;

			// Загрузка = Истина обязательна: подписка ИзменениСтатусаЗаказаПриЗаписи
			// и ПередЗаписью/ПриЗаписи модуля заказа первым делом проверяют этот
			// флаг и выходят. Без него выравнивание разослало бы покупателям СМС
			// о смене статуса и наплодило возвратов и внутренних перемещений.
			ДокументОбъект.ОбменДанными.Загрузка = Истина;

			// РежимЗаписи.Запись, а не Проведение: проведённый заказ остаётся
			// проведённым, движения не пересчитываются - меняется один реквизит
			// шапки, который ни на что не влияет.
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);

			Записано = Записано + 1;

		Исключение

			Ошибок = Ошибок + 1;

			ЗаписьЖурналаРегистрации(
				"Номера заказов с сайта.Выравнивание",
				УровеньЖурналаРегистрации.Ошибка,
				,
				СтрокаСписка.Заказ,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

	КонецЦикла;

	// Пересобираем список: после записи он должен опустеть, и это самая
	// честная проверка того, что выравнивание действительно прошло.
	// Итого выставляем ПОСЛЕ - иначе пересборка затрёт итог записи.
	ПоказатьИзмененияНаСервере();

	Итого = "Записано заказов: " + Записано
		+ ?(Ошибок = 0, "", Символы.ПС + "Не удалось записать: " + Ошибок
			+ " (причина по каждому - в журнале регистрации,"
			+ " событие «Номера заказов с сайта.Выравнивание»)")
		+ Символы.ПС
		+ "Осталось невыровненных: " + Строки.Количество();

КонецПроцедуры
