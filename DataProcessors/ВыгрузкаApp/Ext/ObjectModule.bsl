		КонецЕсли;	
		
		НС = ТЗ.Добавить();
		
		КолКВыгрузке = ХарактеристикаОбъект.ПолучитьКоличествоКВыгрузкеСУчетомРазбитияРостовкок(Стр.Количество);
		
