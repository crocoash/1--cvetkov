		|		ПО ВТХарактеристикиСкидкиНаценки.Номенклатура = ВТ_НКРучные.Номенклатура
		|			И ВТХарактеристикиСкидкиНаценки.ХарактеристикаНоменклатуры = ВТ_НКРучные.ХарактеристикаНоменклатуры
		|ГДЕ
		|	ВТХарактеристикиСкидкиНаценки.Номенклатура.ВидНоменклатуры.Код = ""000000010""
		|
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура,
		|	Характеристика";
	
	ГруппаВсеСклады = Справочники.Склады.НайтиПоКоду("000000053");
	МассивСкладов = Справочники.Склады.ПолучитьМассивСкладов(ГруппаВсеСклады);

	
	
	Запрос.УстановитьПараметр("Номенклатура"       , Номенклатура);
