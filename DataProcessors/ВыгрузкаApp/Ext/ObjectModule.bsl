	Запрос.УстановитьПараметр("Дата"               , ТекущаяДата());
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	Комплектующие = РезультатыЗапроса[8].Выгрузить();
	Остатки       = РезультатыЗапроса[9].Выгрузить();
	
	ТЗ = Остатки.СкопироватьКолонки();
	

