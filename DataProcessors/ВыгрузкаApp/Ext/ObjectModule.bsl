		КонецЕсли;
		
		Если Цена = 0 Тогда
			Продолжить;
		КонецЕсли;
		     
		ГрХар = ХарактеристикаОбъект.ПолучитьРостовку();
		
		Если Не ЗначениеЗаполнено(ГрХар) Тогда
