		|					И (ЗначениеУсловия = НЕОПРЕДЕЛЕНО
		|						ИЛИ ЗначениеУсловия = 0
		|						ИЛИ ЗначениеУсловия = ЗНАЧЕНИЕ(Справочник.ВидыДисконтныхКарт.ПустаяСсылка)
		|						ИЛИ ЗначениеУсловия = ЗНАЧЕНИЕ(Справочник.ВидыОплатЧекаККМ.ПустаяСсылка)
		|						ИЛИ ЗначениеУсловия = ЗНАЧЕНИЕ(Справочник.ИнформационныеКарты.ПустаяСсылка))) КАК СкидкиНаценкиНоменклатурыСрезПоследних
		|		ПО (ВЫБОР
		|				КОГДА ВТХарактеристики_С_НК.Номенклатура.ВидНоменклатуры.Код = ""000000010""
		|					ТОГДА ВТХарактеристики_С_НК.Номенклатура = СкидкиНаценкиНоменклатурыСрезПоследних.Номенклатура
		|				ИНАЧЕ ВТХарактеристики_С_НК.ХарактеристикаНК.Владелец = СкидкиНаценкиНоменклатурыСрезПоследних.Номенклатура
		|			КОНЕЦ)
