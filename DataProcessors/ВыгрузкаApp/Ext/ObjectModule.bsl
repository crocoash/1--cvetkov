Функция НормОписание(Описание)
	
	Опис = Описание;
	
	Опис = СтрЗаменить(Опис, """"      , "&quot");
	Опис = СтрЗаменить(Опис, "&"       , "&amp");
	//Опис = СтрЗаменить(Опис, ">"       , "&gt");
	//Опис = СтрЗаменить(Опис, "<"       , "&lt");
	Опис = СтрЗаменить(Опис, "'"       , "&apos");
	Опис = СтрЗаменить(Опис, Символы.ПС, " ");
	
	Возврат Опис;
	
КонецФункции

Процедура ВыполнитьВыгрузкуНК(ПутьКФайлу, Номенклатура = Неопределено, Тест = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если СтрЧислоВхождений(ПутьКФайлу, ".xml") = 0 Тогда
		
		ПутьКФайлу = ПутьКФайлу + ".xml";
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СкидкиНаценкиНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
		|	СкидкиНаценкиНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	СкидкиНаценкиНоменклатурыСрезПоследних.ПроцентСкидкиНаценки КАК ПроцентСкидкиНаценки
		|ПОМЕСТИТЬ ВТСкидкиНаценки
		|ИЗ
		|	РегистрСведений.СкидкиНаценкиНоменклатуры.СрезПоследних(
		|			&Дата,
		|			Номенклатура.ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Комплект)
		|				И (КОНЕЦПЕРИОДА(ДатаОкончания, ДЕНЬ) >= &Дата
		|					ИЛИ ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|				И (ПолучательСкидки = НЕОПРЕДЕЛЕНО
		|					ИЛИ ПолучательСкидки = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
		|					ИЛИ ПолучательСкидки = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|					ИЛИ ПолучательСкидки = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка))
		|				И Качество = ЗНАЧЕНИЕ(Справочник.Качество.Новый)
		|				И (ЗначениеУсловия = НЕОПРЕДЕЛЕНО
		|					ИЛИ ЗначениеУсловия = 0
		|					ИЛИ ЗначениеУсловия = ЗНАЧЕНИЕ(Справочник.ВидыДисконтныхКарт.ПустаяСсылка)
		|					ИЛИ ЗначениеУсловия = ЗНАЧЕНИЕ(Справочник.ВидыОплатЧекаККМ.ПустаяСсылка)
		|					ИЛИ ЗначениеУсловия = ЗНАЧЕНИЕ(Справочник.ИнформационныеКарты.ПустаяСсылка))) КАК СкидкиНаценкиНоменклатурыСрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	ХарактеристикаНоменклатуры
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХарактеристикиНоменклатуры.Владелец КАК НК,
		|	ХарактеристикиНоменклатуры.Владелец.Наименование КАК НКНаименование,
		|	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
		|   ХарактеристикиНоменклатуры.Наименование КАК НаименованиеХарактеристики,
		|	ЕСТЬNULL(ВТСкидкиНаценки.ПроцентСкидкиНаценки, 0) КАК ПроцентСкидкиНаценки
		|ИЗ
		|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСкидкиНаценки КАК ВТСкидкиНаценки
		|		ПО ХарактеристикиНоменклатуры.Владелец = ВТСкидкиНаценки.Номенклатура
		|			И ХарактеристикиНоменклатуры.Ссылка = ВТСкидкиНаценки.ХарактеристикаНоменклатуры
		|ГДЕ
		|	ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры = &ВидНоменклатуры
		|	И НЕ ХарактеристикиНоменклатуры.Владелец.ПометкаУдаления
		|	И (ХарактеристикиНоменклатуры.Владелец В ИЕРАРХИИ (&Номенклатура)
		|			ИЛИ &НоменклатураВыбрана)";
	
	
	Запрос.УстановитьПараметр("Дата"               , ТекущаяДата());
	Запрос.УстановитьПараметр("ВидНоменклатуры"    , Справочники.ВидыНоменклатуры.НайтиПоКоду("000000009"));
	Запрос.УстановитьПараметр("Номенклатура"       , Номенклатура);
	Запрос.УстановитьПараметр("НоменклатураВыбрана", Не ЗначениеЗаполнено(Номенклатура));
	
	Рез = Запрос.Выполнить().Выгрузить();
	//Рез.фильтрТабы
	//Рез.Свернуть("НКНаименование,НаименованиеХарактеристики");
	
	ТД = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	
	Врем = Формат(ТекущаяДата(), "ДЛФ=T");                                 
	
	Если СтрДлина(Врем) = 7 Тогда
		
		Врем = Лев(Врем, 4);
		
	Иначе
		
		Врем = Лев(Врем, 5);
		
	КонецЕсли;
	
	ТД.ЗаписатьСтроку("<?xml version=""1.0"" encoding=""UTF-8""?>
					  |<!DOCTYPE yml_catalog SYSTEM ""shops.dtd"">
					  |<yml_catalog date=""" + Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd") + " " + Врем + """>
					  |<shop>
					  |<name>Cvetkov</name>
					  |<url>http://www.cvetkovtm.com/</url>
					  |<currencies>
					  |<currency id=""UAH"" rate=""1""/>
					  |</currencies>");
	
	ТД.ЗаписатьСтроку("<offers>");
	
	Для Каждого Стр Из Рез Цикл
		Характеристика = Стр.Характеристика; 
		ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
		
		ИД      = Характеристика.Код;	
		КомплНК = Характеристика.Комплектующие_НК();		
		
		Если КомплНК.Количество() > 0 Тогда 
			Ном = КомплНК[0].комплектующая;
			
			Если Не ЕстьОстатокПоНоменклатуре(Ном) Тогда 
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		
		
		Если КомплНК.Количество() > 0 Тогда
			ХарактеристикаКомплектующей =  КомплНК[0].ХарактеристикаКомплектующей;
			ХарактеристикаКомплектующейОбъект = ХарактеристикаКомплектующей.ПолучитьОбъект();
			
			Если ХарактеристикаКомплектующей.Наименование = "" Тогда 
				Продолжить;
			КонецЕсли;
			Цвет      = ХарактеристикаКомплектующейОбъект.ЦветХарактеристики();
			Ткань     = ОбщегоНазначения.ТканьХарактеристики(КомплНК[0].ХарактеристикаКомплектующей);
			Подкладка = ОбщегоНазначения.ПодкладкаХарактеристики(КомплНК[0].ХарактеристикаКомплектующей);
			ИДГР      = ХарактеристикаКомплектующейОбъект.ИдГруппыПолучить();
			ИдМод     = ХарактеристикаКомплектующей.Владелец.Код;
			
		Иначе
			Продолжить;
			Цвет      = "";
			Ткань     = "";
			Подкладка = "";
			ИДГР      = "";
			ИдМод     = "";
			
		КонецЕсли;
		
				
		Прод = "";
		Ном  = 1;
		
		Вналичии = Истина;
		ЕстьОстаток = Истина;
		
		НеВыгружать = Истина;
		
		Для Каждого Стр1 Из КомплНК Цикл
			
			//КолКВыгрузке = ОбщегоНазначения.КоличествоКВыгрузке(Стр1.ХарактеристикаКомплектующей);
			//       
			//Если КолКВыгрузке>0 Тогда
			//	 НеВыгружать = Ложь;
			//КонецЕсли;
			
			//СтатусОстатка
			ОстатокСклад  = 0;
			ОстатокРезерв = 0;

			СкладРозы = Справочники.Склады.НайтиПоКоду("000000014");   //СкладДержавинская
	 		ПараметрыОтбора = Новый Структура("Склад, Номенклатура, ХарактеристикаНоменклатуры");
			ПараметрыОтбора.Склад = СкладРозы ;
			ПараметрыОтбора.Номенклатура = Стр1.Комплектующая;
			ПараметрыОтбора.ХарактеристикаНоменклатуры = Стр1.ХарактеристикаКомплектующей;

								
			
			Прод = Прод + ОбщегоНазначения.УбратьНоликиСлева(Стр1.ХарактеристикаКомплектующей.Владелец.Код) + ОбщегоНазначения.УбратьНоликиСлева(Стр1.ХарактеристикаКомплектующей.Код);
			
			Если Не Ном = КомплНК.Количество() Тогда
				
				Прод = Прод + ",";
				
			КонецЕсли;
			
 			Ном = Ном + 1;
			
		КонецЦикла;
		
		Если Прод = "" Тогда
			Продолжить;
		КонецЕсли;
		
		Если НеВыгружать Тогда 
			//Продолжить;
		КонецЕсли;
		
		ТД.ЗаписатьСтроку("<offer  id=""" + ИД + """ model_id=""" + ОбщегоНазначения.УбратьНоликиСлева(ИдМод) + """ group_id=""" + ИДГР + """>");
		
		Наименование = СтрЗаменить(Стр.НК.Наименование, "(НК)", "") + ?(ЗначениеЗаполнено(СокрЛП(Ткань)), " " + СокрЛП(Ткань), "") + ?(ЗначениеЗаполнено(СокрЛП(Цвет)), " " + Цвет, "");
		
		ТД.ЗаписатьСтроку("<name>" + Наименование + "</name>");

		
		Если КомплНК.Количество() <> 0 Тогда
			ХарактеристикаОбъект = (КомплНК[0].характеристикакомплектующей.ПолучитьОбъект());
			Если ХарактеристикаОбъект.ПолучитьРостовку() <> Неопределено Тогда
				ИгнорироватьНоль = ХарактеристикаОбъект.ИгнорироватьНоль;
			
				Если ИгнорироватьНоль Тогда
					ТД.ЗаписатьСтроку("<pro_label>" + 10 + "</pro_label>");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
		 
		ТД.ЗаписатьСтроку("<products>" + Прод + "</products>");             
		ТД.ЗаписатьСтроку("<status>" + ?(ЕстьОстаток, ?(Вналичии,"В наявності", "На виробництві"), ?(ИгнорироватьНоль,"Предзамовлення","")) + "</status>");
		
		ТД.ЗаписатьСтроку("<discount_groap>" + ?(Стр.ПроцентСкидкиНаценки = 0, "", Строка(Стр.ПроцентСкидкиНаценки)) + "</discount_groap>");		
	
		ТД.ЗаписатьСтроку("</offer>");                              
		
	КонецЦикла;
	
	ТД.ЗаписатьСтроку("</offers>
					  |</shop>
					  |</yml_catalog>");
	
	ТД.Закрыть();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

функция ЕстьОстатокПоНоменклатуре(Номенклатура) 
	
	Запрос = Новый Запрос;
	
	Запрос.Текст ="ВЫБРАТЬ
	              |	ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	              |ИЗ
	              |	РегистрНакопления.ТоварыНаСкладах.Остатки(
			      |     	&НаДату,
				  |			Номенклатура = &Номенклатура) КАК ТоварыНаСкладахОстатки";
	            	
	
	Запрос.УстановитьПараметр("Номенклатура" , Номенклатура);
	Запрос.УстановитьПараметр("НаДату" , ТекущаяДата());
		
	Рез = Запрос.Выполнить().Выгрузить();
	
	Кол = Рез.Итог("КоличествоОстаток");
	
	Если Кол > 0 Тогда 
		Возврат Истина;
	Иначе 
		Возврат Ложь; 
	КонецЕсли;
конецФункции

Функция ВсеНулевые(Стр, Таб)
	
	Все0 = Истина;
	
	ТЗ = Таб.НайтиСтроки(Новый Структура("Номенклатура, Цвет, Ткань", Стр.Номенклатура, Стр.Цвет, Стр.Ткань));
	
	Для Каждого Стр1 Из ТЗ Цикл
		
		Если Не Стр1.РознКол = 0 Тогда
			
			Все0 = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Все0;
	
КонецФункции
