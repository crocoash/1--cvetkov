	ТЗ.Колонки.Добавить("ИД");
	ТЗ.Колонки.Добавить("СпрГруппыЦветов");
	ТЗ.Колонки.Добавить("Цена");
	ТЗ.Колонки.Добавить("ВНоль");
	ТЗ.Колонки.Добавить("Цвет");
	ТЗ.Колонки.Добавить("Ткань");
	ТЗ.Колонки.Добавить("Подкладка");
