Процедура ЗаписатьНоменклатуру(ТД, Номенклатура, Стр, Разделитель)
	Если Стр.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	НоменклатураОбъект = Номенклатура.ПолучитьОбъект();	
	Характеристика = Стр[0].Характеристика;
	
	НаименованиеУкр = НоменклатураОбъект.Наименование(Ложь);
	НаименованиеРус = НоменклатураОбъект.Наименование(Истина);
	
	ОписаниеРу = ОбщегоНазначения.ОписаниеДляХарактеристики(Характеристика,Истина);
	ОписаниеУкр = ОбщегоНазначения.ОписаниеДляХарактеристики(Характеристика,Ложь);
	
	ТД.ЗаписатьСтроку(Разделитель + """nameUa"": """+НаименованиеРус+""",
	|"+Разделитель+"""nameRu"" : """+НаименованиеУкр+""",		
	|"+Разделитель+"""descriptionUa"" : ""ОписаниеРу"",
	|"+Разделитель+"""descriptionRu"": ""ОписаниеУкр"",
	|"+Разделитель+"""id"" : """+НоменклатураОбъект.КодБезНоликов() +""",");
	
	
	ТабПараметры = ОбщегоНазначения.ПараметрыКВыгрузке("НашСайт");
	КодыИсключенияСвойств = Характеристика.ПолучитьОбъект().ПолучитьКодыСвойств();
	
	Свойства = ОбщегоНазначения.ЗаписатьСвойстваДляХарактеритси(ТабПараметры, Номенклатура.КатегорияНашСайт, Характеристика,"name",,,КодыИсключенияСвойств,Истина, Разделитель);
    ТД.ЗаписатьСтроку(Свойства);
	
	ТД.ЗаписатьСтроку(Разделитель+ "characteristics"": [");
	ТД.ЗаписатьСтроку(Разделитель+ "{");

	Для каждого Стр1 из Стр Цикл
		Характеристика = Стр1.Характеристика;
		ЗаписатьХарактеристку(ТД, Характеристика, Разделитель + "	");
		ТД.ЗаписатьСтроку(Разделитель+ "}");

		ТД.ЗаписатьСтроку("
		|");
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьХарактеристку(Тд,Характеристика, Разделитель) 
	Номенклатура = Характеристика.Владелец;
	НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
	ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
	//СтатусОстатка
	ОстатокСклад  = 0;
	ОстатокРезерв = 0;

	СкладРозы = Справочники.Склады.НайтиПоКоду("000000014");   //СкладДержавинская
 	ПараметрыОтбора = Новый Структура("Склад, Номенклатура, ХарактеристикаНоменклатуры");
	ПараметрыОтбора.Склад = СкладРозы ;
	ПараметрыОтбора.Номенклатура = Характеристика.Владелец;
	ПараметрыОтбора.ХарактеристикаНоменклатуры = Характеристика;
		
	ИгнорироватьНоль = ХарактеристикаОбъект.ПолучитьРостовку().ИгнорироватьНоль;
	
	ТЗОстатки = РегистрыНакопления.ТоварыНаСкладах.Остатки(, ПараметрыОтбора, "Номенклатура, ХарактеристикаНоменклатуры");
		 
	Если ТЗОстатки.Количество() Тогда
		ОстатокСклад = ТЗОстатки[0].Количество;
	КонецЕсли;
	
	ТЗОстатки = РегистрыНакопления.ТоварыВРезервеНаСкладах.Остатки(, ПараметрыОтбора, "Номенклатура, ХарактеристикаНоменклатуры");
	Остаток = РегистрыНакопления.ТоварыНаСкладах.Остатки(,ПараметрыОтбора, "Номенклатура, ХарактеристикаНоменклатуры");
	
	Если ТЗОстатки.Количество() И Остаток.Количество() Тогда
		ОстатокРезерв = ТЗОстатки[0].Количество;
		 //ОстатокСклад
	КонецЕсли;
	СвободныйОстаток = ОстатокСклад - ОстатокРезерв;
	
	РознСтатус = ?(СвободныйОстаток > 0, ?(ОстатокСклад     > 0, "InStock" , "InProduction"), ?(ИгнорироватьНоль,"toOder",""));
	ОптСтатус  = ?(СвободныйОстаток > 0, ?(СвободныйОстаток > 0, "InStock" , "InProduction"), ?(ИгнорироватьНоль,"toOder",""));
	
	//Параметры для характеристики
	ТабПараметры = ОбщегоНазначения.ПараметрыКВыгрузке("НашСайт");
	КодыИсключенияСвойств = НоменклатураОбъект.ПолучитьКодыСвойств();
	
	Свойство = ОбщегоНазначения.ЗаписатьСвойстваДляХарактеритси(ТабПараметры, Номенклатура.КатегорияНашСайт, Характеристика,"name",,, КодыИсключенияСвойств, Истина, Разделитель);	
	Тд.ЗаписатьСтроку(Свойство);
	
	ТД.ЗаписатьСтроку(Разделитель + """id"": """ + ХарактеристикаОбъект.КодБезНоликов() + """,
	|"+Разделитель + """priceOpt"": ""1000"", 
	|"+Разделитель+"""priceRozn"": ""1200"",
	|"+Разделитель+"""priceRozn"": ""1200"",
	|"+Разделитель+"""priceDrop"": ""13000"",
	|"+Разделитель+"""count_In_Stock"": "+ТЗОстатки+",
	|"+Разделитель+"""rozn_IsReady"": "+РознСтатус+",
	|"+Разделитель+"""opt_IsReady"": "+ОптСтатус+",
	|"+Разделитель+"""priceSp"": ""хуй"",");
	
	
КонецПроцедуры

