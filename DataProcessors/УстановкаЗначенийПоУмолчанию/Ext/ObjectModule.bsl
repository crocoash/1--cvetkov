Процедура СоздатьРеквизитыТТН() Экспорт
	Владелец = Справочники.Перевозчики.НайтиПоНаименованию("Новая почта");
	Если НЕ ЗначениеЗаполнено(Владелец) тогда
		Об = Справочники.Перевозчики.СоздатьЭлемент();
		Об.Наименование = "Новая почта";
		Об.Идентификатор = "новаяпочта";
		Об.Записать();
		Владелец = Об.Ссылка;
	КонецЕсли;	
	
	ТД = ПолучитьМакет("РеквизитыТТН");
	Строк = ТД.ВысотаТаблицы;
	Для хх = 2 пО Строк Цикл
		Об = Справочники.РеквизитыТТН.СоздатьЭлемент();
		Об.Владелец = Владелец;
		Об.Наименование = СокрЛП(ТД.Область("R" + хх + "C3").Текст);
		Об.Код = СокрЛП(ТД.Область("R" + хх + "C2").Текст);
		Об.Обязательный = ТД.Область("R" + хх + "C4").Текст = "Да";
		Об.Порядок = ТД.Область("R" + хх + "C5").Текст;
		Об.ВыборИзСписка = ТД.Область("R" + хх + "C6").Текст = "Да";
		Если ТД.Область("R" + хх + "C7").Текст = "ХранилищеЗначения" Тогда
			
			Сп = Новый СписокЗначений;
			Сп.Добавить(0, "Нет");
			Сп.Добавить(1, "Да");
			
			Об.СписокВыбора = Новый ХранилищеЗначения(Сп);
		КонецЕсли;	
		Об.РежимВыбораИзСписка = ТД.Область("R" + хх + "C8").Текст;
		Если ЗначениеЗаполнено(ТД.Область("R" + хх + "C9").Текст) Тогда
			Об.ПолеГородПриВыбореОтделенияНовойПочты = Справочники.РеквизитыТТН.НайтиПоНаименованию(ТД.Область("R" + хх + "C9").Текст);
		КонецЕсли;
		
		Об.ПолеНомераДокумента = ТД.Область("R" + хх + "C10").Текст = "Да";
		Об.ПолеКоличестваМест = ТД.Область("R" + хх + "C11").Текст = "Да";
		
		Если ЗначениеЗаполнено(ТД.Область("R" + хх + "C12").Текст) Тогда
			Об.ПолеОписанияМест = Справочники.РеквизитыТТН.НайтиПоНаименованию(ТД.Область("R" + хх + "C12").Текст);
		КонецЕсли;
		
		Об.ПунктОтправления = ТД.Область("R" + хх + "C13").Текст = "Да";
		Об.ПунктДоставки = ТД.Область("R" + хх + "C14").Текст = "Да";
		Об.ИмяСправочникаВыбора = ТД.Область("R" + хх + "C15").Текст;
		Об.Записать();		
	КонецЦикла;	
КонецПроцедуры	

Процедура СоздатьПравило() Экспорт
	
	Владелец = Справочники.Перевозчики.НайтиПоНаименованию("Новая почта");
	Если НЕ ЗначениеЗаполнено(Владелец) тогда
		Об1 = Справочники.Перевозчики.СоздатьЭлемент();
		Об1.Наименование = "Новая почта";
		Об1.Идентификатор = "новаяпочта";
		Об1.Записать();
		Владелец = Об1.Ссылка;
	КонецЕсли;	

	Об = Справочники.ПравилаЭкспортаДокументов.СоздатьЭлемент();
	Об.Владелец = Владелец;
	Об.ДокументСсылка = Документы.ЗаказПокупателя.ПустаяСсылка();
	Об.Наименование = "Заказ покупателя";
	СТр = Об.ОбъектыПользовательскихНастроек.Добавить();
	Стр.Объект = "Организация";
	Стр.ТипыОбъекта = "Справочник.Организации,";
	
	СТр = Об.ОбъектыПользовательскихНастроек.Добавить();
	Стр.Объект = "Контрагент";
	Стр.ТипыОбъекта = "Справочник.Контрагенты,";

	Макет = ПолучитьМакет("ПравилаЭкспорта");
	Строк = Макет.ВысотаТаблицы;
	Для хх = 2 По Строк Цикл
		Стр = Об.Правила.Добавить();
		Стр.РеквизитТТН = Справочники.РеквизитыТТН.НайтиПоНаименованию(Макет.Область("R" + хх + "C1").Текст);
		Стр.Выражение = СокрЛП(Макет.Область("R" + хх + "C3").Текст);
		Стр.ВыражениеПредставления = СокрЛП(Макет.Область("R" + хх + "C4").Текст);
		Стр.РеквизитДокумента = СокрЛП(Макет.Область("R" + хх + "C2").Текст);
	КонецЦикла;	
	
	об.Записать();
	
	НЗ = РегистрыСведений.ИспользуемыеПравилаЭкспортаДокументов.СоздатьНаборЗаписей();
	НЗ.Отбор.Перевозчик.установить(Владелец);
	НЗ.Отбор.ДокументСсылка.установить(Документы.ЗаказПокупателя.ПустаяСсылка());
	Запись = НЗ.Добавить();
	Запись.ДокументСсылка   = Документы.ЗаказПокупателя.ПустаяСсылка();
	Запись.Перевозчик = Владелец;
	Запись.Правило = Об.Ссылка;
	НЗ.Записать();
КонецПроцедуры	

Процедура ЗаполнитьВсе() Экспорт
	СоздатьРеквизитыТТН();
	СоздатьПравило();
	ЗаполнитьСтатусы();
	Сообщить("Справочники ""Реквизиты ТТН"" и ""Правила экспорта документов"" созданы!");
КонецПроцедуры

