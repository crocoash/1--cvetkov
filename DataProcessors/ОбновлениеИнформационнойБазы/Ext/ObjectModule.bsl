				Прервать;
			КонецЕсли;

		КонецЦикла;
		
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьРССчетаУчетаПрочие(НовыеСтатьи, ПервыйЗапуск = Ложь)
	
	РС = РегистрыСведений.СчетаУчетаПрочие;

