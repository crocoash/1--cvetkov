		СпрСобытияОС.Наименование = "Ремонт";
		СпрСобытияОС.Записать();
		
		СпрСобытияОС = Справочники.СобытияОС.СоздатьЭлемент();
		СпрСобытияОС.ВидСобытияОС = Перечисления.ВидыСобытийОС.ПодготовкаКПередаче;
		СпрСобытияОС.Наименование = "Подготовка к передаче";
		СпрСобытияОС.Записать();
		
		СпрСобытияОС = Справочники.СобытияОС.СоздатьЭлемент();
		СпрСобытияОС.ВидСобытияОС = Перечисления.ВидыСобытийОС.Передача;
		СпрСобытияОС.Наименование = "Передача";
		СпрСобытияОС.Записать();
	Исключение
	КонецПопытки;
	
КонецПроцедуры

// Заполнение реквизитов справочника "Виды контактной информации"
//
Процедура ЗаполнитьРеквизитВидУчетаВремениДляСредней()

	
	//////////////////////////////////////////////////////////
	// Документы НачислениеОтпускаРаботникамОрганизаций
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "
	|ВЫБРАТЬ 
	|	Основной.Ссылка              	Как Док 
	|	ИЗ Документ.НачислениеОтпускаРаботникамОрганизаций КАК Основной
	|";
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Док = Выборка.Док.ПолучитьОбъект();
		ЭтоКомпенсацияОтпуска = Док.ВидДокументаОтпуск = Перечисления.ВидыДокументаОтпуск.КомпенсацияОтпуска;
		
		Для каждого Строка Из Док.Начисления Цикл
			
			Строка.ВидУчетаВремениДляСредней = Док.ВидУчетаВремениДляСредней;
			Строка.Показатель1 = Док.СуммаСредней;
			
			Если ЭтоКомпенсацияОтпуска Тогда
				Строка.Показатель2 = Док.ДнейЧасовКомпенсацииОтпуска;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Док.Проведен Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
	КонецЦикла;
		
	
	//////////////////////////////////////////////////////////
	// Документы НачислениеПоБольничномуЛисту
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "
	|ВЫБРАТЬ 
	|	Основной.Ссылка              	Как Док 
	|	ИЗ Документ.НачислениеПоБольничномуЛисту КАК Основной
	|";
	
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Док = Выборка.Док.ПолучитьОбъект();
		Для каждого Строка Из Док.Начисления Цикл
			
			Строка.ВидУчетаВремениДляСредней = Док.ВидУчетаВремениДляСредней;
			Строка.Показатель1 = Мин(Док.СуммаСредней, Док.СуммаПределаСредней);
			Строка.Показатель2 = Док.ПроцентОплаты;
			
		КонецЦикла;
		
		Если Док.Проведен Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
	КонецЦикла;
		
	
	//////////////////////////////////////////////////////////
	// Документы ОплатаПоСреднемуЗаработку
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "
	|ВЫБРАТЬ 
	|	Основной.Ссылка              	Как Док 
	|	ИЗ Документ.ОплатаПоСреднемуЗаработку КАК Основной
	|";
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Док = Выборка.Док.ПолучитьОбъект();
		Для каждого Строка Из Док.Начисления Цикл
			
			Строка.ВидУчетаВремениДляСредней = Док.ВидУчетаВремениДляСредней;
			Строка.Показатель1 = Док.СуммаСредней;
			
		КонецЦикла;
		
		Если Док.Проведен Тогда
			Док.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			Док.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры // ЗаполнитьСправочникВидыКонтактнойИнформации()

// Установка границы запрета изменения данных
//
Процедура УстановитьДатуЗапретаРедактирования(ОбщаяДатаЗапрета)
	
	Запрос = Новый Запрос;
	Запрос.Текст  = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	Организации.Ссылка КАК Организация,
					|	&ПустойПользователь КАК Пользователь,
					|	&ОбщаяДата КАК ГраницаЗапретаИзменений
					|ИЗ
					|	Справочник.Организации КАК Организации";
						
	Запрос.УстановитьПараметр("ПустойПользователь", Неопределено);
	Запрос.УстановитьПараметр("ОбщаяДата", ОбщаяДатаЗапрета);
		
