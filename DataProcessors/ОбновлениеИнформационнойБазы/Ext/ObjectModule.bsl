КонецПроцедуры // ОчиститьСправочникТорговоеОборудование()

Процедура ОбновлениеСубконтоСчета27()

	Счет27 = ПланыСчетов.Хозрасчетный.ПродукцияСельскохозяйственногоПроизводства.ПолучитьОбъект();
	Счет26 = ПланыСчетов.Хозрасчетный.ГотоваяПродукция;
			
	// приведем состав субконто на счете 27 к составу субконто на счете 26			
	// удалим лишние субконто
	Инд = 0;
	Пока Инд < Счет27.ВидыСубконто.Количество() Цикл
		ВидСубконто27 = Счет27.ВидыСубконто[Инд].ВидСубконто;
		Если Счет26.ВидыСубконто.Найти(ВидСубконто27) = Неопределено Тогда
			Счет27.ВидыСубконто.Удалить(Инд);
		Иначе
			Инд = Инд + 1;
		КонецЕсли;
	КонецЦикла;			
	
	// добавим субконто со счета 26
	Для каждого СтрокаВидСубконто26 Из Счет26.ВидыСубконто Цикл
		
		ВидСубконто26 = СтрокаВидСубконто26.ВидСубконто;
		СтрокаВидСубконто27 = Счет27.ВидыСубконто.Найти(ВидСубконто26);
		Если СтрокаВидСубконто27 = Неопределено Тогда
			СтрокаВидСубконто27 = Счет27.ВидыСубконто.Добавить();	
		КонецЕсли;	
		
		СтрокаВидСубконто27.ВидСубконто   = ВидСубконто26;
		СтрокаВидСубконто27.ТолькоОбороты = СтрокаВидСубконто26.ТолькоОбороты;
		СтрокаВидСубконто27.Суммовой      = СтрокаВидСубконто26.Суммовой;
		СтрокаВидСубконто27.Количественный= СтрокаВидСубконто26.Количественный;
	
	КонецЦикла;
	
	Счет27.Записать();
	
КонецПроцедуры
 
