КонецФункции

Процедура ВыполнитьКоманду(ИдентификаторКоманды) Экспорт
	
	Если ИдентификаторКоманды = "ВыгрузкаДанных" Тогда
		_ВыполнитьВыгрузку(ИдентификаторКоманды);
	ИначеЕсли ИдентификаторКоманды = "ЗагрузкаДанных" Тогда
		_ВыполнитьЗагрузку(ИдентификаторКоманды);	
	Конецесли;		
	
КонецПроцедуры

Функция _ВыполнитьКоманду(КлючЗапуска) Экспорт
	
	ДоступныеКлючиЗапуска = Новый Массив;
	ДоступныеКлючиЗапуска.Добавить("ОбменСЛичнымКабинетом");
	ДоступныеКлючиЗапуска.Добавить("ОбменСЛичнымКабинетом_Выгрузка");
	ДоступныеКлючиЗапуска.Добавить("ОбменСЛичнымКабинетом_Загрузка");
	
	Если ДоступныеКлючиЗапуска.Найти(КлючЗапуска) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
		
	Если КлючЗапуска = "ОбменСЛичнымКабинетом" Тогда
		ВыполнитьКоманду("ВыгрузкаДанных");
		ВыполнитьКоманду("ЗагрузкаДанных");		
	ИначеЕсли КлючЗапуска = "ОбменСЛичнымКабинетом_Выгрузка" Тогда
		ВыполнитьКоманду("ВыгрузкаДанных");
	ИначеЕсли КлючЗапуска = "ОбменСЛичнымКабинетом_Загрузка" Тогда
		ВыполнитьКоманду("ЗагрузкаДанных");	
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура _ВыполнитьВыгрузку(ИдентификаторКоманды)
	
	Параметры = _ЗаполнитьПараметрыДляОбмена(ИдентификаторКоманды);
	
	_ВыгрузитьТовары(Параметры);
	
КонецПроцедуры

Процедура _ВыполнитьЗагрузку(ИдентификаторКоманды)		
	
	Параметры = _ЗаполнитьПараметрыДляОбмена(ИдентификаторКоманды);
	
	_ЗагрузитьЗаказы(Параметры);		
	
КонецПроцедуры

Функция _ЗаполнитьПараметрыДляОбмена(ИдентификаторКоманды)
	
	Результат = Новый Структура;
	
	//определение параметров
	КонстантыОбмена = "";
	АдресЛога = "";
	КомпоновщикТоваров = Новый КомпоновщикНастроекКомпоновкиДанных;
	
	//заполнение параметров
	Параметры = Новый Структура();
	Параметры.Вставить("ИдентификаторКоманды", ИдентификаторКоманды);
	
	_ИнициализироватьКонстантыОбмена(КонстантыОбмена, Параметры);
	
	_ИнициализироватьРеквизитыОбъекта(КонстантыОбмена);	
	
	ТекстНастроек = Неопределено;
	ЗначенияВнутреннихНастроек = _ПолучитьЗначенияВнутреннихНастроек();
	ЗначенияВнутреннихНастроек.Свойство("ТекстНастроек", ТекстНастроек);
	
	ПараметрыКомпоновщика = Новый Структура("КомпоновщикТоваров");
	ПараметрыКомпоновщика.Вставить("КомпоновщикТоваров", КомпоновщикТоваров);
	
	Настройки = _ДесериализоватьНастройкиXML(ТекстНастроек, ПараметрыКомпоновщика);	
	
	//подготавливаем структуру для возврата
	Результат.Вставить("КонстантыОбмена", КонстантыОбмена);
	Результат.Вставить("АдресЛога", АдресЛога);
	Результат.Вставить("КомпоновщикТоваров", КомпоновщикТоваров);
	Если Настройки.Свойство("РеквизитыШапкиЗаказа") Тогда
		Результат.Вставить("ЗначенияРеквизитовШапкиЗаказаПоУмолчанию", Настройки.РеквизитыШапкиЗаказа);
	КонецЕсли;
	Если Настройки.Свойство("РеквизитыТЧЗаказа") Тогда
		Результат.Вставить("ЗначенияРеквизитовТЧЗаказаПоУмолчанию", Настройки.РеквизитыТЧЗаказа);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции


//ЯДРО: ХРАНИЛИЩЕ НАСТРОЕК

Функция _ПолучитьЗначенияВнутреннихНастроек() Экспорт
	
	ПараметрыНастроек = _ПолучитьСтруктуруПараметровДляХранилищаНастроек();

	_ХранилищеЗагрузитьНастройки(ПараметрыНастроек);
	
	Возврат ПараметрыНастроек.Настройки;		
	
КонецФункции

Процедура _ЗаписатьЗначенияВнутреннихНастроек(СписокНастроек) Экспорт
	
	ПараметрыНастроек = _ПолучитьСтруктуруПараметровДляХранилищаНастроек();
	
	//читаем настройки
	_ХранилищеЗагрузитьНастройки(ПараметрыНастроек);
	
	ВнутренниеНастройки = ПараметрыНастроек.Настройки;
	
	//перезаписываем значения
	Для Каждого Настройка Из СписокНастроек Цикл
		Если ВнутренниеНастройки.Свойство(Настройка.Ключ) Тогда
			ВнутренниеНастройки[Настройка.Ключ] = Настройка.Значение;
		КонецЕсли;		
	КонецЦикла;
		
	//сохраняем настройки
	_ХранилищеСохранитьНастройки(ПараметрыНастроек);	
	
КонецПроцедуры

Процедура _ОчиститьЗначенияВнутреннихНастроек() Экспорт
	
	ПараметрыНастроек = _ПолучитьСтруктуруПараметровДляХранилищаНастроек();
	
	_ХранилищеУдалитьНастройки(ПараметрыНастроек);
	
КонецПроцедуры

Процедура _ХранилищеЗагрузитьНастройки(Параметры)
	
	КлючОбъекта = Параметры.КлючОбъекта;
	КлючНастроек = Параметры.КлючНастроек;
	ИмяПользователя	= Параметры.ИмяПользователя;
	ОписаниеНастроек = Параметры.ОписаниеНастроек;
	
	УстановитьПривилегированныйРежим(Истина);
	ВнутренниеНастройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНастроек, ОписаниеНастроек, ИмяПользователя);	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ВнутренниеНастройки <> Неопределено Тогда
		Параметры.Настройки = ВнутренниеНастройки;
	КонецЕсли;
	
КонецПроцедуры

Процедура _ХранилищеСохранитьНастройки(Параметры)
	
	КлючОбъекта = Параметры.КлючОбъекта;
	КлючНастроек = Параметры.КлючНастроек;	
	Настройки = Параметры.Настройки;
	ОписаниеНастроек = Параметры.ОписаниеНастроек;
	ИмяПользователя	= Параметры.ИмяПользователя;
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, Настройки, ОписаниеНастроек, ИмяПользователя);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура _ХранилищеУдалитьНастройки(Параметры)
	
	КлючОбъекта = Параметры.КлючОбъекта;
	КлючНастроек = Параметры.КлючНастроек;
	ИмяПользователя = Параметры.ИмяПользователя;
	
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Удалить(КлючОбъекта, КлючНастроек, ИмяПользователя);
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция _ПолучитьСтруктуруПараметровДляХранилищаНастроек()	
	
	Возврат Новый Структура("КлючОбъекта, КлючНастроек, Настройки, ОписаниеНастроек, ИмяПользователя", 
							"ОбменСЛичнымКабинетом", "ОбменСЛичнымКабинетом", _ПолучитьСписокВнутреннихНастроек(), "ОбменСЛичнымКабинетом", "ОбменСЛичнымКабинетом");
							
КонецФункции
						
Функция _ПолучитьСписокВнутреннихНастроек()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ТекстНастроек", "");
	Результат.Вставить("ДатаПоследнейУдачнойЗагрузкиЗаказов", Дата("00010101000000"));
	
	Возврат Результат;
	
КонецФункции


//ЯДРО: КЭШИРОВАНИЕ ДАННЫХ

Функция _ЗаполнитьКэшДанными(Кэш, ПорядокЗапросов, РезультатыЗапросов)
	
	Для Каждого ОчереднойЗапрос Из ПорядокЗапросов Цикл
		Выборка = РезультатыЗапросов[ОчереднойЗапрос.Ключ].Выбрать();
		Пока Выборка.Следующий() Цикл
			_УстановитьЗначениеВКэш(Кэш, ОчереднойЗапрос.Значение, Выборка.Ключ, Выборка.Значение);
		КонецЦикла;
	КонецЦикла;
	
КонецФункции

Функция _ПолучитьЗначениеИзКэша(Кэш, Имя, Ключ)
	
	Если ТипЗнч(Ключ) = Тип("Строка") Тогда
		Возврат Кэш[Имя].Получить(СокрЛП(Ключ));
	Иначе
		Возврат Кэш[Имя].Получить(Ключ);
	КонецЕсли;
	
КонецФункции

Процедура _УстановитьЗначениеВКэш(Кэш, Имя, Ключ, Значение)
	
	Если ТипЗнч(Ключ) = Тип("Строка") Тогда
		Кэш[Имя].Вставить(СокрЛП(Ключ), Значение);
	Иначе
		Кэш[Имя].Вставить(Ключ, Значение);	
	КонецЕсли;
	
КонецПроцедуры

Процедура _ДобавитьЗначениеВКэш(Кэш, Имя, Значение)
	
	Кэш[Имя].Добавить(Значение);
	
КонецПроцедуры

Функция _СгруппироватьЗначенияКэша(Кэш)
	
	Результат = Новый Массив;
	
	Для Каждого ВидКэша Из Кэш Цикл
		Для Каждого КлючКэша Из ВидКэша.Значение Цикл
			Если Результат.Найти(КлючКэша.Значение) = Неопределено Тогда 
				Результат.Добавить(КлючКэша.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция прНайтиСоздатьЕдиницуИзмеренияХраненияОстатков(Номенклатура, Знач БазоваяЕдиницаИзмерения)

	Если Не ЗначениеЗаполнено(БазоваяЕдиницаИзмерения) Тогда
		БазоваяЕдиницаИзмерения = "шт";		
	КонецЕсли;	
	Результат = Неопределено;
	
	Результат = Номенклатура.ЕдиницаХраненияОстатков;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		
		ВыборкаЕдиниц = Справочники.ЕдиницыИзмерения.Выбрать(, Номенклатура, Новый Структура("Наименование", СокрЛП(БазоваяЕдиницаИзмерения)));
		
		Если ВыборкаЕдиниц.Следующий() Тогда
			
			Результат = ВыборкаЕдиниц.Ссылка;
			
		Иначе
			
			ЕдиницаОбъект = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
			ЕдиницаОбъект.УстановитьНовыйКод();
			ЕдиницаОбъект.Наименование = СокрЛП(БазоваяЕдиницаИзмерения);
			ЕдиницаОбъект.ЕдиницаПоКлассификатору = БазоваяЕдиницаИзмерения;
			ЕдиницаОбъект.Коэффициент = 1;
			ЕдиницаОбъект.Владелец = Номенклатура;	
			ЕдиницаОбъект.ОбменДанными.Загрузка = Истина;
			ЕдиницаОбъект.Записать();
			
			Результат = ЕдиницаОбъект.Ссылка;
			
		КонецЕсли;
	КонецЕсли;
		
	Возврат Результат;

КонецФункции

Функция прПолучитьДанныеТоварыКартинки(Выборка, НайденныеКартинки)
	
	Результат = Новый Массив;
		
	Если Выборка.ТипХраненияФайла = "ВТомахНаДиске" Тогда		
		
		Результат = НайденныеКартинки.Получить(Выборка.Номенклатура);
		
		Если Результат = Неопределено Тогда
			
			Результат = Новый Массив;
			
			НайденныеФайлы = НайтиФайлы(Выборка.Том, СокрЛП(Выборка.ТоварКод)+"*.*", Истина);
			
			ОсновноеИзображение = прПолучитьОсновноеИзображение(Выборка, НайденныеФайлы);
			
			Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
				
				КартинкаТовара = прПолучитьДанныеТоварыКартинка(Выборка, НайденныйФайл);
				
				Если НайденныйФайл.ПолноеИмя = ОсновноеИзображение Тогда
					КартинкаТовара.ЭтоОсновноеИзображение = Истина;
				КонецЕсли;
								
				Результат.Добавить(КартинкаТовара);
				
			КонецЦикла;
			
			НайденныеКартинки.Вставить(Выборка.Номенклатура, Результат);
			
		КонецЕсли;	
						
	ИначеЕсли Выборка.ТипХраненияФайла = "ВИнформационнойБазе" Тогда
		
		КартинкаТовара = прПолучитьДанныеТоварыКартинка(Выборка);
		
		Результат.Добавить(КартинкаТовара);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция прПолучитьДанныеТоварыКартинка(Выборка, НайденныйФайл = Неопределено)
	
	Результат = Новый Структура;
	
	Результат.Вставить("КартинкаУИД", _УИД(Выборка.Хранилище, Истина, Истина));
	Результат.Вставить("ТоварНаименование", Выборка.ТоварНаименование);
	Результат.Вставить("ТоварКод", СокрЛП(Выборка.ТоварКод));
	Результат.Вставить("Хранилище", Выборка.Хранилище);
	Результат.Вставить("ЭтоОсновноеИзображение", Выборка.ЭтоОсновноеИзображение);
	Результат.Вставить("ТипХраненияФайла", Выборка.ТипХраненияФайла);
	Результат.Вставить("ДанныеХранилища", Выборка.ДанныеХранилища);
	
	Если НайденныйФайл = Неопределено Тогда
		
		Результат.Вставить("ХранилищеНаименование", Выборка.ХранилищеНаименование);
		Результат.Вставить("ПолныйПутьКФайлу", "");		
		
		Размер = 0;
		Если ЗначениеЗаполнено(Выборка.ДанныеХранилища) Тогда
			ДанныеХранилища = Выборка.ДанныеХранилища.Получить();		
			Если ТипЗнч(ДанныеХранилища) = Тип("ДвоичныеДанные") Тогда
				Размер = ДанныеХранилища.Размер();
			ИначеЕсли ТипЗнч(ДанныеХранилища) = Тип("Картинка") Тогда
				Размер = ДанныеХранилища.ПолучитьДвоичныеДанные().Размер();
			КонецЕсли;
		КонецЕсли;
				
		Результат.Вставить("Размер", Размер);
		
	Иначе
		
		Результат.Вставить("ХранилищеНаименование", НайденныйФайл.ИмяБезРасширения);
		Результат.Вставить("ПолныйПутьКФайлу", НайденныйФайл.ПолноеИмя);
		Результат.Вставить("Размер", НайденныйФайл.Размер());
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция прПолучитьОсновноеИзображение(Выборка, НайденныеФайлы)
	
	Результат = "";
	
	Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
		
		ИмяФайла = НайденныйФайл.ИмяБезРасширения;
		МассивПодстрок = _РазложитьСтрокуВМассив(ИмяФайла, "_");
		ПоследнееВхождение = МассивПодстрок.Количество() - 1;
		
		НомерКартинки = МассивПодстрок.Получить(ПоследнееВхождение);
		
		Если НомерКартинки = "1"
			ИЛИ НомерКартинки = СокрЛП(Выборка.ТоварКод) Тогда
			Результат = НайденныйФайл.ПолноеИмя;
			Прервать;
		Иначе
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

////
Процедура ПодготовитьЗаказКВыгрузке(Заказ)
	КОмментарий = Заказ.Комментарий;
	Если (Лев(КОмментарий, СтрДлина("Способ доставки: Нова Пошта")) = "Способ доставки: Нова Пошта") или (Лев(КОмментарий, СтрДлина("Способ доставки: Новая Почта")) = "Способ доставки: Новая Почта") Тогда
		КОмментарий = СтрЗаменить(КОмментарий, "Способ доставки: Нова Пошта, Адрес доставки: ", "");
		КОмментарий = СтрЗаменить(КОмментарий, "Способ доставки: Новая Почта, Адрес доставки: ", ""); 
		ПоложениеСтатусЗаказа = Найти(КОмментарий, ", Статус заказа");
		Адрес = Лев(КОмментарий, ПоложениеСтатусЗаказа - 1);
		
		Запятая = Найти(Адрес, ",");
		ГородСтрокой = Лев(Адрес, Запятая - 1);
		ОтделениеСтрокой = Сред(Адрес, Запятая + 2);
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЛМ_Города.Ссылка
		|ИЗ
		|	Справочник.ЛМ_Города КАК ЛМ_Города
		|ГДЕ
		|	ЛМ_Города.НаименованиеРусское = &НаименованиеРусское";
		Запрос.УстановитьПараметр("НаименованиеРусское", ГородСтрокой);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Город = Выборка.Ссылка;
		КонецЕсли;	
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЛМ_Отделения.Ссылка
		|ИЗ
		|	Справочник.ЛМ_Отделения КАК ЛМ_Отделения
		|ГДЕ
		|	ЛМ_Отделения.НаименованиеРусское = &НаименованиеРусское";
		Запрос.УстановитьПараметр("НаименованиеРусское", ОтделениеСтрокой);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Отделение = Выборка.Ссылка;
		КонецЕсли;	
		
		НомерТелефона = Заказ.ТелефонКонтрагента;
		НомерТелефона = СтрЗаменить(НомерТелефона, "+380", "0");
		НомерТелефона = СтрЗаменить(НомерТелефона, " ", "");
		НомерТелефона = СтрЗаменить(НомерТелефона, "-", "");
		НомерТелефона = СтрЗаменить(НомерТелефона, "(", "");
		НомерТелефона = СтрЗаменить(НомерТелефона, ")", "");
		
		ФИО = СокрЛП(Заказ.Контрагент.Наименование);
		Фамилия = "";
		Имя = "";
		Отчество = "";
		
		Пока Найти(ФИО, "  ") Цикл
			ФИО = СтрЗаменить(ФИО, "  ", " ");
		КонецЦикла;	
		
		Пробел = Найти(ФИО, " ");
		Если Пробел > 0 Тогда
			Фамилия = Лев(ФИО, Пробел - 1);
			ФИО = СРед(ФИО, Пробел + 1);
			Пробел = Найти(ФИО, " ");
			Если Пробел > 0 Тогда
				Имя = Лев(ФИО, Пробел - 1);
				Отчество = СРед(ФИО, Пробел + 1);
			Иначе
				Имя = ФИО;
			КонецЕсли;
		Иначе
			Фамилия = ФИО;
		КонецЕсли;
		Фамилия = СокрЛП(Фамилия);
		Имя = СокрЛП(Имя);
		Отчество = СокрЛП(Отчество);
		
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛМ_КонтрагентыДоставки.КонтрагентДоставки,
		|	ЛМ_КонтактныеЛица.Ссылка
		|ИЗ
		|	РегистрСведений.ЛМ_КонтрагентыДоставки КАК ЛМ_КонтрагентыДоставки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЛМ_КонтактныеЛица КАК ЛМ_КонтактныеЛица
		|		ПО ЛМ_КонтрагентыДоставки.КонтрагентДоставки = ЛМ_КонтактныеЛица.Владелец
		|ГДЕ
		|	ЛМ_КонтрагентыДоставки.Контрагент = &Контрагент";
		Запрос.УстановитьПараметр("Контрагент", Заказ.Контрагент);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() ТОгда
			КонтрагентДоставки = Выборка.КонтрагентДоставки;
			КонтактноеЛицо = Выборка.Ссылка;
		Иначе
			
			ОбКонтрагент = Справочники.ЛМ_Контрагенты.СоздатьЭлемент();
			ОбКонтрагент.Город = Город;
			ОбКонтрагент.СкладПоУмолчанию = Отделение;
			ОбКонтрагент.Наименование = Заказ.Контрагент.Наименование;
			ОбКонтрагент.ВидКонтрагента = Справочники.ЛМ_ВидыПлательщиков.НайтиПоРеквизиту("ГУИД", "Recipient");
			
			ОбКонтрагент.Имя = Имя;
			ОбКонтрагент.Фамилия = Фамилия;
			ОбКонтрагент.Отчество = Отчество;
			
			ОбКонтрагент.Телефон = НомерТелефона;
			ОбКонтрагент.ЮрФизЛицо = Справочники.ЛМ_ТипыКонтрагентовОтправителей.НайтиПоРеквизиту("ГУИД", "PrivatePerson");
			ОбКонтрагент.Записать();
			КонтрагентДоставки = ОбКонтрагент.Ссылка;
			
			НЗ = РегистрыСведений.ЛМ_КонтрагентыДоставки.СоздатьНаборЗаписей();
			НЗ.Отбор.Контрагент.Установить(Заказ.Контрагент);
			НЗ.Отбор.КонтрагентДоставки.Установить(ОбКонтрагент.Ссылка);
			З = НЗ.Добавить();
			З.Контрагент = Заказ.Контрагент;
			З.КонтрагентДоставки = ОбКонтрагент.Ссылка;
			НЗ.Записать();
			
			ЗапросКонтактногоЛица = Новый Запрос;
			ЗапросКонтактногоЛица.Текст = 
			"ВЫБРАТЬ
			|	ЛМ_КонтактныеЛица.Ссылка
			|ИЗ
			|	Справочник.ЛМ_КонтактныеЛица КАК ЛМ_КонтактныеЛица
			|ГДЕ
			|	ЛМ_КонтактныеЛица.Владелец = &Владелец";
			ЗапросКонтактногоЛица.УстановитьПараметр("Владелец", ОбКонтрагент.Ссылка);
			Выборка = ЗапросКонтактногоЛица.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				КонтактноеЛицо = Выборка.Ссылка;
			КонецЕсли;	
		КонецЕсли;

		Об = Заказ.ПолучитьОбъект();
		
		ТехнологияДоставкиПоУмолчанию = Неопределено;
		ФормаОплатыПоУмолчанию = Неопределено;
		СтруктураНастройки = Константы.ЛМ_НастройкиЗаполненияЭкспрессНакладнойПоУмолчанию.Получить().Получить();
		Если ТипЗнч(СтруктураНастройки) = Тип("Структура") Тогда
			Если СтруктураНастройки.Свойство("ТехнологияДоставки") Тогда
				ТехнологияДоставкиПоУмолчанию = СтруктураНастройки.ТехнологияДоставки;
			КонецЕсли;	
			Если СтруктураНастройки.Свойство("ФормаОплаты") Тогда
				ФормаОплатыПоУмолчанию = СтруктураНастройки.ФормаОплаты;
			КонецЕсли;	
		КонецЕсли;	
		Об.СпособОтправки = Справочники.СпособыОтправки.НоваяПочта;
		Об.КонтактноеЛицоДоставки = КонтактноеЛицо;
		Об.КонтрагентДоставки = КонтрагентДоставки;
		Об.Плательщик = Справочники.ЛМ_ВидыПлательщиков.НайтиПоРеквизиту("ГУИД","Recipient");
		Об.ПлательщикОбратнойДоставки = Справочники.ЛМ_ВидыПлательщиковОбратнойДоставки.НайтиПоРеквизиту("ГУИД","Recipient");
		Об.СкладНовойПочтыЗначение = Отделение;
		Об.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Продано");
		
		ПоследняяТехнологияДоставки = ВосстановитьЗначение("ПоследняяТехнологияДоставки");
		Если ЗначениеЗаполнено(ПоследняяТехнологияДоставки) Тогда
			Об.ТехнологияДоставки = ПоследняяТехнологияДоставки;
		Иначе
			СтруктураНастройки = Константы.ЛМ_НастройкиЗаполненияЭкспрессНакладнойПоУмолчанию.Получить().Получить();
			Если ТипЗнч(СтруктураНастройки) = Тип("Структура") Тогда
				Если СтруктураНастройки.Свойство("ТехнологияДоставки") Тогда
					Об.ТехнологияДоставки = СтруктураНастройки.ТехнологияДоставки;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		Если Не ЗначениеЗаполнено(Об.ТехнологияДоставки) Тогда
			Об.ТехнологияДоставки = Справочники.ЛМ_ТехнологииДоставки.НайтиПоРеквизиту("ГУИД", "WarehouseWarehouse");
		КонецЕсли;	
		
		Об.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоРеквизиту("ГУИД", "Money");
		Если ФормаОплатыПоУмолчанию <> Неопределено И ФормаОплатыПоУмолчанию<>Справочники.ЛМ_ФормыОплаты.ПустаяСсылка() Тогда
			Об.ВидРасчетов = ФормаОплатыПоУмолчанию;
		Иначе	
			Об.ВидРасчетов = Справочники.ЛМ_ФормыОплаты.НайтиПоРеквизиту("ГУИД", "Cash");
		КонецЕсли;
		
		Об.ТелефонКонтрагента = НомерТелефона;
		Об.ГородНовойПочтыЗначение = Город;
		Об.Мест = 1;
		Об.Вес = 0.2;
		Для Каждого Строка Из Об.Товары Цикл
			Если (Строка.Номенклатура.Вес<>0) Или (Строка.Номенклатура.ВидНоменклатуры.Вес<>0) Тогда
				Об.Вес = 0;
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
		Об.Записать(РежимЗаписиДокумента.Проведение);
	Иначе	
		Об = Заказ.ПолучитьОбъект();
		Об.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Продано");
		Об.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;	
КонецПроцедуры
	

