	// ИД
	_ИмяДокументаЗаказ = Параметры.КонстантыОбмена.Заказ.ИмяДокумента;	
	_ИмяРеквизитаНомерЗаказаВходящий = Параметры.КонстантыОбмена.Заказ.ИмяРеквизитаНомерЗаказаВходящий;
	
