	ЗаказыДанные["КонтактныеЛица"].Колонки.Добавить("ИДКонтрагента");
	ЗаказыДанные["КонтактныеЛица"].Колонки.Добавить("Наименование");
	
	ЗаказыДанные.Вставить("КонтактнаяИнформация", Новый ТаблицаЗначений);
