Процедура СкопироватьКартинкуВБуфер(Характеристики) Экспорт
		
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппаЦветовФотографии.Наименование КАК НаименованиеФото,
		|	ГруппаЦветовФотографии.Фото КАК Фото
		|ИЗ
		|	Справочник.ГруппаЦветов.Фотографии КАК ГруппаЦветовФотографии
		|ГДЕ
		|	ГруппаЦветовФотографии.Ссылка В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ГруппаЦветовХарактеристики.Ссылка
		|			ИЗ
		|				Справочник.ГруппаЦветов.Характеристики КАК ГруппаЦветовХарактеристики
		|			ГДЕ
		|				ГруппаЦветовХарактеристики.Характеристика В (&Характеристика))
		|
		|УПОРЯДОЧИТЬ ПО
		|	НаименованиеФото";
	
	Запрос.УстановитьПараметр("Характеристика", Характеристики);
	
	Форма = ПолучитьФорму("ФормаСпискаФото");
	
	// Выгружаем результат запроса во временную таблицу
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	// Создаем новую таблицу, чтобы колонка Ссылка была без ограничения длины от Наименования
	СписокФото = Новый ТаблицаЗначений;
	СписокФото.Колонки.Добавить("Ссылка");
	СписокФото.Колонки.Добавить("Фото");
	
	Для Каждого Строка Из ТЗ Цикл
		
		НоваяСтрока = СписокФото.Добавить();
		НоваяСтрока.Ссылка = "http://cvetkovtm.com/assets/shop/sync/imgJpg/" + НРег(Строка.НаименованиеФото);
		НоваяСтрока.Фото = Строка.Фото;
		
	КонецЦикла;
	
	Форма.СписокФото = СписокФото;
	Форма.СписокФото.Колонки.Ссылка.Ширина = 300;
	
	Если ТипЗнч(Характеристики) = Тип("Массив") Тогда
		Владелец = Характеристики[0].Владелец;
	Иначе
		Владелец = Характеристики.Владелец;
	КонецЕсли;
	
	ФотоЗамеров = ОбщегоНазначения.ПолучитьОбщееФотоПоНазванию(Владелец, "Замеры");
	
	Если ТипЗнч(ФотоЗамеров) = Тип("Массив") Тогда
		Если ФотоЗамеров.Количество() > 0 Тогда
			ФотоЗамеров = ФотоЗамеров[0];
		Иначе
			ФотоЗамеров = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Видео = ОбщегоНазначения.ПолучитьОбщееФотоПоНазванию(Владелец, "Видео");
	
	Если ТипЗнч(Видео) = Тип("Массив") Тогда
		Если Видео.Количество() > 0 Тогда
			Видео = Видео[0];
		Иначе
			Видео = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ФотоЗамеров <> Неопределено Тогда
		
		НоваяСтрока = Форма.СписокФото.Добавить();
		НоваяСтрока.Ссылка = "http://cvetkovtm.com/assets/shop/sync/imgJpg/" + НРег(ФотоЗамеров.Наименование);	
		НоваяСтрока.Фото = ФотоЗамеров.Фото;
		
	КонецЕсли;
	
	Если Видео <> Неопределено Тогда
		
		НоваяСтрока = Форма.СписокФото.Добавить();
		НоваяСтрока.Ссылка = "http://cvetkovtm.com/assets/shop/sync/imgJpg/" + НРег(Видео.Наименование);	
		НоваяСтрока.Фото = Видео.Фото;
		
	КонецЕсли;
	
	Форма.Открыть();
	
КонецПроцедуры