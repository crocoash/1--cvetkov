// После правки количества фон строки может смениться (в ноль / за минус),
// плюс пересчитывается сумма и разбор нового кроя.
&НаСервере
Процедура ПересчитатьСтрокуНаСервере(Идентификатор)

	Если Идентификатор <> Неопределено И ОснованиеЗаказПокупателя Тогда

		Стр = ТаблицаХарактеристикНоменклатуры.НайтиПоИдентификатору(Идентификатор);

		Если Стр <> Неопределено И ЭтоХарактеристика(Стр.Характеристика) Тогда
			Кэш = НовыйКэш();
			Стр.КлючФона = "";
			ЗаполнитьКлючФонаСтроки(Кэш, Стр);
		КонецЕсли;

	КонецЕсли;

	ОбновитьИтоги();

КонецПроцедуры

// Двойной клик по колонке остатка склада - расшифровка резервов по заказам,
// по колонке "Крой" - карточка ростовки.
&НаКлиенте
Процедура ХарактеристикиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если Поле = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяПоля = Поле.Имя;

	Если ИмяПоля = "ХарактеристикиЦвет" Или ИмяПоля = "ХарактеристикиЦвет1" Тогда
		ОткрытьРостовкуТекущейСтроки();
		Возврат;
	КонецЕсли;

	Если Лев(ИмяПоля, 5) <> "КолО_" И Лев(ИмяПоля, 5) <> "КолГ_" Тогда
		Возврат;
	КонецЕсли;

	ОткрытьРасшифровкуРезерва(ВыбраннаяСтрока, Сред(ИмяПоля, 6));

КонецПроцедуры

// Расшифровка резерва. Обычная общая форма ФормаРасшифровкиРезерва из управляемой
// формы недоступна: ПолучитьОбщуюФорму - метод обычного приложения, и это ошибка
// компиляции, а не времени выполнения. Поэтому заказы, держащие резерв, показываются
// меню выбора, а выбранный заказ открывается своей формой.
&НаКлиенте
Процедура ОткрытьРасшифровкуРезерва(Идентификатор, КраткоеИмяСклада)

	Резервы = РезервыПоЗаказам(Идентификатор, КраткоеИмяСклада);

	Если Резервы.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Резервов по этому складу нет");
		Возврат;
	КонецЕсли;

	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораЗаказаРезерва", ЭтотОбъект),
		Резервы, Элементы.ТаблицаХарактеристикНоменклатуры, "Заказы, держащие резерв");

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЗаказаРезерва(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент <> Неопределено Тогда
		ПоказатьЗначение(, ВыбранныйЭлемент.Значение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция РезервыПоЗаказам(Идентификатор, КраткоеИмяСклада)

	Список = Новый СписокЗначений;

	СтрокаТаблицы = ТаблицаХарактеристикНоменклатуры.НайтиПоИдентификатору(Идентификатор);

	Если СтрокаТаблицы = Неопределено Тогда
		Возврат Список;
	КонецЕсли;

	Склад = Справочники.Склады.ПустаяСсылка();

	Для Каждого СтрокаСклада Из ТабСклады Цикл
		Если ИмяКолонкиСклада("О_", СтрокаСклада.Склад) = "О_" + КраткоеИмяСклада Тогда
			Склад = СтрокаСклада.Склад;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК Заказ,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Номер КАК Номер,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Контрагент КАК Контрагент,
	|	ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад,
	|	СУММА(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток) КАК Количество
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И (ХарактеристикаНоменклатуры = &Характеристика
	|					ИЛИ &ХарактеристикаНеВыбрана)
	|				И (Склад = &Склад
	|					ИЛИ &СкладНеВыбран)) КАК ТоварыВРезервеНаСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Номер,
	|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Контрагент,
	|	ТоварыВРезервеНаСкладахОстатки.Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер";

	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Характеристика", СтрокаТаблицы.Характеристика);
	Запрос.УстановитьПараметр("ХарактеристикаНеВыбрана", Не ЭтоХарактеристика(СтрокаТаблицы.Характеристика));
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("СкладНеВыбран", Не ЗначениеЗаполнено(Склад));

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Заказ, "№ " + СокрЛП(Выборка.Номер) + " - " + Строка(Выборка.Контрагент)
			+ " - " + Строка(Выборка.Количество) + " шт (" + Строка(Выборка.Склад) + ")");
	КонецЦикла;

	Возврат Список;

КонецФункции

