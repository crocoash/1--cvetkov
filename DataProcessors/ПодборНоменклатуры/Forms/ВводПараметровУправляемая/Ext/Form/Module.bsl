	ЗаполнитьОформлениеСтрок(Кэш);
	ОбновитьИтоги();

КонецПроцедуры

&НаСервере
Процедура ОбновитьИтоги()

	Сумма = 0;
	ВКрое1 = 0;
	ВКрое2 = 0;

	Кэш = НовыйКэш();

	Для Каждого Стр Из ТаблицаХарактеристикНоменклатуры Цикл

		Если ЭтоХарактеристика(Стр.Характеристика) Тогда

			Ростовка = РостовкаКэш(Кэш, Стр.Характеристика);

			Если ЗначениеЗаполнено(Ростовка) И Ростовка.ИНКоличество = 0 Тогда

				Если Стр.РазмерЕстьВКрое1 Тогда
					ВКрое1 = ВКрое1 + Стр.Количество;
				КонецЕсли;

				Если Стр.РазмерЕстьВКрое2 Тогда
					ВКрое2 = ВКрое2 + Стр.Количество;
				КонецЕсли;

			КонецЕсли;

		КонецЕсли;

		Сумма = Сумма + Ценообразование.ПересчитатьЦенуПриИзмененииВалюты(Стр.Цена, Стр.ВалютаЦены, ВалютаЦены)
			* Стр.Количество;

	КонецЦикла;

	ИтоговаяСумма       = Сумма;
	ИтоговоеКолВоВКрое1 = ВКрое1;
	ИтоговоеКолВоВКрое2 = ВКрое2;

КонецПроцедуры

#КонецОбласти

#Область ФормированиеРезультата

// Возврат тот же, что у обычной формы: массив структур на каждую строку с
// ненулевым количеством. При включённом "Собирать НК" отмеченные комплектующие
// сворачиваются в наборы через БИАС.СобратьКомплекты.
&НаСервере
Функция СформироватьРезультат()

	МассивСтруктурПараметров = Новый Массив;

	Для Каждого Стр Из ТаблицаХарактеристикНоменклатуры Цикл

		Если Стр.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;

		Характеристика = ?(ЭтоХарактеристика(Стр.Характеристика),
			Стр.Характеристика, Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());

		Если ЦенаПоРеализации И ЗначениеЗаполнено(ТипЦенНоменклатуры) И ЗначениеЗаполнено(Характеристика) Тогда
			НоваяЦена = Ценообразование.ПолучитьЦенуНоменклатуры(
				Характеристика.Владелец, Характеристика, ТипЦенНоменклатуры, ДатаДокумента,
				Стр.ЕдиницаИзмерения, ВалютаДокумента, , , , ДоговорКонтрагента);
		Иначе
			НоваяЦена = Стр.Цена;
		КонецЕсли;

		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ЕдиницаИзмерения",    Стр.ЕдиницаИзмерения);
		СтруктураПараметров.Вставить("Количество",          Стр.Количество);
		СтруктураПараметров.Вставить("Цена",                НоваяЦена);
		СтруктураПараметров.Вставить("ВалютаЦены",          Стр.ВалютаЦены);
		СтруктураПараметров.Вставить("Серия",               Справочники.СерииНоменклатуры.ПустаяСсылка());
		СтруктураПараметров.Вставить("Характеристика",      Характеристика);
		СтруктураПараметров.Вставить("Качество",            ?(РазворачиватьДоКачества, Стр.Качество, Справочники.Качество.Новый));
		СтруктураПараметров.Вставить("ДатаИсполнения",      Стр.ДатаИсполнения);
		СтруктураПараметров.Вставить("ДатаИсполненияКонец", Стр.ДатаИсполненияКонец);

		МассивСтруктурПараметров.Добавить(СтруктураПараметров);

	КонецЦикла;

	Если Не СобиратьНК Тогда
		Возврат МассивСтруктурПараметров;
	КонецЕсли;

	Возврат СобратьНаборы(МассивСтруктурПараметров);

КонецФункции

&НаСервере
Функция СобратьНаборы(МассивСтруктурПараметров)

	ТаблицаКомплектующих = Новый ТаблицаЗначений;
	ТаблицаКомплектующих.Колонки.Добавить("Номенклатура",   Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКомплектующих.Колонки.Добавить("Характеристика", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаКомплектующих.Колонки.Добавить("Количество");

	Для Каждого СтруктураПараметров Из МассивСтруктурПараметров Цикл

		Если Не ЗначениеЗаполнено(СтруктураПараметров.Характеристика) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаКомплектующих.Добавить();
		НоваяСтрока.Номенклатура   = СтруктураПараметров.Характеристика.Владелец;
		НоваяСтрока.Характеристика = СтруктураПараметров.Характеристика;
		НоваяСтрока.Количество     = СтруктураПараметров.Количество;

	КонецЦикла;

	ТаблицаКомплектов = БИАС.СобратьКомплекты(ТаблицаКомплектующих);
	Результат = Новый Массив;

	Для Каждого Стр Из ТаблицаКомплектов Цикл

		ЦенаКомплекта = 0;

		Если ЗначениеЗаполнено(ТипЦенНоменклатуры)
		   И Стр.Номенклатура.ВидНоменклатуры.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Комплект Тогда

			ЦенаКомплекта = Ценообразование.ПолучитьЦенуНоменклатуры(
				Стр.Номенклатура, Стр.Характеристика, ТипЦенНоменклатуры, ДатаДокумента,
				Стр.Номенклатура.ЕдиницаХраненияОстатков, ВалютаДокумента, , , , ДоговорКонтрагента);

		КонецЕсли;

		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Характеристика",   Стр.Характеристика);
		СтруктураПараметров.Вставить("Серия",            Справочники.СерииНоменклатуры.ПустаяСсылка());
		СтруктураПараметров.Вставить("Качество",         Справочники.Качество.Новый);
		СтруктураПараметров.Вставить("ЕдиницаИзмерения", Стр.Номенклатура.ЕдиницаХраненияОстатков);
		СтруктураПараметров.Вставить("Количество",       Стр.Количество);
		СтруктураПараметров.Вставить("Цена",             ЦенаКомплекта);
		СтруктураПараметров.Вставить("ВалютаЦены",       ВалютаЦены);

		ДатаИзготовления = Стр.Характеристика.ПолучитьОбъект().ПолучитьДатуИзготовления(Истина);

		Если ЗначениеЗаполнено(ДатаИзготовления) Тогда
			СтруктураПараметров.Вставить("ДатаИсполнения",      ДатаИзготовления.ДатаПошиваНачало);
			СтруктураПараметров.Вставить("ДатаИсполненияКонец", ДатаИзготовления.ДатаПошиваКонец);
		КонецЕсли;

		Результат.Добавить(СтруктураПараметров);

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
