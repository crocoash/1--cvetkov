&НаКлиенте
Процедура КомандаОтметить2На1(Команда)

	ОтметитьПоЧастямНаСервере(Элементы.ТаблицаХарактеристикНоменклатуры.ТекущаяСтрока, 3);

КонецПроцедуры

// Режим 2 - совпадают первые две части характеристики,
// режим 3 - совпадает первая часть, а для трёхсоставных характеристик вторая.
&НаСервере
Процедура ОтметитьПоЧастямНаСервере(Идентификатор, Режим)

	Если Идентификатор = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущаяСтрока = ТаблицаХарактеристикНоменклатуры.НайтиПоИдентификатору(Идентификатор);

	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Части = ЧастиХарактеристики(ТекущаяСтрока.Характеристика);
	Искомые = Новый Массив;

	Если Режим = 2 Тогда

		Если Части.Количество() < 2 Тогда
			Возврат;
		КонецЕсли;

		Искомые.Добавить(Части[0]);
		Искомые.Добавить(Части[1]);

	Иначе

		Если Части.Количество() = 3 Тогда
			Искомые.Добавить(Части[1]);
		ИначеЕсли Части.Количество() > 0 Тогда
			Искомые.Добавить(Части[0]);
		Иначе
			Возврат;
		КонецЕсли;

	КонецЕсли;

	Для Каждого Стр Из ТаблицаХарактеристикНоменклатуры Цикл

		ЧастиСтроки = ЧастиХарактеристики(Стр.Характеристика);
		Подходит = Истина;

		Для Каждого Искомое Из Искомые Цикл
			Если ЧастиСтроки.Найти(Искомое) = Неопределено Тогда
				Подходит = Ложь;
			КонецЕсли;
		КонецЦикла;

		Если Подходит Тогда
			Стр.Количество = Стр.Количество + 1;
		КонецЕсли;

	КонецЦикла;

	ПересчитатьОформлениеИИтоги();

КонецПроцедуры

&НаКлиенте
Процедура КомандаОтметитьРостовку(Команда)

	ИзменитьПоРостовкеНаСервере(Элементы.ТаблицаХарактеристикНоменклатуры.ТекущаяСтрока, Истина);

КонецПроцедуры

&НаКлиенте
Процедура КомандаСнятьРостовку(Команда)

	ИзменитьПоРостовкеНаСервере(Элементы.ТаблицаХарактеристикНоменклатуры.ТекущаяСтрока, Ложь);

КонецПроцедуры

// Добавить (или снять) количества по ростовке текущей строки: при добавлении
// берётся количество из ростовки, при снятии - по единице.
&НаСервере
Процедура ИзменитьПоРостовкеНаСервере(Идентификатор, Добавлять)

	Если Идентификатор = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущаяСтрока = ТаблицаХарактеристикНоменклатуры.НайтиПоИдентификатору(Идентификатор);

	Если ТекущаяСтрока = Неопределено Или Не ЭтоХарактеристика(ТекущаяСтрока.Характеристика) Тогда
		Возврат;
	КонецЕсли;

	Кэш = НовыйКэш();
	Ростовка = РостовкаКэш(Кэш, ТекущаяСтрока.Характеристика);

	Если Не ЗначениеЗаполнено(Ростовка) Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Стр Из ТаблицаХарактеристикНоменклатуры Цикл

		НайденнаяХарактеристика = Ростовка.Характеристики.Найти(Стр.Характеристика, "Характеристика");

		Если НайденнаяХарактеристика = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если Добавлять Тогда
			Стр.Количество = Стр.Количество
				+ ?(НайденнаяХарактеристика.Количество = 0, 1, НайденнаяХарактеристика.Количество);
		Иначе
			Стр.Количество = Стр.Количество - 1;
		КонецЕсли;

	КонецЦикла;

	ПересчитатьОформлениеИИтоги();

КонецПроцедуры

&НаКлиенте
Процедура КомандаСбросОтбора(Команда)

	СбросОтбораНаСервере();

КонецПроцедуры

