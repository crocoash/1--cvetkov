////////////////////////////////////////////////////////////////////////////////
// Управляемый вариант диалога "Количество и цена" (подбор характеристик).
//
// Повторяет обычную форму ВводПараметровБезСерийСХарактеристиками: таблица
// характеристик с колонками остатков по выбранным складам и группам складов,
// отбор по цвету/размеру/ткани, отметка ростовок, возврат массива структур.
//
// Отличия от обычной формы, вынужденные переходом на управляемую:
//  * параметры приходят через Параметры формы, а не через ВладелецФормы -
//    у управляемой формы нет доступа к реквизитам обычной формы-владельца;
//  * СтруктураИсходныхПараметров не передаётся целиком (в ней лежит
//    ДокументОбъект, который между клиентом и сервером не сериализуется) -
//    вместо неё приходят отдельные реквизиты: ТипЦен, ДатаДокумента и т.д.;
//  * раскраска строк - условное оформление по ключам в скрытых колонках,
//    а не ПриВыводеСтроки (в управляемых формах такого события нет);
//  * флажки "0" и "Наличие" пересобирают таблицу на месте, а не закрывают
//    форму с просьбой переоткрыть подбор;
//  * работа с весами и команды контекстного меню (картинка в буфер, ссылка
//    на сайт) не перенесены - они завязаны на обычные формы и COM.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПрочитатьПараметрыФормы();

	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		СообщитьПользователю("Форма подбора открывается для конкретной номенклатуры.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Заголовок = "Количество и цена """ + Строка(Номенклатура) + """";

	ВосстановитьНастройкиПользователя();
	ЗаполнитьТаблицуХарактеристикИзПараметров();
	ЗаполнитьГруппыСкладов();

	Элементы.ХарактеристикиКоличетсвоКВыгрузка.Видимость = Выгрузка;
	Элементы.ХарактеристикиЦена.ТолькоПросмотр            = Не ЗапрашиватьЦену;
	Элементы.ХарактеристикиКоличество.ТолькоПросмотр      = Не ЗапрашиватьКоличество;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Тяжёлую часть (остатки, резервы, коррекция по ростовкам) считаем после показа
	// формы - так диалог появляется сразу, как и в обычной форме подбора.
	ПодключитьОбработчикОжидания("ОтложенноеЗаполнение", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ОтложенноеЗаполнение()

	ПересобратьТаблицуНаСервере();

КонецПроцедуры

#КонецОбласти

#Область ЧтениеПараметров

&НаСервере
Процедура ПрочитатьПараметрыФормы()

	СписокРеквизитов = "Номенклатура, ЕдиницаИзмерения, ВалютаЦены, ДатаРасчетов, Количество, Цена, "
		+ "ЗапрашиватьЦену, ЗапрашиватьКоличество, РазворачиватьДоКачества, "
		+ "ЭтоЗаказ, ОснованиеЗаказПокупателя, Контрагент, ДоговорКонтрагента, "
		+ "ТипЦенНоменклатуры, ТипЦенКонтрагента, ДатаДокумента, ВалютаДокумента, "
		+ "ЦенаПоРеализации, СобиратьНК";

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, СписокРеквизитов);

	Если Не ЗначениеЗаполнено(ДатаРасчетов) Тогда
		ДатаРасчетов = ТекущаяДата();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = ДатаРасчетов;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВалютаДокумента) Тогда
		ВалютаДокумента = ВалютаЦены;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуХарактеристикИзПараметров()

	Если Не Параметры.Свойство("Строки") Или ТипЗнч(Параметры.Строки) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого ОписаниеСтроки Из Параметры.Строки Цикл

		НоваяСтрока = ТаблицаХарактеристикНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОписаниеСтроки);

		Если Не ЗначениеЗаполнено(НоваяСтрока.ЕдиницаИзмерения) Тогда
			НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(НоваяСтрока.ВалютаЦены) Тогда
			НоваяСтрока.ВалютаЦены = ВалютаЦены;
		КонецЕсли;

	КонецЦикла;

	СкопироватьСтроки(ТаблицаХарактеристикИсходная, ТаблицаХарактеристикНоменклатуры);

КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройкиПользователя()

	Значение = ХранилищеОбщихНастроек.Загрузить("ПодборНоменклатуры", "УбиратьНолевые");
	УбиратьНолевые = ?(Значение = Неопределено, Ложь, Значение);

	Значение = ХранилищеОбщихНастроек.Загрузить("ПодборНоменклатуры", "УбиратьНеДоступные");
	УбиратьНеДоступные = ?(Значение = Неопределено, Истина, Значение);

	Значение = ХранилищеОбщихНастроек.Загрузить("ПодборНоменклатуры", "Разделитель");
	Разделитель = ?(Значение = Неопределено, Истина, Значение);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьНастройку(Имя, Значение)

	ХранилищеОбщихНастроек.Сохранить("ПодборНоменклатуры", Имя, Значение);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СообщитьПользователю(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область ПересборкаТаблицы

// Полный пересчёт: остатки по ростовкам, коррекция строк по настройкам "0" и
// "Наличие", раскраска, колонки остатков и итоги. Вызывается после открытия
// формы и при изменении настроек, влияющих на состав строк.
&НаСервере
Процедура ПересобратьТаблицуНаСервере()

	Кэш = НовыйКэш();

	СкопироватьСтроки(ТаблицаХарактеристикНоменклатуры, ТаблицаХарактеристикИсходная);

	ПредзагрузитьОстаткиРезервыПоРостовкам(Кэш);

	Если ОснованиеЗаказПокупателя Тогда
		ВычислитьДоступныйОстатокКроя(Кэш);
	КонецЕсли;

	Если Выгрузка Тогда
		ЗаполнитьОстатокРозницы();
	КонецЕсли;

	Если УбиратьНеДоступные Тогда
		СкорректироватьПоОстаткамНеДоступным(Кэш);
	КонецЕсли;

	Если УбиратьНолевые Тогда
		СкорректироватьПоОстаткам(Кэш);
	КонецЕсли;

	СкопироватьСтроки(ТаблицаХарактеристикПолная, ТаблицаХарактеристикНоменклатуры);

	ПрименитьОтбор(Кэш);

КонецПроцедуры

// Отбор по отмеченным цветам/размерам/тканям + пересчёт колонок остатков.
&НаСервере
Процедура ПрименитьОтбор(Кэш)

	ОтмеченныеЦвета   = ОтмеченныеЗначения(ЦветСписок);
	ОтмеченныеРазмеры = ОтмеченныеЗначения(РазмерСписок);
	ОтмеченныеТкани   = ОтмеченныеЗначения(ТканьСписок);

	Отобранные = Новый Массив;

	Для Каждого Стр Из ТаблицаХарактеристикПолная Цикл

		Части = ЧастиХарактеристики(Стр.Характеристика);

		Если Не ПодходитПоЧастям(Части, ОтмеченныеЦвета)
		 Или Не ПодходитПоЧастям(Части, ОтмеченныеРазмеры)
		 Или Не ПодходитПоЧастям(Части, ОтмеченныеТкани) Тогда
			Продолжить;
		КонецЕсли;

		Отобранные.Добавить(Стр);

	КонецЦикла;

	ТаблицаХарактеристикНоменклатуры.Очистить();

	Для Каждого Стр Из Отобранные Цикл
		НоваяСтрока = ТаблицаХарактеристикНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;

	ЗаполнитьОформлениеСтрок(Кэш);
	ПерестроитьКолонкиОстатков(Кэш);
	ОбновитьИтоги();

КонецПроцедуры

// Копирование строк между таблицами формы по совпадающим колонкам: Загрузить
// здесь не подходит - у видимой таблицы есть динамические колонки остатков.
&НаСервере
Процедура СкопироватьСтроки(Приемник, Источник)

	Приемник.Очистить();

	Для Каждого Стр Из Источник Цикл
		НоваяСтрока = Приемник.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОтмеченныеЗначения(Список)

	Результат = Новый Массив;

	Для Каждого Стр Из Список Цикл
		Если Стр.Пометка Тогда
			Результат.Добавить(СокрЛП(Стр.Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Характеристика записана как "Цвет, Размер, Ткань" - разбираем её на части,
// по ним же работают и отбор, и кнопки групповой отметки.
&НаСервереБезКонтекста
Функция ЧастиХарактеристики(Характеристика)

	Результат = Новый Массив;

	Для Каждого Часть Из СтрРазделить(СокрЛП(Строка(Характеристика)), ",") Цикл
		Если Не ПустаяСтрока(Часть) Тогда
			Результат.Добавить(СокрЛП(Часть));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ПодходитПоЧастям(Части, Отмеченные)

	Если Отмеченные.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Значение Из Отмеченные Цикл
		Если Части.Найти(Значение) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область КэшОстатков

&НаСервереБезКонтекста
Функция НовыйКэш()

	Кэш = Новый Структура;
	Кэш.Вставить("ОстаткиРезервы", Новый Соответствие);
	Кэш.Вставить("Характеристики", Новый Соответствие);
	Кэш.Вставить("Цвета",          Новый Соответствие);
	Кэш.Вставить("СкладыГрупп",    Новый Соответствие);
	Кэш.Вставить("СкладыКроя",     Неопределено);

	Возврат Кэш;

КонецФункции

&НаСервереБезКонтекста
Функция КлючСкладов(МассивСкладов)

	Ключ = "";

	Если МассивСкладов <> Неопределено Тогда
		Для Каждого Склад Из МассивСкладов Цикл
			Ключ = Ключ + Строка(Склад.УникальныйИдентификатор()) + ";";
		КонецЦикла;
	КонецЕсли;

	Возврат Ключ;

КонецФункции

&НаСервереБезКонтекста
Функция КлючОстатка(Приставка, Номенклатура, Склад, Характеристика, НаДату)

	Возврат Приставка + "|" + Строка(Номенклатура) + "|" + Строка(Характеристика)
		+ "|" + КлючСкладов(Склад) + "|" + Строка(НаДату);

КонецФункции

&НаСервереБезКонтекста
Функция ОстатокКэш(Кэш, Номенклатура, Склад, Характеристика, НаДату)

	Ключ = КлючОстатка("О", Номенклатура, Склад, Характеристика, НаДату);
	Значение = Кэш.ОстаткиРезервы.Получить(Ключ);

	Если Значение = Неопределено Тогда
		Значение = ОбщегоНазначения.ОстатокНоменклатуры(Номенклатура, Склад, Характеристика, НаДату);
		Кэш.ОстаткиРезервы.Вставить(Ключ, Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

&НаСервереБезКонтекста
Функция РезервКэш(Кэш, Номенклатура, Склад, Характеристика, НаДату)

	Ключ = КлючОстатка("Р", Номенклатура, Склад, Характеристика, НаДату);
	Значение = Кэш.ОстаткиРезервы.Получить(Ключ);

	Если Значение = Неопределено Тогда
		Значение = ОбщегоНазначения.РезервНоменклатуры(Номенклатура, Склад, Характеристика, НаДату);
		Кэш.ОстаткиРезервы.Вставить(Ключ, Значение);
	КонецЕсли;

	Возврат Значение;

КонецФункции

&НаСервереБезКонтекста
Функция ЭлементКэшаХарактеристики(Кэш, Характеристика)

	Элемент = Кэш.Характеристики.Получить(Характеристика);

	Если Элемент = Неопределено Тогда
		Элемент = Новый Структура(
			"Объект, ОбъектВычислен, Ростовка, РостовкаВычислена,
			|ИнформацияПоРостовке, ИнфоВычислена, СвободныйОстаток, ОстатокВычислен",
			Неопределено, Ложь, Неопределено, Ложь, Неопределено, Ложь, 0, Ложь);
		Кэш.Характеристики.Вставить(Характеристика, Элемент);
	КонецЕсли;

	Возврат Элемент;

КонецФункции

&НаСервереБезКонтекста
Функция ОбъектХарактеристикиКэш(Кэш, Характеристика)

	Элемент = ЭлементКэшаХарактеристики(Кэш, Характеристика);

	Если Не Элемент.ОбъектВычислен Тогда
		Элемент.Объект = Характеристика.ПолучитьОбъект();
		Элемент.ОбъектВычислен = Истина;
	КонецЕсли;

	Возврат Элемент.Объект;

КонецФункции

&НаСервереБезКонтекста
Функция РостовкаКэш(Кэш, Характеристика)

	Элемент = ЭлементКэшаХарактеристики(Кэш, Характеристика);

	Если Не Элемент.РостовкаВычислена Тогда
		Элемент.Ростовка = ОбъектХарактеристикиКэш(Кэш, Характеристика).ПолучитьРостовку(Истина);
		Элемент.РостовкаВычислена = Истина;
	КонецЕсли;

	Возврат Элемент.Ростовка;

КонецФункции

&НаСервереБезКонтекста
Функция ИнформацияПоРостовкеКэш(Кэш, Характеристика)

	Элемент = ЭлементКэшаХарактеристики(Кэш, Характеристика);

	Если Не Элемент.ИнфоВычислена Тогда
		Элемент.ИнформацияПоРостовке = ОбъектХарактеристикиКэш(Кэш, Характеристика).ПолучимИнформациюПоРостовке();
		Элемент.ИнфоВычислена = Истина;
	КонецЕсли;

	Возврат Элемент.ИнформацияПоРостовке;

КонецФункции

&НаСервереБезКонтекста
Функция СвободныйОстатокКрояКэш(Кэш, Характеристика)

	Элемент = ЭлементКэшаХарактеристики(Кэш, Характеристика);

	Если Не Элемент.ОстатокВычислен Тогда

		Если Кэш.СкладыКроя = Неопределено Тогда
			Кэш.СкладыКроя = СкладыГруппы(Справочники.Склады.НайтиПоКоду("000000034"));
		КонецЕсли;

		Элемент.СвободныйОстаток = ОбъектХарактеристикиКэш(Кэш, Характеристика).СвободныйОстаток(Кэш.СкладыКроя);
		Элемент.ОстатокВычислен = Истина;

	КонецЕсли;

	Возврат Элемент.СвободныйОстаток;

КонецФункции

&НаСервереБезКонтекста
Функция СкладыГруппыКэш(Кэш, Группа)

	Склады = Кэш.СкладыГрупп.Получить(Группа);

	Если Склады = Неопределено Тогда
		Склады = СкладыГруппы(Группа);
		Кэш.СкладыГрупп.Вставить(Группа, Склады);
	КонецЕсли;

	Возврат Склады;

КонецФункции

&НаСервереБезКонтекста
Функция СкладыГруппы(Группа)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Склады.Ссылка КАК Склад
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ЭтоГруппа
	|	И НЕ Склады.ПометкаУдаления
	|	И Склады.Ссылка В ИЕРАРХИИ(&Группа)";

	Запрос.УстановитьПараметр("Группа", Группа);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Склад");

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоХарактеристика(Значение)

	Возврат ТипЗнч(Значение) = Тип("СправочникСсылка.ХарактеристикиНоменклатуры")
		И ЗначениеЗаполнено(Значение);

КонецФункции

// Один пакетный запрос вместо запроса на каждый размер каждой ростовки:
// собираем все характеристики, которые понадобятся проверкам по остаткам,
// и кладём результат в тот же кэш, которым пользуются ОстатокКэш/РезервКэш.
// Наборы (ВидНоменклатуры = "000000010") в выборку не попадают - у них
// особый расчёт остатка, для них запрос уйдёт поштучно, как раньше.
&НаСервере
Процедура ПредзагрузитьОстаткиРезервыПоРостовкам(Кэш)

	НаДату = ТекущаяДата();

	МассивХарактеристик = Новый Массив;
	Обработано = Новый Соответствие;

	Для Каждого Стр Из ТаблицаХарактеристикНоменклатуры Цикл

		Если Не ЭтоХарактеристика(Стр.Характеристика) Тогда
			Продолжить;
		КонецЕсли;

		Ростовка = РостовкаКэш(Кэш, Стр.Характеристика);

		Если Не ЗначениеЗаполнено(Ростовка) Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого СтрРостовки Из Ростовка.Характеристики Цикл

			Ключ = Строка(СтрРостовки.Характеристика.УникальныйИдентификатор());

			Если Обработано.Получить(Ключ) = Неопределено Тогда
				Обработано.Вставить(Ключ, Истина);
				МассивХарактеристик.Добавить(СтрРостовки.Характеристика);
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Если МассивХарактеристик.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры КАК Характеристика,
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ТоварыНаСкладахОстатки.КоличествоОстаток) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(
	|			&НаДату,
	|			ХарактеристикаНоменклатуры В (&МассивХарактеристик)
	|				И Номенклатура.ВидНоменклатуры.Код <> ""000000010"") КАК ТоварыНаСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры,
	|	ТоварыНаСкладахОстатки.Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК Характеристика,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток) КАК Резерв
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|			&НаДату,
	|			ХарактеристикаНоменклатуры В (&МассивХарактеристик)
	|				И Номенклатура.ВидНоменклатуры.Код <> ""000000010"") КАК ТоварыВРезервеНаСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры,
	|	ТоварыВРезервеНаСкладахОстатки.Номенклатура";

	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("МассивХарактеристик", МассивХарактеристик);

	Результаты = Запрос.ВыполнитьПакет();

	Для Каждого Стр Из Результаты[0].Выгрузить() Цикл
		Ключ = КлючОстатка("О", Стр.Номенклатура, Новый Массив, Стр.Характеристика, НаДату);
		Кэш.ОстаткиРезервы.Вставить(Ключ, Стр.Остаток);
	КонецЦикла;

	Для Каждого Стр Из Результаты[1].Выгрузить() Цикл
		Ключ = КлючОстатка("Р", Стр.Номенклатура, Новый Массив, Стр.Характеристика, НаДату);
		Кэш.ОстаткиРезервы.Вставить(Ключ, Стр.Резерв);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область КоррекцияСтрокПоОстаткам

// Убрать строки, у которых по всей ростовке нет ни остатка, ни резерва.
&НаСервере
Процедура СкорректироватьПоОстаткам(Кэш)

	НужноУдалить = Новый Массив;

	Для Каждого Стр Из ТаблицаХарактеристикНоменклатуры Цикл

		Если Не ЭтоХарактеристика(Стр.Характеристика) Тогда
			Продолжить;
		КонецЕсли;

		Ростовка = РостовкаКэш(Кэш, Стр.Характеристика);

		Если Не ЗначениеЗаполнено(Ростовка) Или Ростовка.ИгнорироватьНоль Тогда
			Продолжить;
		КонецЕсли;

		ЕстьДвижение = Ложь;

		Для Каждого СтрРостовки Из Ростовка.Характеристики Цикл

			Владелец = СтрРостовки.Характеристика.Владелец;
			Остаток  = ОстатокКэш(Кэш, Владелец, Новый Массив, СтрРостовки.Характеристика, ТекущаяДата());
			Резервы  = РезервКэш(Кэш, Владелец, Новый Массив, СтрРостовки.Характеристика, ТекущаяДата());

			Если Остаток <> 0 Или Резервы <> 0 Тогда
				ЕстьДвижение = Истина;
			КонецЕсли;

		КонецЦикла;

		Если Не ЕстьДвижение Тогда
			НужноУдалить.Добавить(ТаблицаХарактеристикНоменклатуры.Индекс(Стр));
		КонецЕсли;

	КонецЦикла;

	// удаляем с конца - индексы строк выше по таблице от этого не съезжают
	Для Сч = 1 По НужноУдалить.Количество() Цикл
		ТаблицаХарактеристикНоменклатуры.Удалить(НужноУдалить[НужноУдалить.Количество() - Сч]);
	КонецЦикла;

КонецПроцедуры

// Убрать строки, недоступные к продаже: по всей ростовке свободного остатка нет
// (для ростовок с "игнорировать ноль" учитываем предзаказ).
&НаСервере
Процедура СкорректироватьПоОстаткамНеДоступным(Кэш)

	НужноУдалить = Новый Массив;

	Для Каждого Стр Из ТаблицаХарактеристикНоменклатуры Цикл

		Если Не ЭтоХарактеристика(Стр.Характеристика) Тогда
			Продолжить;
		КонецЕсли;

		Ростовка = РостовкаКэш(Кэш, Стр.Характеристика);

		Если Не ЗначениеЗаполнено(Ростовка) Тогда
			Продолжить;
		КонецЕсли;

		ЕстьДоступный = Ложь;

		Для Каждого СтрРостовки Из Ростовка.Характеристики Цикл

			Владелец = СтрРостовки.Характеристика.Владелец;
			Остаток  = ОстатокКэш(Кэш, Владелец, Новый Массив, СтрРостовки.Характеристика, ТекущаяДата());
			РезервСтроки = РезервКэш(Кэш, Владелец, Новый Массив, СтрРостовки.Характеристика, ТекущаяДата());
			Свободно = Остаток - РезервСтроки;

			Если Ростовка.ИгнорироватьНоль Тогда

				ПредЗаказ = Ростовка.ИНКоличество;

				Если ПредЗаказ = 0 Тогда
					ЕстьДоступный = Истина;
					Продолжить;
				КонецЕсли;

				Если Свободно + ПредЗаказ > 0 Тогда
					ЕстьДоступный = Истина;
				КонецЕсли;

			Иначе

				Если Свободно > 0 Тогда
					ЕстьДоступный = Истина;
				КонецЕсли;

			КонецЕсли;

		КонецЦикла;

		Если Не ЕстьДоступный Тогда
			НужноУдалить.Добавить(ТаблицаХарактеристикНоменклатуры.Индекс(Стр));
		КонецЕсли;

	КонецЦикла;

	// удаляем с конца - индексы строк выше по таблице от этого не съезжают
	Для Сч = 1 По НужноУдалить.Количество() Цикл
		ТаблицаХарактеристикНоменклатуры.Удалить(НужноУдалить[НужноУдалить.Количество() - Сч]);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстатокРозницы()

	ГруппаСклада = Константы.СкладНашСайтРозница.Получить();

	Для Каждого Стр Из ТаблицаХарактеристикНоменклатуры Цикл

		Если Не ЭтоХарактеристика(Стр.Характеристика) Тогда
			Продолжить;
		КонецЕсли;

		ХарактеристикаОбъект = Стр.Характеристика.ПолучитьОбъект();
		Стр.КоличетсвоКВыгрузка = ХарактеристикаОбъект.ПолучитьКоличествоКВыгрузкеСУчетомРазбитияРостовкок(, ГруппаСклада);

	КонецЦикла;

КонецПроцедуры

// Пересчёт того, сколько из нового кроя уже разобрано предзаказами.
&НаСервере
Процедура ВычислитьДоступныйОстатокКроя(Кэш)

	КолВоНовогоКроя1 = Номенклатура.КолВоНовогоКроя1;
	КолВоНовогоКроя2 = Номенклатура.КолВоНовогоКроя2;

	ДоступныйОстатокКроя1 = КолВоНовогоКроя1;
	ДоступныйОстатокКроя2 = КолВоНовогоКроя2;

	СкладыКроя = СкладыГруппыКэш(Кэш, Справочники.Склады.НайтиПоКоду("000000053"));

	Для Каждого Стр Из ТаблицаХарактеристикНоменклатуры Цикл

		Если Не ЭтоХарактеристика(Стр.Характеристика) Тогда
			Продолжить;
		КонецЕсли;

		Ростовка = РостовкаКэш(Кэш, Стр.Характеристика);

		Если Ростовка = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ИнфаПоРостовке = ИнформацияПоРостовкеКэш(Кэш, Стр.Характеристика);

		Если Не ИнфаПоРостовке.ИгнорироватьНоль Тогда
			Продолжить;
		КонецЕсли;

		Стр.Ростовка = Ростовка;

		ХарактеристикаОбъект = ОбъектХарактеристикиКэш(Кэш, Стр.Характеристика);
		ДатаИзготовления = ХарактеристикаОбъект.ПолучитьДатуИзготовления(Истина);
		Стр.Диапазон = ХарактеристикаОбъект.ПолучитьДиапазонИзготовления(Истина);

		Если ЗначениеЗаполнено(ДатаИзготовления) Тогда
			Стр.ДатаИсполнения      = ДатаИзготовления.ДатаПошиваНачало;
			Стр.ДатаИсполненияКонец = ДатаИзготовления.ДатаПошиваКонец;
		КонецЕсли;

		РезервСтроки = РезервКэш(Кэш, Номенклатура, СкладыКроя, Стр.Характеристика, ТекущаяДата());
		Остаток      = ОстатокКэш(Кэш, Номенклатура, СкладыКроя, Стр.Характеристика, ТекущаяДата());
		Свободно     = Остаток - РезервСтроки;

		Если ИнфаПоРостовке.ИНКоличество <> 0 Тогда

			Если Стр.РазмерЕстьВКрое1 Тогда
				ДоступныйОстатокКроя1 = ДоступныйОстатокКроя1 - ИнфаПоРостовке.ИНКоличество;
			КонецЕсли;

			Если Стр.РазмерЕстьВКрое2 Тогда
				ДоступныйОстатокКроя2 = ДоступныйОстатокКроя2 - ИнфаПоРостовке.ИНКоличество;
			КонецЕсли;

		Иначе

			Если Стр.РазмерЕстьВКрое1 Тогда
				ДоступныйОстатокКроя1 = ДоступныйОстатокКроя1 + Свободно;
			КонецЕсли;

			Если Стр.РазмерЕстьВКрое2 Тогда
				ДоступныйОстатокКроя2 = ДоступныйОстатокКроя2 + Свободно;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Если ДоступныйОстатокКроя1 <> КолВоНовогоКроя1 Или ДоступныйОстатокКроя2 <> КолВоНовогоКроя2 Тогда

		НоменклатураОбъект = Номенклатура.ПолучитьОбъект();

		Если ДоступныйОстатокКроя1 <> КолВоНовогоКроя1 Тогда
			НоменклатураОбъект.КолВоУжеВзятогоПредзаказНаКрой1 = ДоступныйОстатокКроя1;
		КонецЕсли;

		Если ДоступныйОстатокКроя2 <> КолВоНовогоКроя2 Тогда
			НоменклатураОбъект.КолВоУжеВзятогоПредзаказНаКрой2 = ДоступныйОстатокКроя2;
		КонецЕсли;

		НоменклатураОбъект.Записать();

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОформлениеСтрок

// В управляемой форме нет ПриВыводеСтроки, поэтому раскраску считаем заранее:
// в скрытые колонки строки кладём ключи, а условное оформление настраиваем
// по фактически встретившимся ключам.
&НаСервере
Процедура ЗаполнитьОформлениеСтрок(Кэш)

	ИспользуемыеЦвета = Новый Соответствие;

	Для Каждого Стр Из ТаблицаХарактеристикНоменклатуры Цикл

		Стр.КлючФона  = "";
		Стр.КлючЦвета = "";
		Стр.КлючРамки = "";

		Если Не ЭтоХарактеристика(Стр.Характеристика) Тогда
			Продолжить;
		КонецЕсли;

		Если ОснованиеЗаказПокупателя Тогда
			ЗаполнитьКлючФонаСтроки(Кэш, Стр);
		КонецЕсли;

		ЦветЗаливки = ЦветНоменклатуры(Кэш, Стр.Характеристика, 1);
		ЦветРамки   = ЦветНоменклатуры(Кэш, Стр.Характеристика, 0);

		Если ЦветЗаливки <> Неопределено Тогда
			Стр.КлючЦвета = ЦветЗаливки.Ключ;
			ИспользуемыеЦвета.Вставить(ЦветЗаливки.Ключ, ЦветЗаливки.Цвет);
		КонецЕсли;

		Если ЦветРамки <> Неопределено Тогда
			Стр.КлючРамки = ЦветРамки.Ключ;
			ИспользуемыеЦвета.Вставить(ЦветРамки.Ключ, ЦветРамки.Цвет);
		ИначеЕсли ЦветЗаливки <> Неопределено Тогда
			Стр.КлючРамки = ЦветЗаливки.Ключ;
		КонецЕсли;

	КонецЦикла;

	НастроитьУсловноеОформление(ИспользуемыеЦвета);

КонецПроцедуры

// Текст колонки "Крой" и фон строки: жёлтый - предзаказ, томатный - в ноль,
// красный - за пределами доступного остатка кроя.
&НаСервере
Процедура ЗаполнитьКлючФонаСтроки(Кэш, Стр)

	Свободно       = СвободныйОстатокКрояКэш(Кэш, Стр.Характеристика);
	ИнфаПоРостовке = ИнформацияПоРостовкеКэш(Кэш, Стр.Характеристика);

	Если ИнфаПоРостовке.ИгнорироватьНоль Тогда

		Стр.КлючФона = "Предзаказ";

		КоличествоВПредзаказе = ?(ИнфаПоРостовке.ИНКоличество = 100, "∞", Строка(ИнфаПоРостовке.ИНКоличество));
		Стр.Цвет = СокрЛП(Стр.Диапазон) + " " + КоличествоВПредзаказе;

		Если ИнфаПоРостовке.ИНКоличество <> 0 Тогда

			Если Свободно - Стр.Количество + ИнфаПоРостовке.ИНКоличество = 0 Тогда
				Стр.КлючФона = "Ноль";
			ИначеЕсли Свободно - Стр.Количество + ИнфаПоРостовке.ИНКоличество < 0 Тогда
				Стр.КлючФона = "Минус";
			КонецЕсли;

		КонецЕсли;

	Иначе

		Стр.Цвет = СокрЛП(Стр.Диапазон);

		Если Свободно - Стр.Количество = 0 Тогда
			Стр.КлючФона = "Ноль";
		ИначеЕсли Свободно - Стр.Количество < 0 Тогда
			Стр.КлючФона = "Минус";
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// У объекта Цвет, созданного через Новый Цвет(...), компоненты обратно не читаются
// (Поле объекта не обнаружено (Red)), поэтому ключ условного оформления собирается
// здесь же - из чисел, пока они на руках.
&НаСервереБезКонтекста
Функция ОписаниеЦвета(Красный, Зеленый, Голубой)

	Возврат Новый Структура("Цвет, Ключ",
		Новый Цвет(Красный, Зеленый, Голубой),
		Строка(Красный) + "-" + Строка(Зеленый) + "-" + Строка(Голубой));

КонецФункции

&НаСервере
Процедура НастроитьУсловноеОформление(ИспользуемыеЦвета)

	УсловноеОформление.Элементы.Очистить();

	ДобавитьОформлениеПоКлючу("КлючФона", "Предзаказ", "ЦветФона", WebЦвета.СветлоЗолотистый,
		"ХарактеристикиХарактеристика");
	ДобавитьОформлениеПоКлючу("КлючФона", "Ноль", "ЦветФона", WebЦвета.Томатный,
		"ХарактеристикиХарактеристика, ХарактеристикиКоличество");
	ДобавитьОформлениеПоКлючу("КлючФона", "Минус", "ЦветФона", WebЦвета.Красный,
		"ХарактеристикиХарактеристика, ХарактеристикиКоличество");

	Если ЭтоЗаказ Тогда
		Элемент = УсловноеОформление.Элементы.Добавить();
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТаблицаХарактеристикНоменклатуры.ДоступенКПродаже");
		ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = Ложь;
		ОтборЭлемента.Использование  = Истина;
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Красный);
	КонецЕсли;

	Для Каждого КлючИЗначение Из ИспользуемыеЦвета Цикл
		ДобавитьОформлениеПоКлючу("КлючЦвета", КлючИЗначение.Ключ, "ЦветФона", КлючИЗначение.Значение,
			"ХарактеристикиЦвет");
		ДобавитьОформлениеПоКлючу("КлючРамки", КлючИЗначение.Ключ, "ЦветФона", КлючИЗначение.Значение,
			"ХарактеристикиЦвет1");
	КонецЦикла;

	Если ИспользуемыеЦвета.Количество() > 0 Тогда
		Элемент = УсловноеОформление.Элементы.Добавить();
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТаблицаХарактеристикНоменклатуры.КлючЦвета");
		ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
		ОтборЭлемента.ПравоеЗначение = "";
		ОтборЭлемента.Использование  = Истина;
		Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Белый);
		ПолеОформления = Элемент.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ХарактеристикиЦвет");
		ПолеОформления.Использование = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьОформлениеПоКлючу(ИмяКолонки, Ключ, ИмяПараметра, ЗначениеПараметра, ИменаПолей)

	Элемент = УсловноеОформление.Элементы.Добавить();

	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ТаблицаХарактеристикНоменклатуры." + ИмяКолонки);
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ключ;
	ОтборЭлемента.Использование  = Истина;

	Элемент.Оформление.УстановитьЗначениеПараметра(ИмяПараметра, ЗначениеПараметра);

	Для Каждого ИмяПоля Из СтрРазделить(ИменаПолей, ",") Цикл
		Если ПустаяСтрока(ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		ПолеОформления = Элемент.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(СокрЛП(ИмяПоля));
		ПолеОформления.Использование = Истина;
	КонецЦикла;

КонецПроцедуры

// Цвет из справочника АСБ_ЦветаНоменклатуры по первой части характеристики.
// ВидЦвета = 1 - заливка, ВидЦвета = 0 - цвет рамки (второй цвет).
// Возвращает Неопределено или структуру "Цвет, Ключ" - см. ОписаниеЦвета.
&НаСервере
Функция ЦветНоменклатуры(Кэш, Характеристика, ВидЦвета)

	Части = ЧастиХарактеристики(Характеристика);

	Если Части.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Наименование = Части[0];
	КлючКэша = Наименование + "|" + Строка(ВидЦвета);
	ИзКэша = Кэш.Цвета.Получить(КлючКэша);

	Если ИзКэша <> Неопределено Тогда
		Возврат ИзКэша;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АСБ_ЦветаНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АСБ_ЦветаНоменклатуры КАК АСБ_ЦветаНоменклатуры
	|ГДЕ
	|	АСБ_ЦветаНоменклатуры.Наименование = &Наименование
	|	И АСБ_ЦветаНоменклатуры.Владелец = &Владелец";

	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Запрос.УстановитьПараметр("Наименование", Наименование);

	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Неопределено;

	Если Выборка.Следующий() Тогда

		ЭлементЦвета = Выборка.Ссылка;

		Если ВидЦвета = 1 Тогда

			Если ЭлементЦвета.ТипЦвета1 = "RAL" Или ЭлементЦвета.ТипЦвета1 = "" Тогда
				Если ЗначениеЗаполнено(ЭлементЦвета.Цвет) Тогда
					// реквизит справочника - у него компоненты читаются
					Результат = ОписаниеЦвета(ЭлементЦвета.Цвет.Red, ЭлементЦвета.Цвет.Green, ЭлементЦвета.Цвет.Blue);
				КонецЕсли;
			ИначеЕсли ЭлементЦвета.ТипЦвета1 = "RGB" Или ЭлементЦвета.ТипЦвета1 = "HEX" Тогда
				Если ЗначениеЗаполнено(ЭлементЦвета.ЦветRGB) Тогда
					Результат = ОписаниеЦвета(ЭлементЦвета.Красный, ЭлементЦвета.Зеленый, ЭлементЦвета.Голубой);
				КонецЕсли;
			КонецЕсли;

		Иначе

			Если ЭлементЦвета.ТипЦвета2 = "RGB" Или ЭлементЦвета.ТипЦвета2 = "HEX" Тогда
				Результат = ОписаниеЦвета(ЭлементЦвета.Красный1, ЭлементЦвета.Зеленый1, ЭлементЦвета.Голубой1);
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	Кэш.Цвета.Вставить(КлючКэша, Результат);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Склады

&НаСервере
Процедура ЗаполнитьГруппыСкладов()

	Если ТабГруппСкладов.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЛОЖЬ КАК Отметка,
	|	Склады.Ссылка КАК Склад
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ПометкаУдаления
	|	И Склады.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад";

	Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
		НоваяСтрока = ТабГруппСкладов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;

	ЗаполнитьСклады();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСклады()

	МассивГрупп = Новый Массив;

	Для Каждого Стр Из ТабГруппСкладов Цикл
		Если Стр.Отметка Тогда
			МассивГрупп.Добавить(Стр.Склад);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЛОЖЬ КАК Отметка,
	|	Склады.Ссылка КАК Склад
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ПометкаУдаления
	|	И НЕ Склады.ЭтоГруппа
	|	И Склады.Родитель В ИЕРАРХИИ(&МассивРодителей)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склады.Наименование";

	Запрос.УстановитьПараметр("МассивРодителей", МассивГрупп);

	ТабСклады.Очистить();

	Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
		НоваяСтрока = ТабСклады.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСкладыПоГруппеДоступности()

	ТабСклады.Очистить();

	Если Не ЗначениеЗаполнено(ГруппаСкладов) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставГруппДоступностиСкладов.Склад КАК Склад,
	|	ЛОЖЬ КАК Отметка
	|ИЗ
	|	РегистрСведений.СоставГруппДоступностиСкладов КАК СоставГруппДоступностиСкладов
	|ГДЕ
	|	СоставГруппДоступностиСкладов.ГруппаДоступности = &ГруппаДоступности
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад";

	Запрос.УстановитьПараметр("ГруппаДоступности", ГруппаСкладов);

	Для Каждого Стр Из Запрос.Выполнить().Выгрузить() Цикл
		НоваяСтрока = ТабСклады.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;

КонецПроцедуры

// Имя колонки остатка: "О_" для склада, "Г_" для группы складов. Пять первых
// символов имени склада - как в обычной форме, плюс отсев символов, которые
// нельзя использовать в имени реквизита.
&НаСервереБезКонтекста
Функция ИмяКолонкиСклада(Приставка, Склад)

	Текст = СтрЗаменить(СтрЗаменить(СокрЛП(Строка(Склад)), """", ""), " ", "");
	Очищенный = "";

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("()[]{}.,;:-+*/\?!<>=""'`~@#$%^&|", Символ) = 0 Тогда
			Очищенный = Очищенный + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Приставка + Лев(Очищенный, 5);

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоКолонкаОстатка(Имя)

	Возврат Лев(Имя, 2) = "О_" Или Лев(Имя, 2) = "Г_" Или Имя = "Ит";

КонецФункции

// Колонки остатков по отмеченным складам и группам создаются на лету:
// реквизиты - ИзменитьРеквизиты, элементы - Элементы.Добавить.
&НаСервере
Процедура ПерестроитьКолонкиОстатков(Кэш)

	СохраненныеСтроки = ТаблицаХарактеристикНоменклатуры.Выгрузить();

	УдаляемыеРеквизиты = Новый Массив;

	Для Каждого Реквизит Из ПолучитьРеквизиты("ТаблицаХарактеристикНоменклатуры") Цикл

		Если Не ЭтоКолонкаОстатка(Реквизит.Имя) Тогда
			Продолжить;
		КонецЕсли;

		УдаляемыеРеквизиты.Добавить("ТаблицаХарактеристикНоменклатуры." + Реквизит.Имя);

		Элемент = Элементы.Найти("Кол" + Реквизит.Имя);
		Если Элемент <> Неопределено Тогда
			Элементы.Удалить(Элемент);
		КонецЕсли;

	КонецЦикла;

	НовыеКолонки = Новый Массив;
	Добавленные  = Новый Соответствие;
	ОписаниеСтроки = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20));

	Для Каждого Скл Из ТабГруппСкладов Цикл
		Если Не Скл.Отметка1 Тогда
			Продолжить;
		КонецЕсли;
		Имя = ИмяКолонкиСклада("Г_", Скл.Склад);
		Если Добавленные.Получить(Имя) = Неопределено Тогда
			Добавленные.Вставить(Имя, Скл.Склад);
			НовыеКолонки.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Скл Из ТабСклады Цикл
		Если Не Скл.Отметка Тогда
			Продолжить;
		КонецЕсли;
		Имя = ИмяКолонкиСклада("О_", Скл.Склад);
		Если Добавленные.Получить(Имя) = Неопределено Тогда
			Добавленные.Вставить(Имя, Скл.Склад);
			НовыеКолонки.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Если ИтогПоСкладах Тогда
		Если Добавленные.Получить("Ит") = Неопределено Тогда
			Добавленные.Вставить("Ит", Неопределено);
			НовыеКолонки.Добавить("Ит");
		КонецЕсли;
	КонецЕсли;

	ДобавляемыеРеквизиты = Новый Массив;

	Для Каждого Имя Из НовыеКолонки Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Имя, ОписаниеСтроки,
			"ТаблицаХарактеристикНоменклатуры", ЗаголовокКолонкиОстатка(Имя)));
	КонецЦикла;

	Если ДобавляемыеРеквизиты.Количество() > 0 Или УдаляемыеРеквизиты.Количество() > 0 Тогда
		ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);
	КонецЕсли;

	// ИзменитьРеквизиты пересоздаёт данные формы - возвращаем строки на место.
	ТаблицаХарактеристикНоменклатуры.Очистить();
	Для Каждого Стр Из СохраненныеСтроки Цикл
		НоваяСтрока = ТаблицаХарактеристикНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
	КонецЦикла;

	Для Каждого Имя Из НовыеКолонки Цикл
		Элемент = Элементы.Добавить("Кол" + Имя, Тип("ПолеФормы"), Элементы.ТаблицаХарактеристикНоменклатуры);
		Элемент.Вид         = ВидПоляФормы.ПолеНадписи;
		Элемент.ПутьКДанным = "ТаблицаХарактеристикНоменклатуры." + Имя;
		Элемент.Заголовок   = ЗаголовокКолонкиОстатка(Имя);
		Элемент.Ширина      = ?(Имя = "Ит", 5, ?(Разделитель, 8, 7));
		Элементы.Переместить(Элемент, Элементы.ТаблицаХарактеристикНоменклатуры,
			Элементы.ХарактеристикиКоличетсвоКВыгрузка);
	КонецЦикла;

	ОбновитьОстаткиСкладов(Кэш);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаголовокКолонкиОстатка(Имя)

	Если Имя = "Ит" Тогда
		Возврат "Ит";
	КонецЕсли;

	Возврат Сред(Имя, 3);

КонецФункции

// Заполнение колонок остатков: "остаток (резерв)" по каждому отмеченному складу
// и группе, плюс итог по всем складам, если включён.
&НаСервере
Процедура ОбновитьОстаткиСкладов(Кэш)

	НаДату = ТекущаяДата();
	Заполненные = Новый Соответствие;

	Для Каждого Скл Из ТабГруппСкладов Цикл

		Если Не Скл.Отметка1 Тогда
			Продолжить;
		КонецЕсли;

		Имя = ИмяКолонкиСклада("Г_", Скл.Склад);

		Если Заполненные.Получить(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Заполненные.Вставить(Имя, Истина);

		ЗаполнитьКолонкуОстатка(Кэш, Имя, СкладыГруппыКэш(Кэш, Скл.Склад), НаДату);

	КонецЦикла;

	Для Каждого Скл Из ТабСклады Цикл

		Если Не Скл.Отметка Тогда
			Продолжить;
		КонецЕсли;

		Имя = ИмяКолонкиСклада("О_", Скл.Склад);

		Если Заполненные.Получить(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Заполненные.Вставить(Имя, Истина);

		МассивСкладов = Новый Массив;
		МассивСкладов.Добавить(Скл.Склад);

		ЗаполнитьКолонкуОстатка(Кэш, Имя, МассивСкладов, НаДату);

	КонецЦикла;

	Если ИтогПоСкладах Тогда
		ЗаполнитьКолонкуОстатка(Кэш, "Ит", Новый Массив, НаДату);
	КонецЕсли;

	ОбновитьОстаткиПанелиСкладов(Кэш);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКолонкуОстатка(Кэш, ИмяКолонки, МассивСкладов, НаДату)

	Для Каждого Стр Из ТаблицаХарактеристикНоменклатуры Цикл

		РезервСтроки = РезервКэш(Кэш, Номенклатура, МассивСкладов, Стр.Характеристика, НаДату);
		Остаток      = ОстатокКэш(Кэш, Номенклатура, МассивСкладов, Стр.Характеристика, НаДату);

		Если Резерв Тогда
			Свободно = Строка(Остаток - РезервСтроки);
			Отступ = "";
			Если Разделитель Тогда
				Если СтрДлина(Свободно) = 1 Тогда
					Отступ = "   ";
				ИначеЕсли СтрДлина(Свободно) = 2 Тогда
					Отступ = "  ";
				ИначеЕсли СтрДлина(Свободно) = 3 Тогда
					Отступ = " ";
				КонецЕсли;
			КонецЕсли;
			Значение = Свободно + Отступ + ?(РезервСтроки > 0, " (" + Строка(РезервСтроки) + ")", "");
		Иначе
			Значение = Строка(Остаток);
		КонецЕсли;

		Стр[ИмяКолонки] = ?(Значение = "0", "", Значение);

	КонецЦикла;

КонецПроцедуры

// Правые панели: остаток по каждому складу и по каждой группе для текущей строки.
&НаСервере
Процедура ОбновитьОстаткиПанелиСкладов(Кэш)

	ТекущаяХарактеристика = ТекущаяХарактеристикаТаблицы();

	Если ТекущаяХарактеристика = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НаДату = ТекущаяДата();

	Для Каждого Стр Из ТабСклады Цикл
		МассивСкладов = Новый Массив;
		МассивСкладов.Добавить(Стр.Склад);
		Стр.Остаток = ПредставлениеОстатка(Кэш, МассивСкладов, ТекущаяХарактеристика, НаДату);
	КонецЦикла;

	Для Каждого Стр Из ТабГруппСкладов Цикл
		Стр.Количество = ПредставлениеОстатка(Кэш, СкладыГруппыКэш(Кэш, Стр.Склад), ТекущаяХарактеристика, НаДату);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПредставлениеОстатка(Кэш, МассивСкладов, Характеристика, НаДату)

	РезервПоСкладу = РезервКэш(Кэш, Номенклатура, МассивСкладов, Характеристика, НаДату);
	Свободно = Строка(ОстатокКэш(Кэш, Номенклатура, МассивСкладов, Характеристика, НаДату) - РезервПоСкладу);

	Если Резерв Тогда
		Возврат ?(Свободно = "0", "", Свободно)
			+ ?(РезервПоСкладу = 0, "", " (" + Строка(РезервПоСкладу) + ")");
	КонецЕсли;

	Возврат ?(Свободно = "0", "", Свободно);

КонецФункции

&НаСервере
Функция ТекущаяХарактеристикаТаблицы()

	Идентификатор = Элементы.ТаблицаХарактеристикНоменклатуры.ТекущаяСтрока;

	Если Идентификатор = Неопределено Тогда
		Если ТаблицаХарактеристикНоменклатуры.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ТаблицаХарактеристикНоменклатуры[0].Характеристика;
	КонецЕсли;

	СтрокаТаблицы = ТаблицаХарактеристикНоменклатуры.НайтиПоИдентификатору(Идентификатор);

	Если СтрокаТаблицы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат СтрокаТаблицы.Характеристика;

КонецФункции

