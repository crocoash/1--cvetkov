Процедура СбросОтбораНаСервере()

	Для Каждого Стр Из ЦветСписок Цикл
		Стр.Пометка = Ложь;
	КонецЦикла;

	Для Каждого Стр Из РазмерСписок Цикл
		Стр.Пометка = Ложь;
	КонецЦикла;

	Для Каждого Стр Из ТканьСписок Цикл
		Стр.Пометка = Ложь;
	КонецЦикла;

	ПрименитьОтбор(НовыйКэш());

КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьОтбор(Команда)

	ЗаполнитьОтборНаСервере();

КонецПроцедуры

// Списки отбора собираются из значений свойств характеристик номенклатуры:
// цвет (069, для школьной - 072), размер (099), ткань (065).
&НаСервере
Процедура ЗаполнитьОтборНаСервере()

	Цвета = ЗначенияСвойстваХарактеристик("000000069");

	Если Цвета.Количество() = 0 Тогда
		Цвета = ЗначенияСвойстваХарактеристик("000000072");
	КонецЕсли;

	ЗагрузитьСписокОтбора(ЦветСписок, ОставитьВстречающиесяВХарактеристиках(Цвета));
	ЗагрузитьСписокОтбора(РазмерСписок, ЗначенияСвойстваХарактеристик("000000099"));
	ЗагрузитьСписокОтбора(ТканьСписок, ЗначенияСвойстваХарактеристик("000000065"));

КонецПроцедуры

&НаСервере
Функция ЗначенияСвойстваХарактеристик(КодСвойства)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗначенияСвойствОбъектов.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	|ГДЕ
	|	ЗначенияСвойствОбъектов.Свойство = &Свойство
	|	И ЗначенияСвойствОбъектов.Объект.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	Значение";

	Запрос.УстановитьПараметр("Свойство", ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду(КодСвойства));
	Запрос.УстановитьПараметр("Владелец", Номенклатура);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Значение");

КонецФункции

// Цвета, которых нет ни в одной характеристике таблицы, в отбор не выводим -
// так же, как это делала обычная форма.
&НаСервере
Функция ОставитьВстречающиесяВХарактеристиках(Значения)

	Результат = Новый Массив;

	Для Каждого Значение Из Значения Цикл

		Для Каждого Стр Из ТаблицаХарактеристикПолная Цикл

			Если Не ЭтоХарактеристика(Стр.Характеристика) Тогда
				Продолжить;
			КонецЕсли;

			Если СтрНайти(Стр.Характеристика.Наименование, Значение.Наименование) > 0 Тогда
				Результат.Добавить(Значение);
				Прервать;
			КонецЕсли;

		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура ЗагрузитьСписокОтбора(Список, Значения)

	Список.Очистить();

	Для Каждого Значение Из Значения Цикл
		НоваяСтрока = Список.Добавить();
		НоваяСтрока.Пометка  = Ложь;
		НоваяСтрока.Значение = Значение;
	КонецЦикла;

КонецПроцедуры

