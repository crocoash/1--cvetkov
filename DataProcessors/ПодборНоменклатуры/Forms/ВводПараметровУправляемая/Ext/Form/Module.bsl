	ЗаполнитьСклады();

	Для Каждого Стр Из ТабСклады Цикл
		Стр.Отметка = (СохраненныеОтметки.Получить(Стр.Склад) <> Неопределено);
	КонецЦикла;

	ПерестроитьКолонкиОстатков(НовыйКэш());

