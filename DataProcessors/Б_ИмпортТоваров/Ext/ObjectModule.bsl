				КонецЦикла;
			Иначе
				
				НовСтрЗн 			= НовСтр.ЗначенияСвойств.Добавить();
				НовСтрЗн.Ид 		= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ЗначенияСвойств, "Ид"			, "Строка"); 
				НовСтрЗн.Значение 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ЗначенияСвойств, "Значение"	, "Строка");
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//разбираем картинки
	Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Товар, "Картинка") тогда
		
