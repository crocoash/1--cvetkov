					НовСтрЗн.Ид 		= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ТекСвойство, "Ид"			, "Строка"); 
					НовСтрЗн.Значение 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ТекСвойство, "Значение"	, "Строка");
					
				КонецЦикла;
			Иначе
				
				НовСтрЗн 			= НовСтр.ЗначенияСвойств.Добавить();
				НовСтрЗн.Ид 		= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ЗначенияСвойств, "Ид"			, "Строка"); 
				НовСтрЗн.Значение 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ЗначенияСвойств, "Значение"	, "Строка");
				
			КонецЕсли;
			
			//НовСтр.НаименованиеПоСвойству = ВернутьНаименованиеПредложенияПоСвойствам(НовСтр.ЗначенияСвойств);	
			
		КонецЕсли;
	КонецЕсли;
	
	Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Предложение, "Комплектующие") тогда
		
		Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Предложение.Комплектующие, "Комплектующее") тогда
			
			Комплектующие = Предложение.Комплектующие.Комплектующее;
			Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ЭтоСписокXDTO(Комплектующие) тогда
				
				Для каждого ТекКомплектующее из Комплектующие Цикл
					
					НовКомплектующая = НовСтр.Комплектующие.Добавить();	
					НовКомплектующая.Ид 			= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ТекКомплектующее, "Ид"			, "Строка");
					НовКомплектующая.Количество 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ТекКомплектующее, "Количество"	, "Число");

				КонецЦикла;
			Иначе
				
				НовКомплектующая = НовСтр.Комплектующие.Добавить();	
				НовКомплектующая.Ид 			= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Комплектующие, "Ид"			, "Строка");
				НовКомплектующая.Количество 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Комплектующие, "Количество"	, "Число");
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура РазборЦен(ТаблицаЦен, Предложение)
	
	НовСтр = ТаблицаЦен.Добавить();
	
	НовСтр.Цены.Колонки.Добавить("Валюта");
	НовСтр.Цены.Колонки.Добавить("ЦенаЗаЕдиницу");
	НовСтр.Цены.Колонки.Добавить("ИдТипаЦены");
	
	НовСтр.Ид	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Предложение, "Ид"			, "Строка");
	
	Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Предложение, "Цены") тогда
		Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Предложение.Цены, "Цена") тогда
			
			Цены = Предложение.Цены.Цена;
			Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ЭтоСписокXDTO(Цены) тогда
				
				Для каждого ТекЦена из Цены Цикл
					НовЦена = НовСтр.Цены.Добавить();
					НовЦена.ИдТипаЦены 		= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ТекЦена, "ИдТипаЦены"	, "Строка");
					НовЦена.ЦенаЗаЕдиницу 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ТекЦена, "ЦенаЗаЕдиницу"	, "Строка");	
					НовЦена.Валюта 			= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ТекЦена, "Валюта"		, "Строка");
					
				КонецЦикла;
				
			Иначе
				НовЦена = НовСтр.Цены.Добавить();
				НовЦена.ИдТипаЦены 		= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Цены, "ИдТипаЦены"	, "Строка");
				НовЦена.ЦенаЗаЕдиницу 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Цены, "ЦенаЗаЕдиницу", "Строка");	
				НовЦена.Валюта 			= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Цены, "Валюта"		, "Строка");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ВернутьНаименованиеПредложенияПоСвойствам(ЗначенияСвойств);	
	
	Результат = "";	
	
	КоличествоСвойств = ЗначенияСвойств.Количество();
	
	Для Инд = 0 по КоличествоСвойств - 1 Цикл
		
		Результат = Результат + ЗначенияСвойств[Инд].Значение;	
		
		Если Инд < КоличествоСвойств -2 тогда
			Результат = Результат + ", ";	
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


