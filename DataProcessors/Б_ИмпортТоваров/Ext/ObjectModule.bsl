	НовСтр.ПометкаУдаления 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Предложение, "ПометкаУдаления", "Булево");
	НовСтр.Наименование 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Предложение, "Наименование"	, "Строка");
	НовСтр.НаименованиеПоСвойству = "";
	
	Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Предложение, "ХарактеристикиТовара") тогда
		
		Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Предложение.ХарактеристикиТовара, "ХарактеристикаТовара") тогда
			
			ХарактеристикиТовара = Предложение.ХарактеристикиТовара.ХарактеристикаТовара;
			Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ЭтоСписокXDTO(ХарактеристикиТовара) тогда
				
				Для каждого ТекХарактеристика из ХарактеристикиТовара Цикл
					
					НовХарактеристика = НовСтр.Характеристики.Добавить();	
					НовХарактеристика.Ид 		= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ТекХарактеристика, "Ид"			, "Строка"); 
					НовХарактеристика.Значение 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ТекХарактеристика, "Значение"	, "Строка");
					
				КонецЦикла;
			Иначе
				
				НовХарактеристика = НовСтр.Характеристики.Добавить();	
				НовХарактеристика.Ид 		= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ХарактеристикиТовара, "Ид"			, "Строка"); 
				НовХарактеристика.Значение 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ХарактеристикиТовара, "Значение"	, "Строка");
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Предложение, "ЗначенияСвойств") тогда
		Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Предложение.ЗначенияСвойств, "ЗначенияСвойства") тогда
			ЗначенияСвойств = Предложение.ЗначенияСвойств.ЗначенияСвойства;
			Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ЭтоСписокXDTO(ЗначенияСвойств) тогда
				Для каждого ТекСвойство из ЗначенияСвойств Цикл 
					
