	НовСтр.Внешний 			= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Свойство, "Внешний"			, "Булево"); 								
	
	НовСтр.ДляПредложений 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Свойство, "ДляПредложений"	, "Булево"); 								
	НовСтр.ДляТоваров 		= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Свойство, "ДляТоваров"		, "Булево"); 								
	
	Попытка
		
		Если НовСтр.ТипЗначений = "Справочник" тогда
			
			тзнВариантовЗначений = новый ТаблицаЗначений;
			тзнВариантовЗначений.Колонки.Добавить("Значение");
			тзнВариантовЗначений.Колонки.Добавить("ИдЗначения");
			тзнВариантовЗначений.Колонки.Добавить("Ссылка");
			
			СправочныеДанные = Свойство.ВариантыЗначений.Справочник;
			Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ЭтоСписокXDTO(СправочныеДанные) тогда

				Для каждого ТекЗначениеСвойства из СправочныеДанные Цикл
					
					НовВариантЗначения 	= тзнВариантовЗначений.Добавить();
					НовВариантЗначения.ИдЗначения 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ТекЗначениеСвойства, "ИдЗначения"		, "Строка"); 								
					НовВариантЗначения.Значение 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ТекЗначениеСвойства, "Значение"		, "Строка"); 
					
				КонецЦикла;
			Иначе
				
				НовВариантЗначения 	= тзнВариантовЗначений.Добавить();
				НовВариантЗначения.ИдЗначения 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(СправочныеДанные, "ИдЗначения"		, "Строка"); 								
				НовВариантЗначения.Значение 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(СправочныеДанные, "Значение"		, "Строка"); 								
				
			КонецЕсли;
				
			НовСтр.ВариантыЗначений = тзнВариантовЗначений;
			
		КонецЕсли;
		
	Исключение
		
		ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + "Для свойства " + Свойство.Наименование + " , который является справочным, не выгружено ни одного значения.";
		
	КонецПопытки;

	
