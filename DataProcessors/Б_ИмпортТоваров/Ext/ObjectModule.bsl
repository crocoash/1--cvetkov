Процедура РазборПредложений(ТаблицаПредложений, Предложение)

	НовСтр = ТаблицаПредложений.Добавить();

	НовСтр.Характеристики.Колонки.Добавить("Ид");
	НовСтр.Характеристики.Колонки.Добавить("Значение");	
	
	НовСтр.Комплектующие.Колонки.Добавить("Ид");
	НовСтр.Комплектующие.Колонки.Добавить("Количество");	
	НовСтр.Комплектующие.Колонки.Добавить("ИдНоменклатуры"	);
	НовСтр.Комплектующие.Колонки.Добавить("ИдХарактеристики");
	
	НовСтр.ЗначенияСвойств.Колонки.Добавить("Ид");
	НовСтр.ЗначенияСвойств.Колонки.Добавить("Значение");
	
