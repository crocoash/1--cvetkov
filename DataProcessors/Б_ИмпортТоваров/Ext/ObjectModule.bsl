Процедура РазборГрупп(ТаблицаГрупп, Группа, Родитель)

	НовСтр = ТаблицаГрупп.Добавить();
	НовСтр.Родитель 		= "G_" + Родитель;									
	НовСтр.Ид 				= "G_" + Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Группа, "Ид"		, "Строка"); 									
	НовСтр.НомерВерсии 		= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Группа, "НомерВерсии"		, "Строка"); 								
	НовСтр.ПометкаУдаления 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Группа, "ПометкаУдаления"	, "Булево"); 								
	НовСтр.Наименование 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Группа, "Наименование"	, "Строка"); 									
	
	тзнПривязанныеСвойства = Новый ТаблицаЗначений;
	тзнПривязанныеСвойства.Колонки.Добавить("Ид");	
	
	Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Группа, "Свойства") тогда
		
		Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Группа.Свойства, "Свойство") тогда
			
			Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ЭтоСписокXDTO(Группа.Свойства.Свойство) тогда
				
				Для каждого ТекСвойство из  Группа.Свойства.Свойство цикл
					
					НовСтрока = тзнПривязанныеСвойства.Добавить();
					НовСтрока.Ид = ТекСвойство.Ид;
					
				КонецЦикла;
				
			Иначе
				
				НовСтрока = тзнПривязанныеСвойства.Добавить();
				НовСтрока.Ид = Группа.Свойства.Свойство.Ид;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	НовСтр.ПривязанныеСвойства = тзнПривязанныеСвойства;
		
	
	Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Группа, "Группы") тогда
		
		Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Группа.Группы, "Группа") тогда
		
		
			Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ЭтоСписокXDTO(Группа.Группы.Группа) тогда
				
				Для каждого ТекГруппа из  Группа.Группы.Группа цикл
					РазборГрупп(ТаблицаГрупп, ТекГруппа, Группа.Ид);	
				КонецЦикла;
				
			Иначе
				РазборГрупп(ТаблицаГрупп, Группа.Группы.Группа, Группа.Ид);	
			КонецЕсли;
		КонецЕсли;  		
	КонецЕсли;
 
