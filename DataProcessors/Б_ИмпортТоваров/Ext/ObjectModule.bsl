			Для каждого ТекГруппа из Группы Цикл 
				НовСтр.Группы.Добавить("G_" + ТекГруппа);
			КонецЦикла;
		Иначе
			НовСтр.Группы.Добавить("G_" + Группы);
		КонецЕсли;
		
	КонецЕсли;
	
	//разбираем изготовителя товара
	СтруктураИзготовителя = Новый Структура;
	СтруктураИзготовителя.Вставить("Ид"						, "");
	СтруктураИзготовителя.Вставить("Наименование"			, "");
	СтруктураИзготовителя.Вставить("ОфициальноеНаименование", "");
	
	Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Товар, "Изготовитель") тогда
		
		ХДТОИзготовитель 		= Товар.Изготовитель;
		
		СтруктураИзготовителя.Ид 						= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ХДТОИзготовитель, "Ид"						, "Строка"); 									
		СтруктураИзготовителя.Наименование 				= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ХДТОИзготовитель, "Наименование"				, "Строка"); 
		СтруктураИзготовителя.ОфициальноеНаименование 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(ХДТОИзготовитель, "ОфициальноеНаименование"	, "Строка"); 								
		
	КонецЕсли;
	
	НовСтр.Изготовитель = СтруктураИзготовителя;		

	//разбираем свойства
	Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Товар, "ЗначенияСвойств") тогда
		Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Товар.ЗначенияСвойств, "ЗначенияСвойства") тогда
