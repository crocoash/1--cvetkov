									РазборТоваров(ТаблицаТоваров, ТекТовар);
								КонецЦикла;
								
							Иначе
								РазборТоваров(ТаблицаТоваров, Товар);
							КонецЕсли;
							
						КонецЕсли;
					КонецЕсли;
							
				Исключение
					
					СообщитьПодробно(Протокол, "Во время разбора товаров, возникла ошибка. Некорректны данные XML. " + ОписаниеОшибки());
					
				КонецПопытки;
				
			ИначеЕсли ИмяСвойстваКИ = "ПакетПредложений" тогда
				
				Попытка 
					Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(ТекОбъектКИ, "Предложения") тогда
						Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(ТекОбъектКИ.Предложения, "Предложение") тогда
						
							Предложение = ТекОбъектКИ.Предложения.Предложение;
							Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ЭтоСписокXDTO(Предложение) тогда
								
								Для каждого ТекПредложение из Предложение Цикл 
									Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(ТекПредложение, "Цены") тогда
										РазборЦен(ТаблицаЦен, ТекПредложение);
									КонецЕсли;	
									
									РазборПредложений(ТаблицаПредложений, ТекПредложение);
									
								КонецЦикла;
							Иначе
								Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(ТекПредложение, "Цены") тогда
									РазборЦен(ТаблицаЦен, Предложение);
								Иначе
									РазборПредложений(ТаблицаПредложений, Предложение);
								КонецЕсли;									
							КонецЕсли;
							
						КонецЕсли;
					КонецЕсли;
					
				Исключение
					
					СообщитьПодробно(Протокол, "Во время разбора предложений и цен, возникла ошибка. Некорректны данные XML. " + ОписаниеОшибки());
					
				КонецПопытки;
				
			КонецЕсли;  
			
		КонецЦикла;
		
		ОбъектXML.Закрыть();
		
	Возврат Истина;
	
