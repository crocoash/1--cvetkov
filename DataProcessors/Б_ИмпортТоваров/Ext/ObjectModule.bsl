	НовСтр.ПометкаУдаления 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Товар, "ПометкаУдаления"	, "Булево"); 								
														  
	НовСтр.Артикул 			= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Товар, "Артикул"			, "Строка");     
	НовСтр.Наименование		= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Товар, "Наименование"		, "Строка");	
	НовСтр.Описание 		= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Товар, "Описание"			, "Строка");		
	НовСтр.БазоваяЕдиница	= СокрЛП(Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьЗначениеПоСвойству(Товар, "БазоваяЕдиница"	, "Строка"));	
	
	//разбираем группы товара
	Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Товар, "Группы") тогда
		
		Группы = Товар.Группы.Ид;
