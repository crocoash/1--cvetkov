			КонецЦикла;
		Иначе
			НовСтр.Картинки.Добавить(?(Б_ОбщиеПроцедурыИФункцииОбменаССайтом.СвойствоXDTOЗаполнено(Картинка), Картинка, "")); 	
			
		КонецЕсли;
	КонецЕсли;
	
	//разбираем ндс
	Если Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ОбъектXDTOСодержитСвойство(Товар, "СтавкиНалогов") тогда
