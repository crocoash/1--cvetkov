	// Заказы аккаунта с ручными ценами разбираются иначе: цена позиции из файла -
	// истина, прайс 1С её не заменяет. Для всех остальных заказов поведение
	// прежнее - цена берётся из ценообразования 1С.
	ЗаказРучногоРежима = ЭтоЗаказРучногоРежима(СтруктураШапки, Контрагент);

	// Строки с ручной ценой: их нужно провести через сумму строки уже после
	// расчёта автоматических скидок.
	СтрокиСРучнойЦеной = Новый Массив;

	Для Каждого СтруктураСтроки Из МассивСтрок Цикл

		Характеристика = Неопределено;
		Количество     = 0;
		Цена           = 0;
		
		// Идентификатор позиции: артикул товара, а для ростовок и наборов, где
		// артикула нет, - идентификатор набора.
		ИдентификаторПозиции = "";

		Если СтруктураСтроки.Свойство("external_id") И
			 Не ПустаяСтрока(СтруктураСтроки.external_id) Тогда

			ИдентификаторПозиции = СокрЛП(СтруктураСтроки.external_id);

		ИначеЕсли СтруктураСтроки.Свойство("set_goodid") И
				  Не ПустаяСтрока(СтруктураСтроки.set_goodid) Тогда

			ИдентификаторПозиции = СокрЛП(СтруктураСтроки.set_goodid);

		КонецЕсли;

		Характеристика = НайтиХарактеристикуПоИдентификаторуССайта(ИдентификаторПозиции);

		Если Не ЗначениеЗаполнено(Характеристика) Тогда

			// Раньше строка без опознанного артикула пропускалась молча, и заказ
			// приземлялся неполным без единого следа. Теперь это видно и в заказе,
			// и в журнале регистрации.
			НазваниеПозиции = "";
			Если СтруктураСтроки.Свойство("name") Тогда
				НазваниеПозиции = СокрЛП(СтруктураСтроки.name);
			ИначеЕсли СтруктураСтроки.Свойство("set_name") Тогда
				НазваниеПозиции = СокрЛП(СтруктураСтроки.set_name);
			КонецЕсли;

			ТекстПропуска = "не найдена хар-ка "
				+ ?(ПустаяСтрока(ИдентификаторПозиции), "(нет идентификатора)", ИдентификаторПозиции)
				+ ?(ПустаяСтрока(НазваниеПозиции), "", " """ + НазваниеПозиции + """");

			Сообщить(ТекстПропуска);
			НовыйЗаказ.Комментарий = НовыйЗаказ.Комментарий + ТекстПропуска + " ";

			ЗаписьЖурналаРегистрации(
				"ЗагрузкаЗаказовССайта",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				"Заказ с сайта " + Строка(ID) + ": строка не загружена - " + ТекстПропуска);

			Продолжить;

		КонецЕсли;

		Если СтруктураСтроки.Свойство("quantity") И
			 Не ПустаяСтрока(СтруктураСтроки.quantity) Тогда
			
			Попытка
				Количество = Число(СокрЛП(СтруктураСтроки.quantity));
			Исключение
				
			КонецПопытки;
			
		КонецЕсли;
		
		ЦенаИзФайла = ЧислоИзТегаЗаказа(СтруктураСтроки, "price");

		Если ЦенаИзФайла <> Неопределено Тогда
			Цена = ЦенаИзФайла;
		КонецЕсли;

		// Ручная цена: менеджер задал цену позиции сам. В строку она уходит не
		// вместо цены, а через сумму строки - так же, как если бы менеджер правил
		// колонку "Сумма" в форме заказа. Цена остаётся прайсовой, а разницу 1С
		// сама раскладывает в процент скидки (сумма меньше) или наценки (больше).
		//
		// В заказе аккаунта с ручными ценами это касается каждой позиции: сайт
		// пишет в price окончательную цену за единицу независимо от того, правил
		// её менеджер или она пришла из карточки товара.
		ЦенаРучная = ЗаказРучногоРежима И (Цена > 0);

		Если Не ЦенаРучная И СтруктураСтроки.Свойство("price_manual") Тогда
			ЦенаРучная = (СокрЛП(Строка(СтруктураСтроки.price_manual)) = "1") И (Цена > 0);
		КонецЕсли;

		Если ЗначениеЗаполнено(Характеристика) И
			 //ЗначениеЗаполнено(Количество) И
			 //ЗначениеЗаполнено(Цена) Тогда
			 ЗначениеЗаполнено(Количество) Тогда
			
			НоваяСтрока = НовыйЗаказ.Товары.Добавить();
			
			
			
			
			
			НоваяСтрока.Номенклатура               = Характеристика.Владелец;
			НоваяСтрока.ХарактеристикаНоменклатуры = Характеристика;
			НоваяСтрока.Сортировка                 = НоваяСтрока.Номенклатура.Наименование + " " + НоваяСтрока.ХарактеристикаНоменклатуры.Наименование;
			НоваяСтрока.ЕдиницаИзмерения           = НоваяСтрока.Номенклатура.ЕдиницаХраненияОстатков;
			НоваяСтрока.Коэффициент                = НоваяСтрока.ЕдиницаИзмерения.Коэффициент;
			НоваяСтрока.СтавкаНДС                  = НоваяСтрока.Номенклатура.СтавкаНДС;
			НоваяСтрока.Количество                 = Количество;
			
			ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
			
			Если НоваяСтрока.Номенклатура.ВидНоменклатуры.Код = "000000009" Тогда
				
				
				Характеристика = ХарактеристикаОбъект.Комплектующие_НК()[0].ХарактеристикаКомплектующей;
				ДатаИзготовления = Характеристика.ПолучитьОбъект().ПолучитьДатуИзготовления(Истина);
				
				Если ЗначениеЗаполнено(ДатаИзготовления) Тогда
					НоваяСтрока.СрокИзготовления      = ДатаИзготовления.ДатаПошиваНачало;
					НоваяСтрока.СрокИзготовленияКонец = ДатаИзготовления.ДатаПошиваКонец;	
				КонецЕсли;

				
				
				КоличествоКомплектующих = БИАС.ПолучитьКоличествоКомплектующихНК(НоваяСтрока.ХарактеристикаНоменклатуры);
				
				НоваяСтрока.КоличествоНК = КоличествоКомплектующих * НоваяСтрока.Количество;
				//НоваяСтрока.Цена         = ?(КоличествоКомплектующих = 0, Цена, Цена / КоличествоКомплектующих);
				
				ЦенаНК = 0;
				
				КомплектующиеНК = Новый ТаблицаЗначений;
				
				КомплектующиеНК.Колонки.Добавить("Комплектующая");
				КомплектующиеНК.Колонки.Добавить("ХарактеристикаКомплектующей");
				
				БИАС.ПолучитьКомплектующиеНК(НоваяСтрока.ХарактеристикаНоменклатуры, КомплектующиеНК);
				
				Для Каждого СтрокаТЗ Из КомплектующиеНК Цикл
					
					ЦенаНК = ЦенаНК + Ценообразование.ПолучитьЦенуНоменклатуры(СтрокаТЗ.Комплектующая, СтрокаТЗ.ХарактеристикаКомплектующей, НовыйЗаказ.ТипЦен, НовыйЗаказ.Дата);
					
				КонецЦикла;
				
				ЦенаНК = ?(КоличествоКомплектующих = 0, 0, ЦенаНК / КоличествоКомплектующих);
				
				Если ЦенаНК = 0 Тогда

					ЦенаНК = Цена;

				КонецЕсли;

				НоваяСтрока.Цена = ЦенаНК;

			Иначе
								
				
				ДатаИзготовления = ХарактеристикаОбъект.ПолучитьДатуИзготовления(Истина);

				Если ЗначениеЗаполнено(ДатаИзготовления) Тогда
					НоваяСтрока.СрокИзготовления      = ДатаИзготовления.ДатаПошиваНачало;
					НоваяСтрока.СрокИзготовленияКонец = ДатаИзготовления.ДатаПошиваКонец;	
				КонецЕсли;
				
				
				НоваяСтрока.КоличествоНК = НоваяСтрока.Количество;
				//НоваяСтрока.Цена         = Цена;

				Цена1С = Ценообразование.ПолучитьЦенуНоменклатуры(
																  НоваяСтрока.Номенклатура,
																  НоваяСтрока.ХарактеристикаНоменклатуры,
																  НовыйЗаказ.ТипЦен,
																  НовыйЗаказ.Дата,
																  НоваяСтрока.ЕдиницаИзмерения,
																  НовыйЗаказ.ВалютаДокумента,
																  НовыйЗаказ.КурсВзаиморасчетов,
																  НовыйЗаказ.КратностьВзаиморасчетов,
																  ,
																  НовыйЗаказ.ДоговорКонтрагента,
																  НовыйЗаказ.УсловиеПродаж);

				Если Цена1С = 0 Тогда

					Цена1С = Цена;

				КонецЕсли;

				НоваяСтрока.Цена = Цена1С;

				// Ростовки и наборы (ветка выше) ручной цены не имеют - сайт по ним
				// всегда отдаёт обычную цену, собранную из комплектующих.
				Если ЦенаРучная Тогда
					СтрокиСРучнойЦеной.Добавить(Новый Структура("Строка, Цена", НоваяСтрока, Цена));
				КонецЕсли;

			КонецЕсли;

			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, НовыйЗаказ);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйЗаказ);

		КонецЕсли;

	КонецЦикла;

	НовыйЗаказ.ПересчитатьАвтоматическиеСкидки();

	// Ручную цену менеджера заводим через сумму строки - тем же обработчиком, что
	// отрабатывает при ручной правке колонки "Сумма" в форме заказа. Цена остаётся
	// прайсовой, а ПроцентСкидкиНаценки 1С выводит сама: положительный, если
	// менеджер продал дешевле прайса, отрицательный (наценка), если дороже.
	// Идём после ПересчитатьАвтоматическиеСкидки: обработчик вычитает уже
	// проставленный ПроцентАвтоматическихСкидок, поэтому итоговая сумма строки
	// получается ровно та, что пришла с сайта.
	Для Каждого РучнаяЦена Из СтрокиСРучнойЦеной Цикл

		СтрокаТовара = РучнаяЦена.Строка;

		СуммаСтроки = РучнаяЦена.Цена * СтрокаТовара.Количество;

		// Разрядность ПроцентСкидкиНаценки - 5 знаков (максимум +-999,99). Если
		// прайсовая цена отличается от ручной больше чем на порядок, процент в
		// реквизит не влезет - тогда откатываемся на прямую запись цены.
		Попытка

			СтрокаТовара.Сумма = СуммаСтроки;

			ОбработкаТабличныхЧастей.ПриИзмененииСуммыТабЧасти(
				СтрокаТовара, НовыйЗаказ, Неопределено, Ложь, Истина, Истина, Истина, "Товары");

		Исключение

			СтрокаТовара.Цена                        = РучнаяЦена.Цена;
			СтрокаТовара.ПроцентАвтоматическихСкидок = 0;
			СтрокаТовара.ПроцентСкидкиНаценки        = 0;

			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТовара, НовыйЗаказ);

		КонецПопытки;

		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТовара, НовыйЗаказ);

	КонецЦикла;

	// Сумма заказа на сайте и сумма приземлившихся строк должны совпадать.
	// Расхождение означает, что позиция не опознана или цена взята из прайса 1С
	// вместо цены сайта - менеджеру это надо видеть, а не искать потом руками.
	СуммаССайта = ЧислоИзТегаЗаказа(СтруктураШапки, "price");

	Если СуммаССайта <> Неопределено И СуммаССайта > 0 Тогда

		СуммаПозиций = НовыйЗаказ.Товары.Итог("Сумма");

			Если Макс(СуммаССайта - СуммаПозиций, СуммаПозиций - СуммаССайта) > 0.01 Тогда

			ТекстРасхождения = "сумма на сайте " + Формат(СуммаССайта, "ЧДЦ=2; ЧН=0; ЧГ=")
				+ ", в 1С " + Формат(СуммаПозиций, "ЧДЦ=2; ЧН=0; ЧГ=");

			НовыйЗаказ.Комментарий = НовыйЗаказ.Комментарий + " (" + ТекстРасхождения + ")";

			ЗаписьЖурналаРегистрации(
				"ЗагрузкаЗаказовССайта",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				"Заказ с сайта " + Строка(ID) + ": " + ТекстРасхождения);

		КонецЕсли;

	КонецЕсли;

	Попытка
		НовыйЗаказ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		НовыйЗаказ.Записать();
	КонецПопытки;
	




	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры
