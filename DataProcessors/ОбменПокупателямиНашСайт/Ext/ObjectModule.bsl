
Перем Группы;

Процедура ВыполнитьЗагрузкуМоя(пПутьКФайлу) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	
	ТипКИEMail = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	ТипКИPhone = Перечисления.ТипыКонтактнойИнформации.Телефон;
	
	ВидКИEMail = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000042");
	ВидКИPhone = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000005");
	ВидКИFax   = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000027");
	ВидКИFax1  = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000017");
	
	Текст = Новый ТекстовыйДокумент;
	
	Текст.Прочитать(пПутьКФайлу);
	
	Строка = Текст.ПолучитьСтроку(1);
	
	Для НомерСтроки = 1 По Текст.КоличествоСтрок() Цикл
		
		Строка = Текст.ПолучитьСтроку(НомерСтроки);
		
		МассивСтрок = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(Строка,";");
		
		ТелефонКонтрагента = МассивСтрок[1];
		Наименование = МассивСтрок[2];
				
		Контрагент = БИАС.НайтиКонтрагентаПоНомеруТелефона(ТелефонКонтрагента);
				
		Если Не ЗначениеЗаполнено(Контрагент) Тогда
						
			НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
			
						
			НовыйКонтрагент.Родитель                  = Справочники.Контрагенты.НайтиПоКоду("000012886");
			НовыйКонтрагент.Наименование              = Наименование;
			НовыйКонтрагент.НаименованиеПолное        = Наименование;
			НовыйКонтрагент.Покупатель                = Истина;
			НовыйКонтрагент.ГруппаДоступаККонтрагенту = Справочники.ГруппыДоступаККонтрагентам.НайтиПоКоду("000000007");
				
			НовыйКонтрагент.Записать();
			
			НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			
			НовыйДоговор.Владелец                                     = НовыйКонтрагент.Ссылка;
			НовыйДоговор.Наименование                                 = "Основной договор";
			НовыйДоговор.Организация                                  = Справочники.Организации.НайтиПоКоду("000000001");
			НовыйДоговор.ВидДоговора                                  = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
			НовыйДоговор.ВалютаВзаиморасчетов                         = Константы.ВалютаУправленческогоУчета.Получить();
			НовыйДоговор.ВедениеВзаиморасчетов                        = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом;
			НовыйДоговор.ВидУсловийДоговора                           = Перечисления.ВидыУсловийДоговоровВзаиморасчетов.БезДополнительныхУсловий;
			НовыйДоговор.ВыводитьИнформациюОСделкеПриПечатиДокументов = Истина;
			НовыйДоговор.СхемаНалоговогоУчета                         = Справочники.СхемыНалоговогоУчетаПоДоговорамКонтрагентов.ПоПервомуСобытию;
			НовыйДоговор.СхемаНалоговогоУчетаПоТаре                   = НовыйДоговор.СхемаНалоговогоУчета;
			НовыйДоговор.Записать();
			НовыйКонтрагент.Комментарий = МассивСтрок[0]; 
			НовыйКонтрагент.ОсновнойДоговорКонтрагента = НовыйДоговор.Ссылка;			
			НовыйКонтрагент.Записать();
			Контрагент = НовыйКонтрагент.Ссылка;
			
			
			Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
						
			Запись.Объект        = Контрагент;
			Запись.Тип           = Перечисления.ТипыКонтактнойИнформации.Телефон;
			Запись.Вид           = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000005");
			Запись.Представление = ТелефонКонтрагента;
			Запись.Поле3         = ТелефонКонтрагента;
			
			Запись.Записать();

			
		Иначе 
			Сообщить(Контрагент.Наименование + " " + ТелефонКонтрагента);
		КонецЕсли;				
						
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ВыполнитьЗагрузку(пПутьКФайлу) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		РодительПоУмолчанию = Справочники.Контрагенты.НайтиПоКоду("000004795");
		ГруппаДоступа       = Справочники.ГруппыДоступаККонтрагентам.НайтиПоКоду("000000006");
		
		ТипКИEMail = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		ТипКИPhone = Перечисления.ТипыКонтактнойИнформации.Телефон;
		
		ВидКИEMail = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000042");
		ВидКИPhone = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000005");
		ВидКИFax   = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000027");
		ВидКИFax1  = Справочники.ВидыКонтактнойИнформации.НайтиПоКоду("000000017");
		
		Текст = Новый ТекстовыйДокумент;
		Текст.Прочитать(пПутьКФайлу);
		
		Если Текст.КоличествоСтрок() < 2 Тогда
			УстановитьПривилегированныйРежим(Ложь);
			Возврат;
		КонецЕсли;
		
		СтрокаЗаголовка = Текст.ПолучитьСтроку(1);
		
		ИменаПолей = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(
			СтрокаЗаголовка
		);
		
		ИндексID            = ИменаПолей.Найти("ID");
		ИндексName          = ИменаПолей.Найти("Name");
		ИндексEMail         = ИменаПолей.Найти("EMail");
		ИндексMainPhone     = ИменаПолей.Найти("MainPhone");
		ИндексPhone         = ИменаПолей.Найти("Phone");
		ИндексFax           = ИменаПолей.Найти("Fax");
		ИндексFax1          = ИменаПолей.Найти("Fax1");
		ИндексGroupID       = ИменаПолей.Найти("GroupID");
		ИндексCountryID     = ИменаПолей.Найти("CountryID");
		ИндексRegionID      = ИменаПолей.Найти("RegionID");
		ИндексLocalityID    = ИменаПолей.Найти("LocalityID");
		
		ИндексContact1ID    = ИменаПолей.Найти("Contact1ID");
		ИндексContact1Name  = ИменаПолей.Найти("Contact1Name");
		ИндексContact1Phone = ИменаПолей.Найти("Contact1Phone");
		
		ИндексContact2ID    = ИменаПолей.Найти("Contact2ID");
		ИндексContact2Name  = ИменаПолей.Найти("Contact2Name");
		ИндексContact2Phone = ИменаПолей.Найти("Contact2Phone");
		
		ИндексContact3ID    = ИменаПолей.Найти("Contact3ID");
		ИндексContact3Name  = ИменаПолей.Найти("Contact3Name");
		ИндексContact3Phone = ИменаПолей.Найти("Contact3Phone");
		
		ИндексNP1Dep        = ИменаПолей.Найти("NP1Dep");
		ИндексNP1City       = ИменаПолей.Найти("NP1City");
		ИндексNP2Dep        = ИменаПолей.Найти("NP2Dep");
		ИндексNP2City       = ИменаПолей.Найти("NP2City");
		ИндексNP3Dep        = ИменаПолей.Найти("NP3Dep");
		ИндексNP3City       = ИменаПолей.Найти("NP3City");
		ИндексNP4Dep        = ИменаПолей.Найти("NP4Dep");
		ИндексNP4City       = ИменаПолей.Найти("NP4City");
		ИндексNP5Dep        = ИменаПолей.Найти("NP5Dep");
		ИндексNP5City       = ИменаПолей.Найти("NP5City");
		
		ИндексLastVisit     = ИменаПолей.Найти("LastVisit");
		ИндексSiteID        = ИменаПолей.Найти("SiteId");
		ИндексTgBot         = ИменаПолей.Найти("TgBot");
		
		Для НомерСтроки = 2 По Текст.КоличествоСтрок() Цикл
			
			СтрокаФайла = Текст.ПолучитьСтроку(НомерСтроки);
			
			Если ПустаяСтрока(СокрЛП(СтрокаФайла)) Тогда
				Продолжить;
			КонецЕсли;
			
			МассивСтрок = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(
				СтрокаФайла
			);
			
			Если МассивСтрок.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Код          = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексID);
			Наименование = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексName);
			IDСайта      = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексSiteID);
			TgBot        = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексTgBot);
			
			ДатаПоследнегоВизитаНаСайте = ПолучитьЗначениеПоляЗагрузки(
				МассивСтрок,
				ИндексLastVisit
			);
			
			CountryID  = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексCountryID);
			RegionID   = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексRegionID);
			LocalityID = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексLocalityID);
			
			EMail     = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексEMail);
			MainPhone = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексMainPhone);
			Phone     = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексPhone);
			Fax       = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексFax);
			Fax1      = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексFax1);
			
			NP1City = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексNP1City);
			NP1Dep  = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексNP1Dep);
			NP2City = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексNP2City);
			NP2Dep  = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексNP2Dep);
			NP3City = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексNP3City);
			NP3Dep  = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексNP3Dep);
			NP4City = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексNP4City);
			NP4Dep  = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексNP4Dep);
			NP5City = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексNP5City);
			NP5Dep  = ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексNP5Dep);
			
			Contact1ID = ПолучитьЗначениеПоляЗагрузки(
				МассивСтрок,
				ИндексContact1ID
			);
			
			Contact1Name = ПолучитьЗначениеПоляЗагрузки(
				МассивСтрок,
				ИндексContact1Name
			);
			
			Contact1Phone = ПолучитьЗначениеПоляЗагрузки(
				МассивСтрок,
				ИндексContact1Phone
			);
			
			Contact2ID = ПолучитьЗначениеПоляЗагрузки(
				МассивСтрок,
				ИндексContact2ID
			);
			
			Contact2Name = ПолучитьЗначениеПоляЗагрузки(
				МассивСтрок,
				ИндексContact2Name
			);
			
			Contact2Phone = ПолучитьЗначениеПоляЗагрузки(
				МассивСтрок,
				ИндексContact2Phone
			);
			
			Contact3ID = ПолучитьЗначениеПоляЗагрузки(
				МассивСтрок,
				ИндексContact3ID
			);
			
			Contact3Name = ПолучитьЗначениеПоляЗагрузки(
				МассивСтрок,
				ИндексContact3Name
			);
			
			Contact3Phone = ПолучитьЗначениеПоляЗагрузки(
				МассивСтрок,
				ИндексContact3Phone
			);
			
			// Удаляем кавычки в начале и конце наименования.
			Наименование = УдалитьКавычкиИзЗначения(Наименование);
			
			// ID сайта пытаемся привести к числу.
			Если Не ПустаяСтрока(IDСайта) Тогда
				
				Попытка
					IDСайта = Число(IDСайта);
				Исключение
					IDСайта = Неопределено;
				КонецПопытки;
				
			Иначе
				
				IDСайта = Неопределено;
				
			КонецЕсли;
			
			Контрагент = Справочники.Контрагенты.ПустаяСсылка();
			
			// Поиск по коду.
			Если Не ПустаяСтрока(Код) Тогда
				
				КодКонтрагента = ОбщегоНазначения.ДополнитьНомерНулями(
					Код,
					9
				);
				
				Контрагент = Справочники.Контрагенты.НайтиПоКоду(
					КодКонтрагента
				);
				
			КонецЕсли;
			
			// Поиск по ID сайта.
			Если Не ЗначениеЗаполнено(Контрагент)
				И ТипЗнч(IDСайта) = Тип("Число") Тогда
				
				Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту(
					"IDСайта",
					IDСайта
				);
				
			КонецЕсли;
			
			// Поиск по основному телефону.
			Если Не ЗначениеЗаполнено(Контрагент)
				И Не ПустаяСтрока(Phone) Тогда
				
				Контрагент = БИАС.НайтиКонтрагентаПоНомеруТелефона(
					Phone
				);
				
			КонецЕсли;
			
			// Поиск по Fax.
			Если Не ЗначениеЗаполнено(Контрагент)
				И Не ПустаяСтрока(Fax) Тогда
				
				Контрагент = БИАС.НайтиКонтрагентаПоНомеруТелефона(
					Fax
				);
				
			КонецЕсли;
			
			// Поиск по Fax1.
			Если Не ЗначениеЗаполнено(Контрагент)
				И Не ПустаяСтрока(Fax1) Тогда
				
				Контрагент = БИАС.НайтиКонтрагентаПоНомеруТелефона(
					Fax1
				);
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Контрагент) Тогда
				
				///////////////////////////////////////////////////////////////
				// СОЗДАНИЕ НОВОГО КОНТРАГЕНТА
				///////////////////////////////////////////////////////////////
				
				Если ПустаяСтрока(Наименование) Тогда
					Продолжить;
				КонецЕсли;
				
				НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
				
				GroupID = ПолучитьЗначениеПоляЗагрузки(
					МассивСтрок,
					ИндексGroupID
				);
				
				Родитель = Справочники.Контрагенты.НайтиПоКоду(GroupID);
				
				Если Не ЗначениеЗаполнено(Родитель) Тогда
					Родитель = РодительПоУмолчанию;
				КонецЕсли;
				
				НовыйКонтрагент.Родитель                  = Родитель;
				НовыйКонтрагент.Наименование              = Наименование;
				НовыйКонтрагент.НаименованиеПолное        = Наименование;
				НовыйКонтрагент.Покупатель                = Истина;
				НовыйКонтрагент.ГруппаДоступаККонтрагенту = ГруппаДоступа;
				
				Если ТипЗнч(IDСайта) = Тип("Число") Тогда
					НовыйКонтрагент.IDСайта = IDСайта;
				КонецЕсли;
				
				// Telegram ID или другая информация из TgBot.
				НовыйКонтрагент.РассылкаТГ = TgBot;
				
				// Дата последнего посещения сайта.
				ДатаПоследнегоВизита = ПолучитьДатуПоследнегоВизита(
					ДатаПоследнегоВизитаНаСайте
				);
				
				Если ЗначениеЗаполнено(ДатаПоследнегоВизита) Тогда
					
					НовыйКонтрагент.ДатаПоследнегоВизитаНаСайте =
						ДатаПоследнегоВизита;
					
				КонецЕсли;
				
				// Регион.
				Регион = ПолучитьРегионПоКодамСайта(
					CountryID,
					RegionID,
					LocalityID
				);
				
				Если ЗначениеЗаполнено(Регион) Тогда
					НовыйКонтрагент.Регион = Регион;
				КонецЕсли;
				
				Если Не ПустаяСтрока(MainPhone) Тогда
					НовыйКонтрагент.ОсновнойКонтакт = MainPhone;
				КонецЕсли;
				
				ЗаполнитьТЧНоваяПочта(
					NP1City,
					NP1Dep,
					НовыйКонтрагент
				);
				
				ЗаполнитьТЧНоваяПочта(
					NP2City,
					NP2Dep,
					НовыйКонтрагент
				);
				
				ЗаполнитьТЧНоваяПочта(
					NP3City,
					NP3Dep,
					НовыйКонтрагент
				);
				
				ЗаполнитьТЧНоваяПочта(
					NP4City,
					NP4Dep,
					НовыйКонтрагент
				);
				
				ЗаполнитьТЧНоваяПочта(
					NP5City,
					NP5Dep,
					НовыйКонтрагент
				);
				
				НовыйКонтрагент.Записать();
				
				// Создание основного договора.
				НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
				
				НовыйДоговор.Владелец =
					НовыйКонтрагент.Ссылка;
				
				НовыйДоговор.Наименование =
					"Основной договор";
				
				НовыйДоговор.Организация =
					Справочники.Организации.НайтиПоКоду("000000001");
				
				НовыйДоговор.ВидДоговора =
					Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
				
				НовыйДоговор.ВалютаВзаиморасчетов =
					Константы.ВалютаУправленческогоУчета.Получить();
				
				НовыйДоговор.ВедениеВзаиморасчетов =
					Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом;
				
				НовыйДоговор.ВидУсловийДоговора =
					Перечисления.ВидыУсловийДоговоровВзаиморасчетов.БезДополнительныхУсловий;
				
				НовыйДоговор.ВыводитьИнформациюОСделкеПриПечатиДокументов =
					Истина;
				
				НовыйДоговор.СхемаНалоговогоУчета =
					Справочники.СхемыНалоговогоУчетаПоДоговорамКонтрагентов.ПоПервомуСобытию;
				
				НовыйДоговор.СхемаНалоговогоУчетаПоТаре =
					НовыйДоговор.СхемаНалоговогоУчета;
				
				НовыйДоговор.Записать();
				
				НовыйКонтрагент.ОсновнойДоговорКонтрагента =
					НовыйДоговор.Ссылка;
				
				НовыйКонтрагент.Записать();
				
				Контрагент = НовыйКонтрагент.Ссылка;
				
				// Контактная информация.
				ЗаписатьКонтактнуюИнформацию(
					Контрагент,
					ТипКИEMail,
					ВидКИEMail,
					EMail,
					Ложь
				);
				
				ЗаписатьКонтактнуюИнформацию(
					Контрагент,
					ТипКИPhone,
					ВидКИPhone,
					Phone,
					Истина
				);
				
				ЗаписатьКонтактнуюИнформацию(
					Контрагент,
					ТипКИPhone,
					ВидКИFax,
					Fax,
					Истина
				);
				
				ЗаписатьКонтактнуюИнформацию(
					Контрагент,
					ТипКИPhone,
					ВидКИFax1,
					Fax1,
					Истина
				);
				
				ПроверитьКонтактныеЛица(
					Contact1ID,
					Contact1Name,
					Contact1Phone,
					Контрагент
				);
				
				ПроверитьКонтактныеЛица(
					Contact2ID,
					Contact2Name,
					Contact2Phone,
					Контрагент
				);
				
				ПроверитьКонтактныеЛица(
					Contact3ID,
					Contact3Name,
					Contact3Phone,
					Контрагент
				);
				
				БИАС.ВыгрузкаПокупателейНашСайт(Контрагент);
				
			Иначе
				
				///////////////////////////////////////////////////////////////
				// ОБНОВЛЕНИЕ СУЩЕСТВУЮЩЕГО КОНТРАГЕНТА
				///////////////////////////////////////////////////////////////
				
				КонтрагентОбъект = Контрагент.ПолучитьОбъект();
				Записывать       = Ложь;
				
				Если Не ПустаяСтрока(Наименование)
					И КонтрагентОбъект.НаименованиеПолное <> Наименование Тогда
					
					КонтрагентОбъект.НаименованиеПолное = Наименование;
					Записывать = Истина;
					
				КонецЕсли;
				
				Если ТипЗнч(IDСайта) = Тип("Число")
					И КонтрагентОбъект.IDСайта <> IDСайта Тогда
					
					КонтрагентОбъект.IDСайта = IDСайта;
					Записывать = Истина;
					
				КонецЕсли;
				
				// Обновление Telegram.
				// Если с сайта пришло пустое значение, реквизит очищается.
				Если СокрЛП(Строка(КонтрагентОбъект.РассылкаТГ))
					<> TgBot Тогда
					
					КонтрагентОбъект.РассылкаТГ = TgBot;
					Записывать = Истина;
					
				КонецЕсли;
				
				ДатаПоследнегоВизита = ПолучитьДатуПоследнегоВизита(
					ДатаПоследнегоВизитаНаСайте
				);
				
				Если ЗначениеЗаполнено(ДатаПоследнегоВизита)
					И КонтрагентОбъект.ДатаПоследнегоВизитаНаСайте
						<> ДатаПоследнегоВизита Тогда
					
					КонтрагентОбъект.ДатаПоследнегоВизитаНаСайте =
						ДатаПоследнегоВизита;
					
					Записывать = Истина;
					
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(КонтрагентОбъект.Регион) Тогда
					
					Регион = ПолучитьРегионПоКодамСайта(
						CountryID,
						RegionID,
						LocalityID
					);
					
					Если ЗначениеЗаполнено(Регион) Тогда
						
						КонтрагентОбъект.Регион = Регион;
						Записывать = Истина;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если КонтрагентОбъект.ОсновнойКонтакт <> MainPhone Тогда
					
					КонтрагентОбъект.ОсновнойКонтакт = MainPhone;
					Записывать = Истина;
					
				КонецЕсли;
				
				ТЗПроверки = Новый ТаблицаЗначений;
				
				ТЗПроверки.Колонки.Добавить("Отделение");
				ТЗПроверки.Колонки.Добавить("Город");
				ТЗПроверки.Колонки.Добавить("Новый");
				
				ЗаполнитьТЧНоваяПочта(
					NP1City,
					NP1Dep,
					Контрагент,
					ТЗПроверки
				);
				
				ЗаполнитьТЧНоваяПочта(
					NP2City,
					NP2Dep,
					Контрагент,
					ТЗПроверки
				);
				
				ЗаполнитьТЧНоваяПочта(
					NP3City,
					NP3Dep,
					Контрагент,
					ТЗПроверки
				);
				
				ЗаполнитьТЧНоваяПочта(
					NP4City,
					NP4Dep,
					Контрагент,
					ТЗПроверки
				);
				
				ЗаполнитьТЧНоваяПочта(
					NP5City,
					NP5Dep,
					Контрагент,
					ТЗПроверки
				);
				
				Если ТЗПроверки.Количество()
					<> КонтрагентОбъект.НоваяПочта.Количество()
					Или ТЗПроверки.Итог("Новый") > 0 Тогда
					
					КонтрагентОбъект.НоваяПочта.Загрузить(ТЗПроверки);
					Записывать = Истина;
					
				КонецЕсли;
				
				Если Записывать Тогда
					
					КонтрагентОбъект.Записать();
					Контрагент = КонтрагентОбъект.Ссылка;
					
				КонецЕсли;
				
				ПроверитьКонтактнуюИнформацию(
					Контрагент,
					ТипКИEMail,
					ВидКИEMail,
					EMail
				);
				
				ПроверитьКонтактнуюИнформацию(
					Контрагент,
					ТипКИPhone,
					ВидКИPhone,
					Phone
				);
				
				ПроверитьКонтактнуюИнформацию(
					Контрагент,
					ТипКИPhone,
					ВидКИFax,
					Fax
				);
				
				ПроверитьКонтактнуюИнформацию(
					Контрагент,
					ТипКИPhone,
					ВидКИFax1,
					Fax1
				);
				
				МассивПроверки = Новый Массив;
				
				ПроверитьКонтактныеЛица(
					Contact1ID,
					Contact1Name,
					Contact1Phone,
					Контрагент,
					МассивПроверки
				);
				
				ПроверитьКонтактныеЛица(
					Contact2ID,
					Contact2Name,
					Contact2Phone,
					Контрагент,
					МассивПроверки
				);
				
				ПроверитьКонтактныеЛица(
					Contact3ID,
					Contact3Name,
					Contact3Phone,
					Контрагент,
					МассивПроверки
				);
				
				Выборка = Справочники.КонтактныеЛицаКонтрагентов.Выбрать(
					,
					Контрагент
				);
				
				Пока Выборка.Следующий() Цикл
					
					Если МассивПроверки.Найти(Выборка.Код)
						= Неопределено Тогда
						
						КонтактноеЛицоОбъект = Выборка.ПолучитьОбъект();
						
						Попытка
							КонтактноеЛицоОбъект.Удалить();
						Исключение
						КонецПопытки;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
		
		ТекстОшибки = ОписаниеОшибки();
		
		УстановитьПривилегированныйРежим(Ложь);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


Функция ПолучитьЗначениеПоляЗагрузки(МассивСтрок, ИндексПоля) Экспорт
	
	Если ИндексПоля = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ИндексПоля < 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Если ИндексПоля >= МассивСтрок.Количество() Тогда
		Возврат "";
	КонецЕсли;
	
	ЗначениеПоля = МассивСтрок[ИндексПоля];
	
	Если ЗначениеПоля = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ЗначениеПоля));
	
КонецФункции

Функция УдалитьКавычкиИзЗначения(ЗначениеСтроки) Экспорт
	
	Результат = СокрЛП(ЗначениеСтроки);
	
	Если СтрДлина(Результат) = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Если Лев(Результат, 1) = """" Тогда
		Результат = Сред(Результат, 2);
	КонецЕсли;
	
	Если СтрДлина(Результат) > 0
		И Прав(Результат, 1) = """" Тогда
		
		Результат = Лев(
			Результат,
			СтрДлина(Результат) - 1
		);
		
	КонецЕсли;
	
	Возврат СокрЛП(Результат);
	
КонецФункции

Функция ПолучитьДатуПоследнегоВизита(
	ЗначениеДатыПоследнегоВизита
) Экспорт
	
	Если ПустаяСтрока(СокрЛП(Строка(ЗначениеДатыПоследнегоВизита))) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		
		UnixВремя = Число(ЗначениеДатыПоследнегоВизита);
		
	Исключение
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Если UnixВремя <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат НачалоДня(
		Дата(1970, 1, 1) + UnixВремя
	);
	
КонецФункции

Функция ПолучитьРегионПоКодамСайта(
	CountryID,
	RegionID,
	LocalityID
) Экспорт
	
	Если ПустаяСтрока(CountryID)
		Или ПустаяСтрока(RegionID)
		Или ПустаяСтрока(LocalityID) Тогда
		
		Возврат Справочники.Регионы.ПустаяСсылка();
		
	КонецЕсли;
	
	РегионСтрана = Справочники.Регионы.НайтиПоРеквизиту(
		"Код_Сайт",
		CountryID,
		Справочники.Регионы.ПустаяСсылка()
	);
	
	Если Не ЗначениеЗаполнено(РегионСтрана) Тогда
		Возврат Справочники.Регионы.ПустаяСсылка();
	КонецЕсли;
	
	РегионОбласть = Справочники.Регионы.НайтиПоРеквизиту(
		"Код_Сайт",
		RegionID,
		РегионСтрана
	);
	
	Если Не ЗначениеЗаполнено(РегионОбласть) Тогда
		Возврат Справочники.Регионы.ПустаяСсылка();
	КонецЕсли;
	
	РегионГород = Справочники.Регионы.НайтиПоРеквизиту(
		"Код_Сайт",
		LocalityID,
		РегионОбласть
	);
	
	Возврат РегионГород;
	
КонецФункции

Процедура ЗаписатьКонтактнуюИнформацию(
	Контрагент,
	ТипКонтактнойИнформации,
	ВидКонтактнойИнформации,
	Представление,
	ЗаполнятьПоле3 = Ложь
) Экспорт
	
	Если ПустаяСтрока(Представление) Тогда
		Возврат;
	КонецЕсли;
	
	Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	
	Запись.Объект        = Контрагент;
	Запись.Тип           = ТипКонтактнойИнформации;
	Запись.Вид           = ВидКонтактнойИнформации;
	Запись.Представление = Представление;
	
	Если ЗаполнятьПоле3 Тогда
		Запись.Поле3 = Представление;
	КонецЕсли;
	
	Запись.Записать();
	
КонецПроцедуры

Процедура ЗаполнитьТЧНоваяПочта(NPCity, NPDep, Контрагент, ТЗПроверки = Неопределено)
	
	Если ПустаяСтрока(NPCity) Или ПустаяСтрока(NPDep) Тогда
		Возврат;
	КонецЕсли;
	
	Город = Справочники.ЛМ_Города.НайтиПоРеквизиту("ГУИД", NPCity);
	
	Если ЗначениеЗаполнено(Город) Тогда
		
		Отделение = Справочники.ЛМ_Отделения.НайтиПоРеквизиту("ГУИД", NPDep, , Город);
		
		Если ЗначениеЗаполнено(Отделение) Тогда
			
			Если ТЗПроверки = Неопределено Тогда
				
				НоваяСтрока = Контрагент.НоваяПочта.Добавить();
				
				НоваяСтрока.Отделение = Отделение;
				НоваяСтрока.Город     = Город;
				
			Иначе
				
				НоваяСтрока = ТЗПроверки.Добавить();
				
				НоваяСтрока.Отделение = Отделение;
				НоваяСтрока.Город     = Город;
				
				ПараметрыОтбора = Новый Структура("Отделение, Город", Отделение, Город);
				
				НайденныеСтроки = Контрагент.НоваяПочта.НайтиСтроки(ПараметрыОтбора);
				
				НоваяСтрока.Новый = ?(НайденныеСтроки.Количество() > 0, 0, 1);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьКонтактныеЛица(ContactID, ContactName, ContactPhone, Контрагент, МассивПроверки = Неопределено)
	
	Если Лев(ContactName, 1) = """" Тогда
		
		ContactName = Сред(ContactName, 2);
		
	КонецЕсли;
	
	Если Прав(ContactName, 1) = """" Тогда
		
		ContactName = Лев(ContactName, СтрДлина(ContactName) - 1);
		
	КонецЕсли;
	
	Если ПустаяСтрока(ContactID) ИЛИ ContactID = "0" Тогда
		
		Если ПустаяСтрока(ContactName) Тогда
			Возврат;
		КонецЕсли;
		
		НовоеКонтактноеЛицо = Справочники.КонтактныеЛицаКонтрагентов.СоздатьЭлемент();
		
		НовоеКонтактноеЛицо.Владелец     = Контрагент;
		НовоеКонтактноеЛицо.Наименование = ContactName;
		
		НовоеКонтактноеЛицо.Записать();
		
		КонтактноеЛицо = НовоеКонтактноеЛицо.Ссылка;
		
	Иначе
		
		КонтактноеЛицо = Справочники.КонтактныеЛицаКонтрагентов.НайтиПоКоду(ОбщегоНазначения.ДополнитьНомерНулями(ContactID, 9), , , Контрагент);
		
		Если КонтактноеЛицо.Пустая() Тогда
			Возврат;
		КонецЕсли;
		
		Если Не ПустаяСтрока(ContactName) И
			 КонтактноеЛицо.Наименование <> ContactName Тогда
			
			КонтактноеЛицоОбъект = КонтактноеЛицо.ПолучитьОбъект();
			
			КонтактноеЛицоОбъект.Наименование = ContactName;
			
			КонтактноеЛицоОбъект.Записать();
			
			КонтактноеЛицо = КонтактноеЛицоОбъект.Ссылка;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если МассивПроверки <> Неопределено Тогда
		
		МассивПроверки.Добавить(КонтактноеЛицо.Код);
		
	КонецЕсли;
	
	ПроверитьКонтактнуюИнформацию(КонтактноеЛицо, Перечисления.ТипыКонтактнойИнформации.Телефон, Справочники.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛицаКонтрагента, ContactPhone);
	
КонецПроцедуры

Процедура ПроверитьКонтактнуюИнформацию(Объект, Тип, Вид, Представление)
	
	Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	
	Запись.Объект = Объект;
	Запись.Тип    = Тип;
	Запись.Вид    = Вид;
	
	Запись.Прочитать();
	
	Если Запись.Выбран() Тогда
		
		Если ПустаяСтрока(Представление) Тогда
			Запись.Удалить();
			Возврат;
		КонецЕсли;
		
		Если Запись.Представление = Представление Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(Представление) Тогда
		
		Запись.Объект        = Объект;
		Запись.Тип           = Тип;
		Запись.Вид           = Вид;
		Запись.Представление = Представление;
		
		Если Тип = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			
			Запись.Поле3 = Представление;
			
		КонецЕсли;
		
		Запись.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ВыполнитьВыгрузку(Контрагент) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Текст = "ID;Name;EMail;MainPhone;Fax;Fax1;GroupID;CountryID;RegionID;LocalityID;Contact1ID;Contact1Name;Contact1Phone;Contact2ID;Contact2Name;Contact2Phone;Contact3ID;Contact3Name;Contact3Phone;Debt;NP1Dep;NP1City;NP2Dep;NP2City;NP3Dep;NP3City;NP4Dep;NP4City;NP5Dep;NP5City;SiteID;MapMember;AccessLevel;HeadSiteID;HeadTurnover;ToNextLevel;
			|";

	// Оборот головного контрагента за период категоризации и сколько ему не хватает до следующего
	// уровня - для прогресс-бара в личном кабинете ("до VIP2 осталось 180 000 грн"). Считаем тем же
	// вызовом и за тот же период, что и регламентное задание категоризации, поэтому цифры всегда
	// согласованы с уже записанным в контрагентов УровеньДоступа.
	// Значения относятся к ГОЛОВНОМУ контрагенту, а не к точке - у всех точек одного клиента они
	// одинаковые, суммировать их по точкам нельзя (отсюда префикс Head в имени колонки).
	Период = КатегоризацияКлиентов.ПериодКатегоризации();
	ПоказателиУровня = Новый Соответствие;
	Для Каждого СтрокаУровня Из КатегоризацияКлиентов.РассчитатьУровниДоступа(
			Период.ДатаНачала, Период.ДатаОкончания) Цикл
		ПоказателиУровня.Вставить(СтрокаУровня.ГоловнойКонтрагент, СтрокаУровня);
	КонецЦикла;

	// Список групп вынесен в КатегоризацияКлиентов.ГруппыОптовыхКлиентов - им же пользуется расчёт
	// уровней доступа. Обе стороны обязаны работать по одной популяции клиентов, иначе проценты
	// уровней считаются не от той базы (см. комментарий там же).
	IDГрупп = КатегоризацияКлиентов.ГруппыОптовыхКлиентов();
	Группы  = КатегоризацияКлиентов.МассивГруппОптовыхКлиентов();

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Код КАК ID,
		|	Контрагенты.Наименование КАК Name,
		|	ЕСТЬNULL(ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток, 0) КАК Debt,
		|	Контрагенты.IDСайта КАК SiteID,
		|	Контрагенты.ГоловнойКонтрагент.IDСайта КАК HeadSiteID,
		|	Контрагенты.ГоловнойКонтрагент КАК ГоловнойКонтрагент,
		|	Контрагенты.УровеньДоступа КАК УровеньДоступа,
		|	ВЫБОР
		|		КОГДА КатегорииОбъектов.Объект = Контрагенты.Ссылка
		|			ТОГДА ""0""
		|		ИНАЧЕ ""1""
		|	КОНЕЦ КАК MapMember
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(&Дата, ) КАК ВзаиморасчетыСКонтрагентамиОстатки
		|		ПО Контрагенты.Ссылка = ВзаиморасчетыСКонтрагентамиОстатки.Контрагент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК КатегорииОбъектов
		|		ПО Контрагенты.Ссылка = КатегорииОбъектов.Объект
		|			И (КатегорииОбъектов.Категория.Код = ""000000133"")
		|ГДЕ
		|	НЕ Контрагенты.ПометкаУдаления
		|	И Контрагенты.Ссылка В ИЕРАРХИИ(&Группы)
		|	И НЕ Контрагенты.ЭтоГруппа
		|	И &Отбор
		|
		|УПОРЯДОЧИТЬ ПО
		|	ID";
	
	
	Запрос.УстановитьПараметр("Дата"  , ТекущаяДата());
	Запрос.УстановитьПараметр("Группы", Группы);
	
	Если Контрагент <> Неопределено Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отбор", "Контрагенты.Ссылка В ИЕРАРХИИ(&Контрагент)");
		
		Запрос.УстановитьПараметр("Контрагент", Контрагент.ссылка);
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Отбор", "ИСТИНА");
		
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	
	ПараметрыОтбора.Вставить("Объект");
	ПараметрыОтбора.Вставить("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	ПараметрыОтбора.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛицаКонтрагента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Текст = Текст + ОбщегоНазначения.УбратьНоликиСлева(Выборка.ID) + ";";
		Текст = Текст + СокрЛП(СтрЗаменить(Выборка.Name, ";", " "))    + ";";
		
		EMail     = "";
		MainPhone = СокрЛП(Выборка.Ссылка.ОсновнойКонтакт);
		
		МассивТелефонов = Новый Массив;
		
		КонтактнаяИнформация = РегистрыСведений.КонтактнаяИнформация.Выбрать(Новый Структура("Объект", Выборка.Ссылка));
		
		Пока КонтактнаяИнформация.Следующий() Цикл
			
			Представление = СокрЛП(КонтактнаяИнформация.Представление);
			
			Если КонтактнаяИнформация.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты И
				 Не ПустаяСтрока(Представление) И
				 ПустаяСтрока(EMail) Тогда
				
				EMail = Представление;
				
			КонецЕсли;
			
			Если КонтактнаяИнформация.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон И
				 Не ПустаяСтрока(Представление) И
				 Представление <> MainPhone И
				 МассивТелефонов.Найти(Представление) = Неопределено Тогда
				
				МассивТелефонов.Добавить(Представление);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Текст = Текст + СокрЛП(СтрЗаменить(EMail, ";", " ")) + ";";
		
		Если ПустаяСтрока(MainPhone) Тогда
			
			КоличествоПолей = 3;
			
		Иначе
			
			Текст = Текст + СокрЛП(СтрЗаменить(MainPhone, ";", " ")) + ";";
			
			КоличествоПолей = 2;
			
		КонецЕсли;
		
		КоличествоТелефонов = Мин(КоличествоПолей, МассивТелефонов.Количество());
		
		Для п = 1 По КоличествоТелефонов Цикл
			
			Текст = Текст + СокрЛП(СтрЗаменить(МассивТелефонов[п - 1], ";", " ")) + ";";
			
		КонецЦикла;
		
		Для п = 1 По КоличествоПолей - КоличествоТелефонов Цикл
			
			Текст = Текст + ";";
			
		КонецЦикла;
		
		ИндексГруппы = ПолучитьИндексГруппы(Выборка.Ссылка.Родитель);
		
		Текст = Текст + ?(ИндексГруппы = Неопределено, "", IDГрупп[Группы[ИндексГруппы]]) + ";";
		
		Регион = ПолучитьЭлементТретьегоУровня(Выборка.Ссылка.Регион);
		
		Текст = Текст + СокрЛП(СтрЗаменить(Регион.Родитель.Родитель.Код_Сайт, ";", " ")) + ";";
		Текст = Текст + СокрЛП(СтрЗаменить(Регион.Родитель.Код_Сайт         , ";", " ")) + ";";
		Текст = Текст + СокрЛП(СтрЗаменить(Регион.Код_Сайт                  , ";", " ")) + ";";
		
		КонтактныеЛица = Справочники.КонтактныеЛицаКонтрагентов.Выбрать(, Выборка.Ссылка);
		
		КоличествоКЛ = 0;
		
		Пока КонтактныеЛица.Следующий() Цикл
			
			Если КоличествоКЛ = 3 Тогда
				Прервать;
			КонецЕсли;
			
			Текст = Текст + ОбщегоНазначения.УбратьНоликиСлева(КонтактныеЛица.Код)     + ";";
			Текст = Текст + СокрЛП(СтрЗаменить(КонтактныеЛица.Наименование, ";", " ")) + ";";
			
			ПараметрыОтбора.Объект = КонтактныеЛица.Ссылка;
			
			Телефон = РегистрыСведений.КонтактнаяИнформация.Получить(ПараметрыОтбора);
			
			Текст = Текст + СокрЛП(СтрЗаменить(Телефон.Представление, ";", " ")) + ";";
			
			КоличествоКЛ = КоличествоКЛ + 1;
			
		КонецЦикла;
		
		Для п = 1 По 3 - КоличествоКЛ Цикл
			
			Текст = Текст + ";;;";
			
		КонецЦикла;
		
		Текст = Текст + Формат(Выборка.Debt, "ЧДЦ=0; ЧГ=0") + ";";
		
		КоличествоОтделений = 0;
		
		Для Каждого СтрокаТЧ Из Выборка.Ссылка.НоваяПочта Цикл
			
			Если КоличествоОтделений = 5 Тогда
				Прервать;
			КонецЕсли;
			
			Текст = Текст + СокрЛП(СтрокаТЧ.Отделение.ГУИД) + ";";
			Текст = Текст + СокрЛП(СтрокаТЧ.Город.ГУИД)     + ";";
			
			КоличествоОтделений = КоличествоОтделений + 1;
			
		КонецЦикла;
		
		Для п = 1 По 5 - КоличествоОтделений Цикл
			
			Текст = Текст + ";;";
			
		КонецЦикла;
		
		Текст = Текст + Формат(Выборка.SiteID, "ЧГ=0") + ";";
		Текст = Текст + Выборка.MapMember              + ";";

		Текст = Текст + КатегоризацияКлиентов.КодУровня(Выборка.УровеньДоступа) + ";";
		Текст = Текст + Формат(Выборка.HeadSiteID, "ЧГ=0") + ";";

		// Если ГоловнойКонтрагент не заполнен, головным считается сам контрагент - точно так же,
		// как это делает КатегоризацияКлиентов при агрегации продаж.
		Голова = ?(ЗначениеЗаполнено(Выборка.ГоловнойКонтрагент), Выборка.ГоловнойКонтрагент, Выборка.Ссылка);
		Показатели = ПоказателиУровня[Голова];

		Если Показатели = Неопределено Тогда
			// Продаж за период не было - клиент вне рейтинга, прогресс-бар в кабинете не рисуем.
			Текст = Текст + "0;0;";
		Иначе
			Текст = Текст + Формат(Показатели.Оборот, "ЧЦ=15; ЧДЦ=2; ЧГ=0; ЧН=0") + ";";
			Текст = Текст + Формат(Показатели.ОборотДоСледующегоУровня, "ЧЦ=15; ЧДЦ=2; ЧГ=0; ЧН=0") + ";";
		КонецЕсли;

		Текст = Текст + Символы.ПС;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Текст;
	
КонецФункции

// Пол/Сезон приходят не как обычные реквизиты Номенклатуры, а через типовой механизм
// дополнительных свойств (см. ОбщегоНазначения.СвойстваОбъекта / ЗаписатьСвойстваДляХарактеритси,
// которым уже пользуется ВыгрузкаНашСайт для product_gender/product_season в product.xml).
// Ищем по коду свойства, а не по имени - имя оказалось не "Пол"/"Сезон" (диагностика через
// КатегоризацияКлиентов.ДиагностикаСвойствНоменклатуры показала реальные названия): свойство
// называется "Стать" (код 000000055), а отдельного "Сезон" в данных нет вовсе - есть только
// "Розетка Сезон" (код 000000056, заведено исходно под выгрузку на Розетку, переиспользуется
// как общий сезон везде, включая product.xml).
//
// Возвращает фрагмент текста запроса вида:
//   ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК <АлиасПол>
//       ПО <АлиасПол>.Объект = <ПолеНоменклатуры> И <АлиасПол>.Свойство.Код = "000000055"
//   ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК <АлиасСезон>
//       ПО <АлиасСезон>.Объект = <ПолеНоменклатуры> И <АлиасСезон>.Свойство.Код = "000000056"
//
Функция ТекстСоединенияПолСезон(ПолеНоменклатуры) Экспорт

	Возврат
	"	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияПол
	|		ПО ЗначенияПол.Объект = " + ПолеНоменклатуры + " И ЗначенияПол.Свойство.Код = ""000000055""
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСезон
	|		ПО ЗначенияСезон.Объект = " + ПолеНоменклатуры + " И ЗначенияСезон.Свойство.Код = ""000000056""
	|";

КонецФункции

// Строковое представление значения свойства (Пол/Сезон/Тип изделия) для CSV - может быть ссылкой
// на элемент справочника значений свойства или простым текстом, в обоих случаях достаточно
// СокрЛП(Строка()).
//
Функция ПредставлениеЗначенияСвойства(Значение) Экспорт

	Возврат ?(ЗначениеЗаполнено(Значение), СокрЛП(СтрЗаменить(Строка(Значение), ";", " ")), "");

КонецФункции

// Код значения свойства для колонки CategoryID - если значение свойства является ссылкой
// на элемент справочника с реквизитом Код (как обычно устроены значения свойств в этой
// конфигурации), возвращает его; для простого текстового/числового значения кода нет - пусто.
//
Функция КодЗначенияСвойства(Значение) Экспорт

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Возврат ОбщегоНазначения.УбратьНоликиСлева(Значение.Код);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

// Категория = значение свойства "Тип виробу" (код 000000037 в справочнике свойств объектов),
// а не КатегорияНашСайт - по просьбе пользователя, для статистики покупок это осмысленнее,
// чем навигационная категория сайта (которую не трогаем - она отдельно используется в product.xml).
//
// Возвращает фрагмент текста запроса вида:
//   ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияТипИзделия
//       ПО ЗначенияТипИзделия.Объект = <ПолеНоменклатуры> И ЗначенияТипИзделия.Свойство.Код = "000000037"
//
Функция ТекстСоединенияТипИзделия(ПолеНоменклатуры) Экспорт

	Возврат
	"	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияТипИзделия
	|		ПО ЗначенияТипИзделия.Объект = " + ПолеНоменклатуры + " И ЗначенияТипИзделия.Свойство.Код = ""000000037""
	|";

КонецФункции

// Статистика ОТГРУЗОК (не заказов!) каждого контрагента (точки) по месяцам и категориям -
// для графиков в личном кабинете. Источник - РегистрНакопления.Продажи, а туда движения пишут
// только РеализацияТоваровУслуг/розничные отчёты/возврат (проверено по коду документов) - то есть
// Month здесь = месяц фактической отгрузки/реализации, НЕ месяц оформления заказа
// (для заказов - см. ВыполнитьВыгрузкуСтатистикиЗаказов).
// Категория = значение свойства "Тип виробу" (см. ТекстСоединенияТипИзделия) - НЕ КатегорияНашСайт,
// это разные вещи: КатегорияНашСайт - навигационная категория сайта (используется в product.xml
// для categoryId), Тип виробу - тип изделия, для статистики покупок осмысленнее. Строка на каждую
// точку-контрагента (SiteID), группировку по головному сайт делает сам через HeadSiteID из users.csv.
//
Функция ВыполнитьВыгрузкуСтатистикиОтгрузок(ДатаНачала, ДатаОкончания) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПродажиОбороты.Период                                КАК Месяц,
	|	ПродажиОбороты.Контрагент                             КАК Контрагент,
	|	ЗначенияТипИзделия.Значение                           КАК Категория,
	|	ЗначенияПол.Значение                                  КАК Пол,
	|	ЗначенияСезон.Значение                                КАК Сезон,
	|	СУММА(ПродажиОбороты.СтоимостьОборот)                 КАК Сумма,
	|	СУММА(ПродажиОбороты.КоличествоОборот)                КАК Количество
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&ДатаНачала, &ДатаОкончания, Месяц, ) КАК ПродажиОбороты
	|" + ТекстСоединенияТипИзделия("ПродажиОбороты.Номенклатура") + "
	|" + ТекстСоединенияПолСезон("ПродажиОбороты.Номенклатура") + "
	|ГДЕ
	|	ПродажиОбороты.СтоимостьОборот <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Период,
	|	ПродажиОбороты.Контрагент,
	|	ЗначенияТипИзделия.Значение,
	|	ЗначенияПол.Значение,
	|	ЗначенияСезон.Значение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент, Месяц";

	Текст = "SiteID;Month;CategoryID;CategoryName;Gender;Season;Amount;Qty;AccessLevel;
			|";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если Не ЗначениеЗаполнено(Выборка.Контрагент.IDСайта) Тогда
			Продолжить;
		КонецЕсли;

		// Тип попавший в укрупнённую группу (см. ГруппаТипаИзделия) получает синтетический код,
		// общий для всей группы, чтобы разные исходные типы (Куртка, Пальто и т.д.) суммировались
		// на сайте в одну категорию, а не расходились по разным CategoryID.
		ИмяКатегории = ГруппаТипаИзделия(ПредставлениеЗначенияСвойства(Выборка.Категория));
		КодКатегории = КодГруппыТипаИзделия(ИмяКатегории);
		Если Не ЗначениеЗаполнено(КодКатегории) Тогда
			КодКатегории = КодЗначенияСвойства(Выборка.Категория);
		КонецЕсли;

		Текст = Текст + Формат(Выборка.Контрагент.IDСайта, "ЧГ=0") + ";";
		Текст = Текст + Формат(Выборка.Месяц, "ДФ=yyyy-MM") + ";";
		Текст = Текст + КодКатегории + ";";
		Текст = Текст + ИмяКатегории + ";";
		Текст = Текст + ПредставлениеЗначенияСвойства(Выборка.Пол) + ";";
		Текст = Текст + ПредставлениеЗначенияСвойства(Выборка.Сезон) + ";";
		Текст = Текст + Формат(Выборка.Сумма, "ЧЦ=15; ЧДЦ=2; ЧГ=0; ЧН=0") + ";";
		Текст = Текст + Формат(Выборка.Количество, "ЧЦ=15; ЧДЦ=3; ЧГ=0; ЧН=0") + ";";
		Текст = Текст + КатегоризацияКлиентов.КодУровня(Выборка.Контрагент.УровеньДоступа) + ";";
		Текст = Текст + Символы.ПС;

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Текст;

КонецФункции

// Статистика ЗАКАЗОВ (не отгрузок!) - месяц оформления Документ.ЗаказПокупателя, а не месяц
// фактической отгрузки (см. ВыполнитьВыгрузкуСтатистикиОтгрузок). Источник - табличная часть
// Товары самого документа, а не регистр (в РегистрНакопления.ТоварыВРезервеНаСкладах, куда пишет
// ЗаказПокупателя, нет ни Контрагента, ни суммы - только количество и склад резерва).
//
// Заказ часто оформляется КОМПЛЕКТОМ (Номенклатура.Комплект = Истина), а отгружается уже
// отдельными товарами после разукомплектации - поэтому строка комплекта в Товары не даёт ни
// правильную категорию (у комплекта своё "Тип виробу", обычно не совпадающее с содержимым),
// ни правильное количество (1 комплект вместо N вложенных единиц), из-за чего заказы выглядели
// меньше отгрузок. Для строк-комплектов берём уже готовую разузлованную табличную часть
// СоставНабора (её заполняет сама конфигурация через УправлениеЗапасами.ДобавитьСоставНабора /
// БИАС.ПолучитьКомплектующиеНаборКомплекта - рекурсивно, вложенные комплекты уже разложены до
// реальных товаров) - оттуда берём настоящую Номенклатуру и Количество для категории и подсчёта.
// Сумма строки комплекта делится между вложенными товарами пропорционально их доле в общем
// количестве комплектующих этой строки (точного разнесения по себестоимости - ДоляСтоимости -
// СоставНабора не хранит, только доли по количеству).
//
Функция ВыполнитьВыгрузкуСтатистикиЗаказов(ДатаНачала, ДатаОкончания) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Месяц                                  КАК Месяц,
	|	ВложенныйЗапрос.Контрагент                             КАК Контрагент,
	|	ЗначенияТипИзделия.Значение                            КАК Категория,
	|	ЗначенияПол.Значение                                   КАК Пол,
	|	ЗначенияСезон.Значение                                 КАК Сезон,
	|	СУММА(ВложенныйЗапрос.Сумма)                           КАК Сумма,
	|	СУММА(ВложенныйЗапрос.Количество)                       КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		НАЧАЛОПЕРИОДА(ЗаказТовары.Ссылка.Дата, МЕСЯЦ)      КАК Месяц,
	|		ЗаказТовары.Ссылка.Контрагент                      КАК Контрагент,
	|		ЗаказТовары.Номенклатура                           КАК Номенклатура,
	|		ЗаказТовары.Сумма                                  КАК Сумма,
	|		ЗаказТовары.Количество                             КАК Количество
	|	ИЗ
	|		Документ.ЗаказПокупателя.Товары КАК ЗаказТовары
	|	ГДЕ
	|		ЗаказТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|		И ЗаказТовары.Ссылка.Проведен
	|		И НЕ ЗаказТовары.Номенклатура.Комплект
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		НАЧАЛОПЕРИОДА(ЗаказТовары.Ссылка.Дата, МЕСЯЦ),
	|		ЗаказТовары.Ссылка.Контрагент,
	|		СоставНабора.Номенклатура,
	|		ЗаказТовары.Сумма * СоставНабора.Количество / ИтогиКомпонентов.ОбщееКоличество,
	|		СоставНабора.Количество
	|	ИЗ
	|		Документ.ЗаказПокупателя.СоставНабора КАК СоставНабора
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказПокупателя.Товары КАК ЗаказТовары
	|			ПО ЗаказТовары.Ссылка = СоставНабора.Ссылка
	|			И ЗаказТовары.КлючСтроки = СоставНабора.КлючСтроки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				СоставНабораИтог.Ссылка      КАК Ссылка,
	|				СоставНабораИтог.КлючСтроки  КАК КлючСтроки,
	|				СУММА(СоставНабораИтог.Количество) КАК ОбщееКоличество
	|			ИЗ
	|				Документ.ЗаказПокупателя.СоставНабора КАК СоставНабораИтог
	|			СГРУППИРОВАТЬ ПО
	|				СоставНабораИтог.Ссылка, СоставНабораИтог.КлючСтроки
	|		) КАК ИтогиКомпонентов
	|			ПО ИтогиКомпонентов.Ссылка = СоставНабора.Ссылка
	|			И ИтогиКомпонентов.КлючСтроки = СоставНабора.КлючСтроки
	|	ГДЕ
	|		ЗаказТовары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|		И ЗаказТовары.Ссылка.Проведен
	|		И ЗаказТовары.Номенклатура.Комплект
	|		И ИтогиКомпонентов.ОбщееКоличество <> 0
	|	) КАК ВложенныйЗапрос
	|" + ТекстСоединенияТипИзделия("ВложенныйЗапрос.Номенклатура") + "
	|" + ТекстСоединенияПолСезон("ВложенныйЗапрос.Номенклатура") + "
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Месяц,
	|	ВложенныйЗапрос.Контрагент,
	|	ЗначенияТипИзделия.Значение,
	|	ЗначенияПол.Значение,
	|	ЗначенияСезон.Значение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент, Месяц";

	Текст = "SiteID;Month;CategoryID;CategoryName;Gender;Season;Amount;Qty;AccessLevel;
			|";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если Не ЗначениеЗаполнено(Выборка.Контрагент.IDСайта) Тогда
			Продолжить;
		КонецЕсли;

		ИмяКатегории = ГруппаТипаИзделия(ПредставлениеЗначенияСвойства(Выборка.Категория));
		КодКатегории = КодГруппыТипаИзделия(ИмяКатегории);
		Если Не ЗначениеЗаполнено(КодКатегории) Тогда
			КодКатегории = КодЗначенияСвойства(Выборка.Категория);
		КонецЕсли;

		Текст = Текст + Формат(Выборка.Контрагент.IDСайта, "ЧГ=0") + ";";
		Текст = Текст + Формат(Выборка.Месяц, "ДФ=yyyy-MM") + ";";
		Текст = Текст + КодКатегории + ";";
		Текст = Текст + ИмяКатегории + ";";
		Текст = Текст + ПредставлениеЗначенияСвойства(Выборка.Пол) + ";";
		Текст = Текст + ПредставлениеЗначенияСвойства(Выборка.Сезон) + ";";
		Текст = Текст + Формат(Выборка.Сумма, "ЧЦ=15; ЧДЦ=2; ЧГ=0; ЧН=0") + ";";
		Текст = Текст + Формат(Выборка.Количество, "ЧЦ=15; ЧДЦ=3; ЧГ=0; ЧН=0") + ";";
		Текст = Текст + КатегоризацияКлиентов.КодУровня(Выборка.Контрагент.УровеньДоступа) + ";";
		Текст = Текст + Символы.ПС;

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Текст;

КонецФункции

// Сводка для дашборда руководителя на сайте: одна строка на точку-контрагента с суммой продаж
// за период (без разбивки по месяцам/категориям - для этого есть shipments_by_category.csv) и
// названием области/города (не кодом сайта, а настоящим Наименование - этот файл не для
// сопоставления с формами сайта, а чтобы можно было сразу красиво сверстать таблицу/пивот).
// Область/город берём через ПолучитьЭлементТретьегоУровня - тот же приём нормализации адреса,
// которым уже пользуется ВыполнитьВыгрузку для CountryID/RegionID/LocalityID в users.csv.
//
Функция ВыполнитьВыгрузкуСводнойПоРегионам(ДатаНачала, ДатаОкончания) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПродажиОбороты.Контрагент                КАК Контрагент,
	|	СУММА(ПродажиОбороты.СтоимостьОборот)    КАК Сумма,
	|	СУММА(ПродажиОбороты.КоличествоОборот)   КАК Количество
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&ДатаНачала, &ДатаОкончания, , ) КАК ПродажиОбороты
	|ГДЕ
	|	ПродажиОбороты.СтоимостьОборот <> 0
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Контрагент
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент";

	Текст = "SiteID;Name;HeadSiteID;AccessLevel;Region;City;Amount;Qty;
			|";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Контрагент = Выборка.Контрагент;

		Если Не ЗначениеЗаполнено(Контрагент.IDСайта) Тогда
			Продолжить;
		КонецЕсли;

		Область = "";
		Город = "";
		Если ЗначениеЗаполнено(Контрагент.Регион) Тогда
			РегионНорм = ПолучитьЭлементТретьегоУровня(Контрагент.Регион);
			Город = ОчиститьНазваниеРегиона(СокрЛП(СтрЗаменить(РегионНорм.Наименование, ";", " ")));
			Если ЗначениеЗаполнено(РегионНорм.Родитель) Тогда
				Область = ОчиститьНазваниеРегиона(СокрЛП(СтрЗаменить(РегионНорм.Родитель.Наименование, ";", " ")));
			КонецЕсли;
		КонецЕсли;

		Текст = Текст + Формат(Контрагент.IDСайта, "ЧГ=0") + ";";
		Текст = Текст + СокрЛП(СтрЗаменить(Контрагент.Наименование, ";", " ")) + ";";
		Текст = Текст + Формат(Контрагент.ГоловнойКонтрагент.IDСайта, "ЧГ=0") + ";";
		Текст = Текст + КатегоризацияКлиентов.КодУровня(Контрагент.УровеньДоступа) + ";";
		Текст = Текст + Область + ";";
		Текст = Текст + Город + ";";
		Текст = Текст + Формат(Выборка.Сумма, "ЧЦ=15; ЧДЦ=2; ЧГ=0; ЧН=0") + ";";
		Текст = Текст + Формат(Выборка.Количество, "ЧЦ=15; ЧДЦ=3; ЧГ=0; ЧН=0") + ";";
		Текст = Текст + Символы.ПС;

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Возврат Текст;

КонецФункции

// Группа укрупнённого типа изделия - несколько родственных значений "Тип виробу" схлопываются
// в одну группу "Куртки" (используется и в сводке руководителя, и в shipments_by_category.csv/
// orders_by_category.csv). Шуба сознательно исключена из группы - остаётся отдельной категорией.
// Список согласован с пользователем. Значения, которых нет в этом соответствии, проходят как есть
// (без группировки).
//
Функция ГруппаТипаИзделия(ИмяТипа) Экспорт

	Если Не ЗначениеЗаполнено(ИмяТипа) Тогда
		Возврат "";
	КонецЕсли;

	ГруппыТипов = Новый Соответствие;
	// Значения свойства хранятся на нескольких языках (Наименование/Наименование рус/Наименование
	// Ингл) - Строка(Значение) возвращает язык по умолчанию конфигурации (украинский), поэтому
	// нужны оба варианта написания, а не только русский, иначе часть типов проходит мимо группировки
	// (баг был найден именно так - "Вітровка"/"Двостороння куртка" и т.п. не совпадали с русскими
	// ключами словаря).
	ГруппыТипов.Вставить("Куртка", "Куртки");
	ГруппыТипов.Вставить("Пальто", "Куртки");
	ГруппыТипов.Вставить("Бомбер", "Куртки");
	ГруппыТипов.Вставить("Парка", "Куртки");
	ГруппыТипов.Вставить("Двусторонняя куртка", "Куртки");
	ГруппыТипов.Вставить("Двостороння куртка", "Куртки");
	ГруппыТипов.Вставить("Светоотражающая куртка", "Куртки");
	ГруппыТипов.Вставить("Світловідбивна куртка", "Куртки");
	ГруппыТипов.Вставить("Ветровка", "Куртки");
	ГруппыТипов.Вставить("Вітровка", "Куртки");
	ГруппыТипов.Вставить("Дождевик", "Куртки");
	ГруппыТипов.Вставить("Дощовик", "Куртки");

	// Костюм: тройка и "3в1" - это тот же костюм, отдельными строками в статистике не нужны.
	// Здесь целевое имя группы совпадает с существующим типом "Костюм" - поэтому CategoryID
	// для всей группы берётся из КодГруппыТипаИзделия, иначе обычный "Костюм" уехал бы на сайт
	// со своим родным кодом и не склеился бы с тройкой (см. КодГруппыТипаИзделия).
	ГруппыТипов.Вставить("Костюм тройка", "Костюм");
	ГруппыТипов.Вставить("Костюм трійка", "Костюм");
	ГруппыТипов.Вставить("3в1", "Костюм");
	ГруппыТипов.Вставить("Зв1", "Костюм");

	Группа = ГруппыТипов[ИмяТипа];

	Возврат ?(Группа = Неопределено, ИмяТипа, Группа);

КонецФункции

// CategoryID для укрупнённой группы: одно синтетическое значение на всю группу, чтобы сайт склеил
// строки в одну категорию. Без этого группа "Костюм" разъехалась бы на сайте на две: обычный тип
// "Костюм" ушёл бы со своим родным кодом свойства, а "Костюм тройка"/"3в1" - с кодом группы.
// Для типов вне групп возвращает пустую строку - значит нужно брать родной код значения свойства.
//
Функция КодГруппыТипаИзделия(ИмяГруппы) Экспорт

	ИменаГрупп = Новый Массив;
	ИменаГрупп.Добавить("Куртки");
	ИменаГрупп.Добавить("Костюм");

	Возврат ?(ИменаГрупп.Найти(ИмяГруппы) = Неопределено, "", "group_" + ИмяГруппы);

КонецФункции

// Название региона/города из справочника адресного классификатора хранится с приклеенным
// населением через пробел (например, "Житомирская область 1 231" или "Ахтырка 47") - отсекаем
// хвостовые цифры и разделяющие их пробелы, оставляя только само название.
//
Функция ОчиститьНазваниеРегиона(Знач Название) Экспорт

	Строка = СокрП(Название);
	Позиция = СтрДлина(Строка);

	Пока Позиция > 0 Цикл
		Символ = Сред(Строка, Позиция, 1);
		Если Символ = " " Или (Символ >= "0" И Символ <= "9") Тогда
			Позиция = Позиция - 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат СокрП(Лев(Строка, Позиция));

КонецФункции

// Сводка для дашборда руководителя: продажи по месяцам и регионам/городам, тип изделия -
// укрупнённой группой (см. ГруппаТипаИзделия), БЕЗ детализации по контрагенту - это агрегат
// по всей компании, контрагент используется только как ключ для определения региона/города
// и в выгрузку не попадает.
//
Функция ВыполнитьВыгрузкуСводнойПоМесяцамИРегионам(ДатаНачала, ДатаОкончания) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПродажиОбороты.Период                  КАК Месяц,
	|	ПродажиОбороты.Контрагент               КАК Контрагент,
	|	ЗначенияТипИзделия.Значение             КАК ТипИзделия,
	|	СУММА(ПродажиОбороты.СтоимостьОборот)   КАК Сумма,
	|	СУММА(ПродажиОбороты.КоличествоОборот)  КАК Количество
	|ИЗ
	|	РегистрНакопления.Продажи.Обороты(&ДатаНачала, &ДатаОкончания, Месяц, ) КАК ПродажиОбороты
	|" + ТекстСоединенияТипИзделия("ПродажиОбороты.Номенклатура") + "
	|ГДЕ
	|	ПродажиОбороты.СтоимостьОборот <> 0
	|СГРУППИРОВАТЬ ПО
	|	ПродажиОбороты.Период,
	|	ПродажиОбороты.Контрагент,
	|	ЗначенияТипИзделия.Значение";

	// Регион/город определяются на уровне контрагента (в запросе их нет), поэтому вторую
	// агрегацию - по (Месяц, Область, Город, ГруппаТипа) - делаем в памяти после выборки.
	Свод = Новый Соответствие;
	КэшРегионов = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Контрагент = Выборка.Контрагент;

		РегионИнфо = КэшРегионов[Контрагент];
		Если РегионИнфо = Неопределено Тогда
			Область = "";
			Город = "";
			Если ЗначениеЗаполнено(Контрагент.Регион) Тогда
				РегионНорм = ПолучитьЭлементТретьегоУровня(Контрагент.Регион);
				Город = ОчиститьНазваниеРегиона(СокрЛП(СтрЗаменить(РегионНорм.Наименование, ";", " ")));
				Если ЗначениеЗаполнено(РегионНорм.Родитель) Тогда
					Область = ОчиститьНазваниеРегиона(СокрЛП(СтрЗаменить(РегионНорм.Родитель.Наименование, ";", " ")));
				КонецЕсли;
			КонецЕсли;
			РегионИнфо = Новый Структура("Область, Город", Область, Город);
			КэшРегионов.Вставить(Контрагент, РегионИнфо);
		КонецЕсли;

		ГруппаТипа = ГруппаТипаИзделия(ПредставлениеЗначенияСвойства(Выборка.ТипИзделия));

		КлючСвода = Формат(Выборка.Месяц, "ДФ=yyyy-MM") + "|" + РегионИнфо.Область + "|" + РегионИнфо.Город + "|" + ГруппаТипа;

		Итог = Свод[КлючСвода];
		Если Итог = Неопределено Тогда
			Итог = Новый Структура("Месяц, Область, Город, ГруппаТипа, Сумма, Количество",
				Формат(Выборка.Месяц, "ДФ=yyyy-MM"), РегионИнфо.Область, РегионИнфо.Город, ГруппаТипа, 0, 0);
			Свод.Вставить(КлючСвода, Итог);
		КонецЕсли;

		Итог.Сумма = Итог.Сумма + Выборка.Сумма;
		Итог.Количество = Итог.Количество + Выборка.Количество;

	КонецЦикла;

	УстановитьПривилегированныйРежим(Ложь);

	Текст = "Month;Region;City;TypeGroup;Amount;Qty;
			|";

	Для Каждого Элемент Из Свод Цикл
		Стр = Элемент.Значение;
		Текст = Текст + Стр.Месяц + ";";
		Текст = Текст + Стр.Область + ";";
		Текст = Текст + Стр.Город + ";";
		Текст = Текст + Стр.ГруппаТипа + ";";
		Текст = Текст + Формат(Стр.Сумма, "ЧЦ=15; ЧДЦ=2; ЧГ=0; ЧН=0") + ";";
		Текст = Текст + Формат(Стр.Количество, "ЧЦ=15; ЧДЦ=3; ЧГ=0; ЧН=0") + ";";
		Текст = Текст + Символы.ПС;
	КонецЦикла;

	Возврат Текст;

КонецФункции

Функция ПолучитьИндексГруппы(Родитель)
	
	Если Родитель.Пустая() Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ИндексГруппы = Группы.Найти(Родитель);
	
	Если ИндексГруппы = Неопределено Тогда
		
		Возврат ПолучитьИндексГруппы(Родитель.Родитель);
		
	Иначе
		
		Возврат ИндексГруппы;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЭлементТретьегоУровня(Элемент)
	
	Если Элемент.Родитель.Родитель.Родитель.Пустая() Тогда
		
		Возврат Элемент;
		
	Иначе
		
		Возврат ПолучитьЭлементТретьегоУровня(Элемент.Родитель);
		
	КонецЕсли;
	
КонецФункции

// Извлекает ключ клиента на сайте из шапки XML заказа.
//
// Возвращает Неопределено на всё, что не является положительным целым: тег может
// отсутствовать, содержать неразвёрнутый плейсхолдер "{site_id}", ноль или число
// с разделителем групп. Такие значения в карточку контрагента писать нельзя.
//
// Параметры:
//  СтруктураШапки - Структура - реквизиты элемента order из файла заказа.
//
// Возвращаемое значение:
//  Число, Неопределено
//
Функция ПолучитьIDСайтаИзЗаказа(СтруктураШапки)

	Значение = "";

	Если Не СтруктураШапки.Свойство("site_id", Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = СокрЛП(Строка(Значение));

	Если ПустаяСтрока(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Значение) Цикл

		Если СтрНайти("0123456789", Сред(Значение, Позиция, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;

	КонецЦикла;

	Попытка
		ЧисловоеЗначение = Число(Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ЧисловоеЗначение <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ЧисловоеЗначение;

КонецФункции

// Аккаунты сайта, которым разрешено задавать цену позиции вручную (id из тега
// site_id, он же код контрагента в user_id). Заказы этих аккаунтов загружаются
// в режиме ручных цен: цена позиции из файла - истина, прайс 1С её не заменяет.
//
// Возвращаемое значение:
//  Массив из Число
//
Функция АккаунтыСайтаСРучнымиЦенами()

	Аккаунты = Новый Массив;

	Аккаунты.Добавить(15207); // marffa9@gmail.com, "тип Марина"

	Возврат Аккаунты;

КонецФункции

// Определяет, загружается ли заказ в режиме ручных цен.
//
// Признак берётся из трёх источников:
//  - тег price_manual в шапке заказа (если сайт пометит заказ явно);
//  - теги site_id / user_id;
//  - код контрагента, к которому заказ в итоге привязался.
// Тегам одним доверять нельзя: контрагент мог быть найден по номеру телефона,
// а site_id при этом прийти пустым или мусорным. Ручной режим включён у аккаунта
// целиком, поэтому опознаём аккаунт любым доступным способом.
//
// Параметры:
//  СтруктураШапки - Структура - теги узла order
//  Контрагент     - СправочникСсылка.Контрагенты - контрагент заказа
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоЗаказРучногоРежима(СтруктураШапки, Контрагент)

	Значение = "";

	Если СтруктураШапки.Свойство("price_manual", Значение) И
		 СокрЛП(Строка(Значение)) = "1" Тогда

		Возврат Истина;

	КонецЕсли;

	Аккаунты = АккаунтыСайтаСРучнымиЦенами();

	IDСайта = ПолучитьIDСайтаИзЗаказа(СтруктураШапки);

	Если IDСайта <> Неопределено И Аккаунты.Найти(IDСайта) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	// user_id - это код контрагента 1С, дополненный нулями до 9 знаков, но по
	// историческим причинам совпадает с id аккаунта на сайте.
	КодИзТега = ЧислоИзТегаЗаказа(СтруктураШапки, "user_id");

	Если КодИзТега <> Неопределено И Аккаунты.Найти(КодИзТега) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(Контрагент) Тогда

		Попытка
			КодКонтрагента = Число(СокрЛП(Контрагент.Код));
		Исключение
			КодКонтрагента = 0;
		КонецПопытки;

		Если КодКонтрагента > 0 И Аккаунты.Найти(КодКонтрагента) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Разбирает числовой тег заказа (суммы наложенного платежа, цены).
//
// Пустой тег означает "данных нет" - в этом случае возвращается Неопределено,
// и вызывающий код НЕ трогает реквизит документа. Сайт присылает число с точкой
// в качестве разделителя дробной части; запятая и пробелы-разделители групп
// допускаются на всякий случай.
//
// Возвращаемое значение:
//  Число, Неопределено
//
Функция ЧислоИзТегаЗаказа(Структура, ИмяТега)

	Значение = "";

	Если Не Структура.Свойство(ИмяТега, Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Значение = СокрЛП(Строка(Значение));

	Значение = СтрЗаменить(Значение, Символы.НПП, "");
	Значение = СтрЗаменить(Значение, " ", "");
	Значение = СтрЗаменить(Значение, ",", ".");

	Если ПустаяСтрока(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЧисловоеЗначение = Число(Значение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат ЧисловоеЗначение;

КонецФункции

// Ищет характеристику номенклатуры по идентификатору позиции с сайта
// (external_id обычного товара или set_goodid ростовки/набора): из значения
// берутся только цифры, поиск идёт по вхождению в код характеристики.
//
// Возвращаемое значение:
//  СправочникСсылка.ХарактеристикиНоменклатуры, Неопределено
//
Функция НайтиХарактеристикуПоИдентификаторуССайта(Идентификатор)

	Если Идентификатор = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТолькоЦифры = "";

	Для Индекс = 1 По СтрДлина(Идентификатор) Цикл

		Символ = Сред(Идентификатор, Индекс, 1);

		Если Символ >= "0" И Символ <= "9" Тогда
			ТолькоЦифры = ТолькоЦифры + Символ;
		КонецЕсли;

	КонецЦикла;

	Если ПустаяСтрока(ТолькоЦифры) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	|ГДЕ
	|	ХарактеристикиНоменклатуры.Код ПОДОБНО &КодХарактеристики";

	Запрос.УстановитьПараметр("КодХарактеристики", "%" + ТолькоЦифры + "%");

	Результат = Запрос.Выполнить().Выгрузить();

	Если Результат.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Результат[0].Ссылка;

КонецФункции

// Дозаполняет суммы наложенного платежа в уже загруженном заказе по повторно
// выгруженному с сайта файлу.
//
// Трогаем только то, что в заказе не заполнено (для суммы наложенного платежа -
// ещё и автоподстановку ПередЗаписью, где она равна сумме документа). Позиции,
// цены и всё остальное из повторного файла не применяются. Документ пишется без
// перепроведения.
//
Процедура ДозаполнитьСуммыНаложенногоПлатежаЗаказа(ЗаказПокупателя, СтруктураШапки)

	ОбъявленнаяСтоимость = ЧислоИзТегаЗаказа(СтруктураШапки, "cod_total");
	НаложенныйПлатеж     = ЧислоИзТегаЗаказа(СтруктураШапки, "cod_amount");
	Оплачено             = ЧислоИзТегаЗаказа(СтруктураШапки, "paid_amount");

	Если (ОбъявленнаяСтоимость = Неопределено ИЛИ ОбъявленнаяСтоимость <= 0)
		И (НаложенныйПлатеж = Неопределено ИЛИ НаложенныйПлатеж <= 0)
		И (Оплачено = Неопределено ИЛИ Оплачено <= 0) Тогда

		Возврат;

	КонецЕсли;

	ЗаказОбъект = ЗаказПокупателя.ПолучитьОбъект();

	Если ЗаказОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЕстьИзменения = Ложь;

	Если ОбъявленнаяСтоимость <> Неопределено И ОбъявленнаяСтоимость > 0
		И Не ЗначениеЗаполнено(ЗаказОбъект.ОценочнаяСтоимость) Тогда

		ЗаказОбъект.ОценочнаяСтоимость = ОбъявленнаяСтоимость;
		ЕстьИзменения = Истина;

	КонецЕсли;

	Если НаложенныйПлатеж <> Неопределено И НаложенныйПлатеж > 0
		И (Не ЗначениеЗаполнено(ЗаказОбъект.СуммаНоваяПочта)
			ИЛИ ЗаказОбъект.СуммаНоваяПочта = ЗаказОбъект.СуммаДокумента) Тогда

		ЗаказОбъект.СуммаНоваяПочта = НаложенныйПлатеж;
		ЕстьИзменения = Истина;

	КонецЕсли;

	Если Оплачено <> Неопределено И Оплачено > 0
		И Не ЗначениеЗаполнено(ЗаказОбъект.СуммаОплаты) Тогда

		ЗаказОбъект.СуммаОплаты = Оплачено;
		ЕстьИзменения = Истина;

	КонецЕсли;

	Если Не ЕстьИзменения Тогда
		Возврат;
	КонецЕсли;

	Попытка

		ЗаказОбъект.Записать();

		ЗаписьЖурналаРегистрации(
			"ЗагрузкаЗаказовССайта",
			УровеньЖурналаРегистрации.Информация,
			,
			ЗаказПокупателя,
			"Из повторного файла с сайта дозаполнены суммы наложенного платежа");

	Исключение

		ЗаписьЖурналаРегистрации(
			"ЗагрузкаЗаказовССайта",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			ЗаказПокупателя,
			"Не удалось дозаполнить суммы наложенного платежа: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

	КонецПопытки;

КонецПроцедуры

Процедура ЗагрузитьЗаказ(пПутьКФайлу) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЧтениеXML = Новый ЧтениеXML;
	
	ЧтениеXML.ОткрытьФайл(пПутьКФайлу);
	
	ПостроительDOM = Новый ПостроительDOM;
	
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	
	ЭлементDOM = ДокументDOM.ЭлементДокумента.ПервыйДочерний;
	
	ID = ЭлементDOM.Атрибуты.ПолучитьИменованныйЭлемент("id").Значение;
	ИсточникКод = ЭлементDOM.Атрибуты.ПолучитьИменованныйЭлемент("type").Значение;
	
	ЗаказПокупателя = Документы.ЗаказПокупателя.НайтиПоРеквизиту("НомерЗаказа2ССайта", ID);

	СтруктураШапки = Новый Структура;
	
	МассивСтрок = Новый Массив;
	
	Для Каждого ДочернийУзел Из ЭлементDOM.ДочерниеУзлы Цикл
		
		Если ДочернийУзел.ИмяЭлемента = "items" Или
			 ДочернийУзел.ИмяЭлемента = "sets" Тогда
			
			Для Каждого Строка Из ДочернийУзел.ДочерниеУзлы Цикл
				
				СтруктураСтроки = Новый Структура;
				
				Для Каждого Реквизит Из Строка.ДочерниеУзлы Цикл

					// Имя тега становится ключом структуры: тег с дефисом или
					// двоеточием уронил бы загрузку всего заказа. Сайт такие не
					// присылает, но терять из-за этого заказ нельзя.
					Попытка
						СтруктураСтроки.Вставить(Реквизит.ИмяЭлемента, Реквизит.ТекстовоеСодержимое);
					Исключение
					КонецПопытки;

				КонецЦикла;
				
				МассивСтрок.Добавить(СтруктураСтроки);
				
			КонецЦикла;
			
		Иначе

			Попытка
				СтруктураШапки.Вставить(ДочернийУзел.ИмяЭлемента, ДочернийУзел.ТекстовоеСодержимое);
			Исключение
			КонецПопытки;

		КонецЕсли;

	КонецЦикла;

	// Заказ уже загружен - повторную выгрузку с сайта (файл order-<id>.xml из
	// админки) целиком не применяем: в 1С заказ живёт своей жизнью, позиции и
	// цены менеджер мог уже поправить. Но суммы наложенного платежа, которые на
	// сайте могли проставить уже после ухода заказа в 1С, дозаполняем.
	Если ЗначениеЗаполнено(ЗаказПокупателя) И ЗначениеЗаполнено(ID) Тогда
		ДозаполнитьСуммыНаложенногоПлатежаЗаказа(ЗаказПокупателя, СтруктураШапки);
		Возврат;
	КонецЕсли;

	Если СтруктураШапки.Свойство("user_id") Тогда
		
		Если ПустаяСтрока(СтруктураШапки.user_id) Тогда
			
			Контрагент = Неопределено;
			
			Если СтруктураШапки.Свойство("phone") И
				 Не ПустаяСтрока(СтруктураШапки.phone)
				Тогда
				
				Контрагент = БИАС.НайтиКонтрагентаПоНомеруТелефона(СтруктураШапки.phone);
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Контрагент) Тогда
				
				Если СтруктураШапки.Свойство("name") И
					 Не ПустаяСтрока(СтруктураШапки.name) Тогда
					
					Родитель = Справочники.Контрагенты.НайтиПоКоду("000004795");
					
					Если СтруктураШапки.Свойство("user_type") И
						 Не ПустаяСтрока(СтруктураШапки.user_type) Тогда
						
						Родитель = Справочники.Контрагенты.НайтиПоКоду(СтруктураШапки.user_type);
						
					КонецЕсли;
					
					НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
					
					НовыйКонтрагент.Родитель                  = Родитель;
					НовыйКонтрагент.Наименование              = СокрЛП(СтруктураШапки.name);
					НовыйКонтрагент.НаименованиеПолное        = НовыйКонтрагент.Наименование;
					НовыйКонтрагент.Покупатель                = Истина;
