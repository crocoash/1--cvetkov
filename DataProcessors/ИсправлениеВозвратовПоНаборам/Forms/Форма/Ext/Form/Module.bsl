// Разовое исправление возвратов, оформленных на карточку набора (ростовки).
//
// Зачем. Набор ("набор комплект", "набор комплект ручной") продаётся своей карточкой,
// а отгружается комплектующей: реализация пишет в Номенклатуру комплектующую, а
// характеристику набора кладёт в колонку НК. Возврат же формировался по строкам заказа,
// то есть на сам набор и с пустым НК. В итоге в регистре Продажи плюс лежит под карточкой
// комплектующей и одним производителем, а минус - под карточкой набора и другим, и в отчёте
// "Продажи" группа набора уходит в минус без единой продажи (номенклатура "Дани": шесть
// возвратов и ни одной реализации).
//
// Заполнение возвратов исправлено в ОбщийМодульПодписокНаСобытия.СоздатьВозвратТоваров -
// новые документы строятся уже по реализации. Эта обработка чинит те, что успели накопиться.
//
// Что делает: находит проведённый возврат, у которого характеристика строки совпадает с НК
// строки проведённой реализации по той же сделке (то есть вернули набор, а отгружали
// комплектующую), заменяет его товары строками этой реализации и перепроводит.
// Склад приёмки и качество берутся из самого возврата - в реализации стоит склад отгрузки.
//
// Порядок работы: "Показать изменения" -> глазами по списку "было -> станет" -> "Записать".
// Само по себе нажатие первой кнопки ничего не меняет.
//
// Внимание: сейчас такие возвраты не приходуют товар на склад вообще - движений по
// ТоварыНаСкладах у них нет. После перепроведения приход появится, и остаток вырастет.
// Это правильно, если товар физически вернулся и его не оприходовали потом руками.
// Начинайте с одного свежего документа и смотрите, как встал остаток.

&НаКлиенте
Процедура ПоказатьИзменения(Команда)

	ПоказатьИзмененияНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПоказатьИзмененияНаСервере()

	Строки.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВозвратТовары.Ссылка КАК Возврат,
	|	ВозвратТовары.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТовары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТовары
	|		ПО ВозвратТовары.Ссылка.Сделка = РеализацияТовары.Ссылка.Сделка
	|			И ВозвратТовары.ХарактеристикаНоменклатуры = РеализацияТовары.НК
	|ГДЕ
	|	ВозвратТовары.Ссылка.Проведен
	|	И НЕ ВозвратТовары.Ссылка.ПометкаУдаления
	|	И ВозвратТовары.Ссылка.Дата МЕЖДУ &ДатаС И &ДатаПо
	|	И ВозвратТовары.НК = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка)
	|	И РеализацияТовары.Ссылка.Проведен
	|	И НЕ РеализацияТовары.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	// Пустая дата - без ограничения с этой стороны, а не «за 0001 год»
	Запрос.УстановитьПараметр("ДатаС",
		?(ЗначениеЗаполнено(ДатаНачала), НачалоДня(ДатаНачала), '00010101'));
	Запрос.УстановитьПараметр("ДатаПо",
		?(ЗначениеЗаполнено(ДатаОкончания), КонецДня(ДатаОкончания), '39991231235959'));

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		СтрокиОтгрузки = СтрокиРеализацийПоСделке(Выборка.Возврат.Сделка);

		Если СтрокиОтгрузки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.Возврат    = Выборка.Возврат;
		НоваяСтрока.Реализации = ДокументыСтрок(СтрокиОтгрузки);
		НоваяСтрока.Было       = ОписаниеТоваров(Выборка.Возврат.Товары);
		НоваяСтрока.Станет     = ОписаниеТоваров(СтрокиОтгрузки);

	КонецЦикла;

	Итого = "Возвратов, оформленных на карточку набора: " + Строки.Количество()
		+ Символы.ПС
		+ "Ничего ещё не записано - для записи нажмите «Записать».";

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИзменения(Команда)

	Если Строки.Количество() = 0 Тогда
		ПоказатьПредупреждение(,
			"Список пуст. Сначала нажмите «Показать изменения».");
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(
		Новый ОписаниеОповещения("ЗаписатьИзмененияЗавершение", ЭтотОбъект),
		"Перезаполнить и перепровести " + Строки.Количество() + " возвратов?"
			+ Символы.ПС
			+ "Документы перепроводятся задним числом: остатки и взаиморасчёты тех"
			+ " периодов пересчитаются. Обратно это только вручную.",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИзмененияЗавершение(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьИзмененияНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаписатьИзмененияНаСервере()

	Записано = 0;
	Ошибок   = 0;

	Для Каждого СтрокаСписка Из Строки Цикл

		Если Не ЗначениеЗаполнено(СтрокаСписка.Возврат) Тогда
			Продолжить;
		КонецЕсли;

		Попытка

			ДокументОбъект = СтрокаСписка.Возврат.ПолучитьОбъект();

			// Документ мог быть удалён другим сеансом, пока список висел на экране
			Если ДокументОбъект = Неопределено Тогда
				Ошибок = Ошибок + 1;
				Продолжить;
			КонецЕсли;

			СтрокиОтгрузки = СтрокиРеализацийПоСделке(ДокументОбъект.Сделка);

			Если СтрокиОтгрузки.Количество() = 0 Тогда
				Ошибок = Ошибок + 1;
				Продолжить;
			КонецЕсли;

			// Склад приёмки и качество - из самого возврата: в реализации стоит склад,
			// с которого отгружали, а товар вернули не обязательно туда же
			СкладПриемки     = Неопределено;
			КачествоВозврата = Неопределено;
			Если ДокументОбъект.Товары.Количество() > 0 Тогда
				СкладПриемки     = ДокументОбъект.Товары[0].Склад;
				КачествоВозврата = ДокументОбъект.Товары[0].Качество;
			КонецЕсли;

			ДокументОбъект.Товары.Очистить();
			ДокументОбъект.СоставНабора.Очистить();
			ДокументОбъект.СерийныеНомера.Очистить();
			ДокументОбъект.СерийныеНомераСоставНабора.Очистить();

			Для Каждого СтрокаОтгрузки Из СтрокиОтгрузки Цикл

				НоваяСтрока = ДокументОбъект.Товары.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтгрузки);

				Если ЗначениеЗаполнено(СкладПриемки) Тогда
					НоваяСтрока.Склад = СкладПриемки;
				КонецЕсли;

				Если КачествоВозврата <> Неопределено Тогда
					НоваяСтрока.Качество = КачествоВозврата;
				КонецЕсли;

			КонецЦикла;

			// Сумма строк реализации расходится с суммой заказа на копейки округления,
			// а при частичной отгрузке - и по существу: возвращаем то, что отгрузили
			ДокументОбъект.СуммаДокумента = ДокументОбъект.Товары.Итог("Сумма");

			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

			Записано = Записано + 1;

		Исключение

			Ошибок = Ошибок + 1;

			ЗаписьЖурналаРегистрации(
				"Возвраты по наборам.Исправление",
				УровеньЖурналаРегистрации.Ошибка,
				,
				СтрокаСписка.Возврат,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

	КонецЦикла;

	// Пересобираем список: после записи он должен опустеть, и это самая честная
	// проверка того, что исправление прошло. Итого выставляем ПОСЛЕ - иначе затрёт.
	ПоказатьИзмененияНаСервере();

	Итого = "Исправлено возвратов: " + Записано
		+ ?(Ошибок = 0, "", Символы.ПС + "Не удалось: " + Ошибок
			+ " (причина по каждому - в журнале регистрации,"
			+ " событие «Возвраты по наборам.Исправление»)")
		+ Символы.ПС
		+ "Осталось неисправленных: " + Строки.Количество();

КонецПроцедуры

// Строки проведённых реализаций по сделке - товар в том виде, в каком он реально отгружен:
// номенклатура-комплектующая, а характеристика набора в НК. Именно этой парой продажа легла
// в регистр Продажи, поэтому и возврат должен состоять из них.
//
// Возвращаемое значение: Массив строк табличных частей "Товары" реализаций.
//
&НаСервереБезКонтекста
Функция СтрокиРеализацийПоСделке(Сделка)

	СтрокиОтгрузки = Новый Массив;

	Если Не ЗначениеЗаполнено(Сделка) Тогда
		Возврат СтрокиОтгрузки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Сделка = &Сделка
	|	И РеализацияТоваровУслуг.Проведен
	|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	РеализацияТоваровУслуг.Дата";
	Запрос.УстановитьПараметр("Сделка", Сделка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого СтрокаРеализации Из Выборка.Ссылка.Товары Цикл
			СтрокиОтгрузки.Добавить(СтрокаРеализации);
		КонецЦикла;
	КонецЦикла;

	Возврат СтрокиОтгрузки;

КонецФункции

// Номера документов, которым принадлежат переданные строки, через запятую.
//
&НаСервереБезКонтекста
Функция ДокументыСтрок(СтрокиТабличныхЧастей)

	Текст = "";
	Учтенные = Новый Соответствие;

	Для Каждого СтрокаТЧ Из СтрокиТабличныхЧастей Цикл

		Документ = СтрокаТЧ.Ссылка;

		Если Учтенные[Документ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтенные.Вставить(Документ, Истина);

		Текст = Текст + ?(Текст = "", "", ", ") + СокрЛП(Документ);

	КонецЦикла;

	Возврат Текст;

КонецФункции

// Человекочитаемый состав строк: "Номенклатура (характеристика) x количество" через ";".
//
&НаСервереБезКонтекста
Функция ОписаниеТоваров(СтрокиТовары)

	Текст = "";

	Для Каждого СтрокаТЧ Из СтрокиТовары Цикл

		Текст = Текст + ?(Текст = "", "", "; ")
			+ СокрЛП(СтрокаТЧ.Номенклатура)
			+ " (" + СокрЛП(СтрокаТЧ.ХарактеристикаНоменклатуры) + ")"
			+ " x" + Формат(СтрокаТЧ.Количество, "ЧГ=0");

	КонецЦикла;

	Возврат Текст;

КонецФункции
