// РАСЦЕНКИ КРОЯ
//
// Расценка живёт в самом документе кроя, а не в карточке модели: одна и та же
// модель кроится в разные смены по разной цене, и цена задним числом меняться
// не должна. Отчёт производства за смену - это и есть один крой: проверено на
// данных, во всех документах ровно одна модель.

&НаКлиенте
Процедура ЗаполнитьМодели(Команда)

	ЗаполнитьКроиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРасценки(Команда)

	ЗаписатьРасценкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКроиНаСервере()

	Расценки.Очистить();
	Сообщение = "";

	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		Сообщение = "Укажите период.";
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Продукция.Ссылка КАК Документ,
	|	НАЧАЛОПЕРИОДА(Продукция.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	Продукция.Ссылка.РасценкаКроя КАК Расценка,
	|	МИНИМУМ(Продукция.Номенклатура) КАК Модель,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Продукция.Номенклатура) КАК Моделей,
	|	СУММА(Продукция.Количество) КАК Выкроено
	|ИЗ
	|	Документ.ОтчетПроизводстваЗаСмену.Продукция КАК Продукция
	|ГДЕ
	|	Продукция.Ссылка.Проведен
	|	И Продукция.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	Продукция.Ссылка,
	|	НАЧАЛОПЕРИОДА(Продукция.Ссылка.Дата, ДЕНЬ),
	|	Продукция.Ссылка.РасценкаКроя
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Документ";

	Выборка = Запрос.Выполнить().Выбрать();

	БезРасценки = 0;
	СМножествомМоделей = 0;

	Пока Выборка.Следующий() Цикл

		НоваяСтрока = Расценки.Добавить();
		НоваяСтрока.Документ = Выборка.Документ;
		НоваяСтрока.Дата = Выборка.Дата;
		НоваяСтрока.Модель = Выборка.Модель;
		НоваяСтрока.Выкроено = Выборка.Выкроено;
		НоваяСтрока.Расценка = Выборка.Расценка;
		НоваяСтрока.Сумма = Окр(Выборка.Выкроено * Выборка.Расценка, 2);

		Если НЕ ЗначениеЗаполнено(Выборка.Расценка) Тогда
			БезРасценки = БезРасценки + 1;
		КонецЕсли;

		// В шапке расценка одна на документ. Пока в каждом крое одна модель,
		// это верно; если однажды в документе окажется несколько - предупредим,
		// а не посчитаем молча по первой попавшейся.
		Если Выборка.Моделей > 1 Тогда
			СМножествомМоделей = СМножествомМоделей + 1;
		КонецЕсли;

	КонецЦикла;

	Если Расценки.Количество() = 0 Тогда
		Сообщение = "За период нет проведённых отчётов производства за смену.";
		Возврат;
	КонецЕсли;

	Сообщение = "Кроев за период: " + Формат(Расценки.Количество(), "ЧДЦ=0")
		+ ", из них без расценки: " + Формат(БезРасценки, "ЧДЦ=0")
		+ ". Проставьте расценку в колонке и нажмите ""Записать расценки"".";

	Если СМножествомМоделей > 0 Тогда
		Сообщение = Сообщение + " Внимание: в " + Формат(СМножествомМоделей, "ЧДЦ=0")
			+ " документах больше одной модели - расценка в них одна на весь документ,"
			+ " в колонке ""Модель"" показана только первая.";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьРасценкиНаСервере()

	Записано = 0;
	Ошибок = 0;
	ПоследняяОшибка = "";

	Для Каждого СтрокаРасценки Из Расценки Цикл

		Если НЕ ЗначениеЗаполнено(СтрокаРасценки.Документ) Тогда
			Продолжить;
		КонецЕсли;

		Попытка

			ДокументОбъект = СтрокаРасценки.Документ.ПолучитьОбъект();

			Если ДокументОбъект.РасценкаКроя = СтрокаРасценки.Расценка Тогда
				Продолжить;
			КонецЕсли;

			ДокументОбъект.РасценкаКроя = СтрокаРасценки.Расценка;

			// Именно Запись, а не Проведение: расценка на движения не влияет,
			// перепроводить крой ради неё незачем и рискованно.
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			Записано = Записано + 1;

			СтрокаРасценки.Сумма = Окр(СтрокаРасценки.Выкроено * СтрокаРасценки.Расценка, 2);

		Исключение

			Ошибок = Ошибок + 1;
			ПоследняяОшибка = ОписаниеОшибки();

		КонецПопытки;

	КонецЦикла;

	Если Записано = 0 И Ошибок = 0 Тогда
		Сообщение = "Менять нечего - расценки уже такие.";
	Иначе
		Сообщение = "Записано расценок: " + Формат(Записано, "ЧДЦ=0");
		Если Ошибок > 0 Тогда
			Сообщение = Сообщение + ". Не записалось: " + Формат(Ошибок, "ЧДЦ=0")
				+ ", последняя ошибка - " + ПоследняяОшибка;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
