&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаНачала = НачалоМесяца(ТекущаяДата());
	ДатаОкончания = НачалоДня(ТекущаяДата());

	ЗаполнитьТканиНаСервере();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ТКАНИ

&НаКлиенте
Процедура ЗавестиТкань(Команда)

	Если НЕ ЗначениеЗаполнено(НазваниеТкани) Тогда
		Сообщение = "Укажите название ткани.";
		Возврат;
	КонецЕсли;

	ЗавестиТканьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТкани(Команда)

	ЗаполнитьТканиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗавестиТканьНаСервере()

	Название = СокрЛП(НазваниеТкани);

	ВидТкань = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Ткань", Истина);
	Если ВидТкань.Пустая() Тогда
		Сообщение = "В справочнике видов номенклатуры нет вида ""Ткань"" - завести его нужно один раз вручную.";
		Возврат;
	КонецЕсли;

	// Метр по классификатору ОКЕИ. Единица измерения подчинена номенклатуре,
	// поэтому её нельзя создать заранее - только вместе с самой тканью.
	Метр = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("006");
	Если Метр.Пустая() Тогда
		Сообщение = "В классификаторе единиц измерения нет метра (код 006).";
		Возврат;
	КонецЕсли;

	Если НЕ Справочники.Номенклатура.НайтиПоНаименованию(Название, Истина).Пустая() Тогда
		Сообщение = "Номенклатура """ + Название + """ уже есть - заводить второй раз не нужно.";
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();

	Попытка

		Ткань = Справочники.Номенклатура.СоздатьЭлемент();
		Ткань.Наименование = Название;
		Ткань.НаименованиеПолное = Название;
		Ткань.ВидНоменклатуры = ВидТкань;
		Ткань.НоменклатурнаяГруппа = НоменклатурнаяГруппаТкани;
		Ткань.Родитель = ПапкаТканей;
		Ткань.Услуга = Ложь;
		Ткань.Набор = Ложь;
		Ткань.Комплект = Ложь;
		Ткань.ВестиУчетПоСериям = Ложь;
		Ткань.Записать();

		// Базовую единицу нельзя проставить до записи номенклатуры: у единицы
		// владелец - сама номенклатура, а ссылки на неё до записи ещё нет.
		Единица = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
		Единица.Владелец = Ткань.Ссылка;
		Единица.ЕдиницаПоКлассификатору = Метр;
		Единица.Наименование = "м";
		Единица.Коэффициент = 1;
		Единица.Записать();

		Ткань.БазоваяЕдиницаИзмерения = Единица.Ссылка;
		Ткань.ЕдиницаХраненияОстатков = Единица.Ссылка;
		Ткань.ЕдиницаДляОтчетов = Единица.Ссылка;
		Ткань.Записать();

		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		Сообщение = "Не удалось завести ткань: " + ОписаниеОшибки();
		Возврат;

	КонецПопытки;

	НазваниеТкани = "";
	Сообщение = "Заведена ткань """ + Название + """, базовая единица - метр."
		+ " Дальше её нужно оприходовать поступлением на склад ""Не пошит"" - крой списывает материалы"
		+ " со склада из шапки отчёта за смену.";

	ЗаполнитьТканиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТканиНаСервере()

	Ткани.Очистить();

	ВидТкань = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Ткань", Истина);
	Если ВидТкань.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидТкань", ВидТкань);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ткань,
	|	Номенклатура.БазоваяЕдиницаИзмерения КАК Единица
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ВидНоменклатуры = &ВидТкань
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И НЕ Номенклатура.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Ткани.Добавить();
		НоваяСтрока.Ткань = Выборка.Ткань;
		НоваяСтрока.Единица = СокрЛП(Строка(Выборка.Единица));
	КонецЦикла;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// РАСЦЕНКИ КРОЯ

&НаКлиенте
Процедура ЗаполнитьМодели(Команда)

	ЗаполнитьМоделиНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьРасценки(Команда)

	ЗаписатьРасценкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМоделиНаСервере()

	Расценки.Очистить();
	Сообщение = "";

	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		Сообщение = "Укажите период.";
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Продукция.Номенклатура КАК Модель,
	|	Продукция.Номенклатура.РасценкаКроя КАК Расценка,
	|	СУММА(Продукция.Количество) КАК Выкроено
	|ИЗ
	|	Документ.ОтчетПроизводстваЗаСмену.Продукция КАК Продукция
	|ГДЕ
	|	Продукция.Ссылка.Проведен
	|	И Продукция.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	Продукция.Номенклатура,
	|	Продукция.Номенклатура.РасценкаКроя
	|
	|УПОРЯДОЧИТЬ ПО
	|	Выкроено УБЫВ";

	Выборка = Запрос.Выполнить().Выбрать();

	БезРасценки = 0;

	Пока Выборка.Следующий() Цикл

		НоваяСтрока = Расценки.Добавить();
		НоваяСтрока.Модель = Выборка.Модель;
		НоваяСтрока.Выкроено = Выборка.Выкроено;
		НоваяСтрока.Расценка = Выборка.Расценка;

		Если НЕ ЗначениеЗаполнено(Выборка.Расценка) Тогда
			БезРасценки = БезРасценки + 1;
		КонецЕсли;

	КонецЦикла;

	Если Расценки.Количество() = 0 Тогда
		Сообщение = "За период нет проведённых отчётов производства за смену.";
	Иначе
		Сообщение = "Моделей за период: " + Формат(Расценки.Количество(), "ЧДЦ=0")
			+ ", из них без расценки: " + Формат(БезРасценки, "ЧДЦ=0")
			+ ". Проставьте расценку в колонке и нажмите ""Записать расценки"".";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьРасценкиНаСервере()

	Записано = 0;
	Ошибок = 0;
	ПоследняяОшибка = "";

	Для Каждого СтрокаРасценки Из Расценки Цикл

		Если НЕ ЗначениеЗаполнено(СтрокаРасценки.Модель) Тогда
			Продолжить;
		КонецЕсли;

		Попытка

			МодельОбъект = СтрокаРасценки.Модель.ПолучитьОбъект();

			// Записываем только изменённое: лишняя запись номенклатуры тянет
			// за собой обработчики и версии объекта.
			Если МодельОбъект.РасценкаКроя = СтрокаРасценки.Расценка Тогда
				Продолжить;
			КонецЕсли;

			МодельОбъект.РасценкаКроя = СтрокаРасценки.Расценка;
			МодельОбъект.Записать();
			Записано = Записано + 1;

		Исключение

			Ошибок = Ошибок + 1;
			ПоследняяОшибка = ОписаниеОшибки();

		КонецПопытки;

	КонецЦикла;

	Если Записано = 0 И Ошибок = 0 Тогда
		Сообщение = "Менять нечего - расценки уже такие.";
	Иначе
		Сообщение = "Записано расценок: " + Формат(Записано, "ЧДЦ=0");
		Если Ошибок > 0 Тогда
			Сообщение = Сообщение + ". Не записалось: " + Формат(Ошибок, "ЧДЦ=0")
				+ ", последняя ошибка - " + ПоследняяОшибка;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
