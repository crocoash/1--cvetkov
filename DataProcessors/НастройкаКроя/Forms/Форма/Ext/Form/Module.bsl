&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаНачала = НачалоМесяца(ТекущаяДата());
	ДатаОкончания = НачалоДня(ТекущаяДата());

	ЗаполнитьТканиНаСервере();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ТКАНИ

&НаКлиенте
Процедура ЗавестиТкань(Команда)

	Если НЕ ЗначениеЗаполнено(НазваниеТкани) Тогда
		Сообщение = "Укажите название ткани.";
		Возврат;
	КонецЕсли;

	ЗавестиТканьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТкани(Команда)

	ЗаполнитьТканиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗавестиТканьНаСервере()

	Название = СокрЛП(НазваниеТкани);

	ВидТкань = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Ткань", Истина);
	Если ВидТкань.Пустая() Тогда
		Сообщение = "В справочнике видов номенклатуры нет вида ""Ткань"" - завести его нужно один раз вручную.";
		Возврат;
	КонецЕсли;

	// Метр по классификатору ОКЕИ. Единица измерения подчинена номенклатуре,
	// поэтому её нельзя создать заранее - только вместе с самой тканью.
	Метр = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("006");
	Если Метр.Пустая() Тогда
		Сообщение = "В классификаторе единиц измерения нет метра (код 006).";
		Возврат;
	КонецЕсли;

	Если НЕ Справочники.Номенклатура.НайтиПоНаименованию(Название, Истина).Пустая() Тогда
		Сообщение = "Номенклатура """ + Название + """ уже есть - заводить второй раз не нужно.";
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();

	Попытка

		Ткань = Справочники.Номенклатура.СоздатьЭлемент();
		Ткань.Наименование = Название;
		Ткань.НаименованиеПолное = Название;
		Ткань.ВидНоменклатуры = ВидТкань;
		Ткань.НоменклатурнаяГруппа = НоменклатурнаяГруппаТкани;
		Ткань.Родитель = ПапкаТканей;
		Ткань.Услуга = Ложь;
		Ткань.Набор = Ложь;
		Ткань.Комплект = Ложь;
		Ткань.ВестиУчетПоСериям = Ложь;
		Ткань.Записать();

		// Базовую единицу нельзя проставить до записи номенклатуры: у единицы
		// владелец - сама номенклатура, а ссылки на неё до записи ещё нет.
		Единица = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
		Единица.Владелец = Ткань.Ссылка;
		Единица.ЕдиницаПоКлассификатору = Метр;
		Единица.Наименование = "м";
		Единица.Коэффициент = 1;
		Единица.Записать();

		Ткань.БазоваяЕдиницаИзмерения = Единица.Ссылка;
		Ткань.ЕдиницаХраненияОстатков = Единица.Ссылка;
		Ткань.ЕдиницаДляОтчетов = Единица.Ссылка;
		Ткань.Записать();

		ЗафиксироватьТранзакцию();

	Исключение

		ОтменитьТранзакцию();
		Сообщение = "Не удалось завести ткань: " + ОписаниеОшибки();
		Возврат;

	КонецПопытки;

	НазваниеТкани = "";
	Сообщение = "Заведена ткань """ + Название + """, базовая единица - метр."
		+ " Дальше её нужно оприходовать поступлением на склад ""Не пошит"" - крой списывает материалы"
		+ " со склада из шапки отчёта за смену.";

	ЗаполнитьТканиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТканиНаСервере()

	Ткани.Очистить();

	ВидТкань = Справочники.ВидыНоменклатуры.НайтиПоНаименованию("Ткань", Истина);
	Если ВидТкань.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидТкань", ВидТкань);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ткань,
	|	Номенклатура.БазоваяЕдиницаИзмерения КАК Единица
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ВидНоменклатуры = &ВидТкань
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И НЕ Номенклатура.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номенклатура.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Ткани.Добавить();
		НоваяСтрока.Ткань = Выборка.Ткань;
		НоваяСтрока.Единица = СокрЛП(Строка(Выборка.Единица));
	КонецЦикла;

КонецПроцедуры

