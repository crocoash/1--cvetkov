// Повторная передача оплат и возвратов в историю покупок на сайте.
//
// Файлы кладутся тем же кодом, что и обычная выгрузка при проведении документа:
// БИАС.ВыгрузитьДокументНаСайт - в каталог /assets/shop/sync/buy-history/<код клиента>/.
// При массовой перевыгрузке связанные документы контрагента (перепечатка накладных,
// обновление данных покупателя) не трогаются - только сами оплаты.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаОкончания = НачалоДня(ТекущаяДата());
	ДатаНачала    = НачалоМесяца(ДатаОкончания);

КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)

	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Сообщить("Не заполнен период.");
		Возврат;
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		Сообщить("Дата начала больше даты окончания.");
		Возврат;
	КонецЕсли;

	ЗаполнитьНаСервере();

	Сообщить("Подобрано документов: " + Формат(Оплаты.Количество(), "ЧН=0; ЧГ=0") + ".");

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПлатежноеПоручениеВходящее.Ссылка КАК Документ,
	|	ПлатежноеПоручениеВходящее.Дата КАК Дата,
	|	ПлатежноеПоручениеВходящее.Контрагент КАК Контрагент,
	|	ПлатежноеПоручениеВходящее.Контрагент.Код КАК КодКонтрагента,
	|	ПлатежноеПоручениеВходящее.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	|ГДЕ
	|	ПлатежноеПоручениеВходящее.Проведен
	|	И ПлатежноеПоручениеВходящее.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ПлатежноеПоручениеВходящее.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ОплатаПокупателя)
	|	И (&БезОтбораКонтрагента ИЛИ ПлатежноеПоручениеВходящее.Контрагент = &Контрагент)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Ссылка,
	|	ПриходныйКассовыйОрдер.Дата,
	|	ПриходныйКассовыйОрдер.Контрагент,
	|	ПриходныйКассовыйОрдер.Контрагент.Код,
	|	ПриходныйКассовыйОрдер.СуммаДокумента
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	ПриходныйКассовыйОрдер.Проведен
	|	И ПриходныйКассовыйОрдер.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ПриходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПКО.ОплатаПокупателя)
	|	И (&БезОтбораКонтрагента ИЛИ ПриходныйКассовыйОрдер.Контрагент = &Контрагент)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПлатежноеПоручениеИсходящее.Ссылка,
	|	ПлатежноеПоручениеИсходящее.Дата,
	|	ПлатежноеПоручениеИсходящее.Контрагент,
	|	ПлатежноеПоручениеИсходящее.Контрагент.Код,
	|	-ПлатежноеПоручениеИсходящее.СуммаДокумента
	|ИЗ
	|	Документ.ПлатежноеПоручениеИсходящее КАК ПлатежноеПоручениеИсходящее
	|ГДЕ
	|	ПлатежноеПоручениеИсходящее.Проведен
	|	И ПлатежноеПоручениеИсходящее.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ПлатежноеПоручениеИсходящее.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийППИсходящее.ВозвратДенежныхСредствПокупателю)
	|	И (&БезОтбораКонтрагента ИЛИ ПлатежноеПоручениеИсходящее.Контрагент = &Контрагент)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РасходныйКассовыйОрдер.Ссылка,
	|	РасходныйКассовыйОрдер.Дата,
	|	РасходныйКассовыйОрдер.Контрагент,
	|	РасходныйКассовыйОрдер.Контрагент.Код,
	|	-РасходныйКассовыйОрдер.СуммаДокумента
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|ГДЕ
	|	РасходныйКассовыйОрдер.Проведен
	|	И РасходныйКассовыйОрдер.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВозвратДенежныхСредствПокупателю)
	|	И (&БезОтбораКонтрагента ИЛИ РасходныйКассовыйОрдер.Контрагент = &Контрагент)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВозвратТоваровОтПокупателя.Ссылка,
	|	ВозвратТоваровОтПокупателя.Дата,
	|	ВозвратТоваровОтПокупателя.Контрагент,
	|	ВозвратТоваровОтПокупателя.Контрагент.Код,
	|	ВозвратТоваровОтПокупателя.СуммаДокумента
	|ИЗ
	|	Документ.ВозвратТоваровОтПокупателя КАК ВозвратТоваровОтПокупателя
	|ГДЕ
	|	ВозвратТоваровОтПокупателя.Проведен
	|	И ВозвратТоваровОтПокупателя.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И (&БезОтбораКонтрагента ИЛИ ВозвратТоваровОтПокупателя.Контрагент = &Контрагент)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Запрос.УстановитьПараметр("ДатаНачала"          , НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания"       , КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Контрагент"          , Контрагент);
	Запрос.УстановитьПараметр("БезОтбораКонтрагента", Не ЗначениеЗаполнено(Контрагент));

	Оплаты.Очистить();

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		НоваяСтрока = Оплаты.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.Пометка = Истина;

		// Без кода клиента файл уедет мимо папки клиента - такие строки не отмечаем.
		Если ПустаяСтрока(СокрЛП(Выборка.КодКонтрагента)) Тогда
			НоваяСтрока.Пометка   = Ложь;
			НоваяСтрока.Результат = "Нет кода контрагента - выгрузка невозможна";
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Отмечать = Истина;

	Для Каждого СтрокаТаблицы Из Оплаты Цикл
		Если СтрокаТаблицы.Пометка Тогда
			Отмечать = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаТаблицы Из Оплаты Цикл
		СтрокаТаблицы.Пометка = Отмечать И Не ПустаяСтрока(СокрЛП(СтрокаТаблицы.КодКонтрагента));
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПоставитьВОчередь(Команда)

	Поставлено = ПоставитьВОчередьНаСервере();

	Если Поставлено = 0 Тогда
		Сообщить("Не отмечено ни одного документа.");
		Возврат;
	КонецЕсли;

	Сообщить("Поставлено в очередь: " + Формат(Поставлено, "ЧН=0; ЧГ=0")
		+ ". Документы уйдут на сайт регламентным заданием ""Выгрузка на сайт (очередь заказов и оплат)"".");

КонецПроцедуры

&НаСервере
Функция ПоставитьВОчередьНаСервере()

	Поставлено = 0;

	Для Каждого СтрокаТаблицы Из Оплаты Цикл

		Если Не СтрокаТаблицы.Пометка Или Не ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
			Продолжить;
		КонецЕсли;

		БИАС.ЗарегистрироватьДокументКВыгрузкеНаСайт(СтрокаТаблицы.Документ);

		СтрокаТаблицы.Результат = "В очереди";
		Поставлено = Поставлено + 1;

	КонецЦикла;

	Возврат Поставлено;

КонецФункции

&НаКлиенте
Процедура ВыгрузитьСейчас(Команда)

	Результат = ВыгрузитьСейчасНаСервере();

	Если ЗначениеЗаполнено(Результат.ОшибкаПодключения) Тогда
		Сообщить("Не удалось подключиться к FTP сайта: " + Результат.ОшибкаПодключения);
		Возврат;
	КонецЕсли;

	Если Результат.Выгружено = 0 И Результат.Ошибок = 0 Тогда
		Сообщить("Не отмечено ни одного документа.");
		Возврат;
	КонецЕсли;

	Сообщить("Выгружено документов: " + Формат(Результат.Выгружено, "ЧН=0; ЧГ=0")
		+ ", с ошибками: " + Формат(Результат.Ошибок, "ЧН=0; ЧГ=0") + ".");

КонецПроцедуры

&НаСервере
Функция ВыгрузитьСейчасНаСервере()

	Результат = Новый Структура("Выгружено, Ошибок, ОшибкаПодключения", 0, 0, "");

	ЕстьОтмеченные = Ложь;

	Для Каждого СтрокаТаблицы Из Оплаты Цикл
		Если СтрокаТаблицы.Пометка И ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
			ЕстьОтмеченные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьОтмеченные Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		FTPСоединение = БИАС.ПодключитьсяКFTPСайта();
	Исключение
		Результат.ОшибкаПодключения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Для Каждого СтрокаТаблицы Из Оплаты Цикл

		Если Не СтрокаТаблицы.Пометка Или Не ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
			Продолжить;
		КонецЕсли;

		Попытка

			БИАС.ВыгрузитьДокументНаСайт(СтрокаТаблицы.Документ, FTPСоединение, Ложь);
			// Если документ ждал в очереди, повторять его уже не нужно.
			БИАС.ОтметитьВыгрузкуДокументаНаСайт(СтрокаТаблицы.Документ);

			СтрокаТаблицы.Результат = "Выгружен";
			Результат.Выгружено = Результат.Выгружено + 1;

		Исключение

			СтрокаТаблицы.Результат = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Результат.Ошибок = Результат.Ошибок + 1;

			ЗаписьЖурналаРегистрации(
				"ВыгрузкаДокументовНаСайт",
				УровеньЖурналаРегистрации.Ошибка,
				,
				СтрокаТаблицы.Документ,
				"Перевыгрузка документа не удалась: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПроверитьМусорНаFTP(Команда)

	Имена = НайтиМусорНаСервере();

	Если Имена.Количество() = 0 Тогда
		Сообщить("Мусорных файлов в корне buy-history не найдено.");
		Возврат;
	КонецЕсли;

	Сообщить("Найдено мусорных файлов: " + Формат(Имена.Количество(), "ЧН=0; ЧГ=0") + ".");

	Показано = 0;

	Для Каждого Имя Из Имена Цикл

		Сообщить("    " + Имя);
		Показано = Показано + 1;

		Если Показано >= 50 Тогда
			Сообщить("    ... остальные не выводились");
			Прервать;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция НайтиМусорНаСервере()

	Попытка
		Возврат БИАС.НайтиМусорныеФайлыИсторииПокупок();
	Исключение
		Сообщить("Не удалось прочитать каталог на FTP: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Новый Массив;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура УдалитьМусорНаFTP(Команда)

	Ответ = Вопрос(
		"Удалить с FTP сайта файлы вида invoice__<uid>_00010101000000.xml из корня buy-history?"
		+ Символы.ПС
		+ "Это остатки старого дефекта выгрузки: код клиента в них пустой, суммы нулевые, сайт их не показывает."
		+ Символы.ПС
		+ "Нормальные файлы в папках клиентов не затрагиваются.",
		РежимДиалогаВопрос.ДаНет);

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Результат = УдалитьМусорНаСервере();

	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Сообщить("Не удалось: " + Результат.Ошибка);
		Возврат;
	КонецЕсли;

	Сообщить("Удалено файлов: " + Формат(Результат.Удалено, "ЧН=0; ЧГ=0") + ".");

КонецПроцедуры

&НаСервере
Функция УдалитьМусорНаСервере()

	Результат = Новый Структура("Удалено, Ошибка", 0, "");

	Попытка
		Результат.Удалено = БИАС.УдалитьМусорныеФайлыИсторииПокупок();
	Исключение
		Результат.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ОплатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущиеДанные = Элементы.Оплаты.ТекущиеДанные;

	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда
		ОткрытьЗначение(ТекущиеДанные.Документ);
	КонецЕсли;

КонецПроцедуры
