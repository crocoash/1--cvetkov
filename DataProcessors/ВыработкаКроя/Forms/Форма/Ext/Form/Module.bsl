&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ДатаНачала = НачалоМесяца(ТекущаяДата());
	ДатаОкончания = НачалоДня(ТекущаяДата());

КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)

	СформироватьНаСервере();

КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()

	Строки.Очистить();
	Итого = "";

	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		Итого = "Укажите период.";
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаОкончания));

	ОтборПоЗакройщику = "";
	Если ЗначениеЗаполнено(Закройщик) Тогда
		ОтборПоЗакройщику = "И Продукция.Ссылка.Закройщик = &Закройщик";
		Запрос.УстановитьПараметр("Закройщик", Закройщик);
	КонецЕсли;

	Запрос.Текст = СтрЗаменить(ТекстЗапросаВыработки(), "//ОтборПоЗакройщику", ОтборПоЗакройщику);

	Результаты = Запрос.ВыполнитьПакет();
	ЗаполнитьРезультат(Результаты[3].Выгрузить(), Результаты[4].Выгрузить());

КонецПроцедуры

&НаСервере
Функция ТекстЗапросаВыработки()

	Возврат
	"ВЫБРАТЬ
	|	Продукция.Ссылка КАК Документ,
	|	НАЧАЛОПЕРИОДА(Продукция.Ссылка.Дата, ДЕНЬ) КАК Дата,
	|	Продукция.Ссылка.Закройщик КАК Закройщик,
	|	Продукция.Номенклатура КАК Модель,
	|	Продукция.Номенклатура.РасценкаКроя КАК Расценка,
	|	СУММА(Продукция.Количество) КАК Выкроено
	|ПОМЕСТИТЬ ВТПродукция
	|ИЗ
	|	Документ.ОтчетПроизводстваЗаСмену.Продукция КАК Продукция
	|ГДЕ
	|	Продукция.Ссылка.Проведен
	|	И Продукция.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	//ОтборПоЗакройщику
	|
	|СГРУППИРОВАТЬ ПО
	|	Продукция.Ссылка,
	|	НАЧАЛОПЕРИОДА(Продукция.Ссылка.Дата, ДЕНЬ),
	|	Продукция.Ссылка.Закройщик,
	|	Продукция.Номенклатура,
	|	Продукция.Номенклатура.РасценкаКроя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Материалы.Ссылка КАК Документ,
	|	Материалы.Номенклатура КАК Ткань,
	|	СУММА(Материалы.Количество) КАК Метров
	|ПОМЕСТИТЬ ВТМатериалы
	|ИЗ
	|	Документ.ОтчетПроизводстваЗаСмену.Материалы КАК Материалы
	|ГДЕ
	|	Материалы.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ВТПродукция.Документ КАК Документ
	|			ИЗ
	|				ВТПродукция КАК ВТПродукция)
	|
	|СГРУППИРОВАТЬ ПО
	|	Материалы.Ссылка,
	|	Материалы.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Ткань,
	|	СУММА(Товары.Сумма) КАК Сумма,
	|	СУММА(Товары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТЦеныЗакупки
	|ИЗ
	|	Документ.ПоступлениеТоваровУслуг.Товары КАК Товары
	|ГДЕ
	|	Товары.Ссылка.Проведен
	|	И Товары.Номенклатура В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ВТМатериалы.Ткань КАК Ткань
	|			ИЗ
	|				ВТМатериалы КАК ВТМатериалы)
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТПродукция.Документ КАК Документ,
	|	ВТПродукция.Дата КАК Дата,
	|	ВТПродукция.Закройщик КАК Закройщик,
	|	ВТПродукция.Модель КАК Модель,
	|	ВТПродукция.Расценка КАК Расценка,
	|	ВТПродукция.Выкроено КАК Выкроено
	|ИЗ
	|	ВТПродукция КАК ВТПродукция
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Документ,
	|	Модель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТМатериалы.Документ КАК Документ,
	|	СУММА(ВТМатериалы.Метров) КАК Метров,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(ВТЦеныЗакупки.Количество, 0) > 0
	|				ТОГДА ВТМатериалы.Метров * ВТЦеныЗакупки.Сумма / ВТЦеныЗакупки.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Стоимость
	|ИЗ
	|	ВТМатериалы КАК ВТМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТЦеныЗакупки КАК ВТЦеныЗакупки
	|		ПО ВТМатериалы.Ткань = ВТЦеныЗакупки.Ткань
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТМатериалы.Документ";

КонецФункции

&НаСервере
Процедура ЗаполнитьРезультат(ТаблицаПродукции, ТаблицаТкани)

	// Ткань списывается на документ целиком, без разбивки по моделям, - раскладываем
	// её на модели пропорционально количеству выкроенных штук.
	ТканьПоДокументам = Новый Соответствие;
	Для Каждого СтрокаТкани Из ТаблицаТкани Цикл
		ТканьПоДокументам.Вставить(СтрокаТкани.Документ, СтрокаТкани);
	КонецЦикла;

	ШтукВДокументе = Новый Соответствие;
	Для Каждого СтрокаПродукции Из ТаблицаПродукции Цикл
		Накоплено = ШтукВДокументе.Получить(СтрокаПродукции.Документ);
		Если Накоплено = Неопределено Тогда
			Накоплено = 0;
		КонецЕсли;
		ШтукВДокументе.Вставить(СтрокаПродукции.Документ, Накоплено + СтрокаПродукции.Выкроено);
	КонецЦикла;

	ВсегоШтук = 0;
	ВсегоМетров = 0;
	ВсегоТкань = 0;
	ВсегоОплата = 0;
	БезРасценки = 0;

	Для Каждого СтрокаПродукции Из ТаблицаПродукции Цикл

		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.Дата = СтрокаПродукции.Дата;
		НоваяСтрока.Документ = СтрокаПродукции.Документ;
		НоваяСтрока.Закройщик = СтрокаПродукции.Закройщик;
		НоваяСтрока.Модель = СтрокаПродукции.Модель;
		НоваяСтрока.Выкроено = СтрокаПродукции.Выкроено;
		НоваяСтрока.Расценка = СтрокаПродукции.Расценка;
		НоваяСтрока.ОплатаКроя = Окр(СтрокаПродукции.Выкроено * СтрокаПродукции.Расценка, 2);

		ВсегоПоДокументу = ШтукВДокументе.Получить(СтрокаПродукции.Документ);
		ДанныеТкани = ТканьПоДокументам.Получить(СтрокаПродукции.Документ);
		Если ДанныеТкани <> Неопределено И ВсегоПоДокументу > 0 Тогда
			Доля = СтрокаПродукции.Выкроено / ВсегоПоДокументу;
			НоваяСтрока.ТканьМетров = Окр(ДанныеТкани.Метров * Доля, 3);
			НоваяСтрока.СтоимостьТкани = Окр(ДанныеТкани.Стоимость * Доля, 2);
		КонецЕсли;

		Если СтрокаПродукции.Выкроено > 0 Тогда
			НоваяСтрока.СебестоимостьЕдиницы =
				Окр((НоваяСтрока.ОплатаКроя + НоваяСтрока.СтоимостьТкани) / СтрокаПродукции.Выкроено, 2);
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(СтрокаПродукции.Расценка) Тогда
			БезРасценки = БезРасценки + СтрокаПродукции.Выкроено;
		КонецЕсли;

		ВсегоШтук = ВсегоШтук + СтрокаПродукции.Выкроено;
		ВсегоОплата = ВсегоОплата + НоваяСтрока.ОплатаКроя;
		ВсегоМетров = ВсегоМетров + НоваяСтрока.ТканьМетров;
		ВсегоТкань = ВсегоТкань + НоваяСтрока.СтоимостьТкани;

	КонецЦикла;

	Если Строки.Количество() = 0 Тогда
		Итого = "За период нет проведённых отчётов производства за смену.";
		Возврат;
	КонецЕсли;

	СебестоимостьШтуки = 0;
	Если ВсегоШтук > 0 Тогда
		СебестоимостьШтуки = Окр((ВсегоОплата + ВсегоТкань) / ВсегоШтук, 2);
	КонецЕсли;

	ТекстИтога = "Выкроено " + Формат(ВсегоШтук, "ЧДЦ=0; ЧГ=3") + " шт"
		+ "; ткани " + Формат(ВсегоМетров, "ЧДЦ=1; ЧГ=3") + " м на " + Формат(ВсегоТкань, "ЧДЦ=2; ЧГ=3") + " грн"
		+ "; закройщику " + Формат(ВсегоОплата, "ЧДЦ=2; ЧГ=3") + " грн"
		+ "; себестоимость кроя " + Формат(СебестоимостьШтуки, "ЧДЦ=2") + " грн/шт";

	// Пустые места честнее показать, чем молча посчитать их нулём.
	Если БезРасценки > 0 Тогда
		ТекстИтога = ТекстИтога + ". Без расценки кроя: " + Формат(БезРасценки, "ЧДЦ=0; ЧГ=3") + " шт";
	КонецЕсли;
	Если ВсегоМетров > 0 И ВсегоТкань = 0 Тогда
		ТекстИтога = ТекстИтога + ". Цена ткани не найдена - не было проведённых поступлений этой номенклатуры";
	КонецЕсли;

	Итого = ТекстИтога;

КонецПроцедуры
