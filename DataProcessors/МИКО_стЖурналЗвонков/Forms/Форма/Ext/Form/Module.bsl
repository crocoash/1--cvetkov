&НаКлиенте
Процедура СоздатьДополнительныйСтикер(Команда)
	ТекущиеДанные = Элементы.ТаблицаИстории.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
	  	Возврат;
	КонецЕсли; 
	
	Вызов = Новый Структура("НомерТелефона,Партнер,Абонент,Входящий,ЕстьЗапись,recordingfile");
	Если ЗаполнитьПоДокументуИсторииЗвонков(Вызов, ТекущиеДанные.Звонок) = Ложь Тогда
		// Внутренний вызов.
		Возврат;
	КонецЕсли;

	// заполняем реквизиты
	Настройки = Новый Структура; 
	Настройки.Вставить("Входящий",				Вызов.Входящий);
	Настройки.Вставить("LongUniqueID",			ТекущиеДанные.ИдентификаторЗвонка);
	Настройки.Вставить("UniqueID",				ТекущиеДанные.ИдентификаторЗвонка);
	Настройки.Вставить("НомерТелефона",			Вызов.НомерТелефона);
	Настройки.Вставить("Партнер",				Вызов.Партнер);
	Настройки.Вставить("Абонент",				Вызов.Абонент);
	Настройки.Вставить("Пропущенный",			Ложь);
	Настройки.Вставить("ЗвонокЗавершен",		Истина);
	Настройки.Вставить("ОбъектВызова",			ПолучитьСсылкуНаСобытие(ТекущиеДанные.Звонок));
	Настройки.Вставить("ВремяЗвонка",			ТекущаяДата());
	Настройки.Вставить("Длительность",			ТекущиеДанные.ДлительностьРазговора);
	Настройки.Вставить("ЕстьЗапись",			Ложь);               
	Настройки.Вставить("ИзИстории",				Истина);
	
	Настройки.Вставить("НЕФиксироватьIDЗвонка",	Истина);
	Оповестить("СоздатьДополнительныйСтикер", Настройки, ЭтаФорма);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрикрепитьСобытиеКЗвонку(ЗвонокСсылка, СобытиеСсылка)

	РезульатЗапроса  = МИКО_стОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗвонокСсылка, "ДокументыСобытие");
	ДокументыСобытие = РезульатЗапроса.Выгрузить();
	
	Если ДокументыСобытие.Найти(СобытиеСсылка, "Событие") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	ДокументОбъект = ЗвонокСсылка.ПолучитьОбъект();
	СобытиеСтр 			= ДокументОбъект.ДокументыСобытие.Добавить();
	СобытиеСтр.Событие 	= СобытиеСсылка;
	Попытка
		ДокументОбъект.Записать();
	Исключение
		Возврат Ложь;		
	КонецПопытки;
	
	Возврат Истина;	
КонецФункции // ПрикрепитьСобытиеКЗвонку()

&НаСервере
Функция ЗаполнитьВладельцаНомера(врПараметры)

	Для каждого ТекСтрока Из Объект.ТаблицаИстории Цикл
		ТекСсылка = ТекСтрока.Звонок;
		Если ТекСсылка.Dst <> врПараметры.Номер И ТекСсылка.Src <> врПараметры.Номер Тогда
			Продолжить;		
		КонецЕсли; 
		
		врОбъект = ТекСсылка.ПолучитьОбъект();
		Если врОбъект.Dst = врПараметры.Номер Тогда
			Если ЗначениеЗаполнено(врПараметры.Абонент) Тогда
			 	врОбъект.Dst_Ссылка = врПараметры.Абонент;
				врОбъект.Dst_Владелец_Ссылка = врПараметры.Организация;
			Иначе
			 	врОбъект.Dst_Ссылка = врПараметры.Организация;
			КонецЕсли;
			ТекСтрока.КонтактКому = врПараметры.Организация;
		КонецЕсли; 
		Если врОбъект.Src = врПараметры.Номер Тогда
			Если ЗначениеЗаполнено(врПараметры.Абонент) Тогда
			 	врОбъект.Src_Ссылка = врПараметры.Абонент;
				врОбъект.Src_Владелец_Ссылка = врПараметры.Организация;
			Иначе
			 	врОбъект.Src_Ссылка  = врПараметры.Организация;
			КонецЕсли;
			ТекСтрока.КонтактКто = врПараметры.Организация;
		КонецЕсли; 
		
		Попытка
			врОбъект.Записать();
		Исключение
		КонецПопытки; 
	КонецЦикла; 
КонецФункции // ЗаполнитьВладельцаНомера()

