Процедура СтрокаПоискаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ИспользоватьПолнотекстовыйПоиск И ЗначениеЗаполнено(Текст) Тогда
		ДанныеВыбора = Новый СписокЗначений;
	    ДанныеВыбора.Добавить("МИКО_ПолнотекстовыйПоиск"+СокрЛП(Текст), "Искать: " + СокрЛП(Текст));
		Если МИКО_опЗаписьКИ.ЭтоЧисловойНомер(Текст) Тогда
			ДанныеВыбора.Добавить(Текст, "Номер телефона: "+Текст);
		Иначе
			ДанныеВыбора.Добавить(Текст, "Skype: "+Текст);
		КонецЕсли; 
	Иначе	
		ДанныеВыбора = ПолучитьОбъектыПоиска(СокрЛП(Текст), ТекстЗапросаОтбора);
	КонецЕсли; 		
	
КонецПроцедуры

// Выполняет поиск по объектам с наименованием
//
&НаСервереБезКонтекста 
Функция ПолучитьОбъектыПоиска(СтрПоиска, ТекстЗапросаОтбора)

	СписокОтбора = Новый СписокЗначений;
	Если СтрДлина(СтрПоиска)<3 Тогда
		Возврат СписокОтбора; 	
	КонецЕсли; 
	
	ТекстЗапроса = ТекстЗапросаОтбора;
	
	СтрокаНомерТелефона = СтрЗаменить(СтрПоиска,"""","""""");
	
	Запрос = Новый Запрос;	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Наименование", "%"+СтрПоиска+"%");			   
	
	Результат = Запрос.Выполнить();
	РезультатТЗ = Результат.Выгрузить();
	
	Для каждого ВариантОтбора Из РезультатТЗ Цикл
	 
		СписокОтбора.Добавить(ВариантОтбора.Ссылка, ВариантОтбора.Представление+": "+ВариантОтбора.Наименование);
	
	КонецЦикла; 
	
	Если МИКО_опЗаписьКИ.ЭтоЧисловойНомер(СтрПоиска) Тогда
		// Поиск по номеру телефона.
		СписокОтбора.Добавить(СтрПоиска, "Номер телефона: "+СтрПоиска);
	Иначе	
		// Это не номер телефона. Возможно skype или наименование
		Если ВСловеТолькоЛатиница(СтрПоиска) Тогда
			СписокОтбора.Добавить(СтрПоиска,"Skype: "+СтрПоиска);
		КонецЕсли;
	КонецЕсли; 
		
	Возврат СписокОтбора;

КонецФункции // ПолучитьОбъектыПоиска()

// Возвращает соответствие со списком справочников, в которых хранится контактная информация, и их приоритет.
// Ключ - приоритет, значение - имя объекта метаданных.
// 
&НаСервереБезКонтекста
Функция ПолучитьОбъектыКИ()

	СоответствиеОбъектов = Новый Соответствие;
	
	Если Метаданные.Справочники.Найти("Пользователи") <> Неопределено Тогда
		СтруктураОбъекта = Новый Структура("Представление, Имя");
		СтруктураОбъекта.Представление	= "Пользователь";
		СтруктураОбъекта.Имя			= "Пользователи";
		
		СоответствиеОбъектов.Вставить(1, СтруктураОбъекта);
	ИначеЕсли Метаданные.Справочники.Найти("Организации") <> Неопределено Тогда
		СтруктураОбъекта = Новый Структура("Представление, Имя");
		СтруктураОбъекта.Представление	= "Организация";
		СтруктураОбъекта.Имя			= "Организации";
		
		СоответствиеОбъектов.Вставить(5, СтруктураОбъекта);
	КонецЕсли;
	Если Метаданные.Справочники.Найти("Партнеры") <> Неопределено Тогда
		СтруктураОбъекта = Новый Структура("Представление, Имя");
		СтруктураОбъекта.Представление	= "Партнер";
		СтруктураОбъекта.Имя			= "Партнеры";
		
		СоответствиеОбъектов.Вставить(2, СтруктураОбъекта);
	КонецЕсли;
	Если Метаданные.Справочники.Найти("Контрагенты") <> Неопределено Тогда
		СтруктураОбъекта = Новый Структура("Представление, Имя");
		СтруктураОбъекта.Представление	= "Контрагент";
		СтруктураОбъекта.Имя			= "Контрагенты";
		
		СоответствиеОбъектов.Вставить(3, СтруктураОбъекта);
	КонецЕсли;	
	Если Метаданные.Справочники.Найти("КонтактныеЛицаКонтрагентов") <> Неопределено Тогда
		СтруктураОбъекта = Новый Структура("Представление, Имя");
		СтруктураОбъекта.Представление	= "Контактное лицо";
		СтруктураОбъекта.Имя			= "КонтактныеЛицаКонтрагентов";
		
		СоответствиеОбъектов.Вставить(6, СтруктураОбъекта);
	КонецЕсли;	
	Если Метаданные.Справочники.Найти("КонтактныеЛицаПартнеров") <> Неопределено Тогда
		СтруктураОбъекта = Новый Структура("Представление, Имя");
		СтруктураОбъекта.Представление	= "Контактное лицо";
		СтруктураОбъекта.Имя			= "КонтактныеЛицаПартнеров";
		
		СоответствиеОбъектов.Вставить(4, СтруктураОбъекта);
	КонецЕсли;	
	Если Метаданные.Справочники.Найти("Корреспонденты") <> Неопределено Тогда
		СтруктураОбъекта = Новый Структура("Представление, Имя");
		СтруктураОбъекта.Представление	= "Корреспондент";
		СтруктураОбъекта.Имя			= "Корреспонденты";
		
		СоответствиеОбъектов.Вставить(7, СтруктураОбъекта);
	КонецЕсли;	
	Если Метаданные.Справочники.Найти("ФизическиеЛица") <> Неопределено Тогда
		СтруктураОбъекта = Новый Структура("Представление, Имя");
		СтруктураОбъекта.Представление	= "Физлицо";
		СтруктураОбъекта.Имя			= "ФизическиеЛица";
		
		СоответствиеОбъектов.Вставить(21, СтруктураОбъекта);
	КонецЕсли; 

	Возврат СоответствиеОбъектов;
	
КонецФункции // ПолучитьОбъектыКИ()

// На основании объектов метаданных формирует текст запроса для универсального отбора.
// 
&НаСервереБезКонтекста
Функция ПолучитьТекстЗапросаОтбора()
	
	ТекстЗапроса = "";
	
	ШаблонЗапроса = 
		"ВЫБРАТЬ {РАЗРЕШЕННЫЕ} ПЕРВЫЕ 3
		|	{Имя}.Ссылка,
		|	{Имя}.Наименование КАК Наименование,
		|	{Вес} КАК Вес,
		|	{Представление} КАК Представление
		|//{ПОМЕСТИТЬ} ВТ
		|ИЗ
		|	Справочник.{Имя} КАК {Имя}
		|ГДЕ
		|	 {Имя}.Наименование ПОДОБНО &Наименование";
				   
				   
	СоответствиеОбъектовКонтактов = ПолучитьОбъектыКИ();
	
	Для каждого ОбъектКИ Из СоответствиеОбъектовКонтактов Цикл
	
		Если Не ТекстЗапроса = "" Тогда
		  	ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС;
			врЗапрос = СтрЗаменить(ШаблонЗапроса, "{РАЗРЕШЕННЫЕ}", "");
		Иначе
			врЗапрос = СтрЗаменить(ШаблонЗапроса, "{РАЗРЕШЕННЫЕ}", "РАЗРЕШЕННЫЕ");
			врЗапрос = СтрЗаменить(врЗапрос, "//{ПОМЕСТИТЬ}", "ПОМЕСТИТЬ");
		КонецЕсли; 
		врЗапрос = СтрЗаменить(врЗапрос, "{Имя}", 			""+ОбъектКИ.Значение.Имя);
		врЗапрос = СтрЗаменить(врЗапрос, "{Вес}", 			""+ОбъектКИ.Ключ);
		врЗапрос = СтрЗаменить(врЗапрос, "{Представление}", """"+ОбъектКИ.Значение.Представление+"""");
		
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + врЗапрос + Символы.ПС;
		
	КонецЦикла; 			   
	
	// Дополним запрос для отбора по номеру телефона.
	
	Если НЕ ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Возврат "";
	КонецЕсли; 
	
	ТекстЗапроса = ТекстЗапроса + Символы.ПС + ";
											   |ВЫБРАТЬ
	                                           |	ВТ.Ссылка,
	                                           |	ВТ.Наименование,
	                                           |	ВТ.Вес,
											   |	ВТ.Представление
	                                           |ИЗ
	                                           |	ВТ КАК ВТ
											   |
											   |УПОРЯДОЧИТЬ ПО Вес ВОЗР";
	
	Возврат ТекстЗапроса;
	
КонецФункции // ПолучитьТекстЗапросаОтбора()

&НаКлиенте
Процедура СтрокаПоискаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	УстановитьЭлементОтбора(ВыбранноеЗначение);
	ВыбранноеЗначение = "";
	
КонецПроцедуры

// Устанавливает элемент отбора по заполненному полю поиска.
// 
&НаКлиенте
Процедура УстановитьЭлементОтбора(ЭлементОтбора=Неопределено)
	
	Если НЕ ЗначениеЗаполнено(ЭлементОтбора) Тогда
		Возврат;
	КонецЕсли; 

	сч = 1;
	Пока Элементы.Найти("дСтрокаОтбора" + Формат(сч,"ЧГ=")) <> Неопределено Цикл
		id = Формат(сч,"ЧГ="); сч = сч + 1;
		Если ЭтаФорма["ЭлементОтбора" + id] = ЭлементОтбора Тогда
			// Такой отбор уже установлен.
			Возврат;
		КонецЕсли; 
	КонецЦикла; 

	ТипЭлемента = ТипЗнч(ЭлементОтбора);
	ПредставлениеОтбора = ПолучитьПредставлениеОтбора(ЭлементОтбора);
	
	сч = 1;
	Пока Элементы.Найти("дСтрокаОтбора" + Формат(сч,"ЧГ=")) <> Неопределено Цикл
		id = Формат(сч,"ЧГ=");
		сч = сч + 1;
		Если ЗначениеЗаполнено(ЭтаФорма["ЭлементОтбора"+id]) Тогда
		 	Продолжить;
		КонецЕсли; 
		ЭтаФорма["ЭлементОтбора"+id] = ЭлементОтбора;
		// Установим представление.
		Элементы["дСтрокаОтбора"+id].Заголовок = ПредставлениеОтбора;
		Элементы["дСтрокаОтбора"+id].Видимость = Истина;
		ОбновитьНаСервере();
		Прервать;
	КонецЦикла; 

	Элементы.грОтбора.Видимость = Истина;
	
КонецПроцедуры // УстановитьЭлементОтбора()
&НаКлиенте
Функция ПолучитьПредставлениеОтбора(ОбъектОтбора)

	Если ОбъектОтбора = Неопределено Тогда
		Возврат "";
	КонецЕсли; 
	
	ТипОтбора = СписокТиповОбъектовОтбора.НайтиПоЗначению(ТипЗнч(ОбъектОтбора));
	
	Если ТипОтбора <> Неопределено Тогда
		Возврат ТипОтбора.Представление+": " + ОбъектОтбора;
	КонецЕсли; 

	Если ТипЗнч(ОбъектОтбора) = Тип("Строка") Тогда		
	    КомандаПоиска = "МИКО_ПолнотекстовыйПоиск";
		Если Найти(ОбъектОтбора, КомандаПоиска)>0 Тогда
		 	Значение = СтрЗаменить(ОбъектОтбора,КомандаПоиска, "");
			Возврат "(п.п.)Наименование: " + Значение;			
		КонецЕсли; 
		
		Если МИКО_опЗаписьКИ.ЭтоЧисловойНомер(ОбъектОтбора) Тогда
			Возврат "Номер телефона: " + ОбъектОтбора;
		КонецЕсли; 
		
		Если ВСловеТолькоЛатиница(ОбъектОтбора) Тогда
			Возврат "Skype: " + ОбъектОтбора;
		КонецЕсли; 
		
		Возврат "Наименование: " + ОбъектОтбора;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции // ПолучитьПредставлениеОтбора()
&НаКлиенте
Процедура дСтрокаОтбора1Нажатие(Элемент)
	ДействиеСтрокаОтбора(Элемент);
КонецПроцедуры

// Обрабатывает нажатие на гиперссылку строки отбора
&НаКлиенте
Процедура ДействиеСтрокаОтбора(ЭлементФормы)

	ЭлементыМеню = Новый СписокЗначений();
	Если НЕ ЗначениеОтбораСтрока(ЭлементФормы) Тогда
		ЭлементыМеню.Добавить("ОткрытьКарточку",  "Открыть карточку",,БиблиотекаКартинок.Найти);
	КонецЕсли; 
	ЭлементыМеню.Добавить("Очистить", "Удалить текущий отбор",,БиблиотекаКартинок.Удалить);
	// ЭлементыМеню.Добавить("ОчиститьВсеОтборы", "Удалить все отборы",,БиблиотекаКартинок.Удалить);
		
	Если (ВерсияПлатформы = "8.2" ИЛИ ИспользоватьРежимМодальности) Тогда
		
		ВыбранныйЭлемент = ВыбратьИзМеню(ЭлементыМеню, ЭлементФормы);
		
		Если ВыбранныйЭлемент = Неопределено Тогда
			Возврат;
		ИначеЕсли ВыбранныйЭлемент.Значение = "Очистить" Тогда
			УстановитьЗначенияПоУмолчанию(ЭлементФормы);
		ИначеЕсли ВыбранныйЭлемент.Значение = "ОчиститьВсеОтборы" Тогда
			УстановитьЗначенияПоУмолчанию();	
		ИначеЕсли ВыбранныйЭлемент.Значение = "ОткрытьКарточку" Тогда
    		ИмяРеквизита = СтрЗаменить(ЭлементФормы.Имя, "дСтрокаОтбора", "ЭлементОтбора");
			ОткрытьЗначениеКлиент(ЭтаФорма[ИмяРеквизита]);
		Иначе
			Возврат;
		КонецЕсли;
		
	Иначе
		
		Выполнить("ПоказатьВыборИзМеню(
			|Новый ОписаниеОповещения(""ПослеВыбораЭлементаМеню"", ЭтаФорма,Новый Структура(""ЭлементФормы"",ЭлементФормы)),
			|ЭлементыМеню,
			|ЭлементФормы)");
			
	КонецЕсли;

КонецПроцедуры // ДействиеСтрокаОтбора()

&НаКлиенте
Процедура УстановитьЗначенияПоУмолчанию(ЭлементФормы = Неопределено, ОбновитьНаСервере=Истина)

	Если ЭлементФормы = Неопределено Тогда
		// Уберем видимость у группы отбора
		Элементы.грОтбора.Видимость = Ложь;
		сч = 1;
		Пока Элементы.Найти("дСтрокаОтбора" + Формат(сч,"ЧГ=")) <> Неопределено Цикл
			id = Формат(сч,"ЧГ="); сч = сч + 1;
			УстановитьЗначениеЭлементаПоУмолчанию(Элементы["дСтрокаОтбора" + id]);
		КонецЦикла; 
		Если ОбновитьНаСервере=Истина Тогда
			ОбновитьНаСервере();
		КонецЕсли; 
		Возврат;
	КонецЕсли; 
	
	УстановитьЗначениеЭлементаПоУмолчанию(ЭлементФормы);
	
	Если ОбновитьНаСервере=Истина Тогда
		ОбновитьНаСервере();
	КонецЕсли; 
	
	сч = 1; ОтборУстановлен = Ложь;
	Пока Элементы.Найти("дСтрокаОтбора" + Формат(сч,"ЧГ=")) <> Неопределено Цикл
		id = Формат(сч,"ЧГ="); сч = сч + 1;
		Если ЗначениеЗаполнено(ЭтаФорма["ЭлементОтбора"+id]) Тогда
		 	ОтборУстановлен = Истина;
			Прервать;
		КонецЕсли; 
	КонецЦикла; 
	Элементы.грОтбора.Видимость = ОтборУстановлен;
	
КонецПроцедуры // УстановитьЗначенияПоУмолчанию()

&НаКлиенте
Процедура УстановитьЗначениеЭлементаПоУмолчанию(ЭлементФормы)

    ИмяРеквизита = СтрЗаменить(ЭлементФормы.Имя, "дСтрокаОтбора", "ЭлементОтбора");
	Если ОбъектОтбора = ЭтаФорма[ИмяРеквизита] Тогда
		ОбъектОтбора = Неопределено;	
	КонецЕсли; 
	ЭтаФорма[ИмяРеквизита] = Неопределено;
	
	ЭлементФормы.Видимость = Ложь;
	ЭлементФормы.Заголовок = СтрЗаменить(ЭлементФормы.Имя, "дСтрокаОтбора", "#Отбор");

КонецПроцедуры // УстановитьЗначениеЭлементаПоУмолчанию()
// Проверяет, является ли значение отбора строкой.
//
&НаКлиенте
Функция ЗначениеОтбораСтрока(ЭлементФормы)

    ИмяРеквизита = СтрЗаменить(ЭлементФормы.Имя, "дСтрокаОтбора", "ЭлементОтбора");
	Если ТипЗнч(ЭтаФорма[ИмяРеквизита]) = Тип("Строка") Тогда
		Возврат Истина;	
	КонецЕсли; 
	
	Возврат Ложь;	
КонецФункции // ЗначениеОтбораНеСтрока()
&НаКлиенте
Процедура ПослеВыбораЭлементаМеню(ВыбранныйЭлемент, Параметры) Экспорт
	
	
	Элемент = Неопределено;
	
	Если ВыбранныйЭлемент = Неопределено Тогда
			Возврат;
	ИначеЕсли ВыбранныйЭлемент.Значение = "Очистить" И Параметры.Свойство("ЭлементФормы", Элемент) Тогда
		УстановитьЗначенияПоУмолчанию(Элемент);
	ИначеЕсли ВыбранныйЭлемент.Значение = "ОткрытьКарточку" И Параметры.Свойство("ЭлементФормы", Элемент) Тогда
		ИмяРеквизита = СтрЗаменить(Элемент.Имя, "дСтрокаОтбора", "ЭлементОтбора");
		ОткрытьЗначениеКлиент(ЭтаФорма[ИмяРеквизита]);
	ИначеЕсли ВыбранныйЭлемент.Значение = "ОчиститьВсеОтборы" И Параметры.Свойство("ЭлементФормы", Элемент) Тогда

		УстановитьЗначенияПоУмолчанию();	
	КонецЕсли;
	
КонецПроцедуры

// Возвращает структуру с элементами отбора.
//
&НаСервере
Функция ПолучитьОбъектыОтбора()

	СтруктураОтбора 	= Новый Структура("СправочникиОтбор, НомерОтбор, НаименованиеОтбор, SkypeОтбор");
	МассивСпрОтбор 		= Новый Массив;
	МассивТелОтбор		= Новый Массив;
	МассивНаимОтбор		= Новый Массив;
	МассивSkypeОтбор	= Новый Массив;
	
	сч = 1;
	Пока Элементы.Найти("дСтрокаОтбора" + Формат(сч,"ЧГ=")) <> Неопределено Цикл
		id = Формат(сч,"ЧГ="); сч = сч + 1;
		ЗаполнитьМассивОтбора(ЭтаФорма["ЭлементОтбора"+id], МассивСпрОтбор, МассивТелОтбор, МассивНаимОтбор, МассивSkypeОтбор);
	КонецЦикла; 
		
	СтруктураОтбора.СправочникиОтбор 	= МассивСпрОтбор;
	СтруктураОтбора.НомерОтбор 			= МассивТелОтбор;
	СтруктураОтбора.НаименованиеОтбор 	= МассивНаимОтбор;
	СтруктураОтбора.SkypeОтбор 			= МассивSkypeОтбор;
	
	Возврат СтруктураОтбора;
	
КонецФункции // ПолучитьОбъектыОтбора()
&НаСервере
Процедура ЗаполнитьМассивОтбора(ЭлементОтбора, МассивСпрСсылка, МассивТел, МассивНаим, МассивSkype)

	Если ЭлементОтбора <> Неопределено И Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(ЭлементОтбора)) Тогда
		МассивСпрСсылка.Добавить(ЭлементОтбора);
	ИначеЕсли ТипЗнч(ЭлементОтбора) = Тип("Строка") Тогда
		
	    КомандаПоиска = "МИКО_ПолнотекстовыйПоиск";
		Если Найти(ЭлементОтбора, КомандаПоиска)>0 Тогда
			РезультатПоискаСсылок = НайтиПоНаименованию(СтрЗаменить(ЭлементОтбора,КомандаПоиска, ""));
			Для каждого ТекЗначение Из РезультатПоискаСсылок Цикл
				Если МассивСпрСсылка.Найти(ТекЗначение) = Неопределено Тогда
					МассивСпрСсылка.Добавить(ТекЗначение);
				КонецЕсли; 
			КонецЦикла; 
			Возврат;			
		КонецЕсли; 

		// Если строку отбора можно преобразовать в число, то будем считать ее отбором по телефону.
		Если МИКО_опЗаписьКИ.ЭтоЧисловойНомер(ЭлементОтбора) Тогда
			ЧислоЦифрДляХранения = МИКО_стОбщегоНазначенияСерверПовторный.КоличествоХранимыхЦифрТелефона();
			НомерТел = МИКО_опЗаписьКИ.ПреобразоватьНомерДляСохранения(ЭлементОтбора, ЧислоЦифрДляХранения);
			МассивТел.Добавить(НомерТел);
			Возврат;
		КонецЕсли; 
				
		// Если в строке отбора только латиница, будем считать, что это skype.
		Если ВСловеТолькоЛатиница(ЭлементОтбора) Тогда
			МассивSkype.Добавить(ЭлементОтбора);
		Иначе
			МассивНаим.Добавить(ЭлементОтбора);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры // ЗаполнитьСтруктуруОтбора()
&НаКлиенте
Процедура СтрокаПоискаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
 	СтандартнаяОбработка = Ложь;
	Если ИспользоватьПолнотекстовыйПоиск И ЗначениеЗаполнено(Текст) Тогда
		ДанныеВыбора = Новый СписокЗначений;
	    ДанныеВыбора.Добавить("МИКО_ПолнотекстовыйПоиск"+СокрЛП(Текст), "Искать: " + СокрЛП(Текст));
		Если МИКО_опЗаписьКИ.ЭтоЧисловойНомер(Текст) Тогда
			ДанныеВыбора.Добавить(Текст, "Номер телефона: "+Текст);
		Иначе
			ДанныеВыбора.Добавить(Текст, "Skype: "+Текст);
		КонецЕсли; 
	Иначе	
		ДанныеВыбора = ПолучитьОбъектыПоиска(СокрЛП(Текст), ТекстЗапросаОтбора);
		Если ДанныеВыбора.Количество()=0 Тогда
		 	ДанныеВыбора.Добавить(Текст);
		КонецЕсли; 
	КонецЕсли; 	
	
КонецПроцедуры
&НаКлиенте
Процедура УдалитьВсеОтборы(Команда)
	УстановитьЗначенияПоУмолчанию();
КонецПроцедуры

&НаКлиенте
Процедура КонтекстноеМенюОткрытьКарточку(Команда)
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТаблицаИстории.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Вызов = Новый Структура("НомерТелефона,Партнер,Абонент,Входящий,ЕстьЗапись,recordingfile");
	Если ЗаполнитьПоДокументуИсторииЗвонков(Вызов, ТекущиеДанные.Звонок) = Ложь Тогда
		Возврат;
	КонецЕсли;
	Клиент = Вызов.Партнер;
	
	ОткрытьЗначениеКлиент(Клиент);
КонецПроцедуры

// Заполняет список типов объектов отбора для последующего формирования представления объекта отбора.
// 
&НаСервере
Процедура ЗаполнитьСписокТиповОбъектовОтбора()

	Если Метаданные.Справочники.Найти("Партнеры") <> Неопределено Тогда
		СписокТиповОбъектовОтбора.Добавить(Тип(("СправочникСсылка.Партнеры")), "Партнер");
	КонецЕсли;

	Если Метаданные.Справочники.Найти("Контрагенты") <> Неопределено Тогда
		СписокТиповОбъектовОтбора.Добавить(Тип(("СправочникСсылка.Контрагенты")), "Контрагент");
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("КонтактныеЛицаПартнеров") <> Неопределено Тогда
		СписокТиповОбъектовОтбора.Добавить(Тип(("СправочникСсылка.КонтактныеЛицаПартнеров")), "Контактное лицо");
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("КонтактныеЛицаКонтрагентов") <> Неопределено Тогда
		СписокТиповОбъектовОтбора.Добавить(Тип(("СправочникСсылка.КонтактныеЛицаКонтрагентов")), "Контактное лицо");
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("Корреспонденты") <> Неопределено Тогда
		СписокТиповОбъектовОтбора.Добавить(Тип(("СправочникСсылка.Корреспонденты")), "Корреспондент");
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("Пользователи") <> Неопределено Тогда
		СписокТиповОбъектовОтбора.Добавить(Тип(("СправочникСсылка.Пользователи")), "Пользователь");
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("ФизическиеЛица") <> Неопределено Тогда
		СписокТиповОбъектовОтбора.Добавить(Тип(("СправочникСсылка.ФизическиеЛица")), "Физ. лицо");
	КонецЕсли;
	
	Если Метаданные.Справочники.Найти("Организации") <> Неопределено Тогда
		СписокТиповОбъектовОтбора.Добавить(Тип(("СправочникСсылка.Организации")), "Организация");
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьСписокТиповОбъектовОтбора()

