КонецПроцедуры

&НаКлиенте
// Возвращает Истина, если это номер текущего пользователя.
// 
Функция ЭтоНащНомер(пНомерТелефона)
	
	Если МоиНомера = Неопределено Тогда
	 	Возврат Истина; 
	Иначе	
		врНомер = Прав(пНомерТелефона, 9);		
		Результат = (Найти(МоиНомера, врНомер + Символы.ПС)>0);
	КонецЕсли; 

	Возврат Результат;
КонецФункции // ЭтоНащНомер()

&НаСервере
Процедура ОбновитьНаСервере(ЭтаФормаОткрыта = Истина)
	ДатаНачала 	 = Период.ДатаНачала; 	  
	ДатаОкончания= Период.ДатаОкончания; 
		
	ОбъектыОтбора = ПолучитьОбъектыОтбора();
	Если ЗначениеЗаполнено(ОбъектОтбора) 
		 И ЭтаФормаОткрыта = Ложь И ОбъектыОтбора.СправочникиОтбор.Найти(ОбъектОтбора)=Неопределено Тогда
		ОбъектыОтбора.СправочникиОтбор.Добавить(ОбъектОтбора);
	    ОбъектыОтбора.НомерОтбор.Очистить();
	    ОбъектыОтбора.SkypeОтбор.Очистить();
	    ОбъектыОтбора.НаименованиеОтбор.Очистить();
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстОсновногоЗапроса();
	Если фПропущенные = Истина Тогда
	 	Запрос.Текст = СтрЗаменить(Запрос.Текст,"//Пропущенный//","");
	КонецЕсли; 	
	МассивОбъектов 	= ОбъектыОтбора.СправочникиОтбор;
	МассивТелефонов = ОбъектыОтбора.НомерОтбор;
	МассивSkype		= ОбъектыОтбора.SkypeОтбор;
	МассивНаим		= ОбъектыОтбора.НаименованиеОтбор;
	
	УсловиеОтбораПоОбъекту1 = "";
	УсловиеОтбораПоОбъекту2 = "";
	УсловиеОтбораПоОбъекту3 = "";
	
	// Найдем контактные лица объекта отбора.
	ПолныйМассивОбъектов = Новый Массив;
	Для к=0 По МассивОбъектов.Количество()-1 Цикл
		КонтактыОбъектОтбора = МИКО_стОбработкаКонтактнойИнформации.ПолучитьКонтактыПоПартнеру(МассивОбъектов[к]);
		Для каждого ЭлемКонтакт Из КонтактыОбъектОтбора Цикл
			ПолныйМассивОбъектов.Добавить(ЭлемКонтакт);
		КонецЦикла; 
	КонецЦикла; 
	
	ШаблонУсловие1 = "";
	ШаблонУсловие2 = "";
	ШаблонУсловие3 = "";
	
	ПервыйОтбор = Истина;
	
	Если ПолныйМассивОбъектов.Количество() > 0 Тогда
		ШаблонУсловие1 = "
		|		МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Dst_Ссылка В (&ОбъектОтбора)
		|	ИЛИ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Src_Ссылка В (&ОбъектОтбора)
		|	ИЛИ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Src_Ссылка В (&ОбъектОтбора)
		|	ИЛИ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Dst_Ссылка В (&ОбъектОтбора)";
		ШаблонУсловие2 = "
		|	МИКО_стЗаписьИсторииЗвонковCDR_ПропустившиеЗвонок.Dst_Ссылка В (&ОбъектОтбора)";
		ШаблонУсловие3 = "
		|		МИКО_стЗаписьИсторииЗвонков.Dst_Ссылка В (&ОбъектОтбора)
		|	ИЛИ МИКО_стЗаписьИсторииЗвонков.Src_Ссылка В (&ОбъектОтбора)";
		
		Запрос.УстановитьПараметр("ОбъектОтбора", ПолныйМассивОбъектов);
		ПервыйОтбор = Ложь;
	КонецЕсли; 
	
	Если МассивТелефонов.Количество() > 0 Тогда
		
		Если ПервыйОтбор Тогда
			ШаблонУсловие1 = "
			|	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Src_ID В (&НомерТелефона)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Dst_ID В (&НомерТелефона)";
			ШаблонУсловие2 = "
			|	МИКО_стЗаписьИсторииЗвонковCDR_ПропустившиеЗвонок.Ссылка.Src_ID В (&НомерТелефона)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковCDR_ПропустившиеЗвонок.Ссылка.Dst_ID В (&НомерТелефона)";
			ШаблонУсловие3 = "
			|	МИКО_стЗаписьИсторииЗвонков.Src_ID В (&НомерТелефона)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонков.Dst_ID В (&НомерТелефона)";
		
		Иначе
			ШаблонУсловие1 = ШаблонУсловие1 + "
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Src_ID В (&НомерТелефона)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Dst_ID В (&НомерТелефона)";
			ШаблонУсловие2 = ШаблонУсловие2 + "
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковCDR_ПропустившиеЗвонок.Ссылка.Src_ID В (&НомерТелефона)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковCDR_ПропустившиеЗвонок.Ссылка.Dst_ID В (&НомерТелефона)";
			ШаблонУсловие3 = ШаблонУсловие3 + "
			|	ИЛИ МИКО_стЗаписьИсторииЗвонков.Src_ID В (&НомерТелефона)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонков.Dst_ID В (&НомерТелефона)";
		КонецЕсли; 
		
		Запрос.УстановитьПараметр("НомерТелефона", МассивТелефонов);
		ПервыйОтбор = Ложь;
	КонецЕсли; 
	
	Если МассивSkype.Количество() > 0 Тогда
		Если ПервыйОтбор Тогда
			ШаблонУсловие1 = "
			|	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Src В (&SkypeОтбор)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Dst В (&SkypeОтбор)";
			ШаблонУсловие2 = "
			|	МИКО_стЗаписьИсторииЗвонковCDR_ПропустившиеЗвонок.Ссылка.Src В (&SkypeОтбор)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковCDR_ПропустившиеЗвонок.Ссылка.Dst В (&SkypeОтбор)";
			ШаблонУсловие3 = "
			|	МИКО_стЗаписьИсторииЗвонков.Src В (&SkypeОтбор)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонков.Dst В (&SkypeОтбор)";
		
		Иначе
			ШаблонУсловие1 = ШаблонУсловие1 + "
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Src В (&SkypeОтбор)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Dst В (&SkypeОтбор)";
			ШаблонУсловие2 = ШаблонУсловие2 + "
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковCDR_ПропустившиеЗвонок.Ссылка.Src В (&SkypeОтбор)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонковCDR_ПропустившиеЗвонок.Ссылка.Dst В (&SkypeОтбор)";
			ШаблонУсловие3 = ШаблонУсловие3 + "
			|	ИЛИ МИКО_стЗаписьИсторииЗвонков.Src В (&SkypeОтбор)
			|	ИЛИ МИКО_стЗаписьИсторииЗвонков.Dst В (&SkypeОтбор)";
		КонецЕсли; 
		
		Запрос.УстановитьПараметр("SkypeОтбор", МассивSkype);
		ПервыйОтбор = Ложь;
	КонецЕсли;
	
	Если МассивНаим.Количество() > 0 Тогда
		
		УсловиеПоНаим1 = "";
		УсловиеПоНаим2 = "";
		УсловиеПоНаим3 = "";
		
		ШаблонУсловиеПоНаим1 = "
		|	ИЛИ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Src_Ссылка.Наименование ПОДОБНО &НаименованиеОтбор//Итератор//
		|	ИЛИ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Dst_Ссылка.Наименование ПОДОБНО &НаименованиеОтбор//Итератор//";
		
		ШаблонУсловиеПоНаим2 = "
		|	ИЛИ МИКО_стЗаписьИсторииЗвонковCDR_ПропустившиеЗвонок.Dst_Ссылка.Наименование ПОДОБНО &НаименованиеОтбор//Итератор//";
		
		ШаблонУсловиеПоНаим3 = "
		|	ИЛИ МИКО_стЗаписьИсторииЗвонков.Src_Ссылка.Наименование ПОДОБНО &НаименованиеОтбор//Итератор//
		|	ИЛИ МИКО_стЗаписьИсторииЗвонков.Dst_Ссылка.Наименование ПОДОБНО &НаименованиеОтбор//Итератор//";
		
		Для к=1 По МассивНаим.Количество() Цикл
		
			УсловиеПоНаим1 = УсловиеПоНаим1+СтрЗаменить(ШаблонУсловиеПоНаим1, "//Итератор//", к);
			УсловиеПоНаим2 = УсловиеПоНаим2+СтрЗаменить(ШаблонУсловиеПоНаим2, "//Итератор//", к);
			УсловиеПоНаим3 = УсловиеПоНаим3+СтрЗаменить(ШаблонУсловиеПоНаим3, "//Итератор//", к);
			
			Запрос.УстановитьПараметр("НаименованиеОтбор"+к,"%"+МассивНаим[к-1]+"%");
		КонецЦикла; 
		
		Если ПервыйОтбор Тогда
			ШаблонУсловие1 = Сред(УсловиеПоНаим1, Найти(УсловиеПоНаим1, "ИЛИ ")+4);
			ШаблонУсловие2 = Сред(УсловиеПоНаим2, Найти(УсловиеПоНаим2, "ИЛИ ")+4);
			ШаблонУсловие3 = Сред(УсловиеПоНаим3, Найти(УсловиеПоНаим3, "ИЛИ ")+4);
		
		Иначе
			ШаблонУсловие1 = ШаблонУсловие1 + УсловиеПоНаим1;
			ШаблонУсловие2 = ШаблонУсловие2 + УсловиеПоНаим2;
			ШаблонУсловие3 = ШаблонУсловие3 + УсловиеПоНаим3;
		КонецЕсли; 
		
		ПервыйОтбор = Ложь;
	КонецЕсли; 
	
	ШаблонУсловие1 = ?(ЗначениеЗаполнено(ШаблонУсловие1),"И ("+ШаблонУсловие1+")","");
	ШаблонУсловие2 = ?(ЗначениеЗаполнено(ШаблонУсловие2),"И ("+ШаблонУсловие2+")","");
	ШаблонУсловие3 = ?(ЗначениеЗаполнено(ШаблонУсловие3),"И ("+ШаблонУсловие3+")","");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"//УсловиеОтбораПоОбъекту1//",ШаблонУсловие1);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"//УсловиеОтбораПоОбъекту2//",ШаблонУсловие2);
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"//УсловиеОтбораПоОбъекту3//",ШаблонУсловие3);
	
	Направления = Новый Массив;
	Если фВходящие И фВнутренние И фИсходящие Тогда
		// нет отбора	
	Иначе
		Если фВнутренние Тогда
		  	Направления.Добавить(ПредопределенноеЗначение("Перечисление.МИКО_стВидыТелефонныхЗвонков.Внутренний"));
		КонецЕсли;
		Если фВходящие Тогда
		  	Направления.Добавить(ПредопределенноеЗначение("Перечисление.МИКО_стВидыТелефонныхЗвонков.Входящий"));
		КонецЕсли;
		Если фИсходящие Тогда
		  	Направления.Добавить(ПредопределенноеЗначение("Перечисление.МИКО_стВидыТелефонныхЗвонков.Исходящий"));
		КонецЕсли;
		
		Если Направления.Количество()>0 Тогда
	 		Запрос.Текст = СтрЗаменить(Запрос.Текст,"//Направления//","");
			Запрос.УстановитьПараметр("Направления", Направления);
		КонецЕсли; 
	КонецЕсли; 

	Запрос.УстановитьПараметр("ДатаНачала", 	ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", 	ДатаОкончания);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	КУдалению = РезультатЗапроса.НайтиСтроки(Новый Структура("Направление,НомерКому", ПредопределенноеЗначение("Перечисление.МИКО_стВидыТелефонныхЗвонков.Внутренний"), "PLAYBACK"));
	Для каждого ТекСтрока Из КУдалению Цикл
	  	РезультатЗапроса.Удалить(ТекСтрока);
	КонецЦикла; 
	
	// Отметим истинно пропущенные.
	впПропущенныеБезПК = Обработки.МИКО_стАнализПропущенныхВызовов.ПолучитьПропущенные(ДатаНачала, Ложь, Истина);
	РезультатЗапроса.Колонки.Добавить("ПропущенныйБезПК", Новый ОписаниеТипов("Булево"));	
	Для каждого ТекПропущенный Из впПропущенныеБезПК Цикл
		Если ТекПропущенный.КоличествоОтвеченных > 0 Тогда
		  	Продолжить;
		КонецЕсли; 
		//  =  КонтактКто = ТекПропущенный.НомерТелефона 
		ОтборПропущенных = Новый Структура("ВремяЗвонка,НомерКто,НетСоединений", ТекПропущенный.ДатаПропущенного, ТекПропущенный.НомерТелефона, Истина);
		врСтроки = РезультатЗапроса.НайтиСтроки(ОтборПропущенных);
		Если врСтроки.Количество()=0 Тогда
			врСтроки = РезультатЗапроса.НайтиСтроки(Новый Структура("Звонок", ТекПропущенный.СсылкаНаПропущенный));
		КонецЕсли; 

		Для каждого текВызов Из врСтроки Цикл
			текВызов.ПропущенныйБезПК = Истина;
		КонецЦикла; 
	КонецЦикла; 
	
	Объект.ТаблицаИстории.Загрузить(РезультатЗапроса);
	
КонецПроцедуры

