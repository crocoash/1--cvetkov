&НаКлиенте
// Выбор варианта отбора
// 
Процедура ВидОтобораПриИзменении(Элемент)
	ЗаполнитьОбъектОтбора(Элемент.Имя);
КонецПроцедуры

&НаСервере
// Выбор варианта отбора (контрагент / партнер / пользователь)
// 
Процедура ЗаполнитьОбъектОтбора(Имя)
	Для каждого ТекЭл Из Элементы.грОтборыПоВидуКонтакта.ПодчиненныеЭлементы Цикл
		Если НЕ ТипЗнч(ТекЭл.Вид) = Тип("ВидКнопкиФормы") Тогда
		   	Продолжить;
		КонецЕсли; 
		ТекЭл.Пометка = Ложь;
		ТекЭл.ЦветФона = ЦветаСтиля.ЦветФонаКнопки;
	КонецЦикла; 	
	
	Элементы[Имя].Пометка = Истина;
	Элементы[Имя].ЦветФона = WebЦвета.Перламутровый;
	
	Элементы.ОбъектОтбора.ВыбиратьТип = Ложь;
	Если Имя = "ПоПартнеру" Тогда
		ОбъектОтбора = Справочники["Партнеры"].ПустаяСсылка();  	
	ИначеЕсли Имя = "ПоКонтрагенту" Тогда	
		ОбъектОтбора = Справочники["Контрагенты"].ПустаяСсылка();  	
	ИначеЕсли Имя = "ПоПользователю" Тогда	
		ОбъектОтбора = Справочники.Пользователи.ПустаяСсылка();  	
	Иначе 	
		Элементы.ОбъектОтбора.ВыбиратьТип = Истина;
		ОбъектОтбора = Null;  	
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте
// Открыть карточку звонка
// Расшифровка звонка
Процедура дОткрытьРасшифровку(Команда)
	ТекущиеДанные = Элементы.ТаблицаИстории.ТекущиеДанные;
	
	Если НЕ ТекущиеДанные = Неопределено Тогда
		
		Если ВерсияПлатформы = "8.3" Тогда
		
			Если НЕ ИспользоватьРежимМодальности Тогда
				Попытка
					Выполнить("ПоказатьЗначение(,ТекущиеДанные.Звонок)");
				Исключение
					Возврат;
				КонецПопытки; 
			Иначе	
				ОткрытьЗначение(ТекущиеДанные.Звонок);
			КонецЕсли; 

		ИначеЕсли ВерсияПлатформы = "8.2" Тогда
			ОткрытьЗначение(ТекущиеДанные.Звонок);
		КонецЕсли; 	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
// Запуск обратного звонка для воспроизведения файла
// 
Процедура дПрослушатьЗапись(Команда)
	ТекущиеДанные = Элементы.ТаблицаИстории.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
	 	Возврат;
	КонецЕсли; 
	ИмяФайлаЗаписиРазговора = ТекущиеДанные.recordingfile;
	
	Если ИмяФайлаЗаписиРазговора = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	// Найдем в какой глобальной переменной определена панель телефонии.
	Miko_Ajam 		= МИКО_стОбщегоНазначенияКлиент.ПолучитьОбъектПанелиТелефонииОб();
	сфпФормаТелефон = МИКО_стОбщегоНазначенияКлиент.ПолучитьОбъектПанелиТелефонииУп();
	 
	ЗвонокИД = ?(СтанцияMyPBX, ИмяФайлаЗаписиРазговора, ТекущиеДанные.ИдентификаторЗвонка);
	Если сфпФормаТелефон <> Неопределено Тогда
		ОжидаемЗапись = Истина;
		Если СтанцияMyPBX = Истина Тогда
			Оповестить("ВоспроизвестиЗаписьПоИмениФайла", ТекущиеДанные.recordingfile, ЭтаФорма);
		Иначе	
			Оповестить("ВоспроизвестиЗапись", ЗвонокИД, ЭтаФорма);
		КонецЕсли; 
	ИначеЕсли Miko_Ajam	<> Неопределено Тогда
		Попытка
			Miko_Ajam.ПрослушатьЗаписьРазговора(ЗвонокИД);
		Исключение
		КонецПопытки;
	Иначе
		МИКО_стОбщегоНазначенияКлиент.СообщитьПользователю("Панель телефонии не подключена! Нет возможности прослушать запись.");	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
// Запуск процесса скачивания файла записи. 
//
Процедура дСкачатьЗапись(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаИстории.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
	 	Возврат;
	КонецЕсли; 
	ИмяФайлаЗаписиРазговора = ТекущиеДанные.recordingfile;
	
	// Найдем в какой глобальной переменной определена панель телефонии.
	Miko_Ajam 		= МИКО_стОбщегоНазначенияКлиент.ПолучитьОбъектПанелиТелефонииОб();
	сфпФормаТелефон = МИКО_стОбщегоНазначенияКлиент.ПолучитьОбъектПанелиТелефонииУп();
	
	Если сфпФормаТелефон <> Неопределено Тогда
		ОжидаемЗапись = Истина;
		Если СтанцияMyPBX = Истина Тогда
			врПараметры = Новый Структура();
			врПараметры.Вставить("uniqueid1c", 	ТекущиеДанные.ИдентификаторЗвонка);
			врПараметры.Вставить("filename", 	ТекущиеДанные.recordingfile);
			врПараметры.Вставить("fpath", 		"");
			
			Оповестить("СкачатьЗаписьПоИмениФайла", врПараметры, ЭтаФорма);
		Иначе	
			Оповестить("СкачатьЗапись", ТекущиеДанные.ИдентификаторЗвонка, ЭтаФорма);
		КонецЕсли; 
	ИначеЕсли Miko_Ajam	<> Неопределено Тогда
		Попытка
			Miko_Ajam.СкачатьЗаписьРазговора(ТекущиеДанные);
		Исключение
			// 	
		КонецПопытки;
	Иначе
		МИКО_стОбщегоНазначенияКлиент.СообщитьПользователю("Нет возможности скачать запись.");	
	КонецЕсли; 
	
КонецПроцедуры

