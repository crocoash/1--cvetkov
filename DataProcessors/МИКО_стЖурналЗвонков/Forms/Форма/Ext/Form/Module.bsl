// #Область СлужебныеПроцедурыИФункции

///
// Обработчики формы

&НаСервере
// Начальное заполнение.
// 
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Метаданные.ПараметрыСеанса.Найти("ТекущийПользователь")<>Неопределено Тогда
		ТекущийПользователь = Вычислить("ПараметрыСеанса.ТекущийПользователь");
	КонецЕсли;
	Элементы.отборЗвонкиТекущегоПользователя.Видимость = ЗначениеЗаполнено(ТекущийПользователь);
	
	фВнутренние = Истина;
	фВходящие 	= Истина;
	фИсходящие  = Истина;
	
	Обновить = Истина;
	
	Если Параметры.Свойство("Контакт", ОбъектОтбора) Тогда
		Элементы.ОбъектОтбора.Видимость = ЗначениеЗаполнено(ОбъектОтбора);
		Элементы.грОтборыПоВидуКонтакта.Видимость = Ложь;
		
		Обновить = Ложь;
	Иначе
		Элементы.ОбъектОтбора.Видимость = Ложь;
		ОбъектОтбора = Справочники.Пользователи.ПустаяСсылка(); 
	КонецЕсли;
	Параметры.Свойство("МоиНомера", МоиНомера);	
	// 
	ЕстьСпрПартнеры 	= НЕ Метаданные.Справочники.Найти("Партнеры") 		= Неопределено;
	ЕстьСпрКонтрагенты  = НЕ Метаданные.Справочники.Найти("Контрагенты") 	= Неопределено;
	ЕстьСпрПользователи = НЕ Метаданные.Справочники.Найти("Пользователи") 	= Неопределено;
	
	Элементы.ПоПартнеру.Видимость 				= ЕстьСпрПартнеры;
	Элементы.ПоКонтрагенту.Видимость 			= ЕстьСпрКонтрагенты;
	Элементы.ПоПользователю.Видимость 			= ЕстьСпрПользователи;
	// 
	Период.Вариант = ВариантСтандартногоПериода.Последние7Дней;
	Элементы.представениеПериод.Заголовок 			= Период;
	Если Обновить = Истина Тогда
		ОбновитьНаСервере();
	КонецЕсли; 
	
	Хост		 = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.АдресСервера();
	Порт 		 = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПортСервера();

	// Получим системную информацию
	СтруктураДанных = МИКО_стСлужебный.ПолучитьСлужебнуюИнформацию();
	ВерсияПлатформы = СтруктураДанных.ВерсияПлатформы;
	ИспользоватьРежимМодальности = СтруктураДанных.ИспользоватьРежимМодальности;
	
	// Видимость элементов формы
	MIKO_Asterisk_Подключена = Метаданные.Обработки.Найти("MIKO_Asterisk")<>Неопределено;
	МИКО_ПанельТелефонииДля1С_Подключена = Метаданные.Обработки.Найти("МИКО_ПанельТелефонииДля1С")<>Неопределено;
	ПанельТелефонииЕсть = (MIKO_Asterisk_Подключена ИЛИ МИКО_ПанельТелефонииДля1С_Подключена);
		
	Элементы.дПрослушатьЗапись.Видимость	= ПанельТелефонииЕсть;
	Элементы.дСкачатьЗапись.Видимость 		= ПанельТелефонииЕсть;
	Элементы.ОткрытьСобытие.Видимость 		= ПанельТелефонииЕсть;
	Элементы.ДобавитьНомерКонтакту.Видимость= ПанельТелефонииЕсть;
	Элементы.дПрослушатьЗапись1.Видимость	= ПанельТелефонииЕсть;
	Элементы.дСкачатьЗапись1.Видимость 		= ПанельТелефонииЕсть;
	Элементы.ОткрытьСобытие1.Видимость 		= ПанельТелефонииЕсть;
	Элементы.Позвонить.Видимость 			= ПанельТелефонииЕсть;

	Элементы.ПозвонитьКоманда.Видимость 	= ПанельТелефонииЕсть;
	Элементы.ДобавитьНомерКонтакту1.Видимость= ПанельТелефонииЕсть;	
	Элементы.ТаблицаИсторииКонтекстноеМенюСоздатьДополнительныйСтикер.Видимость = ПанельТелефонииЕсть;

	нФильтрВнутренние 	= Элементы.фВнутренние.Заголовок;
	нФильтрПропущенные  = Элементы.фПропущенные.Заголовок;
	нФильтрВходящие 	= Элементы.фВходящие.Заголовок;
	нФильтрИсходящие	= Элементы.фИсходящие.Заголовок;
	
	// Сформируем текст запроса отбора по объектам метаданных
	ТекстЗапросаОтбора = ПолучитьТекстЗапросаОтбора(); 
	
	// Заполним список типов справочников для элементов отбора
	ЗаполнитьСписокТиповОбъектовОтбора();
	ВосстановитьНастройки();
	
	СтанцияMyPBX = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.СтанцияMyPBX();
	
КонецПроцедуры 

&НаКлиенте
// Начальное заполнение.
// 
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ОбъектОтбора) Тогда
		УстановитьЗначенияПоУмолчанию(Неопределено, Ложь);
		УстановитьЭлементОтбора(ОбъектОтбора);
	Иначе
		УстановитьЗначенияПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
// Обработка получение оповещений.
// 
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаписьСобытие" Тогда 
		врИстория = Объект.ТаблицаИстории.НайтиСтроки(Новый Структура("ИдентификаторЗвонка", Параметр.id));	
		Если врИстория.Количество()>0 Тогда
			врИстория[0].ЕстьСобытие = ПрикрепитьСобытиеКЗвонку(врИстория[0].Звонок, Параметр.Ссылка);
		КонецЕсли; 
	ИначеЕсли ИмяСобытия = "ПрисвоенНомерТелефона" Тогда 
		ЗаполнитьВладельцаНомера(Параметр);
		ПередатьИсториюЗвонковВПанельТелефонии();
	ИначеЕсли ИмяСобытия = "ЗапроситьИсториюЗвонков" Тогда 
		Если ВладелецФормы <> Неопределено 
			 И (	ВладелецФормы.ИмяФормы = "Обработка.MIKO_Asterisk.Форма.Форма" 
			 	ИЛИ ВладелецФормы.ИмяФормы = "Обработка.МИКО_ПанельТелефонииДля1С.Форма.Форма") Тогда
			 ОбновитьНаСервере(Ложь);
			 ПередатьИсториюЗвонковВПанельТелефонии();
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "ЖС_ПолучитьЗвонкиПоНомеру"Тогда
		
		Если (ТекущаяДата() - ВремяПредыдущегоЗапроса) < 1 Тогда
			Возврат;
		Иначе	
			ВремяПредыдущегоЗапроса = ТекущаяДата();
		КонецЕсли;
		
		// Контакты за последние 30 дней.
		НачалоПериода 	 = НачалоДня(Параметр) - 60*60*24*30;
		ОкончаниеПериода = КонецДня (Параметр);
		ТаблицаИстории = ПолучитьИсториюЗвонковПоНомеруТелефона(Источник, НачалоПериода, ОкончаниеПериода);
		Оповестить("ЖЗ_Refresh1CHistory_partner_", ТаблицаИстории, Источник);
	ИначеЕсли ИмяСобытия = "ОповеститьЖЗ_ЗаписьРазговора" Тогда	
		Если ОжидаемЗапись = Истина Тогда
			ОжидаемЗапись = Ложь;
			врЭлемент = ?(Параметр.ТипОперации = "СкачатьЗапись", Элементы.дСкачатьЗапись, Элементы.дПрослушатьЗапись);
			Если ВерсияПлатформы = "8.3" Тогда
				ОписаниеОповещения = Вычислить("Новый ОписаниеОповещения(""ОбработкаВыбораФайлаЗаписи"", ЭтаФорма, Параметр)");
				Попытка
					Выполнить("ПоказатьВыборИзМеню(ОписаниеОповещения,Параметр.спИменаФайлов, врЭлемент)");
				Исключение
					Возврат;
				КонецПопытки; 
			Иначе	
				Попытка
					врЗначение = Вычислить("ВыбратьИзМеню(Параметр.спИменаФайлов, врЭлемент)");	
				Исключение
					Возврат;
				КонецПопытки; 
				ОбработкаВыбораФайлаЗаписи(врЗначение, Параметр)
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
// Подготовка / отправка истории звонков в панель телефонии.
// 
Процедура ПередатьИсториюЗвонковВПанельТелефонии()

	врТаблицаИстории = Новый Массив;
	Для каждого СтрокаИстории Из Объект.ТаблицаИстории Цикл
		врДанные = Новый Структура;
		врДанные.Вставить("Id", 						СтрокаИстории.ИдентификаторЗвонка);
		врДанные.Вставить("Начало", 					СтрокаИстории.ВремяЗвонка);
		врДанные.Вставить("ПродолжительностьРазговора", СтрокаИстории.ДлительностьРазговора);
		врДанные.Вставить("Пропущен", 					СтрокаИстории.Пропущенный);
		
		Если Строка(СтрокаИстории.Направление) = "Внутренний" Тогда	
			Входящий = НЕ ЭтоНащНомер(СтрокаИстории.НомерКто);
		Иначе
			Входящий =  Строка(СтрокаИстории.Направление) = "Входящий";	
		КонецЕсли; 
		
		Если Входящий = Истина Тогда
			Организация 	= СтрокаИстории.КонтактКто;
			НомерТелефона 	= СтрокаИстории.НомерКто;
		Иначе	
			Организация 	= СтрокаИстории.КонтактКому;
			НомерТелефона 	= СтрокаИстории.НомерКому;
		КонецЕсли; 
		
		врДанные.Вставить("Входящий", 					Входящий = Истина);
		врДанные.Вставить("Организация", 				Организация);
		врДанные.Вставить("Абонент", 					"");
		врДанные.Вставить("НомерТелефона", 				НомерТелефона);
		врДанные.Вставить("ЕстьЗапись", 				СтрокаИстории.ЕстьЗапись);

		врТаблицаИстории.Добавить(врДанные);
	КонецЦикла; 
	Оповестить("ОбновитьЖурналЗвонковЗаСегодня",врТаблицаИстории,Неопределено); 

КонецПроцедуры // ПередатьИсториюЗвонковВПанельТелефонии()

&НаКлиенте
Процедура ИспользоватьПолнотекстовыйПоискПриИзменении(Элемент)
	СохранитьНастройки();	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройки()
    Настройки    = Новый Структура;
	Настройки.Вставить("ИспользоватьПолнотекстовыйПоиск", ИспользоватьПолнотекстовыйПоиск);
    ХранилищеОбщихНастроек.Сохранить("MIKO",  "ЖурналЗвонков", Настройки, , ИмяПользователя());	
КонецПроцедуры
&НаСервере
Процедура ВосстановитьНастройки()

	СтруктураНастроек = ХранилищеОбщихНастроек.Загрузить("MIKO","ЖурналЗвонков",,ИмяПользователя());
	Если ТипЗнч(СтруктураНастроек) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураНастроек);
	КонецЕсли;

КонецПроцедуры
 

///
// Прочие процедуры и функции

&НаКлиенте
// Установка периода.
// 
Процедура УстановитьПериод(Команда)
	
	Если ВерсияПлатформы = "8.3" Тогда
		
		Если НЕ ИспользоватьРежимМодальности Тогда
			ОписаниеОповещения = Вычислить("Новый ОписаниеОповещения(""УстановитьПериодНаФорме"", ЭтаФорма)");
			Попытка
				Выполнить("ОткрытьФорму(""ОбщаяФорма.МИКО_стВыборСтандартногоПериода"",,ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,,ОписаниеОповещения)");
			Исключение
				Возврат;
			КонецПопытки; 
		Иначе	
			вПериод = ОткрытьФормуМодально("ОбщаяФорма.МИКО_стВыборСтандартногоПериода");
			УстановитьПериодНаФорме(вПериод);
		КонецЕсли; 
		
	ИначеЕсли ВерсияПлатформы = "8.2" Тогда
		
		вПериод = ОткрытьФормуМодально("ОбщаяФорма.МИКО_стВыборСтандартногоПериода");
	
		УстановитьПериодНаФорме(вПериод);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура отборЗвонкиЗаСегодняНажатие(Элемент)
	
	Период.Вариант = ВариантСтандартногоПериода.Сегодня;
