/// ПОЛНОТЕКСТОВЫЙ ПОИСК

&НаСервере 
Функция НайтиПоНаименованию(СтрокаПоиска)
	
	НайденныеСсылки = Новый Массив; МассивОтбор = Новый Массив(); СинонимыРеквизитов = Новый Массив;
	ДобавитьОтборЕслиВозможно("Пользователи",				МассивОтбор,СинонимыРеквизитов);	
	ДобавитьОтборЕслиВозможно("Партнеры",					МассивОтбор,СинонимыРеквизитов);	
	ДобавитьОтборЕслиВозможно("Сотрудники",					МассивОтбор,СинонимыРеквизитов);	
	ДобавитьОтборЕслиВозможно("Контрагенты",				МассивОтбор,СинонимыРеквизитов);	
	ДобавитьОтборЕслиВозможно("КонтактныеЛица", 			МассивОтбор,СинонимыРеквизитов);	
	ДобавитьОтборЕслиВозможно("Кореспонденты",				МассивОтбор,СинонимыРеквизитов);	
	ДобавитьОтборЕслиВозможно("Организации",				МассивОтбор,СинонимыРеквизитов);	
	ДобавитьОтборЕслиВозможно("КонтактныеЛицаПартнеров",	МассивОтбор,СинонимыРеквизитов);	
	ДобавитьОтборЕслиВозможно("КонтактныеЛицаКонтрагентов", МассивОтбор,СинонимыРеквизитов);	
	
	РазмерПорции = 300;
	СписокПоиска = ПолнотекстовыйПоиск.СоздатьСписок(СтрокаПоиска, РазмерПорции);
	СписокПоиска.ПорогНечеткости = 10;
	СписокПоиска.ОбластьПоиска = МассивОтбор;
	Попытка
		СписокПоиска.ПерваяЧасть();
	Исключение
	 	Возврат НайденныеСсылки;
	КонецПопытки;
	
	КоличествоНайденных = СписокПоиска.ПолноеКоличество();
	ТекущаяПозиция = 0;
	Пока Истина Цикл
		Для каждого ТекущаяСтрока Из СписокПоиска Цикл
			Для каждого ИмяРеквизита Из СинонимыРеквизитов Цикл
				Если Лев(ТекущаяСтрока.Описание,СтрДлина(ИмяРеквизита)) = ИмяРеквизита
					 И НайденныеСсылки.Найти(ТекущаяСтрока.Значение) = Неопределено Тогда
				    НайденныеСсылки.Добавить(ТекущаяСтрока.Значение);
				КонецЕсли; 		
			КонецЦикла; 
		КонецЦикла; 
		
		ТекущаяПозиция = ТекущаяПозиция + РазмерПорции;
		Если КоличествоНайденных < ТекущаяПозиция Тогда
			Прервать;	
		КонецЕсли; 
		// СписокПоиска.СледующаяЧасть();
	КонецЦикла; 
	
	Возврат НайденныеСсылки;
КонецФункции
&НаСервере 
Процедура ДобавитьОтборЕслиВозможно(Знач ИмяСправочника, МассивОтбор, СинонимыРеквизитов)
	
	Справочник = Метаданные.Справочники.Найти(ИмяСправочника);
	Если Справочник = Неопределено Тогда
		Возврат;
	КонецЕсли; 	
	Если МассивОтбор.Найти(Справочник) = Неопределено Тогда
		МассивОтбор.Добавить(Справочник);
	КонецЕсли; 	
	Если СинонимыРеквизитов.Найти(Справочник.СтандартныеРеквизиты.Наименование.Синоним)=Неопределено Тогда
		СинонимыРеквизитов.Добавить(Справочник.СтандартныеРеквизиты.Наименование.Синоним); 
	КонецЕсли; 
		
КонецПроцедуры

