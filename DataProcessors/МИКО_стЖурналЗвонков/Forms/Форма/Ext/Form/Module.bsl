	КонецЕсли; 
	Вызов = Новый Структура("НомерТелефона,Партнер,Абонент,Входящий,ЕстьЗапись,recordingfile");
	Если ЗаполнитьПоДокументуИсторииЗвонков(Вызов, ТекущиеДанные.Звонок) = Ложь Тогда
		// Внутренний вызов.
		Возврат;
	КонецЕсли;
	                 
	ПараметрыФормы = Новый Структура("НомерТелефона", Вызов.НомерТелефона);
	ОткрытьФорму("Обработка.МИКО_стКомуПринадлежитНомер.Форма", ПараметрыФормы);          
	
КонецПроцедуры

/// 
// История звонкво в стикере.

// Получаем таблицу истории звонков по номеру телефону. Кто последний говорил с клиентом.
// 
&НаСервереБезКонтекста  
Функция ПолучитьИсториюЗвонковПоНомеруТелефона(Знач НомерТелефона, Знач НачалоПериода, Знач ОкончаниеПериода)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИКО_стЗаписьИсторииЗвонков.Ссылка,
		|	МИКО_стЗаписьИсторииЗвонков.Src_ID,
		|	МИКО_стЗаписьИсторииЗвонков.Dst_ID
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Документ.МИКО_стЗаписьИсторииЗвонков КАК МИКО_стЗаписьИсторииЗвонков
		|ГДЕ
		|	МИКО_стЗаписьИсторииЗвонков.НетСоединений = ЛОЖЬ
		|	И МИКО_стЗаписьИсторииЗвонков.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.Дата КАК Начало,
		|	ВЫБОР
		|		КОГДА &Num_ID = МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Cidnum_ID
		|			ТОГДА МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Dst_Ссылка
		|		ИНАЧЕ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Src_Ссылка
		|	КОНЕЦ КАК Абонент,
		|	ВЫБОР
		|		КОГДА &Num_ID = МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Cidnum_ID
		|			ТОГДА МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Peer
		|		ИНАЧЕ МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Cidnum
		|	КОНЕЦ КАК НомерТелефона,
		|	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка КАК Ссылка,
		|	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Длительность КАК ПродолжительностьВызова,
		|	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.linkedid КАК id,
		|	ВЫБОР
		|		КОГДА &Num_ID = МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Cidnum_ID
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Входящий,
		|	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка.НетСоединений КАК Пропущен
		|ИЗ
		|	Документ.МИКО_стЗаписьИсторииЗвонков.ДетализацияCEL КАК МИКО_стЗаписьИсторииЗвонковДетализацияCEL
		|ГДЕ
		|	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка В
		|			(ВЫБРАТЬ
		|				ВТ.Ссылка
		|			ИЗ
		|				ВТ КАК ВТ
		|			ГДЕ
		|				(ВТ.Src_ID = &Num_ID
		|					ИЛИ ВТ.Dst_ID = &Num_ID))
		|ИТОГИ ПО
		|	Ссылка";
	
		
	КоличествоХранимыхЦифрТелефона = МИКО_стОбщегоНазначенияСерверПовторный.КоличествоХранимыхЦифрТелефона();
	Num_ID = МИКО_опЗаписьКИ.ПреобразоватьНомерДляСохранения(НомерТелефона,КоличествоХранимыхЦифрТелефона);
	
	Запрос.УстановитьПараметр("Num_ID", Num_ID);
	Запрос.УстановитьПараметр("НачалоПериода", 	  НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТаблицаИстории = Новый Массив;
	Пока ВыборкаСсылка.Следующий() Цикл
	    Данные = Новый Структура("ЕстьЗапись,Начало,Входящий,Пропущен,Абонент,НомерТелефона,Ссылка,ПродолжительностьВызова,id,Документ,ЕстьДокумент");
		Выборка = ВыборкаСсылка.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Данные.Начало = Неопределено Тогда
			 	ЗаполнитьЗначенияСвойств(Данные, Выборка);
			ИначеЕсли МАКС(Данные.ПродолжительностьВызова,Выборка.ПродолжительностьВызова) = Выборка.ПродолжительностьВызова  Тогда	
			 	ЗаполнитьЗначенияСвойств(Данные, Выборка);
			КонецЕсли; 
		КонецЦикла;
		
		Если НЕ Данные.Начало = Неопределено Тогда
			
			РезульатЗапроса  = МИКО_стОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Ссылка, "ДокументыСобытие");
			ДокументыСобытие = РезульатЗапроса.Выгрузить();
			
			РезульатЗапроса  = МИКО_стОбщегоНазначения.ЗначениеРеквизитаОбъекта(Данные.Ссылка, "ИменаФайлов");
			ИменаФайлов 	 = РезульатЗапроса.Выгрузить();

			Данные.ЕстьЗапись= ИменаФайлов.Количество()>0;
			Если (ДокументыСобытие.Количество()>0) Тогда
		  		Данные.ЕстьДокумент = Истина;
				Данные.Документ 	= ДокументыСобытие[0].Событие; 
			Иначе	
		  		Данные.ЕстьДокумент = Ложь;
			КонецЕсли; 
		    ТаблицаИстории.Добавить(Данные);
		КонецЕсли; 
	КонецЦикла;
	
	Возврат ТаблицаИстории;
КонецФункции

&НаКлиенте
Процедура ТаблицаИсторииПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.ТаблицаИстории.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	Вызов = Новый Структура("НомерТелефона,Партнер,Абонент,Входящий,ЕстьЗапись,recordingfile");
	Если ЗаполнитьПоДокументуИсторииЗвонков(Вызов, ТекущиеДанные.Звонок) = Ложь Тогда
		нКлиентПредставление 		  = "";
		// Внутренний вызов.
		Возврат;
	КонецЕсли;
	//
	Если ЗначениеЗаполнено(Вызов.Партнер) Тогда
		ПредставлкениеКлиент = "" + Вызов.Партнер + " (" + Вызов.НомерТелефона + ")"; 	
	ИначеЕсли ЗначениеЗаполнено(Вызов.Абонент) Тогда
		ПредставлкениеКлиент = "" + Вызов.Абонент + " (" + Вызов.НомерТелефона + ")"; 	
	Иначе
		ПредставлкениеКлиент = "" + Вызов.НомерТелефона + ""; 	
	КонецЕсли; 	
	нКлиентПредставление = ПредставлкениеКлиент;
	
КонецПроцедуры

