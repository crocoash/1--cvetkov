@echo off
title Конфигурация 1С

rem ЗАЧЕМ ВРЕМЕННАЯ КОПИЯ. cmd.exe читает .cmd не целиком, а по мере выполнения, запоминая
rem смещение в файле. apply-config.ps1 первым делом делает git pull, который переписывает
rem этот же файл в _tools - и после возврата из powershell cmd продолжает читать с прежнего
rem смещения, но уже в новом файле. Остаток разбирается в мусор: 17.08.2026 это выглядело
rem как ошибка ""но" не является внутренней или внешней командой". Поэтому меню всегда
rem выполняется из копии в %TEMP%: её никакой pull не трогает.
rem
rem Копия на рабочем столе живёт своей жизнью и сама не обновляется, поэтому она берёт
rem свежий файл из репозитория - пункты меню всегда актуальные, сколько бы она ни лежала.
if /I "%~1"=="__run" goto own

set REPO=%USERPROFILE%\Documents\fork\1--cvetkov\_tools
set SRC=%~dp0
if exist "%REPO%\Обновить базу.cmd" set SRC=%REPO%\

rem Хвосты прошлых запусков чистим здесь: файл, который читается прямо сейчас, не удалится.
del /q "%TEMP%\1c-menu-*.cmd" >nul 2>&1
set MENU=%TEMP%\1c-menu-%RANDOM%%RANDOM%.cmd
copy /y "%SRC%Обновить базу.cmd" "%MENU%" >nul 2>&1
if not exist "%MENU%" goto own
call "%MENU%" __run "%SRC%"
exit /b

:own
rem Второй параметр - папка, из которой сделана копия: рядом с ней и лежит скрипт.
if not "%~2"=="" set "SRC=%~2"
if "%SRC%"=="" set SRC=%~dp0
set PS=%SRC%apply-config.ps1
if not exist "%PS%" set PS=%REPO%\apply-config.ps1
if not exist "%PS%" (
  echo Не найден apply-config.ps1 ни рядом с этим файлом, ни в
  echo %REPO%
  echo Проверьте, что репозиторий на месте, и сделайте git pull.
  pause
  exit /b 1
)

:menu
cls
echo ==========================================
echo   Обновление конфигурации 1С из GitHub
echo ==========================================
echo.
echo   1  - Обновить базу. Помешают люди - спросит, выгонять ли
echo   2  - Обновить базу. Помешают люди - выгонит молча
echo   3  - Доделать обновление БД, если прошлый раз база была занята
echo.
echo   Пункты 1 и 2 делают одно и то же: тянут из GitHub, грузят конфигурацию
echo   и обновляют базу; разница только в вопросе про выгон. Пока правки
echo   не меняют структуру, база обновляется на ходу и никого не трогает.
echo   Пункт 3 - когда загрузка уже прошла, а обновление БД упёрлось в занятую
echo   базу: он не грузит заново, а только доделывает обновление.
echo.
echo   9  - Прочее: выгрузить конфигурацию из базы в файлы, настроить базу
echo   0  - Выход
echo.
set OPT=
set /p OPT=Введите номер и нажмите Enter: 
if "%OPT%"=="1" set ARGS=-ask& goto run
if "%OPT%"=="2" set ARGS=& goto run
if "%OPT%"=="3" set ARGS=-updateonly& goto run
if "%OPT%"=="9" goto more
if "%OPT%"=="0" exit /b
goto menu

:more
cls
echo ==========================================
echo   Прочее
echo ==========================================
echo.
echo   1  - Выгрузить конфигурацию из базы в файлы + снимок
echo   2  - Настроить базу и пользователя
echo   3  - Только загрузить из файлов, базу не обновлять
echo   4  - Только обновить конфигурацию БД (загрузку не повторять)
echo.
echo   0  - Назад
echo.
set OPT=
set /p OPT=Введите номер и нажмите Enter: 
if "%OPT%"=="1" set ARGS=-dump& goto run
if "%OPT%"=="2" set ARGS=-setup& goto run
if "%OPT%"=="3" set ARGS=-loadonly& goto run
if "%OPT%"=="4" set ARGS=-updateonly& goto run
if "%OPT%"=="0" goto menu
goto more

:run
cls
echo Запуск. Шаг загрузки из файлов идёт молча несколько минут - это нормально,
echo окно не закрывать и не прерывать.
echo Открытая на этом компьютере 1С закроется сама и запустится обратно
echo после обновления - сохраните незаписанные документы.
echo.
powershell -NoProfile -ExecutionPolicy Bypass -File "%PS%" %ARGS%
echo.
echo ------------------------------------------
echo Нажмите любую клавишу, чтобы вернуться в меню.
pause >nul
goto menu
