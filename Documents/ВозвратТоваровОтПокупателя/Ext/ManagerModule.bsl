функция СоздатьДокументКроя(Документ) Экспорт 
	
	СкладНеПошит = Справочники.Склады.НайтиПоКоду("000000026");
	Док = Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
	Док.Товары.Загрузить(Документ.Продукция.выгрузить());
	Док.Контрагент = Справочники.Контрагенты.НайтиПоКоду("000009930");
	Док.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;  
	
	Док.СкладОрдер = СкладНеПошит;
	Док.ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.НайтиПоКоду("000009785");
	Док.Организация = Справочники.Организации.НайтиПоКоду("000000001");
		
	// важно заполнить валюту и курс
	Если ЗначениеЗаполнено(Док.ДоговорКонтрагента) Тогда
		Док.ВалютаДокумента = Док.ДоговорКонтрагента.ВалютаВзаиморасчетов;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Док.ВалютаДокумента) Тогда
		Док.ВалютаДокумента = глЗначениеПеременной("ВалютаРегламентированногоУчета");
	КонецЕсли;
	
	
	Для Каждого Стр из Док.Товары Цикл
		Стр.ЕдиницаИзмерения = Справочники.ЕдиницыИзмерения.НайтиПоКоду("000002130");
		Стр.Качество = Справочники.Качество.НайтиПоКоду("000000001");
		Стр.Коэффициент = 1;
		Стр.Цена = 1;
		Стр.Склад = СкладНеПошит;
		
		// Рассчитать реквизиты табличной части.
		ОбработкаТабличныхЧастей.РассчитатьКоличествоМестТабЧасти(Стр, Док);
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(Стр, Док);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(Стр, Док);
		
	КонецЦикла;
	Док.Комментарий = Документ.Комментарий;
	Документ.ПолучитьОбъект().Записать(РежимЗаписиДокумента.ОтменаПроведения); 
	Док.Дата = Документ.Дата;
	
	// Курс взаиморасчетов, ответственный и флаг управленческого учета.
	// При ручном вводе их заполняет форма, но только для нового документа (ЭтоНовый()),
	// а здесь форма открывается уже для записанного - и не заполнит ничего.
	СтруктураКурса = МодульВалютногоУчета.ПолучитьКурсВалюты(Док.ВалютаДокумента, Док.Дата);
	Док.КурсВзаиморасчетов      = СтруктураКурса.Курс;
	Док.КратностьВзаиморасчетов = СтруктураКурса.Кратность;
	Док.Ответственный                = глЗначениеПеременной("глТекущийПользователь");
	Док.ОтражатьВУправленческомУчете = Истина;
	
	Док.Записать();  
	Док.ПолучитьФорму().Открыть();
КонецФункции