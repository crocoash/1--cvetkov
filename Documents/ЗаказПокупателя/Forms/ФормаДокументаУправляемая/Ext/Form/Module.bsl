&НаСервере
Процедура ОткрытьОтчетПоВзаиморасчетамНаСервере()

	// Отчёт открывается обычной формой отчёта - как и раньше.
	Попытка
		Отчет = Отчеты.ВедомостьВзаиморасчетыСКонтрагентами.Создать();
		Отчет.УстановитьНачальныеНастройки();

		Отчет.УниверсальныйОтчет.ДатаНач = ТекущаяДата() - 30 * 86400;
		Отчет.УниверсальныйОтчет.ДатаКон = ТекущаяДата();

		Отчет.УниверсальныйОтчет.ПостроительОтчета.ИзмеренияСтроки.Очистить();
		Отчет.УниверсальныйОтчет.ПостроительОтчета.ИзмеренияКолонки.Очистить();
		Отчет.УниверсальныйОтчет.ПостроительОтчета.ВыбранныеПоля.Очистить();
		Отчет.УниверсальныйОтчет.ПостроительОтчета.Порядок.Очистить();

		Отчет.УниверсальныйОтчет.ДобавитьИзмерениеСтроки("Контрагент");
		Отчет.УниверсальныйОтчет.ДобавитьИзмерениеСтроки("ДоговорКонтрагента");

		ЭлементОтбора = Отчет.УниверсальныйОтчет.ПостроительОтчета.Отбор["Контрагент"];
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения  = ВидСравнения.Равно;
		ЭлементОтбора.Значение      = Объект.Контрагент;

		Отчет.УниверсальныйОтчет.ДобавитьДополнительноеПоле("Регистратор");
		Отчет.УниверсальныйОтчет.ВыводитьДетальныеЗаписи   = Истина;
		Отчет.УниверсальныйОтчет.ОтрицательноеКрасным      = Истина;
		Отчет.УниверсальныйОтчет.мВосстанавливатьНастройкиПриОткрытии = Ложь;

		ФормаОтчета = Отчет.ПолучитьФорму();
		ФормаОтчета.Открыть();
		ФормаОтчета.ОбновитьОтчет();
	Исключение
		Сообщить("Отчёт по взаиморасчётам не открылся: " + ОписаниеОшибки());
	КонецПопытки;

