КонецПроцедуры

// Тот же расчёт, что в КнопкаФормулыНажатие обычной формы: сумма к оплате и
// строка-пояснение перед текстом счёта.
//
&НаСервере
Функция СформироватьТекстСчетаНаСервере(Вариант, ДоляПредоплаты)

	ЭтоПлатформа = Объект.Контрагент.Родитель.Наименование = "Розница платформа";

	ИтогоРезерва  = ИтогКоллекцииФормы(ТабРезерваОстаток, "Сумма");
	Долг          = ?(ЭтоПлатформа, 0,
		Цел(Документы.ЗаказПокупателя.ДолгКонтрагентаНаДату(Объект.Контрагент, ТекущаяДата())));
	СуммаРезервов = Документы.ЗаказПокупателя.ПолучитьСуммуРезервовПоКонтрагенту(Объект.Контрагент);

	Окр1 = Перечисления.ПорядкиОкругления.Окр1;

	ВесьРезервМинусДолг = Ценообразование.ОкруглитьЦену(ИтогоРезерва + Долг, Окр1, Истина);
	Предоплата          = Ценообразование.ОкруглитьЦену(ИтогоРезерва * ДоляПредоплаты + Долг, Окр1, Истина);
	ПредоплатаНаЧасть   = Ценообразование.ОкруглитьЦену(
		(СуммаРезервов - ИтогоРезерва) * ДоляПредоплаты + ИтогоРезерва + Долг, Окр1, Истина);
	ОстатокРезерва      = Ценообразование.ОкруглитьЦену(СуммаРезервов - ИтогоРезерва, Окр1, Истина);

	ИтогоРезервСтрокой = ПреобразоватьСтроку(ИтогоРезерва);
	ДолгСтрокой        = ПреобразоватьСтроку(Долг);
	ДолгБлизокКНулю    = Долг < 4 И Долг > -2;

	Если Вариант = "Часть" Тогда

		Сумма = ПредоплатаНаЧасть;

		Если ОстатокРезерва <> 0 Тогда
			Пояснение = ПреобразоватьСтроку(ОстатокРезерва) + " Виготовляється / 30% + "
				+ ИтогоРезервСтрокой + " Готово + "
				+ ?(ДолгБлизокКНулю, "", "(" + ДолгСтрокой + " Баланс)") + " = "
				+ ПреобразоватьСтроку(ПредоплатаНаЧасть) + " Грн до оплати";
		Иначе
			Пояснение = "весь резерв тут";
		КонецЕсли;

	ИначеЕсли Вариант = "Полностью" Тогда

		Сумма = ВесьРезервМинусДолг;

		Если ДолгБлизокКНулю Тогда
			Пояснение = ПреобразоватьСтроку(ВесьРезервМинусДолг) + " Грн до оплати";
		ИначеЕсли ВесьРезервМинусДолг < 3 Тогда
			Пояснение = "Оплачен";
		Иначе
			Пояснение = ИтогоРезервСтрокой + " + (" + ДолгСтрокой + " Баланс) = "
				+ ПреобразоватьСтроку(ВесьРезервМинусДолг) + " Грн до оплати";
		КонецЕсли;

	ИначеЕсли Вариант = "Фиксированная" Тогда

		Сумма     = 150;
		Пояснение = "150 Грн";

	Иначе

		Сумма = Предоплата;

		СтрокаПроцента = "/ " + Формат(ДоляПредоплаты * 100, "ЧДЦ=0") + "%";

		Если ДолгБлизокКНулю Тогда
			Пояснение = ИтогоРезервСтрокой + " " + СтрокаПроцента + " = "
				+ ПреобразоватьСтроку(Предоплата) + " Грн до оплати";
		ИначеЕсли Предоплата < 20 Тогда
			Пояснение = "Сплачено";
		Иначе
			Пояснение = "(" + ИтогоРезервСтрокой + " " + СтрокаПроцента + ") + ("
				+ ДолгСтрокой + " Баланс) = " + ПреобразоватьСтроку(Предоплата) + " Грн до оплати";
		КонецЕсли;

	КонецЕсли;

	ИнфоСумма = Сумма;

	Текст = Пояснение + Символы.ПС + ТекстСМС;
	Текст = СтрЗаменить(Текст, "[Cумма]", СтрЗаменить(Строка(Сумма), " ", ""));

	Элементы.НадписьИтогоРезерв.Заголовок = "Разом резерв: "
		+ СокрЛП(ИтогКоллекцииФормы(ТабРезерваОстаток, "Количество")) + " шт. на суму "
		+ Строка(Ценообразование.ОкруглитьЦену(ИтогоРезерва, Окр1, Истина));

	Результат = Новый Структура;
	Результат.Вставить("Сумма", Сумма);
	Результат.Вставить("Текст", Текст);

	Возврат Результат;

КонецФункции

