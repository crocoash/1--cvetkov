	Объект.СпособОтправки          = ПредопределенноеЗначение("Справочник.СпособыОтправки.ПустаяСсылка");
	Объект.КонтрагентДоставки      = ПредопределенноеЗначение("Справочник.ЛМ_Контрагенты.ПустаяСсылка");
	Объект.КонтактноеЛицоДоставки  = ПредопределенноеЗначение("Справочник.ЛМ_КонтактныеЛица.ПустаяСсылка");
	Объект.ТелефонКонтрагента      = "";
	Объект.ГородНовойПочтыЗначение = ПредопределенноеЗначение("Справочник.ЛМ_Города.ПустаяСсылка");
	Объект.СкладНовойПочтыЗначение = ПредопределенноеЗначение("Справочник.ЛМ_Отделения.ПустаяСсылка");
	Объект.АдресДоставки           = "";
	Объект.ДатаДоставки            = '00010101';
	Объект.СуммаНоваяПочта         = 0;
	Объект.Получатель              = "";

