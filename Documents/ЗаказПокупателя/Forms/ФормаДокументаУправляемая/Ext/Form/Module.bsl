// БЛАНКИ ПЕРЕАДРЕСАЦИИ И ИЗМЕНЕНИЯ ДАННЫХ

&НаКлиенте
Процедура ПечатьБланковНажатие(Элемент)

	Если Не ЗначениеЗаполнено(ЗаказПодбора) Тогда
		Возврат;
	КонецЕсли;

	Причина = ПричинаПереадресацииНаСервере();

	Если ПустаяСтрока(Причина) Тогда
		Если Не ВвестиСтроку(Причина, "Причина изменения данных") Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	НапечататьБланкНаСервере(Причина);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПричинаПереадресацииНаСервере()

	Возврат Константы.ПричинаПереадресации.Получить();

КонецФункции

// Бланк "Изменение данных" или "Переадресация" - смотря совпало ли отделение.
//
&НаСервере
Процедура НапечататьБланкНаСервере(Знач Причина)

	Если Не ЗначениеЗаполнено(ЗаказПодбораДокумент) Тогда
		Возврат;
	КонецЕсли;

	СовпалоОтделение = ЗаказПодбораДокумент.ГородНовойПочтыЗначение = Объект.ГородНовойПочтыЗначение
		И ЗаказПодбораДокумент.СкладНовойПочтыЗначение = Объект.СкладНовойПочтыЗначение;

	ИмяМакета = ?(СовпалоОтделение, "ИзменениеДанных", "Переадресация");

	ТабДок = Новый ТабличныйДокумент;
	Макет  = Документы.ЗаказПокупателя.ПолучитьМакет(ИмяМакета);

	ТабДок.Вывести(Макет.ПолучитьОбласть("Шапка"));

	ОбластьТекст = Макет.ПолучитьОбласть("Текст");

	ОбластьТекст.Параметры.ФИО              = Константы.ИмяОтправителя.Получить();
	ОбластьТекст.Параметры.СерияПаспорта     = Константы.СерияПаспортаОтправителя.Получить();
	ОбластьТекст.Параметры.НомерПаспорта     = СтрЗаменить(Константы.НомерПаспортаОтправителя.Получить(), " ", "");
	ОбластьТекст.Параметры.КогдаВыдан        = Константы.КогдаВыданПаспортОтправителя.Получить();
	ОбластьТекст.Параметры.КемВыдан          = Константы.КемВыданПаспортОтправителя.Получить();
	ОбластьТекст.Параметры.АдресОтправителя  = Константы.АдресОтправителяУкрпочта.Получить();
	ОбластьТекст.Параметры.НомерТТН          = ЗаказПодбораДокумент.НомерТТН;
	ОбластьТекст.Параметры.Город             = ЗаказПодбораДокумент.ГородНовойПочтыЗначение;
	ОбластьТекст.Параметры.ТекущаяДата       = Формат(ТекущаяДата(), "ДЛФ=Д");

	Если СовпалоОтделение Тогда

		ОбластьТекст.Параметры.ПричинаИзменения  = Причина;
		ОбластьТекст.Параметры.фПолучатель       = "v";
		ОбластьТекст.Параметры.ДанныеПолучателя  = Строка(Объект.Контрагент);
		ОбластьТекст.Параметры.Телефон           = СокрЛП(Объект.ТелефонКонтрагента);

		СуммаНовая  = ?(ЧислоИзСуммы(Объект.СуммаНоваяПочта) = 0, Всего, ЧислоИзСуммы(Объект.СуммаНоваяПочта));
		СуммаСтарая = ?(ЧислоИзСуммы(ЗаказПодбораДокумент.СуммаНоваяПочта) = 0,
			ЗаказПодбораДокумент.СуммаДокумента, ЧислоИзСуммы(ЗаказПодбораДокумент.СуммаНоваяПочта));

		Если СуммаСтарая <> СуммаНовая Тогда
			ОбластьТекст.Параметры.фСуммаОбратная = "v";
			ОбластьТекст.Параметры.СуммаОбратная  = СуммаНовая;
		КонецЕсли;

	Иначе

		ОбластьТекст.Параметры.ПричинаПереадресации = Причина;
		ОбластьТекст.Параметры.ПолучательНовый      = Строка(Объект.Контрагент);
		ОбластьТекст.Параметры.КонтактНовый         = Строка(Объект.Контрагент);
		ОбластьТекст.Параметры.Телефон              = СокрЛП(Объект.ТелефонКонтрагента);
		ОбластьТекст.Параметры.ФормаРасчета         = Объект.ВидРасчетов;

		Если Объект.ТехнологияДоставки.ГУИД = "WarehouseWarehouse"
			Или Объект.ТехнологияДоставки.ГУИД = "DoorsWarehouse" Тогда
			ОбластьТекст.Параметры.АдресНовый = СокрЛП(Объект.ГородНовойПочтыЗначение)
				+ "  " + СокрЛП(Объект.СкладНовойПочтыЗначение);
		Иначе
			ОбластьТекст.Параметры.АдресНовый = СокрЛП(Объект.ГородНовойПочтыЗначение)
				+ ", " + СокрЛП(Объект.АдресДоставки);
		КонецЕсли;

		Если СокрЛП(Объект.Плательщик) = "Получатель" Тогда
			ОбластьТекст.Параметры.фПолучатель  = "V";
			ОбластьТекст.Параметры.фОтправитель = "";
		Иначе
			ОбластьТекст.Параметры.фПолучатель  = "";
			ОбластьТекст.Параметры.фОтправитель = "V";
		КонецЕсли;

		Объект.ВидПереадресации   = Перечисления.ВидыПереадресации.ПереадресованоНаЗаказ;
		Объект.ЗаказПереадресации = ЗаказПодбораДокумент;

	КонецЕсли;

	ТабДок.Вывести(ОбластьТекст);

	Объект.РаспечатанБланк = Истина;

	ТабДок.РазмерСтраницы = "A4";
	ТабДок.АвтоМасштаб    = Истина;
	ТабДок.Показать();

КонецПроцедуры

// Подбор заказа из отказов с тем же товарным составом.
//
&НаКлиенте
Процедура кнОбновитьНажатие(Элемент)

	ОбновитьЗаказПодбораНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаказПодбораНаСервере()

	Таблица = ПодборИзОтказаНаСервере();

	Если Таблица.Количество() = 0 Тогда
		ЗаказПодбора = "";
		ЗаказПодбораДокумент = Документы.ЗаказПокупателя.ПустаяСсылка();
		Возврат;
	КонецЕсли;

	Строка = Таблица[0];

	ЗаказПодбора = Строка(Строка.Город) + "   відділення №" + Строка(Строка.Склад.Номер)
		+ "   " + Строка(Строка.СтатусДоставки) + "   " + Строка(Строка.СрокХранения)
		+ "   " + Строка(Строка.ДатаДоставки) + "   " + Строка(Строка.Телефон);

	ЗаказПодбораДокумент = Строка.Заказ;
	Объект.ЗаказПодбораДокумент = Строка.Заказ;

КонецПроцедуры

&НаСервере
Функция ПодборИзОтказаНаСервере()

	ТоварныйСостав = "";

	Для Каждого СтрокаТЧ Из Объект.Товары Цикл

		Если Не (ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) И ЗначениеЗаполнено(СтрокаТЧ.Количество)) Тогда
			Продолжить;
		КонецЕсли;

		Если Не ПустаяСтрока(ТоварныйСостав) Тогда
			ТоварныйСостав = ТоварныйСостав + ";";
		КонецЕсли;

		ТоварныйСостав = ТоварныйСостав + СокрЛП(СтрокаТЧ.Номенклатура.Наименование) + "-" + СтрокаТЧ.Количество;

	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказПокупателя.Ссылка КАК Заказ,
		|	ЗаказПокупателя.Номер КАК Номер,
		|	ЗаказПокупателя.ГородНовойПочтыЗначение КАК Город,
		|	ЗаказПокупателя.СкладНовойПочтыЗначение КАК Склад,
		|	ЗаказПокупателя.ТелефонКонтрагента КАК Телефон,
		|	ЗаказПокупателя.СтатусОтправки КАК СтатусДоставки,
		|	ЗаказПокупателя.ДатаДоставки КАК ДатаДоставки
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.СтатусЗаказа = &Отказ
		|	И ЗаказПокупателя.ТоварныйСостав ПОДОБНО &ТоварныйСостав
		|	И ЗаказПокупателя.ВидПереадресации <> &Возврат";

	Запрос.УстановитьПараметр("Отказ",          Справочники.СтатусыЗаказов.НайтиПоНаименованию("Отказ"));
	Запрос.УстановитьПараметр("Возврат",        Перечисления.ВидыПереадресации.Возврат);
	Запрос.УстановитьПараметр("ТоварныйСостав", ТоварныйСостав);

	Результат = Запрос.Выполнить().Выгрузить();

	Результат.Колонки.Добавить("СрокХранения");

	Для Каждого Строка Из Результат Цикл
		Если ЗначениеЗаполнено(Строка.ДатаДоставки) Тогда
			Строка.СрокХранения = Строка(ПросроченоДнейНаСервере(Строка.ДатаДоставки)) + " дн.";
		КонецЕсли;
	КонецЦикла;

	// Сначала совпавшие по городу и отделению, затем по городу, затем прочие.
	Результат.Сортировать("СтатусДоставки, ДатаДоставки Возр");

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ДобавитьСчетНажатие(Элемент)

	ТекстРеквизитов = "";

	Если Не ВвестиСтроку(ТекстРеквизитов, "Вставьте банковские реквизиты", 10000, Истина) Тогда
		Возврат;
	КонецЕсли;

	СоздатьБанковскийСчетНаСервере(ТекстРеквизитов);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьБанковскийСчетНаСервере(Знач ТекстРеквизитов)

	Реквизиты = Справочники.БанковскиеСчета.РазобратьБанковскиеРеквизиты(ТекстРеквизитов);

	Справочники.БанковскиеСчета.СоздатьБанковскийСчетОрганизации(
		Реквизиты.Получатель, Реквизиты.КодПолучателя, Реквизиты.IBAN, Реквизиты.НазначениеПлатежа);

КонецПроцедуры

