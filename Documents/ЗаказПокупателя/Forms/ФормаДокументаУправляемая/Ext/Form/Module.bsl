	Док.КонтрагентДоставки      = Справочники.ЛМ_Контрагенты.ПустаяСсылка();
	Док.КонтактноеЛицоДоставки  = Справочники.ЛМ_КонтактныеЛица.ПустаяСсылка();
	Док.ТелефонКонтрагента      = "";
	Док.ГородНовойПочтыЗначение = Справочники.ЛМ_Города.ПустаяСсылка();
	Док.СкладНовойПочтыЗначение = Справочники.ЛМ_Отделения.ПустаяСсылка();
	Док.АдресДоставки           = "";
	Док.ДатаДоставки            = Дата(1, 1, 1);
	Док.СуммаНоваяПочта         = 0;
	Док.Получатель              = "";

КонецПроцедуры

// Ввод контрагента номером телефона: если ввели цифры - ищем контрагента по номеру.
//
&НаКлиенте
Процедура КонтрагентОкончаниеВводаТекста(Элемент, Текст, Значение, СтандартнаяОбработка)

	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	Найденные = НайтиКонтрагентовПоТелефонуНаСервере(Текст);

	Если Найденные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	Если Найденные.Количество() = 0 Тогда

		Сообщить("Контрагент не найден по номеру телефона! + " + Текст);

	ИначеЕсли Найденные.Количество() = 1 Тогда

		Значение = Найденные[0].Значение;

	Иначе

		ВыбранноеЗначение = ВыбратьИзСписка(Найденные, Элемент);

		Если ВыбранноеЗначение <> Неопределено Тогда
			Значение = ВыбранноеЗначение.Значение;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиКонтрагентовПоТелефонуНаСервере(Знач Текст)

	Если Не ОбщегоНазначения.ЭтоЧисло(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Список = Новый СписокЗначений;

	Контрагенты = БИАС.ПолучитьМассивКонтрагентовПоНомеруТелефона(Текст);

	Если ТипЗнч(Контрагенты) = Тип("Массив") Тогда
		Для Каждого Контрагент Из Контрагенты Цикл
			Список.Добавить(Контрагент, Строка(Контрагент));
		КонецЦикла;
	КонецЕсли;

	Возврат Список;

КонецФункции

&НаКлиенте
Процедура ДоговорКонтрагентаНачалоВыбора(Элемент, СтандартнаяОбработка)

	// Отбор договоров по видам и способу ведения взаиморасчётов делала
	// РаботаСДиалогами.НачалоВыбораЗначенияДоговораКонтрагента - из управляемой
	// формы этот модуль недоступен, поэтому отбор ставим параметрами выбора.
	СтандартнаяОбработка = Ложь;

	СписокВидовДоговоров = Новый СписокЗначений;
	СписокВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"));
	СписокВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомиссионером"));
	СписокВидовДоговоров.Добавить(ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.Бартерный"));

	Отбор = Новый Структура;
	Отбор.Вставить("Владелец", Объект.Контрагент);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	ПараметрыФормы.Вставить("ВидыДоговоров", СписокВидовДоговоров);
	ПараметрыФормы.Вставить("ЗакрытьПриВыборе", Истина);

	ОткрытьФорму("Справочник.ДоговорыКонтрагентов.ФормаВыбора", ПараметрыФормы, Элемент);

