// МЕЛКИЕ СЛУЖЕБНЫЕ ФУНКЦИИ

&НаСервереБезКонтекста
Функция ОчиститьТелефон(Знач Телефон)

	Телефон = СтрЗаменить(Телефон, "+38", "");
	Телефон = СтрЗаменить(Телефон, "(",   "");
	Телефон = СтрЗаменить(Телефон, ")",   "");
	Телефон = СтрЗаменить(Телефон, "-",   "");
	Телефон = СтрЗаменить(Телефон, ",",   "");
	Телефон = СтрЗаменить(Телефон, " ",   "");

	Если Лев(Телефон, 2) = "38" Тогда
		Телефон = Сред(Телефон, 3);
	КонецЕсли;

	Если Лев(Телефон, 1) = "8" Тогда
		Телефон = Сред(Телефон, 2);
	КонецЕсли;

	Если Лев(Телефон, 2) = "00" Тогда
		Телефон = Сред(Телефон, 2);
	КонецЕсли;

	Возврат Телефон;

КонецФункции

// Сумма наложки бывает и числом, и строкой из Формат() с неразрывным пробелом.
//
&НаСервереБезКонтекста
Функция ЧислоИзСуммы(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Текст = СтрЗаменить(Строка(Значение), Символ(160), "");
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, ",", ".");

	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// У коллекций данных управляемой формы (Объект.Товары, таблицы значений формы)
// нет метода Итог() - считаем сумму колонки вручную.
//
&НаСервереБезКонтекста
Функция ИтогКоллекцииФормы(Коллекция, Знач ИмяКолонки)

	Итог = 0;

	Для Каждого Строка Из Коллекция Цикл
		Итог = Итог + Строка[ИмяКолонки];
	КонецЦикла;

	Возврат Итог;

КонецФункции

&НаСервереБезКонтекста
Функция ПросроченоДнейНаСервере(Знач ДатаДоставки)

	КолДней = (НачалоДня(ТекущаяДата()) - НачалоДня(ДатаДоставки)) / 86400;

	Если КолДней < 0 Тогда
		Возврат 0;
	КонецЕсли;

	Выходные = 0;

	Для Сч = 1 По КолДней Цикл
		Если ДеньНедели(НачалоДня(ДатаДоставки) + Сч * 86400) = 7 Тогда
			Выходные = Выходные + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат КолДней - Выходные;

КонецФункции

&НаСервереБезКонтекста
Функция ПреобразоватьСтроку(Знач Число)

	Если Число > 0 Тогда

		Стр = Строка(Цел(Число));
		КоличествоЦифр = СтрДлина(Стр);

		Если КоличествоЦифр > 3 Тогда
			Возврат Лев(Стр, КоличествоЦифр - 3 - 1) + "'" + Прав(Стр, 3);
		КонецЕсли;

		Возврат Стр;

	КонецЕсли;

	Возврат Строка(Число);

КонецФункции

