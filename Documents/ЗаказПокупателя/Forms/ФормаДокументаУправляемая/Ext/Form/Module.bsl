	Объект.Распечатан   = Истина;

	ОтправитьСМСОТТННаСервере();

КонецПроцедуры

&НаКлиенте
Процедура РазослатьНомерТТН(Команда)

	ТекстОтказа = РазослатьНомерТТННаСервере();

	Если Не ПустаяСтрока(ТекстОтказа) Тогда
		Сообщить(ТекстОтказа);
		Возврат;
	КонецЕсли;

	Если Записать() Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция РазослатьНомерТТННаСервере()

	Если Объект.СтатусЗаказа <> Справочники.СтатусыЗаказов.НайтиПоНаименованию("Собран") Тогда
		Возврат "Статус заказа должен быть ""Собран"", чтобы разослать ТТН!";
	КонецЕсли;

	// Переадресованному заказу номер ТТН берём из обратной доставки исходного.
	Если Объект.ВидПереадресации = Перечисления.ВидыПереадресации.ПереадресованоСЗаказа
		И ПустаяСтрока(Объект.НомерТТН)
		И ЗначениеЗаполнено(Объект.ЗаказПереадресации) Тогда

		СтруктураОтвета = ОбменДаннымиСИСПеревозчиковОбщегоНазначения.ПолучитьСтатусНакладной(
			КлючAPIНовойПочты(), Объект.ЗаказПереадресации.НомерТТН,
			Объект.ЗаказПереадресации.ТелефонКонтрагента);

		Если СтруктураОтвета <> "" И ЗначениеЗаполнено(СтруктураОтвета.ТТНОбратнойДоставки) Тогда
			Объект.НомерТТН = СтруктураОтвета.ТТНОбратнойДоставки;
		КонецЕсли;

	КонецЕсли;

	Если Объект.ТипОбратнойДоставки.ГУИД = "Money"
		Или Объект.ТипОбратнойДоставки.Наименование = "КонтрольОплаты" Тогда
		Объект.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоНаименованию("ЦБ не получена");
	Иначе
		Объект.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Завершенные");
	КонецЕсли;

	Возврат "";

КонецФункции

// СМС с номером ТТН - по шаблону из констант, тем же сервисом, что и раньше.
//
&НаСервере
Процедура ОтправитьСМСОТТННаСервере()

	Если Не Константы.РассылкаТТНСПомощьюСМС.Получить()
		Или Не Объект.Контрагент.Родитель.ОтправлятьСМС
		Или Не ЗначениеЗаполнено(Объект.НомерТТН) Тогда
		Возврат;
	КонецЕсли;

	Телефон = ФормированиеПечатныхФорм.ПолучитьТелефонДляНалоговойНакладной(Объект.ТелефонКонтрагента);

	Если Не ЗначениеЗаполнено(Телефон) Тогда
		Сообщить("Некорректно указан номер телефона!");
		Возврат;
	КонецЕсли;

	Док = ДокументПоФорме();

	ТекстСообщения = Константы.ШаблонСообщения.Получить();
	ТекстСообщения = ОбщийМодульПодписокНаСобытия.ШаблонСМСВТекст(ТекстСообщения, Док);

	ОтправитьСМСЧерезСервис(Телефон, ТекстСообщения, Справочники.ШаблоныСМС.ПустаяСсылка());

	// Дубль на основной телефон контрагента, если так настроено у группы.
	ОсновнойТелефон = ОбщегоНазначения.ПоправитьТелефон(
		ОбщегоНазначения.ТелефонКонтрагента(Объект.Контрагент));

	Если (Объект.Контрагент.Родитель.СМСПоОсновномуТелефону
			Или Объект.Контрагент.Родитель.Родитель.СМСПоОсновномуТелефону)
		И Объект.ТелефонКонтрагента <> ОсновнойТелефон Тогда

		ОтправитьСМСЧерезСервис(ОсновнойТелефон, ТекстСообщения, Справочники.ШаблоныСМС.ПустаяСсылка());

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОтправитьСМСЧерезСервис(Знач Телефон, Знач Текст, Знач Шаблон)

	Если Не ЗначениеЗаполнено(Телефон) Или ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	ИмяВходящегоФайла = КаталогВременныхФайлов() + "outsms.txt";
	ТекстовыйДокумент = Новый ТекстовыйДокумент;

	Если ЗначениеЗаполнено(Объект.АльфаИмя) Тогда
		Отправитель = СокрЛП(Объект.АльфаИмя.Наименование);
	Иначе
		Отправитель = СокрЛП(ОбщийМодульПодписокНаСобытия.АльфаИмяПоУмолчанию().Наименование);
	КонецЕсли;

	Если Константы.СМСКлаб.Получить() Тогда

		Логин  = Константы.ЛогинСМС.Получить();
		Пароль = Константы.ПарольСМС.Получить();

		Сервер = "www.smpp.smsclub.mobi";
		СтрокаПолучения = "/hfw_smpp_addon/httpsendsms.php?username=" + Логин + "&password=" + Пароль
			+ "&from=" + Отправитель + "&to=" + СокрЛП(Телефон)
			+ "&text=" + Строка(Base64ТекстаСМС(Текст));

		ОбщийМодульПодписокНаСобытия.ЗапросHTTP(СтрокаПолучения, Сервер, ИмяВходящегоФайла,
			ТекстовыйДокумент, Телефон);

		ЗаписатьИсториюСМС(Телефон, Текст, Шаблон);

	КонецЕсли;

	Если Константы.СМСЕМСторе.Получить() Тогда

		Логин  = Константы.СМСЕМСтрореЛогин.Получить();
		Пароль = Константы.СМСЕМСтрорePароль.Получить();
		Сервер = Константы.СМСЕМСтрорИД.Получить();

		ТелефонСКодом = Телефон;

		Если Лев(ТелефонСКодом, 2) <> "38" Тогда
			ТелефонСКодом = "38" + ТелефонСКодом;
		КонецЕсли;

		СтрокаПолучения = "/get.php?user=" + СокрЛП(Логин) + "&pass=" + СокрЛП(Пароль)
			+ "&num=" + ТелефонСКодом + "&sms=" + СокрЛП(Текст);

		Соединение = Новый HTTPСоединение(Сервер);
		Соединение.Получить(СтрокаПолучения, ИмяВходящегоФайла);

		ВходящийФайл = Новый Файл(ИмяВходящегоФайла);

		Если Не ВходящийФайл.Существует() Тогда
			Сообщить("Не удалось получить ответ с сервера");
			Возврат;
		КонецЕсли;

		Сообщить("SMS отправлена.");

		ЗаписатьИсториюСМС(ТелефонСКодом, Текст, Шаблон);

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьИсториюСМС(Знач Телефон, Знач Текст, Знач Шаблон)

	Запись = РегистрыСведений.ОтправленныеСообщения.СоздатьМенеджерЗаписи();
	Запись.Период  = ТекущаяДата();
	Запись.Заказ   = Объект.Ссылка;
	Запись.Телефон = Телефон;
	Запись.Шаблон  = Шаблон;
	Запись.Текст   = Текст;
	Запись.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Функция Base64ТекстаСМС(Знач Текст)

	ИмяФайла = КаталогВременныхФайлов() + "sms.txt";

	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.ANSI);
	Запись.Записать(СокрЛП(Текст));
	Запись.Закрыть();

	Возврат Base64Строка(Новый ДвоичныеДанные(ИмяФайла));

КонецФункции

