// СТРАНИЦА ОТПРАВКА СООБЩЕНИЙ

&НаСервере
Процедура ОткрытьСтраницуСообщенийНаСервере()

	Элементы.РамкаГруппыПриходБезналичныхДС.Заголовок = "Приход безналичных ДС за "
		+ Формат(ТекущаяДата(), "ДФ=MMMM.yyyy");

	ПриходБезналичныхДС.Загрузить(Справочники.БанковскиеСчета.ПолучитьВыпискуДляВыставленияСчета());
	ПриходБезналичныхДС1.Загрузить(ПриходБезналичныхДС.Выгрузить());

	Если ПриходБезналичныхДС.Количество() = 0 Или Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Счет = Документы.ЗаказПокупателя.ПолучительПоследнийСчет(Объект.Контрагент);

	Если Счет = Неопределено Или Не ЗначениеЗаполнено(Счет) Тогда
		Возврат;
	КонецЕсли;

	Если Не ПустаяСтрока(Счет.ШаблонСмс.Текст) Тогда

		ТекстСМС = Счет.ШаблонСмс.Текст;

		НайденнаяСтрока = ПриходБезналичныхДС.НайтиСтроки(Новый Структура("БанковскийСчет", Счет));

		Если НайденнаяСтрока.Количество() > 0 Тогда
			Элементы.ПриходБезналичныхДС.ТекущаяСтрока = НайденнаяСтрока[0].ПолучитьИдентификатор();
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриходБезналичныхДСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекущиеДанные = Элементы.ПриходБезналичныхДС.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВыбранныйБанковскийСчет = ТекущиеДанные.БанковскийСчет;

	ТекстШаблона = ШаблонСМССчетаНаСервере(ВыбранныйБанковскийСчет);

	Если ПустаяСтрока(ТекстШаблона) Тогда
		Сообщить("Для данного банковского счета не указан шаблон СМС!");
	Иначе
		ТекстСМС = ТекстШаблона;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ШаблонСМССчетаНаСервере(Знач Счет)

	Если Не ЗначениеЗаполнено(Счет) Или Не ЗначениеЗаполнено(Счет.ШаблонСМС) Тогда
		Возврат "";
	КонецЕсли;

	Возврат Счет.ШаблонСМС.Текст;

КонецФункции

