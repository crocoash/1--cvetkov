	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Серия имеет смысл только при размещении на складе.
	Если ТипЗнч(ТекущиеДанные.Размещение) <> Тип("СправочникСсылка.Склады") Тогда
		ТекущиеДанные.СерияНоменклатуры = ПредопределенноеЗначение("Справочник.СерииНоменклатуры.ПустаяСсылка");
	КонецЕсли;

