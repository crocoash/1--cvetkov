Функция ОбщегоНазначенияТекущаяДата()

	Возврат ТекущаяДата();

КонецФункции

&НаСервере
Функция ПроверитьВозможностьВыгрузкиНаСервере()

	ОстаткиРезервов = Документы.ЗаказПокупателя.РезервПоЗаказуОстаток(Объект.Ссылка);

	Если ОстаткиРезервов.Количество() > 0 Тогда
		Возврат "По заказу есть незакрытые резервы!";
	КонецЕсли;

	Если Объект.ОбъемныйВес = 0 Тогда
		Возврат "Объемный вес не может быть 0";
	КонецЕсли;

	Если ЧислоИзСуммы(Объект.СуммаНоваяПочта) = 0
		И (Объект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000009")
			Или Объект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000012")) Тогда
		Возврат "Сумма наложки не может быть 0";
	КонецЕсли;

	Если Объект.СтатусЗаказа <> Справочники.СтатусыЗаказов.НайтиПоНаименованию("Ожидает отправки") Тогда
		Возврат "Статус заказа должен быть ""Ожидает отправки"" для этой процедуры";
	КонецЕсли;

	Возврат "";

КонецФункции

// Выгрузка ТТН идёт обработкой обмена с ИС перевозчиков - она работает с
// обычными формами, поэтому вызывается на сервере через Попытка.
//
