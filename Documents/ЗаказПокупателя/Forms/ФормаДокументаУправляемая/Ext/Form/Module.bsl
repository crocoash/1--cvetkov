// Расшифровка резерва по колонкам "Остаток" и "Закреплённый резерв".
//
&НаКлиенте
Процедура ТабРезерваОстатокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Поле.Имя <> "ТабРезерваОстатокОстатокРозы"
		И Поле.Имя <> "ТабРезерваОстатокЗакрепленныйРезерв" Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;

	ОткрытьРасшифровкуРезерваНаСервере(ВыбраннаяСтрока);

КонецПроцедуры

&НаСервере
Процедура ОткрытьРасшифровкуРезерваНаСервере(ВыбраннаяСтрока)

	СтрокаТЗ = ТабРезерваОстаток.НайтиПоИдентификатору(ВыбраннаяСтрока);

	Если СтрокаТЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Расшифровка открывается общей обычной формой ФормаРасшифровкиРезерва.
	Попытка

		Форма = ПолучитьОбщуюФорму("ФормаРасшифровкиРезерва");

		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура",               СтрокаТЗ.Номенклатура);
		ПараметрыОтбора.Вставить("ХарактеристикаНоменклатуры", СтрокаТЗ.ХарактеристикаНоменклатуры);

		ТЗОстатки = РегистрыНакопления.ТоварыВРезервеНаСкладах.Остатки(, ПараметрыОтбора);
		ТЗОстатки.Сортировать("ДокументРезерва Возр");

		Для Каждого Строка Из ТЗОстатки Цикл

			НоваяСтрока = Форма.ТабличноеПоле1.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);

			НоваяСтрока.Заказ            = Строка.ДокументРезерва;
			НоваяСтрока.Контрагент       = Строка.ДокументРезерва.Контрагент;
			НоваяСтрока.СтатусЗаказа     = Строка.ДокументРезерва.СтатусЗаказа;
			НоваяСтрока.ДнейВСтатусе     = Документы.ЗаказПокупателя.ДнейВСтатусе(Строка.ДокументРезерва);
			НоваяСтрока.Номер            = Строка.ДокументРезерва.Номер;
			НоваяСтрока.Склад            = Строка.Склад;
			НоваяСтрока.СтатусПредоплаты = Документы.ЗаказПокупателя.СтатусПредоплаты(Строка.ДокументРезерва.Контрагент);

		КонецЦикла;

		ПараметрыОтбора.Вставить("НК", СтрокаТЗ.НК);
		Форма.ПараметрыСтроки = ПараметрыОтбора;

		Форма.Открыть();

	Исключение
		Сообщить("Расшифровка резерва открывается из старой формы заказа: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Закрепление резерва флажком в строке.
//
&НаКлиенте
Процедура ТабРезерваОстатокПриИзмененииФлажка(Элемент, Колонка)

	Если Колонка <> "ТабРезерваОстатокЗакрепитьРезерв" Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.ТабРезерваОстаток.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НужнаЗапись = ЗакрепитьРезервСтрокиНаСервере(ТекущиеДанные.ПолучитьИдентификатор());

	Если НужнаЗапись Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗакрепитьРезервСтрокиНаСервере(Идентификатор)

	СтрокаТЗ = ТабРезерваОстаток.НайтиПоИдентификатору(Идентификатор);

	Если СтрокаТЗ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Запись = РегистрыСведений.ЗакрепленныеРезервы.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, СтрокаТЗ);
	Запись.ЗаказПокупателя = СтрокаТЗ.ДокументРезерва;

	Если СтрокаТЗ.ЗакрепитьРезерв Тогда

		Запись.Записать();

		Если Не Объект.ЗакрепитьРезерв Тогда
			Объект.ЗакрепитьРезерв = Истина;
			Возврат Истина;
		КонецЕсли;

	Иначе

		Запись.Прочитать();

		Если Запись.Выбран() Тогда
			Запись.Удалить();
		КонецЕсли;

		Если ТабРезерваОстаток.НайтиСтроки(Новый Структура("ЗакрепитьРезерв", Истина)).Количество() = 0 Тогда
			Объект.ЗакрепитьРезерв = Ложь;
			Возврат Истина;
		КонецЕсли;

	КонецЕсли;

	Возврат Ложь;

КонецФункции

