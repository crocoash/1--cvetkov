Процедура СпособОтправкиПриИзменении(Элемент)

	АвтоЗаполнитьДоставкуНаСервере();
	НастроитьЭлементыНаСервере();

КонецПроцедуры

// Значения по умолчанию для отправки Новой почтой - как АвтоЗаполнить()
// в обычной форме.
//
&НаСервере
Процедура АвтоЗаполнитьДоставкуНаСервере()

	Если Объект.СпособОтправки <> Справочники.СпособыОтправки.НоваяПочта Тогда
		Возврат;
	КонецЕсли;

	Объект.ВидГруза                   = Справочники.ЛМ_ВидыГрузов.НайтиПоРеквизиту("ГУИД", "Cargo");
	Объект.ВидРасчетов                = Справочники.ЛМ_ФормыОплаты.НайтиПоРеквизиту("ГУИД", "Cash");
	Объект.ТехнологияДоставки         = Справочники.ЛМ_ТехнологииДоставки.НайтиПоРеквизиту("ГУИД", "WarehouseWarehouse");
	Объект.Плательщик                 = Справочники.ЛМ_ВидыПлательщиков.НайтиПоРеквизиту("ГУИД", "Recipient");
	Объект.ПлательщикОбратнойДоставки = Справочники.ЛМ_ВидыПлательщиковОбратнойДоставки.НайтиПоРеквизиту("ГУИД", "Recipient");

	Если Объект.Мест = 0 Тогда
		Объект.Мест = 1;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ЮрФизЛицо) Тогда
		Объект.ЮрФизЛицо = ВосстановитьЗначение("ПоследнееЮрфизЛицо");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТехнологияДоставкиПриИзменении(Элемент)

	ДанныеДоставкиБылиИзменены = Истина;
	НастроитьЭлементыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентДоставкиПриИзменении(Элемент)

	КонтрагентДоставкиПриИзмененииНаСервере();

КонецПроцедуры

&НаСервере
Процедура КонтрагентДоставкиПриИзмененииНаСервере()

	Если Не ЗначениеЗаполнено(Объект.КонтрагентДоставки) Тогда
		Объект.КонтактноеЛицоДоставки = Справочники.ЛМ_КонтактныеЛица.ПустаяСсылка();
		Возврат;
	КонецЕсли;

	Объект.Фамилия    = Объект.КонтрагентДоставки.Фамилия;
	Объект.Имя        = Объект.КонтрагентДоставки.Имя;
	Объект.Отчество   = Объект.КонтрагентДоставки.Отчество;
	Объект.Получатель = Объект.КонтрагентДоставки.Наименование;

	Если Объект.КонтактноеЛицоДоставки.Владелец <> Объект.КонтрагентДоставки Тогда
		ПодобратьКонтактноеЛицоДоставкиНаСервере();
	КонецЕсли;

КонецПроцедуры

