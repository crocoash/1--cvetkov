КонецПроцедуры

&НаКлиенте
Процедура ДействияФормыДействиеЗаполнитьИПровести(Команда)

	// Заполнять с проведением можно только документы текущей даты - оперативное
	// проведение переносит документ в конец дня.
	Если НачалоДня(Объект.Дата) <> НачалоДня(ОбщегоНазначенияТекущаяДата()) Тогда
		Предупреждение("Дата документа отличается от текущей. Оперативное проведение невозможно."
			+ Символы.ПС + "Документ заполнен не будет!");
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Ответ = Вопрос("В режиме заполнения с проведением документ будет проводиться оперативно."
			+ Символы.ПС + "Продолжить?", РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ЗаполнитьИПровестиНаСервере();

	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИПровестиНаСервере()

	Док = ДокументПоФорме();

	Если ОчищатьРазмещениеПередЗаполнением Тогда

		ОчиститьРазмещениеТабличнойЧасти(Док.Товары);

		Если глЗначениеПеременной("ИспользоватьВозвратнуюТару") Тогда
			ОчиститьРазмещениеТабличнойЧасти(Док.ВозвратнаяТара);
		КонецЕсли;

	КонецЕсли;

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВидимостьСерии",     Элементы.ТоварыСерияНоменклатуры.Видимость);
	СтруктураПараметров.Вставить("Авторезервирование", Авторезервирование);
	СтруктураПараметров.Вставить("Авторазмещение",     Авторазмещение);
	СтруктураПараметров.Вставить("СтратегияАвторезервированияПоЗаказам", СтратегияАвторезервированияПоЗаказам);

	Попытка
		Док.ЗаполнитьТабличныеЧастиПередПроведениемУпр(СтруктураПараметров);
	Исключение
		Сообщить("Заполнение перед проведением: " + ОписаниеОшибки());
	КонецПопытки;

	ДокументВФорму(Док);

КонецПроцедуры

&НаСервере
Процедура ОчиститьРазмещениеТабличнойЧасти(ТабличнаяЧасть)

	Для Каждого Строка Из ТабличнаяЧасть Цикл
		Строка.Размещение = Неопределено;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельТоварыДействиеОчиститьРазмещение(Команда)

	Если Объект.Товары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Вопрос("Очистить размещения в табличной части?", РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Да) = КодВозвратаДиалога.Да Тогда

		Для Каждого Строка Из Объект.Товары Цикл
			Строка.Размещение = Неопределено;
		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельВозвратнаяТараДействиеОчиститьРазмещение(Команда)

	Если Объект.ВозвратнаяТара.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Если Вопрос("Очистить размещения в табличной части?", РежимДиалогаВопрос.ДаНет, ,
		КодВозвратаДиалога.Да) = КодВозвратаДиалога.Да Тогда

		Для Каждого Строка Из Объект.ВозвратнаяТара Цикл
			Строка.Размещение = Неопределено;
		КонецЦикла;

	КонецЕсли;

КонецПроцедуры

