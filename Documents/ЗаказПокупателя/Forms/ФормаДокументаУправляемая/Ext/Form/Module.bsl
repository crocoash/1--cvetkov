// Обход страниц по кругу - как кнопки << и >> в обычной форме.
//
&НаКлиенте
Процедура ОсновныеДействияФормыДействие1(Команда)

	ИмяСтраницы = Элементы.ОсновнаяПанель.ТекущаяСтраница.Имя;

	Если ИмяСтраницы = "СтраницаРезерв" Тогда
		Следующая = Элементы.СтраницаНоваяПочта;
	ИначеЕсли ИмяСтраницы = "СтраницаОтправкаСообщений" Тогда
		Следующая = Элементы.СтраницаТовары;
	ИначеЕсли ИмяСтраницы = "СтраницаТовары" Тогда
		Следующая = Элементы.СтраницаРезерв;
	ИначеЕсли ИмяСтраницы = "СтраницаНоваяПочта" Тогда
		Следующая = Элементы.СтраницаОтправкаСообщений;
	Иначе
		Возврат;
	КонецЕсли;

	Элементы.ОсновнаяПанель.ТекущаяСтраница = Следующая;
	ОсновнаяПанельПриСменеСтраницы(Элементы.ОсновнаяПанель, Следующая);

КонецПроцедуры

&НаКлиенте
Процедура ОсновныеДействияФормыДействие2(Команда)

	ИмяСтраницы = Элементы.ОсновнаяПанель.ТекущаяСтраница.Имя;

	Если ИмяСтраницы = "СтраницаРезерв" Тогда
		Следующая = Элементы.СтраницаТовары;
	ИначеЕсли ИмяСтраницы = "СтраницаНоваяПочта" Тогда
		Следующая = Элементы.СтраницаРезерв;
	ИначеЕсли ИмяСтраницы = "СтраницаТовары" Тогда
		Следующая = Элементы.СтраницаОтправкаСообщений;
	ИначеЕсли ИмяСтраницы = "СтраницаОтправкаСообщений" Тогда
		Следующая = Элементы.СтраницаНоваяПочта;
	Иначе
		Возврат;
	КонецЕсли;

	Элементы.ОсновнаяПанель.ТекущаяСтраница = Следующая;
	ОсновнаяПанельПриСменеСтраницы(Элементы.ОсновнаяПанель, Следующая);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуАвтоСкидокНаСервере()

	ТаблицаАвтоСкидок.Очистить();

	БИАС.ЗагрузкаЗаказовРозетка();

	Для Каждого СтрокаТЧ Из Объект.Товары Цикл
		Если СтрокаТЧ.ПроцентАвтоматическихСкидок = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТаблицаАвтоСкидок.Добавить(), СтрокаТЧ);
	КонецЦикла;

	Для Каждого СтрокаТЧ Из Объект.Услуги Цикл
		Если СтрокаТЧ.ПроцентАвтоматическихСкидок = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ТаблицаАвтоСкидок.Добавить(), СтрокаТЧ);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеЗаполненостиДоставкиНаСервере()

	ЭтоСтраницаНовойПочты = Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаНоваяПочта;

	Если ЭтоСтраницаНовойПочты И ЗначениеЗаполнено(Объект.СкладНовойПочтыЗначение) Тогда
		Элементы.Получатель.ЦветФона = WebЦвета.ЗеленаяЛужайка;
	КонецЕсли;

	Если СтрНайти(Объект.АдресДоставки, "Проверить оплату") > 0
		Или СтрНайти(Объект.АдресДоставки, "Банковская карта") > 0 Тогда
		Элементы.АдресДоставки.ЦветФона = WebЦвета.Хаки;
	КонецЕсли;

КонецПроцедуры

