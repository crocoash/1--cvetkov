Процедура ПолучитьСтоимостьДоставкиНажатие(Элемент)

	ПолучитьСтоимостьДоставкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПолучитьСтоимостьДоставкиНаСервере()

	Если Не ЗначениеЗаполнено(Объект.ГородНовойПочтыЗначение) Тогда
		Возврат;
	КонецЕсли;

	СтруктураНастройки = Константы.ЛМ_НастройкиЗаполненияЭкспрессНакладнойПоУмолчанию.Получить().Получить();

	ТекущийВес = Объект.Вес;

	Если ТекущийВес = 0 Тогда
		Для Каждого СтрокаТЧ Из Объект.Товары Цикл
			ВесЕдиницы = СтрокаТЧ.Номенклатура.Вес;
			Если ВесЕдиницы = 0 Тогда
				ВесЕдиницы = СтрокаТЧ.Номенклатура.ВидНоменклатуры.Вес;
			КонецЕсли;
			ТекущийВес = ТекущийВес + ВесЕдиницы * СтрокаТЧ.Количество;
		КонецЦикла;
	КонецЕсли;

	Объект.СтоимостьДоставки = ОбменДаннымиСИСПеревозчиковОбщегоНазначения.ПолучитьСтоимостьДоставки(
		КлючAPIНовойПочты(), СтруктураНастройки, Объект.ГородНовойПочтыЗначение,
		ТекущийВес, Объект.ВидГруза, Объект.Мест, ИтогКоллекцииФормы(Объект.Товары, "Сумма"));

КонецПроцедуры

