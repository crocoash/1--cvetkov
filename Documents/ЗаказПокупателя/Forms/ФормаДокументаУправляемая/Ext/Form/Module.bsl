// Проверка монополии и конкуренции: спорные позиции предлагается удалить.
//
&НаКлиенте
Процедура ПроверитьМонополиюИКонкуренцию(Команда)

	Конфликты = НайтиКонфликтыЦеновыхГруппНаСервере();

	Если Конфликты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	КИндексуУдаления = Новый Массив;

	Для Каждого Конфликт Из Конфликты Цикл

		Ответ = Вопрос(Конфликт.Текст, РежимДиалогаВопрос.ДаНетОтмена);

		Если Ответ = КодВозвратаДиалога.Да Тогда
			КИндексуУдаления.Добавить(Конфликт.Индекс);
		ИначеЕсли Ответ = КодВозвратаДиалога.Отмена Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если КИндексуУдаления.Количество() > 0 Тогда
		УдалитьСтрокиТоваровНаСервере(КИндексуУдаления);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция НайтиКонфликтыЦеновыхГруппНаСервере()

	Результат = Новый Массив;

	Для Индекс = 0 По Объект.Товары.Количество() - 1 Цикл

		СтрокаТЧ = Объект.Товары[Индекс];

		ТекстОшибки = ПроверитьЦеновуюГруппуНаСервере(СтрокаТЧ.Номенклатура, Объект.Контрагент);

		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = ПроверитьХарактеристикуНаСервере(СтрокаТЧ.ХарактеристикаНоменклатуры, Объект.Контрагент);
		КонецЕсли;

		Если ПустаяСтрока(ТекстОшибки) Тогда
			Продолжить;
		КонецЕсли;

		Конфликт = Новый Структура;
		Конфликт.Вставить("Индекс", Индекс);
		Конфликт.Вставить("Текст", ТекстОшибки + Символы.ПС + Символы.ПС
			+ Строка(СтрокаТЧ.Номенклатура) + " " + Строка(СтрокаТЧ.ХарактеристикаНоменклатуры)
			+ Символы.ПС + " Удалим эту позицию из Заказа?");

		Результат.Добавить(Конфликт);

	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаСервере
Процедура УдалитьСтрокиТоваровНаСервере(Индексы)

	// Удаляем с конца, чтобы не сбить индексы.
	Для Сч = 1 По Индексы.Количество() Цикл
		Объект.Товары.Удалить(Индексы[Индексы.Количество() - Сч]);
	КонецЦикла;

	ОбновитьПодвалНаСервере();
	ОбновитьЗаголовкиСтраницНаСервере();

КонецПроцедуры

// Выбор заказа для переадресации: обычная форма показывала таблицу кандидатов
// общей формой ВыборИзТЗ. В управляемой форме подставляем лучший вариант
// (как кнопка "Обновить"), полный список остаётся в старой форме.
//
&НаКлиенте
Процедура ЗаказПодбораНачалоВыбора(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ОбновитьЗаказПодбораНаСервере();

	Если Не ЗначениеЗаполнено(ЗаказПодбора) Тогда
		Сообщить("Подходящих заказов из отказов не найдено.");
	КонецЕсли;

КонецПроцедуры
