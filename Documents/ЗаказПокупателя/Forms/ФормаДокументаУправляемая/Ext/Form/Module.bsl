&НаСервере
Процедура ТоварыПриОкончанииРедактированияНаСервере(Индекс)

	Док = ДокументПоФорме();

	Если Индекс >= 0 Тогда

		СтрокаТЧ = Док.Товары[Индекс];

		// Количество комплектующих для набора-комплекта.
		Если СтрокаТЧ.Номенклатура.ВидНоменклатуры.Код = "000000009" Тогда
			СтрокаТЧ.КоличествоНК = БИАС.ПолучитьКоличествоКомплектующихНК(СтрокаТЧ.ХарактеристикаНоменклатуры)
				* СтрокаТЧ.Количество;
		Иначе
			СтрокаТЧ.КоличествоНК = СтрокаТЧ.Количество;
		КонецЕсли;

	КонецЕсли;

	Док.ПересчитатьАвтоматическиеСкидки();

	ДокументВФорму(Док);

	ПересчитатьЦенуНКНаСервере(Объект.ТипЦен);

	ОбновитьПодвалНаСервере();
	ОбновитьЗаголовкиСтраницНаСервере();

КонецПроцедуры

// Цена набора-комплекта складывается из цен комплектующих.
//
&НаСервере
Процедура ПересчитатьЦенуНКНаСервере(НовыйТипЦен)

	Если Объект.Дата < Дата("20190615") Тогда
		Возврат;
	КонецЕсли;

	Док = ДокументПоФорме();

	Для Каждого СтрокаТЧ Из Док.Товары Цикл

		Если СтрокаТЧ.Номенклатура.ВидНоменклатуры.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Комплект Тогда
			Продолжить;
		КонецЕсли;

		Цена = 0;

		КомплектующиеНК = Новый ТаблицаЗначений;
		КомплектующиеНК.Колонки.Добавить("Комплектующая");
		КомплектующиеНК.Колонки.Добавить("ХарактеристикаКомплектующей");

		БИАС.ПолучитьКомплектующиеНК(СтрокаТЧ.ХарактеристикаНоменклатуры, КомплектующиеНК);

		Для Каждого СтрокаТЗ Из КомплектующиеНК Цикл
			Цена = Цена + Ценообразование.ПолучитьЦенуНоменклатуры(
				СтрокаТЗ.Комплектующая, СтрокаТЗ.ХарактеристикаКомплектующей, НовыйТипЦен, Объект.Дата);
		КонецЦикла;

		Попытка

			ХарактеристикаОбъект = СтрокаТЧ.ХарактеристикаНоменклатуры.ПолучитьОбъект();
			Комплектующие1Уровень = ХарактеристикаОбъект.Комплектующие_НК();

			Попытка
				Цена = Цена / ?(СтрокаТЧ.Номенклатура.ВидНоменклатуры.Код = "000000009",
					Комплектующие1Уровень.Количество(), 1);
			Исключение
				// комплектующих нет - цену оставляем как посчитали
			КонецПопытки;

			СтрокаТЧ.Цена = Цена;

			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТЧ, Док);

		Исключение
			// характеристика без состава - строку пропускаем
		КонецПопытки;

	КонецЦикла;

	ДокументВФорму(Док);

КонецПроцедуры

