// ВЫГРУЗКА В НОВУЮ ПОЧТУ, ПЕЧАТЬ БЛАНКОВ

&НаКлиенте
Процедура ОсновныеДействияФормыВыгрузитьНП(Команда)

	Объект.ДатаОтгрузки = ОбщегоНазначенияТекущаяДата();

	Если Не ЗначениеЗаполнено(Объект.СпособОтправки) Тогда
		Объект.СпособОтправки = ПредопределенноеЗначение("Справочник.СпособыОтправки.НоваяПочта");
		АвтоЗаполнитьДоставкуНаСервере();
	КонецЕсли;

	Если Не Записать() Тогда
		Возврат;
	КонецЕсли;

	ТекстОтказа = ПроверитьВозможностьВыгрузкиНаСервере();

	Если Не ПустаяСтрока(ТекстОтказа) Тогда
		Сообщить(ТекстОтказа);
		Возврат;
	КонецЕсли;

	ВыгрузитьВНовуюПочтуНаСервере();

	Прочитать();

	ЗаказСобранКлиент();

КонецПроцедуры

