Процедура ТелефонКонтрагентаПриИзменении(Элемент)

	ПолучательБылИзменен = Истина;

	Объект.ТелефонКонтрагента = ПреобразоватьТелефонНаСервере(Объект.ТелефонКонтрагента);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПреобразоватьТелефонНаСервере(Знач Телефон)

	Возврат ОбщегоНазначения.ПреобразоватьТелефон(Телефон);

КонецФункции

// Списки выбора города, отделения и получателя по истории контрагента.
//
&НаСервере
Процедура ЗаполнитьСпискиНППриОткрытии()

	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КонтрагентыНоваяПочта.Отделение КАК Отделение,
		|	КонтрагентыНоваяПочта.Город КАК Город
		|ИЗ
		|	Справочник.Контрагенты.НоваяПочта КАК КонтрагентыНоваяПочта
		|ГДЕ
		|	КонтрагентыНоваяПочта.Ссылка = &Контрагент";

	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);

	Результат = Запрос.Выполнить().Выгрузить();

	СписокГородов = Новый СписокЗначений;
	СписокСкладов = Новый СписокЗначений;

	Для Каждого Строка Из Результат Цикл

		Если ЗначениеЗаполнено(Строка.Город) И СписокГородов.НайтиПоЗначению(Строка.Город) = Неопределено Тогда
			СписокГородов.Добавить(Строка.Город);
		КонецЕсли;

		Если ЗначениеЗаполнено(Строка.Отделение) И СписокСкладов.НайтиПоЗначению(Строка.Отделение) = Неопределено Тогда
			СписокСкладов.Добавить(Строка.Отделение,
				СокрЛП(Строка.Отделение.Владелец) + " - " + СокрЛП(Строка.Отделение));
		КонецЕсли;

	КонецЦикла;

	Элементы.ГородНовойПочтыПредставление.СписокВыбора.Очистить();
	Для Каждого Элемент Из СписокГородов Цикл
		Элементы.ГородНовойПочтыПредставление.СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;

	Элементы.СкладНовойПочтыПредставление.СписокВыбора.Очистить();
	Для Каждого Элемент Из СписокСкладов Цикл
		Элементы.СкладНовойПочтыПредставление.СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;

	// Виды расчётов и плательщики - как в ПриОткрытии обычной формы.
	ЗаполнитьСписокСправочника(Элементы.ВидРасчетов.СписокВыбора, Справочники.ЛМ_ФормыОплаты);
	ЗаполнитьСписокСправочника(Элементы.Плательщик.СписокВыбора, Справочники.ЛМ_ВидыПлательщиков);
	ЗаполнитьСписокСправочника(Элементы.ПлательщикОбратнойДоставки.СписокВыбора,
		Справочники.ЛМ_ВидыПлательщиковОбратнойДоставки);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСправочника(Список, Менеджер)

	Список.Очистить();

	Выборка = Менеджер.Выбрать();

	Пока Выборка.Следующий() Цикл
		Список.Добавить(Выборка.Ссылка);
	КонецЦикла;

КонецПроцедуры

// Список получателей: сам контрагент и его контактные лица с телефонами.
//
&НаСервере
Процедура ЗаполнитьПолучателяНаСервере()

	Элементы.Получатель.СписокВыбора.Очистить();

	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	НаименованиеКонтрагента = СокрЛП(Строка(Объект.Контрагент));

	ВидыТелефонов = Новый Массив;
	ВидыТелефонов.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента);
	ВидыТелефонов.Добавить(Справочники.ВидыКонтактнойИнформации.ФаксОрганизации);
	ВидыТелефонов.Добавить(Справочники.ВидыКонтактнойИнформации.ФаксКонтрагента);

	Для Каждого Вид Из ВидыТелефонов Цикл

		Телефон = ОбщегоНазначения.ТелефонКонтрагентаПоВиду(Объект.Контрагент, Вид);

		Если ЗначениеЗаполнено(Телефон) Тогда
			Элементы.Получатель.СписокВыбора.Добавить(
				НаименованиеКонтрагента + " - " + Телефон,
				НаименованиеКонтрагента + " - " + Телефон);
		КонецЕсли;

	КонецЦикла;

	ЕстьКонтактноеЛицо = Ложь;

	Выборка = Справочники.КонтактныеЛицаКонтрагентов.Выбрать(, Объект.Контрагент);

	Пока Выборка.Следующий() Цикл

		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;

		ЕстьКонтактноеЛицо = Истина;

		Телефон = ОбщегоНазначения.ТелефонКонтрагентаПоВиду(Выборка.Ссылка,
			Справочники.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛицаКонтрагента);

		Если Не ЗначениеЗаполнено(Телефон) Тогда
			Телефон = ОбщегоНазначения.ТелефонКонтрагента(Объект.Контрагент);
		КонецЕсли;

		Элементы.Получатель.СписокВыбора.Добавить(
			СокрЛП(Строка(Выборка.Ссылка)) + " - " + Телефон,
			СокрЛП(Строка(Выборка.Ссылка)) + " - " + Телефон);

	КонецЦикла;

	Если ЕстьКонтактноеЛицо Тогда
		Элементы.Получатель.ЦветФона = WebЦвета.Фиолетовый;
	КонецЕсли;

КонецПроцедуры

// Получатель как контактное лицо или отдельный контрагент - перенос
// СохранитьПолучателя() обычной формы, выполняется после записи заказа.
//
&НаСервере
Процедура СохранитьПолучателяНаСервере(ТекущийОбъект)

	Если Не (ЗначениеЗаполнено(ТекущийОбъект.ТелефонКонтрагента)
		И ЗначениеЗаполнено(ТекущийОбъект.Контрагент)) Тогда
		Возврат;
	КонецЕсли;

	НайденПолучатель = Справочники.КонтактныеЛицаКонтрагентов.НайтиПоНаименованию(
		ТекущийОбъект.Получатель, Истина, , ТекущийОбъект.Контрагент);

	СоздаватьКонтрагента = ТекущийОбъект.Контрагент.Родитель.СоздатьНовогоКонтрагентаИзПолучателя
		Или ТекущийОбъект.Контрагент.Родитель.Родитель.СоздатьНовогоКонтрагентаИзПолучателя;

	Если СокрЛП(ТекущийОбъект.Получатель) <> СокрЛП(ТекущийОбъект.Контрагент.Наименование)
		И Не ЗначениеЗаполнено(НайденПолучатель)
		И Не СоздаватьКонтрагента
		И Не ТекущийОбъект.НеСохранятьКонтактноеЛицо Тогда

		Контакт = Справочники.КонтактныеЛицаКонтрагентов.СоздатьЭлемент();
		Контакт.Владелец     = ТекущийОбъект.Контрагент;
		Контакт.Наименование = ТекущийОбъект.Получатель;
		Контакт.Записать();

		Если ТекущийОбъект.ТелефонКонтрагента
			<> ОбщегоНазначения.ТелефонКонтрагента(ТекущийОбъект.Контрагент) Тогда

			Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			Запись.Объект       = Контакт.Ссылка;
			Запись.Вид          = Справочники.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛицаКонтрагента;
			Запись.Тип          = Перечисления.ТипыКонтактнойИнформации.Телефон;
			Запись.Представление = ТекущийОбъект.ТелефонКонтрагента;
			Запись.Записать();

		КонецЕсли;

	КонецЕсли;

	// Контрагент из получателя - если это включено у группы контрагента.
	Если Не СоздаватьКонтрагента Или Не ЗначениеЗаполнено(ТекущийОбъект.Получатель) Тогда
		Возврат;
	КонецЕсли;

	ЕстьПолучатель = БИАС.НайтиКонтрагентаПоНомеруТелефона(ТекущийОбъект.ТелефонКонтрагента);

	Если ЗначениеЗаполнено(ЕстьПолучатель) Тогда

		Если СокрЛП(Строка(ЕстьПолучатель)) <> СокрЛП(ТекущийОбъект.Получатель) Тогда
			КонтрагентОбъект = ЕстьПолучатель.ПолучитьОбъект();
			КонтрагентОбъект.Наименование       = СокрЛП(ТекущийОбъект.Получатель);
			КонтрагентОбъект.НаименованиеПолное = СокрЛП(ТекущийОбъект.Получатель);
			КонтрагентОбъект.Записать();
		КонецЕсли;

		Возврат;

	КонецЕсли;

	Родитель = Справочники.Контрагенты.НайтиПоКоду("000000463");

	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.ГруппаДоступаККонтрагенту = Справочники.ГруппыДоступаККонтрагентам.НайтиПоКоду("000000002");
	Контрагент.Наименование       = ТекущийОбъект.Получатель;
	Контрагент.НаименованиеПолное = ТекущийОбъект.Получатель;
	Контрагент.Покупатель         = Истина;
	Контрагент.Родитель           = Родитель;
	Контрагент.Записать();

	Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Договор.Владелец             = Контрагент.Ссылка;
	Договор.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("980");
	Договор.ВидДоговора          = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	Договор.Наименование         = "Основной";
	Договор.Организация          = Справочники.Организации.НайтиПоКоду("000000001");
	Договор.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом;
	Договор.Записать();

	Если ЗначениеЗаполнено(ТекущийОбъект.ТелефонКонтрагента) Тогда
		Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		Запись.Объект        = Контрагент.Ссылка;
		Запись.Вид           = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		Запись.Тип           = Перечисления.ТипыКонтактнойИнформации.Телефон;
		Запись.Представление = ТекущийОбъект.ТелефонКонтрагента;
		Запись.Записать();
	КонецЕсли;

КонецПроцедуры

// История отправок контрагента пополняется после записи заказа.
//
&НаСервере
Процедура ЗаписатьНПНаСервере(ТекущийОбъект)

	Если ТекущийОбъект.Контрагент.НЕСохранятьИсторию Или ТекущийОбъект.НеСохранятьКонтактноеЛицо Тогда
		Возврат;
	КонецЕсли;

	Если Не (ТекущийОбъект.СпособОтправки = Справочники.СпособыОтправки.НоваяПочта
		И ЗначениеЗаполнено(ТекущийОбъект.Контрагент)
		И ЗначениеЗаполнено(ТекущийОбъект.СкладНовойПочтыЗначение)
		И ЗначениеЗаполнено(ТекущийОбъект.ГородНовойПочтыЗначение)) Тогда
		Возврат;
	КонецЕсли;

	ЕстьПолучатель = ОбщегоНазначения.ПолучательВКонтрагентах(ТекущийОбъект.Получатель);

	Если ЗначениеЗаполнено(ЕстьПолучатель) Тогда
		КонтрагентСсылка = ЕстьПолучатель;
	Иначе
		КонтрагентСсылка = ТекущийОбъект.Контрагент;
	КонецЕсли;

	КонтрагентОбъект = КонтрагентСсылка.ПолучитьОбъект();
	ИнфаДоставки = КонтрагентОбъект.НоваяПочта.Добавить();
	ИнфаДоставки.Город     = ТекущийОбъект.ГородНовойПочтыЗначение;
	ИнфаДоставки.Отделение = ТекущийОбъект.СкладНовойПочтыЗначение;
	КонтрагентОбъект.Записать();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеОтправкиВАктивныхЗаказахНаСервере(ТекущийОбъект)

	Если Не ТекущийОбъект.Контрагент.Родитель.УстанавливатьФлагРезервПоКонтрагентуВЗаказе
		Или ТекущийОбъект.НеСохранятьКонтактноеЛицо Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Заказ Из АктивныеЗаказыКонтрагента(ТекущийОбъект.Контрагент, ТекущийОбъект.Номер) Цикл

		ЗаказОбъект = Заказ.ПолучитьОбъект();
		ЗаказОбъект.ТехнологияДоставки      = ТекущийОбъект.ТехнологияДоставки;
		ЗаказОбъект.АдресДоставкиНП         = ТекущийОбъект.АдресДоставкиНП;
		ЗаказОбъект.ГородНовойПочтыЗначение = ТекущийОбъект.ГородНовойПочтыЗначение;
		ЗаказОбъект.СкладНовойПочтыЗначение = ТекущийОбъект.СкладНовойПочтыЗначение;
		ЗаказОбъект.Получатель              = ТекущийОбъект.Получатель;
		ЗаказОбъект.ТелефонКонтрагента      = ТекущийОбъект.ТелефонКонтрагента;
		ЗаказОбъект.ПоследняяОплатаЗаказа   = ТекущийОбъект.ПоследняяОплатаЗаказа;
		ЗаказОбъект.Записать();

	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция АктивныеЗаказыКонтрагента(Знач Контрагент, Знач Номер)

	СписокСтатусов = Новый СписокЗначений;
	СписокСтатусов.Добавить("000000011");   // Продано
	СписокСтатусов.Добавить("000000001");   // Резерв
	СписокСтатусов.Добавить("000000005");   // Ожидает оплаты
	СписокСтатусов.Добавить("000000002");   // Ожидает отправки

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказПокупателя.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.НомерТТН = """"
		|	И ЗаказПокупателя.СтатусЗаказа.Код В (&СтатусЗаказа)
		|	И ЗаказПокупателя.Контрагент = &Контрагент
		|	И ЗаказПокупателя.Номер <> &Номер";

	Запрос.УстановитьПараметр("СтатусЗаказа", СписокСтатусов);
	Запрос.УстановитьПараметр("Контрагент",   Контрагент);
	Запрос.УстановитьПараметр("Номер",        Номер);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеИзАктивногоЗаказаНаСервере()

	Если Не ЗначениеЗаполнено(Объект.Контрагент)
		Или Не Объект.Контрагент.Родитель.УстанавливатьФлагРезервПоКонтрагентуВЗаказе Тогда
		Возврат;
	КонецЕсли;

	Заказы = АктивныеЗаказыКонтрагента(Объект.Контрагент, Объект.Номер);

	Если Заказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Заказ = Заказы[0];

	Объект.ТехнологияДоставки      = Заказ.ТехнологияДоставки;
	Объект.АдресДоставкиНП         = Заказ.АдресДоставкиНП;
	Объект.ГородНовойПочтыЗначение = Заказ.ГородНовойПочтыЗначение;
	Объект.СкладНовойПочтыЗначение = Заказ.СкладНовойПочтыЗначение;
	Объект.Получатель              = Заказ.Получатель;
	Объект.ТелефонКонтрагента      = Заказ.ТелефонКонтрагента;

КонецПроцедуры

// Подстановка отделения и получателя из последней отправки контрагента.
//
&НаСервере
Процедура ЗаполнитьДоставкуНаСервере()

	Если ЗначениеЗаполнено(Объект.СкладНовойПочтыЗначение)
		Или Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	КонтрагентОбъект = Объект.Контрагент.ПолучитьОбъект();

	Если КонтрагентОбъект.ЭтоДропер() Или КонтрагентОбъект.ЭтоМаркетплейс() Тогда
		Возврат;
	КонецЕсли;

	ПоследнийЗаказ = ПоследниеДанныеОтправкиНаСервере();

	Если Не ЗначениеЗаполнено(ПоследнийЗаказ) Тогда
		Возврат;
	КонецЕсли;

	Объект.СкладНовойПочтыЗначение = ПоследнийЗаказ.СкладНовойПочтыЗначение;
	Объект.ГородНовойПочтыЗначение = ПоследнийЗаказ.ГородНовойПочтыЗначение;

	Если Не ЗначениеЗаполнено(Объект.ТелефонКонтрагента) Тогда
		Объект.Получатель         = ПоследнийЗаказ.Получатель;
		Объект.ТелефонКонтрагента = ПоследнийЗаказ.ТелефонКонтрагента;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПоследниеДанныеОтправкиНаСервере()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказПокупателя.Дата КАК Дата,
		|	ЗаказПокупателя.Получатель КАК Получатель,
		|	ЗаказПокупателя.ТелефонКонтрагента КАК ТелефонКонтрагента,
		|	ЗаказПокупателя.ТехнологияДоставки КАК ТехнологияДоставки,
		|	ЗаказПокупателя.ГородНовойПочтыЗначение КАК ГородНовойПочтыЗначение,
		|	ЗаказПокупателя.СкладНовойПочтыЗначение КАК СкладНовойПочтыЗначение,
		|	ЗаказПокупателя.АдресДоставкиНП КАК АдресДоставкиНП
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.Контрагент = &Контрагент
		|	И ЗаказПокупателя.НомерТТН <> """"
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";

	Запрос.УстановитьПараметр("Контрагент", Объект.Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ТТН, СТАТУС ОТПРАВКИ, ВЕС И ОБЪЁМ

&НаКлиенте
Процедура ОбновитьСтатусНажатие(Элемент)

	ОбновитьСтатусОтправкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСтатусОтправкиНаСервере()

	Перевозчик      = Справочники.Перевозчики.НайтиПоНаименованию("Новая почта");
	НастройкиОбмена = ОбменДаннымиСИСПеревозчиковСервер.ПолучитьНастройкиОбменаДанными(Перевозчик);

	КлючAPI = Неопределено;

	Если Не НастройкиОбмена.Свойство("КлючAPI", КлючAPI) Тогда
		Возврат;
	КонецЕсли;

	СтруктураОтвета = СтатусНакладной(КлючAPI, Объект.НомерТТН);

	Если СтруктураОтвета = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.СтатусОтправки = СтруктураОтвета.СтатусДокумента;
	Объект.ДатаДоставки   = СтруктураОтвета.ДатаДоставки;
	Объект.ПричинаОтказа  = СтруктураОтвета.ПричинаОтказа;
	Объект.НомерТТНОбратнойДоставки = СтруктураОтвета.ТТНОбратнойДоставки;

	АдресДоставкиПоТТН = СтруктураОтвета.АдресДоставки;
	Объект.СтоимостьДоставки = СтруктураОтвета.СтоимостьДоставки;

	Если ЗначениеЗаполнено(Объект.НомерТТНОбратнойДоставки) Тогда

		СтруктураОбратной = СтатусНакладной(КлючAPI, Объект.НомерТТНОбратнойДоставки);

		Если СтруктураОбратной <> Неопределено Тогда
			Объект.СтатусОбратнойДоставки = СтруктураОбратной.СтатусДокумента;
			Объект.ДатаДоставки           = СтруктураОбратной.ДатаДоставки;
			АдресДоставкиПоТТН            = СтруктураОбратной.АдресДоставки;
		КонецЕсли;

	КонецЕсли;

	Объект.СрокХранения = Документы.ЗаказПокупателя.СрокХранения(Объект.ДатаДоставки);

	НастроитьЭлементыНаСервере();

КонецПроцедуры

&НаСервере
Функция СтатусНакладной(КлючAPI, Знач НомерНакладной)

	Если Не ЗначениеЗаполнено(НомерНакладной) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("НомерДок");
	ТЗ.Колонки.Добавить("Телефон");

	Строка = ТЗ.Добавить();
	Строка.НомерДок = НомерНакладной;

	Если Лев(Объект.ТелефонКонтрагента, 2) = "38" Тогда
		Строка.Телефон = Объект.ТелефонКонтрагента;
	Иначе
		Строка.Телефон = "38" + Объект.ТелефонКонтрагента;
	КонецЕсли;

	Ответ = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.СтатусНакладнойНов(КлючAPI, ТЗ);

	Если Ответ.Количество() > 0 Тогда
		Возврат Ответ[0];
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Процедура ПолучитьДатуДостаувкиНажатие(Элемент)

	ПолучитьДатуДоставкиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПолучитьДатуДоставкиНаСервере()

	ГородОтправитель = ГородОтправителяПоУмолчанию();

	Если Не ЗначениеЗаполнено(ГородОтправитель) Тогда
		Возврат;
	КонецЕсли;

	Объект.ДатаДоставки = ОбменДаннымиСИСПеревозчиковОбщегоНазначения.ПолучитьДатуДоставки(
		КлючAPIНовойПочты(), ГородОтправитель, Объект.ГородНовойПочтыЗначение, Объект.ДатаОтгрузки);

КонецПроцедуры

&НаСервере
Функция ГородОтправителяПоУмолчанию()

	СтруктураНастройки = Константы.ЛМ_НастройкиЗаполненияЭкспрессНакладнойПоУмолчанию.Получить().Получить();

	Если ТипЗнч(СтруктураНастройки) = Тип("Структура") И СтруктураНастройки.Свойство("Отправитель") Тогда
		Возврат СтруктураНастройки.Отправитель.Город;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервере
Функция КлючAPIНовойПочты()

	Перевозчик      = Справочники.Перевозчики.НайтиПоНаименованию("Новая почта");
	НастройкиОбмена = ОбменДаннымиСИСПеревозчиковСервер.ПолучитьНастройкиОбменаДанными(Перевозчик);

	КлючAPI = Неопределено;
	НастройкиОбмена.Свойство("КлючAPI", КлючAPI);

	Возврат КлючAPI;

КонецФункции

