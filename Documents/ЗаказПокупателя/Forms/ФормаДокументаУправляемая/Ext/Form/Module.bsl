&НаКлиенте
Процедура СкладНовойПочтыПредставлениеОкончаниеВводаТекста(Элемент, Текст, Значение, СтандартнаяОбработка)

	// В обычной форме процедура начиналась с Возврат - подбор отделения по тексту
	// отключён. Оставлено как есть.
	Возврат;

КонецПроцедуры

&НаКлиенте
Процедура ПолучательПриИзменении(Элемент)

	Если Не ЗначениеЗаполнено(Объект.Получатель) Тогда
		Возврат;
	КонецЕсли;

	ПолучательБылИзменен = Истина;

	Объект.Получатель = СокрЛП(Объект.Получатель);

	// Значение из списка выбора приходит как "Контакт - Телефон".
	Если СтрЧислоВхождений(Объект.Получатель, "-") > 0 Тогда
		РазобратьПолучателяИзСпискаНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура РазобратьПолучателяИзСпискаНаСервере()

	Части = ОбщегоНазначения.СоставныеПоРазделителю(Объект.Получатель, "-");

	Попытка
		Контакт = Части[0].Значение;
	Исключение
		Контакт = "";
	КонецПопытки;

	Попытка
		Телефон = Части[1].Значение;
	Исключение
		Телефон = "";
	КонецПопытки;

	Объект.Получатель         = СокрЛП(Контакт);
	Объект.ТелефонКонтрагента = ОбщегоНазначения.ПоправитьТелефон(Телефон);

	РазобратьПолучателяНаСервере(Объект.Получатель);

КонецПроцедуры

&НаКлиенте
Процедура ПолучательОкончаниеВводаТекста(Элемент, Текст, Значение, СтандартнаяОбработка)

	РазобратьПолучателяНаСервере(Текст);

КонецПроцедуры

// "Разбить" из обычной формы: ФИО получателя раскладывается по реквизитам.
//
&НаСервере
Процедура РазобратьПолучателяНаСервере(Знач Текст)

	Док = ДокументПоФорме();

	Попытка
		Док.Разбить(Текст);
	Исключение
		Сообщить("Не удалось разобрать ФИО получателя: " + ОписаниеОшибки());
	КонецПопытки;

	ДокументВФорму(Док);

КонецПроцедуры

