КонецПроцедуры

// Отбор по колонке "Остаток": она строковая вида "5 (2)", поэтому число
// вынимается разбором, как и в обычной форме.
//
&НаСервере
Процедура ОтборПоОстаткуНаСервере(ЕстьОстаток)

	Копия = ТабРезерваОстаток.Выгрузить();
	ТабРезерваОстаток.Очистить();

	Для Каждого Строка Из Копия Цикл

		Позиция = СтрНайти(Строка.ОстатокРозы, "(");

		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			СвободныйОстаток = Число(СокрП(Лев(Строка.ОстатокРозы, Позиция - 1)));
		Исключение
			СвободныйОстаток = 0;
		КонецПопытки;

		Попытка
			ОстатокРезерв = Число(СтрЗаменить(Сред(Строка.ОстатокРозы, Позиция + 1), ")", ""));
		Исключение
			ОстатокРезерв = 0;
		КонецПопытки;

		ЭтоРозы = Строка.Склад.Наименование = "Розы";

		Если ЕстьОстаток Тогда

			Если (СвободныйОстаток + ОстатокРезерв) <= 0 И Не ЭтоРозы Тогда
				Продолжить;
			КонецЕсли;

			Если СвободныйОстаток > 0 Или ОстатокРезерв > 0 Или ЭтоРозы Тогда
				ЗаполнитьЗначенияСвойств(ТабРезерваОстаток.Добавить(), Строка);
			КонецЕсли;

		Иначе

			Если СвободныйОстаток < 0 Или (СвободныйОстаток = 0 И ОстатокРезерв = 0) Тогда
				ЗаполнитьЗначенияСвойств(ТабРезерваОстаток.Добавить(), Строка);
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	РассчитатьИнфоФормулыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельРезервОтменаОтбора(Команда)

	ПоказатьВесьРезервНаСервере();

КонецПроцедуры

