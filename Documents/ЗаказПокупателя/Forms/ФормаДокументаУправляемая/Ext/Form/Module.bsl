&НаСервере
Функция ТекстДляКастыНаСервере()

	НомерЗаказа = ?(ЗначениеЗаполнено(Объект.НомерЗаказа2ССайта), Объект.НомерЗаказа2ССайта,
		Документы.ЗаказПокупателя.УбратьНоликиСлева(Объект.Номер));

	Текст = "Замовлення № " + НомерЗаказа + Символы.ПС + Символы.ПС;

	Для Каждого Строка Из ТабРезерваОстаток Цикл

		Характеристика = ХарактеристикаБезНабора(Строка.ХарактеристикаНоменклатуры);

		Текст = Текст + Характеристика.Владелец.Наименование + Символы.ПС
			+ Характеристика.Наименование + Символы.ПС;

		Если ЗначениеЗаполнено(Строка.СрокИзготовления) И Строка.СрокИзготовления <> "Виготовленно" Тогда
			Текст = Текст + "Готовність " + Строка.СрокИзготовления + Символы.ПС;
		КонецЕсли;

		СсылкаНаЗамеры = СсылкаНаТаблицуЗамеров(Характеристика);

		Если Не ПустаяСтрока(СсылкаНаЗамеры) Тогда
			Текст = Текст + СсылкаНаЗамеры + Символы.ПС;
		КонецЕсли;

		Текст = Текст + Символы.ПС;

	КонецЦикла;

	Текст = Текст + Символы.ПС + "Загальна вартість: " + ИтогКоллекцииФормы(ТабРезерваОстаток, "Сумма") + " Грн" + Символы.ПС;

	Возврат Текст;

КонецФункции

&НаСервереБезКонтекста
Функция ХарактеристикаБезНабора(Знач Характеристика)

	ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();

	Если ХарактеристикаОбъект.ЭтоХарактеристикаРучнойНК() Тогда
		Возврат ХарактеристикаОбъект.Комплектующие_НК()[0].ХарактеристикаКомплектующей;
	КонецЕсли;

	Возврат Характеристика;

КонецФункции

&НаСервереБезКонтекста
Функция СсылкаНаТаблицуЗамеров(Знач Характеристика)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	""http://cvetkovtm.com/assets/shop/sync/imgJpg/"" + ГруппаЦветовФотографии.Наименование КАК Ссылка
		|ИЗ
		|	Справочник.ГруппаЦветов.Фотографии КАК ГруппаЦветовФотографии
		|ГДЕ
		|	ГруппаЦветовФотографии.Ссылка.Наименование = &Наименование
		|	И ГруппаЦветовФотографии.Ссылка.Владелец = &Владелец
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка";

	Запрос.УстановитьПараметр("Владелец",     Характеристика.Владелец);
	Запрос.УстановитьПараметр("Наименование", "Замеры");

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Строка(Выборка.Ссылка);
	КонецЕсли;

	Возврат "";

КонецФункции

// Текст для клиента: данные собирает 1С, формулировки и эмодзи - сайт.
// Логика сценариев не менялась (см. комментарий в старой форме).
//
&НаКлиенте
Процедура КоманднаяПанельТабРезерваОстатокОплата(Команда)

	Результат = ТекстДляКлиентаНаСервере();

	Если Не Результат.Успех Тогда
		Предупреждение("Не удалось получить текст для клиента." + Символы.ПС + Результат.Сообщение);
		Возврат;
	КонецЕсли;

	СкопироватьВБуфер(Результат.Текст);

	Сообщить("Текст для клиента скопирован в буфер обмена");

	Если Не ПустаяСтрока(Результат.Ссылка) Тогда
		Сообщить("Если эмодзи не вставились - открой " + Результат.Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ТекстДляКлиентаНаСервере()

	НомерЗаказа = ?(ЗначениеЗаполнено(Объект.НомерЗаказа2ССайта), Объект.НомерЗаказа2ССайта,
		Документы.ЗаказПокупателя.УбратьНоликиСлева(Объект.Номер));

	Позиции = Новый Массив;

	Для Каждого Строка Из ТабРезерваОстаток Цикл

		Характеристика = ХарактеристикаБезНабора(Строка.ХарактеристикаНоменклатуры);

		Готовность = "";

		Если ЗначениеЗаполнено(Строка.СрокИзготовления) И Строка.СрокИзготовления <> "Виготовленно" Тогда
			Готовность = Строка(Строка.СрокИзготовления);
		КонецЕсли;

		Позиция = Новый Структура;
		Позиция.Вставить("name",        Строка(Характеристика.Владелец.Наименование));
		Позиция.Вставить("variant",     Строка(Характеристика.Наименование));
		Позиция.Вставить("ready",       Готовность);
		Позиция.Вставить("measure_url", СсылкаНаТаблицуЗамеров(Характеристика));

		Позиции.Добавить(Позиция);

	КонецЦикла;

	СуммаЗаказа = Объект.СуммаДокумента;

	Если СуммаЗаказа = 0 Тогда
		СуммаЗаказа = ИтогКоллекцииФормы(ТабРезерваОстаток, "Сумма");
	КонецЕсли;

	ЭтоОпт = Ложь;

	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		КонтрагентОбъект = Объект.Контрагент.ПолучитьОбъект();
		ЭтоОпт = КонтрагентОбъект.ЭтоОптовик() И Не КонтрагентОбъект.ЭтоМаруся();
	КонецЕсли;

	Оплачено = Документы.ЗаказПокупателя.СуммаОплатПоЗаказу(Объект.Ссылка);

	ЗаказОплачен = СуммаЗаказа > 0 И Оплачено >= СуммаЗаказа;
	НужнаОплата  = Не ЭтоОпт И Не ЗаказОплачен;

	РазмерПередоплаты = 150;
	СсылкаОплаты      = "";

	Если НужнаОплата Тогда

		Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
			Сообщить("Заказ ещё не записан - ссылку на оплату можно получить только по записанному заказу.");
		Иначе

			РезультатОплаты = ОплатаПоСсылке.ПолучитьСсылкуНаОплатуЗаказа(Объект.Ссылка, СуммаЗаказа);

			Если РезультатОплаты.Успех Тогда
				СсылкаОплаты = РезультатОплаты.Ссылка;
			Иначе
				Сообщить("Ссылка на оплату не получена: " + РезультатОплаты.Сообщение);
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	ЕстьПредоплата   = Не ЗаказОплачен И Оплачено > 0;
	ОсталосьОплатить = СуммаЗаказа - Оплачено;

	Если ЗаказОплачен Тогда
		Сценарий = "paid";
	ИначеЕсли ЭтоОпт Тогда
		Сценарий = "opt";
	ИначеЕсли ЕстьПредоплата Тогда
		Сценарий = ?(ПустаяСтрока(СсылкаОплаты), "advance", "advance_link");
	ИначеЕсли Не ПустаяСтрока(СсылкаОплаты) Тогда
		Сценарий = ?(СуммаЗаказа > РазмерПередоплаты, "pay_link", "pay_link_full");
	Иначе
		Сценарий = "no_link";
	КонецЕсли;

	Наложка = ЧислоИзСуммы(Объект.СуммаНоваяПочта);

	Если Наложка > РазмерПередоплаты
		И (Сценарий = "pay_link" Или Сценарий = "pay_link_full" Или Сценарий = "no_link") Тогда
		Наложка = Наложка - РазмерПередоплаты;
	КонецЕсли;

	ДанныеПолучателя = Новый Структура;
	ДанныеПолучателя.Вставить("known",  ЗначениеЗаполнено(Объект.ГородНовойПочтыЗначение));
	ДанныеПолучателя.Вставить("name",   Строка(Объект.Получатель));
	ДанныеПолучателя.Вставить("phone",  Строка(Объект.ТелефонКонтрагента));
	ДанныеПолучателя.Вставить("city",   Строка(Объект.ГородНовойПочтыЗначение.Наименование));
	ДанныеПолучателя.Вставить("branch", Строка(Объект.СкладНовойПочтыЗначение.Наименование));

	Данные = Новый Структура;
	Данные.Вставить("order",     Строка(НомерЗаказа));
	Данные.Вставить("sum",       СуммаЗаказа);
	Данные.Вставить("scenario",  Сценарий);
	Данные.Вставить("paid",      Оплачено);
	Данные.Вставить("rest",      ОсталосьОплатить);
	Данные.Вставить("advance",   РазмерПередоплаты);
	Данные.Вставить("pay_url",   СсылкаОплаты);
	Данные.Вставить("cod",       Наложка);
	Данные.Вставить("recipient", ДанныеПолучателя);
	Данные.Вставить("items",     Позиции);

	Возврат ОплатаПоСсылке.ПолучитьСсылкуНаТекстДляКлиента(Данные, Объект.Ссылка);

КонецФункции

