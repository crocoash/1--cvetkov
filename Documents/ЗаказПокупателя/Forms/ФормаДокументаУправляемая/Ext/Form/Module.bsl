// Заказ покупателя - управляемая форма документа.
//
// Перенесена с обычной формы (Forms/ФормаДокумента, Form.bin): те же 9 страниц,
// те же поля и колонки, та же логика. Обычная форма из конфигурации НЕ удалена -
// чтобы вернуться, достаточно переключить DefaultObjectForm в
// Documents/ЗаказПокупателя.xml обратно на Form.ФормаДокумента; на самой форме
// для этого же есть кнопка "Старая форма", открывающая старую форму этого заказа.
//
// Что изменилось по сравнению с обычной формой и почему:
//
// 1. Вся работа с данными ушла на сервер. В управляемой форме Справочники,
//    Документы, Константы, запросы и типовые общие модули (ОбработкаТабличныхЧастей,
//    Ценообразование, ЗаполнениеДокументов, БИАС и прочие) доступны только на
//    сервере, поэтому каждый обработчик - тонкий клиентский вызов серверной
//    процедуры. Типовые процедуры ждут настоящий ДокументОбъект, а не данные
//    формы, поэтому сервер берёт его через РеквизитФормыВЗначение("Объект"),
//    работает с ним и возвращает обратно ЗначениеВРеквизитФормы.
//
// 2. Общий модуль РаботаСДиалогами (и ПроцедурыПоискаПоСтроке,
//    РаботаСТорговымОборудованием) компилируется только в клиенте обычного
//    приложения - из управляемой формы он недоступен в принципе. Всё, что он
//    делал с внешним видом (видимость колонок и полей, надписи, заголовки
//    страниц), переписано здесь напрямую. Всё, что он открывал (подбор
//    номенклатуры, проверка штрихкодов, "Цены и валюта", состав набора,
//    групповое изменение ТЧ, файлы, свойства) - это обычные формы, и они
//    открываются через старую форму заказа: см. ОткрытьВСтаройФорме.
//
// 3. У управляемой таблицы нет события ПриВыводеСтроки, поэтому колонки,
//    которые обычная форма рисовала в момент вывода (Код, Артикул, Всего,
//    Сумма без скидок, Цена мелкий опт, суммы плановой себестоимости),
//    в таблицах товаров/услуг/тары не выводятся: реквизитов ТЧ у них нет.
//    Раскраска строк резерва по остатку сохранена - таблица резерва живёт
//    в реквизите формы, и цвет ставится условным оформлением по колонкам
//    Количество1/Количество2, которые считает ПересчитатьТабРезерва.
//
// 4. Сканер штрихкода и терминал сбора данных к управляемой форме не
//    подключаются: событие ВнешнееСобытие есть только у обычной формы.
//    Сборка по штрихкоду остаётся в старой форме.
//
// Модальные Вопрос/Предупреждение/ВвестиСтроку используются как в оригинале -
// в конфигурации ModalityUseMode = Use.

&НаКлиенте
Перем ДатаДо;

&НаКлиенте
Перем ПолучательБылИзменен;

&НаКлиенте
Перем ДанныеДоставкиБылиИзменены;

&НаКлиенте
Перем ТекХарактеристика;

&НаКлиенте
Перем ВыбранныйБанковскийСчет;

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНОЕ: МОСТ К ТИПОВЫМ ПРОЦЕДУРАМ И К СТАРОЙ ФОРМЕ

// Типовые процедуры конфигурации написаны под ДокументОбъект, а на управляемой
// форме лежат данные формы. Эти две функции - единственный способ отдать им
// настоящий объект и забрать изменения назад.
//
&НаСервере
Функция ДокументПоФорме()

	Возврат РеквизитФормыВЗначение("Объект");

КонецФункции

&НаСервере
Процедура ДокументВФорму(Док)

	ЗначениеВРеквизитФормы(Док, "Объект");

КонецПроцедуры

// Операции, которые живут в обычных формах (подбор номенклатуры, проверка
// штрихкодов, цены и валюта, состав набора, файлы, свойства): открываем старую
// форму этого же заказа, дальше пользователь работает в ней.
//
&НаКлиенте
Процедура ОткрытьВСтаройФорме(Пояснение = "")

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Предупреждение("Сначала запишите заказ - старая форма открывается по записанному документу.");
		Возврат;
	КонецЕсли;

	Если Модифицированность Тогда
		Если Вопрос("Заказ изменён. Записать перед открытием старой формы?",
			РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			Если Не Записать() Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если Не ПустаяСтрока(Пояснение) Тогда
		Сообщить(Пояснение);
	КонецЕсли;

	// Обычные формы живут в клиенте обычного приложения, поэтому сначала пробуем
	// открыть форму прямо отсюда. Если платформа не даст - пробуем с сервера,
	// и только потом говорим пользователю, что делать руками.
	Попытка
		Объект.Ссылка.ПолучитьФорму("ФормаДокумента").Открыть();
		Возврат;
	Исключение
		ОшибкаКлиента = ОписаниеОшибки();
	КонецПопытки;

	Если ОткрытьСтаруюФормуНаСервере(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Предупреждение(
		"Старая форма заказа отсюда не открылась." + Символы.ПС + ОшибкаКлиента + Символы.ПС + Символы.ПС
		+ "Чтобы вернуться на неё совсем: в Documents/ЗаказПокупателя.xml поставить"
		+ Символы.ПС + "DefaultObjectForm = Document.ЗаказПокупателя.Form.ФормаДокумента"
		+ Символы.ПС + "и загрузить конфигурацию из файлов.");

КонецПроцедуры

&НаСервере
Функция ОткрытьСтаруюФормуНаСервере(Ссылка)

	Попытка
		Ссылка.ПолучитьФорму("ФормаДокумента").Открыть();
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура СтараяФорма(Команда)

	ОткрытьВСтаройФорме();

КонецПроцедуры

// Индекс текущей строки таблицы - то, что можно передать на сервер вместо самой
// строки данных формы.
//
&НаКлиенте
Функция ИндексТекущейСтроки(ИмяТаблицы)

	ТекущиеДанные = Элементы[ИмяТаблицы].ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат -1;
	КонецЕсли;

	Возврат Объект[ИмяТаблицы].Индекс(ТекущиеДанные);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ОБЩЕГО НАЗНАЧЕНИЯ (СЕРВЕР)

&НаСервере
Функция МожноРассчитыватьАвтоматическиеСкидкиНаСервере()

	Док = ДокументПоФорме();
	Возврат Док.МожноРассчитыватьАвтоматическиеСкидки();

КонецФункции

&НаСервере
Процедура ПересчитатьАвтоматическиеСкидкиНаСервере()

	Док = ДокументПоФорме();
	Док.ПересчитатьАвтоматическиеСкидки();
	ДокументВФорму(Док);

	ОбновитьПодвалНаСервере();

КонецПроцедуры

// Подвал: суммы документа и информационная надпись об итогах.
// В обычной форме это делала ОбновитьПодвал() через ЭлементыФормы.Всего.Значение.
//
&НаСервере
Процедура ОбновитьПодвалНаСервере()

	Док = ДокументПоФорме();

	Всего    = Док.ПолучитьСуммуСНДС();
	ВсегоНДС = Док.ПолучитьСуммуНДС();

	СтоимостьОтправки = ИтогКоллекцииФормы(Объект.Товары, "СтоимостьОтправки");

	ВременнаяСтрока = "";

	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();

	Если ЗначениеЗаполнено(Объект.ВалютаДокумента)
		И Объект.ВалютаДокумента <> ВалютаРегламентированногоУчета Тогда

		ВременнаяСтрока = ВременнаяСтрока
			+ ЗаполнениеДокументов.КратностьДокумента(Док, ВалютаРегламентированногоУчета)
			+ Объект.ВалютаДокумента + " = "
			+ ЗаполнениеДокументов.КурсДокумента(Док, ВалютаРегламентированногоУчета)
			+ ВалютаРегламентированногоУчета + ", ";

	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.ТипЦен) Тогда
		ВременнаяСтрока = ВременнаяСтрока + "Тип цен: " + Объект.ТипЦен;
	Иначе
		ВременнаяСтрока = ВременнаяСтрока + "Тип цен: Не заполнено!";
	КонецЕсли;

	Если Объект.АвторасчетНДС Тогда
		ВременнаяСтрока = ВременнаяСтрока + " Автоматический расчет НДС.";
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.УсловиеПродаж) Тогда
		ВременнаяСтрока = ВременнаяСтрока + ", Условие продаж: " + Объект.УсловиеПродаж;
	КонецЕсли;

	Элементы.ИнфНадписьТоварыИтоги.Заголовок = ВременнаяСтрока;

	// Сумма взаиморасчётов - то, что обычная форма считала в ОбновлениеОтображения.
	Если Объект.КурсВзаиморасчетов = 0 Тогда
		СуммаВзаиморасчетов = 0;
	Иначе
		СуммаВзаиморасчетов = МодульВалютногоУчета.ПересчитатьИзВалютыВВалюту(
			НалоговыйУчет.ПолучитьСуммуДокументаСНДС(Док),
			Объект.ВалютаДокумента,
			Объект.ДоговорКонтрагента.ВалютаВзаиморасчетов,
			ЗаполнениеДокументов.КурсДокумента(Док, ВалютаРегламентированногоУчета),
			Объект.КурсВзаиморасчетов,
			ЗаполнениеДокументов.КратностьДокумента(Док, ВалютаРегламентированногоУчета),
			Объект.КратностьВзаиморасчетов);
	КонецЕсли;

	Элементы.ИнфНадписьКурса.Заголовок = "Курс: " + Строка(Объект.КурсВзаиморасчетов)
		+ " / " + Строка(Объект.КратностьВзаиморасчетов);

КонецПроцедуры

// Долг контрагента в информационной надписи.
//
&НаСервере
Процедура ОбновитьНадписьДолгаНаСервере()

	Долг = Документы.ЗаказПокупателя.ДолгКонтрагентаНаДату(Объект.Контрагент, ТекущаяДата());

	Элементы.ИнфНадписьДолга.Заголовок = ?(Долг >= 0, "Долг ", "Переплата ") + Строка(Долг);

	Если Долг > 30 Тогда
		Элементы.ИнфНадписьДолга.ЦветТекста = Новый Цвет(255, 0, 0);
	Иначе
		Элементы.ИнфНадписьДолга.ЦветТекста = Новый Цвет(0, 128, 0);
	КонецЕсли;

КонецПроцедуры

// Видимость и доступность - то, что в обычной форме делали УстановитьВидимость(),
// УстановитьДоступностьРеквизитовЮрЛица(), УстановитьВидимостьПолейСклада(),
// ОформитьПолеРегион() и вызовы РаботаСДиалогами.
//
&НаСервере
Процедура НастроитьЭлементыНаСервере()

	УчитыватьНДС = Объект.УчитыватьНДС;

	Элементы.ТоварыСтавкаНДС.Видимость = УчитыватьНДС;
	Элементы.ТоварыСуммаНДС.Видимость  = УчитыватьНДС;
	Элементы.УслугиСтавкаНДС.Видимость = УчитыватьНДС;
	Элементы.УслугиСуммаНДС.Видимость  = УчитыватьНДС;

	Элементы.ТоварыСуммаНДС.ТолькоПросмотр = Объект.АвторасчетНДС;
	Элементы.УслугиСуммаНДС.ТолькоПросмотр = Объект.АвторасчетНДС;

	// Серии видны только при обособленном учёте по заказам и разрешении резервировать по сериям.
	ОбособленныйУчет = ЗначениеЗаполнено(Объект.ДоговорКонтрагента)
		И Объект.ДоговорКонтрагента.ОбособленныйУчетТоваровПоЗаказамПокупателей;

	Элементы.ТоварыСерияНоменклатуры.Видимость = ОбособленныйУчет
		И Константы.ИспользоватьУказаниеСерийНоменклатурыПриРезервировании.Получить();

	// Услуги на комиссию не отдаём.
	Элементы.СтраницаУслуги.Видимость = Объект.ДоговорКонтрагента.ВидДоговора
		<> Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером;

	Элементы.СтраницаТара.Видимость = глЗначениеПеременной("ИспользоватьВозвратнуюТару");

	Элементы.СтраницаАвтоматическиеСкидки.Видимость = МожноРассчитыватьАвтоматическиеСкидкиНаСервере();

	ЭтоМаркетПлейс = ЭтоМаркетПлейсНаСервере();
	Элементы.ОткрытьЗаказ.Видимость              = ЭтоМаркетПлейс;
	Элементы.НаименованиеСсылкаНаЗаказ.Видимость = ЭтоМаркетПлейс;
	Элементы.СсылкаНаЗаказ.Видимость             = ЭтоМаркетПлейс;

	// Цену, сумму и скидку правит только тот, кому это разрешено.
	МожноМенятьЦену = УправлениеДопПравамиПользователей.РазрешитьРедактированиеЦенВДокументах();

	Элементы.ТоварыЦена.ТолькоПросмотр                 = Не МожноМенятьЦену;
	Элементы.ТоварыСумма.ТолькоПросмотр                = Не МожноМенятьЦену;
	Элементы.ТоварыПроцентСкидкиНаценки.ТолькоПросмотр = Не МожноМенятьЦену;
	Элементы.УслугиЦена.ТолькоПросмотр                 = Не МожноМенятьЦену;
	Элементы.УслугиСумма.ТолькоПросмотр                = Не МожноМенятьЦену;
	Элементы.УслугиПроцентСкидкиНаценки.ТолькоПросмотр = Не МожноМенятьЦену;
	Элементы.ВозвратнаяТараЦена.ТолькоПросмотр         = Не МожноМенятьЦену;
	Элементы.ВозвратнаяТараСумма.ТолькоПросмотр        = Не МожноМенятьЦену;

	// Дропшипер и тип цен показываются только при включённых константах.
	ДропшиперПоставщик = Константы.ДропшиперПоставщик.Получить();
	ДропшиперПосредник = Константы.ДропшиперПосредник.Получить();

	Элементы.Дропшипер.Видимость       = ДропшиперПоставщик Или ДропшиперПосредник;
	Элементы.НадписьДропшипер.Видимость = Элементы.Дропшипер.Видимость;

	Элементы.ТипЦен.Доступность = ЗначениеЗаполнено(Объект.Дропшипер);

	Если ДропшиперПосредник Тогда
		Элементы.НадписьДропшипер.Заголовок    = "Поставщик:";
		Элементы.ТипЦен.Видимость              = Истина;
		Элементы.надписьТипЦен.Видимость       = Истина;
		Элементы.ОплатилПоставщику.Видимость   = Истина;
	Иначе
		Элементы.НадписьДропшипер.Заголовок    = "Дропшипер:";
		Элементы.ТипЦен.Видимость              = Ложь;
		Элементы.надписьТипЦен.Видимость       = Ложь;
		Элементы.ОплатилПоставщику.Видимость   = Ложь;
	КонецЕсли;

	// Автоподбор заказа из отказов.
	ПоискСовпадения = Константы.ПоискСовпаденияПриОтказе.Получить();

	Элементы.НадписьАвтоподбор.Видимость = ПоискСовпадения;
	Элементы.ЗаказПодбора.Видимость      = ПоискСовпадения;
	Элементы.ПечатьБланков.Видимость     = ПоискСовпадения;
	Элементы.кнОбновить.Видимость        = ПоискСовпадения;

	Элементы.ВидПереадресации.Видимость   = ЗначениеЗаполнено(Объект.ВидПереадресации);
	Элементы.ЗаказПереадресации.Видимость = ЗначениеЗаполнено(Объект.ЗаказПереадресации);

	// Реквизиты юрлица.
	ЭтоЮрЛицо = Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;

	Элементы.КодЕДРПОУ.Видимость                 = ЭтоЮрЛицо;
	Элементы.ФормаСобственности.Видимость        = ЭтоЮрЛицо;
	Элементы.НадписьКодЕДРПОУ.Видимость          = ЭтоЮрЛицо;
	Элементы.НадписьФормаСобственности.Видимость = ЭтоЮрЛицо;

	// Адресная доставка: либо отделение, либо адрес.
	АдреснаяДоставка = Объект.ТехнологияДоставки.ГУИД = "WarehouseDoors"
		Или Объект.ТехнологияДоставки.ГУИД = "DoorsDoors";

	Элементы.СкладНовойПочтыПредставление.Видимость = Не АдреснаяДоставка;
	Элементы.АдресДоставкиНП.Видимость              = АдреснаяДоставка;
	Элементы.НадписьАдресДоставкиНП.Видимость       = АдреснаяДоставка;

	// Причина отказа - только для статусов "На возврате" и "Отказ".
	ПоказыватьПричину = Объект.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоКоду("000000006")
		Или Объект.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоКоду("000000008");

	Элементы.ПричинаОтказаИнфо.Видимость = ПоказыватьПричину;
	Элементы.ПричинаОтказа.Видимость     = ПоказыватьПричину;

	Элементы.НомерОбратнойДоставкиТТН.Видимость = Не ПустаяСтрока(Объект.НомерТТНОбратнойДоставки);
	Элементы.НомерТТН1.Видимость                = Не ПустаяСтрока(Объект.НомерТТНОбратнойДоставки);
	Элементы.НадписьСтатусОтправки.Видимость    = Не ПустаяСтрока(Объект.СтатусОбратнойДоставки);
	Элементы.СтатусОтправки1.Видимость          = Не ПустаяСтрока(Объект.СтатусОбратнойДоставки);

	// Наложку правим только при снятом флажке-замке.
	Элементы.СуммаНоваяПочта.ТолькоПросмотр = Не РедактироватьСуммуНоваяПочта
		И ЗначениеЗаполнено(Объект.НомерТТН);

	// Регион: пока не выбран достаточно глубокий уровень - поле подсвечено.
	УровеньРегиона = 0;

	Если ЗначениеЗаполнено(Объект.Регион) Тогда
		БИАС.ПолучитьУровеньВИерархии(УровеньРегиона, Объект.Регион);
	КонецЕсли;

	Если УровеньРегиона < 4 Тогда
		Элементы.Регион.ЦветФона = Новый Цвет(255, 255, 153);
	Иначе
		Элементы.Регион.ЦветФона = Новый Цвет();
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда

		Элементы.КомментарийКонтрагена.Заголовок = Объект.Контрагент.Комментарий;
		Элементы.ЧерныйСписок.Видимость          = Объект.Контрагент.ВЧерномСписке;

		Если ЗначениеЗаполнено(Объект.Контрагент.ДатаПоследнегоВизитаНаСайте) Тогда
			Элементы.Контрагент.ЦветФона = Новый Цвет(204, 255, 204);
		Иначе
			Элементы.Контрагент.ЦветФона = Новый Цвет();
		КонецЕсли;

	Иначе
		Элементы.ЧерныйСписок.Видимость = Ложь;
	КонецЕсли;

	Элементы.НадписьПочта.Видимость = (Не ЗначениеЗаполнено(Объект.АдресЭлектроннойПочтыКонтрагента)
		Или Найти(Объект.АдресЭлектроннойПочтыКонтрагента, "mail.ru") > 0)
		И Объект.ТипЦен.Код = "000000001";

	Если Объект.Плательщик.Наименование = "Отправитель" Тогда
		Элементы.Плательщик.ЦветФона = Новый Цвет(255, 82, 131);
	Иначе
		Элементы.Плательщик.ЦветФона = Новый Цвет();
	КонецЕсли;

	Элементы.ФормаКнопкаВыгрузитьНП.Доступность = Не Объект.НеВыгружатьНП;

	Если Объект.СуммаОплаты > 0 Тогда
		Элементы.НадписьСуммаОплаты.Заголовок = "частичная оплата: " + Строка(Объект.СуммаОплаты) + " грн";
	КонецЕсли;

	ОбновитьКнопкуПлатежаНаСервере();

КонецПроцедуры

&НаСервере
Функция ЭтоМаркетПлейсНаСервере()

	Док = ДокументПоФорме();
	Возврат Док.ЭтоМаркетПлэйс();

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ЖИЗНЕННЫЙ ЦИКЛ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() Тогда

		Если Не ЗначениеЗаполнено(Объект.Дата) Тогда
			Объект.Дата = ТекущаяДата();
		КонецЕсли;

		Если Объект.Вес = 0 Тогда
			Объект.Вес = 1;
		КонецЕсли;

		ТекущийПользователь = глЗначениеПеременной("глТекущийПользователь");

		Объект.СхемаРезервирования = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(
			ТекущийПользователь, "ОсновнаяСхемаРезервирования");
		Объект.СпособОтправки = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(
			ТекущийПользователь, "СпособОтправкиЗаказПокупателя");
		Объект.СтатусЗаказа = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(
			ТекущийПользователь, "СтатусЗаказа");
		Объект.ВидОплатыЗаказа = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(
			ТекущийПользователь, "ВидОплатыЗаказ");

		Объект.ИсточникЗначение = Справочники.ИсточникиИнформацииПриОбращенииПокупателей.НайтиПоКоду("000000016");
		Объект.АльфаИмя         = ОбщийМодульПодписокНаСобытия.АльфаИмяПоУмолчанию();

		Шаб = Справочники.ШаблоныСМС.Выбрать();

		Пока Шаб.Следующий() Цикл

			Если Не Шаб.Основной Тогда
				Продолжить;
			КонецЕсли;

			ШаблонСМС = Шаб.Ссылка;
			ТекстСМС  = ШаблонСМС.Текст;

			Прервать;

		КонецЦикла;

		АвтоЗаполнитьДоставкуНаСервере();
		ВидОплатыЗаказаНаСервере();

	КонецЕсли;

	ЗаполнитьСлужебныеРеквизитыНаСервере();
	НастроитьЭлементыНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ЗаполнитьСлужебныеРеквизитыНаСервере();
	НастроитьЭлементыНаСервере();

КонецПроцедуры

// Реквизиты формы, которых нет в документе: суммы подвала, признак редактирования
// наложки, ссылка на заказ автоподбора.
//
&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыНаСервере()

	ОбновитьПодвалНаСервере();
	ОбновитьНадписьДолгаНаСервере();

	ЗаказПодбораДокумент = Объект.ЗаказПодбораДокумент;

	Если ЗначениеЗаполнено(ЗаказПодбораДокумент) Тогда
		ЗаказПодбора = Строка(ЗаказПодбораДокумент);
	КонецЕсли;

	СуммаОплаты = Объект.СуммаОплаты;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПолучательБылИзменен       = Ложь;
	ДанныеДоставкиБылиИзменены = Ложь;

	ДатаДо = Объект.Дата;

	ПриОткрытииНаСервере();

	// Тяжёлое - списки Новой почты, получатель, доставка - после показа формы,
	// иначе карточка открывается заметно дольше (см. типовой профиль оптимизации).
	ПодключитьОбработчикОжидания("ДозаполнитьПослеОткрытия", 0.1, Истина);

КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()

	// Страница, с которой открывается заказ: у нового - товары, у записанного
	// с резервом - резерв, иначе новая почта. Так было в обычной форме.
	Если Объект.Ссылка.Пустая() Тогда

		Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаТовары;

	Иначе

		КоличествоРезервов = Документы.ЗаказПокупателя.КоличествоРезервовПоКонтрагенту(Объект.Контрагент);

		Если КоличествоРезервов > 0 И КоличествоРезервов < 250 Тогда
			Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаРезерв;
		Иначе
			Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаНоваяПочта;
		КонецЕсли;

	КонецЕсли;

	ОбновитьЗаголовкиСтраницНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДозаполнитьПослеОткрытия()

	ДозаполнитьПослеОткрытияНаСервере();
	ОсновнаяПанельПриСменеСтраницы(Элементы.ОсновнаяПанель, Элементы.ОсновнаяПанель.ТекущаяСтраница);

КонецПроцедуры

&НаСервере
Процедура ДозаполнитьПослеОткрытияНаСервере()

	ЗаполнитьСпискиНППриОткрытии();
	ЗаполнитьПолучателяНаСервере();

	Если Объект.Ссылка.Пустая() Тогда
		ЗаполнитьДоставкуНаСервере();
	КонецЕсли;

	НастроитьЭлементыНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовкиСтраницНаСервере()

	Элементы.СтраницаТовары.Заголовок = "Товары (" + Объект.Товары.Количество() + " поз.)";
	Элементы.СтраницаТара.Заголовок   = "Тара (" + Объект.ВозвратнаяТара.Количество() + " поз.)";
	Элементы.СтраницаУслуги.Заголовок = "Услуги (" + Объект.Услуги.Количество() + " поз.)";

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	// Флажки "получателя меняли" и "данные доставки меняли" живут на клиенте,
	// а нужны серверной части записи - передаём их параметрами записи.
	ПараметрыЗаписи.Вставить("ПолучательБылИзменен",       ПолучательБылИзменен = Истина);
	ПараметрыЗаписи.Вставить("ДанныеДоставкиБылиИзменены", ДанныеДоставкиБылиИзменены = Истина);

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	ТекущийОбъект.ТелефонКонтрагента = ОчиститьТелефон(ТекущийОбъект.ТелефонКонтрагента);

	Если ТекущийОбъект.ВидОплатыЗаказа = Перечисления.ВидОплатыЗаказ.НаложеныйПлатеж
		И Не (ТекущийОбъект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000012")
			Или ТекущийОбъект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000009")) Тогда

		ТекущийОбъект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000009");

	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущийОбъект.КонтрагентДоставки)
		И (Не ЗначениеЗаполнено(ТекущийОбъект.Фамилия) Или Не ЗначениеЗаполнено(ТекущийОбъект.Имя)) Тогда

		ТекущийОбъект.Фамилия  = ТекущийОбъект.КонтрагентДоставки.Фамилия;
		ТекущийОбъект.Имя      = ТекущийОбъект.КонтрагентДоставки.Имя;
		ТекущийОбъект.Отчество = ТекущийОбъект.КонтрагентДоставки.Отчество;

	КонецЕсли;

	Документы.ЗаказПокупателя.СортироватьТабЧасть(ТекущийОбъект.Товары);

	// Серии в ТЧ имеют смысл только при обособленном учёте по заказам.
	ОбособленныйУчет = ЗначениеЗаполнено(ТекущийОбъект.ДоговорКонтрагента)
		И ТекущийОбъект.ДоговорКонтрагента.ОбособленныйУчетТоваровПоЗаказамПокупателей;

	Если Не ОбособленныйУчет Тогда

		НайденаСерия = Ложь;

		Для Каждого СтрокаТЧ Из ТекущийОбъект.Товары Цикл

			Если Не ЗначениеЗаполнено(СтрокаТЧ.СерияНоменклатуры) Тогда
				Продолжить;
			КонецЕсли;

			СтрокаТЧ.СерияНоменклатуры = Справочники.СерииНоменклатуры.ПустаяСсылка();
			НайденаСерия = Истина;

		КонецЦикла;

		Если НайденаСерия Тогда
			Сообщить("По договору не ведется обособленный учет по заказам покупателей! Серия в табличной части будет очищена.",
				СтатусСообщения.Важное);
		КонецЕсли;

	КонецЕсли;

	Если ТекущийОбъект.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Ожидает оплаты") Тогда
		ТекущийОбъект.ДатаОплаты          = Дата(1, 1, 1);
		ТекущийОбъект.ИдентификацияЗаказа = Перечисления.ИдентификацияЗаказа.ПустаяСсылка();
	КонецЕсли;

	// Проверки, при которых записывать нельзя.
	Если ТекущийОбъект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.ПредоплатаНаКарту
		И ЧислоИзСуммы(ТекущийОбъект.СуммаНоваяПочта) > Всего Тогда

		Сообщить("При предоплате на карту сумма новой почты не может быть больше суммы заказа!!!",
			СтатусСообщения.Важное);
		Отказ = Истина;
		Возврат;

	КонецЕсли;

	Если Константы.ДропшиперПосредник.Получить()
		И ТекущийОбъект.Дропшипер.БыстрыйФильтр И ТекущийОбъект.Дропшипер.Поставщик Тогда

		СуммаНП = ЧислоИзСуммы(ТекущийОбъект.СуммаНоваяПочта);

		Если СуммаНП > Всего Тогда
			Сообщить("Сумма поставщика-дропшипера не может быть больше суммы заказа!!!", СтатусСообщения.Важное);
			Отказ = Истина;
			Возврат;
		ИначеЕсли СуммаНП = 0 Тогда
			Сообщить("Сумма поставщика-дропшипера не может быть равной 0!!!", СтатусСообщения.Важное);
			Отказ = Истина;
			Возврат;
		КонецЕсли;

	КонецЕсли;

	КонтрольОплаты = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000009");

	Если Константы.ДропшиперПоставщик.Получить() И ЗначениеЗаполнено(ТекущийОбъект.Дропшипер)
		И (ТекущийОбъект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоРеквизиту("ГУИД", "Money")
			Или КонтрольОплаты)
		И ЧислоИзСуммы(ТекущийОбъект.СуммаНоваяПочта) = 0 Тогда

		Сообщить("Сумма Новой Почты не может быть равной 0!!!", СтатусСообщения.Важное);
		Отказ = Истина;
		Возврат;

	КонецЕсли;

	Если ТекущийОбъект.Контрагент.Родитель = Справочники.Контрагенты.НайтиПоКоду("000004272")
		И Не ЗначениеЗаполнено(ТекущийОбъект.СсылкаНаЗаказ) Тогда

		Сообщить("Необходимо заполнить номер заказа с сайта2");
		Отказ = Истина;
		Возврат;

	КонецЕсли;

	Если ТекущийОбъект.ТипОбратнойДоставки.Код = "000000012"
		И Не ЗначениеЗаполнено(ТекущийОбъект.БанковскийСчетКонтрольОплаты) Тогда

		Сообщить("При контроле оплаты обязательно должен быть заполнен банковский счёт");
		Отказ = Истина;
		Возврат;

	КонецЕсли;

	// Предупреждения о переадресации - не блокируют запись.
	Если ТекущийОбъект.ВидПереадресации = Перечисления.ВидыПереадресации.ПереадресованоСЗаказа Тогда
		Сообщить("Заказ переадресован с отправки " + Строка(ТекущийОбъект.ЗаказПереадресации)
			+ " (" + ТекущийОбъект.ЗаказПереадресации.СтатусЗаказа.Наименование + "). Срок хранения - "
			+ ТекущийОбъект.ЗаказПереадресации.СрокХранения + " дней!!!", СтатусСообщения.Важное);
	КонецЕсли;

	Если ТекущийОбъект.ВидПереадресации = Перечисления.ВидыПереадресации.ПереадресованоНаЗаказ Тогда
		Сообщить("Заказ переадресован на отправку " + Строка(ТекущийОбъект.ЗаказПереадресации)
			+ " (" + ТекущийОбъект.СтатусЗаказа.Наименование + "). Срок хранения - "
			+ ТекущийОбъект.ЗаказПереадресации.СрокХранения + " дней!!!", СтатусСообщения.Важное);
	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущийОбъект.ДатаДоставки)
		И ТекущийОбъект.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Отказ") Тогда

		ТекущийОбъект.СрокХранения = ПросроченоДнейНаСервере(ТекущийОбъект.ДатаДоставки);

	КонецЕсли;

	Если ЗначениеЗаполнено(ТекущийОбъект.ЗаказПодбораДокумент)
		И ТекущийОбъект.ЗаказПодбораДокумент.ГородНовойПочтыЗначение = ТекущийОбъект.ГородНовойПочтыЗначение
		И ТекущийОбъект.ЗаказПодбораДокумент.СкладНовойПочтыЗначение = ТекущийОбъект.СкладНовойПочтыЗначение Тогда

		ЗаказПодбораОбъект = ТекущийОбъект.ЗаказПодбораДокумент.ПолучитьОбъект();
		ЗаказПодбораОбъект.ВидПереадресации   = Перечисления.ВидыПереадресации.ИзменениеДанных;
		ЗаказПодбораОбъект.ЗаказПереадресации = Документы.ЗаказПокупателя.ПустаяСсылка();
		ЗаказПодбораОбъект.СтатусЗаказа       = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Не удачные");
		ЗаказПодбораОбъект.Записать(РежимЗаписиДокумента.Проведение);

		ТекущийОбъект.НомерТТН           = ТекущийОбъект.ЗаказПодбораДокумент.НомерТТН;
		ТекущийОбъект.ВидПереадресации   = Перечисления.ВидыПереадресации.ИзменениеДанных;
		ТекущийОбъект.ЗаказПереадресации = ТекущийОбъект.ЗаказПодбораДокумент;

	КонецЕсли;

	СохранитьЗначение("Источник", ТекущийОбъект.ИсточникЗначение);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// То, что обычная форма делала в ПриЗаписи: сохранить получателя, историю
	// Новой почты и разнести данные отправки по активным заказам контрагента.
	НужноОбновитьАктивные = Ложь;

	Если ПараметрыЗаписи.Свойство("ПолучательБылИзменен") И ПараметрыЗаписи.ПолучательБылИзменен Тогда
		СохранитьПолучателяНаСервере(ТекущийОбъект);
		НужноОбновитьАктивные = Истина;
	КонецЕсли;

	Если ПараметрыЗаписи.Свойство("ДанныеДоставкиБылиИзменены") И ПараметрыЗаписи.ДанныеДоставкиБылиИзменены Тогда
		ЗаписатьНПНаСервере(ТекущийОбъект);
		НужноОбновитьАктивные = Истина;
	КонецЕсли;

	Если НужноОбновитьАктивные Тогда
		ОбновитьДанныеОтправкиВАктивныхЗаказахНаСервере(ТекущийОбъект);
	КонецЕсли;

	ЗакрытиеЗаказаНаСервере(ТекущийОбъект);

	ЗаполнитьСлужебныеРеквизитыНаСервере();
	НастроитьЭлементыНаСервере();
	ОбновитьЗаголовкиСтраницНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗакрытиеЗаказаНаСервере(ТекущийОбъект)

	Попытка
		ТекущийОбъект.ЗакрытиеЗаказа();
	Исключение
		Сообщить("Закрытие заказа: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	Если Объект.Дата <> ДатаДо И ЗначениеЗаполнено(ДатаДо) Тогда
		УстановитьПризнакПерераспределенияРезерва();
	КонецЕсли;

	ДатаДо = Объект.Дата;

	ПолучательБылИзменен       = Ложь;
	ДанныеДоставкиБылиИзменены = Ложь;

	Если Объект.Проведен И Элементы.ОсновнаяПанель.ТекущаяСтраница <> Элементы.СтраницаНоваяПочта Тогда
		Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаРезерв;
		ОсновнаяПанельПриСменеСтраницы(Элементы.ОсновнаяПанель, Элементы.СтраницаРезерв);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьПризнакПерераспределенияРезерва()

	Константы.НужноПерераспределитьРезерв.Установить(Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()

	// Обычная форма здесь снимала блокировку объекта и отключала торговое
	// оборудование. Управляемая форма блокировкой управляет сама, торговое
	// оборудование к ней не подключается.
	Возврат;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Изменен контрагент" И Объект.КонтрагентДоставки = Параметр Тогда

		ПодобратьКонтактноеЛицоДоставкиНаСервере();

	ИначеЕсли ИмяСобытия = "Изменили табчасть" Тогда

		ПересчитатьАвтоматическиеСкидкиНаСервере();

	ИначеЕсли ИмяСобытия = "РеализацияПровестиПлюс" И Параметр = Объект.Ссылка Тогда

		ПерейтиНаСтраницуПослеПроведения();

	ИначеЕсли ИмяСобытия = "МожноВыгрузить" Тогда

		Если Не ЗначениеЗаполнено(Объект.НомерТТН) Тогда
			ОсновныеДействияФормыВыгрузитьНП(Неопределено);
		Иначе
			РаспечататьТТННаСервере();
			СобранЗаказ();
		КонецЕсли;

	ИначеЕсли ИмяСобытия = "ЕдиничкаМожноВыгрузить" Тогда

		Объект.ОбъемныйВес = 4;
		ОсновныеДействияФормыВыгрузитьНП(Неопределено);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаСтраницуПослеПроведения()

	Если ЕстьРезервПоЗаказуНаСервере() Тогда
		Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаРезерв;
	Иначе
		Элементы.ОсновнаяПанель.ТекущаяСтраница = Элементы.СтраницаНоваяПочта;
	КонецЕсли;

	ОсновнаяПанельПриСменеСтраницы(Элементы.ОсновнаяПанель, Элементы.ОсновнаяПанель.ТекущаяСтраница);

КонецПроцедуры

&НаСервере
Функция ЕстьРезервПоЗаказуНаСервере()

	Если Не ЗначениеЗаполнено(Объект.СпособОтправки) Тогда
		Объект.СпособОтправки = Справочники.СпособыОтправки.НоваяПочта;
	КонецЕсли;

	ТЗОстатки = РегистрыНакопления.ТоварыВРезервеНаСкладах.Остатки(,
		Новый Структура("ДокументРезерва", Объект.Ссылка), "ДокументРезерва", "Количество");

	Возврат ТЗОстатки.Количество() > 0;

КонецФункции

&НаСервере
Процедура ПодобратьКонтактноеЛицоДоставкиНаСервере()

	Если Не ЗначениеЗаполнено(Объект.КонтрагентДоставки) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЛМ_КонтактныеЛица.Ссылка
		|ИЗ
		|	Справочник.ЛМ_КонтактныеЛица КАК ЛМ_КонтактныеЛица
		|ГДЕ
		|	ЛМ_КонтактныеЛица.Владелец = &Владелец
		|	И ЛМ_КонтактныеЛица.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("Владелец", Объект.КонтрагентДоставки);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Объект.КонтактноеЛицоДоставки = Выборка.Ссылка;
	КонецЕсли;

КонецПроцедуры

