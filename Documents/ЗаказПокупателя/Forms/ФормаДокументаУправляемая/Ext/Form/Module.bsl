// СТРАНИЦА РЕЗЕРВ

&НаСервере
Процедура ОткрытьСтраницуРезерваНаСервере()

	Если Объект.Проведен Тогда

		РезервПоКонтрагенту = Объект.Контрагент.Родитель.УстанавливатьФлагРезервПоКонтрагентуВЗаказе;

		Элементы.ТабРезерваОстаток.Видимость = Истина;
		Элементы.Резерв.Видимость            = Ложь;

		ЗаполнитьТабРезервНаСервере();

		Элементы.ТабРезерваОстатокДокументРезерва.Видимость = РезервПоКонтрагенту;

		РассчитатьИнфоФормулыНаСервере();

	Иначе

		Элементы.ТабРезерваОстаток.Видимость = Ложь;
		Элементы.Резерв.Видимость            = Истина;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабРезервНаСервере()

	ТабРезерваОстаток.Очистить();

	Параметр = ?(РезервПоКонтрагенту, Объект.Контрагент, Объект.Ссылка);

	ТабРезерва = Документы.ЗаказПокупателя.РезервПоЗаказуОстаток(Параметр);
	ТабРезерва.Сортировать("Номенклатура, ХарактеристикаНоменклатуры");

	Номер = 1;

	РодителиГрупп = Новый СписокЗначений;

	Для Каждого Строка Из ТабРезерва Цикл

		Если Строка.Количество < 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТабРезерваОстаток.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Номер = Номер;

		Номер = Номер + 1;

		Родитель = Строка.Номенклатура.ЦеноваяГруппа.Родитель;

		Если ЗначениеЗаполнено(Родитель) И РодителиГрупп.НайтиПоЗначению(Родитель) = Неопределено Тогда
			РодителиГрупп.Добавить(Родитель);
		КонецЕсли;

	КонецЦикла;

	Элементы.РодителиЦеновыхГрупп.СписокВыбора.Очистить();

	Для Каждого Элемент Из РодителиГрупп Цикл
		Элементы.РодителиЦеновыхГрупп.СписокВыбора.Добавить(Элемент.Значение);
	КонецЦикла;

	ПересчитатьТабРезерваНаСервере();

КонецПроцедуры

// Пересчёт таблицы резерва: свободный остаток, закреплённый резерв, готовность,
// цена со скидкой. Один в один ПересчитатьТабРезерва() обычной формы.
//
&НаСервере
Процедура ПересчитатьТабРезерваНаСервере()

	ОстатокРезерваИтог = 0;
	ГотовоИтог         = 0;

	СкладРозы         = Справочники.Склады.НайтиПоКоду("000000014");
	СкладДержавинская = Справочники.Склады.НайтиПоКоду("000000038");

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	НЕ Склады.ЭтоГруппа
		|	И Склады.Ссылка В ИЕРАРХИИ(&ГруппаСкладов)";

	Запрос.УстановитьПараметр("ГруппаСкладов", Справочники.Склады.НайтиПоКоду("000000037"));

	СкладыФилиалы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	Для Каждого СтрокаТЗ Из ТабРезерваОстаток Цикл

		СтрокаТЗ.ЗакрепитьРезерв = БИАС.РезервЗакреплен(СтрокаТЗ.ДокументРезерва,
			СтрокаТЗ.ХарактеристикаНоменклатуры, СтрокаТЗ.Номенклатура);

		ЗакрепленныйРезерв = БИАС.ПолучитьЗакрепленныйРезерв(СтрокаТЗ.ДокументРезерва,
			СтрокаТЗ.ХарактеристикаНоменклатуры, СтрокаТЗ.Номенклатура);

		СтрокаТЗ.ЗакрепленныйРезерв = "(" + Строка(ЗакрепленныйРезерв) + ")";

		ПараметрыОтбора = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры",
			СтрокаТЗ.Номенклатура, СтрокаТЗ.ХарактеристикаНоменклатуры);
		ПараметрыОтбора.Вставить("Склад", СкладРозы);
		ПараметрыОтбора.Вставить("Склад", СкладДержавинская);

		ОстатокСклад  = 0;
		ОстатокРезерв = 0;

		ТЗОстатки = РегистрыНакопления.ТоварыНаСкладах.Остатки(, ПараметрыОтбора,
			"Номенклатура, ХарактеристикаНоменклатуры");

		Если ТЗОстатки.Количество() > 0 Тогда
			ОстатокСклад = ТЗОстатки[0].Количество;
		КонецЕсли;

		ТЗОстатки = РегистрыНакопления.ТоварыВРезервеНаСкладах.Остатки(, ПараметрыОтбора,
			"Номенклатура, ХарактеристикаНоменклатуры");

		Если ТЗОстатки.Количество() > 0 Тогда
			ОстатокРезерв = ТЗОстатки[0].Количество;
		КонецЕсли;

		СвободныйОстаток = ОстатокСклад - ОстатокРезерв;

		Если СтрокаТЗ.Склад = СкладРозы Тогда
			СвободныйОстаток = СвободныйОстаток + СтрокаТЗ.Количество;
			ОстатокРезерв    = ОстатокРезерв    - СтрокаТЗ.Количество;
		КонецЕсли;

		Если ЗакрепленныйРезерв <> 0 Тогда
			Если ЗакрепленныйРезерв > ОстатокРезерв Тогда
				СвободныйОстаток = СвободныйОстаток - ЗакрепленныйРезерв + ОстатокРезерв;
				ОстатокРезерв    = 0;
			Иначе
				ОстатокРезерв = ОстатокРезерв - ЗакрепленныйРезерв;
			КонецЕсли;
		КонецЕсли;

		СтрокаТЗ.ОстатокРозы = Строка(СвободныйОстаток) + " (" + Строка(ОстатокРезерв) + ")";

		СтрокаТЗ.Количество1 = СвободныйОстаток - СтрокаТЗ.Количество;
		СтрокаТЗ.Количество2 = ОстатокРезерв - СтрокаТЗ.Количество - ?(СвободныйОстаток < 0, 0, СвободныйОстаток);
		СтрокаТЗ.Количество3 = СтрокаТЗ.Количество2 - ЗакрепленныйРезерв;

		Если СтрокаТЗ.Склад.Код = "000000023" Или СкладыФилиалы.Найти(СтрокаТЗ.Склад) <> Неопределено Тогда

			ОстатокСкладФилиалы  = ОбщегоНазначения.ОстатокНоменклатуры(СтрокаТЗ.Номенклатура,
				СкладыФилиалы, СтрокаТЗ.ХарактеристикаНоменклатуры, ТекущаяДата());
			ОстатокРезервФилиалы = ОбщегоНазначения.РезервНоменклатуры(СтрокаТЗ.Номенклатура,
				СкладыФилиалы, СтрокаТЗ.ХарактеристикаНоменклатуры, ТекущаяДата());

			СтрокаТЗ.ОстатокФилиалы = Строка(ОстатокСкладФилиалы - ОстатокРезервФилиалы)
				+ " (" + Строка(ОстатокРезервФилиалы) + ")";

		КонецЕсли;

		СтрокаТЗ.ЦеноваяГруппа = СтрокаТЗ.Номенклатура.ЦеноваяГруппа;
		СтрокаТЗ.ГруппаСкладов = СтрокаТЗ.Склад.Родитель;

		// Цена и готовность берутся из заказа, в котором лежит резерв.
		Если СтрокаТЗ.ДокументРезерва = Объект.Ссылка Тогда
			ТЧТовары   = Объект.Товары;
			ТипЦенСтроки = Объект.ТипЦен;
			ДатаСтроки = Объект.Дата;
			ВалютаСтроки = Объект.ВалютаДокумента;
			КурсСтроки = Объект.КурсВзаиморасчетов;
			КратностьСтроки = Объект.КратностьВзаиморасчетов;
			ДоговорСтроки = Объект.ДоговорКонтрагента;
		Иначе
			ТЧТовары   = СтрокаТЗ.ДокументРезерва.Товары;
			ТипЦенСтроки = СтрокаТЗ.ДокументРезерва.ТипЦен;
			ДатаСтроки = СтрокаТЗ.ДокументРезерва.Дата;
			ВалютаСтроки = СтрокаТЗ.ДокументРезерва.ВалютаДокумента;
			КурсСтроки = СтрокаТЗ.ДокументРезерва.КурсВзаиморасчетов;
			КратностьСтроки = СтрокаТЗ.ДокументРезерва.КратностьВзаиморасчетов;
			ДоговорСтроки = СтрокаТЗ.ДокументРезерва.ДоговорКонтрагента;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтрокаТЗ.НК) Тогда
			НайденныеСтроки = ТЧТовары.НайтиСтроки(Новый Структура("ХарактеристикаНоменклатуры", СтрокаТЗ.НК));
		Иначе
			НайденныеСтроки = ТЧТовары.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры",
				СтрокаТЗ.Номенклатура, СтрокаТЗ.ХарактеристикаНоменклатуры));
		КонецЕсли;

		Скидка    = 0;
		СтатусОпт = "";

		Если НайденныеСтроки.Количество() > 0 Тогда

			Если ТипЦенСтроки.Код = "000000001"
				И НайденныеСтроки[0].Номенклатура.ВидНоменклатуры.ТипНоменклатуры
					<> Перечисления.ТипыНоменклатуры.Комплект Тогда

				ТипЦенСтроки = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000014");

			КонецЕсли;

			Скидка = НайденныеСтроки[0].ПроцентСкидкиНаценки + НайденныеСтроки[0].ПроцентАвтоматическихСкидок;

			СтрокаТЗ.СрокИзготовления = ГотовностьСтрокиРезерва(СтрокаТЗ, НайденныеСтроки[0], СтатусОпт);
			СтрокаТЗ.СрокИзготовленияДобавленИзПодбора = НайденныеСтроки[0].СрокИзготовленияДобавленИзПодбора;

		КонецЕсли;

		ЦенаБезСкидки = Ценообразование.ПолучитьЦенуНоменклатуры(
			СтрокаТЗ.Номенклатура,
			СтрокаТЗ.ХарактеристикаНоменклатуры,
			ТипЦенСтроки,
			ДатаСтроки,
			СтрокаТЗ.Номенклатура.ЕдиницаХраненияОстатков,
			ВалютаСтроки,
			КурсСтроки,
			КратностьСтроки, ,
			ДоговорСтроки);

		СтрокаТЗ.Цена          = ЦенаБезСкидки * (1 - Скидка / 100);
		СтрокаТЗ.ЦенаБезСкидки = ЦенаБезСкидки;
		СтрокаТЗ.Сумма         = СтрокаТЗ.Цена * СтрокаТЗ.Количество;

		Если СтатусОпт = "1" Тогда
			ГотовоИтог = ГотовоИтог + СтрокаТЗ.Сумма;
		Иначе
			ОстатокРезерваИтог = ОстатокРезерваИтог + СтрокаТЗ.Сумма;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Готовность позиции: статус склада, дата пошива или дата изготовления.
//
&НаСервере
Функция ГотовностьСтрокиРезерва(СтрокаТЗ, СтрокаТовара, СтатусОпт)

	ХарактеристикаОбъект = СтрокаТЗ.ХарактеристикаНоменклатуры.ПолучитьОбъект();

	Попытка
		Предзаказ = ХарактеристикаОбъект.ПолучитьРостовку(Истина).ИгнорироватьНоль;
	Исключение
		Предзаказ = Ложь;
	КонецПопытки;

	СтатусОпт        = Справочники.Склады.ПолучитьСтатус(Истина, СтрокаТЗ.Склад, Предзаказ);
	СтатусГотовности = СтрокаТЗ.Склад.СтатусГотовности;

	Если СтатусОпт = "1" Тогда
		Возврат СтатусГотовности;
	КонецЕсли;

	СрокИзготовления      = Дата(1, 1, 1);
	СрокИзготовленияКонец = Дата(1, 1, 1);

	СрокПросрочен = СтрокаТовара.СрокИзготовления = Дата(1, 1, 1)
		Или СтрокаТовара.СрокИзготовления < ТекущаяДата();

	Если СтатусОпт = "2" И СрокПросрочен Тогда

		ДатаПошива = ХарактеристикаОбъект.ПолучитьДатуСНеПошит();

		Если ЗначениеЗаполнено(ДатаПошива) Тогда
			СрокИзготовления      = ДатаПошива.ДатаПОшиваНачало;
			СрокИзготовленияКонец = ДатаПошива.ДатаПОшиваКонец;
		КонецЕсли;

	ИначеЕсли СтатусОпт = "3" И СрокПросрочен Тогда

		ДатаИзготовления = ХарактеристикаОбъект.ПолучитьДатуИзготовления(Истина);

		Если ЗначениеЗаполнено(ДатаИзготовления) Тогда
			СрокИзготовления      = ДатаИзготовления.ДатаПОшиваНачало;
			СрокИзготовленияКонец = ДатаИзготовления.ДатаПОшиваКонец;
		КонецЕсли;

	Иначе

		СрокИзготовления      = СтрокаТовара.СрокИзготовления;
		СрокИзготовленияКонец = СтрокаТовара.СрокИзготовленияКонец;

	КонецЕсли;

	Если СтатусОпт = "0" И Не Предзаказ Тогда
		Возврат СтатусГотовности;
	ИначеЕсли СрокИзготовленияКонец <> Дата(1, 1, 1) И СрокИзготовления <> Дата(1, 1, 1)
		И СрокИзготовленияКонец <> СрокИзготовления Тогда
		Возврат Формат(СрокИзготовления, "ДФ=dd.MM") + " - " + Формат(СрокИзготовленияКонец, "ДФ=dd.MM");
	ИначеЕсли СрокИзготовления <> Дата(1, 1, 1) Тогда
		Возврат Формат(СрокИзготовления, "ДФ=dd.MM");
	КонецЕсли;

	Возврат ?(СтатусГотовности = "Списан (Брак)" И Предзаказ, "Виготовляється", СтатусГотовности);

КонецФункции

// Формулы предоплаты под таблицей резерва.
//
&НаСервере
Процедура РассчитатьИнфоФормулыНаСервере()

	ЭтоПлатформа = Объект.Контрагент.Родитель.Наименование = "Розница платформа";

	ИтогоРезерва  = ИтогКоллекцииФормы(ТабРезерваОстаток, "Сумма");
	Долг          = ?(ЭтоПлатформа, 0,
		Документы.ЗаказПокупателя.ДолгКонтрагентаНаДату(Объект.Контрагент, ТекущаяДата()));
	СуммаРезервов = Документы.ЗаказПокупателя.ПолучитьСуммуРезервовПоКонтрагенту(Объект.Контрагент);

	Окр1 = Перечисления.ПорядкиОкругления.Окр1;

	ВесьРезервМинусДолг = Ценообразование.ОкруглитьЦену(ИтогоРезерва + Долг, Окр1, Истина);
	Предоплата          = Ценообразование.ОкруглитьЦену(ИтогоРезерва * 0.3 + Долг, Окр1, Истина);
	ПредоплатаНаЧасть   = Ценообразование.ОкруглитьЦену(
		(СуммаРезервов - ИтогоРезерва) * 0.3 + ИтогоРезерва + Долг, Окр1, Истина);
	ОстатокРезерва      = Ценообразование.ОкруглитьЦену(СуммаРезервов - ИтогоРезерва, Окр1, Истина);

	ИтогоРезервСтрокой = ПреобразоватьСтроку(ИтогоРезерва);
	ДолгСтрокой        = ПреобразоватьСтроку(Долг);

	Элементы.НадписьИтогоРезерв.Заголовок = "Итого резерв: "
		+ СокрЛП(ИтогКоллекцииФормы(ТабРезерваОстаток, "Количество")) + " шт. на сумму "
		+ Строка(Ценообразование.ОкруглитьЦену(ИтогоРезерва, Окр1, Истина));

	ДолгБлизокКНулю = Долг < 4 И Долг > -2;

	// 30 %
	Если ДолгБлизокКНулю Тогда
		ИнфоФормула1 = ИтогоРезервСтрокой + " / 30% = " + ПреобразоватьСтроку(Предоплата) + " Грн до оплати";
	ИначеЕсли Предоплата < 20 Тогда
		ИнфоФормула1 = ПреобразоватьСтроку(Предоплата) + " Оплачен";
	Иначе
		ИнфоФормула1 = "(" + ИтогоРезервСтрокой + " / 30%) + (" + ДолгСтрокой + " Баланс) = "
			+ ПреобразоватьСтроку(Предоплата) + " Грн до оплати";
	КонецЕсли;

	// Часть резерва
	Если ОстатокРезерва > 0 Тогда
		ИнфоФормула2 = ПреобразоватьСтроку(ОстатокРезерва) + " - Виготовляється / 30% + "
			+ ИтогоРезервСтрокой + " Готово + "
			+ ?(ДолгБлизокКНулю, "", "(" + ДолгСтрокой + " Баланс)") + " = "
			+ ПреобразоватьСтроку(ПредоплатаНаЧасть) + " Грн до оплати";
	Иначе
		ИнфоФормула2 = "весь резерв тут";
	КонецЕсли;

	// 100 %
	Если ДолгБлизокКНулю Тогда
		ИнфоФормула = ПреобразоватьСтроку(ВесьРезервМинусДолг) + " Грн до оплати";
	ИначеЕсли ВесьРезервМинусДолг < 3 Тогда
		ИнфоФормула = ПреобразоватьСтроку(ВесьРезервМинусДолг) + " Оплачено";
	Иначе
		ИнфоФормула = ИтогоРезервСтрокой + " + (" + ДолгСтрокой + " Баланс) = "
			+ ПреобразоватьСтроку(ВесьРезервМинусДолг) + " Грн до оплати";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РезервПоКонтрагентуПриИзменении(Элемент)

	РезервПоКонтрагентуПриИзмененииНаСервере();

КонецПроцедуры

&НаСервере
Процедура РезервПоКонтрагентуПриИзмененииНаСервере()

	ЗаполнитьТабРезервНаСервере();

	Элементы.ТабРезерваОстатокДокументРезерва.Видимость = РезервПоКонтрагенту;

	РассчитатьИнфоФормулыНаСервере();

КонецПроцедуры

