// Имя колонки таблицы значений из имени элемента формы: элементы называются
// ТабРезерваОстаток<Колонка>.
//
&НаКлиенте
Функция ИмяКолонкиТаблицыРезерва(ИмяЭлемента)

	Возврат Сред(ИмяЭлемента, СтрДлина("ТабРезерваОстаток") + 1);

КонецФункции

&НаСервере
Процедура ОтборПоКолонкеНаСервере(ИмяКолонки, Идентификатор, Равно)

	СтрокаТЗ = ТабРезерваОстаток.НайтиПоИдентификатору(Идентификатор);

	Если СтрокаТЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Значение = СтрокаТЗ[ИмяКолонки];
	Исключение
		Возврат;   // отбор по служебной колонке (например, номеру строки) не поддерживаем
	КонецПопытки;

	Копия = ТабРезерваОстаток.Выгрузить();
	ТабРезерваОстаток.Очистить();

	Для Каждого Строка Из Копия Цикл
		Если (Равно И Строка[ИмяКолонки] = Значение) Или (Не Равно И Строка[ИмяКолонки] <> Значение) Тогда
			ЗаполнитьЗначенияСвойств(ТабРезерваОстаток.Добавить(), Строка);
		КонецЕсли;
	КонецЦикла;

	РассчитатьИнфоФормулыНаСервере();

КонецПроцедуры

