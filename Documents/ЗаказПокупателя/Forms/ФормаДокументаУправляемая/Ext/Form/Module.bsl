&НаКлиенте
Процедура ПриИзмененииДисконтнойКартыКлиент()

	ВладелецКарты = ВладелецДисконтнойКартыНаСервере(Объект.ДисконтнаяКарта);

	Если ЗначениеЗаполнено(ВладелецКарты) И ВладелецКарты <> Объект.Контрагент Тогда

		Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
			Ответ = КодВозвратаДиалога.Да;
		Иначе
			Ответ = Вопрос("У выбранной дисконтной карты владелец " + СокрЛП(ВладелецКарты) + "."
				+ Символы.ПС + "Изменить контрагента в документе?", РежимДиалогаВопрос.ДаНет);
		КонецЕсли;

		Если Ответ = КодВозвратаДиалога.Да Тогда
			Объект.Контрагент = ВладелецКарты;
			КонтрагентПриИзмененииНаСервере();
			ПриИнтерактивномИзмененииДоговораНаСервере();
		КонецЕсли;

	КонецЕсли;

	ПересчитатьАвтоматическиеСкидкиНаСервере();

КонецПроцедуры

