&НаКлиенте
Процедура РассчитатьОбъемКлиент()

	Объект.ОбъемныйВес = Объект.Высота * Объект.Ширина * Объект.Длина / 4000;

	ОбъемПриИзменении(Неопределено);

	Для Каждого Строка Из Объект.ПараметрыГрузов Цикл
		Строка.Высота = Объект.Высота;
		Строка.Ширина = Объект.Ширина;
		Строка.Длина  = Объект.Длина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура МестПриИзменении(Элемент)

	Если Объект.Мест > 1 Тогда

		Разница = Объект.Мест - Объект.ПараметрыГрузов.Количество();

		Если Разница > 0 Тогда
			Для Сч = 1 По Разница Цикл
				Объект.ПараметрыГрузов.Добавить();
			КонецЦикла;
		ИначеЕсли Разница < 0 Тогда
			Количество = Объект.ПараметрыГрузов.Количество();
			Для Сч = 1 По -Разница Цикл
				Объект.ПараметрыГрузов.Удалить(Количество - Сч);
			КонецЦикла;
		КонецЕсли;

	Иначе
		Объект.ПараметрыГрузов.Очистить();
	КонецЕсли;

	РассчитатьОбъемКлиент();
	ВесПриИзменении(Неопределено);
	ОбъемПриИзменении(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ВесПриИзменении(Элемент)

	Количество = Объект.ПараметрыГрузов.Количество();

	Если Количество = 0 Тогда
		Возврат;
	КонецЕсли;

	СреднийВес = Объект.Вес / Количество;

	Для Каждого Строка Из Объект.ПараметрыГрузов Цикл
		Строка.ФактическийВес = СреднийВес;
	КонецЦикла;

КонецПроцедуры

