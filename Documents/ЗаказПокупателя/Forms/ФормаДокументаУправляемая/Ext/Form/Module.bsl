		Объект.ИдентификацияЗаказа = Перечисления.ИдентификацияЗаказа.ПустаяСсылка();
	КонецЕсли;

	Если Объект.СтатусЗаказа.ПрименятьСхемуРезервирования
		И ЗначениеЗаполнено(Объект.СтатусЗаказа.СхемаРезервирования) Тогда

		Объект.СхемаРезервирования = Объект.СтатусЗаказа.СхемаРезервирования;

