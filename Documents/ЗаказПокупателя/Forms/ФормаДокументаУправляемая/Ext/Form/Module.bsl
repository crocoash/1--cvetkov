&НаКлиенте
Процедура Кнопка11Нажатие(Элемент)

	Оценка = "";

	Если ЗначениеЗаполнено(Объект.СуммаНоваяПочта) Тогда
		Оценка = "Накладний платіж " + Объект.СуммаНоваяПочта + " Грн";
	КонецЕсли;

	ДанныеПолучателя = Объект.Получатель + Символы.ПС
		+ Объект.ТелефонКонтрагента + Символы.ПС
		+ Объект.ГородНовойПочтыЗначение + Символы.ПС
		+ Объект.СкладНовойПочтыЗначение + Символы.ПС + Символы.ПС + Оценка;

	СкопироватьВБуфер(ДанныеПолучателя);

	Сообщить("Данные получателя скопированы в буфер обмена");

