&НаКлиенте
Процедура ОсновнаяПанельПриСменеСтраницы(Элемент, ТекущаяСтраница)

	ИмяСтраницы = ТекущаяСтраница.Имя;

	Если ИмяСтраницы = "СтраницаАвтоматическиеСкидки" Тогда

		ЗаполнитьТаблицуАвтоСкидокНаСервере();

	ИначеЕсли ИмяСтраницы = "СтраницаРезерв" Тогда

		ПоказатьВесьРезерв = Ложь;
		ОткрытьСтраницуРезерваНаСервере();

	ИначеЕсли ИмяСтраницы = "СтраницаОтправкаСообщений" Тогда

		ОткрытьСтраницуСообщенийНаСервере();

	КонецЕсли;

	ОбновитьСостояниеЗаполненостиДоставкиНаСервере();

КонецПроцедуры

