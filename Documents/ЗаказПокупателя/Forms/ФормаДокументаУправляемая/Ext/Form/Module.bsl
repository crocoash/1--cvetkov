	Если Не ЗначениеЗаполнено(Объект.ГородНовойПочтыЗначение) Тогда
		Предупреждение("Сначала нужно выбрать город!", 2, "Упс");
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.КонтрагентДоставки) Тогда
		Предупреждение("Сначала нужно выбрать получателя и записать документ!", 2, "Упс");
		Возврат;
	КонецЕсли;

	Если ЕстьУлицыГородаНаСервере(Объект.ГородНовойПочтыЗначение) Тогда
		Если Вопрос("Обновить улицы города?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ЗагрузитьУлицыНаСервере();

