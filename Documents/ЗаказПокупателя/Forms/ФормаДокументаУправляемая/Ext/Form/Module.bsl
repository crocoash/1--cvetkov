// Вид оплаты заказа задаёт статус, страховку, наложку, тип обратной доставки
// и банковский счёт контроля оплаты - один в один как в обычной форме.
//
&НаСервере
Процедура ВидОплатыЗаказаНаСервере()

	Объект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000012");
	Объект.СпособОтправки      = Справочники.СпособыОтправки.НайтиПоКоду("000000001");

	АвтоЗаполнитьДоставкуНаСервере();

	Если Объект.ВидОплатыЗаказа = Перечисления.ВидОплатыЗаказ.НаложеныйПлатеж Тогда

		Объект.Страховка200 = Ложь;
		ЗаполнитьНаложкуНаСервере(Объект.СуммаДокумента);
		Объект.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Ожидает отправки");

		Если Объект.Контрагент.Код = "000004317" Или Объект.СпособОтправки.Код = "000000006" Тогда
			Объект.БанковскийСчетКонтрольОплаты = Справочники.БанковскиеСчета.НайтиПоКоду("000000026");
		Иначе
			Объект.БанковскийСчетКонтрольОплаты = Объект.ТипОбратнойДоставки.БанковскийСчет;
		КонецЕсли;

	ИначеЕсли Объект.ВидОплатыЗаказа = Перечисления.ВидОплатыЗаказ.Предоплата Тогда

		Объект.СтатусЗаказа   = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Ожидает оплаты");
		Объект.Страховка200   = Ложь;
		Объект.СуммаНоваяПочта = Объект.СуммаДокумента - 150;
		Объект.БанковскийСчетКонтрольОплаты = Объект.ТипОбратнойДоставки.БанковскийСчет;

	ИначеЕсли Объект.ВидОплатыЗаказа = Перечисления.ВидОплатыЗаказ.Безналичный Тогда

		Объект.СтатусЗаказа        = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Ожидает оплаты");
		Объект.Страховка200        = Истина;
		Объект.СуммаНоваяПочта     = 0;
		Объект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.ПустаяСсылка();
		Объект.БанковскийСчетКонтрольОплаты = Справочники.БанковскиеСчета.ПустаяСсылка();

	ИначеЕсли Объект.ВидОплатыЗаказа = Перечисления.ВидОплатыЗаказ.Долг Тогда

		Объект.СтатусЗаказа        = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Ожидает отправки");
		Объект.Страховка200        = Ложь;
		Объект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.ПустаяСсылка();
		Объект.БанковскийСчетКонтрольОплаты = Справочники.БанковскиеСчета.ПустаяСсылка();
		Объект.СуммаНоваяПочта     = 0;

	ИначеЕсли Объект.ВидОплатыЗаказа = Перечисления.ВидОплатыЗаказ.Оплачен Тогда

		Объект.СтатусЗаказа        = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Ожидает отправки");
		Объект.Страховка200        = Истина;
		Объект.СуммаНоваяПочта     = 0;
		Объект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.ПустаяСсылка();
		Объект.БанковскийСчетКонтрольОплаты = Справочники.БанковскиеСчета.ПустаяСсылка();

	КонецЕсли;

	Если Объект.СтатусЗаказа.ПрименятьСхемуРезервирования Тогда
		Объект.СхемаРезервирования = Объект.СтатусЗаказа.СхемаРезервирования;
	КонецЕсли;

КонецПроцедуры

// Наложка оптовику считается с надбавкой 1,65% (комиссия), рознице - как есть.
//
&НаСервере
Процедура ЗаполнитьНаложкуНаСервере(Знач Сумма)

	Если Не ЗначениеЗаполнено(Объект.ТипЦен) Или Объект.ТипЦен.ПолучитьОбъект().ЭтоОптоваяЦена() Тогда
		Объект.ДваПроцентаУслуга = Сумма / 100 * 1.65;
		Объект.СуммаНоваяПочта   = Сумма + Объект.ДваПроцентаУслуга;
	Иначе
		Объект.СуммаНоваяПочта = Сумма;
	КонецЕсли;

