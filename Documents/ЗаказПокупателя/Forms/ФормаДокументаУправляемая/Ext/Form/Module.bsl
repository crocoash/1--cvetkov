	// В обычной форме выбор города через API Новой почты был закомментирован -
	// работает обычный выбор из справочника ЛМ_Города.
	Возврат;

КонецПроцедуры

&НаКлиенте
Процедура ГородНовойПочтыПредставлениеПриИзменении(Элемент)

	ДанныеДоставкиБылиИзменены = Истина;

	ГородНовойПочтыПриИзмененииНаСервере();

КонецПроцедуры

&НаСервере
Процедура ГородНовойПочтыПриИзмененииНаСервере()

	Если ЗначениеЗаполнено(Объект.КонтрагентДоставки)
		И ЗначениеЗаполнено(Объект.ГородНовойПочтыЗначение)
		И Объект.КонтрагентДоставки.Город <> Объект.ГородНовойПочтыЗначение Тогда

		КонтрагентОбъект = Объект.КонтрагентДоставки.ПолучитьОбъект();
		КонтрагентОбъект.Город = Объект.ГородНовойПочтыЗначение;
		КонтрагентОбъект.Записать();

	КонецЕсли;

	Если Объект.СкладНовойПочтыЗначение.Владелец <> Объект.ГородНовойПочтыЗначение Тогда
		Объект.СкладНовойПочтыЗначение = Справочники.ЛМ_Отделения.ПустаяСсылка();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ГородНовойПочтыПредставлениеОкончаниеВводаТекста(Элемент, Текст, Значение, СтандартнаяОбработка)

	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	Города = ПодобратьГородаНаСервере(Текст);

	Если Города <> Неопределено И Города.Количество() > 0 Тогда
		Значение = Города;
		СтандартнаяОбработка = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодобратьГородаНаСервере(Знач Текст)

	Города = Справочники.ЛМ_Города.ПолучитьГородаПоВхождениюНачал(Текст);

	Если Не ЗначениеЗаполнено(Города) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Список = Новый СписокЗначений;

	Для Каждого Город Из Города Цикл
		Список.Добавить(Город, Город.Наименование + "   " + Город.НаименованиеРусское);
	КонецЦикла;

	Возврат Список;

КонецФункции

