&НаСервере
Процедура ДатаПриИзмененииНаСервере()

	Док = ДокументПоФорме();

	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();

	ЗаполнениеДокументов.ПриИзмененииЗначенияДатыДокумента(Док, ВалютаРегламентированногоУчета);
	УправлениеЗаказами.УстановитьДатуОплатыПоДоговору(Док, "ДатаДокумента", Док.ДоговорКонтрагента);
	Док.ПересчитатьАвтоматическиеСкидки();

	ДокументВФорму(Док);

	ОбновитьПодвалНаСервере();
	НастроитьЭлементыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	ОрганизацияПриИзмененииНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()

	Док = ДокументПоФорме();

	СтарыйДоговор = Док.ДоговорКонтрагента;

	СтруктураПараметров = Новый Структура;
	ЗаполнениеДокументов.ПриИзмененииЗначенияОрганизации(Док, СтруктураПараметров);

	// Банковский счёт должен принадлежать организации документа.
	Если Не ЗначениеЗаполнено(Док.СтруктурнаяЕдиница)
		Или Док.СтруктурнаяЕдиница.Владелец <> Док.Организация Тогда

		Док.СтруктурнаяЕдиница = Док.Организация.ОсновнойБанковскийСчет;

	КонецЕсли;

	Если СтарыйДоговор <> Док.ДоговорКонтрагента Тогда
		Док.ПриИзмененииДоговора();
	КонецЕсли;

	ДокументВФорму(Док);

	ОбновитьПодвалНаСервере();
	НастроитьЭлементыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)

	КонтрагентПриИзмененииНаСервере();

КонецПроцедуры

// Один в один КонтрагентПриИзмененииФрагмент обычной формы: договор, склад,
// схема резервирования, тип цен по группе контрагента, контакты, долг.
//
&НаСервере
Процедура КонтрагентПриИзмененииНаСервере()

	Док = ДокументПоФорме();

	СтруктураПараметров = Новый Структура;
	ЗаполнениеДокументов.ПриИзмененииЗначенияКонтрагента(Док, СтруктураПараметров);

	Док.ПриИзмененииДоговора();

	Если ЗначениеЗаполнено(Док.Контрагент)
		И (ЗначениеЗаполнено(Док.Контрагент.Родитель.ТипЦеныГруппы)
			Или ЗначениеЗаполнено(Док.Контрагент.Родитель.Родитель.ТипЦеныГруппы)) Тогда

		Если ЗначениеЗаполнено(Док.Контрагент.Родитель.ТипЦеныГруппы) Тогда
			НовыйТипЦен = Док.Контрагент.Родитель.ТипЦеныГруппы;
		Иначе
			НовыйТипЦен = Док.Контрагент.Родитель.Родитель.ТипЦеныГруппы;
		КонецЕсли;

		Если Док.ТипЦен <> НовыйТипЦен Тогда

			СтруктураРеквизитов = Ценообразование.ПолучитьСтруктуруРеквизитовДокументаДляЦенообразования(Док);
			СтруктураРеквизитов.Вставить("ВызовПриИзмененииЗначенияДоговора");

			ЗаполнениеДокументов.ИзменитьЦеныВалюту(
				Док,
				Перечисления.СпособыЗаполненияЦен.ПоЦенамНоменклатуры,
				СтруктураРеквизитов,
				,
				"Товары",
				Константы.ВалютаРегламентированногоУчета.Получить(),
				,
				,
				НовыйТипЦен);

			Док.ТипЦен = НовыйТипЦен;

		КонецЕсли;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(Док.Контрагент) Тогда
		ОчиститьНПНаСервере(Док);
	Иначе
		Док.СкладГруппа         = Док.Контрагент.Родитель.Склад;
		Док.СхемаРезервирования = Док.Контрагент.Родитель.СхемаРезервирования;

		Если ЗначениеЗаполнено(Док.Контрагент.СкладКонтрагента) Тогда
			Док.СкладГруппа = Док.Контрагент.СкладКонтрагента;
		КонецЕсли;

		Док.ТелефонКонтрагента1               = ОбщегоНазначения.ТелефонКонтрагента(Док.Контрагент);
		Док.АдресЭлектроннойПочтыКонтрагента  = ОбщегоНазначения.ИмейлКонтрагента(Док.Контрагент);
	КонецЕсли;

	ДокументВФорму(Док);

	ЗаполнитьДанныеИзАктивногоЗаказаНаСервере();
	ЗаполнитьСпискиНППриОткрытии();
	ЗаполнитьПолучателяНаСервере();

	ОбновитьНадписьДолгаНаСервере();
	ОбновитьПодвалНаСервере();
	РассчитатьИнфоФормулыНаСервере();
	НастроитьЭлементыНаСервере();

КонецПроцедуры

