КонецПроцедуры

&НаСервере
Процедура УслугиНоменклатураПриИзмененииНаСервере(Индекс)

	Если Индекс < 0 Тогда
		Возврат;
	КонецЕсли;

	Док = ДокументПоФорме();
	СтрокаТЧ = Док.Услуги[Индекс];

	ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТЧ, Док, "Реализация");
	ОбработкаТабличныхЧастей.ЗаполнитьСодержаниеТабЧасти(СтрокаТЧ, Док);

	СтрокаТЧ.Цена = Ценообразование.ПолучитьЦенуНоменклатуры(
		СтрокаТЧ.Номенклатура,
		Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка(),
		Док.ТипЦен,
		Док.Дата,
		Справочники.ЕдиницыИзмерения.ПустаяСсылка(),
		Док.ВалютаДокумента,
		Док.КурсВзаиморасчетов,
		Док.КратностьВзаиморасчетов, ,
		Док.ДоговорКонтрагента);

	// Услуга "процент от суммы товаров": процент берётся из наименования.
	ЗаполнитьУслугуПроцентом(СтрокаТЧ, Док);

	ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТЧ, Док);
	ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТЧ, Док);

	ДокументВФорму(Док);
	ОбновитьПодвалНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУслугуПроцентом(СтрокаТЧ, Док)

	Процент = "";
	Наименование = СтрокаТЧ.Номенклатура.Наименование;

	Для Сч = 1 По СтрДлина(Наименование) Цикл
		Символ = Сред(Наименование, Сч, 1);
		Если Найти("0123456789.,", Символ) > 0 Тогда
			Процент = Процент + Символ;
		КонецЕсли;
	КонецЦикла;

	Попытка
		Процент = Число(Процент);
	Исключение
		Процент = 0;
	КонецПопытки;

	Если Процент = 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаТЧ.Количество = 1;
	СтрокаТЧ.Цена       = Док.Товары.Итог("Сумма") * Процент / 100;

