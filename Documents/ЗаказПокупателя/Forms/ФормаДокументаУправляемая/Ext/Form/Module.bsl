// ОПЛАТА

&НаСервере
Процедура ОбновитьКнопкуПлатежаНаСервере()

	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Элементы.WayForPay.Видимость = ЗначениеЗаполнено(Объект.WayForPayOrderReference);

	КонтрагентОбъект = Объект.Контрагент.ПолучитьОбъект();

	Если КонтрагентОбъект.ЭтоОптовик() И Не КонтрагентОбъект.ЭтоМаруся() Тогда

		ВыставленныйСчет = Справочники.БанковскиеСчета.ПолучитьВыставленныйСчет(Объект.Контрагент);

		Если ВыставленныйСчет <> Неопределено Тогда
			Элементы.КнопкаПлатежа.Видимость = Истина;
			Элементы.КнопкаПлатежа.Заголовок = СокрЛП(ВыставленныйСчет.Сумма) + " "
				+ ВыставленныйСчет.БанковскийСчет.Наименование;
		Иначе
			Элементы.КнопкаПлатежа.Видимость = Ложь;
		КонецЕсли;

	Иначе
		Элементы.КнопкаПлатежа.Видимость = Истина;
		Элементы.КнопкаПлатежа.Заголовок = "Оплата";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КнопкаПлатежаНажатие(Элемент)

	Предоплата150 = "   Предоплата 150  ";
	ПолнаяОплата  = "   Полная оплата   ";

	ЭтоОптовик = ЭтоОптовикНаСервере();

	Если ЭтоОптовик Тогда

		Ответ = "";

	Иначе

		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(Предоплата150);
		СписокКнопок.Добавить(ПолнаяОплата);

		Ответ = Вопрос("Выберите действие:", СписокКнопок);

		Если Ответ = Неопределено Тогда
			Возврат;
		КонецЕсли;

	КонецЕсли;

	ПлатежПроведен = СоздатьПлатежНаСервере(Ответ = Предоплата150, ЭтоОптовик);

	Если ПлатежПроведен И Не ЭтоОптовик Тогда

		Если Ответ = Предоплата150 Тогда
			Объект.ВидОплатыЗаказа = ПредопределенноеЗначение("Перечисление.ВидОплатыЗаказ.Предоплата");
		Иначе
			Объект.ВидОплатыЗаказа = ПредопределенноеЗначение("Перечисление.ВидОплатыЗаказ.Оплачен");
		КонецЕсли;

		ВидОплатыЗаказаНаСервере();

	КонецЕсли;

	ОбновитьКнопкуПлатежаНаСервере();

КонецПроцедуры

&НаСервере
Функция ЭтоОптовикНаСервере()

	Если Не ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;

	КонтрагентОбъект = Объект.Контрагент.ПолучитьОбъект();

	Возврат КонтрагентОбъект.ЭтоОптовик() И Не КонтрагентОбъект.ЭтоМаруся();

КонецФункции

&НаСервере
Функция СоздатьПлатежНаСервере(ЭтоПредоплата, ЭтоОптовик)

	Если ЭтоОптовик Тогда

		ВыставленныйСчет = Справочники.БанковскиеСчета.ПолучитьВыставленныйСчет(Объект.Контрагент);

		Если ВыставленныйСчет = Неопределено Тогда
			Сообщить("По контрагенту нет выставленного счёта.");
			Возврат Ложь;
		КонецЕсли;

		Сумма = ВыставленныйСчет.Сумма;
		Счет  = ВыставленныйСчет.БанковскийСчет;

	Иначе

		ЭтоМаруся = Объект.Контрагент.ПолучитьОбъект().ЭтоМаруся();

		Счет = ?(ЭтоМаруся, Справочники.БанковскиеСчета.НайтиПоКоду("000000012"),
			Справочники.БанковскиеСчета.НайтиПоКоду("000000021"));

		Если ЭтоПредоплата Тогда
			Сумма = 150;
		ИначеЕсли ЭтоМаруся Тогда
			Сумма = Объект.СуммаДокумента;
		Иначе
			Сумма = Документы.ЗаказПокупателя.ДолгКонтрагентаНаДату(Объект.Контрагент, ТекущаяДата())
				+ Документы.ЗаказПокупателя.ПолучитьСуммуРезервовПоКонтрагенту(Объект.Контрагент);
		КонецЕсли;

	КонецЕсли;

	Платеж = Документы.ПлатежноеПоручениеВходящее.СоздатьДокументПрограмно(Объект.Ссылка, Сумма, Счет);

	Если Не Платеж.СчетОрганизации.Карта Тогда
		Попытка
			Платеж.ПолучитьФорму().Открыть();
		Исключение
			Сообщить("Платёжное поручение создано, форма открывается из старой формы: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Возврат Платеж.Проведен;

КонецФункции

&НаКлиенте
Процедура ПроверитьОплатуНажатие(Элемент)

	ОбновитьКнопкуПлатежаНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура WayForPayНажатие(Элемент)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Предупреждение("Сначала запишите заказ.");
		Возврат;
	КонецЕсли;

	Результат = ПроверитьWayForPayНаСервере();

	Если Не Результат.Успешно Тогда
		Предупреждение("Не удалось получить статус платежа WayForPay." + Символы.ПС + Результат.Сообщение);
		Возврат;
	КонецЕсли;

	Если Результат.ПлатежЗарегистрирован Тогда
		Предупреждение("Оплата WayForPay подтверждена, платёж зарегистрирован.");
	ИначеЕсли Результат.СтатусОплаты = "Approved" Тогда
		Предупреждение("Оплата WayForPay подтверждена.");
	Иначе
		Текст = "Статус: " + Результат.СтатусОплаты;
		Если ЗначениеЗаполнено(Результат.Причина) Тогда
			Текст = Текст + Символы.ПС + "Причина: " + Результат.Причина;
		КонецЕсли;
		Предупреждение("Платеж WayForPay не подтвержден." + Символы.ПС + Текст);
	КонецЕсли;

	ОбновитьКнопкуПлатежаНаСервере();

КонецПроцедуры

&НаСервере
Функция ПроверитьWayForPayНаСервере()

	Возврат WayForPay.ПроверитьИЗарегистрироватьОплату(Объект.Ссылка, Объект.WayForPayOrderReference);

КонецФункции

