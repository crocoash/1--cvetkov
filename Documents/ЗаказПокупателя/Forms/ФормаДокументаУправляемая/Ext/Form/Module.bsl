&НаСервере
Процедура ТоварыНоменклатураПриИзмененииНаСервере(Индекс)

	Если Индекс < 0 Тогда
		Возврат;
	КонецЕсли;

	Док = ДокументПоФорме();
	СтрокаТЧ = Док.Товары[Индекс];

	Док.ПриИзмененииНоменклатурыТоваров(СтрокаТЧ);
	Док.ОпределитьСкидку(СтрокаТЧ);

	ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТЧ, Док);
	ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТЧ, Док);

	ДокументВФорму(Док);
