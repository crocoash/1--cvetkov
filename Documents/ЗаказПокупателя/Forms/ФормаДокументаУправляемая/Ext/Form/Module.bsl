&НаСервере
Процедура ПечатьРезерваНаСервере(НаПринтер)

	ТабДок = Новый ТабличныйДокумент;

	Макет = Документы.ЗаказПокупателя.ПолучитьМакет("Резерв");

	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаГотово1");
	ОбластьИтого  = Макет.ПолучитьОбласть("Итого");

	ИтогоРезерв = 0;

	ТЗЗаказы = ТабРезерваОстаток.Выгрузить(, "ДокументРезерва");
	ТЗЗаказы.Свернуть("ДокументРезерва");
	ТЗЗаказы.Колонки.Добавить("ДатаЗаказа");

	Для Каждого Строка Из ТЗЗаказы Цикл
		Строка.ДатаЗаказа = Строка.ДокументРезерва.Дата;
	КонецЦикла;

	ТЗЗаказы.Сортировать("ДатаЗаказа");

	Для Каждого СтрокаЗаказа Из ТЗЗаказы Цикл

		ОбластьШапка.Параметры.Заголовок = ОбщегоНазначения.СформироватьЗаголовокДокумента(
			СтрокаЗаказа.ДокументРезерва, "Залишок резерву на замовлення");

		ТабДок.Вывести(ОбластьШапка);

		НомерСтроки    = 1;
		КоличествоИтог = 0;
		СуммаИтог      = 0;

		НайденныеСтроки = ТабРезерваОстаток.НайтиСтроки(
			Новый Структура("ДокументРезерва", СтрокаЗаказа.ДокументРезерва));

		Для Каждого Позиция Из НайденныеСтроки Цикл

			ОбластьСтрока.Параметры.Заполнить(Позиция);
			ОбластьСтрока.Параметры.НомерСтроки   = НомерСтроки;
			ОбластьСтрока.Параметры.Номенклатура  = Позиция.Номенклатура.НаименованиеПолное;
			ОбластьСтрока.Параметры.ЦеноваяГруппа = Позиция.Номенклатура.ЦеноваяГруппа;
			ОбластьСтрока.Параметры.Готовность    = Позиция.СрокИзготовления;

			Если Позиция.ЗакрепитьРезерв Тогда
				ТабДок.Вывести(ОбластьСтрока).ЦветФона = Новый Цвет(255, 255, 200);
			Иначе
				ТабДок.Вывести(ОбластьСтрока);
			КонецЕсли;

			НомерСтроки    = НомерСтроки + 1;
			КоличествоИтог = КоличествоИтог + Позиция.Количество;
			СуммаИтог      = СуммаИтог + Позиция.Сумма;

		КонецЦикла;

		ОбластьИтого.Параметры.Количество = КоличествоИтог;
		ОбластьИтого.Параметры.Сумма      = СуммаИтог;

		ТабДок.Вывести(ОбластьИтого);

		ИтогоРезерв = ИтогоРезерв + СуммаИтог;

	КонецЦикла;

	ОбластьИтогоРезерв = Макет.ПолучитьОбласть("ИтогоРезерв");

	Если ТЗЗаказы.Количество() > 1 Тогда
		ОбластьИтогоРезерв.Параметры.ИтогоРезерв           = ИтогоРезерв;
		ОбластьИтогоРезерв.Параметры.ИтогоРезервЗаголовок  = "Резерв за всіма замовленнями: ";
	КонецЕсли;

	ОбластьИтогоРезерв.Параметры.РезервЗаголовок = "Виготовляється: ";
	ОбластьИтогоРезерв.Параметры.Готово          = "0 Грн";
	ОбластьИтогоРезерв.Параметры.ОстатокРезерв   = Строка(ИтогоРезерв) + " Грн";

	ТабДок.Вывести(ОбластьИтогоРезерв);

	УниверсальныеМеханизмы.НапечататьДокумент(ТабДок, 1, НаПринтер, "Резерв " + СокрЛП(Объект.Контрагент));

КонецПроцедуры

