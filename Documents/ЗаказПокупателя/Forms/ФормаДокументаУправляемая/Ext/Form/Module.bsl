Процедура ОтправитьСМСНажатие(Элемент)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Предупреждение("Сначала запишите заказ!", 3, "Упс");
		Возврат;
	КонецЕсли;

	ОтправитьСМСВручнуюНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОтправитьСМСВручнуюНаСервере()

	// Если рассылка ТТН настроена автоматически - вручную не шлём (как раньше).
	Если (Константы.РассылкаТТНСПомощьюСМС.Получить() Или Константы.РассылкаТТНСПомощьюЭлПочты.Получить())
		И Объект.Контрагент.Родитель.ОтправлятьСМС Тогда
		Возврат;
	КонецЕсли;

	Телефон = ФормированиеПечатныхФорм.ПолучитьТелефонДляНалоговойНакладной(Объект.ТелефонКонтрагента1);

	Если Не ЗначениеЗаполнено(Телефон) Тогда
		Сообщить("Некорректно указан номер телефона!");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ТекстСМС) Тогда
		Сообщить("Не заполнен текст сообщения!");
		Возврат;
	КонецЕсли;

	ТекстСМС = ОбщийМодульПодписокНаСобытия.ШаблонСМСВТекст(ТекстСМС, Объект.Ссылка);

	ОтправитьСМСЧерезСервис(Телефон, ТекстСМС, ШаблонСМС);

