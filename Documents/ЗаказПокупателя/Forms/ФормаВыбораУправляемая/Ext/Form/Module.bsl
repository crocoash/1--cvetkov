&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Сообщить1("Параметры.ТочностьСуммы         ="+Параметры.ТочностьСуммы);
	Сообщить1("Параметры.ТочностьПроцент       ="+Параметры.ТочностьПроцент);
	Сообщить1("Параметры.СуммаПоступилоПоЗаказу="+Параметры.СуммаПоступилоПоЗаказу);
	Сообщить1("Параметры.КонтрагентЗаказа      ="+Параметры.КонтрагентЗаказа);
	
	ТочностьСуммы         = Параметры.ТочностьСуммы;
	ТочностьПроцент       = Параметры.ТочностьПроцент;
	СуммаПоступилоПоЗаказу= Параметры.СуммаПоступилоПоЗаказу;
	
	Список.Параметры.УстановитьЗначениеПараметра("СтатусЗаказаОжидаетОплаты", 
	Справочники.СтатусыЗаказов.НайтиПоНаименованию("Ожидает оплаты"));			
	
	// не надо		  
	//////Список.Параметры.УстановитьЗначениеПараметра("ЗаказПокупателяКонтрагент", Параметры.КонтрагентЗаказа);
	////
	////Список.Параметры.УстановитьЗначениеПараметра("СостояниеУтвержден", Перечисления.СостоянияОбъектов.Утвержден);
	////Список.Параметры.УстановитьЗначениеПараметра("СостояниеОтклонен", Перечисления.СостоянияОбъектов.Отклонен);
	
	// из 3.1
	Если Параметры.Свойство("КонтрагентЗаказа") И ЗначениеЗаполнено(Параметры.КонтрагентЗаказа) Тогда
		Эл = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Эл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагент");
		Эл.ПравоеЗначение = Параметры.КонтрагентЗаказа;
		Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Эл.Использование = Истина;
	КонецЕсли;	
	
	ОбновитьСписок();	
	
КонецПроцедуры   

Процедура Сообщить1(сТекст)
	Если бОтладка Тогда 
		Сообщить(сТекст);
	КонецЕсли;	
КонецПроцедуры

