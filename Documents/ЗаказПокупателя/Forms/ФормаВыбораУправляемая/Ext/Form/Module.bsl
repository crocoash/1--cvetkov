	|	ЗаказПокупателя.Ссылка,
	|	ЗаказПокупателя.СуммаДокумента,
	|	ЗаказПокупателя.СтатусЗаказа
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.СуммаДокумента МЕЖДУ &Предел1 И &Предел2
	|	И ЗаказПокупателя.СтатусЗаказа = &СтатусЗаказаОжидаетОплаты
	//	|АВТОУПОРЯДОЧИВАНИЕ
	|";
	
	Запрос.УстановитьПараметр("СтатусЗаказаОжидаетОплаты", Справочники.СтатусыЗаказов.НайтиПоНаименованию("Ожидает оплаты"));			
	Запрос.УстановитьПараметр("Предел1", чСуммаЗаказаОт);			
	Запрос.УстановитьПараметр("Предел2", чСуммаЗаказаДо);			
	тз = Запрос.Выполнить().Выгрузить();
	КолвоРаскрашенныхЗаказов = тз.Количество();
	
	//КолвоРаскрашенныхЗаказов = 0;
	//Для Каждого тс Из Список Цикл 
	//	Если тс.Окрашена Тогда 
	//		КолвоРаскрашенныхЗаказов = КолвоРаскрашенныхЗаказов + 1;
	//	КонецЕсли;	
	//КонецЦикла;
	
	//Для Каждого тс Из Табло Цикл 
	//	тс.Окрашена = ?(((тс.СуммаДокумента>=чСуммаОт)И(тс.СуммаДокумента<=чСуммаДо)),"1","0");				
	//КонецЦикла;
	//Табло.Сортировать("Окрашена Убыв, Дата Возр, Номер Возр");
	//сз = Новый СписокЗначений;
	//СЗ.ЗагрузитьЗначения(Табло.ВыгрузитьКолонку("Ссылка"));
	//ДокументСписок.Отбор.ССылка.Использование = Истина;
	//ДокументСписок.Отбор.Ссылка.ВидСравнения = ВидСравнения.ВСписке;
	//ДокументСписок.Отбор.ССылка.Значение = СЗ;
	//ДокументСписок.Порядок.Очистить();
	//	ДокументСписок.НастройкаПорядка.Организация.Доступность = Истина; 
	
	//ЭлементыФормы.ДокументСписок.Колонки.Дата.ТекстПодвала               = "Диапазон сумм заказов";	
	//ЭлементыФормы.ДокументСписок.Колонки.Номер.ТекстПодвала              = Формат(чСуммаЗаказаОт,"ЧЦ=10; ЧДЦ=2; ЧН=0");	
	//ЭлементыФормы.ДокументСписок.Колонки.НомерЗаказа2ССайта.ТекстПодвала = Формат(чСуммаЗаказаДо,"ЧЦ=10; ЧДЦ=2; ЧН=0");	
	
	//ДекорацияСуммОтИДо.Заголовок = 
	
	//СклонениеЗаказа = " " 
	//+ ЧислоПрописью(КолвоРаскрашенныхЗаказов,, "заказ, заказа, заказов, М,,,,,0")
	//+": ";
	
	сЗаказ = ЧислоПрописью(КолвоРаскрашенныхЗаказов,, "заказ, заказа, заказов, М,,,,,0");
	пЗаказ = Найти(сЗаказ,"заказ");
	сЗаказ1 = Сред(сЗаказ, пЗаказ);
	СклонениеЗаказа = " " + сЗаказ1 + ": ";
