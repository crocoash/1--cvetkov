	//чСуммаЗаказаДо = чСуммаДо;
	чСуммаОт = 0;
	чСуммаДо = 0;
	
	ДельтаСуммы = 0; ДельтаПроцент = 0; Дельта = 0;
	Если ТочностьСуммы <> 0 Тогда 
		ДельтаСуммы = ТочностьСуммы;
	КонецЕсли;
	Если ТочностьПроцент <> 0 Тогда 
		ДельтаПроцент = СуммаПоступилоПоЗаказу * (ТочностьПроцент/100);
	КонецЕсли;
	Если ДельтаПроцент < ДельтаСуммы Тогда
		Дельта = ДельтаСуммы;
	Иначе 	
		Дельта = ДельтаПроцент;
	КонецЕсли;
	чСуммаОт = СуммаПоступилоПоЗаказу - Дельта;
	чСуммаОт = ?(чСуммаОт<0,0, чСуммаОт);
	чСуммаДо = СуммаПоступилоПоЗаказу + Дельта;
	
	чСуммаЗаказаОт = чСуммаОт;
	чСуммаЗаказаДо = чСуммаДо;
	
