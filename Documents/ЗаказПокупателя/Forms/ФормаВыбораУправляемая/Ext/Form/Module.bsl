	"%  Раскрашены "+КолвоРаскрашенныхЗаказов+СклонениеЗаказа+Формат(чСуммаЗаказаОт,"ЧЦ=10; ЧДЦ=2; ЧН=0")+" - "+Формат(чСуммаЗаказаДо,"ЧЦ=10; ЧДЦ=2; ЧН=0")+" грн.";;		
	
