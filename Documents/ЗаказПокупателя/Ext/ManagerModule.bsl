Функция ДнейВСтатусе(Заказ) Экспорт 
	
	Запрос  = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИсторияИзмененияСтатусовЗаказов.Период КАК Период,
	               |	ИсторияИзмененияСтатусовЗаказов.СтатусЗаказа КАК СтатусЗаказа
	               |ИЗ
	               |	РегистрСведений.ИсторияИзмененияСтатусовЗаказов КАК ИсторияИзмененияСтатусовЗаказов
	               |ГДЕ
	               |	ИсторияИзмененияСтатусовЗаказов.ЗаказПокупателя = &ЗаказПокупателя
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
				   
	Запрос.УстановитьПараметр("ЗаказПокупателя",Заказ);
	
	Рез =  Запрос.Выполнить().Выгрузить();
	НачПер = ТекущаяДата();
	КонПер = ТекущаяДата();
	ТекСтатус = "";
	Для Каждого Стр Из Рез Цикл
		ТекСтатус = Стр.СтатусЗаказа;
		НачПер = Стр.Период;                            
		Прервать;                 
	КонецЦикла;
	
	КолДней = Цел((НачалоДня(КонПер)-НачалоДня(НачПер))/86400);
	Если КолДней = 0 Тогда
		Возврат 0;
	иначе
		Возврат Строка(КолДней);
	КонецЕсли;

КонецФункции

Процедура ОткрытьОтчетВедомостьПоТоварам(Номенклатура,Характеристика,Склад = "") Экспорт
	
