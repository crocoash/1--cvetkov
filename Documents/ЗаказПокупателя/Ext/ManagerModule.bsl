	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Тип = &Тип
	               |	И КонтактнаяИнформация.Объект = &Объект";
	Запрос.УстановитьПараметр("Тип",Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
	Запрос.УстановитьПараметр("Объект",Кон);

//	Запрос.УстановитьПараметр("Вид",Справочники.ВидыКонтактнойИнформации.АдресЭлектроннойПочтыКонтрагентаДляОбменаДокументами
	ТабАдресатов = Запрос.Выполнить().Выгрузить();
	Возврат ТабАдресатов
	
КонецФункции

Функция УчЗаписьПоУмолчанию() Экспорт 
	ВыборкаУЧ = Справочники.УчетныеЗаписиЭлектроннойПочты.Выбрать();
	УЧ = Неопределено;
	Пока ВыборкаУЧ.Следующий() Цикл
		Если НЕ ВыборкаУЧ.ПометкаУдаления И ВыборкаУЧ.Рабочий Тогда 
			УЧ = ВыборкаУЧ.Ссылка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат УЧ;
КонецФункции

Функция УбратьНоликиСлева(СтрокаСНоликами) Экспорт 
	Ф=0;  НоваяСтрока = "";
	Для Сч = 1 По СтрДлина(СтрокаСНоликами) Цикл 
		Символ = Сред(СтрокаСНоликами,Сч,1);
		Если  НЕ Символ = "0" и Ф=0 Тогда
			//первый ненулевой символ
			Ф=1
		КонецЕсли;
		Если Ф=1 Тогда
			//дальше берем все и нолики тоже
			НоваяСтрока = НоваяСтрока+Символ
		КонецЕсли;
	КонецЦикла;
	Возврат НоваяСтрока
КонецФункции

Процедура ОтправитьЗаказ(Док,Адрес,ТекстПисьма,НазвДок) Экспорт 
	
	УЧ = УчЗаписьПоУмолчанию();
	Если УЧ = Неопределено Тогда 
		Сообщить("Не определена учетная запись");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда 
		Сообщить("Не заполнен адрес!");
		Возврат;
	КонецЕсли;
	Альфаимя = ОбщийМодульПодписокНаСобытия.АльфаИмяПоУмолчанию();
	
	Об = Док.ПолучитьОбъект();
	ТабДок = Об.ПечатьДокумента(); 
	Если Константы.ОтправкаДокументовВФОрмате.Получить() = Перечисления.ФорматыОТправкиДокументов.Эксель Тогда
		ИмФайла = НазвДок+"_"+УбратьНоликиСлева(Док.Номер)+".xlsx";
		ТабДок.Записать(КаталогВременныхФайлов()+ИмФайла,ТипФайлаТабличногоДокумента.XLSX);
	Иначе
		ИмФайла = НазвДок+"_"+УбратьНоликиСлева(Док.Номер)+".pdf";
		ТабДок.Записать(КаталогВременныхФайлов()+ИмФайла,ТипФайлаТабличногоДокумента.PDF);
	КонецЕсли;
	
	УправлениеЭлектроннойПочтой.ОтправитьПисьмо1(УЧ,ТекстПисьма,Адрес,Альфаимя,КаталогВременныхФайлов()+ИмФайла);
	
	Письмо = Документы.ЭлектронноеПисьмо.СоздатьДокумент();
	Письмо.Основание = Док;
	Письмо.УчетнаяЗапись = Уч;
	НС = Письмо.КомуТЧ.Добавить();
	НС.АдресЭлектроннойПочты = Адрес;
	НС.Представление = Док.Контрагент.Наименование;
	Письмо.Кому = Адрес;
	Письмо.СтатусПисьма = Перечисления.СтатусыПисем.Отправленное;
	Письмо.Дата = ТекущаяДата();
	Письмо.ДатаОтправления = ТекущаяДата();
	Письмо.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Письмо.Тема = СокрЛП(Док);
	Письмо.Записать();
	
КонецПроцедуры

Функция РеализацияЗаказаОсновная(Зак) Экспорт 
	
	Если ЗначениеЗаполнено(Зак.ОсновнойЗаказ) Тогда
		Если ТипЗнч(Зак.ОсновнойЗаказ)=Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			Возврат Зак.ОсновнойЗаказ;
		Иначе
			Заказ = Зак.ОсновнойЗаказ;
		КонецЕсли;
	Иначе
		Заказ = Зак;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	               |ГДЕ
	               |	НЕ РеализацияТоваровУслуг.ПометкаУдаления
	               |	И РеализацияТоваровУслуг.Сделка = &Сделка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	РеализацияТоваровУслуг.Дата УБЫВ";
	Запрос.УстановитьПараметр("Сделка",Заказ);
	Рез = Запрос.Выполнить().Выбрать();
	
	Если Рез.Следующий() Тогда
		Возврат Рез.Ссылка;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции


