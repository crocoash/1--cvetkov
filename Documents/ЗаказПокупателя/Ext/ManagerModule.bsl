Функция СрокХранения(Дата) Экспорт
	
	Если Не ЗначениеЗаполнено(Дата) Тогда 
		Возврат 0;
	КонецЕсли;

	КолДней = (НачалоДня(ТекущаяДата())-НачалоДня(Дата))/86400;
	Если КолДней<0 ИЛИ КолДней>60 Тогда
		Возврат  0;
	КонецЕсли;
	Выходн = 0;
	Для Сч = 1 По КолДней Цикл
		Если ДеньНедели(НачалоДня(Дата)+Сч*86400) = 7 Тогда
			Выходн = Выходн+1;
		КонецЕсли;
	КонецЦикла;
	Возврат КолДней-Выходн;
	
КонецФункции 

