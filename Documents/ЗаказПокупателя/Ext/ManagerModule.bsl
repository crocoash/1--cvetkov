				ДЛя Каждого Стр3 Из Рез Цикл
					Об = Стр3.Ссылка.ПолучитьОбъект();
					Попытка
						Об.Записать(РежимЗаписиДокумента.Проведение);
					Исключение
						#Если Клиент Тогда
						Сообщить(СокрЛП(Об)+" провести не удалось!");
						#КонецЕсли
					КонецПопытки;
				КонецЦикла;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

