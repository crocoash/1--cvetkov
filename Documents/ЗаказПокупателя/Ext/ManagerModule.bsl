Функция РезервПоЗаказуОстаток(Параметр) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ДокументРезерва,
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.НК КАК НК,
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, &Параметр) КАК ТоварыВРезервеНаСкладахОстатки";
	
	
	Если ТипЗнч(Параметр) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Параметр", "ДокументРезерва.Контрагент = &Параметр");
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Параметр", "ДокументРезерва = &Параметр");
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Параметр", Параметр);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция КоличествоРезервовПоКонтрагенту(Параметр) Экспорт 
	
	ТаблицаРезерва = РезервПоЗаказуОстаток(Параметр);
	 
	Количество = 0;
	Для Каждого Стр Из ТаблицаРезерва Цикл 
		Количество = Количество + Стр.Количество;
	КонецЦикла;
	
	
	Возврат Количество;
		
