Функция СуммаОстаткаРезерва(Зак) Экспорт
	ТабРезерваОстаток = РезервПоЗаказуОстаток(Зак);
	ТабРезерваОстаток.Колонки.Добавить("Сумма");
	Для Каждого Стр Из ТабРезерваОстаток Цикл
		ОтборПоНоменклатуре = Зак.Товары.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры",Стр.Номенклатура,Стр.ХарактеристикаНоменклатуры));
		ТабНоменклатуры = Зак.Товары.Выгрузить(ОтборПоНоменклатуре);
		Попытка
			Цена = ТабНоменклатуры.Итог("Сумма")/ТабНоменклатуры.Итог("Количество");
			ЦенаБС = ТабНоменклатуры.Итог("Цена")/ТабНоменклатуры.Итог("Количество");
		Исключение
			Цена = 0;
			ЦенаБС = 0;
		КонецПопытки;
		Стр.Сумма = Цена*Стр.Количество;
	КонецЦикла;	
	Возврат ТабРезерваОстаток.Итог("Сумма");
КонецФункции

