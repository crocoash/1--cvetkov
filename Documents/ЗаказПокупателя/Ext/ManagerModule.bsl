// ==========================================================================================
// БЛОК ДЛЯ ПРОВЕРКИ ОПТИМИЗАЦИИ РЕЗЕРВИРОВАНИЯ (2026-07-24).
// Сравнивает результат старого РасспределитьРезерв() и нового РасспределитьРезервОпт()
// (см. ObjectModule.bsl) на реальных заказах, НИЧЕГО не записывая в базу.
// Вызывать из отладчика Конфигуратора через "Вычислить выражение", например:
//   Документы.ЗаказПокупателя.ТестСравнитьРезерв(Документы.ЗаказПокупателя.НайтиПоНомеру("0001234", Дата(2026,1,1)))
// или для пачки документов:
//   Документы.ЗаказПокупателя.ТестСравнитьРезерв(Новый Массив(...))
// Возвращает ТаблицаЗначений: Заказ, Совпало, Расхождения, ВремяСтарый(мс), ВремяНовый(мс).
// ==========================================================================================
Функция ТестСравнитьРезерв(МассивЗаказов, Знач ИсправитьБагСклада = Ложь) Экспорт

	// ИсправитьБагСклада = Ложь - сравнение "старый код vs новый код с тем же известным багом"
	// (для проверки, что оптимизация сама по себе ничего не меняет).
	// ИсправитьБагСклада = Истина - сравнение "старый код vs новый код С ИСПРАВЛЕННЫМ багом"
	// (покажет, на скольких реальных заказах баг со складом реально проявляется).

	Если ТипЗнч(МассивЗаказов) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Одиночный = МассивЗаказов;
		МассивЗаказов = Новый Массив;
		МассивЗаказов.Добавить(Одиночный);
	КонецЕсли;

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Заказ");
	Результат.Колонки.Добавить("Совпало");
	Результат.Колонки.Добавить("Расхождения");
	Результат.Колонки.Добавить("СтрокСтарый");
	Результат.Колонки.Добавить("СтрокНовый");

	Для Каждого Заказ Из МассивЗаказов Цикл

		СтрокаРезультата = Результат.Добавить();
		СтрокаРезультата.Заказ = Заказ;

		Попытка

			ОбСтарый = Заказ.ПолучитьОбъект();
			ОбСтарый.РасспределитьРезерв();
			СтарТаб = ОбСтарый.Резерв.Выгрузить();

			ОбНовый = Заказ.ПолучитьОбъект();
			ОбНовый.РасспределитьРезервОпт(Неопределено, ИсправитьБагСклада);
			НовТаб = ОбНовый.Резерв.Выгрузить();

		Исключение

			СтрокаРезультата.Совпало = Ложь;
			СтрокаРезультата.Расхождения = "ОШИБКА: " + ОписаниеОшибки();
			Продолжить;

		КонецПопытки;

		СтарТаб.Сортировать("Склад,Номенклатура,ХарактеристикаНоменклатуры,НК,Количество");
		НовТаб.Сортировать("Склад,Номенклатура,ХарактеристикаНоменклатуры,НК,Количество");

		СтрокаРезультата.СтрокСтарый = СтарТаб.Количество();
		СтрокаРезультата.СтрокНовый  = НовТаб.Количество();

		Расхождения = "";
		Совпало = (СтарТаб.Количество() = НовТаб.Количество());

		Если Совпало Тогда

			Для Инд = 0 По СтарТаб.Количество() - 1 Цикл

				С = СтарТаб[Инд];
				Н = НовТаб[Инд];

				Если С.Склад <> Н.Склад
					ИЛИ С.Номенклатура <> Н.Номенклатура
					ИЛИ С.ХарактеристикаНоменклатуры <> Н.ХарактеристикаНоменклатуры
					ИЛИ С.НК <> Н.НК
					ИЛИ С.Количество <> Н.Количество Тогда

					Совпало = Ложь;
					Расхождения = Расхождения + "Стр." + Инд + ": было ["
						+ СокрЛП(С.Склад) + ", " + СокрЛП(С.Номенклатура) + ", " + СокрЛП(С.ХарактеристикаНоменклатуры) + ", " + С.Количество
						+ "] стало ["
						+ СокрЛП(Н.Склад) + ", " + СокрЛП(Н.Номенклатура) + ", " + СокрЛП(Н.ХарактеристикаНоменклатуры) + ", " + Н.Количество
						+ "]; ";

				КонецЕсли;

			КонецЦикла;

		Иначе

			Расхождения = "Разное количество строк резерва: было " + СтарТаб.Количество() + ", стало " + НовТаб.Количество();

		КонецЕсли;

		СтрокаРезультата.Совпало = Совпало;
		СтрокаРезультата.Расхождения = Расхождения;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Удобная обёртка для ТестСравнитьРезерв - сама берёт последние N заказов с заполненной
// схемой резервирования (там, где оптимизация вообще что-то меняет) и сравнивает.
// Вызов из отладчика Конфигуратора:
//   Документы.ЗаказПокупателя.ТестСравнитьРезервПоследние(30)
Функция ТестСравнитьРезервПоследние(Знач Количество = 30, Знач ИсправитьБагСклада = Ложь) Экспорт

	// "ВЫБРАТЬ ПЕРВЫЕ N" не принимает параметр запроса - число подставляется в текст напрямую.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Цел(Количество) + "
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	НЕ ЗаказПокупателя.ПометкаУдаления
	|	И ЗаказПокупателя.СхемаРезервирования <> ЗНАЧЕНИЕ(Справочник.СхемыРезервирования.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата УБЫВ";

	МассивЗаказов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	Возврат ТестСравнитьРезерв(МассивЗаказов, ИсправитьБагСклада);

КонецФункции

// Текстовая обёртка над ТестСравнитьРезерв/ТестСравнитьРезервПоследние - результат сразу
// читаемая строка, без необходимости разворачивать ТаблицаЗначений в дереве отладчика.
// Вызов из "Вычислить выражение" (Значение результата откроется как обычный текст):
//   Документы.ЗаказПокупателя.ТестСравнитьРезервПоследниеТекст(1)
Функция ОписаниеРезультатаСравненияРезерва(ТаблицаРезультата) Экспорт

	Всего = ТаблицаРезультата.Количество();
	Совпало = 0;

	Для Каждого Стр Из ТаблицаРезультата Цикл
		Если Стр.Совпало = Истина Тогда
			Совпало = Совпало + 1;
		КонецЕсли;
	КонецЦикла;

	Текст = "Проверено: " + Всего + ", совпало: " + Совпало + ", НЕ совпало: " + (Всего - Совпало) + Символы.ПС + Символы.ПС;

	Для Каждого Стр Из ТаблицаРезультата Цикл

		Текст = Текст + "Заказ " + СокрЛП(Стр.Заказ) + ": Совпало=" + Стр.Совпало
			+ ", строк было=" + Стр.СтрокСтарый + ", строк стало=" + Стр.СтрокНовый;

		Если Стр.Совпало <> Истина Тогда
			Текст = Текст + Символы.ПС + "    " + Стр.Расхождения;
		КонецЕсли;

		Текст = Текст + Символы.ПС;

	КонецЦикла;

	Возврат Текст;

КонецФункции

Функция ТестСравнитьРезервТекст(МассивЗаказов, Знач ИсправитьБагСклада = Ложь) Экспорт

	Возврат ОписаниеРезультатаСравненияРезерва(ТестСравнитьРезерв(МассивЗаказов, ИсправитьБагСклада));

КонецФункции

Функция ТестСравнитьРезервПоследниеТекст(Знач Количество = 30, Знач ИсправитьБагСклада = Ложь) Экспорт

	Возврат ОписаниеРезультатаСравненияРезерва(ТестСравнитьРезервПоследние(Количество, ИсправитьБагСклада));

