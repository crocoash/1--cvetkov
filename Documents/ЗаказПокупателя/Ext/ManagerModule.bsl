функция ПолучитьРучнойВыборОплаты(Контрагент) Экспорт  
	
	ПроданоКод         = "000000011"; 
	РезервКод          = "000000001";
	ОжидаетОплатыКод   = "000000005"; 
	ОжидаетОтрпавкиКод = "000000002";
	
	СписСтатусовЗак = Новый СписокЗначений;
	СписСтатусовЗак.Добавить(ПроданоКод);
	СписСтатусовЗак.Добавить(РезервКод);
	СписСтатусовЗак.Добавить(ОжидаетОплатыКод);
	СписСтатусовЗак.Добавить(ОжидаетОтрпавкиКод);	

	 Запрос = Новый Запрос;
	 Запрос.Текст = "ВЫБРАТЬ
	                |	МАКСИМУМ(ЗаказПокупателя.ПоследняяОплатаЗаказа) КАК ПоследняяОплатаЗаказа
	                |ИЗ
	                |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	                |ГДЕ
	                |	ЗаказПокупателя.НомерТТН = """"
	                |	И ЗаказПокупателя.СтатусЗаказа.Код В(&СтатусЗаказа)
	                |	И ЗаказПокупателя.Контрагент = &Контрагент
	                |	И ЗаказПокупателя.ПоследняяОплатаЗаказа <> &ПоследняяОплатаЗаказа";
	 
	 Запрос.УстановитьПараметр("СтатусЗаказа",СписСтатусовЗак);
	 Запрос.УстановитьПараметр("Контрагент",Контрагент); 
	 Запрос.УстановитьПараметр("ПоследняяОплатаЗаказа",Перечисления.ПоследняяОплатаЗаказа.Автоматически);

		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл  
		ПоследняяОплатаЗаказа = Выборка.ПоследняяОплатаЗаказа;
		Если ЗначениеЗаполнено(ПоследняяОплатаЗаказа) Тогда
			Возврат ПоследняяОплатаЗаказа = Перечисления.ПоследняяОплатаЗаказа.НаКарту;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат Неопределено;
КонецФункции


