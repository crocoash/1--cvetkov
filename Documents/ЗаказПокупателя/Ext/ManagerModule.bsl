Функция ПолучитьСуммуРезервовПоКонтрагенту(Контрагент) Экспорт
	
	СуммаРезервов = 0;
	
	ТипЦенМелкийОпт = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000014");
	ТипКомплект     = Перечисления.ТипыНоменклатуры.Комплект;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ДокументРезерва,
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.НК КАК НК,
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ДокументРезерва.Контрагент = &Контрагент) КАК ТоварыВРезервеНаСкладахОстатки";
		

	Запрос.УстановитьПараметр("Контрагент", Контрагент);
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.НК) Тогда
			
			НайденныеСтроки = Выборка.ДокументРезерва.Товары.НайтиСтроки(Новый Структура("ХарактеристикаНоменклатуры", Выборка.НК));
			
		Иначе
			
			НайденныеСтроки = Выборка.ДокументРезерва.Товары.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры", Выборка.Номенклатура, Выборка.ХарактеристикаНоменклатуры));
			
		КонецЕсли;
		
		пТипЦен = Выборка.ДокументРезерва.ТипЦен;
		Скидка  = 0;
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			Если пТипЦен.Код = "000000001" И
				 НайденныеСтроки[0].Номенклатура.ВидНоменклатуры.ТипНоменклатуры <> ТипКомплект Тогда
				
				пТипЦен = ТипЦенМелкийОпт;
				
			КонецЕсли;
			
			Скидка = НайденныеСтроки[0].ПроцентСкидкиНаценки + НайденныеСтроки[0].ПроцентАвтоматическихСкидок;
			
		КонецЕсли;
		
		ЦенаБС = Ценообразование.ПолучитьЦенуНоменклатуры(
														  Выборка.Номенклатура,
														  Выборка.ХарактеристикаНоменклатуры,
														  пТипЦен,
														  Выборка.ДокументРезерва.Дата,
														  Выборка.Номенклатура.ЕдиницаХраненияОстатков,
														  Выборка.ДокументРезерва.ВалютаДокумента,
														  Выборка.ДокументРезерва.КурсВзаиморасчетов,
														  Выборка.ДокументРезерва.КратностьВзаиморасчетов,
														  ,
														  Выборка.ДокументРезерва.ДоговорКонтрагента);
		
		СуммаРезервов = СуммаРезервов + Выборка.Количество * ЦенаБС * (1 - Скидка / 100);
		
	КонецЦикла;
	
	Возврат СуммаРезервов;
	
КонецФункции

Функция ДолгКонтрагентаНаДату(Контрагент,Дата) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВзаиморасчетыСКонтрагентамиОстатки.СуммаУпрОстаток,
	               |	ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(&НадДату, Контрагент = &Контрагент) КАК ВзаиморасчетыСКонтрагентамиОстатки";
	Запрос.УстановитьПараметр("Контрагент",Контрагент);
	Запрос.УстановитьПараметр("НадДату",Дата);

	Рез = Запрос.Выполнить().Выгрузить();
	Долг = Рез.Итог("СуммаВзаиморасчетовОстаток");
	Возврат Долг
КонецФункции

// Возвращает сумму фактических оплат по заказу: проведённые приходные кассовые ордера
// и платёжные поручения входящие, у которых заказ стоит в расшифровке платежа (Сделка)
// или в основании документа. Долг контрагента в целом здесь не учитывается - только
// деньги, привязанные к этому заказу.
Функция СуммаОплатПоЗаказу(Заказ) Экспорт

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СУММА(Оплаты.Сумма) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		РасшифровкаПКО.СуммаПлатежа КАК Сумма
	|	ИЗ
	|		Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасшифровкаПКО
	|	ГДЕ
	|		РасшифровкаПКО.Ссылка.Проведен
	|		И (РасшифровкаПКО.Сделка = &Заказ
	|				ИЛИ РасшифровкаПКО.Ссылка.ДокументОснование = &Заказ)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		РасшифровкаППВ.СуммаПлатежа
	|	ИЗ
	|		Документ.ПлатежноеПоручениеВходящее.РасшифровкаПлатежа КАК РасшифровкаППВ
	|	ГДЕ
	|		РасшифровкаППВ.Ссылка.Проведен
	|		И (РасшифровкаППВ.Сделка = &Заказ
	|				ИЛИ РасшифровкаППВ.Ссылка.ДокументОснование = &Заказ)) КАК Оплаты";

	Запрос.УстановитьПараметр("Заказ", Заказ);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() И Выборка.Сумма <> NULL Тогда
		Возврат Выборка.Сумма;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция СтатусПредоплаты(Контрагент) Экспорт
	
		Долг = ДолгКонтрагентаНаДату(Контрагент,ТекущаяДата());
		СуммаРезервов = ПолучитьСуммуРезервовПоКонтрагенту(Контрагент);
		ПредоплатаТридцатьПроцетов = Ценообразование.ОкруглитьЦену(СуммаРезервов * 0.3,Перечисления.ПорядкиОкругления.Окр1, Истина);
		ПредоплатаКОплате = ПредоплатаТридцатьПроцетов + Долг;
	
		ПолнаяОплата = Долг + СуммаРезервов;
				
		Если СуммаРезервов = 0 И Долг > 30  Тогда
			Возврат "Есть борг!!! " + Строка(Долг); 
			
		ИначеЕсли СуммаРезервов <> 0 И Долг > 50  Тогда                                                          
			Возврат "Резерв и Борг!!! " + Строка(Долг) + " Грн";
			
		ИначеЕсли СуммаРезервов <> 0 И ПолнаяОплата < -10  Тогда
			Возврат "Замовлення сплачено ++ і є зайві гроші " + Строка(ПолнаяОплата) + " Грн";
			
		ИначеЕсли СуммаРезервов <> 0 И ПолнаяОплата > -10 И ПолнаяОплата < 50 Тогда
			Возврат "Замовлення сплачено повністю ++";	
			
		// есть резерв
		ИначеЕсли СуммаРезервов <> 0 И Долг < 50 И Долг > -50  Тогда
			Возврат "Передплата --- до оплати " + Строка(ПредоплатаКОплате) ;	
											
		ИначеЕсли СуммаРезервов <> 0 И ПредоплатаКОплате < 50 И ПредоплатаКОплате > -200 Тогда
			Возврат "Передплата ++ ";
			
		ИначеЕсли СуммаРезервов <> 0 И ПредоплатаКОплате < -200 Тогда
			Возврат "Предоплата більше 30% ++";	
			
		ИначеЕсли СуммаРезервов <> 0 И Долг < -300  Тогда
			Возврат "Передплата часткова " + Строка(Долг) + " до оплати " + ПредоплатаКОплате + " Грн";
			
		Иначе 
			Возврат "";
		КонецЕсли;
		 
КонецФункции

функция ПолучитьЦветСтатусаПредоплаты(СтатусПредоплаты,Оформление=10) Экспорт 
	
	 ВсеНаРозах = WebЦвета.ЗеленыйЛес;
	 ЧастьНаСкалдеРозы = WebЦвета.СветлоЗеленый;
	 ГрифельноСерый = WebЦвета.ГрифельноСерый;
	 СветлоСерый = WebЦвета.СветлоСерый;
	 
	 //нет резервов=3
	 //только розы 2
	 //розы+непошит = 1
	 //нет роз = 0
	 		
	Если Оформление = 0 Тогда 
		Возврат WebЦвета.Белый;
	ИначеЕсли Оформление = 1 Тогда 
		Возврат ЧастьНаСкалдеРозы;
	ИначеЕсли Оформление = 2 Тогда
		Возврат ВсеНаРозах;
	ИначеЕсли Оформление = 3 Тогда
		Возврат СветлоСерый;
	КонецЕсли;				
	
	
	Если Оформление=10 Тогда
		// ИСПРАВЛЕНО (2026-07-27): проверки сравнивали статус с русскими фразами, а
		// СтатусПредоплаты() реально формирует текст на украинском ("борг"/"Борг", "сплачено
		// повністю", "більше 30%", "Передплата ---", "часткова") - ни одна проверка не совпадала,
		// функция всегда проваливалась в WebЦвета.Синий по умолчанию ниже. Поправлено под
		// реальный текст статуса.
		Если СтрЧислоВхождений(СтатусПредоплаты,"борг") ИЛИ СтрЧислоВхождений(СтатусПредоплаты,"Борг") ТОгда

			Возврат WebЦвета.ГрифельноСерый;

		ИначеЕсли СтрЧислоВхождений(СтатусПредоплаты,"сплачено повністю") ИЛИ СтрЧислоВхождений(СтатусПредоплаты,"більше 30") ТОгда

			Возврат WebЦвета.ЗеленыйЛес;

		ИначеЕсли СтрЧислоВхождений(СтатусПредоплаты,"Передплата ---") Тогда

			Возврат WebЦвета.ЛососьСветлый;

		ИначеЕсли СтрЧислоВхождений(СтатусПредоплаты,"часткова") ТОгда

			Возврат WebЦвета.СветлоЗеленый;

		КонецЕсли;
	КонецЕсли;

	Возврат WebЦвета.Синий;
	
КонецФункции

//Получаем Грузоотправителя исходя из последнего оплачиваемого платежа на р\с
Функция ПолучительГрузоОтправителя(Контрагент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	ПлатежноеПоручениеВходящее.СчетОрганизации КАК СчетОрганизации
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	|ГДЕ
	|	ПлатежноеПоручениеВходящее.Дата > &Дата
	|	И ПлатежноеПоручениеВходящее.Контрагент = &Контрагент
	|	И (ПлатежноеПоручениеВходящее.СчетОрганизации = &Алла
	|	ИЛИ ПлатежноеПоручениеВходящее.СчетОрганизации = &Антон
	|	ИЛИ ПлатежноеПоручениеВходящее.СчетОрганизации = &Игорь)";

	Алла = Справочники.БанковскиеСчета.НайтиПоКоду("000000024");
	Антон = Справочники.БанковскиеСчета.НайтиПоКоду("000000026");
	Игорь = Справочники.БанковскиеСчета.НайтиПоКоду("000000025");
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата() - 30 * (24 * 60 * 60));
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Алла", Алла);
	Запрос.УстановитьПараметр("Антон", Антон);
	Запрос.УстановитьПараметр("Игорь", Игорь);
	
	Рез = Запрос.Выполнить().Выгрузить();
	
	Если Рез.Количество() <> 0 Тогда
		Код = Рез[Рез.Количество()-1].СчетОрганизации.Код;
		Если Код = "000000024" Тогда
			 Возврат Справочники.Контрагенты.НайтиПоКоду("000000522");
		ИначеЕсли Код = "000000026" Тогда
			Возврат Справочники.Контрагенты.НайтиПоКоду("000000514");
		ИначеЕсли Код = "000000025" Тогда
			Возврат Справочники.Контрагенты.НайтиПоКоду("000000521");
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

