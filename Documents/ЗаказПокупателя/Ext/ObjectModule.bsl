Процедура РасспределитьРезерв(МасИсклЗаказов=Неопределено) Экспорт
	
	//РезКопия = Резерв.Выгрузить();
	Резерв.Очистить();
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	РеализацияТоваровУслугТовары.Количество КАК Количество,
	//               |	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	//               |	РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	//               |	РеализацияТоваровУслугТовары.Склад КАК Склад,
	//               |	РеализацияТоваровУслугТовары.Ссылка КАК Реализ
	//               |ИЗ
	//               |	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
	//               |ГДЕ
	//               |	РеализацияТоваровУслугТовары.Ссылка.Сделка В(&Сделка)
	//               |	И РеализацияТоваровУслугТовары.Ссылка.Сделка <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)";
	МассЗак = Новый Массив;
	МассЗак.Добавить(Ссылка);
	Если ЗначениеЗаполнено(ОсновнойЗаказ) Тогда
		МассЗак.Добавить(ОсновнойЗаказ);
	КонецЕсли;
	//Запрос.УстановитьПараметр("Сделка",МассЗак);
	//РезРеал = Запрос.Выполнить().Выгрузить();
	//
	//МасРЕал = РезРеал.ВыгрузитьКолонку("Реализ");
	
	Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ТоварыВРезервеНаСкладахОбороты.Номенклатура КАК Номенклатура,
	//               |	ТоварыВРезервеНаСкладахОбороты.Склад КАК Склад,
	//               |	ТоварыВРезервеНаСкладахОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	//               |	ТоварыВРезервеНаСкладахОбороты.КоличествоРасход КАК Количество,
	//               |	ТоварыВРезервеНаСкладахОбороты.НК КАК НК
	//               |ИЗ
	//               |	РегистрНакопления.ТоварыВРезервеНаСкладах.Обороты(, , Запись, ) КАК ТоварыВРезервеНаСкладахОбороты
	//               |ГДЕ
	//               |	ТоварыВРезервеНаСкладахОбороты.ДокументРезерва В(&ДокументРезерва)
	//               |	И ТоварыВРезервеНаСкладахОбороты.КоличествоРасход > 0
	//               |	И (ТоварыВРезервеНаСкладахОбороты.Регистратор ССЫЛКА Документ.ЗаказПокупателя
	//               |			ИЛИ ТоварыВРезервеНаСкладахОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг)";
	//               //|	И ТоварыВРезервеНаСкладахОбороты.ДокументРезерва <> &Ссылка";
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТоварыВРезервеНаСкладахОбороты.Склад КАК Склад,
	               |	ТоварыВРезервеНаСкладахОбороты.Номенклатура КАК Номенклатура,
	               |	ТоварыВРезервеНаСкладахОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ТоварыВРезервеНаСкладахОбороты.НК КАК НК,
	               |	ТоварыВРезервеНаСкладахОбороты.КоличествоРасход КАК Количество,
	               |	ТоварыВРезервеНаСкладахОбороты.СрокИзготовления КАК СрокИзготовления
	               |ИЗ
	               |	РегистрНакопления.ТоварыВРезервеНаСкладах.Обороты(, , Авто, ДокументРезерва В (&ДокументРезерва)) КАК ТоварыВРезервеНаСкладахОбороты
	               |ГДЕ
	               |	ТоварыВРезервеНаСкладахОбороты.КоличествоРасход > 0
	               |	И (ТоварыВРезервеНаСкладахОбороты.Регистратор ССЫЛКА Документ.ЗаказПокупателя
	               |			ИЛИ ТоварыВРезервеНаСкладахОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТоварыВРезервеНаСкладахОбороты.Регистратор КАК Регистратор,
	               |	ТоварыВРезервеНаСкладахОбороты.Номенклатура КАК Номенклатура,
	               |	ТоварыВРезервеНаСкладахОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ТоварыВРезервеНаСкладахОбороты.НК КАК НК,
	               |	СУММА(ТоварыВРезервеНаСкладахОбороты.КоличествоПриход) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ТоварыВРезервеНаСкладах.Обороты(, , Авто, ДокументРезерва В (&ДокументРезерва)) КАК ТоварыВРезервеНаСкладахОбороты
	               |ГДЕ
	               |	ТоварыВРезервеНаСкладахОбороты.Регистратор ССЫЛКА Документ.ВозвратТоваровОтПокупателя
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТоварыВРезервеНаСкладахОбороты.Регистратор,
	               |	ТоварыВРезервеНаСкладахОбороты.Номенклатура,
	               |	ТоварыВРезервеНаСкладахОбороты.ХарактеристикаНоменклатуры,
	               |	ТоварыВРезервеНаСкладахОбороты.НК
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ТоварыВРезервеНаСкладахОбороты.КоличествоПриход) > 0
	               |ИТОГИ ПО
	               |	Регистратор";
	


	//Запрос.УстановитьПараметр("Ссылка"         , Ссылка);
	Запрос.УстановитьПараметр("ДокументРезерва", МассЗак);
	
	//РезУехало = Запрос.Выполнить().Выгрузить();
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	РезУехало      = РезультатыЗапроса[0].Выгрузить();
	Возвраты       = РезультатыЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВозвратыТовары = РезультатыЗапроса[1].Выгрузить();
	
	//СкладРезерваУехало="";	
	//Для Каждого Стр Из РезУехало Цикл
	//	Если ЗначениеЗаполнено(Стр.Склад) Тогда
	//		СкладРезерваУехало = Стр.Склад;
	//		Прервать;
	//	КонецЕсли;
	//КонецЦикла;
	
	//РезУехало.Свернуть("Номенклатура, ХарактеристикаНоменклатуры","Количество");
	
	// Добавим резерв того, что уехало
	Для Каждого Стр Из РезУехало Цикл
		
		НС = Резерв.Добавить();
		
		ЗаполнитьЗначенияСвойств(НС, Стр);
		
		//НС.Склад = СкладРезерваУехало;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(СхемаРезервирования) Тогда
		Возврат;
	КонецЕсли;                              
	
	
	//ВозвратыТовары.Удалить(ВозвратыТовары[0]);
	
	ВозвратыТовары.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, НК", "Количество");
	
	ПараметрыОтбора = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, НК");
	
	МассивУдалить = Новый Массив;
	
	Для Каждого СтрокаТЗ Из РезУехало Цикл
	
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаТЗ);
		
		НайденныеСтроки = ВозвратыТовары.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			СтрокаВозврата = НайденныеСтроки[0];
			
			Если СтрокаТЗ.Количество > СтрокаВозврата.Количество Тогда
				
				СтрокаТЗ.Количество = СтрокаТЗ.Количество - СтрокаВозврата.Количество;
				
				ВозвратыТовары.Удалить(СтрокаВозврата);
				
			ИначеЕсли СтрокаВозврата.Количество > СтрокаТЗ.Количество Тогда
				
				СтрокаВозврата.Количество = СтрокаВозврата.Количество - СтрокаТЗ.Количество;
				
				МассивУдалить.Добавить(СтрокаТЗ);
				
			Иначе
				
				ВозвратыТовары.Удалить(СтрокаВозврата);
				
				МассивУдалить.Добавить(СтрокаТЗ);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаТЗ Из МассивУдалить Цикл
		
		РезУехало.Удалить(СтрокаТЗ);
		
	КонецЦикла;
	
	// удалим из товаров что уехало
	Товары1 = Товары.Выгрузить();
	Товары1.Колонки.Добавить("НК");
	
	//добавим НК
	НужноУдалить = Новый Массив;
	Для Каждого Стр Из Товары1 Цикл
		//Если Стр.Номенклатура.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоКоду("000000009") Тогда
		Если Стр.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Комплект Тогда
			НужноУдалить.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	
	ТЗ = Товары1.СкопироватьКолонки();
	Для Каждого Стр Из НужноУдалить Цикл
		Комплектующие = Новый ТаблицаЗначений;
		
		Комплектующие.Колонки.Добавить("Комплектующая");              
		Комплектующие.Колонки.Добавить("Количество");
		Комплектующие.Колонки.Добавить("ХарактеристикаКомплектующей");
		
		БИАС.ПолучитьКомплектующиеНК(Стр.ХарактеристикаНоменклатуры, Комплектующие);
		
		Для Каждого ком Из Комплектующие Цикл
			НС = ТЗ.Добавить();
			НС.Номенклатура = Ком.Комплектующая;
			НС.ХарактеристикаНоменклатуры = Ком.ХарактеристикаКомплектующей;
			НС.Количество = Стр.Количество * ком.Количество ;
			НС.НК = Стр.ХарактеристикаНоменклатуры;
		КонецЦикла;
		
		Товары1.Удалить(Стр);
	КонецЦикла;
	
	Для Каждого Стр Из ТЗ Цикл
		НС = Товары1.Добавить();
		ЗаполнитьЗначенияСвойств(НС,Стр);
	КонецЦикла;
	
	Товары1.Свернуть("Номенклатура,ХарактеристикаНоменклатуры,Размещение,НК","Количество");
	
	НужноУдалить = Новый Массив;
	Для Каждого Стр Из РезУехало Цикл
		НайденТовар = Товары1.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры",Стр.Номенклатура,Стр.ХарактеристикаНоменклатуры));
		Если НайденТовар.Количество()>0 Тогда
			Если НайденТовар[0].Количество>Стр.Количество Тогда
				НайденТовар[0].Количество = НайденТовар[0].Количество-Стр.Количество;
			ИНаче
				НужноУдалить.Добавить(НайденТовар[0]);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Стр Из НужноУдалить Цикл
		Попытка
			Товары1.Удалить(Стр);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	МассивУдалить = Новый Массив;
	
	Пока Возвраты.Следующий() Цикл
		
		МассивСтрокВозврата = Новый Массив;
		
		ЗаписатьВозврат = Ложь;
		
		ВозвратОбъект = Возвраты.Регистратор.ПолучитьОбъект();
		
		ВозвратыТовары = Возвраты.Выбрать();
		
		Пока ВозвратыТовары.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора, ВозвратыТовары);
			
			Если ПараметрыОтбора.НК.Пустая() Тогда
				
				ПараметрыОтбора.НК = Неопределено;
				
			КонецЕсли;
			
			НайденныеСтроки = Товары1.НайтиСтроки(ПараметрыОтбора);
			
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				Если НайденныеСтроки[0].Количество >= ВозвратыТовары.Количество Тогда
					
					Если ПараметрыОтбора.НК = Неопределено Тогда
						
						ПараметрыОтбора.НК = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
						
					КонецЕсли;
					
					НайденныеСтрокиВозврата = ВозвратОбъект.Товары.НайтиСтроки(ПараметрыОтбора);
					
					Если НайденныеСтрокиВозврата.Количество() > 0 Тогда
						
						БИАС.ЗаполнитьРезерв(ВозвратОбъект, Ссылка, НайденныеСтрокиВозврата[0], СхемаРезервирования, МасИсклЗаказов);
						
						МассивСтрокВозврата.Добавить(НайденныеСтрокиВозврата[0]);
						
						ЗаписатьВозврат = Истина;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если НайденныеСтроки[0].Количество > ВозвратыТовары.Количество Тогда
					
					НайденныеСтроки[0].Количество = НайденныеСтроки[0].Количество - ВозвратыТовары.Количество;
					
				Иначе
					
					Если МассивУдалить.Найти(НайденныеСтроки[0]) = Неопределено Тогда
						
						МассивУдалить.Добавить(НайденныеСтроки[0]);
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого СтрокаТЗ Из МассивСтрокВозврата Цикл
			
			ВозвратОбъект.Товары.Удалить(СтрокаТЗ);
			
		КонецЦикла;
		
		Если ЗаписатьВозврат Тогда
			
			ВозвратОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		КонецЕсли;
		
	КонецЦикла;
	                                                                                    
	Для Каждого СтрокаТЗ Из МассивУдалить Цикл
		
		Товары1.Удалить(СтрокаТЗ);
		
	КонецЦикла;
	
	Товары1.Свернуть("Номенклатура,ХарактеристикаНоменклатуры,Размещение,НК","Количество");
	
	Для Каждого Стр Из Товары1 Цикл 
		Схема =  ?((ТипЦен.Код = "000000001" ИЛИ ТипЦен.Код = "000000011") И НЕ ЗначениеЗаполнено(Стр.НК), Справочники.СхемыРезервирования.НайтиПоКоду("Кр0000021"), СхемаРезервирования); 
		Стр.Размещение = ОбщегоНазначения.СкладРезерваПолучить(Стр,Схема, МасИсклЗаказов);
		ЗаполнитьРезерв(Стр, МасИсклЗаказов);
	КонецЦикла;
	
	//а теперя разберем НК))
	ТабРез = Резерв.Выгрузить();
	Резерв.Очистить();
	ТабРез.Колонки.Добавить("Взяли",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Для Каждого Стр Из Товары Цикл
		//Если Стр.Номенклатура.ВидНоменклатуры =  Справочники.ВидыНоменклатуры.НайтиПоКоду("000000009") Тогда
		//	Комплектующие = ОбщегоНазначения.Комплектующие_НК(Стр.ХарактеристикаНоменклатуры);
		Если Стр.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Комплект Тогда
			
			Комплектующие = Новый ТаблицаЗначений;
			
			Комплектующие.Колонки.Добавить("Комплектующая");
			Комплектующие.Колонки.Добавить("Количество");
			Комплектующие.Колонки.Добавить("ХарактеристикаКомплектующей");
			
			БИАС.ПолучитьКомплектующиеНК(Стр.ХарактеристикаНоменклатуры, Комплектующие);
				
			Для Каждого Ком Из Комплектующие Цикл
				// распределяем
				Надо = Стр.Количество * Ком.Количество;
				Для Каждого Рез1 Из ТабРез Цикл
					Если Рез1.Взяли >= Рез1.Количество Тогда  // эта строка уже распределена
						Продолжить;
					КонецЕсли;
					Если НЕ Рез1.ХарактеристикаНоменклатуры = Ком.ХарактеристикаКомплектующей Тогда 
						Продолжить;
					КонецЕсли;
					Если Рез1.Количество-Рез1.Взяли>=Надо Тогда
						Кол = Надо;
					Иначе
						Кол = Рез1.Количество-Рез1.Взяли;
					КонецЕсли;
					Рез1.Взяли = Рез1.Взяли+Кол;
					Рез1.НК = Стр.ХарактеристикаНоменклатуры;
					Надо = Надо-Кол;
					Если Надо <=0 Тогда Прервать; КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
		
	Для Каждого Стр Из ТабРез Цикл   //если частично пошло на НК, разделим
		Если ЗначениеЗаполнено(Стр.НК) И Стр.Взяли<Стр.Количество Тогда
			НС = ТабРез.Добавить();
			ЗаполнитьЗначенияСвойств(НС,Стр);
			НС.Количество = Стр.Количество-Стр.Взяли;
			НС.НК = "";
			
			Стр.Количество = Стр.Взяли;
			
		КонецЕсли;
	КонецЦикла;
		
	Для Каждого Стр Из Товары Цикл
		Надо = Стр.Количество;
		//Если НЕ Стр.Номенклатура.ВидНоменклатуры =  Справочники.ВидыНоменклатуры.НайтиПоКоду("000000009") Тогда
		Если Не Стр.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Комплект Тогда
			Для Каждого Рез1 Из ТабРез Цикл
				Если Рез1.Взяли >= Рез1.Количество Тогда // эта строка уже распределена
					Продолжить;
				КонецЕсли;
				Если НЕ Рез1.ХарактеристикаНоменклатуры = Стр.ХарактеристикаНоменклатуры Тогда 
					Продолжить;
				КонецЕсли;
				Если Рез1.Количество-Рез1.Взяли>=Стр.Количество Тогда
					Кол = Стр.Количество;
				Иначе
					Кол = Рез1.Количество-Рез1.Взяли;
				КонецЕсли;
				Рез1.Взяли = Рез1.Взяли+Кол;
				Надо = Надо-Кол;
				Если Надо <=0 Тогда Прервать; КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;
	
	НужноУдалить = Новый Массив; //удалим где без НК и взяли 0	
	Для Каждого Стр Из ТабРез Цикл
		Если НЕ ЗначениеЗаполнено(Стр.НК) И Стр.Взяли = 0 Тогда
			НужноУдалить.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из НужноУдалить Цикл
		ТабРез.Удалить(Стр);
	КонецЦикла;
	
	Для Каждого Стр Из ТабРез Цикл
		НС = Резерв.Добавить();
		ЗаполнитьЗначенияСвойств(НС,Стр)
	КонецЦикла;
	
	Резерв.Сортировать("Номенклатура,ХарактеристикаНоменклатуры");
	
КонецПроцедуры

Процедура ЗаполнитьРезерв(СтрНоменклатуры, МасИсклЗак = Неопределено)Экспорт
	//Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	//               |ИЗ
	//               |	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	//               |ГДЕ
	//               |	РеализацияТоваровУслуг.Сделка В(&Сделка)";
	//МассЗак = Новый Массив;
	//МассЗак.Добавить(Ссылка);
	//Если ЗначениеЗаполнено(ОсновнойЗаказ) Тогда
	//	МассЗак.Добавить(ОсновнойЗаказ);
	//КонецЕсли;
	//Запрос.УстановитьПараметр("Сделка",МассЗак);
	//Рез = Запрос.Выполнить().Выгрузить();
	//МассРеал = Рез.ВыгрузитьКолонку("Ссылка");
	//
	////разерв уехал
	//Запрос.Текст = "ВЫБРАТЬ
	//               |	ТоварыВРезервеНаСкладахОбороты.Номенклатура КАК Номенклатура,
	//               |	ТоварыВРезервеНаСкладахОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	//               |	ТоварыВРезервеНаСкладахОбороты.Склад КАК Склад,
	//               |	-ТоварыВРезервеНаСкладахОбороты.КоличествоОборот КАК Количество
	//               |ИЗ
	//               |	РегистрНакопления.ТоварыВРезервеНаСкладах.Обороты(, , , ) КАК ТоварыВРезервеНаСкладахОбороты
	//               |ГДЕ
	//               |	ТоварыВРезервеНаСкладахОбороты.ДокументРезерва В(&ДокументРезерва)";
	//Запрос.УстановитьПараметр("ДокументРезерва",МассРеал);
	//РезУехал = Запрос.Выполнить().Выгрузить();
	//
	Характеристика = СтрНоменклатуры.ХарактеристикаНоменклатуры;
	ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
	Ростовка = ХарактеристикаОбъект.ПолучитьРостовку(Истина);
	
	
	 Склады = Новый Массив; 
	 Схема =  ?((ТипЦен.Код = "000000001" ИЛИ ТипЦен.Код = "000000011") И НЕ ЗначениеЗаполнено(СтрНоменклатуры.НК), Справочники.СхемыРезервирования.НайтиПоКоду("Кр0000021"), СхемаРезервирования);
	 
	 Если ХарактеристикаОбъект.ЭтоХарактеристикаНК() И ЗначениеЗаполнено(СтрНоменклатуры.НК) И Ростовка.ИгнорироватьНоль Тогда
		 
		Для Каждого Стр из Схема.Склады Цикл
			Если Не Стр.Склад.Розница Тогда
				 Склады.Добавить(Стр.Склад);
			КонецЕсли;
		КонецЦикла;		
	Иначе
		Склады = Схема.Склады.ВыгрузитьКолонку("Склад"); 
	КонецЕсли;

	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВложенныйЗапрос.Склад КАК Склад,
	               |	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	               |	СУММА(ВложенныйЗапрос.КоличествоОстаток) КАК Количество
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад,
	               |		ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
	               |		-ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	               |	ИЗ
	               |		РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	               |				,
	               |				НЕ Склад В (&Склады)
	               |					И НЕ ДокументРезерва В (&ДокументРезерва)
	               |					И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ТоварыВРезервеНаСкладахОстатки
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ТоварыНаСкладахОстатки.Склад,
	               |		ТоварыНаСкладахОстатки.Номенклатура,
	               |		ТоварыНаСкладахОстатки.КоличествоОстаток
	               |	ИЗ
	               |		РегистрНакопления.ТоварыНаСкладах.Остатки(
	               |				,
	               |				НЕ Склад В (&Склады)
	               |					И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ТоварыНаСкладахОстатки) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.Номенклатура,
	               |	ВложенныйЗапрос.Склад
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Количество УБЫВ";
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",Характеристика);
	Запрос.УстановитьПараметр("Склады",Склады);
	Запрос.УстановитьПараметр("ДокументРезерва",МасИсклЗак);
	//Запрос.УстановитьПараметр("МассивРеализаций",МассРеал);
	
	РезОстатков = Запрос.Выполнить().Выгрузить();
	Скл = Неопределено;
	Зарезервировано = 0;
	Если ЗначениеЗаполнено(СхемаРезервирования) И СхемаРезервирования.Склады.Количество()>0 ТОгда
		ЭтоОпт = ТипЦен = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000001");
		ЭтоИзРостовки = ЗначениеЗаполнено(СтрНоменклатуры.НК);
		//Если ЭтоОпт И ЭтоИзРостовки И Ростовка.ИгнорироватьНоль Тогда
		//	Склады = Справочники.СхемыРезервирования.НайтиПоКоду("Кр0000014").Склады;
		//Иначе 
			
		//КонецЕсли;
			
		ДЛя Каждого склад Из Склады Цикл
			Если Зарезервировано>=СтрНоменклатуры.Количество Тогда Продолжить; КонецЕсли;
			МасСкл = Новый Массив;
			МасСкл.Добавить(Склад);
			Ост = ОбщегоНазначения.ОстатокНоменклатуры(СтрНоменклатуры.Номенклатура,МасСкл,СтрНоменклатуры.ХарактеристикаНоменклатуры,ТекущаяДата());
			Рез = ОбщегоНазначения.РезервНоменклатуры(СтрНоменклатуры.Номенклатура,МасСкл,СтрНоменклатуры.ХарактеристикаНоменклатуры,ТекущаяДата(),Ссылка,МасИсклЗак);
			//ОтборУехал = РезУехал.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры,Склад",СтрНоменклатуры.Номенклатура,СтрНоменклатуры.ХарактеристикаНоменклатуры,Стр.Склад));
			//ТабУехал = РезУехал.Скопировать(ОтборУехал);
			//Уехал = ТабУехал.Итог("Количество"); +Уехал
			Наличие = Ост-Рез;
			Если Наличие>0 Тогда
				Если Наличие<СтрНоменклатуры.Количество-Зарезервировано  Тогда 
					НС = Резерв.Добавить();
					ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
					НС.Склад = Склад;
					НС.Количество = Наличие;
					Зарезервировано = Зарезервировано+НС.Количество;
				Иначе
					НС = Резерв.Добавить();
					ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
					НС.Склад = Склад;
					НС.Количество = СтрНоменклатуры.Количество-Зарезервировано;
					Зарезервировано = Зарезервировано+НС.Количество;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
			Если Зарезервировано<СтрНоменклатуры.Количество  Тогда  //если и на других нету, тогда доберем в минус из приора
				Попытка
					НС = Резерв.Добавить();
					ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
					НС.Склад = Склады[Склады.Количество()-1];
					НС.Количество = СтрНоменклатуры.Количество-Зарезервировано;
					Зарезервировано = Зарезервировано+НС.Количество;
				Исключение
				КонецПопытки;
			КонецЕсли;
	КонецЕсли;
		
	//если не хватило на приоритетных или схема не выбрана
	Если Зарезервировано<СтрНоменклатуры.Количество Тогда 
		ДЛя Каждого Стр Из РезОстатков Цикл
			Если Зарезервировано>=СтрНоменклатуры.Количество Тогда Продолжить; КонецЕсли;
			Если Стр.Количество>0 Тогда
				Если Стр.Количество<СтрНоменклатуры.Количество-Зарезервировано  Тогда 
					НС = Резерв.Добавить();
					ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
					НС.Склад = Склад;
					НС.Количество = Стр.Количество;
					Зарезервировано = Зарезервировано+НС.Количество;
				Иначе
					НС = Резерв.Добавить();
					ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
					НС.Склад = Склад;
					НС.Количество = СтрНоменклатуры.Количество-Зарезервировано;
					Зарезервировано = Зарезервировано+НС.Количество;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Зарезервировано<СтрНоменклатуры.Количество И РезОстатков.Количество()>0 Тогда  //если и на других нету, тогда доберем в минус 
			НС = Резерв.Добавить();
			ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
			НС.Склад = РезОстатков[0];
			НС.Количество = СтрНоменклатуры.Количество-Зарезервировано;
			Зарезервировано = Зарезервировано+НС.Количество;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// ==========================================================================================
// БЛОК ДЛЯ ПРОВЕРКИ ОПТИМИЗАЦИИ РЕЗЕРВИРОВАНИЯ (2026-07-24).
// Ничего из старого кода (РасспределитьРезерв/ЗаполнитьРезерв) не менялось и не вызывается
// отсюда. Три новые процедуры/функции ниже - самостоятельная копия с тем же результатом,
// но без запроса на каждый склад в цикле. Использовать только через
// Документ.РасспределитьРезервОпт() для сравнения со старым результатом
// (см. ЗаказПокупателя.ТестСравнитьРезерв в модуле менеджера). В боевой процесс проведения
// пока не включено.
// ==========================================================================================

Функция КлючКэшаОстатков(Знач Номенклатура, Знач Характеристика, Знач Склад) Экспорт

	Возврат XMLСтрока(Номенклатура) + "|" + XMLСтрока(Характеристика) + "|" + XMLСтрока(Склад);

КонецФункции

Процедура РасспределитьРезервОпт(МасИсклЗаказов=Неопределено, ИсправитьБагСклада = Ложь) Экспорт

	Резерв.Очистить();

	МассЗак = Новый Массив;
	МассЗак.Добавить(Ссылка);
	Если ЗначениеЗаполнено(ОсновнойЗаказ) Тогда
		МассЗак.Добавить(ОсновнойЗаказ);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТоварыВРезервеНаСкладахОбороты.Склад КАК Склад,
	               |	ТоварыВРезервеНаСкладахОбороты.Номенклатура КАК Номенклатура,
	               |	ТоварыВРезервеНаСкладахОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ТоварыВРезервеНаСкладахОбороты.НК КАК НК,
	               |	ТоварыВРезервеНаСкладахОбороты.КоличествоРасход КАК Количество,
	               |	ТоварыВРезервеНаСкладахОбороты.СрокИзготовления КАК СрокИзготовления
	               |ИЗ
	               |	РегистрНакопления.ТоварыВРезервеНаСкладах.Обороты(, , Авто, ДокументРезерва В (&ДокументРезерва)) КАК ТоварыВРезервеНаСкладахОбороты
	               |ГДЕ
	               |	ТоварыВРезервеНаСкладахОбороты.КоличествоРасход > 0
	               |	И (ТоварыВРезервеНаСкладахОбороты.Регистратор ССЫЛКА Документ.ЗаказПокупателя
	               |			ИЛИ ТоварыВРезервеНаСкладахОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТоварыВРезервеНаСкладахОбороты.Регистратор КАК Регистратор,
	               |	ТоварыВРезервеНаСкладахОбороты.Номенклатура КАК Номенклатура,
	               |	ТоварыВРезервеНаСкладахОбороты.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ТоварыВРезервеНаСкладахОбороты.НК КАК НК,
	               |	СУММА(ТоварыВРезервеНаСкладахОбороты.КоличествоПриход) КАК Количество
	               |ИЗ
	               |	РегистрНакопления.ТоварыВРезервеНаСкладах.Обороты(, , Авто, ДокументРезерва В (&ДокументРезерва)) КАК ТоварыВРезервеНаСкладахОбороты
	               |ГДЕ
	               |	ТоварыВРезервеНаСкладахОбороты.Регистратор ССЫЛКА Документ.ВозвратТоваровОтПокупателя
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТоварыВРезервеНаСкладахОбороты.Регистратор,
	               |	ТоварыВРезервеНаСкладахОбороты.Номенклатура,
	               |	ТоварыВРезервеНаСкладахОбороты.ХарактеристикаНоменклатуры,
	               |	ТоварыВРезервеНаСкладахОбороты.НК
	               |
	               |ИМЕЮЩИЕ
	               |	СУММА(ТоварыВРезервеНаСкладахОбороты.КоличествоПриход) > 0
	               |ИТОГИ ПО
	               |	Регистратор";

	Запрос.УстановитьПараметр("ДокументРезерва", МассЗак);

	РезультатыЗапроса = Запрос.ВыполнитьПакет();

	РезУехало      = РезультатыЗапроса[0].Выгрузить();
	Возвраты       = РезультатыЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВозвратыТовары = РезультатыЗапроса[1].Выгрузить();

	Для Каждого Стр Из РезУехало Цикл
		НС = Резерв.Добавить();
		ЗаполнитьЗначенияСвойств(НС, Стр);
	КонецЦикла;

	Если Не ЗначениеЗаполнено(СхемаРезервирования) Тогда
		Возврат;
	КонецЕсли;

	ВозвратыТовары.Свернуть("Номенклатура, ХарактеристикаНоменклатуры, НК", "Количество");

	ПараметрыОтбора = Новый Структура("Номенклатура, ХарактеристикаНоменклатуры, НК");

	МассивУдалить = Новый Массив;

	Для Каждого СтрокаТЗ Из РезУехало Цикл

		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаТЗ);

		НайденныеСтроки = ВозвратыТовары.НайтиСтроки(ПараметрыОтбора);

		Если НайденныеСтроки.Количество() > 0 Тогда

			СтрокаВозврата = НайденныеСтроки[0];

			Если СтрокаТЗ.Количество > СтрокаВозврата.Количество Тогда

				СтрокаТЗ.Количество = СтрокаТЗ.Количество - СтрокаВозврата.Количество;

				ВозвратыТовары.Удалить(СтрокаВозврата);

			ИначеЕсли СтрокаВозврата.Количество > СтрокаТЗ.Количество Тогда

				СтрокаВозврата.Количество = СтрокаВозврата.Количество - СтрокаТЗ.Количество;

				МассивУдалить.Добавить(СтрокаТЗ);

			Иначе

				ВозвратыТовары.Удалить(СтрокаВозврата);

				МассивУдалить.Добавить(СтрокаТЗ);

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаТЗ Из МассивУдалить Цикл
		РезУехало.Удалить(СтрокаТЗ);
	КонецЦикла;

	Товары1 = Товары.Выгрузить();
	Товары1.Колонки.Добавить("НК");

	НужноУдалить = Новый Массив;
	Для Каждого Стр Из Товары1 Цикл
		Если Стр.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Комплект Тогда
			НужноУдалить.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;

	ТЗ = Товары1.СкопироватьКолонки();
	Для Каждого Стр Из НужноУдалить Цикл
		Комплектующие = Новый ТаблицаЗначений;

		Комплектующие.Колонки.Добавить("Комплектующая");
		Комплектующие.Колонки.Добавить("Количество");
		Комплектующие.Колонки.Добавить("ХарактеристикаКомплектующей");

		БИАС.ПолучитьКомплектующиеНК(Стр.ХарактеристикаНоменклатуры, Комплектующие);

		Для Каждого ком Из Комплектующие Цикл
			НС = ТЗ.Добавить();
			НС.Номенклатура = Ком.Комплектующая;
			НС.ХарактеристикаНоменклатуры = Ком.ХарактеристикаКомплектующей;
			НС.Количество = Стр.Количество * ком.Количество ;
			НС.НК = Стр.ХарактеристикаНоменклатуры;
		КонецЦикла;

		Товары1.Удалить(Стр);
	КонецЦикла;

	Для Каждого Стр Из ТЗ Цикл
		НС = Товары1.Добавить();
		ЗаполнитьЗначенияСвойств(НС,Стр);
	КонецЦикла;

	Товары1.Свернуть("Номенклатура,ХарактеристикаНоменклатуры,Размещение,НК","Количество");

	НужноУдалить = Новый Массив;
	Для Каждого Стр Из РезУехало Цикл
		НайденТовар = Товары1.НайтиСтроки(Новый Структура("Номенклатура,ХарактеристикаНоменклатуры",Стр.Номенклатура,Стр.ХарактеристикаНоменклатуры));
		Если НайденТовар.Количество()>0 Тогда
			Если НайденТовар[0].Количество>Стр.Количество Тогда
				НайденТовар[0].Количество = НайденТовар[0].Количество-Стр.Количество;
			ИНаче
				НужноУдалить.Добавить(НайденТовар[0]);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Стр Из НужноУдалить Цикл
		Попытка
			Товары1.Удалить(Стр);
		Исключение
		КонецПопытки;
	КонецЦикла;

	МассивУдалить = Новый Массив;

	Пока Возвраты.Следующий() Цикл

		МассивСтрокВозврата = Новый Массив;

		ЗаписатьВозврат = Ложь;

		ВозвратОбъект = Возвраты.Регистратор.ПолучитьОбъект();

		ВозвратыТовары = Возвраты.Выбрать();

		Пока ВозвратыТовары.Следующий() Цикл

			ЗаполнитьЗначенияСвойств(ПараметрыОтбора, ВозвратыТовары);

			Если ПараметрыОтбора.НК.Пустая() Тогда
				ПараметрыОтбора.НК = Неопределено;
			КонецЕсли;

			НайденныеСтроки = Товары1.НайтиСтроки(ПараметрыОтбора);

			Если НайденныеСтроки.Количество() > 0 Тогда

				Если НайденныеСтроки[0].Количество >= ВозвратыТовары.Количество Тогда

					Если ПараметрыОтбора.НК = Неопределено Тогда
						ПараметрыОтбора.НК = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
					КонецЕсли;

					НайденныеСтрокиВозврата = ВозвратОбъект.Товары.НайтиСтроки(ПараметрыОтбора);

					Если НайденныеСтрокиВозврата.Количество() > 0 Тогда

						БИАС.ЗаполнитьРезерв(ВозвратОбъект, Ссылка, НайденныеСтрокиВозврата[0], СхемаРезервирования, МасИсклЗаказов);

						МассивСтрокВозврата.Добавить(НайденныеСтрокиВозврата[0]);

						ЗаписатьВозврат = Истина;

					КонецЕсли;

				КонецЕсли;

				Если НайденныеСтроки[0].Количество > ВозвратыТовары.Количество Тогда
					НайденныеСтроки[0].Количество = НайденныеСтроки[0].Количество - ВозвратыТовары.Количество;
				Иначе
					Если МассивУдалить.Найти(НайденныеСтроки[0]) = Неопределено Тогда
						МассивУдалить.Добавить(НайденныеСтроки[0]);
					КонецЕсли;
				КонецЕсли;

			КонецЕсли;

		КонецЦикла;

		Для Каждого СтрокаТЗ Из МассивСтрокВозврата Цикл
			ВозвратОбъект.Товары.Удалить(СтрокаТЗ);
		КонецЦикла;

		Если ЗаписатьВозврат Тогда
			ВозвратОбъект.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;

	КонецЦикла;

	Для Каждого СтрокаТЗ Из МассивУдалить Цикл
		Товары1.Удалить(СтрокаТЗ);
	КонецЦикла;

	Товары1.Свернуть("Номенклатура,ХарактеристикаНоменклатуры,Размещение,НК","Количество");

	// ==== Пакетная предзагрузка остатков/резерва (единственное содержательное отличие от РасспределитьРезерв) ====
	МасНоменклатурКлюч = Новый Массив;
	МасХарактеристикКлюч = Новый Массив;
	МасСкладовКлюч = Новый Массив;

	Для Каждого СтрПрефетч Из Товары1 Цикл

		Если СтрПрефетч.Номенклатура.ВидНоменклатуры.Код = "000000010" Тогда
			Продолжить; // "набор" считается как раньше, отдельными запросами внутри ЗаполнитьРезервОпт
		КонецЕсли;

		СхемаПрефетч = ?((ТипЦен.Код = "000000001" ИЛИ ТипЦен.Код = "000000011") И НЕ ЗначениеЗаполнено(СтрПрефетч.НК), Справочники.СхемыРезервирования.НайтиПоКоду("Кр0000021"), СхемаРезервирования);

		Если Не ЗначениеЗаполнено(СхемаПрефетч) ИЛИ СхемаПрефетч.Склады.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		ХарактеристикаОбъектПрефетч = СтрПрефетч.ХарактеристикаНоменклатуры.ПолучитьОбъект();
		РостовкаПрефетч = ХарактеристикаОбъектПрефетч.ПолучитьРостовку(Истина);

		СкладыПрефетч = Новый Массив;
		Если ХарактеристикаОбъектПрефетч.ЭтоХарактеристикаНК() И ЗначениеЗаполнено(СтрПрефетч.НК) И РостовкаПрефетч.ИгнорироватьНоль Тогда
			Для Каждого СтрСхемы Из СхемаПрефетч.Склады Цикл
				Если Не СтрСхемы.Склад.Розница Тогда
					СкладыПрефетч.Добавить(СтрСхемы.Склад);
				КонецЕсли;
			КонецЦикла;
		Иначе
			СкладыПрефетч = СхемаПрефетч.Склады.ВыгрузитьКолонку("Склад");
		КонецЕсли;

		Если МасНоменклатурКлюч.Найти(СтрПрефетч.Номенклатура) = Неопределено Тогда
			МасНоменклатурКлюч.Добавить(СтрПрефетч.Номенклатура);
		КонецЕсли;
		Если МасХарактеристикКлюч.Найти(СтрПрефетч.ХарактеристикаНоменклатуры) = Неопределено Тогда
			МасХарактеристикКлюч.Добавить(СтрПрефетч.ХарактеристикаНоменклатуры);
		КонецЕсли;
		Для Каждого СкладПрефетч Из СкладыПрефетч Цикл
			Если МасСкладовКлюч.Найти(СкладПрефетч) = Неопределено Тогда
				МасСкладовКлюч.Добавить(СкладПрефетч);
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	ОстаткиМап = Новый Соответствие;
	РезервМап  = Новый Соответствие;

	Если МасНоменклатурКлюч.Количество() > 0 И МасСкладовКлюч.Количество() > 0 Тогда

		ЗапросПрефетч = Новый Запрос;
		ЗапросПрефетч.Текст =
		"ВЫБРАТЬ
		|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТоварыНаСкладахОстатки.Склад КАК Склад,
		|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			&ТекущаяДата,
		|			Номенклатура В (&МасНоменклатур)
		|				И ХарактеристикаНоменклатуры В (&МасХарактеристик)
		|				И Склад В (&МасСкладов)) КАК ТоварыНаСкладахОстатки
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад,
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
		|			&ТекущаяДата,
		|			Номенклатура В (&МасНоменклатур)
		|				И ХарактеристикаНоменклатуры В (&МасХарактеристик)
		|				И Склад В (&МасСкладов)
		|				И ДокументРезерва <> &Ссылка
		|				И НЕ ДокументРезерва В (&МасИсклЗак)) КАК ТоварыВРезервеНаСкладахОстатки";

		ЗапросПрефетч.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
		ЗапросПрефетч.УстановитьПараметр("МасНоменклатур", МасНоменклатурКлюч);
		ЗапросПрефетч.УстановитьПараметр("МасХарактеристик", МасХарактеристикКлюч);
		ЗапросПрефетч.УстановитьПараметр("МасСкладов", МасСкладовКлюч);
		ЗапросПрефетч.УстановитьПараметр("Ссылка", Ссылка);
		ЗапросПрефетч.УстановитьПараметр("МасИсклЗак", МасИсклЗаказов);

		РезультатыПрефетч = ЗапросПрефетч.ВыполнитьПакет();

		ВыборкаОст = РезультатыПрефетч[0].Выбрать();
		Пока ВыборкаОст.Следующий() Цикл
			ОстаткиМап.Вставить(КлючКэшаОстатков(ВыборкаОст.Номенклатура, ВыборкаОст.ХарактеристикаНоменклатуры, ВыборкаОст.Склад), ВыборкаОст.Количество);
		КонецЦикла;

		ВыборкаРез = РезультатыПрефетч[1].Выбрать();
		Пока ВыборкаРез.Следующий() Цикл
			РезервМап.Вставить(КлючКэшаОстатков(ВыборкаРез.Номенклатура, ВыборкаРез.ХарактеристикаНоменклатуры, ВыборкаРез.Склад), ВыборкаРез.Количество);
		КонецЦикла;

	КонецЕсли;
	// ==== конец блока предзагрузки ====

	Для Каждого Стр Из Товары1 Цикл
		Схема =  ?((ТипЦен.Код = "000000001" ИЛИ ТипЦен.Код = "000000011") И НЕ ЗначениеЗаполнено(Стр.НК), Справочники.СхемыРезервирования.НайтиПоКоду("Кр0000021"), СхемаРезервирования);
		Стр.Размещение = ОбщегоНазначения.СкладРезерваПолучить(Стр,Схема, МасИсклЗаказов);
		ЗаполнитьРезервОпт(Стр, МасИсклЗаказов, ОстаткиМап, РезервМап, ИсправитьБагСклада);
	КонецЦикла;

	//а теперя разберем НК))
	ТабРез = Резерв.Выгрузить();
	Резерв.Очистить();
	ТабРез.Колонки.Добавить("Взяли",Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Для Каждого Стр Из Товары Цикл
		Если Стр.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Комплект Тогда

			Комплектующие = Новый ТаблицаЗначений;

			Комплектующие.Колонки.Добавить("Комплектующая");
			Комплектующие.Колонки.Добавить("Количество");
			Комплектующие.Колонки.Добавить("ХарактеристикаКомплектующей");

			БИАС.ПолучитьКомплектующиеНК(Стр.ХарактеристикаНоменклатуры, Комплектующие);

			Для Каждого Ком Из Комплектующие Цикл
				Надо = Стр.Количество * Ком.Количество;
				Для Каждого Рез1 Из ТабРез Цикл
					Если Рез1.Взяли >= Рез1.Количество Тогда
						Продолжить;
					КонецЕсли;
					Если НЕ Рез1.ХарактеристикаНоменклатуры = Ком.ХарактеристикаКомплектующей Тогда
						Продолжить;
					КонецЕсли;
					Если Рез1.Количество-Рез1.Взяли>=Надо Тогда
						Кол = Надо;
					Иначе
						Кол = Рез1.Количество-Рез1.Взяли;
					КонецЕсли;
					Рез1.Взяли = Рез1.Взяли+Кол;
					Рез1.НК = Стр.ХарактеристикаНоменклатуры;
					Надо = Надо-Кол;
					Если Надо <=0 Тогда Прервать; КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Стр Из ТабРез Цикл
		Если ЗначениеЗаполнено(Стр.НК) И Стр.Взяли<Стр.Количество Тогда
			НС = ТабРез.Добавить();
			ЗаполнитьЗначенияСвойств(НС,Стр);
			НС.Количество = Стр.Количество-Стр.Взяли;
			НС.НК = "";

			Стр.Количество = Стр.Взяли;

		КонецЕсли;
	КонецЦикла;

	Для Каждого Стр Из Товары Цикл
		Надо = Стр.Количество;
		Если Не Стр.Номенклатура.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Комплект Тогда
			Для Каждого Рез1 Из ТабРез Цикл
				Если Рез1.Взяли >= Рез1.Количество Тогда
					Продолжить;
				КонецЕсли;
				Если НЕ Рез1.ХарактеристикаНоменклатуры = Стр.ХарактеристикаНоменклатуры Тогда
					Продолжить;
				КонецЕсли;
				Если Рез1.Количество-Рез1.Взяли>=Стр.Количество Тогда
					Кол = Стр.Количество;
				Иначе
					Кол = Рез1.Количество-Рез1.Взяли;
				КонецЕсли;
				Рез1.Взяли = Рез1.Взяли+Кол;
				Надо = Надо-Кол;
				Если Надо <=0 Тогда Прервать; КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;

	НужноУдалить = Новый Массив;
	Для Каждого Стр Из ТабРез Цикл
		Если НЕ ЗначениеЗаполнено(Стр.НК) И Стр.Взяли = 0 Тогда
			НужноУдалить.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из НужноУдалить Цикл
		ТабРез.Удалить(Стр);
	КонецЦикла;

	Для Каждого Стр Из ТабРез Цикл
		НС = Резерв.Добавить();
		ЗаполнитьЗначенияСвойств(НС,Стр)
	КонецЦикла;

	Резерв.Сортировать("Номенклатура,ХарактеристикаНоменклатуры");

КонецПроцедуры

Процедура ЗаполнитьРезервОпт(СтрНоменклатуры, МасИсклЗак = Неопределено, ОстаткиМап = Неопределено, РезервМап = Неопределено, ИсправитьБагСклада = Ложь) Экспорт

	// ИсправитьБагСклада = Ложь (по умолчанию) - точное поведение оригинального ЗаполнитьРезерв,
	// включая известный баг (см. комментарий у РасспределитьРезервОпт): при резервировании
	// со "складов не из приоритетной схемы" ниже записывается склад из прошлого цикла (Склад),
	// а не реальный склад найденного остатка (Стр.Склад). Нужно для честного сравнения со старым
	// кодом через ТестСравнитьРезерв. Когда сравнение подтвердится на реальных данных - переключить
	// на Истина отдельным шагом и повторно сравнить (расхождения покажут реальное влияние бага).

	Характеристика = СтрНоменклатуры.ХарактеристикаНоменклатуры;
	ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
	Ростовка = ХарактеристикаОбъект.ПолучитьРостовку(Истина);

	ЭтоНабор = (СтрНоменклатуры.Номенклатура.ВидНоменклатуры.Код = "000000010");

	Склады = Новый Массив;
	Схема =  ?((ТипЦен.Код = "000000001" ИЛИ ТипЦен.Код = "000000011") И НЕ ЗначениеЗаполнено(СтрНоменклатуры.НК), Справочники.СхемыРезервирования.НайтиПоКоду("Кр0000021"), СхемаРезервирования);

	Если ХарактеристикаОбъект.ЭтоХарактеристикаНК() И ЗначениеЗаполнено(СтрНоменклатуры.НК) И Ростовка.ИгнорироватьНоль Тогда

		Для Каждого Стр из Схема.Склады Цикл
			Если Не Стр.Склад.Розница Тогда
				 Склады.Добавить(Стр.Склад);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Склады = Схема.Склады.ВыгрузитьКолонку("Склад");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВложенныйЗапрос.Склад КАК Склад,
	               |	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	               |	СУММА(ВложенныйЗапрос.КоличествоОстаток) КАК Количество
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад,
	               |		ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
	               |		-ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	               |	ИЗ
	               |		РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	               |				,
	               |				НЕ Склад В (&Склады)
	               |					И НЕ ДокументРезерва В (&ДокументРезерва)
	               |					И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ТоварыВРезервеНаСкладахОстатки
	               |
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |
	               |	ВЫБРАТЬ
	               |		ТоварыНаСкладахОстатки.Склад,
	               |		ТоварыНаСкладахОстатки.Номенклатура,
	               |		ТоварыНаСкладахОстатки.КоличествоОстаток
	               |	ИЗ
	               |		РегистрНакопления.ТоварыНаСкладах.Остатки(
	               |				,
	               |				НЕ Склад В (&Склады)
	               |					И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ТоварыНаСкладахОстатки) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.Номенклатура,
	               |	ВложенныйЗапрос.Склад
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Количество УБЫВ";
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",Характеристика);
	Запрос.УстановитьПараметр("Склады",Склады);
	Запрос.УстановитьПараметр("ДокументРезерва",МасИсклЗак);

	РезОстатков = Запрос.Выполнить().Выгрузить();
	Зарезервировано = 0;
	Если ЗначениеЗаполнено(СхемаРезервирования) И СхемаРезервирования.Склады.Количество()>0 ТОгда

		ДЛя Каждого склад Из Склады Цикл
			Если Зарезервировано>=СтрНоменклатуры.Количество Тогда Продолжить; КонецЕсли;

			Если ЭтоНабор ИЛИ ОстаткиМап = Неопределено ИЛИ РезервМап = Неопределено Тогда
				МасСкл = Новый Массив;
				МасСкл.Добавить(Склад);
				Ост = ОбщегоНазначения.ОстатокНоменклатуры(СтрНоменклатуры.Номенклатура,МасСкл,СтрНоменклатуры.ХарактеристикаНоменклатуры,ТекущаяДата());
				Рез = ОбщегоНазначения.РезервНоменклатуры(СтрНоменклатуры.Номенклатура,МасСкл,СтрНоменклатуры.ХарактеристикаНоменклатуры,ТекущаяДата(),Ссылка,МасИсклЗак);
			Иначе
				Ключ = КлючКэшаОстатков(СтрНоменклатуры.Номенклатура, СтрНоменклатуры.ХарактеристикаНоменклатуры, Склад);
				Ост = ОстаткиМап.Получить(Ключ);
				Если Ост = Неопределено Тогда Ост = 0; КонецЕсли;
				Рез = РезервМап.Получить(Ключ);
				Если Рез = Неопределено Тогда Рез = 0; КонецЕсли;
			КонецЕсли;

			Наличие = Ост-Рез;
			Если Наличие>0 Тогда
				Если Наличие<СтрНоменклатуры.Количество-Зарезервировано  Тогда
					НС = Резерв.Добавить();
					ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
					НС.Склад = Склад;
					НС.Количество = Наличие;
					Зарезервировано = Зарезервировано+НС.Количество;
				Иначе
					НС = Резерв.Добавить();
					ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
					НС.Склад = Склад;
					НС.Количество = СтрНоменклатуры.Количество-Зарезервировано;
					Зарезервировано = Зарезервировано+НС.Количество;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
			Если Зарезервировано<СтрНоменклатуры.Количество  Тогда  //если и на других нету, тогда доберем в минус из приора
				Попытка
					НС = Резерв.Добавить();
					ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
					НС.Склад = Склады[Склады.Количество()-1];
					НС.Количество = СтрНоменклатуры.Количество-Зарезервировано;
					Зарезервировано = Зарезервировано+НС.Количество;
				Исключение
				КонецПопытки;
			КонецЕсли;
	КонецЕсли;

	//если не хватило на приоритетных или схема не выбрана
	Если Зарезервировано<СтрНоменклатуры.Количество Тогда
		ДЛя Каждого Стр Из РезОстатков Цикл
			Если Зарезервировано>=СтрНоменклатуры.Количество Тогда Продолжить; КонецЕсли;
			Если Стр.Количество>0 Тогда
				Если Стр.Количество<СтрНоменклатуры.Количество-Зарезервировано  Тогда
					НС = Резерв.Добавить();
					ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
					НС.Склад = ?(ИсправитьБагСклада, Стр.Склад, Склад);
					НС.Количество = Стр.Количество;
					Зарезервировано = Зарезервировано+НС.Количество;
				Иначе
					НС = Резерв.Добавить();
					ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
					НС.Склад = ?(ИсправитьБагСклада, Стр.Склад, Склад);
					НС.Количество = СтрНоменклатуры.Количество-Зарезервировано;
					Зарезервировано = Зарезервировано+НС.Количество;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Зарезервировано<СтрНоменклатуры.Количество И РезОстатков.Количество()>0 Тогда  //если и на других нету, тогда доберем в минус
			НС = Резерв.Добавить();
			ЗаполнитьЗначенияСвойств(НС,СтрНоменклатуры);
			НС.Склад = РезОстатков[0];
			НС.Количество = СтрНоменклатуры.Количество-Зарезервировано;
			Зарезервировано = Зарезервировано+НС.Количество;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ОпределитьСкидку(Стр)Экспорт
	Если НЕ ЗначениеЗаполнено(Контрагент) ИЛИ НЕ ЗначениеЗаполнено(Стр.Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	НайденаСкидкаПоНоменклатуре = Контрагент.Скидки.Найти(Стр.Номенклатура,"Номенклатура");	
	Если НЕ НайденаСкидкаПоНоменклатуре = Неопределено Тогда
		Если ЗначениеЗаполнено(НайденаСкидкаПоНоменклатуре.СкидкаПроцент) Тогда
			//Стр.Цена = Стр.Цена*(1-НайденаСкидкаПоНоменклатуре.СкидкаПроцент/100);
			Стр.ПроцентСкидкиНаценки = НайденаСкидкаПоНоменклатуре.СкидкаПроцент;
		Иначе
			//Стр.Цена = Стр.Цена-НайденаСкидкаПоНоменклатуре.СкидкаСумма;
			Попытка
				Стр.ПроцентСкидкиНаценки = 100-(Стр.Цена-НайденаСкидкаПоНоменклатуре.СкидкаСумма)/Стр.Цена*100;
			Исключение
				Стр.ПроцентСкидкиНаценки = 0;
			КонецПопытки;
		КонецЕсли;
	Иначе
		Если  Контрагент.ОбщаяСкидка>0 Тогда
			//Стр.Цена = Стр.Цена*(1-Контрагент.ОбщаяСкидка/100);
			Стр.ПроцентСкидкиНаценки = Контрагент.ОбщаяСкидка;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция УбратьНоликиСлева(СтрокаСНоликами) Экспорт 
	Ф=0;  НоваяСтрока = "";
	Для Сч = 1 По СтрДлина(СтрокаСНоликами) Цикл 
		Символ = Сред(СтрокаСНоликами,Сч,1);
		Если  НЕ Символ = "0" и Ф=0 Тогда
			//первый ненулевой символ
			Ф=1
		КонецЕсли;
		Если Ф=1 Тогда
			//дальше берем все и нолики тоже
			НоваяСтрока = НоваяСтрока+Символ
		КонецЕсли;
	КонецЦикла;
	Возврат НоваяСтрока
КонецФункции

Функция ПечатьДокумента(ЗаполнятьГиперссылки = Ложь) Экспорт
	
	Если ЗаполнятьГиперссылки Тогда
		
		СтруктураПараметров = Новый Структура("ТабДок, НомерКолонки, Гиперссылки");
		
		Гиперссылки = Новый Соответствие;
		
	КонецЕсли;
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаказПокупателя_" + СокрЛП(ИмяКомпьютера());
	
	Макет = ПолучитьМакет("НакладнаяНов");
	
	// печать производится на языке, указанном в настройках пользователя
	КодЯзыкаПечать = Локализация.ПолучитьЯзыкФормированияПечатныхФорм(УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "РежимФормированияПечатныхФорм"));
	Макет.КодЯзыкаМакета = КодЯзыкаПечать;

	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.Заголовок = "Замовлення №"+УбратьНоликиСлева(Номер)+" від "+Формат(Дата,"ДЛФ=DD;Л=uk");
	Попытка
		Тел = СокрЛП(ТелефонКонтрагента);
		Расч= СокрЛП(ВидОплатыЗаказа); //ВидРасчетов
		Дост = СокрЛП(СпособОтправки)+", "+СокрЛП(АдресДоставкиНП);
	Исключение
		Тел = "";
		Расч= "";
		Дост = "";
	КонецПопытки;

	Если Не ЗначениеЗаполнено(Тел) Тогда
		Тел = КонтактнаяИнформация(Контрагент,Перечисления.ТипыКонтактнойИнформации.Телефон,Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента); 
	КонецЕсли;
	ОбластьМакета.Параметры.Покупатель = СокрЛП(Контрагент)+", "+Тел;
	ОбластьМакета.Параметры.Договор = СокрЛП(ДоговорКонтрагента);
	
	//Если НЕ ЗначениеЗаполнено(Расч) И СокрЛП(ВидРасчетов)="Готівка" Тогда
	//	Расч = СокрЛП(ВидРасчетов);
	//КонецЕсли;
	Если Расч= "Оплачен" Тогда
		Расч = "Наличный";
	//Иначе
	//	Расч = "Безналичный";
	КонецЕсли;

	ОбластьМакета.Параметры.ВидОплаты = Расч;
	Если НЕ ЗначениеЗаполнено(СтрЗаменить(Дост,",","")) Тогда
		Дост = Комментарий;
	КонецЕсли;
	
	//ОбластьМакета.Параметры.Доставка = Дост;
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	//========================================================================
	ОбластьМакета = Макет.ПолучитьОбласть("ИнформацияПоПокупателю");
	
	Баланс = Документы.ЗаказПокупателя.ДолгКонтрагентаНаДату(Контрагент,ТекущаяДата());
	
	СуммаРезервов = Строка(Документы.ЗаказПокупателя.ПолучитьСуммуРезервовПоКонтрагенту(Контрагент));
	ТекДата = Строка(Формат(ТекущаяДата(),"ДЛФ=DD;Л=uk"));
	
	ОбластьМакета.Параметры.СуммаРезерва = СуммаРезервов + " Грн";
	ОбластьМакета.Параметры.Баланс = ?(Баланс<=0,"Аванс клиента","Долг клиента");
	ОбластьМакета.Параметры.ТкущаяДата = ТекДата;
	ОбластьМакета.Параметры.БалансКлиента = Строка(Баланс) + " Грн";
	
	ТабДокумент.Вывести(ОбластьМакета);
	//========================================================================

	
	//ЕстьСкидка = ЕстьСкидка();
	
	СкидкаИтог = 0;
	
	//товары
	Если Товары.Количество() > 0 Тогда
		
		ТипКомплект     = Перечисления.ТипыНоменклатуры.Комплект;
		ТипЦенМелкийОпт = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000014");
		
		ТЗТовары = Товары.ВыгрузитьКолонки();
		
		ЕстьСкидка = Ложь;
		
		Для Каждого СтрокаТЧ Из Товары Цикл
			
			Если СтрокаТЧ.Номенклатура.ВидНоменклатуры.Код = "000000009" Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТЗТовары.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			
			Если СтрокаТЧ.ПроцентСкидкиНаценки > 0 Или
				 СтрокаТЧ.ПроцентАвтоматическихСкидок > 0 Тогда
				ЕстьСкидка = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТЗТовары.Количество() > 0 Тогда
			
			Если ЕстьСкидка Тогда
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТабСкидка");
			Иначе
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаб");
			КонецЕсли;
			
			ОбластьМакета.Параметры.ТабЧасть = "По еденично";
			
			ТабДокумент.Вывести(ОбластьМакета);
			
			Если ЕстьСкидка Тогда
				ИмяМакета = "СтрокаСкидка";
			Иначе
				ИмяМакета = "Строка";
			КонецЕсли;
			
			Ном = 1;
			
			Для Каждого СтрокаТЗ Из ТЗТовары Цикл
				
				ОбластьМакета = Макет.ПолучитьОбласть(ИмяМакета);
				
				//ОбластьМакета.Параметры.Заполнить(СтрокаТЗ);
				ПозицияЗапятой = СтрНайти(СтрокаТЗ.ХарактеристикаНоменклатуры, ",");
				Цвет = Лев(СтрокаТЗ.ХарактеристикаНоменклатуры, ПозицияЗапятой - 1);
				Размеры = Прав(СтрокаТЗ.ХарактеристикаНоменклатуры, СтрДлина(СтрокаТЗ.ХарактеристикаНоменклатуры) -  ПозицияЗапятой);
				
				ОбластьМакета.Параметры.Ном = Ном;
				ОбластьМакета.Параметры.Номенклатура = СтрокаТЗ.Номенклатура;
				ОбластьМакета.Параметры.Цвет = Цвет;
				ОбластьМакета.Параметры.Размеры = Размеры;
				ОбластьМакета.Параметры.Количество = СтрокаТЗ.Количество;
				
				Если ТипЦен.Код = "000000001" И
					 СтрокаТЗ.Номенклатура.ВидНоменклатуры.ТипНоменклатуры <> ТипКомплект Тогда
					
					ЦенаТовара = Ценообразование.ПолучитьЦенуНоменклатуры(
																		  СтрокаТЗ.Номенклатура,
																		  СтрокаТЗ.ХарактеристикаНоменклатуры,
																		  ТипЦенМелкийОпт,
																		  Дата,
																		  СтрокаТЗ.ЕдиницаИзмерения,
																		  ВалютаДокумента,
																		  КурсВзаиморасчетов,
																		  КратностьВзаиморасчетов,
																		  ,
																		  ДоговорКонтрагента);
					
					СуммаТовара = СтрокаТЗ.Количество * ЦенаТовара;
					
				Иначе
					
					ЦенаТовара = СтрокаТЗ.Цена;
					
				КонецЕсли;
				
				ОбластьМакета.Параметры.Цена  = Формат(ЦенаТовара, "ЧДЦ=0");
				ОбластьМакета.Параметры.Сумма = Формат(СтрокаТЗ.Сумма, "ЧДЦ=0");
				
				Если ЕстьСкидка Тогда
					
					Если ТипЦен.Код = "000000001" И
						 СтрокаТЗ.Номенклатура.ВидНоменклатуры.ТипНоменклатуры <> ТипКомплект Тогда
						
						ПроцентСкидки = СтрокаТЗ.ПроцентАвтоматическихСкидок + СтрокаТЗ.ПроцентСкидкиНаценки;
						СкидкаНаЕд    = ЦенаТовара  * ПроцентСкидки / 100;
						Скидка        = СуммаТовара * ПроцентСкидки / 100;
						
					Иначе
						
						СкидкаНаЕд    = ?(СтрокаТЗ.Количество = 0, 0, СтрокаТЗ.Цена - СтрокаТЗ.Сумма / СтрокаТЗ.Количество);
						Скидка        = СтрокаТЗ.Цена * СтрокаТЗ.Количество - СтрокаТЗ.Сумма;
						//ПроцентСкидки = ?(СтрокаТЗ.Цена * СтрокаТЗ.Количество = 0, 0, (1 - СтрокаТЗ.Сумма / (СтрокаТЗ.Цена * СтрокаТЗ.Количество)) * 100);
						ПроцентСкидки = СтрокаТЗ.ПроцентАвтоматическихСкидок + СтрокаТЗ.ПроцентСкидкиНаценки;
						
					КонецЕсли;
					
					ОбластьМакета.Параметры.Скидка        = ?(ПроцентСкидки = 0, "", ?(ПроцентСкидки > 0, "-", "+") + ПроцентСкидки + "% (" + Формат(СкидкаНаЕд, "ЧДЦ=2") + ")");
					ОбластьМакета.Параметры.ЦенаСоСкидкой = ЦенаТовара - СкидкаНаЕд;
					
					СкидкаИтог = СкидкаИтог + Скидка;
					
				КонецЕсли;
				
				Ном = Ном + 1;
				
				Если Ном / 2 - Цел(Ном / 2) = 0 Тогда
					ОбластьМакета.Области["Область" + ИмяМакета].ЦветФона = WebЦвета.Белый;
				Иначе
					ОбластьМакета.Области["Область" + ИмяМакета].ЦветФона = WebЦвета.СветлоСерый;
				КонецЕсли;
				
				ТабДокумент.Вывести(ОбластьМакета);
				
				Если ЗаполнятьГиперссылки Тогда
					
					Гиперссылки.Вставить(ТабДокумент.ВысотаТаблицы, ОбщегоНазначения.СсылкаНаКартинку(СтрокаТЗ.ХарактеристикаНоменклатуры));
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ТЗКомплекты = Товары.ВыгрузитьКолонки();
		
		ЕстьСкидка = Ложь;
		
		Для Каждого СтрокаТЧ Из Товары Цикл
			
			Если СтрокаТЧ.Номенклатура.ВидНоменклатуры.Код <> "000000009" Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТЗКомплекты.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			
			Если СтрокаТЧ.ПроцентСкидкиНаценки > 0 Или
				 СтрокаТЧ.ПроцентАвтоматическихСкидок > 0 Тогда
				ЕстьСкидка = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ТЗКомплекты.Количество() > 0 Тогда
			
			Если ЕстьСкидка ТОгда
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТабСкидка");
			Иначе
				ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаб");
			КонецЕсли;
			
			ОбластьМакета.Параметры.ТабЧасть = "Ростовки";
			
			ТабДокумент.Вывести(ОбластьМакета);
			
			Если ЕстьСкидка ТОгда
				ИмяМакета = "СтрокаСкидкаНК";
			Иначе
				ИмяМакета = "СтрокаНК";
			КонецЕсли;
			
			Ном = 1;
			ТЗКомплекты.Сортировать("Номенклатура,ХарактеристикаНоменклатуры Возр");
			
			Для Каждого СтрокаТЗ Из ТЗКомплекты Цикл
				
				ОбластьМакета = Макет.ПолучитьОбласть(ИмяМакета);
				
				ПозицияЗапятой = СтрНайти(СтрокаТЗ.ХарактеристикаНоменклатуры, ",");
				Цвет = Лев(СтрокаТЗ.ХарактеристикаНоменклатуры, ПозицияЗапятой - 1);
				Размеры = Прав(СтрокаТЗ.ХарактеристикаНоменклатуры, СтрДлина(СтрокаТЗ.ХарактеристикаНоменклатуры) -  ПозицияЗапятой);
				
				//ОбластьМакета.Параметры.Заполнить(СтрокаТЗ);
				ОбластьМакета.Параметры.Номенклатура = СтрокаТЗ.Номенклатура;
				ОбластьМакета.Параметры.Цвет = Цвет;
				ОбластьМакета.Параметры.Ном = Ном;
				
				ОбластьМакета.Параметры.Количество = СтрокаТЗ.Количество;
				ОбластьМакета.Параметры.КоличествоНК = СтрокаТЗ.КоличествоНК;				
				ОбластьМакета.Параметры.Размеры   = Размеры;
				ОбластьМакета.Параметры.Цена  = Формат(СтрокаТЗ.Цена, "ЧДЦ=0");
				ОбластьМакета.Параметры.Сумма = Формат(СтрокаТЗ.Сумма, "ЧДЦ=0");
				
				Если ЕстьСкидка Тогда
					
					СкидкаНаЕд    = ?(СтрокаТЗ.КоличествоНК = 0, 0, СтрокаТЗ.Цена - СтрокаТЗ.Сумма / СтрокаТЗ.КоличествоНК);
					Скидка        = СтрокаТЗ.Цена * СтрокаТЗ.КоличествоНК - СтрокаТЗ.Сумма;
					//ПроцентСкидки = ?(СтрокаТЗ.Цена * СтрокаТЗ.КоличествоНК = 0, 0, (1 - СтрокаТЗ.Сумма / (СтрокаТЗ.Цена * СтрокаТЗ.КоличествоНК)) * 100);
					ПроцентСкидки = СтрокаТЗ.ПроцентАвтоматическихСкидок + СтрокаТЗ.ПроцентСкидкиНаценки;
					
					ОбластьМакета.Параметры.Скидка        = ?(ПроцентСкидки = 0, "", ?(ПроцентСкидки > 0, "-", "+") + ПроцентСкидки + "% (" + Формат(СкидкаНаЕд, "ЧДЦ=2") + ")");
					ОбластьМакета.Параметры.ЦенаСоСкидкой = СтрокаТЗ.Цена - СкидкаНаЕд;
					
					СкидкаИтог = СкидкаИтог + Скидка;
					
				КонецЕсли;
				
				Ном = Ном + 1;
				
				Если Ном / 2 - Цел(Ном / 2) = 0 Тогда
					ОбластьМакета.Области["Область" + ИмяМакета].ЦветФона = WebЦвета.Белый;
				Иначе
					ОбластьМакета.Области["Область" + ИмяМакета].ЦветФона = WebЦвета.СветлоСерый;
				КонецЕсли;
				
				ТабДокумент.Вывести(ОбластьМакета);
				
				Если ЗаполнятьГиперссылки Тогда
					ХарактеристикаОбъект = СтрокаТЗ.ХарактеристикаНоменклатуры.ПолучитьОбъект();
					ТЗКомплектующие = ХарактеристикаОбъект.Комплектующие_НК();
					
					Если ТЗКомплектующие.Количество() > 0 Тогда
						
						Гиперссылки.Вставить(ТабДокумент.ВысотаТаблицы, ОбщегоНазначения.СсылкаНаКартинку(ТЗКомплектующие[0].ХарактеристикаКомплектующей));
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
			
	КонецЕсли;
	
	//услуги
	Ном=1;
	Если Услуги.Количество()>0 Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТабУслуги");
		ТабДокумент.Вывести(ОбластьМакета);
		ОбластьМакета = Макет.ПолучитьОбласть("СтрокаУслуги");
		Для каждого Стр из Услуги Цикл 
			ОбластьМакета.Параметры.Заполнить(Стр);
			ОбластьМакета.Параметры.Ном = Ном;
			Ном = Ном+1;
			ТабДокумент.Вывести(ОбластьМакета);
		КонецЦикла;
	КонецЕсли;

	Если СкидкаИтог > 0 Тогда
		
		ОбластьМакета = Макет.ПолучитьОбласть("ИтогСкидка");
		
		ОбластьМакета.Параметры.Скидка = СкидкаИтог;
		
		ТабДокумент.Вывести(ОбластьМакета);
		
	КонецЕсли;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Итог");
	
	ОбластьМакета.Параметры.КолТоваров = Строка(Товары.Итог("КоличествоНК")) + " шт.";
	ОбластьМакета.Параметры.Итого      = Формат(Товары.Итог("Сумма") + Услуги.Итог("Сумма"), "ЧДЦ=0") + " Грн" ;
	
	ТабДокумент.Вывести(ОбластьМакета);
	ТабДокумент.АвтоМасштаб = Истина;
	
	//Дно
	ОбластьМакета = Макет.ПолучитьОбласть("Дно");
	ТабДокумент.Вывести(ОбластьМакета);	
	
	Если ЗаполнятьГиперссылки Тогда
		
		СтруктураПараметров.ТабДок       = ТабДокумент;
		СтруктураПараметров.НомерКолонки = 8;
		СтруктураПараметров.Гиперссылки  = Гиперссылки;
		
		Возврат СтруктураПараметров;
		
	Иначе
		
		Возврат ТабДокумент;
		
	КонецЕсли;
	
КонецФункции // ПечатьДокумента()

Функция ЕстьСкидка()
	Есть = ЛОжь;
	Для Каждого Стр Из Товары Цикл
		Если НЕ Стр.Сумма=Стр.Цена*Стр.Количество Тогда
			Есть = Истина;
		КонецЕсли;
	КонецЦикла;
	//Для Каждого Стр Из Товары1 Цикл
	//	Если Стр.ПроцентСкидкиНаценки>0 Тогда
	//		Есть = Истина;
	//	КонецЕсли;
	//КонецЦикла;
	Возврат Есть;
КонецФункции

Функция ЕстьЗакрытие() Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗакрытиеЗаказовПокупателейЗаказы.Ссылка
	               |ИЗ
	               |	Документ.ЗакрытиеЗаказовПокупателей.Заказы КАК ЗакрытиеЗаказовПокупателейЗаказы
	               |ГДЕ
	               |	ЗакрытиеЗаказовПокупателейЗаказы.ЗаказПокупателя = &ЗаказПокупателя";
					   
	Запрос.УстановитьПараметр("ЗаказПокупателя",Ссылка);
	Рез = Запрос.Выполнить().Выгрузить();
	Если Рез.Количество()>0 Тогда
		Возврат Рез[0].Ссылка
	Иначе
		Возврат Документы.ЗакрытиеЗаказовПокупателей.ПустаяСсылка();
	КонецЕсли;
		
КонецФункции

функция ЭтоПодЗаказ() Экспорт 
	
	Если ЗначениеЗаполнено(ОсновнойЗаказ) И ТипЗнч(ОсновнойЗаказ) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат (СтрНайти(Номер,"/") > 0);	
	КонецЕсли;
	Возврат Ложь;
		
КонецФункции

функция ЭтоАктивныйЗаказ() Экспорт 
	Возврат ЗначениеЗаполнено(СтатусЗаказа) И (СтатусЗаказа.Код = "000000005" ИЛИ СтатусЗаказа.Код = "000000002" ИЛИ СтатусЗаказа.Код = "000000011" ИЛИ СтатусЗаказа.Код = "000000001" Или СтатусЗаказа.Код = "000000012");
КонецФункции 

Функция ЕстьПДС() Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПланируемоеПоступлениеДенежныхСредствРасшифровкаПлатежа.Ссылка
	               |ИЗ
	               |	Документ.ПланируемоеПоступлениеДенежныхСредств.РасшифровкаПлатежа КАК ПланируемоеПоступлениеДенежныхСредствРасшифровкаПлатежа
	               |ГДЕ
	               |	ПланируемоеПоступлениеДенежныхСредствРасшифровкаПлатежа.Сделка = &Сделка";
					   
	Запрос.УстановитьПараметр("Сделка",Ссылка);
	Рез = Запрос.Выполнить().Выгрузить();
	Если Рез.Количество()>0 Тогда
		Возврат Рез[0].Ссылка;
	Иначе
		Возврат Документы.ПланируемоеПоступлениеДенежныхСредств.ПустаяСсылка();
	КонецЕсли;
		
КонецФункции

Процедура ЗакрытиеЗаказа() Экспорт 
	ЗакрытиеЗ = ЕстьЗакрытие();
	Если НЕ ЗначениеЗаполнено(ЗакрытиеЗ) Тогда
		Если СтатусЗаказа.ЗакрыватьРезерв Тогда
			Закрытие = Документы.ЗакрытиеЗаказовПокупателей.СоздатьДокумент();
			Закрытие.Дата = ТекущаяДата();
			Закрытие.ВидОперации = Перечисления.ВидыОперацийЗакрытиеЗаказовПокупателей.ЗакрытиеЗаказов;
			НС = Закрытие.Заказы.Добавить();
			НС.ЗаказПокупателя = Ссылка;
			НС.ПричинаЗакрытияЗаказа = СокрЛП(СтатусЗаказа);
			Закрытие.Записать(РежимЗаписиДокумента.Проведение);
		КонецЕсли;
	Иначе
		Если СтатусЗаказа.ЗакрыватьРезерв Тогда
			Если НЕ ЗакрытиеЗ.Проведен Тогда
				Об = ЗакрытиеЗ.ПолучитьОбъект();
				Об.ПометкаУдаления = Ложь;
				Об.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
		Иначе
			 Если ЗакрытиеЗ.Проведен Тогда
				Об = ЗакрытиеЗ.ПолучитьОбъект();
				Об.ПометкаУдаления = Истина;
				Об.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;

		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПДС() Экспорт 
	ПДСЗ = ЕстьПДС();
	
	Если НЕ ЗначениеЗаполнено(ПДСЗ) И НЕ СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоКоду("000000007") Тогда
		Если  ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоРеквизиту("ГУИД","Money")  Тогда
			ПДС = Документы.ПланируемоеПоступлениеДенежныхСредств.СоздатьДокумент();
			ПДС.Заполнить(Ссылка);
			ПДС.Дата = ТекущаяДата();
			ПДС.Состояние = Перечисления.СостоянияОбъектов.Подготовлен;
			ПДС.СуммаДокумента = СуммаДокумента;
			ПДС.ФормаОплаты = Перечисления.ВидыДенежныхСредств.Наличные;
			ПДС.ДокументОснование = Ссылка;
			Попытка
				ПДС.РасшифровкаПлатежа[0].СуммаВзаиморасчетов  = СуммаДокумента;
				ПДС.РасшифровкаПлатежа[0].СуммаПлатежа = СуммаДокумента;
				ПДС.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
			КонецПопытки;
		КонецЕсли;
	Иначе
		Если НЕ СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоКоду("000000007")  Тогда   //неудачный
			Если   НЕ ПДСЗ.Проведен Тогда
				Об = ПДСЗ.ПолучитьОбъект();
				Об.Состояние = Перечисления.СостоянияОбъектов.Подготовлен;
				Об.ПометкаУдаления = Ложь;
				Об.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
		Иначе
			 Если  ПДСЗ.Проведен Тогда
				Об = ПДСЗ.ПолучитьОбъект();
				Об.Состояние = Перечисления.СостоянияОбъектов.Отклонен;
				Об.ПометкаУдаления = Истина;
				Об.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


Функция ЦенаНоменклатуры(Номенклатура,ТипыЦенНоменклатуры,Дата) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЦеныНоменклатурыСрезПоследних.Цена
	               |ИЗ
	               |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |			&НаДату,
	               |			Номенклатура = &Номенклатура
	               |				И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних";
				   
	Запрос.УстановитьПараметр("НаДату",Дата);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);	
	Запрос.УстановитьПараметр("ТипЦен",ТипыЦенНоменклатуры);
	
	Рез = запрос.Выполнить().Выгрузить();
	
	Если Рез.Количество()=0 Тогда
		Возврат 0;
	Иначе
		Возврат Рез[0].Цена;
	КонецЕсли;
КонецФункции

// Функция помещает в структуру все данные, отображаемые при печати документа.
// Вызывается из функции ПечатьСчетаЗаказа и из веб-приложения
//
// Параметры:
//  Тип - строка, содержит тип печатаемого документа (счет или заказ)
//
// Возвращаемое значение:
//  Структура
//
Функция ПолучитьПараметрыПечатиСчетаЗаказа(Тип) Экспорт	
	
	ПараметрыПечати = Новый Структура;
	ПозицииТовары = Новый Массив;
	ПозицииТара = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ЭтотОбъект.Ссылка);
	Запрос.Текст ="
	|ВЫБРАТЬ
	|	Номер,
	|	Дата,
	|	ДоговорКонтрагента,
	|	Организация,
	|	Контрагент КАК Получатель,
	|	Организация КАК Руководители,
	|	Организация КАК Поставщик,
	|	СуммаДокумента,
	|	ВалютаДокумента,
	|	УчитыватьНДС,
	|	СуммаВключаетНДС
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|
	|ГДЕ
	|	ЗаказПокупателя.Ссылка = &ТекущийДокумент";

	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();

	СтрокаВыборкиПоляСодержания = ОбработкаТабличныхЧастей.ПолучитьЧастьЗапросаДляВыбораСодержания("ЗаказПокупателя");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТекущийДокумент", ЭтотОбъект.Ссылка);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.Номенклатура                    КАК Номенклатура,
	|	ВЫРАЗИТЬ (ВложенныйЗапрос.Номенклатура.НаименованиеПолное КАК Строка(1000)) КАК НаименованиеПолное,
	|	ВложенныйЗапрос.Номенклатура.Код                КАК Код,
	|	ВложенныйЗапрос.Номенклатура.Артикул            КАК Артикул,
	|	ВложенныйЗапрос.Количество                      КАК Количество,
	|	ВложенныйЗапрос.ЕдиницаИзмерения.Представление  КАК ЕдиницаИзмерения,
	|	ВложенныйЗапрос.ПроцентСкидкиНаценки 
	|	+ ВложенныйЗапрос.ПроцентАвтоматическихСкидок   КАК Скидка,
	|	ВложенныйЗапрос.Цена                            КАК Цена,
	|	ВложенныйЗапрос.Сумма                           КАК Сумма,
	|	ВложенныйЗапрос.СуммаНДС                        КАК СуммаНДС,
	|	ВложенныйЗапрос.Характеристика КАК Характеристика,
	|	NULL                                            Как Серия,
	|	ВложенныйЗапрос.НомерСтроки                     КАК НомерСтроки,
	|	Метка
	|ИЗ
	|(
	|	ВЫБРАТЬ
	|		ЗаказПокупателя.Номенклатура,
	|		ЗаказПокупателя.ЕдиницаИзмерения,
	|		ЗаказПокупателя.ПроцентСкидкиНаценки        КАК ПроцентСкидкиНаценки,
	|		ЗаказПокупателя.ПроцентАвтоматическихСкидок КАК ПроцентАвтоматическихСкидок,
	|		ЗаказПокупателя.Цена                        КАК Цена,
	|		СУММА(ЗаказПокупателя.Количество)           КАК Количество,
	|		СУММА(ЗаказПокупателя.Сумма     )           КАК Сумма,
	|		СУММА(ЗаказПокупателя.СуммаНДС  )           КАК СуммаНДС,
	|		ЗаказПокупателя.ХарактеристикаНоменклатуры  КАК Характеристика,
	|		МИНИМУМ(ЗаказПокупателя.НомерСтроки)        КАК НомерСтроки,
	|		0                                           КАК Метка
	|	ИЗ
	|		Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателя
	|	ГДЕ
	|		ЗаказПокупателя.Ссылка = &ТекущийДокумент
	|	СГРУППИРОВАТЬ ПО
	|		ЗаказПокупателя.Номенклатура,
	|		ЗаказПокупателя.ЕдиницаИзмерения,
	|		ЗаказПокупателя.ПроцентСкидкиНаценки,
	|		ЗаказПокупателя.ПроцентАвтоматическихСкидок,
	|		ЗаказПокупателя.Цена,
	|		ЗаказПокупателя.ХарактеристикаНоменклатуры
	|) КАК ВложенныйЗапрос
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Номенклатура,
	|	" + СтрокаВыборкиПоляСодержания + "                   КАК Товар,
	|	ЗаказПокупателя.Номенклатура.Код                      КАК Код,
	|	ЗаказПокупателя.Номенклатура.Артикул                  КАК Артикул,
	|	ЗаказПокупателя.Количество                            КАК Количество,
	|	ЗаказПокупателя.Номенклатура.ЕдиницаХраненияОстатков.Представление  КАК ЕдиницаИзмерения,
	|	ЗаказПокупателя.ПроцентСкидкиНаценки
	|	+ ЗаказПокупателя.ПроцентАвтоматическихСкидок         КАК Скидка,
	|	ЗаказПокупателя.Цена                                  КАК Цена,
	|	ЗаказПокупателя.Сумма                                 КАК Сумма,
	|	ЗаказПокупателя.СуммаНДС                              КАК СуммаНДС,
	|	NULL                                                  КАК Характеристика,
	|	NULL                                                  КАК Серия,
	|	ЗаказПокупателя.НомерСтроки                           КАК НомерСтроки,
	|	1                                                     КАК Метка
	|ИЗ
	|	Документ.ЗаказПокупателя.Услуги КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Ссылка = &ТекущийДокумент
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Номенклатура                КАК Номенклатура,
	|	ПРЕДСТАВЛЕНИЕ(ЗаказПокупателя.Номенклатура) КАК Товар,
	|	ЗаказПокупателя.Номенклатура.Код            КАК Код,
	|	ЗаказПокупателя.Номенклатура.Артикул        КАК Артикул,
	|	ЗаказПокупателя.Количество                  КАК Количество,
	|	ЗаказПокупателя.Номенклатура.ЕдиницаХраненияОстатков.Представление КАК ЕдиницаИзмерения,
	|	NULL                                        КАК Скидка,
	|	ЗаказПокупателя.Цена                        КАК Цена,
	|	ЗаказПокупателя.Сумма                       КАК Сумма,
	|	(0)                                         КАК СуммаНДС,
	|	NULL                                        КАК Характеристика,
	|	NULL                                        КАК Серия,
	|	ЗаказПокупателя.НомерСтроки                 КАК НомерСтроки,
	|	3                                           КАК Метка
	|ИЗ
	|(
	|	ВЫБРАТЬ
	|		ЗаказПокупателя.Номенклатура         КАК Номенклатура,
	|		СУММА(ЗаказПокупателя.Количество)    КАК Количество,
	|		ЗаказПокупателя.Цена                 КАК Цена,
	|		СУММА(ЗаказПокупателя.Сумма)         КАК Сумма,
	|		МИНИМУМ(ЗаказПокупателя.НомерСтроки) КАК НомерСтроки
	|	ИЗ
	|		Документ.ЗаказПокупателя.ВозвратнаяТара КАК ЗаказПокупателя
	|	ГДЕ
	|		ЗаказПокупателя.Ссылка = &ТекущийДокумент
	|	СГРУППИРОВАТЬ ПО
	|		ЗаказПокупателя.Номенклатура,
	|		ЗаказПокупателя.Цена
	|) КАК ЗаказПокупателя
	|УПОРЯДОЧИТЬ ПО Метка ВОЗР, НомерСтроки ВОЗР
	|";

	ЗапросТовары = Запрос.Выполнить().Выгрузить();

	// Выводим шапку накладной

	ПараметрыПечати.Вставить("УчитыватьНДС", Шапка.УчитыватьНДС);
	СведенияОПоставщике = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(Шапка.Поставщик, Шапка.Дата,,,"uk");
	Если  ТипЗнч(СтруктурнаяЕдиница) = Тип("СправочникСсылка.БанковскиеСчета")
		И ЗначениеЗаполнено(СтруктурнаяЕдиница) Тогда
		Банк		= СтруктурнаяЕдиница.Банк;
		МФО	 		= Банк.Код;
		НомерСчета 	= СтруктурнаяЕдиница.НомерСчета;
	Иначе
		// покажем банковские реквизиты основного счета организации
		Банк		= СведенияОПоставщике.Банк;
		МФО	 		= СведенияОПоставщике.МФО;
		НомерСчета 	= СведенияОПоставщике.НомерСчета;
	КонецЕсли;
	Если Тип = "Счет" Тогда
		ПараметрыПечати.Вставить("ИНН", СведенияОПоставщике.ИНН);
		ПредставлениеПоставщикаДляПлатПоручения = "";
		ПараметрыПечати.Вставить("КодПоЕДРПОУ", СведенияОПоставщике.КодПоЕДРПОУ);
		ПараметрыПечати.Вставить("БанкМФО", МФО);
		
			КоррСчет   = Банк.КоррСчет;
			ГородБанка = Банк.Город;

			ПараметрыПечати.Вставить("БанкПолучателя", Банк);
			ПараметрыПечати.Вставить("БанкПолучателяПредставление", СокрЛП(Банк) + " " + ГородБанка);
			ПараметрыПечати.Вставить("СчетБанкаПолучателя", КоррСчет);
			ПараметрыПечати.Вставить("СчетПолучателяПредставление", НомерСчета);
			ПараметрыПечати.Вставить("СчетПолучателя", НомерСчета);
		Если ПустаяСтрока(ПредставлениеПоставщикаДляПлатПоручения) Тогда
			ПредставлениеПоставщикаДляПлатПоручения = ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОПоставщике, "ПолноеНаименование,",,"uk");
		КонецЕсли;
		ПараметрыПечати.Вставить("ПредставлениеПоставщикаДляПлатПоручения", ПредставлениеПоставщикаДляПлатПоручения);
	КонецЕсли; 

	
	Если Тип = "Счет" Тогда
		ПараметрыПечати.Вставить("ТекстЗаголовка", ОбщегоНазначения.СформироватьЗаголовокДокумента(Шапка, "Рахунок на оплату", "uk"));
	Иначе
		ПараметрыПечати.Вставить("ТекстЗаголовка", ОбщегоНазначения.СформироватьЗаголовокДокумента(Шапка, "Замовлення покупця", "uk"));
	КонецЕсли;
	ПараметрыПечати.Вставить("ТекстПоставщик", "Постачальник:");
	ПараметрыПечати.Вставить("ПредставлениеПоставщика", ФормированиеПечатныхФорм.ОписаниеОрганизации(УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(Шапка.Организация, Шапка.Дата), "ПолноеНаименование,",,"uk"));
	ПараметрыПечати.Вставить("ПредставлениеРеквизитовПоставщика", "Р/р " + НомерСчета + ", Банк " + Банк + ", МФО " + МФО + Символы.ПС 
													 + ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОПоставщике, "ЮридическийАдрес,Телефоны,/,КодПоЕДРПОУ,ИНН,НомерСвидетельства,/,ПлательщикНалогаНаПрибыль,",,"uk"));
		
	СведенияОПолучателе = УправлениеКонтактнойИнформацией.СведенияОЮрФизЛице(Шапка.Получатель, Шапка.Дата,,,"uk");
	ПараметрыПечати.Вставить("ТекстПокупатель", "Покупець:");
	ПараметрыПечати.Вставить("ПредставлениеПолучателя", ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОПолучателе, "ПолноеНаименование,",,"uk"));
    ПараметрыПечати.Вставить("ПредставлениеРеквизитовПолучателя", ФормированиеПечатныхФорм.ОписаниеОрганизации(СведенияОПолучателе,"Телефоны,",,"uk"));
	
	ПараметрыПечати.Вставить("ЕстьСкидки", Ложь);
	Для каждого ВыборкаСтрокТовары Из ЗапросТовары Цикл 
		Если ЗначениеЗаполнено(ВыборкаСтрокТовары.Скидка) Тогда
			ПараметрыПечати.ЕстьСкидки = Истина;
			Прервать;
		КонецЕсли; 
	КонецЦикла;

	ДопКолонка = Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить();
	ПараметрыПечати.Вставить("ВыводитьКоды", Ложь);
	Если ДопКолонка = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул Тогда
		ПараметрыПечати.ВыводитьКоды = Истина;
		Колонка = "Артикул";
	ИначеЕсли ДопКолонка = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Код Тогда
		ПараметрыПечати.ВыводитьКоды = Истина;
		Колонка = "Код";
	КонецЕсли;
	
	Если ПараметрыПечати.ВыводитьКоды Тогда
		ПараметрыПечати.Вставить("ИмяКолонкиКодов", Колонка);
	КонецЕсли;

	Сумма    = 0;
	СуммаНДС = 0;
	СуммаТара = 0;
	ВсегоСкидок    = 0;
	ВсегоБезСкидок = 0;

	Для каждого ВыборкаСтрокТовары Из ЗапросТовары Цикл 
		
		ПараметрыПозиции = Новый Структура;

		ПараметрыПозиции.Вставить("Номенклатура", ВыборкаСтрокТовары.Номенклатура);
		ПараметрыПозиции.Вставить("НомерСтроки", ЗапросТовары.Индекс(ВыборкаСтрокТовары) + 1);

		Если ПараметрыПечати.ВыводитьКоды Тогда
			Если Колонка = "Артикул" Тогда
				ПараметрыПозиции.Вставить("КодАртикул", ВыборкаСтрокТовары.Артикул);
			Иначе
				ПараметрыПозиции.Вставить("КодАртикул", ВыборкаСтрокТовары.Код);
			КонецЕсли;
		КонецЕсли;

		ПараметрыПозиции.Вставить("Количество", ВыборкаСтрокТовары.Количество);
		ПараметрыПозиции.Вставить("ЕдиницаИзмерения", ВыборкаСтрокТовары.ЕдиницаИзмерения);
		ПараметрыПозиции.Вставить("Цена", ВыборкаСтрокТовары.Цена);
		ПараметрыПозиции.Вставить("Товар", СокрП(ВыборкаСтрокТовары.НаименованиеПолное) 
														+ ФормированиеПечатныхФорм.ПредставлениеСерий(ВыборкаСтрокТовары));

		Скидка = Ценообразование.ПолучитьСуммуСкидки(ВыборкаСтрокТовары.Сумма, ВыборкаСтрокТовары.Скидка);

		Если ПараметрыПечати.ЕстьСкидки Тогда
			ПараметрыПозиции.Вставить("Скидка", Скидка);
			ПараметрыПозиции.Вставить("СуммаБезСкидки", ВыборкаСтрокТовары.Сумма + Скидка);
		КонецЕсли;

		ПараметрыПозиции.Вставить("Сумма", ВыборкаСтрокТовары.Сумма); 
		
		
		#Если ВнешнееСоединение Тогда
		WEBПриложения.ПодготовитьСтруктуруДляВнешнегоСоединения(ПараметрыПозиции);
		#КонецЕсли
		
		Если ВыборкаСтрокТовары.Метка = 3 Тогда
			ПозицииТара.Добавить(ПараметрыПозиции);
			СуммаТара      = СуммаТара    + ВыборкаСтрокТовары.Сумма;
		Иначе
			Сумма          = Сумма       + ВыборкаСтрокТовары.Сумма;
			СуммаНДС       = СуммаНДС    + ВыборкаСтрокТовары.СуммаНДС;
			ВсегоСкидок    = ВсегоСкидок + Скидка;
			ВсегоБезСкидок = Сумма       + ВсегоСкидок;
			ПозицииТовары.Добавить(ПараметрыПозиции);
		КонецЕсли;

	КонецЦикла;
	
	ПараметрыПечати.Вставить("ПозицииТовары", ПозицииТовары);
	ПараметрыПечати.Вставить("ПозицииТара", ПозицииТара);
	
	ПараметрыПечати.Вставить("ЕстьТара", ?(ПозицииТара.Количество() = 0, ложь, истина));
	
	ПараметрыПечати.Вставить("ВсегоТара", ОбщегоНазначения.ФорматСумм(СуммаТара));

	// Вывести Итого
	Если ПараметрыПечати.ЕстьСкидки Тогда
		ПараметрыПечати.Вставить("ВсегоСкидок", ОбщегоНазначения.ФорматСумм(ВсегоСкидок));
		ПараметрыПечати.Вставить("ВсегоБезСкидок", ОбщегоНазначения.ФорматСумм(ВсегоБезСкидок));
	КонецЕсли;
	ПараметрыПечати.Вставить("Всего", ОбщегоНазначения.ФорматСумм(Сумма));

	// Вывести ИтогоНДС
	Если ПараметрыПечати.УчитыватьНДС Тогда
		ПараметрыПечати.Вставить("НДС", ?(Шапка.СуммаВключаетНДС, "У тому числі ПДВ:", "Сума ПДВ:"));
		ПараметрыПечати.Вставить("ВсегоНДС", ОбщегоНазначения.ФорматСумм(СуммаНДС));
	КонецЕсли;

	// Вывести Сумму прописью
	СуммаКПрописи = Сумма + ?(Шапка.СуммаВключаетНДС, 0, СуммаНДС);
	ПараметрыПечати.Вставить("ИтоговаяСтрока", "Всього найменувань " + ЗапросТовары.Количество()
	+ ", на суму " + ОбщегоНазначения.ФорматСумм(СуммаКПрописи, Шапка.ВалютаДокумента));
	ПараметрыПечати.Вставить("СуммаПрописью", ОбщегоНазначения.СформироватьСуммуПрописью(СуммаКПрописи, Шапка.ВалютаДокумента, "uk"));
	ПараметрыПечати.Вставить("СуммаПрописьюНДС", ?(НЕ Шапка.УчитыватьНДС, "", НСтр("ru='В т.ч. НДС: ';uk='У т.ч. ПДВ: '", "uk") + ОбщегоНазначения.СформироватьСуммуПрописью(СуммаНДС, Шапка.ВалютаДокумента, "uk")));

	// Вывести подписи
	Если Тип = "Счет" Тогда


	КонецЕсли; 
	
	#Если ВнешнееСоединение Тогда
	WEBПриложения.ПодготовитьСтруктуруДляВнешнегоСоединения(ПараметрыПечати);
	#КонецЕсли

	Возврат ПараметрыПечати;

КонецФункции // ПолучитьПараметрыПечатиСчетаЗаказа()  

#Если Клиент Тогда

	
// Функция формирует табличный документ с печатной формой заказа или счета,
// разработанного методистами
//
// Возвращаемое значение:
//  Табличный документ - сформированная печатная форма
//
Функция ПечатьСчетаЗаказа(Тип) Экспорт

	ДопКолонка = Константы.ДополнительнаяКолонкаПечатныхФормДокументов.Получить();
	Если ДопКолонка = Перечисления.ДополнительнаяКолонкаПечатныхФормДокументов.Артикул Тогда
		ВыводитьКоды    = Истина;
		Колонка         = "Артикул";
		ТекстКодАртикул = "Артикул";
