Процедура ПроверитьГруппуСкладовРезерва()
	
	МасСтрок = Новый Массив;
	Для Каждого Стр Из Резерв Цикл
		
		Если Стр.Склад.Родитель = Справочники.Склады.НайтиПоКоду("000000037") Тогда
			//МасСтрок.Добавить(Стр);
		КонецЕсли;
		
	КонецЦикла;
	НайденаЗадача = ОбщегоНазначения.ЕстьЗадачаЗаказа(Ссылка,"В заказе есть резерв на склад из группы филиалы");
	Если МасСтрок.Количество()>0 И НЕ ЗначениеЗаполнено(НайденаЗадача) Тогда
		ФВ =  Документы.ЗаказПокупателя.ПолучитьФорму("ФормаЗадачи");
		ФВ.Заголовок = "В заказе есть резерв на склад из группы филиалы"; 
		ДЛя Каждого Стр Из МасСтрок Цикл
			НС = ФВ.ТабРезерваОстаток.Добавить();
			ЗаполнитьЗначенияСвойств(НС,Стр);
			НС.ГруппаСкладов = НС.Склад.Родитель;
		КонецЦикла;
		СоздатьЗадачу = ФВ.ОткрытьМодально();
		Если Не СоздатьЗадачу = Неопределено Тогда
			Если НЕ СоздатьЗадачу Тогда Возврат; КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
		
		Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();
		
		Задача.Дата           = НачалоДня(ТекущаяДата()) + 32400;
		Задача.Наименование   = "В заказе есть резерв на склад из группы филиалы";
		Задача.Объект         = Ссылка;
		Задача.Оповещение     = Истина;
		Задача.СрокОповещения = Задача.Дата +       5 * 60;
		Задача.СрокИсполнения = Задача.Дата + 24 * 60 * 60;
		Задача.Описание       = "В заказе есть резерв на склад из группы филиалы";
		
		Форма = Задача.ПолучитьФорму("ФормаЗадачи");
		
		Форма.Открыть();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗадачаПользователю(пПользователь)
	
	ИдентификаторСобытия = "ИзменениеСтатуса";
	
	СуществующаяЗадача = Неопределено;
	
	Если Не Контрагент.Родитель.СоздаватьНовуюЗадачуПоЗаказу Тогда
		
		СуществующаяЗадача = БИАС.ПолучитьЗадачуКонтрагентаПоИдентификатору(Ссылка, ИдентификаторСобытия, пПользователь);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СуществующаяЗадача) Тогда
		
		Задача = СуществующаяЗадача.ПолучитьОбъект();
		
		Задача.Дата           = ТекущаяДата();
		Задача.Объект         = Ссылка;
		Задача.Оповещение     = Истина;
		Задача.СрокОповещения = Задача.Дата;
		Задача.СрокИсполнения = Задача.Дата + 24 * 60 * 60;
		Задача.Описание       = Задача.Описание + Символы.ПС + Символы.ПС + "Заказ перешел в статус " + СокрЛП(СтатусЗаказа)
		
	Иначе
		
		Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();
		
		Задача.ИдентификаторСобытия = ИдентификаторСобытия;
		Задача.Исполнитель          = пПользователь;
		Задача.Дата                 = ТекущаяДата();
		
		Если СтатусЗаказа.Наименование = "Продано" Тогда
			Задача.Прочитано = Истина;
			Задача.Описание = ТипЦен.Наименование + " "+ СтатусДо.Наименование ;

		ИначеЕсли СтатусЗаказа.Наименование = "Не удачные" Тогда
			Задача.Описание = СокрЛП(СтатусЗаказа) + ТипЦен;
			
			Если ТипЦен = справочники.ТипыЦенНоменклатуры.НайтиПоНаименованию("Оптовые") И ЗначениеЗаполнено(Задача.Объект)  тогда
				Задача.Описание = Задача.Описание + " " + Задача.Объект.Ссылка.Контрагент.Наименование;
			КонецЕсли;
		Иначе
			Задача.Описание = "Заказ перешел в статус " + СокрЛП(СтатусЗаказа);
		КонецЕсли;
		
		Задача.Наименование         = СокрЛП(СтатусЗаказа);
		Задача.Объект               = Ссылка;
		Задача.Оповещение           = Истина;
		Задача.СрокИсполнения       = Задача.Дата + 24 * 60 * 60;
		Задача.СрокОповещения       = Задача.Дата;	
		
	КонецЕсли;
	
	Попытка
		Задача.Записать();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ПроверитьСтатус() Экспорт
	
	Если СтатусЗаказа <> СтатусДо Тогда // сменили статус

		// Уведомление менеджеру о переходе в статус. Отсюда его слать нельзя:
		// обработчик работает в транзакции записи документа, а она ещё может
		// откатиться - сообщение при этом уже улетело бы. Поэтому только ставим
		// заказ в очередь (запись идёт в той же транзакции и появляется
		// одновременно с новым статусом), а шлёт регламент ТелеграмОбмен.
		//
		// Пустой СтатусДо - это первая установка статуса у нового заказа, а не
		// смена: по заказу с сайта менеджер и так получает "новый заказ".
		Если ЗначениеЗаполнено(СтатусДо) Тогда
			ТелеграмБот.ЗарегистрироватьСменуСтатуса(Ссылка, СтатусЗаказа);
		КонецЕсли;

		Если СтатусЗаказа.ФормироватьЗадачу Тогда

			// По розничным заказам исполнителя можно перебить в карточке статуса
			// (закладка "Розница"); пусто там - работает общее правило.
			// Тип цен берём у объекта, а не через Ссылка: обработчик выполняется
			// в транзакции записи, и по ссылке пришло бы состояние ДО правки.
			Исполнитель = Неопределено;

			Если ЗначениеЗаполнено(СтатусЗаказа.ПользовательРозница)
				И ТелеграмБот.ЭтоРозничныйТипЦен(ТипЦен) Тогда

				Исполнитель = СтатусЗаказа.ПользовательРозница;

			ИначеЕсли ЗначениеЗаполнено(СтатусЗаказа.Пользователь) Тогда

				Исполнитель = СтатусЗаказа.Пользователь;

			ИначеЕсли ЗначениеЗаполнено(СтатусЗаказа.ПользовательГруппа) Тогда

				Исполнитель = СтатусЗаказа.ПользовательГруппа;

			КонецЕсли;

			Если ЗначениеЗаполнено(Исполнитель) Тогда
				ЗадачаПользователю(Исполнитель);
			КонецЕсли;

		КонецЕсли;
		СтатусДо = СтатусЗаказа;
//БИАС 19.02.2021
		//Если СтатусЗаказа.ПрименятьСхемуРезервирования И ЗначениеЗаполнено(СтатусЗаказа.СхемаРезервирования)  
		//		И НЕ СхемаРезервирования = СтатусЗаказа.СхемаРезервирования Тогда
		//	СхемаРезервирования = СтатусЗаказа.СхемаРезервирования;
		//	РасспределитьРезерв();
		//КонецЕсли;
//БИАС 19.02.2021
		
	КонецЕсли;
	
КонецПроцедуры

