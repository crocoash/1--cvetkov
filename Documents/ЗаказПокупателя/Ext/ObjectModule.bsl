	//	Иначе	
	//		ТелефонКонтрагента = "";
	//	КонецЕсли;
	//КонецЕсли;	
	
	Если ЗначениеЗаполнено(Ссылка) И не ЗначениеЗаполнено(НомерТТН) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭкспортированныеОбъектыВИСПеревозчиков.НомерДокумента
		|ИЗ
		|	РегистрСведений.ЭкспортированныеОбъектыВИСПеревозчиков КАК ЭкспортированныеОбъектыВИСПеревозчиков
		|ГДЕ
		|	ЭкспортированныеОбъектыВИСПеревозчиков.Объект = &Объект";
		Запрос.УстановитьПараметр("Объект", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если выборка.Следующий() Тогда
			НомерТТН = СокрЛП(выборка.НомерДокумента);
		Иначе
	        НомерТТН = "";
		КонецЕсли;	
	КонецЕсли;	
	
	Если СтатусЗаказа=Справочники.СтатусыЗаказов.НайтиПоНаименованию("Не удачные") Тогда
		РассчитатьСтоимостьДоставки();
	КонецЕсли;	
			
