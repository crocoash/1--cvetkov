Функция НомерДокумента() Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказПокупателя.Номер КАК Номер,
	               |	ЗаказПокупателя.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	               |ГДЕ
	               |	ЗаказПокупателя.Дата >= &НачДата
	               |	И НЕ ЗаказПокупателя.Номер ПОДОБНО &Номер
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЗаказПокупателя.Дата УБЫВ";
	Запрос.УстановитьПараметр("Номер","%/%");
	//Запрос.УстановитьПараметр("НачДата",НачалоГода(ТекущаяДата()));
	Запрос.УстановитьПараметр("НачДата", Дата("20200101"));

	Рез = Запрос.Выполнить().Выгрузить();
	
	Рез.Сортировать("Номер Убыв");
	
	Ном=ОбщегоНазначения.ДополнитьНомерНулями("1",Метаданные.Документы.ЗаказПокупателя.ДлинаНомера);
	МожноБрать = НЕ ЗначениеЗаполнено(Ссылка);	
	Для Каждого Стр Из Рез Цикл
		
		Если Стр.Ссылка = Ссылка Тогда МожноБрать = Истина; Продолжить; КонецЕсли;
		
		Если НЕ МожноБрать Тогда Продолжить; КонецЕсли;
		
		Ном = ОбщегоНазначения.НормальноеЧисло(Стр.Номер);

		Ном = Число(Ном)+1;
		Возврат ОбщегоНазначения.ДополнитьНомерНулями(Строка(Ном),Метаданные.Документы.ЗаказПокупателя.ДлинаНомера);
		
	КонецЦикла;
	
	Возврат Ном;
	
