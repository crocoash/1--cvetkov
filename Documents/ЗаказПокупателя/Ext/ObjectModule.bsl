// Быстрый заказ с сайта приходит на карточку контрагента с именем-заглушкой:
// на момент загрузки ФИО покупателя ещё нет, и сайт присылает в теге name
// «Швидке замовлення». Здесь распознаём такие имена, чтобы потом переподписать
// карточку настоящим ФИО.
Функция ЭтоИмяЗаглушкаКонтрагента(Наименование)

	ИмяДляСравнения = НРег(СокрЛП(Наименование));

	Если ПустаяСтрока(ИмяДляСравнения) Тогда
		Возврат Истина;
	КонецЕсли;

	Заглушки = ",швидке замовлення,швидке замовления,швидке замовленя,швидка покупка,быстрый заказ,сайт,заказ с сайта,";

	Возврат Найти(Заглушки, "," + ИмяДляСравнения + ",") > 0;

КонецФункции

// Сколько заказов, кроме текущего, висит на контрагенте.
Функция КоличествоЗаказовКонтрагентаКроме(Контр, ТекущийЗаказ)

	Запрос = Новый Запрос;

	Запрос.Текст =

		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(ЗаказПокупателя.Ссылка) КАК Количество
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.Контрагент = &Контрагент
		|	И ЗаказПокупателя.Ссылка <> &Ссылка";

	Запрос.УстановитьПараметр("Контрагент", Контр);
	Запрос.УстановитьПараметр("Ссылка"    , ТекущийЗаказ);

	Выборка = Запрос.Выполнить().Выбрать();

	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);

КонецФункции

// Подписывает карточку контрагента ФИО получателя.
//
// Быстрый заказ с сайта заводится на карточку с именем-заглушкой, потому что
// данных на отправку в момент загрузки ещё нет. ФИО появляется позже - когда
// менеджер получил их и заполнил Получателя. С этого момента карточка должна
// называться ФИО: иначе весь трафик быстрых заказов остаётся безымянным,
// а история покупок клиента не собирается.
//
// Переподписываем только саму заглушку и только карточку текущего заказа -
// нормальное ФИО в карточке чужого клиента не трогаем никогда.
Процедура ПодписатьКонтрагентаПолучателем()

	// Загрузка с сайта и программная запись сюда не попадают: там Получатель
	// либо пуст, либо содержит ту же самую заглушку.
	Если Не ЗначениеЗаполнено(ЗаписьИзФормы) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Контрагент) Или ПустаяСтрока(Получатель) Тогда
		Возврат;
	КонецЕсли;

	ФИО = СокрЛП(Получатель);

	Если Не ЭтоИмяЗаглушкаКонтрагента(Контрагент.Наименование) Тогда
		Возврат;
	КонецЕсли;

	// Получатель должен быть похож на ФИО: не вторая заглушка, не обрывок и не
	// один только номер телефона (в поле руками пишут что угодно).
	Если ЭтоИмяЗаглушкаКонтрагента(ФИО) Или
		 СтрДлина(ФИО) < 5 Или
		 ВРег(ФИО) = НРег(ФИО) Тогда

		Возврат;

	КонецЕсли;

	// Страховка на случай, если «Швидке замовлення» - одна общая карточка на все
	// быстрые заказы, а не карточка на телефон покупателя: переподписать общего
	// контрагента ФИО одного клиента значит спрятать под этим именем весь
	// чужой трафик. У личной карточки столько заказов не набирается.
	Если КоличествоЗаказовКонтрагентаКроме(Контрагент, Ссылка) > 20 Тогда
		Возврат;
	КонецЕсли;

	КонтрагентОбъект = Контрагент.ПолучитьОбъект();

	КонтрагентОбъект.Наименование       = Лев(ФИО, 100);
	КонтрагентОбъект.НаименованиеПолное = ФИО;

	КонтрагентОбъект.Записать();

КонецПроцедуры

// Процедура вызывается перед записью документа
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Номер) Тогда
		
		Если ЗначениеЗаполнено(ОсновнойЗаказ) И
			 ЗначениеЗаполнено(ОсновнойЗаказ.Сделка) Тогда
			
			Номер = НомерПодзаказа();
			
		Иначе
			
			Номер = НомерДокумента();
			
		КонецЕсли;
		
	КонецЕсли;
	
	мУдалятьДвижения = НЕ ЭтоНовый();
	Если НЕ РежимЗаписи = РежимЗаписиДокумента.Проведение И Проведен Тогда
		Если ОбъемныйВес=0 Тогда	
			РасчитатьОбъемВес();
		КонецЕсли;
	КонецЕсли;
	
//БИАС 19.02.2021
	//ПроверитьРезерв();
	Если СтатусЗаказа.ПрименятьСхемуРезервирования И
		 ЗначениеЗаполнено(СтатусЗаказа.СхемаРезервирования) И
		 СхемаРезервирования <> СтатусЗаказа.СхемаРезервирования Тогда
		
		СхемаРезервирования = СтатусЗаказа.СхемаРезервирования;
		
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		
		ПроверитьРезерв();
		
	КонецЕсли;
//БИАС 19.02.2021
	
	СтатусДо = Ссылка.СтатусЗаказа;
	
	Если (ВидОплатыЗаказа = Перечисления.ВидОплатыЗаказ.НаложеныйПлатеж) И Не ЗначениеЗаполнено(СуммаНоваяПочта) Тогда
		СуммаНоваяПочта = СуммаДокумента;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПорядковыйНомер) Тогда
		ПорядковыйНомер = ОбщегоНазначения.ПорядковыйНомерПолучить();
	КонецЕсли;
	
//БИАС 19.02.2021
	//Если (НЕ СхемаРезервирования = Ссылка.СхемаРезервирования ИЛИ
	//	НЕ Товары.Итог("Количество") = Ссылка.Товары.Итог("Количество") 
	//	ИЛИ НЕ СтатусЗаказа = ССылка.СтатусЗаказа)  И НЕ ИзРеализации И НЕ ЭтоНовый() Тогда
	//	Константы.НужноПерераспределитьРезерв.Установить(Истина);
	//КонецЕсли;
//БИАС 19.02.2021
	Биас.УстановитьНомерПриходнойОрера();

	
	Если Ссылка.СтатусЗаказа.ФормироватьРеализацию И НЕ СтатусЗаказа.ФормироватьРеализацию Тогда
		ДополнительныеСвойства.Вставить("ОтменитьРеализацию", Истина);
	КонецЕсли;	
	
	Если Ссылка.СтатусЗаказа.ФормироватьПКО И НЕ СтатусЗаказа.ФормироватьПКО Тогда
		ДополнительныеСвойства.Вставить("ОтменитьПКО", Истина);
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		ДополнительныеСвойства.Вставить("ЭтоНовый", Истина);
	Иначе
		ДополнительныеСвойства.Вставить("ЭтоНовый", Ложь);
	КонецЕсли;
	Если СпособОтправки = Справочники.СпособыОтправки.НоваяПочта Тогда
		Если НЕ ЗначениеЗаполнено(Фамилия) И ЗначениеЗаполнено(Получатель) Тогда
			Разбить(Получатель);
		ИначеЕсли НЕ ЗначениеЗаполнено(Фамилия) И ЗначениеЗаполнено(Контрагент) Тогда
			Разбить(Контрагент);
		КонецЕсли;
	КонецЕсли;
	
	ЕстьПолучатель = ОбщегоНазначения.ПолучательВКонтрагентах(Получатель);
	
	Если Не ЗначениеЗаполнено(ЕстьПолучатель) И Не ПустаяСтрока(ТелефонКонтрагента) Тогда
		
		ЕстьПолучатель = БИАС.НайтиКонтрагентаПоНомеруТелефона(ТелефонКонтрагента);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЕстьПолучатель) И
		 ЗначениеЗаполнено(Получатель) И
		 ЗначениеЗаполнено(ЗаписьИзФормы) И
		 (Контрагент.Родитель.СоздатьНовогоКонтрагентаИзПолучателя Или Контрагент.Родитель.Родитель.СоздатьНовогоКонтрагентаИзПолучателя) И
		 СокрЛП(ЕстьПолучатель) <> СокрЛП(Получатель) Тогда
		
		КонтрагентОбъект = ЕстьПолучатель.ПолучитьОбъект();
		
		КонтрагентОбъект.Наименование       = СокрЛП(Получатель);
		КонтрагентОбъект.НаименованиеПолное = СокрЛП(Получатель);
		
		КонтрагентОбъект.Записать();
		
	ИначеЕсли Не ЗначениеЗаполнено(ЕстьПолучатель) И
			  ЗначениеЗаполнено(Получатель) И
			  (Контрагент.Родитель.СоздатьНовогоКонтрагентаИзПолучателя Или Контрагент.Родитель.Родитель.СоздатьНовогоКонтрагентаИзПолучателя) И
			  ЗначениеЗаполнено(ЗаписьИзФормы) Тогда
		
		//ФВ = Справочники.Контрагенты.ПолучитьФорму("ФормаВыбораГруппы");
