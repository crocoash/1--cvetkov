//
Процедура ЗаполнитьДокументПоОснованиюУпр(Основание)

	Если ТипЗнч(Основание) = Тип("ДокументСсылка.Событие") Тогда
		КонтактноеЛицоКонтрагента    = Основание.КонтактноеЛицо;
		Контрагент                   = Основание.Контрагент;
	КонецЕсли;

КонецПроцедуры // ЗаполнитьДокументПоОснованиюУпр()

Процедура РассчитатьСтоимостьДоставки()
	Перевозчик = Справочники.Перевозчики.НайтиПоНаименованию("Новая почта");
	НастройкиОбмена = ОбменДаннымиСИСПеревозчиковСервер.ПолучитьНастройкиОбменаДанными(Перевозчик);
	КлючАПИ = Неопределено;
	ГородОтправитель = Неопределено;
	СтруктураНастройки = Константы.ЛМ_НастройкиЗаполненияЭкспрессНакладнойПоУмолчанию.Получить().Получить();
	Если ТипЗнч(СтруктураНастройки) = Тип("Структура") Тогда
		Если СтруктураНастройки.Свойство("Отправитель") Тогда
			ОтправительПоУмолчанию = СтруктураНастройки.Отправитель;
			ГородОтправитель = ОтправительПоУмолчанию.Город;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ГородОтправитель) Тогда
		ТекВес=Вес;
		Если ТекВес=0 Тогда
			Для Каждого ТекСтрока Из Товары Цикл
				ВесЕдиницы=ТекВес+ТекСтрока.Номенклатура.Вес;
				Если ВесЕдиницы=0 Тогда
					ВесЕдиницы=ТекСтрока.Номенклатура.ВидНоменклатуры.Вес*ТекСтрока.Количество;
				КонецЕсли;	
				ТекВес=ТекВес+ВесЕдиницы*ТекСтрока.Количество;
			КонецЦикла
		КонецЕсли;	
		СтоимостьДоставки = ОбменДаннымиСИСПеревозчиковОбщегоНазначения.ПолучитьСтоимостьДоставки(КлючАПИ, СтруктураНастройки, ГородНовойПочтыЗначение, ТекВес, ВидГруза, Мест,СуммаДокумента);
		СтоимостьДоставки=СтоимостьДоставки*2;
	Иначе
		//Сообщить("Не удалось определить город отправителя");
	КонецЕсли;

КонецПроцедуры


