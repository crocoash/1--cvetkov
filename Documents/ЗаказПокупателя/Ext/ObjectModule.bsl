Функция РасчитатьОбъемВес(Пересчет=Ложь) Экспорт 
	Если НЕ СпособОтправки = Справочники.СпособыОтправки.НоваяПочта ИЛИ (НЕ Пересчет И ЗначениеЗаполнено(Вес)) Тогда 
		Возврат 0;
	КонецЕсли;
	ВесМ = 0;  ОбВ = 0; Ширина = 0;Длина = 0; Высота = 0;
	Для Каждого Стр Из Товары Цикл
		Если НЕ ЗначениеЗаполнено(Стр.Номенклатура.Вес) Тогда
			//Сообщить(СокрЛП(Стр.Номенклатура)+" не указан вес!");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.Номенклатура.Ширина) Или НЕ ЗначениеЗаполнено(Стр.Номенклатура.Длина) Или НЕ ЗначениеЗаполнено(Стр.Номенклатура.Высота) Тогда
			//Сообщить(СокрЛП(Стр.Номенклатура)+" не указаны габариты!");
		КонецЕсли;
		Ширина = Ширина+Стр.Номенклатура.Ширина; Высота = Высота+ Стр.Номенклатура.Высота; Длина = Длина+Стр.Номенклатура.Длина;
		ВесМ = весМ+Стр.Номенклатура.Вес;  
		ОбВ=ОбВ+Стр.Номенклатура.Ширина * Стр.Номенклатура.Длина * Стр.Номенклатура.Высота / 4000;
	КонецЦикла;
	Если НЕ ЗначениеЗаполнено(Мест)  Тогда Мест = 1; КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Вес) ИЛИ Пересчет Тогда 
		Если ЗначениеЗаполнено(ВесМ) Тогда
			Вес = ВесМ; 
		Иначе
			Вес = 1;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОбъемныйВес) ИЛИ  Пересчет  Тогда 
		ОбъемныйВес = ОбВ;
	КонецЕсли;

КонецФункции

Процедура Разбить(Элемент)  Экспорт 
	СтрНаименования = СокрЛП(Элемент);
	ПоложениеПробела = Найти(СтрНаименования, " ");
	Если ПоложениеПробела > 0 Тогда
		Фамилия= Лев(СтрНаименования, ПоложениеПробела - 1);
		СтрНаименования = СокрЛП(Сред(СтрНаименования, ПоложениеПробела + 1));
	Иначе
		Фамилия = СтрНаименования;
		Имя = "";  
		СтрНаименования="";
	КонецЕсли;	
	ПоложениеПробела = Найти(СтрНаименования, " ");
	Если ПоложениеПробела > 0 Тогда
		Имя = Лев(СтрНаименования, ПоложениеПробела - 1);
		СтрНаименования = СокрЛП(Сред(СтрНаименования, ПоложениеПробела + 1));
	Иначе
		Имя = СтрНаименования;
		Отчество = ""; 
		СтрНаименования=""; 
	КонецЕсли;	
	СтрНаименования = СокрЛП(СтрНаименования);
	Если ЗначениеЗаполнено(СтрНаименования) тогда
		Отчество = СтрНаименования;
	КонецЕсли;
    Получатель=Фамилия+" "+Имя+" "+Отчество;
	Записать();
	
КонецПроцедуры

