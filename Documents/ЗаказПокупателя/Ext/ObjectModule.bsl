		Дог = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		Дог.Владелец = Кон.Ссылка;
		Дог.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("980");
		Дог.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
		Дог.Наименование = "Основной";
		Дог.Организация = Справочники.Организации.НайтиПоКоду("000000001");
	//	Дог.ВидУсловийДоговора = Перечисления.ВидыУсловийДоговоровВзаиморасчетов.БезДополнительныхУсловий;
		Дог.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом;
	//	Дог.ВедениеВзаиморасчетовНУ = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом;
		Дог.Записать();

		
		//телефон
		Если ЗначениеЗаполнено(ТелефонКонтрагента) Тогда
			Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
			Запись.Объект = Кон.Ссылка;
			Запись.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
			Запись.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			Запись.Представление = ТелефонКонтрагента;
			Запись.Записать();
		КонецЕсли;
		
		////имейл
		//Если ЗначениеЗаполнено(АдресЭлектроннойПочтыКонтрагента) Тогда
		//	Запись = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
		//	Запись.Объект = Кон.Ссылка;
