		//Если Род = Неопределено Тогда Возврат; КонецЕсли;
		
		Род = Справочники.Контрагенты.НайтиПоКоду("000000463");
		
		Кон = Справочники.Контрагенты.СоздатьЭлемент();
		Кон.ГруппаДоступаККонтрагенту = Справочники.ГруппыДоступаККонтрагентам.НайтиПоКоду("000000002");
		Кон.Наименование = Получатель;
		Кон.НаименованиеПолное = Получатель;
		Кон.Покупатель = Истина;
		Кон.Родитель =Род;
		Кон.Записать();
		
