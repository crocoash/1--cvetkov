Перем ОтказОтСоздания Экспорт;
Перем мЕстьОшибки Экспорт;

Процедура ВыгрузитьЭкспрессНакладную() Экспорт
	Если ПроверкаЗаполнения() Тогда
		Возврат;
	КонецЕсли;
	мЕстьОшибки = Ложь;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("apiKey", Константы.ЛМ_КлючAPI.Получить());
	СтруктураЗапроса.Вставить("modelName", "InternetDocument");
	Если ЗначениеЗаполнено(ГУИД) Тогда
		СтруктураЗапроса.Вставить("calledMethod", "update");
	Иначе	
		СтруктураЗапроса.Вставить("calledMethod", "save");
	КонецЕсли;
	СтруктураПараметров = Новый Структура;
	Если ЗначениеЗаполнено(ГУИД) Тогда
		СтруктураПараметров.Вставить("Ref", ГУИД);
	КонецЕсли;	
	СтруктураПараметров.Вставить("PayerType", ПлательщикДоставки.ГУИД);
	СтруктураПараметров.Вставить("PaymentMethod", ФормаОплаты.ГУИД);
	СтруктураПараметров.Вставить("DateTime", Формат(ДатаОтправки, "ДФ=dd.MM.yyyy"));
	СтруктураПараметров.Вставить("ServiceType", ТехнологияДоставки.ГУИД);
	СтруктураПараметров.Вставить("Cost", Формат(ОбъявленнаяСтоимость, "ЧГ="));
	СтруктураПараметров.Вставить("CitySender", ГородОтправителя.ГУИД);
	СтруктураПараметров.Вставить("Sender", Отправитель.ГУИД);
	Если ТехнологияДоставки.ГУИД = "DoorsDoors" ИЛИ ТехнологияДоставки.ГУИД = "DoorsWarehouse" Тогда
		СтруктураПараметров.Вставить("SenderAddress", АдресОтправителя.ГУИД);
	Иначе
		СтруктураПараметров.Вставить("SenderAddress", СкладОтправителя.ГУИД);
	КонецЕсли;	
	СтруктураПараметров.Вставить("ContactSender", КонтактноеЛицоОтправителя.ГУИД);
	СтруктураПараметров.Вставить("SendersPhone", ТелефонОтправителя);
	СтруктураПараметров.Вставить("CityRecipient", ГородПолучателя.ГУИД);
	СтруктураПараметров.Вставить("Recipient", Получатель.ГУИД);
	
	Если ТехнологияДоставки.ГУИД = "DoorsDoors" ИЛИ ТехнологияДоставки.ГУИД = "WarehouseDoors" Тогда
		СтруктураПараметров.Вставить("RecipientAddress", АдресПолучателя.ГУИД);
	Иначе
		СтруктураПараметров.Вставить("RecipientAddress", СкладПолучателя.ГУИД);
	КонецЕсли;	
	СтруктураПараметров.Вставить("ContactRecipient", КонтактноеЛицоПолучателя.ГУИД);
	СтруктураПараметров.Вставить("RecipientsPhone", ТелефонПолучателя);
	
	
	Если ПараметрыГрузов.Количество() = 0 И ЗначениеЗаполнено(КоличествоМест) тогда
		СтруктураПараметров.Вставить("SeatsAmount", Формат(КоличествоМест, "ЧГ="));
	Иначе
		СтруктураПараметров.Вставить("SeatsAmount", Формат(ПараметрыГрузов.Количество(), "ЧГ="));
	КонецЕсли;
	
	СтруктураПараметров.Вставить("CargoType", ТипГруза.ГУИД);
	
	Если ПараметрыГрузов.Количество() = 0 Тогда
		Если ТипГруза.ГУИД = "Documents" Тогда
			СтруктураПараметров.Вставить("VolumeGeneral", "0");
		Иначе	
			СтруктураПараметров.Вставить("VolumeGeneral", Формат(Объем,"ЧДЦ=3"));
		КонецЕсли;	
	КонецЕсли;	
	
	СтруктураПараметров.Вставить("Weight", Формат(ФактическийВес,"ЧДЦ=1, ЧГ="));
	СтруктураПараметров.Вставить("Description", ОписаниеГруза.Наименование);
	СтруктураПараметров.Вставить("AdditionalInformation", СокрЛП(Комментарий));
	
	//Объект.ОбъемныйВес = Объект.Объем * 250;
	//Если Объект.Ширина <> 0  и Объект.Длина <> 0 И Объект.Высота <> 0 Тогда
	//	ИсходныйОбъем = Объект.Ширина * Объект.Длина * Объект.Высота;
	//	Коэфф = Объект.Объем / ИсходныйОбъем;
	//	Объект.Ширина = Объект.Ширина * Коэфф;
	//	Объект.Длина = Объект.Длина * Коэфф;
	//	Объект.Высота = Объект.Высота * Коэфф;
	//КонецЕсли;	

	
	
	МассПараметровГруза = Новый Массив;
	Для Каждого ТекСтрокаПараметровГруза Из ПараметрыГрузов Цикл
		ТекСтруктура = Новый Структура;
		Если ТипГруза.ГУИД = "Documents" Тогда
			ТекСтруктура.Вставить("volumetricWidth", "0");
			ТекСтруктура.Вставить("volumetricLength", "0");
			ТекСтруктура.Вставить("volumetricHeight", "0");
			ТекСтруктура.Вставить("volumetricVolume", "0");
		Иначе
			ТекСтруктура.Вставить("volumetricWidth", Формат(ТекСтрокаПараметровГруза.Ширина, "ЧДЦ=1; ЧРД=.; ЧГ="));
			ТекСтруктура.Вставить("volumetricLength", Формат(ТекСтрокаПараметровГруза.Длина, "ЧДЦ=1; ЧРД=.; ЧГ="));
			ТекСтруктура.Вставить("volumetricHeight", Формат(ТекСтрокаПараметровГруза.Высота, "ЧДЦ=1; ЧРД=.; ЧГ="));
			ТекСтруктура.Вставить("volumetricVolume", Формат(ТекСтрокаПараметровГруза.Объем, "ЧДЦ=6; ЧРД=.; ЧГ="));
		КонецЕсли;
		ТекСтруктура.Вставить("weight", Формат(ТекСтрокаПараметровГруза.ФактическийВес, "ЧДЦ=1; ЧРД=.; ЧГ="));
		МассПараметровГруза.Добавить(ТекСтруктура);
	КонецЦикла;	
	Если МассПараметровГруза.Количество() > 0 И ТипГруза.ГУИД <> "Documents" Тогда
		СтруктураПараметров.Вставить("OptionsSeat", МассПараметровГруза);
	КонецЕсли;
	
	МасивШиныДиски = Новый Массив;
	Если ТипГруза.ГУИД = "TiresWheels" ТОгда
		Для Каждого ТекСтр Из ШиныИДиски Цикл
			СтруктураШиныДиски = Новый Структура;
			СтруктураШиныДиски.Вставить("CargoDescription", ТекСтр.ШиныДиски.ГУИД);
			СтруктураШиныДиски.Вставить("Amount", Формат(ТекСтр.Количество, "ЧГ="));
		КонецЦикла;	
	КонецЕсли;
	
	Если МасивШиныДиски.Количество() > 0 Тогда
		СтруктураПараметров.Вставить("CargoDetails", МасивШиныДиски);
	КонецЕсли;
	Если ЗначениеЗаполнено(ВременнойИнтервал) Тогда 
		СтруктураПараметров.Вставить("TimeInterval", ВременнойИнтервал.ГУИД);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ВидОбратнойДоставки) тогда
		МассивВидовОбратнойДоставки = Новый Массив;
		Если ВидОбратнойДоставки.ГУИД = "SignedDocuments" ИЛИ ВидОбратнойДоставки.ГУИД = "CreditDocuments" ИЛИ ВидОбратнойДоставки.ГУИД = "EWTransporter" ИЛИ ВидОбратнойДоставки.ГУИД = "Money" Тогда
			СтруктураТекВидаОбратнойДоставки = Новый Структура;
			СтруктураТекВидаОбратнойДоставки.Вставить("CargoType", ВидОбратнойДоставки.ГУИД);
			СтруктураТекВидаОбратнойДоставки.Вставить("PayerType", ПлательщикОбратнойДоставки.ГУИД);
			Если ВидОбратнойДоставки.ГУИД = "Money" Тогда
				СтруктураТекВидаОбратнойДоставки.Вставить("RedeliveryString", Формат(СуммаОбратнойДоставки, "ЧН=' '; ЧГ=0"));
			Иначе
				СтруктураТекВидаОбратнойДоставки.Вставить("RedeliveryString", ОписаниеОбратнойДоставки);
			КонецЕсли;	
			МассивВидовОбратнойДоставки.Добавить(СтруктураТекВидаОбратнойДоставки);
		КонецЕсли;	
		Если ОбратнаяДоставкаПоддонов.Количество() > 0 Тогда
			СтруктураТекВидаОбратнойДоставки = Новый Структура;
			СтруктураТекВидаОбратнойДоставки.Вставить("CargoType", "Trays");
			СтруктураТекВидаОбратнойДоставки.Вставить("PayerType", ПлательщикОбратнойДоставки.ГУИД);
			СтруктураТекВидаОбратнойДоставки.Вставить("RedeliveryString", ОписаниеОбратнойДоставки);
			МассивОбратнойДоставки = Новый Массив;
			Для каждого ТекСтрокаПоддона Из ОбратнаяДоставкаПоддонов цикл
				СтруктураПоддона = Новый Структура;
				СтруктураПоддона.Вставить("CargoDescription", ТекСтрокаПоддона.Поддон.ГУИД);
				СтруктураПоддона.Вставить("Amount", Формат(ТекСтрокаПоддона.Количество, "ЧГ="));
				МассивОбратнойДоставки.Вставить(СтруктураПоддона);
			КонецЦикла; 	
			СтруктураТекВидаОбратнойДоставки.Вставить(МассивОбратнойДоставки);
			МассивВидовОбратнойДоставки.Добавить(СтруктураТекВидаОбратнойДоставки);
		КонецЕсли;
		СтруктураПараметров.Вставить("BackwardDeliveryData", МассивВидовОбратнойДоставки);
	КонецЕсли;	
	
	Если СуботняяДоставка Тогда
		СтруктураПараметров.Вставить("SaturdayDelivery", "1");
	КонецЕсли;
	
	Если ЗаборДоверенности Тогда
		СтруктураПараметров.Вставить("IsTakeAttorney", "1");
	КонецЕсли;
	Если ДоставкаДеньВДень Тогда
		СтруктураПараметров.Вставить("SameDayDelivery", "1");
	КонецЕсли;
	Если ЗначениеЗаполнено(ЖелаемаяДатаДоставки) тогда
		СтруктураПараметров.Вставить("PreferredDeliveryDate", Формат(ЖелаемаяДатаДоставки, "ДФ=dd.MM.yyyy"));
	КонецЕсли;	
	Если ЗначениеЗаполнено(КонтрольОплаты) тогда
		СтруктураПараметров.Вставить("AfterpaymentOnGoodsCost", Формат(КонтрольОплаты, "ЧГ="));
	КонецЕсли;	
	Если ЗначениеЗаполнено(Экспедирование) тогда
		СтруктураПараметров.Вставить("ForwardingCount", Формат(Экспедирование, "ЧГ="));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерПакета) тогда
		СтруктураПараметров.Вставить("PackingNumber", НомерПакета);
	КонецЕсли;

	
	Если ЗначениеЗаполнено(Экспедирование) тогда
		СтруктураПараметров.Вставить("ForwardingCount", Формат(Экспедирование, "ЧГ="));
	КонецЕсли;

	
	СтруктураЗапроса.Вставить("methodProperties", СтруктураПараметров);
	Если Константы.ЛМ_ЯзыкИнтерфейсаОбмена.Получить() = Перечисления.ЛМ_ЯзыкиИнтерфейсаОбмена.Украинский Тогда
		СтруктураЗапроса.Вставить("language", "ua");
	Иначе
		СтруктураЗапроса.Вставить("language", "ru");
	КонецЕсли;
	ДеревоОтвета = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.ОтправитьЗапрос(СтруктураЗапроса);
	СтуктураОтвета = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.ПолучитьСтруктуруОтвета(ДеревоОтвета,Истина);
	Если Не ЗначениеЗаполнено(ГУИД) И СтуктураОтвета.Свойство("Ref") Тогда
		ГУИД = СтуктураОтвета.Ref;
	ИначеЕсли 	СтуктураОтвета.Свойство("Ошибки") Тогда
		СтруктураОшибок = СтуктураОтвета.Ошибки;
		Для Каждого КлючЗнач Из СтруктураОшибок Цикл
			Ключ = КлючЗнач.Ключ;
			ПоложениеИтератора = Найти(Ключ, "Итератор");
			Если ПоложениеИтератора > 0 Тогда
				Ключ = Лев(Ключ, ПоложениеИтератора - 1);
			КонецЕсли;
			Сообщить(Ключ + ": " + КлючЗнач.Значение, СтатусСообщения.Важное);
			мЕстьОшибки = истина;
		КонецЦикла;	
	КонецЕсли;	
	Если Не ЗначениеЗаполнено(НомерТТН) И СтуктураОтвета.Свойство("IntDocNumber") Тогда
		НомерТТН = СтуктураОтвета.IntDocNumber;
		КонецЕсли;
КонецПроцедуры	

Функция ПроверкаЗаполнения()
	Ошибка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Отправитель) Тогда
		Сообщить("Поле ""Отправитель"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Получатель) Тогда
		Сообщить("Поле ""Получатель"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ПлательщикДоставки) Тогда
		Сообщить("Поле ""Плательщик доставки"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ФормаОплаты) Тогда
		Сообщить("Поле ""Форма оплаты"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ТехнологияДоставки) Тогда
		Сообщить("Поле ""Технология доставки"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	
	Если ТехнологияДоставки.ГУИД = "WarehouseWarehouse" Тогда
		Если НЕ ЗначениеЗаполнено(СкладОтправителя) Тогда
			Сообщить("Поле ""Склад отправителя"" не заполнено");
			Ошибка = Истина;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(СкладПолучателя) Тогда
			Сообщить("Поле ""Склад получателя"" не заполнено");
			Ошибка = Истина;
		КонецЕсли;	
	ИначеЕсли 	ТехнологияДоставки.ГУИД = "WarehouseDoors" Тогда
		Если НЕ ЗначениеЗаполнено(СкладОтправителя) Тогда
			Сообщить("Поле ""Склад отправителя"" не заполнено");
			Ошибка = Истина;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(АдресПолучателя) Тогда
			Сообщить("Поле ""Адрес получателя"" не заполнено");
			Ошибка = Истина;
		КонецЕсли;	
		
	ИначеЕсли 	ТехнологияДоставки.ГУИД = "DoorsWarehouse" Тогда
		Если НЕ ЗначениеЗаполнено(АдресОтправителя) Тогда
			Сообщить("Поле ""Адрес отправителя"" не заполнено");
			Ошибка = Истина;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(СкладПолучателя) Тогда
			Сообщить("Поле ""Склад получателя"" не заполнено");
			Ошибка = Истина;
		КонецЕсли;	
	ИначеЕсли 	ТехнологияДоставки.ГУИД = "DoorsDoors" Тогда
		Если НЕ ЗначениеЗаполнено(АдресОтправителя) Тогда
			Сообщить("Поле ""Адрес отправителя"" не заполнено");
			Ошибка = Истина;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(АдресПолучателя) Тогда
			Сообщить("Поле ""Адрес получателя"" не заполнено");
			Ошибка = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицоОтправителя) Тогда
		Сообщить("Поле ""Контактное лицо отправителя"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(КонтактноеЛицоПолучателя) Тогда
		Сообщить("Поле ""Контактное лицо получателя"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ГородОтправителя) Тогда
		Сообщить("Поле ""Город отправителя"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ГородПолучателя) Тогда
		Сообщить("Поле ""Город получателя"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ТелефонОтправителя) Тогда
		Сообщить("Поле ""Телефон отправителя"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ТелефонПолучателя) Тогда
		Сообщить("Поле ""Телефон получателя"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ОбъявленнаяСтоимость) Тогда
		Сообщить("Поле ""Объявленная стоимость"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(КоличествоМест) Тогда
		Сообщить("Поле ""Количество мест"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ОписаниеГруза) Тогда
		Сообщить("Поле ""Описание груза"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	

	Если НЕ ЗначениеЗаполнено(ТипГруза) Тогда
		Сообщить("Поле ""Тип груза"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(ФактическийВес) Тогда
		Сообщить("Поле ""Фактический вес"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
    Если НЕ ЗначениеЗаполнено(ОбъемныйВес) Тогда
		Сообщить("Поле ""Объемный вес"" не заполнено");
		Ошибка = Истина;
	КонецЕсли;	
	
	Возврат Ошибка;
КонецФункции	

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ДанныеЗаполнения <> Неопределено Тогда
		
		Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ДанныеЗаполнения)) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
