Процедура УдалитьДокумент() Экспорт
	Если Распечатан Тогда
		Сообщить("Документ распечатан. Удаление документа невозможно!");
	КонецЕсли;	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("apiKey", Константы.ЛМ_КлючAPI.Получить());
	СтруктураЗапроса.Вставить("modelName", "InternetDocument");
	СтруктураЗапроса.Вставить("calledMethod", "delete");
	СтруктураЗапроса.Вставить("methodProperties", Новый Структура("DocumentRefs", Новый Структура("item" ,ГУИД)));
	ДеревоОтвета = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.ОтправитьЗапрос(СтруктураЗапроса);
	СтуктураОтвета = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.ПолучитьСтруктуруОтвета(ДеревоОтвета);
	Если СтуктураОтвета.Свойство("success") Тогда
		Если СтуктураОтвета.success = "true" Тогда
			ПометкаУдаления = Истина;
			Записать();
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры	

