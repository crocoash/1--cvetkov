&НаКлиенте
Процедура НаименованиеКонтрагентаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ФормаВыбора = ПолучитьФорму("Справочник.ЛМ_Контрагенты.ФормаВыбора");
	//КонтрагентыОтбора = ПолучитьКонтрагентовДляОтбора();
	//Если КонтрагентыОтбора <> Неопределено Тогда
	КонтрагентОснования = КонтрагентОснования();
	Если НЕ КонтрагентОснования = Неопределено Тогда
		ЭлементОтбора = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Контрагент");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = КонтрагентОснования;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;	
	Рез = ФормаВыбора.ОткрытьМодально();
	Если Рез <> Неопределено Тогда
		ВыборКонтрагентаДоставки(Рез);
	КонецЕсли;	
КонецПроцедуры

