&НаСервере
Процедура УстановитьДоступность()
	Если Объект.Распечатан Тогда
		ТолькоПросмотр = Истина;
	Иначе	
		ТолькоПросмотр = Ложь;
	КонецЕсли;	
	Если Объект.ТехнологияДоставки.ГУИД = "DoorsDoors" ИЛИ Объект.ТехнологияДоставки.ГУИД = "DoorsWarehouse" Тогда
		Элементы.СкладОтправителя.ТолькоПросмотр = Истина;
		Элементы.АдресОтправителя.ТолькоПросмотр = Ложь;
	ИначеЕсли 	Объект.ТехнологияДоставки.ГУИД = "WarehouseWarehouse" ИЛИ Объект.ТехнологияДоставки.ГУИД = "WarehouseDoors" Тогда
		Элементы.СкладОтправителя.ТолькоПросмотр = Ложь;
		Элементы.АдресОтправителя.ТолькоПросмотр = Истина;
	КонецЕсли;	
	
	Если Объект.ТехнологияДоставки.ГУИД = "DoorsDoors" ИЛИ Объект.ТехнологияДоставки.ГУИД = "WarehouseDoors" Тогда
		Элементы.СкладПолучателя.ТолькоПросмотр = Истина;
		Элементы.АдресПолучателя.ТолькоПросмотр = Ложь;
	ИначеЕсли 	Объект.ТехнологияДоставки.ГУИД = "WarehouseWarehouse" ИЛИ Объект.ТехнологияДоставки.ГУИД = "DoorsWarehouse" Тогда
		Элементы.СкладПолучателя.ТолькоПросмотр = Ложь;
		Элементы.АдресПолучателя.ТолькоПросмотр = Истина;
	КонецЕсли;	
    Заголовок = "Экспресс накладная " + Объект.Номер + " от " + Формат(Объект.Дата, "ДФ='dd.MM.yyyy ЧЧ:мм:сс'") + ?(Объект.Распечатан, "     ДОКУМЕНТ РАСПЕЧАТАН", "");
