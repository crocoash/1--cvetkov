&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если Не ЗначениеЗаполнено(Объект.КонтактноеЛицоПолучателя) И ЗначениеЗаполнено(Объект.ФамилияПолучателя) И ЗначениеЗаполнено(Объект.ИмяПолучателя) и ЗначениеЗаполнено(Объект.ОтчествоПолучателя) И ЗначениеЗаполнено(Объект.ТелефонПолучателя) Тогда
		Если ЗначениеЗаполнено(Объект.Получатель) Тогда
			Об = Справочники.ЛМ_КонтактныеЛица.СоздатьЭлемент();
			Об.Владелец = Объект.Получатель;
			Об.Имя = Объект.ИмяПолучателя;
			Об.Фамилия = Объект.ФамилияПолучателя;
			Об.Отчество = Объект.ОтчествоПолучателя;
			Об.Телефон = Объект.ТелефонПолучателя;
			Об.Записать();
			ТекущийОбъект.КонтактноеЛицоПолучателя = Об.Ссылка;
		ИначеЕсли ЗначениеЗаполнено(Объект.НаименованиеКонтрагента) Тогда
			ОбКонтрагент = Справочники.ЛМ_Контрагенты.СоздатьЭлемент();
			ОбКонтрагент.Город = Объект.ГородПолучателя;
			ОбКонтрагент.Наименование = Объект.НаименованиеКонтрагента;
			ОбКонтрагент.ВидКонтрагента = Справочники.ЛМ_ВидыПлательщиков.НайтиПоРеквизиту("ГУИД","Recipient");
			ОбКонтрагент.Имя = Объект.ИмяПолучателя;
			ОбКонтрагент.Фамилия = Объект.ФамилияПолучателя;
			ОбКонтрагент.Отчество = Объект.ОтчествоПолучателя;
			ОбКонтрагент.Телефон = Объект.ТелефонПолучателя;
			ОбКонтрагент.ЮрФизЛицо = Справочники.ЛМ_ТипыКонтрагентовОтправителей.НайтиПоРеквизиту("ГУИД", "PrivatePerson");
			ОбКонтрагент.Записать();
			ТекущийОбъект.Получатель = ОбКонтрагент.Ссылка;
			ЗапросКонтактногоЛица = Новый Запрос;
			ЗапросКонтактногоЛица.Текст = 
			"ВЫБРАТЬ
			|	ЛМ_КонтактныеЛица.Ссылка
			|ИЗ
			|	Справочник.ЛМ_КонтактныеЛица КАК ЛМ_КонтактныеЛица
			|ГДЕ
			|	ЛМ_КонтактныеЛица.Владелец = &Владелец";
			ЗапросКонтактногоЛица.УстановитьПараметр("Владелец", ОбКонтрагент.Ссылка);
			Выборка = ЗапросКонтактногоЛица.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ТекущийОбъект.КонтактноеЛицоПолучателя = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеКонтрагентаОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьЗначение(Объект.Получатель);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьФИОКОнтактногоЛица()
	Объект.ИмяПолучателя = Объект.КонтактноеЛицоПолучателя.Имя;
	Объект.ФамилияПолучателя = Объект.КонтактноеЛицоПолучателя.Фамилия;
	Объект.ОтчествоПолучателя = Объект.КонтактноеЛицоПолучателя.Отчество;
	Объект.ТелефонПолучателя = Объект.КонтактноеЛицоПолучателя.Телефон;
КонецПроцедуры	

&НаКлиенте
Процедура КонтактноеЛицоПолучателяПриИзменении(Элемент)
	ЗаполнитьФИОКОнтактногоЛица();
КонецПроцедуры

&НаСервере
Процедура ПроставитьТелефонОтправителя()
	Если ЗначениеЗаполнено(Объект.КонтактноеЛицоОтправителя.Телефон) тогда
		Объект.ТелефонОтправителя = Объект.КонтактноеЛицоОтправителя.Телефон;
	Иначе	
		Объект.ТелефонОтправителя = Объект.Отправитель.Телефон;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура КонтактноеЛицоОтправителяПриИзменении(Элемент)
	ПроставитьТелефонОтправителя();
КонецПроцедуры

