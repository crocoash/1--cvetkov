&НаСервере
Процедура ВыборКонтрагентаДоставки(ВыбранныйКОнтрагент)
	Объект.Получатель = ВыбранныйКОнтрагент;
	Объект.НаименованиеКонтрагента = ВыбранныйКОнтрагент.Наименование;
	Объект.ГородПолучателя = ВыбранныйКОнтрагент.Город;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_КонтактныеЛица.Ссылка,
	|	ЛМ_КонтактныеЛица.Фамилия,
	|	ЛМ_КонтактныеЛица.Отчество,
	|	ЛМ_КонтактныеЛица.Имя,
	|	ЛМ_КонтактныеЛица.Телефон
	|ИЗ
	|	Справочник.ЛМ_КонтактныеЛица КАК ЛМ_КонтактныеЛица
	|ГДЕ
	|	ЛМ_КонтактныеЛица.ПометкаУдаления = ЛОЖЬ
	|	И ЛМ_КонтактныеЛица.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", ВыбранныйКОнтрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.КонтактноеЛицоПолучателя = Выборка.Ссылка;
		Объект.ИмяПолучателя = Выборка.Имя;
		Объект.ФамилияПолучателя = Выборка.Фамилия;
		Объект.ОтчествоПолучателя = Выборка.Отчество;
		Объект.ТелефонПолучателя = Выборка.Телефон;
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьКонтрагентовДляОтбора()
	Если ЗначениеЗаполнено(Объект.ДокументОснование) тогда
		Если Объект.ДокументОснование.Метаданные().Реквизиты.Найти("Контрагент") <> Неопределено Тогда
			Если ЗначениеЗаполнено(Объект.ДокументОснование.Контрагент) Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ЛМ_КонтрагентыДоставки.КонтрагентДоставки
				|ИЗ
				|	РегистрСведений.ЛМ_КонтрагентыДоставки КАК ЛМ_КонтрагентыДоставки
				|ГДЕ
				|	ЛМ_КонтрагентыДоставки.Контрагент = &Контрагент";
				Запрос.УстановитьПараметр("Контрагент", Объект.ДокументОснование.Контрагент);
				Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонтрагентДоставки");
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
КонецФункции	

