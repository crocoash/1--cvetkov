&НаКлиенте
Процедура ОбъемПриИзменении(Элемент)
	Объект.ОбъемныйВес = Объект.Объем * 250;
	Если Объект.Ширина <> 0  и Объект.Длина <> 0 И Объект.Высота <> 0 Тогда
		ИсходныйОбъем = Объект.Ширина * Объект.Длина * Объект.Высота;
		Коэфф = Объект.Объем / ИсходныйОбъем;
		Объект.Ширина = Объект.Ширина * Коэфф;
		Объект.Длина = Объект.Длина * Коэфф;
		Объект.Высота = Объект.Высота * Коэфф;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОбъемныйВесПриИзменении(Элемент)
	Объект.Объем = Объект.ОбъемныйВес / 250;
	Если Объект.Ширина <> 0  и Объект.Длина <> 0 И Объект.Высота <> 0 Тогда
		ИсходныйОбъем = Объект.Ширина * Объект.Длина * Объект.Высота;
		Коэфф = Объект.Объем * 1000000 / ИсходныйОбъем;
		Объект.Ширина = Объект.Ширина * Коэфф;
		Объект.Длина = Объект.Длина * Коэфф;
		Объект.Высота = Объект.Высота * Коэфф;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ПараметрыГрузовОбъемПриИзменении(Элемент)
	ИсходныйОбъем = Элементы.ПараметрыГрузов.ТекущиеДанные.Ширина * Элементы.ПараметрыГрузов.ТекущиеДанные.Высота * Элементы.ПараметрыГрузов.ТекущиеДанные.Длина / 1000000;
	Коэфф = Элементы.ПараметрыГрузов.ТекущиеДанные.Объем / ИсходныйОбъем;
	Элементы.ПараметрыГрузов.ТекущиеДанные.Ширина = Коэфф * Элементы.ПараметрыГрузов.ТекущиеДанные.Ширина;
	Элементы.ПараметрыГрузов.ТекущиеДанные.Длина = Коэфф * Элементы.ПараметрыГрузов.ТекущиеДанные.Длина;
	Элементы.ПараметрыГрузов.ТекущиеДанные.Высота = Коэфф * Элементы.ПараметрыГрузов.ТекущиеДанные.Высота;
	
КонецПроцедуры

