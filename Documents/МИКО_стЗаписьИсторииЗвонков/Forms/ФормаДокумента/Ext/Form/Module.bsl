&НаСервере
// Начальное заполнение документа.
// 
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПараметрыАТС = ПолучитьПараметрыАТС(Объект.id_pbx);
	Хост		 = ПараметрыАТС.Получить("АдресСервера");
	Порт 		 = ПараметрыАТС.Получить("ПортСервера");
	
	Элементы.НаименованиеАТС.Заголовок = ПараметрыАТС.Получить("Наименование");
	
	Пропущен = (Объект.Пропущенный Или Объект.НетСоединений);
	
	// Получим системную информацию.
	СтруктураДанных = МИКО_стСлужебный.ПолучитьСлужебнуюИнформацию();
	ВерсияПлатформы = СтруктураДанных.ВерсияПлатформы;
	ИспользоватьРежимМодальности = СтруктураДанных.ИспользоватьРежимМодальности;
	
	// Видимость элементов формы.
	Элементы.Src_Владелец_Ссылка.Видимость = ЗначениеЗаполнено(Объект.Src_Владелец_Ссылка);
	Элементы.Dst_Владелец_Ссылка.Видимость = ЗначениеЗаполнено(Объект.Dst_Владелец_Ссылка);
	Элементы.Пропущен.Видимость            = Пропущен;
	Элементы.ОтвеченВВайбере.Видимость     = (Объект.ОтвеченВВайбере Или
											 (Пропущен И (Объект.Направление = Перечисления.МИКО_стВидыТелефонныхЗвонков.Входящий)));
    Элементы.Answer.Видимость              = (Не Пропущен И Не Объект.ОтвеченВВайбере);
	Элементы.ДеталиЗвонка.Видимость        = (Не Пропущен И Не Объект.ОтвеченВВайбере);
	
	ЭтоВнешнийВызов = Объект.Направление <> Перечисления.МИКО_стВидыТелефонныхЗвонков.Внутренний;
	Элементы.OutLine.Видимость 		= ЭтоВнешнийВызов;
	Элементы.Регион.Видимость  		= ЭтоВнешнийВызов;
	
	Элементы.ПропустившиеЗвонок.Видимость = Объект.CDR_ПропустившиеЗвонок.Количество()>0;
	ЭтаФорма.Заголовок = "" + Объект.Направление + " вызов от " + Формат(Объект.Дата, "ДЛФ=DDT");
	
	Если Объект.Направление = Перечисления.МИКО_стВидыТелефонныхЗвонков.Входящий Тогда
		Элементы.Пропущен.Заголовок = "Пропущен";
	Иначе	
		Элементы.Пропущен.Заголовок = "Не дозвонились";	
	КонецЕсли; 
	
	Попытка
		Элементы.грПрочиеКоманды.Видимость = (ИмяПользователя()="") ИЛИ РольДоступна("МИКО_стРедактированиеИсторииЗвонков") ИЛИ РольДоступна("ПолныеПрава");
	Исключение
	КонецПопытки; 
	
	// Видимость элементов формы
	ПанельТелефонииЕсть = Метаданные.Обработки.Найти("МИКО_ПанельТелефонииДля1С")<>Неопределено;
	Элементы.ФормадПрослушатьЗапись.Видимость 	= ПанельТелефонииЕсть;
	Элементы.ФормадСкачатьЗапись.Видимость 		= ПанельТелефонииЕсть;
	Элементы.Позвонить.Видимость 				=(ПанельТелефонииЕсть И ЭтоВнешнийВызов);
	Элементы.ПозвонитьDst.Видимость 			=(ПанельТелефонииЕсть И ЭтоВнешнийВызов);
	Элементы.ПозвонитьSrc.Видимость 			=(ПанельТелефонииЕсть И ЭтоВнешнийВызов);
	
	СтанцияMyPBX = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.СтанцияMyPBX();
КонецПроцедуры

// Определяем параметры АТС
//
Функция ПолучитьПараметрыАТС(id_pbx)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИКО_ДополнительныеАТС.АдресСервера,
		|	МИКО_ДополнительныеАТС.ПортСервера,
		|	МИКО_ДополнительныеАТС.РесурсCDR,
		|	МИКО_ДополнительныеАТС.РесурсCEL,
		|	МИКО_ДополнительныеАТС.Наименование
		|ИЗ
		|	Справочник.МИКО_ДополнительныеАТС КАК МИКО_ДополнительныеАТС
		|ГДЕ
		|	МИКО_ДополнительныеАТС.id_pbx = &id_pbx";
	
	Запрос.УстановитьПараметр("id_pbx", id_pbx);	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ПараметрыАТС = Новый Соответствие;
		ПараметрыАТС.Вставить("Наименование", "Основная АТС");
		ПараметрыАТС.Вставить("РесурсCDR",    ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.РесурсCDR());
		ПараметрыАТС.Вставить("АдресСервера", ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.АдресСервера()); 
		ПараметрыАТС.Вставить("ПортСервера",  ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПортСервера()); 		
	    ПараметрыАТС.Вставить("РесурсCEL",    ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.РесурсCEL());
	Иначе
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ПараметрыАТС = Новый Соответствие;
			ПараметрыАТС.Вставить("Наименование", ВыборкаДетальныеЗаписи.Наименование);
			ПараметрыАТС.Вставить("РесурсCDR",    ВыборкаДетальныеЗаписи.РесурсCDR);
			ПараметрыАТС.Вставить("АдресСервера", ВыборкаДетальныеЗаписи.АдресСервера); 
			ПараметрыАТС.Вставить("ПортСервера",  ВыборкаДетальныеЗаписи.ПортСервера); 		
		    ПараметрыАТС.Вставить("РесурсCEL",    ВыборкаДетальныеЗаписи.РесурсCEL);
		КонецЦикла;
	
	КонецЕсли; 
		
	Возврат ПараметрыАТС;
КонецФункции

&НаКлиенте
// Обработка взаимодействия с прочими внешними модулями.
//
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если "ОповеститьЖЗ_ЗаписьРазговора" = ИмяСобытия Тогда	
		Если ОжидаемЗапись = Истина Тогда
			ОжидаемЗапись = Ложь;
			врЭлемент = ?(Параметр.ТипОперации = "СкачатьЗапись", Элементы.ФормадСкачатьЗапись, Элементы.ФормадПрослушатьЗапись);
			Если ВерсияПлатформы = "8.3" Тогда
				ОписаниеОповещения = Вычислить("Новый ОписаниеОповещения(""ОбработкаВыбораФайлаЗаписи"", ЭтаФорма, Параметр)");
				Попытка
					Выполнить("ПоказатьВыборИзМеню(ОписаниеОповещения,Параметр.спИменаФайлов, врЭлемент)");
				Исключение
					Возврат;
				КонецПопытки; 
			Иначе	
				Попытка
					врЗначение = Вычислить("ВыбратьИзМеню(Параметр.спИменаФайлов, врЭлемент)");	
				Исключение
				   	// 
					Возврат;
				КонецПопытки; 
				ОбработкаВыбораФайлаЗаписи(врЗначение, Параметр)
			КонецЕсли;
		КонецЕсли; 
	ИначеЕсли "PT1C_NewOutLine" = ИмяСобытия И Параметр <> Объект.OutLine Тогда	
		Объект.OutLine = Параметр;
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
// Запуск обратного звонка для воспроизведения файла.
// 
Процедура дПрослушатьЗапись(Команда)

	ИмяФайлаЗаписиРазговора = Объект.recordingfile; 
	
	СтруктураДанных = Новый Структура("ИмяФайла, ИдентификаторЗвонка", ИмяФайлаЗаписиРазговора, ?(СтанцияMyPBX, Объект.recordingfile, Объект.linkedid));
	
	// Найдем в какой глобальной переменной определена панель телефонии.
	Miko_Ajam 		= МИКО_стОбщегоНазначенияКлиент.ПолучитьОбъектПанелиТелефонииОб();
	сфпФормаТелефон = МИКО_стОбщегоНазначенияКлиент.ПолучитьОбъектПанелиТелефонииУп();
	
	Если сфпФормаТелефон <> Неопределено Тогда
		ОжидаемЗапись = Истина;
		Оповестить("ВоспроизвестиЗапись", СтруктураДанных.ИдентификаторЗвонка, ЭтаФорма);
	ИначеЕсли Miko_Ajam	<> Неопределено Тогда
		Попытка
			Miko_Ajam.ПрослушатьЗаписьРазговора(СтруктураДанных.ИдентификаторЗвонка);
		Исключение
			// 	
		КонецПопытки;
	Иначе
		МИКО_стОбщегоНазначенияКлиент.СообщитьПользователю("Панель телефонии не подключена! Нет возможности прослушать запись.");	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
// Запуск процесса скачивания файла записи 
//
Процедура дСкачатьЗапись(Команда)
	
	ИмяФайлаЗаписиРазговора = Объект.recordingfile;
	
	СтруктураДанных = Новый Структура("ИмяФайла, ИдентификаторЗвонка", ИмяФайлаЗаписиРазговора, ?(СтанцияMyPBX, Объект.recordingfile, Объект.linkedid));
	
	// Найдем в какой глобальной переменной определена панель телефонии.
	Miko_Ajam 		= МИКО_стОбщегоНазначенияКлиент.ПолучитьОбъектПанелиТелефонииОб();
	сфпФормаТелефон = МИКО_стОбщегоНазначенияКлиент.ПолучитьОбъектПанелиТелефонииУп();
	
	Если сфпФормаТелефон <> Неопределено Тогда
		ОжидаемЗапись = Истина;
		Если СтанцияMyPBX Тогда
			врПараметры = Новый Структура("filename,fpath",СтруктураДанных.ИдентификаторЗвонка,"");
			Оповестить("СкачатьЗаписьПоИмениФайла", врПараметры, ЭтаФорма);
		Иначе	
			Оповестить("СкачатьЗапись", СтруктураДанных.ИдентификаторЗвонка, ЭтаФорма);
		КонецЕсли;
	ИначеЕсли Miko_Ajam	<> Неопределено Тогда
		Попытка
			Miko_Ajam.СкачатьЗаписьРазговора(СтруктураДанных);
		Исключение
			// 	
		КонецПопытки;
	Иначе
		МИКО_стОбщегоНазначенияКлиент.СообщитьПользователю("Нет возможности скачать запись.");	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура Позвонить(Команда)
	Вызов = Новый Структура("НомерТелефона,Партнер,Абонент,Входящий,ЕстьЗапись,recordingfile");
	Если ЗаполнитьПоДокументуИсторииЗвонков(Вызов, Объект.Ссылка) = Ложь Тогда
		// Внутренний вызов.
		Возврат;
	КонецЕсли;
	// Найдем в какой глобальной переменной определена панель телефонии.
	
	Miko_Ajam 		= МИКО_стОбщегоНазначенияКлиент.ПолучитьОбъектПанелиТелефонииОб();
	
	Если Miko_Ajam <> Неопределено Тогда
		Miko_Ajam.НабратьНомер(Вызов.НомерТелефона);	
	Иначе
		врДанные = Новый Структура("ОснованиеЗвонка", Объект.Ссылка);
		Оповестить("Позвонить", Вызов.НомерТелефона, врДанные);
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ПозвонитьПоНомеру(Команда)
	
	врИмяПоля = СтрЗаменить(Команда.Имя, "Позвонить", "");
	Вызов = Новый Структура("НомерТелефона", Объект[врИмяПоля]);
	
	Если НЕ ЗначениеЗаполнено(Вызов.НомерТелефона) Тогда
	   	Возврат;
	КонецЕсли; 
	
	Miko_Ajam 		= МИКО_стОбщегоНазначенияКлиент.ПолучитьОбъектПанелиТелефонииОб();
	
	Если Miko_Ajam <> Неопределено Тогда
		Miko_Ajam.НабратьНомер(Вызов.НомерТелефона);	
	Иначе
		врДанные = Новый Структура("ОснованиеЗвонка", Объект.Ссылка);
		Оповестить("Позвонить", Вызов.НомерТелефона, врДанные);
	КонецЕсли; 
	
КонецПроцедуры

&НаСервереБезКонтекста
// Вспомогательная функция, получает данные по документу "МИКО_стЗаписьИсторииЗвонков".
// 
Функция ЗаполнитьПоДокументуИсторииЗвонков(Вызов, СсылкаНаДокумент)
	Если СсылкаНаДокумент.Направление = ПредопределенноеЗначение("Перечисление.МИКО_стВидыТелефонныхЗвонков.Внутренний") Тогда
		Возврат Ложь;	
	ИначеЕсли СсылкаНаДокумент.Направление = ПредопределенноеЗначение("Перечисление.МИКО_стВидыТелефонныхЗвонков.Входящий") Тогда
		врДанные = МИКО_стОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, "Src_Владелец_Ссылка,Src_Ссылка,Src");
		Партнер				= врДанные.Src_Владелец_Ссылка;	
		Абонент 			= врДанные.Src_Ссылка;
		Вызов.НомерТелефона = врДанные.Src;
		Вызов.Входящий 		= Истина;
	ИначеЕсли СсылкаНаДокумент.Направление = ПредопределенноеЗначение("Перечисление.МИКО_стВидыТелефонныхЗвонков.Исходящий") Тогда
		врДанные = МИКО_стОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, "Dst_Владелец_Ссылка,Dst_Ссылка,Dst");
		Партнер 			= врДанные.Dst_Владелец_Ссылка;	
		Абонент 			= врДанные.Dst_Ссылка;
		Вызов.НомерТелефона = врДанные.Dst;
		Вызов.Входящий 		= Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Партнер) Тогда
		Вызов.Партнер = Партнер;	
		Вызов.Абонент = Абонент;	
	Иначе
		Вызов.Партнер = Абонент;	
	КонецЕсли;
	
	РезульатЗапроса = МИКО_стОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаДокумент, "ИменаФайлов");
	Если НЕ РезульатЗапроса.Пустой() Тогда
		ИменаФайлов 		= РезульатЗапроса.Выгрузить();
		Вызов.ЕстьЗапись 	= Истина;
		Вызов.recordingfile = ИменаФайлов[0].ИмяФайла;
	Иначе	
		Вызов.ЕстьЗапись    = Ложь;
		Вызов.recordingfile = "";
	КонецЕсли; 
	
	Возврат Истина;	
КонецФункции


&НаКлиенте
// Открытие выбранного документа "Событие".
// 
Процедура ДокументыСобытиеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СобытиеСсылка = Элемент.ТекущиеДанные.Событие;
		
	Если ВерсияПлатформы = "8.3" Тогда
		
		Если НЕ ИспользоватьРежимМодальности Тогда
		
			Попытка
				Выполнить("ПоказатьЗначение(,СобытиеСсылка)");
			Исключение
				Возврат;
			КонецПопытки; 
	
		Иначе	
			ОткрытьЗначение(СобытиеСсылка);
		КонецЕсли; 
		
	ИначеЕсли ВерсияПлатформы = "8.2" Тогда
		ОткрытьЗначение(СобытиеСсылка);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
// Подготовить данные для отладки.
// 
Процедура ВывестиДанныеДляОтладки(Команда)
	ТекстОтладки = ПодготовитьДанныеДляОтладки(Объект.Номер);
	
	ТД = Новый ТекстовыйДокумент;
	ТД.УстановитьТекст(ТекстОтладки);
	ТД.Показать();
КонецПроцедуры

&НаСервере
// Подготовить данные для отладки на сервере.
//
Функция ПодготовитьДанныеДляОтладки(UID)

	Если СтанцияMyPBX Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ *
			|ИЗ
			|	РегистрСведений.МИКО_стMyPBX_Asteriskcdr КАК МИКО_стИсторияЗвонковCDR
			|ГДЕ
			|	МИКО_стИсторияЗвонковCDR.uniqueid_pt1c = &UID";
	    Запрос.УстановитьПараметр("UID",UID);
		CDR = Запрос.Выполнить().Выгрузить();

		Данные = Новый Структура("CDR",CDR);
		Возврат ЗначениеВСтрокуВнутр(Данные);
	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ *
		|ИЗ
		|	РегистрСведений.МИКО_стИсторияЗвонковCDR КАК МИКО_стИсторияЗвонковCDR
		|ГДЕ
		|	МИКО_стИсторияЗвонковCDR.UID = &UID";
    Запрос.УстановитьПараметр("UID",UID);
	CDR = Запрос.Выполнить().Выгрузить();

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ *
		|ИЗ
		|	РегистрСведений.МИКО_стИсторияЗвонковCEL КАК МИКО_стИсторияЗвонковCEL
		|ГДЕ
		|	МИКО_стИсторияЗвонковCEL.UID = &UID";
    Запрос.УстановитьПараметр("UID",UID);
	CEL = Запрос.Выполнить().Выгрузить();

	Данные = Новый Структура("CDR,CEL",CDR,CEL);
	Возврат ЗначениеВСтрокуВнутр(Данные);
	
КонецФункции // ПодготовитьДанныеДляОтладки()

&НаКлиенте
// Обработка выбора имени файла из списка для прослушивания / скачивания.
// Параметры:
//   ВыбранныйЭлемент - Имя файла записи
//   врПараметры - Дополнительные параметры.
//
Процедура ОбработкаВыбораФайлаЗаписи(ВыбранныйЭлемент, врПараметры) Экспорт 
    Если ВыбранныйЭлемент = Неопределено  Тогда
	 	Возврат;
	КонецЕсли; 
	
	Если врПараметры.ТипОперации = "СкачатьЗапись" Тогда
		врПараметры = Новый Структура("filename,fpath",ВыбранныйЭлемент.Значение,врПараметры.ДопПараметры);
		Оповестить("СкачатьЗаписьПоИмениФайла", врПараметры, ЭтаФорма);		
	ИначеЕсли врПараметры.ТипОперации = "ВоспроизвестиЗапись" Тогда
		Оповестить("ВоспроизвестиЗаписьПоИмениФайла", ВыбранныйЭлемент.Значение, ЭтаФорма); 
	КонецЕсли; 	
КонецПроцедуры // ОбработкаВыбораФайлаЗаписи()


&НаКлиенте
Процедура ЗагрузитьПовторно(Команда)
	ЗагрузитьПовторноСервер();
КонецПроцедуры

// Повторная загрузка документа.
//
&НаСервере
Процедура ЗагрузитьПовторноСервер()
		
	МассивUID = Новый Массив;
	МассивUID.Добавить(Объект.Номер);
	мод_стЗагрузкаИсторииЗвонков_v7 = Вычислить("МИКО_стЗагрузкаИсторииЗвонков_v7");
	
	Если СтанцияMyPBX Тогда
		ДанныеИзБазы = мод_стЗагрузкаИсторииЗвонков_v7.ПолучитьДанныеЗвонковCDR_Autorecord_MyPBX(МассивUID, МассивUID);
		мод_стЗагрузкаИсторииЗвонков_v7.ЗаполнитьОбработатьИсториюЗвонковCDR_MyPBX(Объект.Номер, ДанныеИзБазы);
	Иначе
		ДанныеИзБазы = мод_стЗагрузкаИсторииЗвонков_v7.ПолучитьДанныеЗвонковCEL_CDR(МассивUID, Объект.id_pbx);
		Если ДанныеИзБазы.ТабAskozia.Количество()>0 Тогда
			мод_стЗагрузкаИсторииЗвонков_v7.СформироватьДокументыИсторииAskozia(МассивUID, ДанныеИзБазы);
		Иначе
			мод_стЗагрузкаИсторииЗвонков_v7.ЗаполнитьОбработатьИсториюЗвонковПоUID(Объект.Номер, ДанныеИзБазы);
		КонецЕсли;
	КонецЕсли;

	врОбъект = Объект.Ссылка.ПолучитьОбъект();
	ЗначениеВРеквизитФормы(врОбъект, "Объект");
	
КонецПроцедуры // ЗагрузитьПовторно()

