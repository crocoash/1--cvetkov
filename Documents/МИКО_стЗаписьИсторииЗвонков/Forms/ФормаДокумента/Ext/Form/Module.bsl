// Поиск в записях докумнта истории идентификатора линии.
// 
&НаКлиенте
Процедура НайтиIDЛиний(Команда)
	
	врПараметры = Новый Структура("UID,OutLine,Направление", Объект.Номер, Объект.OutLine, Объект.Направление);	
	ОткрытьФорму("Справочник.МИКО_стУчетныеЗаписиАТС.Форма.ПомощникОписанияВнешнейЛинии", врПараметры, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОтвеченВВайбереПриИзменении(Элемент)
	
	Пропущен = Не Объект.ОтвеченВВайбере;
	
	Объект.Пропущенный   = Пропущен;
	Объект.НетСоединений = Пропущен;
	
	Элементы.Пропущен.Видимость = Пропущен;
	
	Записать();
	
КонецПроцедуры
 


