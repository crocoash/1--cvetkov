// #Область СлужебныеПроцедурыИФункции

// Заполнение информации по клиентам.
// 
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ЗначениеЗаполнено(Src_Ссылка) Тогда
		врДанные = Новый Структура("Владелец");		
		ЗаполнитьЗначенияСвойств(врДанные, Src_Ссылка);
	    Если ЗначениеЗаполнено(врДанные.Владелец) Тогда
		  	Src_Владелец_Ссылка = врДанные.Владелец;                   
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Src_Владелец_Ссылка) Тогда
			ДанныеАбонента = МИКО_опЗаписьКИ.НайтиКлиентаПоНомеруТелефона(Src);
			Если ТипЗнч(ДанныеАбонента) = Тип("Массив") Тогда
				ДанныеАбонента= ДанныеАбонента[0];
			КонецЕсли;
			Если НЕ ДанныеАбонента = Неопределено
				И ЗначениеЗаполнено(ДанныеАбонента.Партнер)
				И ЗначениеЗаполнено(ДанныеАбонента.Абонент)
				И Src_Ссылка = ДанныеАбонента.Абонент
				И НЕ ДанныеАбонента.Партнер = ДанныеАбонента.Абонент Тогда
			
				Src_Владелец_Ссылка = ДанныеАбонента.Партнер;
			
			КонецЕсли; 
		КонецЕсли; 
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Dst_Ссылка) Тогда
		врДанные = Новый Структура("Владелец");		
		ЗаполнитьЗначенияСвойств(врДанные, Dst_Ссылка);
	    Если ЗначениеЗаполнено(врДанные.Владелец) Тогда
		  	Dst_Владелец_Ссылка = врДанные.Владелец;                   
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Dst_Владелец_Ссылка) Тогда
			ДанныеАбонента = МИКО_опЗаписьКИ.НайтиКлиентаПоНомеруТелефона(Dst);
			Если ТипЗнч(ДанныеАбонента) = Тип("Массив") Тогда
				ДанныеАбонента= ДанныеАбонента[0];
			КонецЕсли;
			Если НЕ ДанныеАбонента = Неопределено
				И ЗначениеЗаполнено(ДанныеАбонента.Партнер)
				И ЗначениеЗаполнено(ДанныеАбонента.Абонент)
				И Dst_Ссылка = ДанныеАбонента.Абонент
				И НЕ ДанныеАбонента.Партнер = ДанныеАбонента.Абонент Тогда
				
				Dst_Владелец_Ссылка = ДанныеАбонента.Партнер;
			
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли; 
	
	
	
	ЕстьЗапись = (ИменаФайлов.Количество()>0);

	СоздатьЗадачуПоПропущенномуВызову();

КонецПроцедуры

// Создает одну активную задачу на группу пользователей "Менеджеры" по пропущенному
// входящему звонку. Повторная запись того же документа задачу не дублирует -
// наличие уже созданной (невыполненной) задачи проверяется через ОбщегоНазначения.ЕстьЗадачаЗаказа().
//
Процедура СоздатьЗадачуПоПропущенномуВызову()

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Только для новых звонков: документ может перезаписываться позже (привязка владельца,
	// связь с "Событие"), но статус "Пропущенный" уже известен на момент первой записи.
	Если НЕ ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;

	Если Направление <> Перечисления.МИКО_стВидыТелефонныхЗвонков.Входящий
		ИЛИ НЕ Пропущенный
		ИЛИ ЛожныйЗвонок Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(ОбщегоНазначения.ЕстьЗадачаЗаказа(Ссылка, "Пропущенный вызов")) Тогда
		Возврат;
	КонецЕсли;

	ГруппаМенеджеры = Справочники.Пользователи.НайтиПоНаименованию("Менеджеры", Истина);
	Если НЕ ЗначениеЗаполнено(ГруппаМенеджеры) ИЛИ НЕ ГруппаМенеджеры.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Src_Ссылка) Тогда
		ПредставлениеЗвонящего = Строка(Src_Ссылка);
	Иначе
		ПредставлениеЗвонящего = Src;
	КонецЕсли;

	Описание = "Пропущенный входящий вызов от " + ПредставлениеЗвонящего
		+ " (" + Формат(Дата, "ДЛФ=DDT") + ")." + Символы.ПС + "Требуется перезвонить клиенту.";

	ОбщегоНазначения.СоздатьЗадачуНаПользователя(Ссылка, "Пропущенный вызов", Описание, ГруппаМенеджеры, Истина);

КонецПроцедуры

// #КонецОбласти 