
Функция СоздатьДокументПрограмно(
	Заказ,
	Сумма,
	Счет,
	ВхНомер = Неопределено
) Экспорт
	
	// Проверяем, не создан ли уже платеж по этому заказу
	// с таким входящим номером.
	Если ЗначениеЗаполнено(ВхНомер) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПлатежноеПоручениеВходящее.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
		|ГДЕ
		|	ПлатежноеПоручениеВходящее.ДокументОснование = &ДокументОснование
		|	И ПлатежноеПоручениеВходящее.НомерВходящегоДокумента = &ВходящийНомер
		|	И НЕ ПлатежноеПоручениеВходящее.ПометкаУдаления";
		
		Запрос.УстановитьПараметр(
			"ДокументОснование",
			Заказ
		);
		
		Запрос.УстановитьПараметр(
			"ВходящийНомер",
			ВхНомер
		);
		
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Сообщить(
				"Платеж с входящим номером """ 
				+ Строка(ВхНомер)
				+ """ по этому заказу уже создан: "
				+ Строка(Выборка.Ссылка)
			);
			
			//ФормаСуществующегоДокумента =
			//	Документы.ПлатежноеПоручениеВходящее.ПолучитьФорму(
			//		"ФормаДокумента",
			//		Выборка.Ссылка
			//	);
			//
			//ФормаСуществующегоДокумента.ОткрытьМодально();
			
			Возврат "";
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Контрагент = Заказ.Контрагент;
	ДоговорКонтрагента = Заказ.ДоговорКонтрагента;
	
	Док = Документы.ПлатежноеПоручениеВходящее.ПолучитьФорму(
		"ФормаДокумента"
	);
	
	Док.ДокументОснование = Заказ;
	Док.ДатаВходящегоДокумента = ТекущаяДата();
	
	Док.Организация = Заказ.Организация;
	Док.СчетОрганизации = Счет;
	
	Если ЗначениеЗаполнено(ВхНомер) Тогда
		
		Док.НомерВходящегоДокумента = ВхНомер;
		
	КонецЕсли;
	
	Док.Контрагент = Контрагент;
	Док.ДоговорКонтрагента = ДоговорКонтрагента;
	
	Док.ВидОперации =
		Перечисления.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.
		ОплатаПокупателя;
	
	Док.СуммаДокумента = Сумма;
	Док.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду(980);
	
	Док.Оплачено = Истина;
	Док.ДатаОплаты = ТекущаяДата();
	Док.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	
	Док.ОтражатьВУправленческомУчете = Истина;
	
	Док.СчетУчетаРасчетовСКонтрагентом =
		ПланыСчетов.Хозрасчетный.
		РасчетыСОтечественнымиПокупателями;
	
	Док.СчетБанк =
		ПланыСчетов.Хозрасчетный.
		ТекущиеСчетаВНациональнойВалюте;
	
	Док.Подразделение = Заказ.Подразделение;
	
	
	// Расшифровка платежа
	Док.РасшифровкаПлатежа.Очистить();
	
	СтрТЧ = Док.РасшифровкаПлатежа.Добавить();
	
	СтрТЧ.ДоговорКонтрагента = ДоговорКонтрагента;
	СтрТЧ.Сделка = Заказ;
	
	СтруктураКурсаВзаиморасчетов =
		МодульВалютногоУчета.ПолучитьКурсВалюты(
			ДоговорКонтрагента.ВалютаВзаиморасчетов,
			ТекущаяДата()
		);
	
	СтрТЧ.КурсВзаиморасчетов =
		СтруктураКурсаВзаиморасчетов.Курс;
	
	СтрТЧ.СуммаВзаиморасчетов = Сумма;
	СтрТЧ.СуммаПлатежа = Сумма;
	
	СтрТЧ.СтатьяДвиженияДенежныхСредств =
		Справочники.СтатьиДвиженияДенежныхСредств.
		ОплатаПокупателя;
	
	
	Док.Дата = ТекущаяДата();
	
	Док.ОткрытьМодально();
	
	Возврат Док;
	
КонецФункции

Функция СоздатьДок(Заказ, Сумма, Счет) Экспорт
	
	Контрагент = Заказ.Контрагент;
	ДоговорКонтрагента = Заказ.ДоговорКонтрагента;
	
	
	Док = Документы.ПлатежноеПоручениеВходящее.ПолучитьФорму("ФормаДокумента");
		
	Док.ДокументОснование       = Заказ;
	Док.ДатаВходящегоДокумента  = ТекущаяДата();

	Док.Организация             = Заказ.Организация;
	Док.СчетОрганизации         = Счет;

	Док.Контрагент              = Контрагент;
	Док.ДоговорКонтрагента      = ДоговорКонтрагента;
	Док.ВидОперации             = Перечисления.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ОплатаПокупателя;
	
	Док.СуммаДокумента          = Сумма; //ИнформацияОВыставленомПлатеже
	Док.ВалютаДокумента         = Справочники.Валюты.НайтиПоКоду(980);
	Док.Оплачено                = Истина;
	Док.ДатаОплаты              = ТекущаяДата();
	Док.Ответственный           = ПараметрыСеанса.ТекущийПользователь;
	Док.ОтражатьВУправленческомУчете = Истина;
	Док.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.РасчетыСОтечественнымиПокупателями;
	Док.СчетБанк                = ПланыСчетов.Хозрасчетный.ТекущиеСчетаВНациональнойВалюте;
	Док.Подразделение           = Заказ.Подразделение; 
	
	
	
	//Расшифровка дока=====================================================================================
	
	Док.РасшифровкаПлатежа.Очистить();
	СтрТЧ = Док.РасшифровкаПлатежа.Добавить();
	СтрТЧ.ДоговорКонтрагента = ДоговорКонтрагента;
	СтрТЧ.Сделка             = Заказ;

	
	СтруктураКурсаВзаиморасчетов = МодульВалютногоУчета.ПолучитьКурсВалюты(ДоговорКонтрагента.ВалютаВзаиморасчетов, ТекущаяДата());
	СтрТЧ.КурсВзаиморасчетов     = СтруктураКурсаВзаиморасчетов.Курс;			
	СтрТЧ.СуммаВзаиморасчетов    = Сумма;
	
	СтрТЧ.СуммаПлатежа =           Сумма; // минус ;		
	СтрТЧ.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПокупателя;

	//===================================================================================================
	
	Док.Дата = ТекущаяДата();
		
	Возврат Док;
	
КонецФункции