Функция УбратьНоликиСлева(СтрокаСНоликами) Экспорт 
	Ф=0;  НоваяСтрока = "";
	Для Сч = 1 По СтрДлина(СтрокаСНоликами) Цикл 
		Символ = Сред(СтрокаСНоликами,Сч,1);
		Если  НЕ Символ = "0" и Ф=0 Тогда
			//первый ненулевой символ
			Ф=1
		КонецЕсли;
		Если Ф=1 Тогда
			//дальше берем все и нолики тоже
			НоваяСтрока = НоваяСтрока+Символ
		КонецЕсли;
	КонецЦикла;
	Возврат НоваяСтрока
КонецФункции


Функция КонтактнаяИнформация(Об,Тип,Вид) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтактнаяИнформация.Представление
	               |ИЗ
	               |	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Тип = &Тип
	               |	И КонтактнаяИнформация.Вид = &Вид
	               |	И КонтактнаяИнформация.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект",Об);
	Запрос.УстановитьПараметр("Тип",Тип);
	Запрос.УстановитьПараметр("Вид",Вид);
    Рез = Запрос.Выполнить().Выгрузить();
	
	Если Рез.Количество()>0 Тогда
		Возврат Рез[0].Представление;
	Иначе
		Возврат ""
	КонецЕсли;
КонецФункции

Функция ЕстьСкидка()
	Есть = ЛОжь;
	Для Каждого Стр Из Товары Цикл
		Если НЕ Стр.Сумма=Стр.Цена*Стр.Количество Тогда
			Есть = Истина;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из Товары1 Цикл
		Если НЕ Стр.Сумма=Стр.Цена*Стр.Количество Тогда
			Есть = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Есть;
КонецФункции

Процедура ЗаполнитьПоРезервуЗаказа() Экспорт 
	
	Товары.Очистить();
	МассивСкл = Новый Массив;
	Если ЗначениеЗаполнено(Склад) ТОгда  //по складу реализации
		МассивСкл.Добавить(Склад);
	ИначеЕсли ТипЗнч(Сделка.СкладГруппа) = Тип("СправочникСсылка.ГруппыДоступностиСкладов") Тогда  //по группе скл заказа
		Запрос = Новый  Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СоставГруппДоступностиСкладов.Склад
		               |ИЗ
		               |	РегистрСведений.СоставГруппДоступностиСкладов КАК СоставГруппДоступностиСкладов
		               |ГДЕ
		               |	СоставГруппДоступностиСкладов.ГруппаДоступности = &ГруппаДоступности";
					   
		Запрос.УстановитьПараметр("ГруппаДоступности",Сделка.СкладГруппа);
		Рез = Запрос.Выполнить().Выгрузить();
		МассивСкл = Рез.ВыгрузитьКолонку("Склад");
	ИначеЕсли ЗначениеЗаполнено(Сделка.СкладГруппа) ТОгда  //по складу заказа
		МассивСкл.Добавить(Сделка.СкладГруппа);
	КонецЕсли;
	ЗаполнитьРезерв(МассивСкл);
КонецПроцедуры

Процедура ЗаполнитьРезерв(МасСкл) Экспорт 
	
	Если Сделка = Неопределено ТОгда
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(Сделка)Тогда
		Возврат;
	КонецЕсли;
	//заполняем по основному заказу
	Если ЗначениеЗаполнено(Сделка.ОсновнойЗаказ) Тогда
		Зак = Сделка.ОсновнойЗаказ;
	Иначе
		Зак = Сделка;
	КонецЕсли;
	
	Запрос  = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
	               |	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад,
	               |	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК Количество,
	               |	ТоварыВРезервеНаСкладахОстатки.НК КАК НК
	               |ИЗ
	               |	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеНаСкладахОстатки
	               |ГДЕ
	               |	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва = &ДокументРезерва
	               |	И (ТоварыВРезервеНаСкладахОстатки.Склад В (&Склады)
	               |			ИЛИ &СкладыВыбраны)";
	Запрос.УстановитьПараметр("ДокументРезерва",Зак);
	Запрос.УстановитьПараметр("Склады",МасСкл);
	Запрос.УстановитьПараметр("СкладыВыбраны",?(МасСкл.Количество()=0,Истина,ЛОжь));
	
	Рез = Запрос.Выполнить().Выгрузить();
	Рез.Сортировать("Номенклатура");	
	ДЛя Каждого Стр Из Рез Цикл
		НС = Товары.Добавить();
		НайденаНоменклатураЗаказа = Сделка.Товары.НайтиСтроки(Новый Структура ("Номенклатура,ХарактеристикаНоменклатуры",Стр.Номенклатура,Стр.ХарактеристикаНоменклатуры));
		Если НайденаНоменклатураЗаказа.Количество()>0 Тогда
			ЗаполнитьЗначенияСвойств(НС,НайденаНоменклатураЗаказа[0]);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НС,Стр);
		Если ЗначениеЗаполнено(Стр.НК) Тогда
			НайденНК = Сделка.Товары.Найти(Стр.НК,"ХарактеристикаНоменклатуры");
			Если НЕ НайденНК = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(НС,НайденНК,,"Номенклатура,ХарактеристикаНоменклатуры");
				//Комплектующие = ОбщегоНазначения.Комплектующие_НК(Стр.НК);
				//Кол = Комплектующие.Количество();
				//Если Кол>0 Тогда
				//	НС.Цена = НайденНК.Цена/Кол;
				//Иначе
				//	НС.Цена = НайденНК.Цена;
				//КонецЕсли;
				пТипЦен = ТипЦен;
				//Скидка  = 0;
			
				Если ТипЦен.Код = "000000001" И
					 НайденНК.Номенклатура.ВидНоменклатуры.ТипНоменклатуры <> Перечисления.ТипыНоменклатуры.Комплект Тогда
					
					пТипЦен = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000014");
					
				КонецЕсли;
				
				
				//Скидка = НайденНК.ПроцентСкидкиНаценки + НайденНК.ПроцентАвтоматическихСкидок;
				
				ЦенаБС = Ценообразование.ПолучитьЦенуНоменклатуры(
																  Стр.Номенклатура,
																  Стр.ХарактеристикаНоменклатуры,
																  пТипЦен,
																  Зак.Дата,
																  Стр.Номенклатура.ЕдиницаХраненияОстатков,
																  ВалютаДокумента,
																  КурсВзаиморасчетов,
																  КратностьВзаиморасчетов,
																  ,
																  ДоговорКонтрагента);
				
				//НС.Цена = ЦенаБС * (1 - Скидка / 100);
				НС.Цена = ЦенаБС;
				
			КонецЕсли;
			
			НС.ЕдиницаИзмерения = Стр.Номенклатура.ЕдиницаДляОтчетов;
			
		КонецЕсли;
		НС.Количество = Стр.Количество;
		//НС.Сумма = НС.Количество*НС.Цена;
		НС.СпособСписанияОстаткаТоваров = Перечисления.СпособыСписанияОстаткаТоваров.ИзРезерва;
		НС.ЗаказПокупателя = Сделка;
		НС.Коэффициент=1;
		
		ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НС, ЭтотОбъект,,Истина);
		ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НС, ЭтотОбъект);
		
	КонецЦикла;
	Товары.Сортировать("Номенклатура,ХарактеристикаНоменклатуры")
	
КонецПроцедуры

// Функция формирует табличный документ с печатной формой накладной,
// разработанной методистами
//
// Возвращаемое значение:
//  Табличный документ - печатная форма накладной
//
Функция ПечатьДокумента(ЗаполнятьГиперссылки = Ложь) Экспорт
	
	Если ЗаполнятьГиперссылки Тогда
		
		СтруктураПараметров = Новый Структура("ТабДок, НомерКолонки, Гиперссылки");
		
		Гиперссылки = Новый Соответствие;
		
	КонецЕсли;
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_РеализацияТоваровУслуг_РН_" + СокрЛП(ИмяКомпьютера());
	
	Если Контрагент.ВыводитьВРНПодробноеОписание Тогда	
		Макет = ПолучитьМакет("НакладнаяНовПодробно");	
	Иначе		
		Макет = ПолучитьМакет("НакладнаяНов");		
	КонецЕсли;
	
	// печать производится на языке, указанном в настройках пользователя
	КодЯзыкаПечать = Локализация.ПолучитьЯзыкФормированияПечатныхФорм(УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(глЗначениеПеременной("глТекущийПользователь"), "РежимФормированияПечатныхФорм"));
	
	Макет.КодЯзыкаМакета = КодЯзыкаПечать;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка1");

	
	ОбластьМакета.Параметры.Заголовок = "Расходная накладная №" + УбратьНоликиСлева(Номер) + " от " + Формат(Дата, "ДЛФ=DD");
	ОбластьМакета.Параметры.Заказ     = ?(ЗначениеЗаполнено(Сделка), "Согласно заказа №" + ОбщегоНазначения.УбратьНоликиСлева(Сделка.Номер) + " от " + Формат(Сделка.Дата, "ДФ=dd.MM.yyyy"), "");
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	Если ЗначениеЗаполнено(Грузоотправитель) Тогда
		
		ОбластьМакета = Макет.ПолучитьОбласть("Отправитель");
		ОбластьМакета.Параметры.Отправитель = СокрЛП(Грузоотправитель.НаименованиеПолное);
		ТабДокумент.Вывести(ОбластьМакета);
		
	КонецЕсли;
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка2");
		
	Попытка
		Тел = СокрЛП(Сделка.ТелефонКонтрагента);
		Расч= СокрЛП(Сделка.ВидРасчетов);
		Дост = СокрЛП(Сделка.СпособОтправки)+", "+СокрЛП(Сделка.АдресДоставкиНП);
	Исключение
		Тел = "";
		Расч= "";
		Дост = "";
	КонецПопытки;

	Если Не ЗначениеЗаполнено(Тел) Тогда
		Тел = КонтактнаяИнформация(Контрагент,Перечисления.ТипыКонтактнойИнформации.Телефон,Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента); 
	КонецЕсли;
	ОбластьМакета.Параметры.Покупатель = ?(ЗначениеЗаполнено(ФопПолучатель),СокрЛП(фопПолучатель),СокрЛП(Контрагент));
	ОбластьМакета.Параметры.Договор = СокрЛП(ДоговорКонтрагента);
	
	Если ЗначениеЗаполнено(Сделка) Тогда
		ОбластьМакета.Параметры.ВидОплаты = Строка(Сделка.ВидОплатыЗаказа) + " ТТН - " + Сделка.НомерТТН;
		ОбластьМакета.Параметры.Доставка = Сделка.Получатель + " " + Сделка.ТелефонКонтрагента ;
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(Расч) И СокрЛП(ВидРасчетов)="Готівка" Тогда
		Расч = СокрЛП(ВидРасчетов);
	КонецЕсли;
	
	Если Расч= "Готівка" Тогда
		Расч = "Наличный";
	Иначе
		Расч = "Безналичный";
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	Заказ = Сделка;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаказПокупателя.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.ОсновнойЗаказ = &ОсновнойЗаказ";
	
	
	Запрос.УстановитьПараметр("ОсновнойЗаказ", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Заказ = Выборка.Ссылка;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Заказ) И
		 Заказ.ТипОбратнойДоставки.Код = "000000009" Тогда // Грошовий переказ
		
		ОбластьМакета = Макет.ПолучитьОбласть("НаложенныйПлатеж");
		
		ОбластьМакета.Параметры.НаложенныйПлатеж = Заказ.СуммаНоваяПочта;
		
		ТабДокумент.Вывести(ОбластьМакета);
		
	КонецЕсли;
	
	ЕстьСкидка = ЕстьСкидка(); Скид = 0;
	
	Если ЗаполнятьГиперссылки Тогда
		
		СтруктураПараметров.НомерКолонки = ?(ЕстьСкидка, 9, 10);
		
	КонецЕсли;
	
	ТабР = ОбщегоНазначения.ТаблицаРостовок(Товары.Выгрузить(), Склад);
	
	ОбработкаЗначенияСвойств = Обработки.ЗначенияСвойствОбъекта.Создать();
	
	ОбработкаЗначенияСвойств.НазначениеСвойств = ПланыВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Справочник_ХарактеристикиНоменклатуры;
	
	//товары
	Ном=1;
	ТабТов = Товары.Выгрузить();
	НужноУдалить = Новый Массив;
	Для Каждого Стр Из ТабТов Цикл
		Если ЗначениеЗаполнено(Стр.НК) Тогда
			НужноУдалить.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из НужноУдалить Цикл
		ТабТов.Удалить(Стр);
	КонецЦикла;
	
	Если ТабТов.Количество() > 0 Тогда
		
		Если ЕстьСкидка Тогда
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТабСкидка");
		Иначе
			ОбластьМакета = Макет.ПолучитьОбласть("ШапкаТаб");
		КонецЕсли;
		ОбластьМакета.Параметры.ТабЧасть = "Еденичные товары";
		ТабДокумент.Вывести(ОбластьМакета);
		
		ТабТов.Свернуть("Номенклатура,ХарактеристикаНоменклатуры,НК,Цена","Количество,Сумма");
		ТабТов.Сортировать("Номенклатура,ХарактеристикаНоменклатуры");
		
		Для Каждого Стр Из ТабТов Цикл
			
			Цвет   = "";
			Ткань  = "";
			Размер = "";
			
			ОбработкаЗначенияСвойств.ОбъектОтбораЗначений   = Стр.ХарактеристикаНоменклатуры;
			ОбработкаЗначенияСвойств.ОбъектОтбораНазначений = Стр.Номенклатура;
			
			ЗначенияСвойствОбъекта = ОбработкаЗначенияСвойств.ПрочитатьТаблицуСвойствИЗначений();
			
			Для Каждого СтрокаТЗ Из ЗначенияСвойствОбъекта Цикл
				
				Если СтрокаТЗ.ПометкаУдаления Тогда
					Продолжить;
				КонецЕсли;
				
				Если СтрНайти(СтрокаТЗ.Наименование, "Цвет") > 0 Тогда
					
					Цвет = СокрЛП(СтрокаТЗ.Значение);
					
				КонецЕсли;
				
				Если СтрНайти(СтрокаТЗ.Наименование, "Ткань") > 0 Тогда
					
					Ткань = СокрЛП(СтрокаТЗ.Значение);
					
				КонецЕсли;
				
				Если СтрНайти(СтрокаТЗ.Наименование, "Размер") > 0 И ЗначениеЗаполнено(СтрокаТЗ.Значение) Тогда
					
					Размер = СокрЛП(СтрокаТЗ.Значение);
					
				КонецЕсли;
				
			КонецЦикла;
			
			ИмяОбласти = "Строка" + ?(ЕстьСкидка, "Скидка", "") + ?(ПустаяСтрока(Ткань), "", "Ткань");
			
			ОбластьМакета = Макет.ПолучитьОбласть(ИмяОбласти);
			
			ОбластьМакета.Параметры.Заполнить(Стр);
			
			ПараметрыОтбора = Новый Структура("Объект, Свойство");
