	//ОбластьМакета.Параметры.СуммаПрописью  = ОбщегоНазначения.СформироватьСуммуПрописью(СуммаКПрописи, Шапка.ВалютаДокумента,КодЯзыкаПечать)
	Если ЕстьСкидка Тогда
		ОбластьМакета = Макет.ПолучитьОбласть("ИтогСкидка");
		ОбластьМакета.Параметры.Скидка = Скид;
		ТабДокумент.Вывести(ОбластьМакета);
	КонецЕсли;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Итог");
	ОбластьМакета.Параметры.КолТоваров = Строка(Товары.Итог("Количество")+Товары1.Итог("Количество"))+"шт";
	ОбластьМакета.Параметры.Итого = Товары.Итог("Сумма")+Товары1.Итог("Сумма")+Услуги.Итог("Сумма");
	ТабДокумент.Вывести(ОбластьМакета);
	
	ДолгДо = 0;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВзаиморасчетыСКонтрагентамиОстатки.СуммаВзаиморасчетовОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Остатки(&Дата, ДоговорКонтрагента = &ДоговорКонтрагента) КАК ВзаиморасчетыСКонтрагентамиОстатки";
	
	
	Запрос.УстановитьПараметр("Дата"              , Дата);
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ДолгДо = Выборка.Остаток;
		
	КонецЕсли;
	
	ДолгПосле = ДолгДо + Товары.Итог("Сумма") + Товары1.Итог("Сумма") + Услуги.Итог("Сумма");
	
	Если СокрЛП(ВидРасчетов) = "Готівка" И Оплачено > 0 Тогда
		
		ДолгПосле = ДолгПосле - Оплачено;
		
	КонецЕсли;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Долг");
	
	ОбластьМакета.Параметры.ДолгДо    = Формат(ДолгДо, "ЧДЦ=0") + " Грн";
	ОбластьМакета.Параметры.ДолгДоЗаголовок = ?(ДолгДо<0,"До предплата: ","До борг - ");
	ОбластьМакета.Параметры.ДолгПослеЗаголовок = ?(ДолгПосле<0,"Після предплата: ","Після борг: ");

	//ОбластьМакета.Параметры.Оплачено  = ?(СокрЛП(ВидРасчетов) = "Готівка", Оплачено, 0);
	ОбластьМакета.Параметры.ДолгПосле = Формат(ДолгПосле, "ЧДЦ=0") + " Грн";
	
	ТабДокумент.Вывести(ОбластьМакета);
	
	ОбластьМакета = Макет.ПолучитьОбласть("Дно");
	
	//ТабДокумент.Вывести(ОбластьМакета);
	Попытка
		Если ЗначениеЗаполнено(Грузоотправитель)Тогда
			Путь = "C:\Program Files\1cv8\common\Подписи\";
			АнтонПодпись = Новый Картинка(Путь + "Антон.PNG");
			ИгорьПодпись = Новый Картинка(Путь + "Игорь.PNG");
			АллаПодпись = Новый Картинка(Путь + "Алла.PNG");
			
			ОбластьМакета = Макет.ПолучитьОбласть("ОффПодпись");
			
			Антон = Справочники.Контрагенты.НайтиПоКоду("000000514");
			Игорь = Справочники.Контрагенты.НайтиПоКоду("000000521");
			Алла = Справочники.Контрагенты.НайтиПоКоду("000000522");
			
			Если Грузоотправитель = Антон Тогда
				ОбластьМакета.Рисунки.D1.Картинка = АнтонПодпись;
			ИначеЕсли Грузоотправитель = Игорь Тогда
				ОбластьМакета.Рисунки.D1.Картинка = ИгорьПодпись;
			ИначеЕсли Грузоотправитель = Алла Тогда
				ОбластьМакета.Рисунки.D1.Картинка = АллаПодпись;
			КонецЕсли;
			 ОбластьМакета.Параметры.Покупатель = СокрЛП(Контрагент);		 
			 ОбластьМакета.Параметры.Грузоотправитель = СокрЛП(Грузоотправитель.Наименование);
			 ТабДокумент.Вывести(ОбластьМакета);
		КонецЕсли;
	Исключение
	КонецПопытки;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	Если ЗаполнятьГиперссылки Тогда
		
		СтруктураПараметров.ТабДок      = ТабДокумент;
		СтруктураПараметров.Гиперссылки = Гиперссылки;
		
		Возврат СтруктураПараметров;
		
	Иначе
		
		Возврат ТабДокумент;
		
	КонецЕсли;
	
КонецФункции // ПечатьДокумента()

Функция ОплатаЕсть (Заказ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Заказ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК ПриходныйКассовыйОрдерРасшифровкаПлатежа
	               |ГДЕ
	               |	(ПриходныйКассовыйОрдерРасшифровкаПлатежа.Сделка = &Сделка
	               |			ИЛИ ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.ДокументОснование = &Сделка)
	               |	И ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.Проведен
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПлатежноеПоручениеВходящееРасшифровкаПлатежа.Ссылка
	               |ИЗ
	               |	Документ.ПлатежноеПоручениеВходящее.РасшифровкаПлатежа КАК ПлатежноеПоручениеВходящееРасшифровкаПлатежа
	               |ГДЕ
