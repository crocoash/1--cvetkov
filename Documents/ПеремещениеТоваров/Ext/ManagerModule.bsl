функция ПолучитьДокументПеремещенияУпаковки(СкладОтправитель,Номенклатура) Экспорт 
	
	Кодполучателя = "000000043";
	
	Запрос = Новый Запрос;	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПеремещениеТоваровТовары.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	               |ГДЕ
	               |	НЕ ПеремещениеТоваровТовары.Ссылка.Проведен
	               |	И ПеремещениеТоваровТовары.Ссылка.СкладОтправитель.Код = &КодОтправителя
	               |	И ПеремещениеТоваровТовары.Ссылка.СкладПолучатель.Код = &КодПолучателя
	               |	И ПеремещениеТоваровТовары.Ссылка.Дата > &Дата
	               |	И ПеремещениеТоваровТовары.Номенклатура = &Номенклатура";
	
	Запрос.УстановитьПараметр("КодОтправителя",СкладОтправитель.Код);
	Запрос.УстановитьПараметр("КодПолучателя",Кодполучателя);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Запрос.УстановитьПараметр("Дата",НачалоДня(ТекущаяДата()));
	Результат = Запрос.Выполнить().Выбрать();
	
    Если Результат.Следующий() Тогда
        Перемещение = Результат.Ссылка.ПолучитьОбъект();
		Перемещение.Дата = ТекущаяДата();
		Возврат Перемещение;
    Иначе
        Док = Документы.ПеремещениеТоваров.СоздатьДокумент();
		Док.СкладОтправитель = СкладОтправитель;
		Док.СкладПолучатель = Справочники.Склады.НайтиПоКоду(Кодполучателя);
		Док.Организация = Справочники.Организации.НайтиПоКоду("000000001");
		Док.Комментарий = Номенклатура.НаименованиеПолное;
		Док.ОтражатьВУправленческомУчете = Истина;    
		Док.Дата = ТекущаяДата();
		Возврат Док;
	КонецЕсли;		
КонецФункции
