// КОМАНДЫ ФОРМЫ

&НаКлиенте
Процедура Заполнить(Команда)
	
	ЗаполнитьНаСервере();
	Закрыть();
	
КонецПроцедуры

// Заполняет ТЗ списком пользователей из справочника пользователей
&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Для каждого СтрПользователь Из СписокПользователей Цикл
		
		Если НЕ СтрПользователь.ОбновитьИнформацию Тогда
			Продолжить;
		КонецЕсли; 
		
		МенеджерЗаписи = РегистрыСведений.МИКО_мвДанныеПользователей.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрПользователь);
		
		Попытка
			МенеджерЗаписи.Записать();
			СтрПользователь.ОбновитьИнформацию = Ложь;
		Исключение
			
		КонецПопытки;
		
	КонецЦикла;
	
	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры // ЗаполнитьНаСервере()

&НаСервере
Процедура ПросклонятьНаСервере(Пользователь = Неопределено)
	
	// Просклоняем ФИО пользоватлей
	Попытка
		ПодключитьВнешнююКомпоненту("ОбщийМакет.МИКО_мвКомпонентаСклоненияФИО", "Decl");
		Компонента = Новый("AddIn.Decl.CNameDecl");
	Исключение
		Компонента = Неопределено;
		МИКО_стОбщегоНазначенияСервер.СообщитьПользователю("Не удалось подключить компоненту для склонения имени. Поробуйте просклонять вручную");
		Возврат;
	КонецПопытки;
	
	Для каждого СтрокаТЗ Из СписокПользователей Цикл
		
		Если Пользователь <> Неопределено И СтрокаТЗ.Пользователь <> Пользователь Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТЗ.ПолПользователя = Перечисления.МИКО_мвПолПользователей.Мужской Тогда
			Пол = 1;
		ИначеЕсли СтрокаТЗ.ПолПользователя = Перечисления.МИКО_мвПолПользователей.Женский Тогда
			Пол = 2;
		Иначе
			Пол = 0;
		КонецЕсли;
		
		МИКО_мвМаршрутизацияЗвонковСервер.ПросклонятьФразуКомпонента(Компонента, СтрокаТЗ.ФИОПользователя,2,СтрокаТЗ.ФИО_РП,Пол);
		МИКО_мвМаршрутизацияЗвонковСервер.ПросклонятьФразуКомпонента(Компонента, СтрокаТЗ.ФИОПользователя,3,СтрокаТЗ.ФИО_ДП,Пол);
		МИКО_мвМаршрутизацияЗвонковСервер.ПросклонятьФразуКомпонента(Компонента, СтрокаТЗ.ФИОПользователя,4,СтрокаТЗ.ФИО_ВП,Пол);
		МИКО_мвМаршрутизацияЗвонковСервер.ПросклонятьФразуКомпонента(Компонента, СтрокаТЗ.ФИОПользователя,5,СтрокаТЗ.ФИО_ТП,Пол);
		МИКО_мвМаршрутизацияЗвонковСервер.ПросклонятьФразуКомпонента(Компонента, СтрокаТЗ.ФИОПользователя,6,СтрокаТЗ.ФИО_ПП,Пол);
		
		ОбновитьСтатусЗаполнениПараметровСклонения(СтрокаТЗ);
		
		СтрокаТЗ.ОбновитьИнформацию = Истина;
	КонецЦикла;
	
КонецПроцедуры
&НаКлиенте
Процедура Просклонять(Команда)
	
	Если Элементы.СписокПользователей.ТекущиеДанные <> Неопределено Тогда
		ПросклонятьНаСервере(Элементы.СписокПользователей.ТекущиеДанные.Пользователь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПросклонятьВсе(Команда)
	
	ПросклонятьНаСервере();
	
КонецПроцедуры


&НаКлиенте
Процедура ПоказатьПараметры(Команда)
	
	Если Элементы.ПоказатьПараметры.Пометка = Ложь Тогда
		
		Элементы.ГруппаПараметрыСклонения.Видимость = Истина;
		Элементы.ПоказатьПараметры.Пометка = Истина;
		
	Иначе
		
		Элементы.ГруппаПараметрыСклонения.Видимость = Ложь;
		Элементы.ПоказатьПараметры.Пометка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОтборы(Команда)
	
	Элементы.ГруппаОтборы.Видимость = НЕ Элементы.ГруппаОтборы.Видимость;
	Элементы.СписокПользователейПоказатьНедействительных.Пометка = НЕ Элементы.СписокПользователейПоказатьНедействительных.Пометка;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЧЕЕ

&НаКлиенте
Процедура ПометитьМодифицированность(Элемент)
	
	Если Элемент = Неопределено ИЛИ Элементы.СписокПользователей.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ЭтаФорма.Модифицированность = Истина;
	Элементы.СписокПользователей.ТекущиеДанные.ОбновитьИнформацию = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопрос(Ответ, Параметры) Экспорт
	
	Вопрос = "";
	Если Ответ <> Неопределено И Параметры.Свойство("Вопрос", Вопрос) Тогда
		
		Если Вопрос = "СохранитьНастройки" Тогда
			
			Если Ответ = КодВозвратаДиалога.Да Тогда
				ЗаполнитьНаСервере();
				Закрыть();
			ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
				ЭтаФорма.Модифицированность = Ложь;
				Закрыть();
			Иначе
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
        
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПроверитьИзмененияНаСервере()

	Для каждого СтрДанных Из СписокПользователей Цикл
		Если СтрДанных.ОбновитьИнформацию Тогда
			Возврат;
		КонецЕсли; 
	КонецЦикла; 

	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры // ПроверитьИзмененияНаСервере()

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСтатусЗаполнениПараметровСклонения(СтрокаТаблицы)
	
	СтрокаТаблицы.ПараметрыСклоненияУказаны = 
		ЗначениеЗаполнено(СтрокаТаблицы.ФИО_РП) Или 
		ЗначениеЗаполнено(СтрокаТаблицы.ФИО_ДП) Или 
		ЗначениеЗаполнено(СтрокаТаблицы.ФИО_ТП) Или 
		ЗначениеЗаполнено(СтрокаТаблицы.ФИО_ВП) Или 
		ЗначениеЗаполнено(СтрокаТаблицы.ФИО_ПП);
	
КонецПроцедуры

// <Описание процедуры>
//
&НаКлиенте
Процедура УстановитьВидимостьЭлементов()

	Элементы.ГруппаОтборы.Видимость = Ложь;
	Элементы.СписокПользователейПоказатьНедействительных.Пометка = Ложь;

КонецПроцедуры // УстановитьВидимостьЭлементов()

// <Описание процедуры>
//
&НаСервере
Процедура УстановитьНачальныеОтборы()

	ТолькоАктивные = Истина;
	Элементы.СписокПользователей.ОтборСтрок = Новый ФиксированнаяСтруктура("Неактивен", Ложь);

КонецПроцедуры // УстановитьОтборы()

// #КонецОбласти 