&НаКлиенте
Процедура Лицензирование(Команда)
	Попытка
		мМИКО_Лицензирование = Вычислить("МИКО_Лицензирование");	
	Исключение
		Возврат;	
	КонецПопытки; 
	НастройкиФормы = Новый Структура;
	НастройкиФормы.Вставить("ИдентификаторПродукта", "9");
	НастройкиФормы.Вставить("СведенияОПродукте", мМИКО_Лицензирование.ПолучитьСведенияОПродукте("Модуль умной маршрутизации"));
	
	ОткрытьФорму("ОбщаяФорма.МИКО_РегистрацияПродукта", НастройкиФормы, ЭтаФорма, ЭтаФорма.УникальныйИдентификатор);
	// ОткрытьФорму("ПланВидовХарактеристик.МИКО_стНастройкиТелефонии.Форма.Настройки", НастройкиФормы, ЭтаФорма);
КонецПроцедуры


