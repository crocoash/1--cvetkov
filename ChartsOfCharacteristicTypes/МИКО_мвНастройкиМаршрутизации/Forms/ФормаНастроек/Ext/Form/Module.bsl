&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТестНомерДляПриветствия = "74952293042";	
	// Видимость элементов формы
	MIKO_Asterisk_Подключена = Метаданные.Обработки.Найти("MIKO_Asterisk")<>Неопределено;
	МИКО_ПанельТелефонииДля1С_Подключена = Метаданные.Обработки.Найти("МИКО_ПанельТелефонииДля1С")<>Неопределено;
	ПанельТелефонииЕсть = (MIKO_Asterisk_Подключена ИЛИ МИКО_ПанельТелефонииДля1С_Подключена);
	Элементы.ПрослушатьПриветствиеБезОтветственных.Видимость = ПанельТелефонииЕсть;
	Элементы.ПрослушатьПриветствие.Видимость 				 = ПанельТелефонииЕсть;
	Элементы.ПрослушатьПриветствиеОкончание.Видимость 		 = ПанельТелефонииЕсть;
	
	// Создадим элемент стиля "шрифт" для выделения заголовков элементов формы.
	ШрифтВыделения = Новый Шрифт(ШрифтыСтиля.ШрифтТекста,,10,Истина);
	
	ЗагрузитьНастройки();
	
	Если ПустаяСтрока(ПоставщикУслуг) Тогда
		ПоставщикУслуг = Элементы.ПоставщикУслуг.СписокВыбора[0].Значение;
	КонецЕсли;
	
	ОбновитьПримерОповещенияГолосовогоМеню();
	ОбновитьСписокДикторов();
	ОбновитьИнтерфейсФормы();
	
	// Получим системную информацию
	СтруктураДанных = МИКО_стСлужебный.ПолучитьСлужебнуюИнформацию();
	ВерсияПлатформы = СтруктураДанных.ВерсияПлатформы;
	ИспользоватьРежимМодальности = СтруктураДанных.ИспользоватьРежимМодальности;
	
	// Попробуем установитьсвойство формы "ВертикальнаяПрокрутка" в значение "Авто".
	Попытка
		врПараметры = Новый Структура("ВертикальнаяПрокрутка");
		ЗаполнитьЗначенияСвойств(врПараметры, ЭтаФорма);
		Если врПараметры.ВертикальнаяПрокрутка <> Неопределено Тогда
			Выполнить("ЭтаФорма.ВертикальнаяПрокрутка = ВертикальнаяПрокруткаФормы.Авто");
		КонецЕсли; 
	Исключение
	КонецПопытки;
	
	ПриСозданииНаСервереСписокСотрудников();
	ПолучитьРегламентныеЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если ЭтаФорма.Модифицированность Тогда
		
		Если (ВерсияПлатформы = "8.2" ИЛИ ИспользоватьРежимМодальности) Тогда
			Ответ = Вопрос("Сохранить изменения перед выходом?", РежимДиалогаВопрос.ДаНетОтмена);
			Если Ответ = КодВозвратаДиалога.Да Тогда
				СохранитьНастройки();
			ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
				ЭтаФорма.Модифицированность = Ложь;
			КонецЕсли;
		Иначе
			Попытка	
				Выполнить("ПоказатьВопрос(
				|Новый ОписаниеОповещения(""ПослеОтветаНаВопрос"", ЭтаФорма, Новый Структура(""Вопрос"", ""СохранитьНастройки"")),
				|""Сохранить изменения перед выходом?"", РежимДиалогаВопрос.ДаНетОтмена)");
				
				Отказ = Истина;
			Исключение
				Возврат;
			КонецПопытки; 
		КонецЕсли;  
	КонецЕсли;
	
КонецПроцедуры

