///
// Настройка расписания заданий
///

&НаСервере 
// Получение регламентных заданий по подсистеме "ИсторияЗвонков"
// 
Процедура ПолучитьРегламентныеЗадания()
	Задания.Очистить();
	
	ВсеЗадания = РегламентныеЗадания.ПолучитьРегламентныеЗадания();
	Для каждого Задание Из ВсеЗадания Цикл
		Имя = Задание.Метаданные.Имя;
		Если Элементы.Найти(Имя)=Неопределено Тогда
			Продолжить;
		КонецЕсли; 			
		Элементы[Имя].Заголовок = "" + Задание.Расписание;
		
		ПоляЗадания = Задания.Добавить();
		ПоляЗадания.УникальныйИдентификатор = Задание.УникальныйИдентификатор;
		ПоляЗадания.Имя 					= Имя;
		ПоляЗадания.Представление 			= Задание.Метаданные.Синоним;
		ПоляЗадания.Расписание 				= Задание.Расписание;
	КонецЦикла; 
КонецПроцедуры 

&НаКлиенте
// Обработка изменения расписания регламентного задания
//
Процедура ВыбратьРасписание(Расписание, ДопПараметры) Экспорт
	Если Расписание = Неопределено Тогда
		// не изменили расписание, просто закрыли форму 
		Возврат;
	КонецЕсли; 
				
	Если Не ТипЗнч(ДопПараметры) = Тип("Структура") Тогда
		// это не верное оповещение
		Возврат;
	КонецЕсли; 
	
	СохранитьРасписаниеЗадания(ДопПараметры.УникальныйИдентификатор, Расписание);
КонецПроцедуры

// Сохранить расписание задания.
//
// Параметры:
//  УникальныйИдентификатор  - <тип - УникальныйИдентификатор> - идентификатор регламентного задания.
//  Расписание  - <РасписаниеРегламентногоЗадания> - новое значение расписания.
//
&НаСервере
Процедура СохранитьРасписаниеЗадания(УИД, Расписание)

	Задание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(УИД);
	Если Задание = Неопределено Тогда
		// передан не верный идентификатор
		Возврат;			
	КонецЕсли; 
	// правим расписание
	Задание.Расписание = Расписание;
	Задание.Записать();	

	ПолучитьРегламентныеЗадания();
КонецПроцедуры // СохранитьРасписаниеЗадания()

&НаКлиенте
// Обработка нажатия на гиперссылку регламентного задания.
// 
Процедура ИзменениеРасписанияНажатие(Элемент)
	
	ВсеЗадания = Задания.НайтиСтроки(Новый Структура("Имя", Элемент.Имя));
	Если ВсеЗадания.Количество()=0 Тогда
		Возврат;
	КонецЕсли; 	
	
	// пробуем менять расписание
	УИД = ВсеЗадания[0].УникальныйИдентификатор; 
	Имя = ВсеЗадания[0].Имя;
	Расписание = ВсеЗадания[0].Расписание;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("УникальныйИдентификатор",УИД);	
	ДопПараметры.Вставить("Имя",Имя);
	
	
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(Расписание);	
	
	Если ВерсияПлатформы = "8.3" Тогда
		
		Если НЕ ИспользоватьРежимМодальности Тогда
		
			ОписаниеОповещения = Вычислить("Новый ОписаниеОповещения(""ВыбратьРасписание"", ЭтаФорма, ДопПараметры)");
			Попытка	
				Выполнить("Диалог.Показать(ОписаниеОповещения)");
			Исключение
				Возврат;
			КонецПопытки; 
			
		Иначе	
			ЗначениеРасписания = Диалог.ОткрытьМодально();
			УстановитьРасписаниеНаСервере(УИД, Диалог.Расписание);
			ПолучитьРегламентныеЗадания();
		КонецЕсли; 
		
		
	ИначеЕсли ВерсияПлатформы = "8.2" Тогда
		ЗначениеРасписания = Диалог.ОткрытьМодально();
		УстановитьРасписаниеНаСервере(УИД, Диалог.Расписание);
		ПолучитьРегламентныеЗадания();
	КонецЕсли; 
	
КонецПроцедуры
 
&НаСервереБезКонтекста
// Установка расписания для регламентного задания.
// 
Процедура УстановитьРасписаниеНаСервере(РеглЗаданиеУИД, Знач Расписание)

	РеглЗадание = РегламентныеЗадания.НайтиПоУникальномуИдентификатору(РеглЗаданиеУИД);
	РеглЗадание.Расписание = Расписание;
	РеглЗадание.Записать();
	
КонецПроцедуры // ()

