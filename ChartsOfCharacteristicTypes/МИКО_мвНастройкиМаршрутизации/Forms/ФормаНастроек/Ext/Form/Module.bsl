КонецПроцедуры // ЗапроситьОбратныйЗвонокСГолосомДиктора()

&НаСервереБезКонтекста
Процедура ОбновитьТаблицуМаршрутизацииНаСервере()
	
	Попытка
		// Перезаполним таблицу значимых событий
		ОбновитьТаблицуЗначимыхСобытий();
		// Обновим таблицу маршрутизации
		МИКО_мвМаршрутизацияЗвонковСервер.ОбновитьТаблицуМаршрутизации();
	Исключение
		ЗаписьЖурналаРегистрации("МИКО.мвОбновитьТаблицуМаршрутизации",  УровеньЖурналаРегистрации.Предупреждение, , ,  "Ошибка запуска регламентной задачи: " + ОписаниеОшибки());
	КонецПопытки; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбновитьТаблицуЗначимыхСобытий()
	Попытка
		мМИКО_мвМаршрутизацияЗвонковСервер = Вычислить("МИКО_мвМаршрутизацияЗвонковСервер");	
	Исключение
		Возврат;	
	КонецПопытки; 
	// Определим, по каким документов фиксируется информация
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	мвРегистрируемыеСобытия.ВидСобытия,
		|	мвРегистрируемыеСобытия.ВидОбъекта,
		|	мвРегистрируемыеСобытия.Вес,
		|	мвРегистрируемыеСобытия.СрокДействия,
		|	мвРегистрируемыеСобытия.Предопределенный,
		|	тчСоответствиеРеквизитов.НаименованиеПоляОбъекта КАК НаименованиеПоляДата
		|ИЗ
		|	Справочник.МИКО_мвРегистрируемыеСобытия КАК мвРегистрируемыеСобытия
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.МИКО_мвРегистрируемыеСобытия.СоответствиеРеквизитов КАК тчСоответствиеРеквизитов
		|		ПО (тчСоответствиеРеквизитов.Ссылка = мвРегистрируемыеСобытия.Ссылка)
		|			И (тчСоответствиеРеквизитов.НаименованиеПоля = ""Дата"")
		|ГДЕ
		|	мвРегистрируемыеСобытия.ПометкаУдаления = ЛОЖЬ";
		
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаВидовСобытий = РезультатЗапроса.Выгрузить();
	
	// Подготовим запрос для выбора списка документов, по которым будем собирать
	// информацию для таблицы значимых событий.
	
	ТекстЗапросаПоОбъектам = "";
	Для Каждого СтрокаТЗ Из ТаблицаВидовСобытий Цикл
		
		ТекстЗапросаПоОбъекту =
			"ВЫБРАТЬ
			|	Объект.Ссылка
			|ИЗ
			|	%ВидСобытия%.%ВидОбъекта% КАК Объект
			|ГДЕ
			|	Объект.%Дата% >= &НачалоПериода
			|";
			
		Если СтрокаТЗ.Предопределенный
		 Или СтрокаТЗ.ВидСобытия = Перечисления.МИКО_мвВидыЗначимыхСобытий.ВходящийЗвонок
		 Или СтрокаТЗ.ВидСобытия = Перечисления.МИКО_мвВидыЗначимыхСобытий.ИсходящийЗвонок Тогда
			ТекстЗапросаПоОбъекту = СтрЗаменить(ТекстЗапросаПоОбъекту, "%ВидСобытия%",   "Документ");
			ТекстЗапросаПоОбъекту = СтрЗаменить(ТекстЗапросаПоОбъекту, "%ВидОбъекта%",   "МИКО_стЗаписьИсторииЗвонков");
			ТекстЗапросаПоОбъекту = СтрЗаменить(ТекстЗапросаПоОбъекту, "%Дата%",         "Дата");
		Иначе
			ТекстЗапросаПоОбъекту = СтрЗаменить(ТекстЗапросаПоОбъекту, "%ВидСобытия%",   СтрокаТЗ.ВидСобытия);
			ТекстЗапросаПоОбъекту = СтрЗаменить(ТекстЗапросаПоОбъекту, "%ВидОбъекта%",   СтрокаТЗ.ВидОбъекта);
			ТекстЗапросаПоОбъекту = СтрЗаменить(ТекстЗапросаПоОбъекту, "%Дата%",         СтрокаТЗ.НаименованиеПоляДата);
		КонецЕсли;
		
		Если ПустаяСтрока(ТекстЗапросаПоОбъектам) Тогда
			ТекстЗапросаПоОбъектам = ТекстЗапросаПоОбъекту;
		Иначе
			ТекстЗапросаПоОбъектам = ТекстЗапросаПоОбъектам + Символы.ПС +
				"ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + Символы.ПС + ТекстЗапросаПоОбъекту;
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Объекты.Ссылка
		|ИЗ
		|	(%ТекстЗапросаПоОбъектам%) КАК Объекты";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ТекстЗапросаПоОбъектам%", ТекстЗапросаПоОбъектам);
	
	// Граница периода обрабатываемых данных определяется по максимуму
	// срока действия всех регистрируемых событий.
	Если ТаблицаВидовСобытий.Количество() > 0 Тогда
		МаксСрокДействияВДнях = МИКО_стОбщегоНазначения.НайтиСтрокуСМаксимальнымЗначениеВТаблице(ТаблицаВидовСобытий, "СрокДействия").СрокДействия;
	Иначе
		МаксСрокДействияВДнях = 0;
	КонецЕсли; 
	
	НачалоПериода = НачалоДня(ТекущаяДата() - МаксСрокДействияВДнях * 86400);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	
	РезультатЗапроса = Запрос.Выполнить();
	ОбходЗапроса = РезультатЗапроса.Выбрать();
	
	Пока ОбходЗапроса.Следующий() Цикл
		мМИКО_мвМаршрутизацияЗвонковСервер.ЗарегистрироватьСобытие(ОбходЗапроса.Ссылка, Истина);
	КонецЦикла;
	
КонецПроцедуры // ОбновитьТаблицуЗначимыхСобытий()

Функция СформироватьСтрокуПриветствия(НомерТелефона)
	
	Попытка
		мМИКО_мвМаршрутизацияЗвонковСервер = Вычислить("МИКО_мвМаршрутизацияЗвонковСервер");	
	Исключение
		Возврат НомерТелефона;
	КонецПопытки;
	
	Возврат мМИКО_мвМаршрутизацияЗвонковСервер.СформироватьСтрокуПриветствия(НомерТелефона);
	
КонецФункции

