////////////////////////////////////////////////////////////////////////////////
// СОТРУДНИКИ.

&НаСервере
// Наполнение списка сотрудников.
// 
Процедура ПриСозданииНаСервереСписокСотрудников()
	
	ИерархическийСправочник 	= Метаданные.Справочники.Пользователи.Иерархический;
	ЕстьРеквизитНедействителен 	= Метаданные.Справочники.Пользователи.Реквизиты.Найти("Недействителен")<>Неопределено;
	
	// Заполним таблицу пользователей данными из РС "МИКО_мвДанныеПользователей".
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(МИКО_мвДанныеПользователей.УчаствуетВГолосовомМеню, 0) = 0
		|			ТОГДА НЕ Пользователи.ПометкаУдаления
		|		ИНАЧЕ МИКО_мвДанныеПользователей.УчаствуетВГолосовомМеню
		|	КОНЕЦ КАК УчаствуетВГолосовомМеню,
		|	ЕСТЬNULL(МИКО_мвДанныеПользователей.ФИО_РП, """") КАК ФИО_РП,
		|	ЕСТЬNULL(МИКО_мвДанныеПользователей.ФИО_ДП, """") КАК ФИО_ДП,
		|	ЕСТЬNULL(МИКО_мвДанныеПользователей.ФИО_ВП, """") КАК ФИО_ВП,
		|	ЕСТЬNULL(МИКО_мвДанныеПользователей.ФИО_ТП, """") КАК ФИО_ТП,
		|	ЕСТЬNULL(МИКО_мвДанныеПользователей.ФИО_ПП, """") КАК ФИО_ПП,
		|	ЕСТЬNULL(МИКО_мвДанныеПользователей.ПериодНачало, ДАТАВРЕМЯ(1,1,1,0,0,0)) КАК ПериодНачало,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(МИКО_мвДанныеПользователей.Пользователь, 0) = 0
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ОбновитьИнформацию,
		|	ЕСТЬNULL(МИКО_мвДанныеПользователей.ПолПользователя, """") КАК ПолПользователя,
		|	Пользователи.Ссылка КАК Пользователь,
		|	//ПолеНедействителен//
		|	Пользователи.Ссылка.Наименование КАК ФИОПользователя
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.МИКО_мвДанныеПользователей КАК МИКО_мвДанныеПользователей
		|		ПО (МИКО_мвДанныеПользователей.Пользователь = Пользователи.Ссылка)
		|";
				   
	Если ИерархическийСправочник Тогда
		Запрос.Текст = Запрос.Текст + 
			"ГДЕ
	   		|	НЕ Пользователи.ЭтоГруппа
			|";
	КонецЕсли;
		
	Запрос.Текст = Запрос.Текст + 
		"УПОРЯДОЧИТЬ ПО
		|	ФИОПользователя";
				   
	Если ЕстьРеквизитНедействителен Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ПолеНедействителен//", "Пользователи.Недействителен ИЛИ Пользователи.ПометкаУдаления КАК Неактивен,");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//ПолеНедействителен//", "Пользователи.ПометкаУдаления КАК Неактивен,");
	КонецЕсли; 
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли; 
	
	СписокПользователей.Загрузить(Результат.Выгрузить());
	
	Для Каждого СтрокаТЗ Из СписокПользователей Цикл
		ОбновитьСтатусЗаполнениПараметровСклонения(СтрокаТЗ);
	КонецЦикла;
	
	// Получим системную информацию
	УстановитьНачальныеОтборы();

КонецПроцедуры

