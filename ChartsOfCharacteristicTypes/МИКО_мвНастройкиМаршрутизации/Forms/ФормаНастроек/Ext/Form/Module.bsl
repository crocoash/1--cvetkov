// КОМАНДЫ ФОРМЫ

&НаКлиенте
Процедура Сохранить(Команда)
	
	Если НЕ ЗначениеЗаполнено(Элементы.ДикторГолосовогоМеню.ТекстРедактирования) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Укажите диктора для генерации речи.";
		Сообщение.Поле = "ДикторГолосовогоМеню";
		Сообщение.УстановитьДанные(ДикторГолосовогоМеню);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли; 
	
	СохранитьНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрослушатьПриветствие(Команда)
	
	ПрослушатьПриветствиеНаСервере();
	ЗапроситьОбратныйЗвонокСГолосомДиктора();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрослушатьПриветствиеБезОтветственных(Команда)
	
	ПрослушатьПриветствиеБезОтветственныхНаСервере();
	ЗапроситьОбратныйЗвонокСГолосомДиктора();
	
КонецПроцедуры

&НаСервере
Процедура ПрослушатьПриветствиеНаСервере()
	
	Сотрудники1С = ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.СформироватьСписокСотрудников(ПадежСклоненияИменСотрудников, СоставИмениСотрудников);
	Ключ = ?(ПоставщикУслуг = "Yandex",КлючAPI_Yandex, КлючAPI_CRT);
	ДанныеПриветствия = Новый Структура;
	ДанныеПриветствия.Вставить("Приветствие", ПриветствиеГолосовогоМеню);
	ДанныеПриветствия.Вставить("Сотрудники",  Сотрудники1С);
	ДанныеПриветствия.Вставить("Окончание",   ОкончаниеГолосовогоМеню);
	// Добавим дополнительный параметры
	ДанныеПриветствия.Вставить("Параметры", Новый Структура);
	ДанныеПриветствия.Параметры.Вставить("Поставщик",   ПоставщикУслуг);
	ДанныеПриветствия.Параметры.Вставить("КлючAPI",     Ключ);
	ДанныеПриветствия.Параметры.Вставить("Диктор",      ДикторГолосовогоМеню);
	ДанныеПриветствия.Параметры.Вставить("Оптимизация", ОптимизацияРасходов);
	
	ПодготовитьСистемуКВоспроизведению(ДанныеПриветствия);
	
КонецПроцедуры

&НаСервере
Процедура ПрослушатьПриветствиеБезОтветственныхНаСервере()
	Ключ = ?(ПоставщикУслуг = "Yandex",КлючAPI_Yandex, КлючAPI_CRT);
	ДанныеПриветствия = Новый Структура;
	ДанныеПриветствия.Вставить("Приветствие", ПриветствиеГолосовогоМенюБезОтветственных);
	ДанныеПриветствия.Вставить("Сотрудники",  Новый Массив);
	ДанныеПриветствия.Вставить("Окончание",   "");
	// Добавим дополнительный параметры
	ДанныеПриветствия.Вставить("Параметры", Новый Структура);
	ДанныеПриветствия.Параметры.Вставить("Поставщик",   ПоставщикУслуг);
	ДанныеПриветствия.Параметры.Вставить("КлючAPI",     Ключ);
	ДанныеПриветствия.Параметры.Вставить("Диктор",      ДикторГолосовогоМеню);
	ДанныеПриветствия.Параметры.Вставить("Оптимизация", ОптимизацияРасходов);
	
	ПодготовитьСистемуКВоспроизведению(ДанныеПриветствия);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицуМаршрутизации(Команда)
	
	Если (ВерсияПлатформы = "8.2" ИЛИ ИспользоватьРежимМодальности) Тогда
		Ответ = Вопрос("Внимание! Процедура может занять длительное время. Продолжить?", РежимДиалогаВопрос.ДаНет,,); 
		Если Ответ = КодВозвратаДиалога.Нет Тогда
    		Возврат;
		КонецЕсли;
		ОбновитьТаблицуМаршрутизацииНаСервере();
	Иначе	
		Выполнить("ПоказатьВопрос(Новый ОписаниеОповещения(""ПослеОтветаНаВопрос"", 
		|ЭтаФорма, Новый Структура(""Вопрос"", ""ОбновитьТаблицуМаршрутизации"")), 
		|""Внимание! Процедура может занять длительное время. Продолжить?"", РежимДиалогаВопрос.ДаНет)");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СформироватьТекстПриветствия(Команда)
	
	// Получим системную информацию
	СтруктураДанных = МИКО_стСлужебный.ПолучитьСлужебнуюИнформацию();
	ВерсияПлатформы = СтруктураДанных.ВерсияПлатформы;
	ИспользоватьРежимМодальности = СтруктураДанных.ИспользоватьРежимМодальности;
	
	Подсказка = "Укажите номер телефона клиента для формирования приветствия";
	Если ЗначениеЗаполнено(ТестНомерДляПриветствия) Тогда
		МИКО_стОбщегоНазначенияКлиент.СообщитьПользователю(СформироватьСтрокуПриветствия(ТестНомерДляПриветствия));
	Иначе
		МИКО_стОбщегоНазначенияКлиент.СообщитьПользователю("Не указан номер телефона!");
	КонецЕсли;
	
КонецПроцедуры

