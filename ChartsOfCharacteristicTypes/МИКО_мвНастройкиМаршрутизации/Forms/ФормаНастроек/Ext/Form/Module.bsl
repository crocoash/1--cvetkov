// ОБРАБОТЧИКИ АСИНХРОННЫХ ОТВЕТОВ

&НаКлиенте
Процедура ПослеВводаСтроки(Строка, Параметры) Экспорт
	
	РеквизитФормы = "";
	Если Строка <> Неопределено И Параметры.Свойство("Реквизит", РеквизитФормы) Тогда
		ЭтаФорма[РеквизитФормы] = Строка;
		ЭтаФорма.Модифицированность = Истина;
		
		ОбновитьПримерОповещенияГолосовогоМеню();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЭлементаМеню(ВыбранныйЭлемент, Параметры) Экспорт
	
	ВидМеню = "";	
	Если ВыбранныйЭлемент <> Неопределено И Параметры.Свойство("Меню", ВидМеню) Тогда
		
		Если ВидМеню = "#Сотрудники" Тогда
		
			Если ВыбранныйЭлемент.Значение = "ИзменитьПадеж" Тогда
				
				ЭлементыМеню = Новый СписокЗначений();
				ЭлементыМеню.Добавить(1, "Именительный (Кто?)");
				ЭлементыМеню.Добавить(2, "Родительный (Нет кого?)");
				ЭлементыМеню.Добавить(3, "Дательный (Кому?)");
				ЭлементыМеню.Добавить(4, "Винительный (Кого?)");
				ЭлементыМеню.Добавить(5, "Творительный (Кем?)");
				ЭлементыМеню.Добавить(6, "Предложный (О ком?)");
				Если (ВерсияПлатформы = "8.2" ИЛИ ИспользоватьРежимМодальности) Тогда
					ВыбранныйЭлемент = ВыбратьИзМеню(ЭлементыМеню, Элементы.ИзменитьПадеж);
					ПослеВыбораЭлементаМеню(ВыбранныйЭлемент, Новый Структура("Меню", "#Падежи"));
				Иначе
					Выполнить("ПоказатьВыборИзМеню(
							|Новый ОписаниеОповещения(""ПослеВыбораЭлементаМеню"", ЭтаФорма, Новый Структура(""Меню"", ""#Падежи"")),
							|ЭлементыМеню,
							|Элементы.ИзменитьПадеж)");
				КонецЕсли;
			ИначеЕсли ВыбранныйЭлемент.Значение = "ИзменитьСоставИмени" Тогда
				
				ЭлементыМеню = Новый СписокЗначений();
				ЭлементыМеню.Добавить(0, "Фамилия, имя, отчество");
				ЭлементыМеню.Добавить(1, "Фамилия, имя");
				ЭлементыМеню.Добавить(2, "Имя, отчество");
				Если (ВерсияПлатформы = "8.2" ИЛИ ИспользоватьРежимМодальности) Тогда
					ВыбранныйЭлемент = ВыбратьИзМеню(ЭлементыМеню, Элементы.ИзменитьПадеж);
					ПослеВыбораЭлементаМеню(ВыбранныйЭлемент, Новый Структура("Меню", "#СоставИмени"));
				Иначе
				
					Выполнить("ПоказатьВыборИзМеню(
								|Новый ОписаниеОповещения(""ПослеВыбораЭлементаМеню"", ЭтаФорма, Новый Структура(""Меню"", ""#СоставИмени"")),
								|ЭлементыМеню,
								|Элементы.ИзменитьСоставИмени)");
				КонецЕсли;
			КонецЕсли;
				
		ИначеЕсли ВидМеню = "#Падежи" Тогда
			
			ПадежСклоненияИменСотрудников = ВыбранныйЭлемент.Значение;
			
			ЭтаФорма.Модифицированность = Истина;
			
			ОбновитьПримерОповещенияГолосовогоМеню();
			
		ИначеЕсли ВидМеню = "#СоставИмени" Тогда
			
			СоставИмениСотрудников = ВыбранныйЭлемент.Значение;
			
			ЭтаФорма.Модифицированность = Истина;
			
			ОбновитьПримерОповещенияГолосовогоМеню();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопрос(Ответ, Параметры) Экспорт
	
	Вопрос = "";
	Если Ответ <> Неопределено И Параметры.Свойство("Вопрос", Вопрос) Тогда
		
		Если Вопрос = "СохранитьНастройки" Тогда
			
			Если Ответ = КодВозвратаДиалога.Да Тогда
				СохранитьНастройки();
				Закрыть();
			ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
				ЭтаФорма.Модифицированность = Ложь;
				Закрыть();
			КонецЕсли;
		ИначеЕсли Вопрос = "ОбновитьТаблицуМаршрутизации" Тогда
			
			Если Ответ = КодВозвратаДиалога.Нет Тогда
				Возврат;
			КонецЕсли;
			
			ОбновитьТаблицуМаршрутизацииНаСервере();
			
		КонецЕсли;
        
    КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// УПРАВЛЕНИЕ НАСТРОЙКАМИ.
&НаСервере 
Процедура ЗагрузитьНастройки()
	
	// Загружаем настройки из базы
	Запрос = Новый Запрос;
		
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИКО_мвНастройкиМаршрутизации.Наименование КАК Параметр,
		|	МИКО_мвНастройкиМаршрутизации.Значение
		|ИЗ
		|	ПланВидовХарактеристик.МИКО_мвНастройкиМаршрутизации КАК МИКО_мвНастройкиМаршрутизации
		|ГДЕ
		|	МИКО_мвНастройкиМаршрутизации.ЭтоГруппа = ЛОЖЬ
		|	И МИКО_мвНастройкиМаршрутизации.Предопределенный = ИСТИНА
		|	И МИКО_мвНастройкиМаршрутизации.Родитель = ЗНАЧЕНИЕ(ПланВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ОповещениеГолосовогоМеню)";
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаНастроек = РезультатЗапроса.Выгрузить();
	
	СписокПараметров.ЗагрузитьЗначения(ТаблицаНастроек.ВыгрузитьКолонку("Параметр"));
	
	// Заполняем настройки
	Для Каждого СтрокаНастройки Из ТаблицаНастроек Цикл
		
		ЭтаФорма[СтрокаНастройки.Параметр] = СтрокаНастройки.Значение;
		
	КонецЦикла;
	
	// Заполним значения по умолчанию
	Если ПустаяСтрока(ПриветствиеГолосовогоМеню) И ПустаяСтрока(ОкончаниеГолосовогоМеню) Тогда
		
		ПриветствиеГолосовогоМеню = 
			"Вас приветствует компания МИКО, официальный партнер фирмы 1С в Зеленограде. Ранее Вы общались с";
			
		ОкончаниеГолосовогоМеню = 
			"Для связи с отделом продаж наберите 90";
			
		Модифицированность = Истина;
		
	КонецЕсли;
	
	Если ПустаяСтрока(ПриветствиеГолосовогоМенюБезОтветственных) Тогда
	
		ПриветствиеГолосовогоМенюБезОтветственных = "Вас приветствует компания МИКО, официальный партнер фирмы 1С в Зеленограде";	
		Модифицированность = Истина;
		
	КонецЕсли; 
	
КонецПроцедуры // ЗагрузитьНастройки()

&НаСервере 
Процедура СохранитьНастройки()

	Для Каждого элПараметр Из СписокПараметров Цикл
		ПараметрОбъект = ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации[элПараметр.Значение].ПолучитьОбъект();
		
		Если "ДикторГолосовогоМенюБезОтветственных" = элПараметр.Значение Тогда
			ИмяРеквизита = "ДикторГолосовогоМеню";
		ИначеЕсли "КлючAPI" = элПараметр.Значение Тогда
			ИмяРеквизита = "КлючAPI_"+ПоставщикУслуг;	
		Иначе
			ИмяРеквизита = элПараметр.Значение;
		КонецЕсли; 
		
		ПараметрОбъект.Значение = ЭтаФорма[ИмяРеквизита];
		ПараметрОбъект.Записать();
	КонецЦикла;
	
	СотрудникиСохранитьНаСервере();
	ЭтаФорма.Модифицированность = Ложь;

КонецПроцедуры // СохранитьНастройки()


////////////////////////////////////////////////////////////////////////////////
// УПРАВЛЕНИЕ ВНЕШНИМ ВИДОМ ФОРМЫ.
&НаСервере 
Процедура ОбновитьПримерОповещенияГолосовогоМеню()
	
	врСотрудники = ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.СформироватьСписокСотрудников(ПадежСклоненияИменСотрудников, СоставИмениСотрудников);
		
	СтрПриветствие                 = ?(ПустаяСтрока(ПриветствиеГолосовогоМеню),                 "<Пусто>", ПриветствиеГолосовогоМеню);
	СтрПриветствиеБезОтветственных = ?(ПустаяСтрока(ПриветствиеГолосовогоМенюБезОтветственных), "<Пусто>", ПриветствиеГолосовогоМенюБезОтветственных);
	СтрОкончание                   = ?(ПустаяСтрока(ОкончаниеГолосовогоМеню),                   "<Пусто>", ОкончаниеГолосовогоМеню);
	СтрСотрудники                  = ?(врСотрудники.Количество()=0,                  			"<Не настроен список сотрудников>", МИКО_стОбщегоНазначения.СтрокаИзМассиваПодстрок(врСотрудники, ".")+". ");
	
	НадписьПриветствиеСотрудники = СтрСотрудники;
				
КонецПроцедуры // ОбновитьПримерОповещенияГолосовогоМеню()
&НаСервере 
Процедура ОбновитьСписокДикторов()
	
	Элементы.ДикторГолосовогоМеню.СписокВыбора.Очистить();
	Элементы.ДикторГолосовогоМенюБезОтветственных.СписокВыбора.Очистить();
	
	Если ПоставщикУслуг = "CRT" Тогда
		
		// Для ЦРТ список можно скачать с сайта
		Попытка
			СписокДикторов = ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ЗагрузитьСписокДикторов();
			МИКО_стОбщегоНазначения.ЗаполнитьКоллекциюСвойств(Элементы.ДикторГолосовогоМеню.СписокВыбора, СписокДикторов);
			МИКО_стОбщегоНазначения.ЗаполнитьКоллекциюСвойств(Элементы.ДикторГолосовогоМенюБезОтветственных.СписокВыбора, СписокДикторов);
		Исключение
		КонецПопытки;
		
	ИначеЕсли ПоставщикУслуг = "Yandex" Тогда
		 
		ДикторыЯндекс = Новый СписокЗначений;
		ДикторыЯндекс.Добавить("jane",  "Жанна");
		ДикторыЯндекс.Добавить("omazh", "Василиса"); // гугл говорит, omazh - вассал )
		ДикторыЯндекс.Добавить("zahar", "Захар");
		ДикторыЯндекс.Добавить("ermil", "Ермил");
		
		МИКО_стОбщегоНазначения.ЗаполнитьКоллекциюСвойств(Элементы.ДикторГолосовогоМеню.СписокВыбора, ДикторыЯндекс);
		МИКО_стОбщегоНазначения.ЗаполнитьКоллекциюСвойств(Элементы.ДикторГолосовогоМенюБезОтветственных.СписокВыбора, ДикторыЯндекс);
		
	КонецЕсли;
	
КонецПроцедуры // ОбновитьСписокДикторов()
&НаСервере 
Процедура ОбновитьИнтерфейсФормы()
	
	// Управляем доступом к элементам управления голосового меню
	Элементы.ГруппаСинтезРечиДляГолосовогоМенюТело.Доступность = ИспользоватьСинтезРечиДляГолосовогоМеню;
	Элементы.СтраницаТекстIVR.Доступность = ИспользоватьСинтезРечиДляГолосовогоМеню;
	Элементы.СтраницаДополнительно.Доступность = ИспользоватьСинтезРечиДляГолосовогоМеню;
	Элементы.Сотрудники.Доступность = ИспользоватьСинтезРечиДляГолосовогоМеню;
	
	
	Если Элементы.Найти("СтраницаПояснение" + ПоставщикУслуг) <> Неопределено Тогда
		// Отображаем настройки поставщика
		Элементы.СтраницыПояснениеКПоставщикам.ТекущаяСтраница = Элементы["СтраницаПояснение" + ПоставщикУслуг];
	КонецЕсли; 
	
	Если ПоставщикУслуг = "CRT" Тогда
		Элементы.КлючAPI_Yandex.Видимость = Ложь;
		Элементы.КлючAPI_CRT.Видимость    = Истина;
	ИначеЕсли ПоставщикУслуг = "Yandex" Тогда	
		Элементы.КлючAPI_Yandex.Видимость = Истина;
		Элементы.КлючAPI_CRT.Видимость    = Ложь;
	КонецЕсли; 
	
КонецПроцедуры // ОбновитьИнтерфейсФормы()


