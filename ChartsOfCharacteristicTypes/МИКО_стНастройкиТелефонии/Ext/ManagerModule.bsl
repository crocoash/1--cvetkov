		ОбъектНастройки.Значение = вр_Парам;
		Попытка
			ОбъектНастройки.Записать();
		Исключение
			Возврат Ложь;	
		КонецПопытки; 
	КонецЕсли; 
	
	Настройка = МИКО_стОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.СтанцияMyPBX, "Значение");	
	Настройка = ?(НЕ ТипЗнч(Настройка)=Тип("Булево")ИЛИ НЕ ЗначениеЗаполнено(Настройка),Ложь,Настройка);
	Возврат Настройка = Истина;
	
КонецФункции // СтанцияMyPBX()

// Возврат количества цифр для ассоциации с контактом.
// 
Функция ПозицияЗагрузкиКодовГородов(вр_Парам = Неопределено) Экспорт 
	
	Если НЕ вр_Парам = Неопределено Тогда
		ОбъектНастройки = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПозицияЗагрузкиКодовГородов.ПолучитьОбъект();
		ОбъектНастройки.Значение = вр_Парам;
		Попытка
			ОбъектНастройки.Записать();
		Исключение
			Возврат Ложь;	
		КонецПопытки; 
	КонецЕсли; 
	Настройка = МИКО_стОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПозицияЗагрузкиКодовГородов, "Значение");	
	Настройка = ?(НЕ ТипЗнч(Настройка) = Тип("Число"), 1, Настройка);
	Возврат Настройка;
КонецФункции // КоличествоХранимыхЦифрТелефона()

// Дополнительные процедуры / функции.

// Поиск ссылки на Учетную запись АТС. Поиск производится по идентификатору линии.
// 
Функция ПолучитьПредставлениеТранкаПоИмени(Знач ИмяТранка) Экспорт
	Если НЕ ЗначениеЗаполнено(ИмяТранка) Тогда
		Возврат Справочники.МИКО_стУчетныеЗаписиАТС.ПустаяСсылка();
	КонецЕсли; 
	ИмяТранка = Врег(ИмяТранка);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИКО_стУчетныеЗаписиАТС.did,
		|	МИКО_стУчетныеЗаписиАТС.accountcode,
		|	МИКО_стУчетныеЗаписиАТС.Идентификатор,
		|	МИКО_стУчетныеЗаписиАТС.Ссылка
		|ИЗ
		|	Справочник.МИКО_стУчетныеЗаписиАТС КАК МИКО_стУчетныеЗаписиАТС";

	Результат = Запрос.Выполнить();
	ТекТранк = Результат.Выбрать();

	Пока ТекТранк.Следующий() Цикл
	 	Если ЗначениеЗаполнено(ТекТранк.did) И Врег(ТекТранк.did) = ИмяТранка Тогда
			Возврат ТекТранк.Ссылка;
		ИначеЕсли ЗначениеЗаполнено(ТекТранк.accountcode) И Врег(ТекТранк.accountcode) = ИмяТранка Тогда
			Возврат ТекТранк.Ссылка;
		ИначеЕсли ЗначениеЗаполнено(ТекТранк.Идентификатор) И Врег(ТекТранк.Идентификатор) = ИмяТранка Тогда
			Возврат ТекТранк.Ссылка;
		КонецЕсли; 
	КонецЦикла;	
	
	Возврат Справочники.МИКО_стУчетныеЗаписиАТС.ПустаяСсылка();
КонецФункции // ПолучитьПредставлениеТранкаПоИмени()

Функция ЭтоКаналФакса(Знач ИмяКанала) Экспорт
	Если НЕ ЗначениеЗаполнено(ИмяКанала) Тогда
		Возврат Ложь;
	КонецЕсли; 
	ИмяКанала = Врег(ИмяКанала);	
	врИменаТранков = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ИменаФаксов.ТаблицаЗначений.Выгрузить();
	
	Для каждого ТекТранк Из врИменаТранков Цикл
	 	Если Найти(ИмяКанала, Врег(ТекТранк.Представление))>0 Тогда
			Возврат Истина;
		КонецЕсли; 
	КонецЦикла;
	Возврат Ложь;
КонецФункции // ЭтоКаналФакса()
 
