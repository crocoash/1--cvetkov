// Возврат количества цифр для ассоциации с контактом.
// 
Функция КоличествоХранимыхЦифрТелефона(вр_Парам = Неопределено, ПоУмолчанию = Ложь) Экспорт 
	Если ПоУмолчанию = Истина Тогда
		Возврат 9;	
	КонецЕсли; 
	
	Если НЕ вр_Парам = Неопределено Тогда
		ОбъектНастройки = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.КоличествоХранимыхЦифрТелефона.ПолучитьОбъект();
		ОбъектНастройки.Значение = вр_Парам;
		Попытка
			ОбъектНастройки.Записать();
		Исключение
			Возврат Ложь;	                                            
		КонецПопытки; 
	КонецЕсли;                                          
	Настройка = МИКО_стОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.КоличествоХранимыхЦифрТелефона, "Значение");	
	Настройка = ?(НЕ ТипЗнч(Настройка) = Тип("Число") ИЛИ Настройка = 0, 9,Настройка);
	Возврат Настройка;
КонецФункции // КоличествоХранимыхЦифрТелефона()

