// Поиск идентификаторов в логах звонков.
// 
Функция НайтиИдентификаторыЛиний(UID=Неопределено) Экспорт

	масс_ACCOUNTCODE= Новый Массив;	
	масс_DID 		= Новый Массив;	
	масс_ID 		= Новый Массив;	
	масс_ID_account	= Новый Массив;	

	ИД_Линий = Новый Структура("DID,ID,ACCOUNTCODE,ID_account",масс_DID,масс_ID,масс_ACCOUNTCODE,масс_ID_account);
  	ИдентификаторыЛиний = "";
	
	Результат = Новый Структура("ИД_Линий,ИдентификаторыПредставление",ИД_Линий,ИдентификаторыЛиний);
	Попытка
		врМИКО_стСлужебный = Вычислить("МИКО_стСлужебный");
	Исключение
		Возврат Результат;
	КонецПопытки; 
	
	Если СтанцияMyPBX() = Истина Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ВЫБОР
			|		КОГДА МИКО_стИсторияЗвонковCDR.calltype = ""Inbound""
			|			ТОГДА МИКО_стИсторияЗвонковCDR.srctrunk
			|		КОГДА МИКО_стИсторияЗвонковCDR.calltype = ""Outbound""
			|			ТОГДА МИКО_стИсторияЗвонковCDR.dstrunk
			|	КОНЕЦ КАК Trunk
			|ИЗ
			|	РегистрСведений.МИКО_стMyPBX_Asteriskcdr КАК МИКО_стИсторияЗвонковCDR
			|//UID ГДЕ
			|//UID 	МИКО_стИсторияЗвонковCDR.uniqueid_pt1c = &UID
			|
			|СГРУППИРОВАТЬ ПО
			|	ВЫБОР
			|		КОГДА МИКО_стИсторияЗвонковCDR.calltype = ""Inbound""
			|			ТОГДА МИКО_стИсторияЗвонковCDR.srctrunk
			|		КОГДА МИКО_стИсторияЗвонковCDR.calltype = ""Outbound""
			|			ТОГДА МИКО_стИсторияЗвонковCDR.dstrunk
			|	КОНЕЦ";
		Если UID<>Неопределено Тогда
			Запрос.УстановитьПараметр("UID", UID);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "//UID","");
		КонецЕсли; 	
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
		 	Возврат Результат;
		КонецЕсли;
		
		Выборка   = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			масс_ID.Добавить(Выборка.Trunk);
		КонецЦикла;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	МИКО_стИсторияЗвонковCDR.channel,
			|	МИКО_стИсторияЗвонковCDR.dstchannel,
			|	МИКО_стИсторияЗвонковCDR.accountcode,
			|	МИКО_стИсторияЗвонковCDR.origextension,
			|	МИКО_стИсторияЗвонковCDR.did
			|ИЗ
			|	РегистрСведений.МИКО_стИсторияЗвонковCDR КАК МИКО_стИсторияЗвонковCDR
			|//UID ГДЕ
			|//UID	МИКО_стИсторияЗвонковCDR.UID = &UID";
		Если UID<>Неопределено Тогда
			Запрос.УстановитьПараметр("UID", UID);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "//UID","");
		КонецЕсли; 	
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Запрос.Текст = "ВЫБРАТЬ
			               |	МИКО_стИсторияЗвонковAskozia.src_chan КАК channel,
			               |	МИКО_стИсторияЗвонковAskozia.dst_chan КАК dstchannel,
			               |	МИКО_стИсторияЗвонковAskozia.did КАК did,
			               |	"""" КАК accountcode,
			               |	"""" КАК origextension
			               |ИЗ
			               |	РегистрСведений.МИКО_стИсторияЗвонковAskozia КАК МИКО_стИсторияЗвонковAskozia
						   |ГДЕ
						   |	МИКО_стИсторияЗвонковAskozia.UID = &UID";
			РезультатЗапроса = Запрос.Выполнить();
		КонецЕсли; 
		
		Если РезультатЗапроса.Пустой() Тогда
		 	Возврат Результат;
		КонецЕсли; 
		Префиксы_ID = Новый Массив;
		Префиксы_ID.Добавить("SIP");
		Префиксы_ID.Добавить("IAX");
		Префиксы_ID.Добавить("DAHDI");
		
		Выборка   = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
	     	Если ЗначениеЗаполнено(Выборка.did) И масс_DID.Найти(Выборка.did) = Неопределено Тогда
			   	масс_DID.Добавить(Выборка.did);
			КонецЕсли;
	     	Если ЗначениеЗаполнено(Выборка.origextension) И масс_DID.Найти(Выборка.origextension) = Неопределено Тогда
			   	масс_DID.Добавить(Выборка.origextension);
			КонецЕсли;
	     	Если ЗначениеЗаполнено(Выборка.accountcode) И масс_ACCOUNTCODE.Найти(Выборка.accountcode) = Неопределено Тогда
			   	масс_ACCOUNTCODE.Добавить(Выборка.accountcode);
			КонецЕсли;
			
			Для каждого врПрефикс Из Префиксы_ID Цикл
				Если Найти(Выборка.channel, врПрефикс + "/")>0 Тогда
					вр_ID = врМИКО_стСлужебный.ПолучитьИмяУчеткиИзКанала(Выборка.channel);
					Если СтрДлина(вр_ID)>4 И масс_ID.Найти(вр_ID) = Неопределено Тогда
						масс_ID.Добавить(вр_ID);
					ИначеЕсли СтрДлина(вр_ID)>0 И СтрДлина(вр_ID)<5 И масс_ID_account.Найти(вр_ID) = Неопределено Тогда
						масс_ID_account.Добавить(вр_ID);	
					КонецЕсли; 
				КонецЕсли; 
				Если Найти(Выборка.dstchannel, врПрефикс + "/")>0 Тогда
					вр_ID = врМИКО_стСлужебный.ПолучитьИмяУчеткиИзКанала(Выборка.dstchannel);
					Если СтрДлина(вр_ID)>4 И масс_ID.Найти(вр_ID) = Неопределено Тогда
						масс_ID.Добавить(вр_ID);
					ИначеЕсли СтрДлина(вр_ID)>0 И СтрДлина(вр_ID)< 5 И масс_ID_account.Найти(вр_ID) = Неопределено Тогда
						масс_ID_account.Добавить(вр_ID);	
					КонецЕсли;
				КонецЕсли; 
			КонецЦикла; 
		КонецЦикла;
		
	КонецЕсли;
	
	ИД_Линий.Вставить("DID",масс_DID);
	ИД_Линий.Вставить("ACCOUNTCODE",масс_ACCOUNTCODE);
	ИД_Линий.Вставить("ID",масс_ID);
	ИД_Линий.Вставить("ID_account",масс_ID_account);
	
	Рез_ID = "";
	Для каждого вр_ID Из ИД_Линий.ID Цикл
	 	Рез_ID = Рез_ID + Символы.ПС + вр_ID;
	КонецЦикла;
	Если НЕ Рез_ID = "" Тогда
		ИдентификаторыЛиний = ИдентификаторыЛиний + Символы.ПС + "#####################################################################" + Символы.ПС;
		ИдентификаторыЛиний = ИдентификаторыЛиний + "Идентификаторы каналов:" + Символы.ПС;
	  	ИдентификаторыЛиний = ИдентификаторыЛиний + Рез_ID;
	КонецЕсли; 
	
	Рез_ACCOUNTCODE = "";
	Для каждого вр_ACCOUNTCODE Из ИД_Линий.ACCOUNTCODE Цикл
	 	Рез_ACCOUNTCODE = Рез_ACCOUNTCODE + Символы.ПС + вр_ACCOUNTCODE;
	КонецЦикла;
	Если НЕ Рез_ACCOUNTCODE = "" Тогда
		ИдентификаторыЛиний = ИдентификаторыЛиний + Символы.ПС + "#####################################################################" + Символы.ПС;
		ИдентификаторыЛиний = ИдентификаторыЛиний + "Accountcode:" + Символы.ПС;
	  	ИдентификаторыЛиний = ИдентификаторыЛиний + Рез_ACCOUNTCODE;
	КонецЕсли; 

	Рез_DID = "";
    Для каждого вр_DID Из ИД_Линий.DID Цикл
	 	Рез_DID = Рез_DID + Символы.ПС + вр_DID;
	КонецЦикла;
	Если НЕ Рез_DID = "" Тогда
		ИдентификаторыЛиний = ИдентификаторыЛиний + Символы.ПС + "#####################################################################" + Символы.ПС;
		ИдентификаторыЛиний = ИдентификаторыЛиний + "DID номера (номера, на котороые звонит клиент):" + Символы.ПС;
	  	ИдентификаторыЛиний = ИдентификаторыЛиний + Рез_DID;
	КонецЕсли;
	
	Рез_ID_account = "";
    Для каждого вр_ID_account Из ИД_Линий.ID_account Цикл
	 	Рез_ID_account = Рез_ID_account + Символы.ПС + вр_ID_account;
	КонецЦикла;
	Если НЕ Рез_ID_account = "" Тогда
		ИдентификаторыЛиний = ИдентификаторыЛиний + Символы.ПС + "#####################################################################" + Символы.ПС;
		ИдентификаторыЛиний = ИдентификаторыЛиний + "ID_account (внутренние номера):" + Символы.ПС;
	  	ИдентификаторыЛиний = ИдентификаторыЛиний + Рез_ID_account;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Рез_DID + Рез_ACCOUNTCODE + Рез_ID + Рез_ID_account) Тогда
	 	ИдентификаторыЛиний = "Идентификаторы не найдены...";
	КонецЕсли; 
	
	Результат = Новый Структура("ИД_Линий,ИдентификаторыПредставление",ИД_Линий,ИдентификаторыЛиний);
	Возврат Результат;
	
КонецФункции // НайтиИдентификаторыЛиний()

// #КонецОбласти
