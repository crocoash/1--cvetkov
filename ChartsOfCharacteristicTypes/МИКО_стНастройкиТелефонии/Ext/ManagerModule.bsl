Функция ВнешниеНомера(вр_Парам = Неопределено) Экспорт
	Если НЕ вр_Парам = Неопределено Тогда
		ОбъектНастройки = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ВнешниеНомера.ПолучитьОбъект();
		ОбъектНастройки.ТаблицаЗначений.Загрузить(вр_Парам);
		Попытка
			ОбъектНастройки.Записать();
		Исключение
			Возврат Ложь;	
		КонецПопытки; 
	КонецЕсли; 
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИКО_стНастройкиТелефонииТаблицаЗначений.Ссылка,
		|	МИКО_стНастройкиТелефонииТаблицаЗначений.НомерСтроки,
		|	МИКО_стНастройкиТелефонииТаблицаЗначений.Значение,
		|	МИКО_стНастройкиТелефонииТаблицаЗначений.Представление,
		|	МИКО_стНастройкиТелефонииТаблицаЗначений.did,
		|	МИКО_стНастройкиТелефонииТаблицаЗначений.accountcode
		|ИЗ
		|	ПланВидовХарактеристик.МИКО_стНастройкиТелефонии.ТаблицаЗначений КАК МИКО_стНастройкиТелефонииТаблицаЗначений
		|ГДЕ
		|	МИКО_стНастройкиТелефонииТаблицаЗначений.Ссылка = ЗНАЧЕНИЕ(ПланВидовХарактеристик.МИКО_стНастройкиТелефонии.ВнешниеНомера)";
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Значение");
	
	Возврат Результат;
