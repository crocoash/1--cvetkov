// Установка регистрационного номера МИКО для профилей.
// 
Процедура КлючЗащитыПриИзменении(Элемент)
	КлючЗащиты = СокрЛП(КлючЗащиты);
	
	НеСохранятьРегНомер = Ложь;
	Если Найти(КлючЗащиты, "MIKOUPD")>0 Тогда
		МИКО_стОбщегоНазначенияКлиент.СообщитьПользователю("""Для активации купона """+КлючЗащиты+""" необходимо выполнить регистрацию продукукта. Активация купона выполняется на вкладке ""Применить купон"".""");
		НеСохранятьРегНомер = Истина;
		КлючКупон  = КлючЗащиты;
		КлючЗащиты = "";
	КонецЕсли; 

	Если ЗначениеЗаполнено(КлючЗащиты) И Найти(КлючЗащиты, "MIKO-")<>1 Тогда
		МИКО_стОбщегоНазначенияКлиент.СообщитьПользователю("""Введен не корректный регистрационный номер - """+КлючЗащиты+""".""");
		КлючЗащиты = "";
		НеСохранятьРегНомер = Истина;
	КонецЕсли; 
	
	// MIKO-XXX
	Оповестить("MIKO_GetSetTrialLicense_stat", КлючЗащиты, ЭтаФорма);
	Элементы.грРегистрация.Видимость = НЕ ЗначениеЗаполнено(КлючЗащиты); 
	///
	// Регистрация лицензии
	Оповестить("MIKO_RefreshLicense_stat", Неопределено, ЭтаФорма);
	СохранятьНастройки = Истина;
	
КонецПроцедуры

