// 
Процедура ПолучитьCDR(Команда)
	Если НЕ ИспользоватьМодульСтатистики Тогда Возврат;	КонецЕсли; 
	Попытка
		врМИКО_стСлужебный = Вычислить("МИКО_стСлужебный");
	Исключение
		Возврат;
	КонецПопытки; 
