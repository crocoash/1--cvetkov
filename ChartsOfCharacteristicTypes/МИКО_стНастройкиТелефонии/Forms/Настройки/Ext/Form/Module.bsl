// Описание учетных записей факсов.
// 
Процедура ИменаФаксовЗначениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ИменаФаксов.ТекущиеДанные;
