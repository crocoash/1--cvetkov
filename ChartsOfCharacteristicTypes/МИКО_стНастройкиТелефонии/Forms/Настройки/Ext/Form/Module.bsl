	ОстатокДнейЛицензии = 0;
	// Пример ответа от сервера лицензирования МИКО                                        
    ЭлементыUl = ДокументDOM.ПолучитьЭлементыПоИмени("saaslicenseinfo");
	Если ЭлементыUl.Количество()=0 Тогда
	 	Возврат ОтветСервера;
	КонецЕсли;
	ТекЭлемент_hasp = ЭлементыUl[0];
	
	ДополнительнаяИнформация = Новый Структура;
	ДополнительнаяИнформация.Вставить("key", 		ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "key") );
	ДополнительнаяИнформация.Вставить("companyname",ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "companyname") );
	ДополнительнаяИнформация.Вставить("contact", 	ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "contact") );
	ДополнительнаяИнформация.Вставить("email", 		ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "email") );
	ДополнительнаяИнформация.Вставить("tel", 		ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "tel") );
	ДополнительнаяИнформация.Вставить("activated", 	ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "activated") = "1");
	version = ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "version");
	
	Продукты = Новый Массив;
	products = ТекЭлемент_hasp.ПолучитьЭлементыПоИмени("product");
	Для каждого product Из products Цикл
		врПродукт = Новый Структура("name,id,trial,expired,feature");
		name  = ЗначениеАтрибутаDOM(product.Атрибуты, "name");
		ID    = ЗначениеАтрибутаDOM(product.Атрибуты, "id");
		trial = ЗначениеАтрибутаDOM(product.Атрибуты, "trial");
		
		врПродукт.Вставить("name",	name);
		врПродукт.Вставить("id",	ID);
		врПродукт.Вставить("trial",	trial);
		
		expired  	 = ЗначениеАтрибутаDOM(product.Атрибуты, "expired");
		дата_expired = ПреобразоватьВДату(СтрЗаменить(СтрЗаменить(СтрЗаменить(expired,"-","")," ",""),":",""));
		Если ID = ИдентификаторПродукта Тогда
			Если expired = "" И trial = "0" Тогда
			 	ОстатокДнейЛицензии = 0;
			ИначеЕсли ОстатокДнейЛицензии <> 0 И ЗначениеЗаполнено(дата_expired) Тогда
				врОстатокДнейЛицензии = (дата_expired - ТекущаяДата())/(24*60*60);
				ОстатокДнейЛицензии = ?(ОстатокДнейЛицензии > 0, ОстатокДнейЛицензии + врОстатокДнейЛицензии, врОстатокДнейЛицензии);
			КонецЕсли; 
		КонецЕсли; 
		врПродукт.Вставить("expired",	дата_expired);
		
		feature = Новый Массив;
		элfeature = product.ПолучитьЭлементыПоИмени("feature");  	
		Для каждого тек_feature Из элfeature Цикл
			name   	 = ЗначениеАтрибутаDOM(тек_feature.Атрибуты, "name");
			count 	 = ЗначениеАтрибутаDOM(тек_feature.Атрибуты, "count");
			captured = ЗначениеАтрибутаDOM(тек_feature.Атрибуты, "captured");
			counteach= ЗначениеАтрибутаDOM(тек_feature.Атрибуты, "counteach");
			
			врfeature = Новый Структура("name,count,captured,counteach", name,count,captured,counteach);
			feature.Добавить(врfeature);
		КонецЦикла; 
		врПродукт.Вставить("feature",	feature);
		
		Продукты.Добавить(врПродукт);
	КонецЦикла; 
		
	ДополнительнаяИнформация.Вставить("Продукты",		Продукты);
	ОтветСервера.Вставить("ОстатокДнейЛицензии", 		ОстатокДнейЛицензии);
	ОтветСервера.Вставить("ДополнительнаяИнформация", 	ДополнительнаяИнформация);
	ОтветСервера.Вставить("РегистрационныйНомер", 		ДополнительнаяИнформация.key);
	ОтветСервера.Вставить("ТипЛицензии", 				"MIKO SaaS");
	ОтветСервера.Вставить("version", 					version);
	
	Возврат ОтветСервера;
КонецФункции // ПолучитьСведенияПоКлючамЗащитыМИКО()

