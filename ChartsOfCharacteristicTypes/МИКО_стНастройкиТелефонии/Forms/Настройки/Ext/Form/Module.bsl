///
// Заполнение формы регистрации.

&НаКлиенте
// Обработка выбора органиции для заполнения формы регистрации.
// 
Процедура НаименованиеКомпанииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ПроверитьОрганизацию() Тогда
		СписокОрганизаций = ПолучитьСписокОрганизаций();
		
		Если ВерсияПлатформы = "8.3" Тогда
			ОписаниеОповещения = Вычислить("Новый ОписаниеОповещения(""ВыборОрганизации"", ЭтаФорма)");
			Попытка
				Выполнить("ПоказатьВыборИзСписка(ОповещениеОбработкиВыбора,СписокОрганизаций,Элемент)");
			Исключение
				Возврат;
			КонецПопытки; 
			
		ИначеЕсли ВерсияПлатформы = "8.2" Тогда
			ВыбратьИзСписка(СписокОрганизаций,Элемент);			
		КонецЕсли; 
	КонецЕсли; 
КонецПроцедуры

&НаСервереБезКонтекста
// Получаем список выбора организаций.
// 
Функция ПолучитьСписокОрганизаций()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации";
	
	массОрганизации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	СписокОрганизаций = Новый СписокЗначений; 
	СписокОрганизаций.ЗагрузитьЗначения(массОрганизации);
	Возврат СписокОрганизаций;
КонецФункции // ПолучитьСписокОрганизаций()
 
&НаКлиенте
// Обработчик выбора организации
// 
Процедура ВыборОрганизации(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	ВыполнитьЗаполнениеСервер(ВыбранноеЗначение.Значение);
КонецПроцедуры

&НаСервере
// Заполнение формы по данным организации.
// Параметры:
//   СсылкаНаОрганизацию - Ссылка на элемент справочника "Организации".
// 
Процедура ВыполнитьЗаполнениеСервер(СсылкаНаОрганизацию = Неопределено)
	ПараметрыОрганизации = Неопределено;
	Если НЕ ПроверитьОрганизацию(СсылкаНаОрганизацию, ПараметрыОрганизации) Тогда
		// не нашли организацию.
		Возврат;
	КонецЕсли;
	
	Данные = Новый Структура("ФИОКонтактногоЛица,НаименованиеКомпании,ИНН,НомерТелефона,ЭлектронныйАдрес,Комментарий");
	
	// Заполним основные сведения об организиции	
	ДанныеЗаполнения = Новый Структура("Наименование,НаименованиеПолное,ИНН");
	ЗаполнитьЗначенияСвойств(ДанныеЗаполнения, СсылкаНаОрганизацию);
	Данные.Вставить("НаименованиеКомпании", ?(ЗначениеЗаполнено(ДанныеЗаполнения.НаименованиеПолное),ДанныеЗаполнения.НаименованиеПолное,ДанныеЗаполнения.Наименование));
	Данные.Вставить("ИНН",			ДанныеЗаполнения.ИНН);
	
	Если ПараметрыОрганизации.ЕстьТаблицаКИ = Истина Тогда
		пТелефон = ПредопределенноеЗначение(("Перечисление.ТипыКонтактнойИнформации.Телефон"));
		пЭлАдрес = ПредопределенноеЗначение(("Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты"));
		пАдрес 	 = ПредопределенноеЗначение(("Перечисление.ТипыКонтактнойИнформации.Адрес"));
		
		ИскомыеТипы = Новый Массив;
		ИскомыеТипы.Добавить(пТелефон);
		ИскомыеТипы.Добавить(пЭлАдрес);
		ИскомыеТипы.Добавить(пАдрес);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ОрганизацииКонтактнаяИнформация.Тип,
			|	ОрганизацииКонтактнаяИнформация.Представление
			|ИЗ
			|	Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформация
			|ГДЕ
			|	ОрганизацииКонтактнаяИнформация.Тип В(&ИскомыеТипы)";
		
		Запрос.УстановитьПараметр("ИскомыеТипы", ИскомыеТипы);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.Тип = пТелефон Тогда
				Данные.Вставить("НомерТелефона", 		Выборка.Представление);
			ИначеЕсли Выборка.Тип = пЭлАдрес Тогда	
				Данные.Вставить("ЭлектронныйАдрес",		Выборка.Представление);
			ИначеЕсли Выборка.Тип = пАдрес Тогда	
				Данные.Вставить("Комментарий",	Выборка.Представление);
			КонецЕсли; 
		КонецЦикла;
	КонецЕсли; 
	Данные.Вставить("ФИОКонтактногоЛица",		ИмяПользователя());
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Данные);
КонецПроцедуры // ВыполнитьЗаполнениеСервер()

&НаСервере
// Проверка / подготовка данных к заполнению.
//
Функция ПроверитьОрганизацию(СсылкаНаОрганизацию = Неопределено, ПараметрыОрганизации = Неопределено)
	ПараметрыОрганизации = Новый Структура;
	ПараметрыОрганизации.Вставить("СправочникСуществует", 			Ложь);
	ПараметрыОрганизации.Вставить("ЕстьТаблицаКИ", 					Ложь);
	                                            
	мОрганизации = Метаданные.Справочники.Найти("Организации");
	Если мОрганизации = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли; 
	ПараметрыОрганизации.Вставить("СправочникСуществует", 	Истина);
	
	Если НЕ мОрганизации.ТабличныеЧасти.Найти("КонтактнаяИнформация") = Неопределено Тогда
		ПараметрыОрганизации.Вставить("ЕстьТаблицаКИ", 		Истина);
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(СсылкаНаОрганизацию) Тогда
	  	СсылкаНаОрганизацию = Справочники["Организации"].НайтиПоНаименованию("");
	КонецЕсли; 
	Возврат ЗначениеЗаполнено(СсылкаНаОрганизацию);
КонецФункции 

