Функция ActivateCoupone82(sCoupone) 
	Если НЕ ЗначениеЗаполнено(sCoupone) Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если Компонент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("sCoupone", Строка(sCoupone));
	СтруктураПараметров.Вставить("result", "");

	Попытка
