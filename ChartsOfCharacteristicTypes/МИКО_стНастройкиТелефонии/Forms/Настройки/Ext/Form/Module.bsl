&НаСервере
// Разбор конфигурационного файла Askozia.
// 
Процедура ЗагрузитьИзФайлаНаСервере(Данные)
	ВремФайл = ПолучитьИмяВременногоФайла("xml");
	Попытка
		
		Если ЭтоАдресВременногоХранилища(Данные) Тогда
			ДД = ПолучитьИзВременногоХранилища(Данные);
		Иначе
			ДД = Данные;
		КонецЕсли; 
		
		Если ТипЗнч(ДД) = Тип("ДвоичныеДанные") Тогда
			ДД.Записать(ВремФайл);
			ЧтениеXML = Новый ЧтениеXML; ПостроительDOM = Новый ПостроительDOM; 
			ЧтениеXML.ОткрытьФайл(ВремФайл);
			ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		ИначеЕсли ТипЗнч(ДД) = Тип("ДокументDOM") ИЛИ ТипЗнч(ДД) = Тип("ДокументHTML") Тогда
			ДокументDOM = ДД;
		ИначеЕсли ТипЗнч(ДД) = Тип("Строка") Тогда
			ЧтениеHTML 	 	= Новый ЧтениеHTML;	
			ПостроительDOM 	= Новый ПостроительDOM; 
			ЧтениеHTML.УстановитьСтроку(ДД);
			ДокументDOM = ПостроительDOM.Прочитать(ЧтениеHTML);	
		Иначе 
			Возврат;
		КонецЕсли; 
	Исключение
		// Не вышло передать данные на сервер!
		МИКО_стОбщегоНазначенияСервер.СообщитьПользователю("Не вышло передать данные на сервер!");
		Возврат;
	КонецПопытки;
	
	
	Тип = "provider";
	СписокЭлементовDOM = ДокументDOM.ПолучитьЭлементыПоИмени(Тип);
	Для Каждого ЭлементDOM Из СписокЭлементовDOM Цикл
		Если ЭлементDOM.РодительскийУзел.ИмяУзла <> "sip" Тогда
			Продолжить;
		КонецЕсли; 
		// имя учетной записи
		name	= ЭлементDOM.ПолучитьЭлементыПоИмени("name");
		Если name.Количество()=0 Тогда
			Продолжить;
		КонецЕсли; 
		name = name[0].ТекстовоеСодержимое;
		
		// идентификатор
		uniqid 	= ЭлементDOM.ПолучитьЭлементыПоИмени("uniqid");
		Если uniqid.Количество()=0 Тогда
			Продолжить;
		КонецЕсли; 
		uniqid = uniqid[0].ТекстовоеСодержимое;
		
		ЗагрузитьУчетнуюЗапись(name, uniqid, Тип);
	КонецЦикла;
	
	Тип = "fax";
	СписокЭлементовDOM = ДокументDOM.ПолучитьЭлементыПоИмени(Тип);
	Для Каждого ЭлементDOM Из СписокЭлементовDOM Цикл
		// имя учетной записи
		name	= ЭлементDOM.ПолучитьЭлементыПоИмени("callerid");
		Если name.Количество()=0 Тогда
			Продолжить;
		КонецЕсли; 
		name = name[0].ТекстовоеСодержимое;
		
		// идентификатор
		uniqid 	= ЭлементDOM.ПолучитьЭлементыПоИмени("uniqid");
		Если uniqid.Количество()=0 Тогда
			Продолжить;
		КонецЕсли; 
		uniqid = uniqid[0].ТекстовоеСодержимое;
		
		ЗагрузитьУчетнуюЗапись(name, uniqid, Тип);
	КонецЦикла;
			
КонецПроцедуры
&НаСервере
// Создаем учетные записи АТС.
// 
Процедура ЗагрузитьУчетнуюЗапись(Наименование, Идентификатор, Тип)

  	УчЗапись = Справочники.МИКО_стУчетныеЗаписиАТС.НайтиПоРеквизиту("Идентификатор", Идентификатор);
  	Если УчЗапись = Справочники.МИКО_стУчетныеЗаписиАТС.ПустаяСсылка() Тогда			
		УчЗапись = Справочники.МИКО_стУчетныеЗаписиАТС.СоздатьЭлемент();
		УчЗапись.Идентификатор = Идентификатор;
		УчЗапись.Наименование  = Наименование;
		Попытка
		  	УчЗапись.Записать();
		Исключение
			МИКО_стОбщегоНазначенияСервер.СообщитьПользователю("Не вышло загрузить учетную запись ("+ Наименование +"), " + Идентификатор);
			Возврат;
		КонецПопытки; 
	КонецЕсли; 
	
	Если Тип = "fax" Тогда
	  	ИмяТаблицы = "ИменаФаксов";
	ИначеЕсли Тип = "provider" Тогда 	
	  	ИмяТаблицы = "ИменаТранков";
	Иначе 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИКО_стУчетныеЗаписиАТС.Ссылка
		|ИЗ
		|	Справочник.МИКО_стУчетныеЗаписиАТС КАК МИКО_стУчетныеЗаписиАТС
		|ГДЕ
		|	МИКО_стУчетныеЗаписиАТС.Идентификатор = &Идентификатор";

	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	УчЗаписи = Запрос.Выполнить().Выгрузить();
	Если УчЗаписи.Количество()=0 Тогда
		СтрУчЗапись = ЭтаФорма[ИмяТаблицы].Добавить();
		СтрУчЗапись.Представление 	= Идентификатор;
		СтрУчЗапись.Значение 	  	= УчЗапись.Ссылка;
	КонецЕсли;
	
КонецПроцедуры	

