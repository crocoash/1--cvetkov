&НаСервере  
Функция ПолучитьСведенияSentinelHasp(ДокументDOM)
	ОтветСервера = Новый Структура("HASP_ОстатокДнейЛицензии,HASP_ТипЛицензии,HASP_РегистрационныйНомер,HASP_ДополнительнаяИнформация",-1,"","",Новый Структура);

	ТаблицаКлючей = Новый ТаблицаЗначений;
	ТаблицаКлючей.Колонки.Добавить("id");
	ТаблицаКлючей.Колонки.Добавить("feature_id");
	ТаблицаКлючей.Колонки.Добавить("license_type");
	ТаблицаКлючей.Колонки.Добавить("count_days");
	ТаблицаКлючей.Колонки.Добавить("type");
	
	// Получить перечень страниц
    ЭлементыUl = ДокументDOM.ПолучитьЭлементыПоИмени("hasp");
	Если ЭлементыUl.Количество()=0 Тогда
	 	Возврат ОтветСервера;
	КонецЕсли; 
	
    ВсегоДнейОсталось = 0;
    Для каждого ТекЭлемент_hasp Из ЭлементыUl Цикл
        // <?xml version="1.0" encoding="UTF-8" ?>
        // <hasp_info>
        //  <license_manager>
        //	<hostname>VCENTER</hostname>
        //	<ip>172.16.32.6</ip>
        //	<osname>Microsoft Windows Server 2003</osname>
        //	<hasp id="13542686473463621" type="HASP-SL-AdminMode">
        //	  <feature id="2">
        //		<license>
        //		  <license_type>perpetual</license_type>
        //		</license>
        //	  </feature>
        //	</hasp>
        //  </license_manager>
        // </hasp_info>.
        АтрибутType = ТекЭлемент_hasp.Атрибуты.ПолучитьИменованныйЭлемент("type");
        АктивацияType = ?(АтрибутType = Неопределено,"",АтрибутType.Значение);
        id = ТекЭлемент_hasp.Идентификатор;
        
        Элементы_feature = ТекЭлемент_hasp.ПолучитьЭлементыПоИмени("feature");
        Для каждого ТекЭлементUl Из Элементы_feature Цикл
            feature_id = ТекЭлементUl.Идентификатор;
            

			эл_license_type = ТекЭлементUl.ПолучитьЭлементыПоИмени("license_type");
            license_type = ?(эл_license_type.Количество()=0,"",эл_license_type[0].ТекстовоеСодержимое);
            Если license_type = "perpetual" Тогда
                ОстатокДнейЛицензии = 0;
                ВсегоДнейОсталось = 999;
            Иначе	

				эл_time_start = ТекЭлементUl.ПолучитьЭлементыПоИмени("time_start");
                time_start = ?(эл_time_start.Количество()=0,"",эл_time_start[0].ТекстовоеСодержимое);
                time_start = ?(НРег(time_start) = "uninitialized","0",time_start);

				эл_total_time = ТекЭлементUl.ПолучитьЭлементыПоИмени("total_time");
                total_time = ?(эл_total_time.Количество()=0,"",эл_total_time[0].ТекстовоеСодержимое);
                Попытка
                    ТекущееВремяВФорматеUnix 	= МестноеВремя(Текущаядата())-'19700101';
                    ВремяОКончанияДействияКлюча	= ?(time_start="0",ТекущееВремяВФорматеUnix,Число(time_start)) + Число(total_time);
                    
                    ОстатокДнейЛицензии 		= Цел((ВремяОКончанияДействияКлюча-ТекущееВремяВФорматеUnix)/86400);
                    ВсегоДнейОсталось = ВсегоДнейОсталось + ОстатокДнейЛицензии;
                Исключение
                    ОстатокДнейЛицензии = 0;
                    Продолжить;
                КонецПопытки; 
                ОстатокДнейЛицензии = ОстатокДнейЛицензии;
            КонецЕсли; 
            
            СтрокаКлюча = ТаблицаКлючей.Добавить();
            СтрокаКлюча.id 			= id;
            СтрокаКлюча.license_type= license_type; 
            СтрокаКлюча.count_days 	= ОстатокДнейЛицензии;
            СтрокаКлюча.type 		= АктивацияType;
            СтрокаКлюча.feature_id  = feature_id;
        КонецЦикла	
    КонецЦикла;
	
	Если ТаблицаКлючей = Неопределено Тогда
		Возврат ОтветСервера;
	КонецЕсли;
	
	Ключ_perpetual = ТаблицаКлючей.Найти("perpetual", "license_type");
	Если НЕ Ключ_perpetual = Неопределено Тогда
		ОтветСервера.HASP_ОстатокДнейЛицензии = 0;
		ОтветСервера.HASP_ТипЛицензии		 = Ключ_perpetual.type;
		ОтветСервера.HASP_РегистрационныйНомер= Ключ_perpetual.id;
		Возврат ОтветСервера;
	КонецЕсли;
			
	Для каждого Ключ_trial Из ТаблицаКлючей Цикл
		Если НЕ ТипЗнч(Ключ_trial.count_days) = Тип("Число") 
			 ИЛИ НЕ Ключ_trial.license_type = "trial" 
			 ИЛИ Ключ_trial.count_days  <= 0 Тогда
			Продолжить;
		КонецЕсли; 	
		ОтветСервера.HASP_ОстатокДнейЛицензии = Ключ_trial.count_days;
		ОтветСервера.HASP_ТипЛицензии		 = Ключ_trial.type;
		ОтветСервера.HASP_РегистрационныйНомер= Ключ_trial.id;
		Возврат ОтветСервера;
	КонецЦикла; 

	Если ТаблицаКлючей.Количество()>0
		 И ОтветСервера.HASP_РегистрационныйНомер = "" Тогда
		Ключ_trial = ТаблицаКлючей[0]; 
		ОтветСервера.HASP_ОстатокДнейЛицензии = Ключ_trial.count_days;
		ОтветСервера.HASP_ТипЛицензии		 = Ключ_trial.type;
		ОтветСервера.HASP_РегистрационныйНомер= Ключ_trial.id;
		Возврат ОтветСервера;	
	КонецЕсли; 
КонецФункции // ПолучитьСведенияSentinelHasp()
&НаСервере  
Функция ПолучитьСведенияПоКлючамЗащитыМИКО(ДокументDOM)
	ОтветСервера = Новый Структура("ОстатокДнейЛицензии,ТипЛицензии,РегистрационныйНомер,ДополнительнаяИнформация", -1,"","",Новый Структура);
    ЭлементыUl = ДокументDOM.ПолучитьЭлементыПоИмени("licenseinfo");
	Если ЭлементыUl.Количество()=0 Тогда
		ОтветСервера = ПолучитьСведенияПоКлючамЗащитыМИКО_v2(ДокументDOM);
		Возврат ОтветСервера;
	КонецЕсли;
	ТекЭлемент_hasp = ЭлементыUl[0];
	
	ДополнительнаяИнформация = Новый Структура;
	ДополнительнаяИнформация.Вставить("key", 		ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "key") );
	ДополнительнаяИнформация.Вставить("expired", 	ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "expired") );
	ДополнительнаяИнформация.Вставить("companyname",ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "companyname") );
	ДополнительнаяИнформация.Вставить("contact", 	ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "contact") );
	ДополнительнаяИнформация.Вставить("email", 		ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "email") );
	ДополнительнаяИнформация.Вставить("tel", 		ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "tel") );
	ДополнительнаяИнформация.Вставить("activated", 	ЗначениеАтрибутаDOM(ТекЭлемент_hasp.Атрибуты, "activated") = "1");
	
	expired = ПреобразоватьВДату(СтрЗаменить(ДополнительнаяИнформация.expired,"-",""));	
	Если ЗначениеЗаполнено(expired) Тогда
		ОстатокДнейЛицензии = (expired - ТекущаяДата())/(24*60*60);
	Иначе
		ОстатокДнейЛицензии = 0;
	КонецЕсли; 
	
	Продукты = Новый Массив;
	products = ТекЭлемент_hasp.ПолучитьЭлементыПоИмени("product");
	Для каждого product Из products Цикл
		name  = ЗначениеАтрибутаDOM(product.Атрибуты, "name");
		Продукты.Добавить(name);
	КонецЦикла; 
	
	ДоступныеФункции = Новый Соответствие;
	availablefeatures = ТекЭлемент_hasp.ПолучитьЭлементыПоИмени("availablefeatures");
	Если availablefeatures.Количество()>0 Тогда
		feature = availablefeatures[0].ПолучитьЭлементыПоИмени("feature");  	
		Для каждого тек_feature Из feature Цикл
			name  = ЗначениеАтрибутаDOM(тек_feature.Атрибуты, "name");
			count = ЗначениеАтрибутаDOM(тек_feature.Атрибуты, "count");
			ДоступныеФункции.Вставить(name, count);
		КонецЦикла; 
	КонецЕсли; 
	
	ЗахваченныеЛицензии = Новый Соответствие;
	capturedfeatures = ТекЭлемент_hasp.ПолучитьЭлементыПоИмени("capturedfeatures");
	Если capturedfeatures.Количество()>0 Тогда
		feature = capturedfeatures[0].ПолучитьЭлементыПоИмени("feature");  	
		Для каждого тек_feature Из feature Цикл
			name  = ЗначениеАтрибутаDOM(тек_feature.Атрибуты, "name");
			Попытка
				count = ЗначениеАтрибутаDOM(тек_feature.Атрибуты, "count");
			Исключение
			  	Продолжить;
			КонецПопытки; 
			ЗахваченныеЛицензии.Вставить(name, count);
		КонецЦикла; 
	КонецЕсли; 
	ДополнительнаяИнформация.Вставить("Продукты",			Продукты);
	ДополнительнаяИнформация.Вставить("ДоступныеФункции",	ДоступныеФункции);
	ДополнительнаяИнформация.Вставить("ЗахваченныеЛицензии",ЗахваченныеЛицензии);
	
	ОтветСервера.Вставить("ОстатокДнейЛицензии", 		ОстатокДнейЛицензии);
	ОтветСервера.Вставить("ДополнительнаяИнформация", 	ДополнительнаяИнформация);
	ОтветСервера.Вставить("РегистрационныйНомер", 		ДополнительнаяИнформация.key);
	ОтветСервера.Вставить("ТипЛицензии", 				"MIKO SaaS");
	
	Возврат ОтветСервера;
КонецФункции // ПолучитьСведенияПоКлючамЗащитыМИКО()
