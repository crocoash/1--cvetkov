&НаСервере
Процедура ИнициироватьЗагрузкуСНачалаНаСервере()
	
	Если ИспользоватьДопАТС Тогда
		ДанныеДопАТС = Элементы.ДополнительныеАТС1.ТекущаяСтрока;	
		
		Если ДанныеДопАТС <> Неопределено Тогда
			id_pbx = ДанныеДопАТС.id_pbx; 
		//	idCEL  = ПолучитьПоследнийПолученныйПакет("МИКО_стИсторияЗвонковCEL", id_pbx);
		//	idCDR  = ПолучитьПоследнийПолученныйПакет("МИКО_стИсторияЗвонковCDR", id_pbx);
		//	idCDRa = ПолучитьПоследнийПолученныйПакет("МИКО_стИсторияЗвонковAskozia",id_pbx);
			ОчиститьРегистрВТранзакции("МИКО_стИсторияЗвонковAskozia",  id_pbx);
			ОчиститьРегистрВТранзакции("МИКО_стИсторияЗвонковCDR", 		id_pbx);
			ОчиститьРегистрВТранзакции("МИКО_стИсторияЗвонковCEL", 		id_pbx);	
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИсторию(Команда)
	УдалитьИсториюНаСервере();
КонецПроцедуры

&НаСервере
Процедура УдалитьИсториюНаСервере()
	
	ИнициироватьЗагрузкуСНачалаНаСервере();
	Сообщить("Служебные регистры очищены. ");
	
	ДанныеДопАТС = Элементы.ДополнительныеАТС1.ТекущаяСтрока;	
	Если ДанныеДопАТС <> Неопределено Тогда
	
		id_pbx = ДанныеДопАТС.id_pbx;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИКО_стЗаписьИсторииЗвонков.Ссылка
		|ИЗ
		|	Документ.МИКО_стЗаписьИсторииЗвонков КАК МИКО_стЗаписьИсторииЗвонков
		|ГДЕ
		|	МИКО_стЗаписьИсторииЗвонков.id_pbx = &id_pbx";
		Запрос.УстановитьПараметр("id_pbx", id_pbx);
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокументОбъект.Удалить();
		КонецЦикла; 
		Сообщить("Документы истории для АТС ID = "+id_pbx+" удалены. ");
	
	КонецЕсли;	

КонецПроцедуры

