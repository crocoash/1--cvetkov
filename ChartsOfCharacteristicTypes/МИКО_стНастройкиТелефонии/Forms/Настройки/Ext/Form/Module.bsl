Процедура ПолучитьТаблицуКлючейЗащиты()
	
	Если Компонент = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	ТекстЛицензий = ""; Результат="";
	
	Если ВерсияПлатформы = "8.3" Тогда
		Попытка	
			ОпОп = Вычислить("Новый ОписаниеОповещения(""ОповещениеОВыполненииМетода"", ЭтаФорма, ""GetLicenseInfo"")"); 
			Компонент.BeginCallingGetLicenseInfo(ОпОп, Результат);
