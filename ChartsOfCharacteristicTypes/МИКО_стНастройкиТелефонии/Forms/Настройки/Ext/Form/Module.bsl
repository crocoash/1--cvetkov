// #Область СлужебныеПроцедурыИФункции
&НаКлиенте
Перем Компонент;

&НаСервере
// Восстановление настроек. Инициализация.
// 
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	МакетДокумента = ПолучитьОбщийМакет("МИКО_ЛицензионноеСоглашение");
	ЛицензионноеСоглашениеHTML = МакетДокумента.ПолучитьТекст();
		
	Попытка
		врМИКО_стСлужебный 	 = Вычислить("МИКО_стСлужебный");
		мМИКО_Лицензирование = Вычислить("МИКО_Лицензирование");	
	Исключение
		Отказ = Ложь;
		Возврат;
	КонецПопытки; 

    СведенияОПродукте 	  = мМИКО_Лицензирование.ПолучитьСведенияОПродукте("Модуль статистики");
	ИдентификаторПродукта = СведенияОПродукте.ИдентификаторТриальногоПродукта;	
	// Заполнение формы.
	АдресСервера 	= ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.АдресСервера();
	ПортСервера  	= ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПортСервера();
	ИмяПользователя = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПользовательСтатистики();
	Пароль			= ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.Пароль();
	ИспользоватьЖурналСтатистикиВПанелиТелефонии = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ИспользоватьЖурналСтатистикиВПанелиТелефонии();
	//
	РесурсCDR 		   = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.РесурсCDR();
	РесурсCEL 		   = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.РесурсCEL();
	КлючЗащиты	       = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.КлючЗащиты();
	ИспользоватьДопАТС = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ИспользоватьДопАТС();
	КоличествоХранимыхЦифрТелефона = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.КоличествоХранимыхЦифрТелефона();
	
	ВнешниеНомера.Загрузить(ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ВнешниеНомера.ТаблицаЗначений.Выгрузить());
	ИменаФаксов.Загрузить(ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ИменаФаксов.ТаблицаЗначений.Выгрузить());
		
	ТипАТС = ?(ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.СтанцияMyPBX(),1,0);
	
	// Получение информации по фоновым заданиям.
	// С регламентными заданиями может работать только администратор системы с полными правами.
	Если ИмяПользователя()<>"" И НЕ РольДоступна("ПолныеПрава") Тогда
		МИКО_стОбщегоНазначенияСервер.СообщитьПользователю("Выполнять настройку может только администратор системы с полными правами.");
		Отказ = Истина;
		Возврат;
	КонецЕсли; 
	ПолучитьРегламентныеЗадания();
		
	// Получим системную информацию.
	СтруктураДанных = врМИКО_стСлужебный.ПолучитьСлужебнуюИнформацию();
	ВерсияПлатформы = СтруктураДанных.ВерсияПлатформы;
	ИспользоватьРежимМодальности = СтруктураДанных.ИспользоватьРежимМодальности;
	Попытка
		Заголовок = "Версия модуля: "+врМИКО_стСлужебный.ВерсияМодуляСтатистики();
	Исключение
		Заголовок = "Не найден ключ защиты.";	
	КонецПопытки;
	ОтправилиМетрику = Ложь;
	Компонент 		 = Неопределено;
	ЮрЛицо 			 = Истина;
	Элементы.ДекорацияВерсия.Заголовок = Заголовок;
	
	ИспользоватьМодульСтатистики = МИКО_опЗаписьКИ.ИспользоватьМодульСтатистики();	
	УстановитьДоступностьЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементовФормы()

	ЛицензионноеСоглашениеПринято = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ЛицензионноеСоглашениеПринято();
	Если НЕ ЛицензионноеСоглашениеПринято Тогда
	  	Элементы.КореньСтраниц.ТекущаяСтраница = Элементы.грЛицензионноеСоглашение;
	Иначе
	  	Элементы.КореньСтраниц.ТекущаяСтраница = Элементы.Основные;
	КонецЕсли;
	Элементы.ПринятьСоглашение.Видимость = НЕ ЛицензионноеСоглашениеПринято;
	Элементы.граШапкаФормы.Доступность = ЛицензионноеСоглашениеПринято;
	Для каждого ТекСтраница Из Элементы.КореньСтраниц.ПодчиненныеЭлементы Цикл
		Если ТекСтраница = Элементы.грЛицензионноеСоглашение Тогда
		 	Продолжить;
		КонецЕсли; 
		ТекСтраница.Доступность = ЛицензионноеСоглашениеПринято;
	КонецЦикла;

	Элементы.Дополнительно.Доступность  = ИспользоватьМодульСтатистики;
	Элементы.Основные.Доступность 		= ИспользоватьМодульСтатистики;

КонецПроцедуры
 

&НаКлиенте
// Обработка оповещения от прочих форм.
// 
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	///
	// Регистрация лицензии	
	Если ИмяСобытия = "MIKO_ТекстЛицензии_stat" Тогда
		ОбовитьСтатусЛицензии(Параметр);
	ИначеЕсли ИмяСобытия = "MIKOLIC_INFO" Тогда	
		ПоказатьСообщение("Результат: " + Источник);
	ИначеЕсли ИмяСобытия = "MIKOLIC_Trial" Тогда	
		КлючЗащиты = Параметр;
		Оповестить("MIKO_ActivateCoupone_stat", КлючКупон, ЭтаФорма);
		КонтрольРегистрации = Истина;
		дСтатусРегистрацииКлюча = дСтатусРегистрацииКлюча+"Регистрационный номер """+Параметр+""" успешно получен." + Символы.ПС;
		КлючЗащитыПриИзменении(Неопределено);	
	ИначеЕсли ИмяСобытия = "MIKOLIC_Trial_Error" Тогда	
		// Ошибка получения временной лицензии.
		КонтрольРегистрации = Истина;
		дСтатусРегистрацииКлюча = дСтатусРегистрацииКлюча+"Ошибка при получении регистрационного номера клиента.";	
	ИначеЕсли ИмяСобытия = "MIKO_GetSetTrialLicense_stat" Тогда
		УстановкаПолучениеЛицензии(Параметр);
	ИначеЕсли ИмяСобытия = "MIKO_RefreshLicense_stat" Тогда
		ПолучитьТаблицуКлючейЗащиты();
	ИначеЕсли ИмяСобытия = "MIKO_ActivateCoupone_stat" Тогда
		ActivateCoupone(Параметр);
	ИначеЕсли "ВыборКаталога" = ИмяСобытия И "МИКО_СообщениеВТехническуюПоддержку" = Источник Тогда	
		СохранитьОтладочнуюИнформацию(Параметр);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
// Обработка внешних событий компонента.
// 
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	Если "MIKO_Protection1C" <> Источник Тогда
		Возврат;
	КонецЕсли; 
	
	врСообщеине = дСтатусРегистрацииКлюча;
	Если Событие = "MIKOLIC_ERROR" Тогда
		Если Найти(Данные, "1003")>0 Тогда
			врСообщеине = врСообщеине + "[1003] Для активации купона """+КлючКупон+""" необходимо ввести данные о компании и получить регистрационный номер по ссылке ""Настроить модуль статистики"" -> ""Настройки лицензирования""." + Символы.ПС;	
			КонтрольРегистрации = Ложь;	
		ИначеЕсли Найти(Данные,"1058")>0  Тогда 	
			// ERR Данный e-mail адрес уже зарегистрирован в системе [1058]	
			врСообщеине = врСообщеине + "[1058] E-mail """+ЭлектронныйАдрес+""" уже зарегистрирован в системе." + Символы.ПС;		
		ИначеЕсли Найти(Данные,"1053")>0  Тогда 	
			врСообщеине = врСообщеине + "[1053] Введен не верный регистрационный номер """+КлючКупон+"""." + Символы.ПС;
			КонтрольРегистрации = Ложь;
		ИначеЕсли Найти(Данные,"1081")>0  Тогда 	
			врСообщеине = врСообщеине + "[1081] Введен не верный код купона """+КлючКупон+"""." + Символы.ПС;
			КонтрольРегистрации = Ложь;
			КлючКупон = "";		
		ИначеЕсли Найти(Данные, "1082")>0 Тогда 	
			врСообщеине = врСообщеине + "[1082] Купон """+КлючКупон+""" уже был активирован ранее." + Символы.ПС;  
			КлючКупон = "";	
		ИначеЕсли Найти(Данные, "1012")>0 Тогда
			// ERR Сервер лицензирования не вернул ответ [1011]
			врСообщеине = врСообщеине + "[1012] Сервер лицензирования не отклонил запрос." + Символы.ПС;	
		ИначеЕсли Найти(Данные, "1011")>0 Тогда
			// ERR Сервер лицензирования не вернул ответ [1011]
			врСообщеине = врСообщеине + "[1011] Сервер лицензирования не вернул ответ." + Символы.ПС;
			врСообщеине = врСообщеине + "Проверьте наличие доступа в интернет." + Символы.ПС;
		КонецЕсли; 
	ИначеЕсли Событие = "MIKOLIC_INFO" Тогда
		врСообщеине = врСообщеине + Данные + " """ + КлючКупон +  """ " +Символы.ПС;
	Иначе
		врСообщеине = врСообщеине + Данные +Символы.ПС;
	КонецЕсли;
	дСтатусРегистрацииКлюча = врСообщеине;
	
КонецПроцедуры

&НаКлиенте
// Изменение настройки использования модуля статистики.
// 
Процедура ИспользоватьМодульСтатистикиПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
// Сохранение настроек модуля.
//
Процедура Сохранить(Команда)
	СохранитьНаСервере();
	Модифицированность = Ложь;
КонецПроцедуры
&НаСервере
Процедура СохранитьНаСервере()	
	// Сохраним настройки
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.АдресСервера(АдресСервера);
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПортСервера(ПортСервера);
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПользовательСтатистики(ИмяПользователя);
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.Пароль(Пароль);
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ИспользоватьЖурналСтатистикиВПанелиТелефонии(ИспользоватьЖурналСтатистикиВПанелиТелефонии);
	//
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.РесурсCDR(РесурсCDR);
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.РесурсCEL(РесурсCEL);
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.КоличествоХранимыхЦифрТелефона(КоличествоХранимыхЦифрТелефона);
	// ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.КлючЗащиты(КлючЗащиты);
	
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ВнешниеНомера(ВнешниеНомера.Выгрузить());
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ИменаФаксов(ИменаФаксов.Выгрузить());
	
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.СтанцияMyPBX(?(ТипАТС = 1, Истина, Ложь));
	
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ИспользоватьДопАТС(ИспользоватьДопАТС);
	
	Узел = ПланыОбмена.МИКО_стОбновлениеКИ.НайтиПоКоду("КИ");
	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		Узел = ПланыОбмена.МИКО_стОбновлениеКИ.СоздатьУзел();
		Узел.Код = "КИ";
		Узел.Наименование = "Измененные объекты КИ";
		Узел.ДополнительныеСвойства.Вставить("ИзменениеНастроек", Истина);
	    Узел.Записать();
	КонецЕсли; 
	Узел = ПланыОбмена.МИКО_стОбновлениеКИ_Дополнительный.НайтиПоКоду("КИ");
	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		Узел = ПланыОбмена.МИКО_стОбновлениеКИ_Дополнительный.СоздатьУзел();
		Узел.Код = "КИ";
		Узел.Наименование = "Измененные объекты КИ (Дополнительный)";
		Узел.ДополнительныеСвойства.Вставить("ИзменениеНастроек", Истина);
	    Узел.Записать();
	КонецЕсли; 
	
	Узел = ПланыОбмена.МИКО_стСопоставлениеСобытий.НайтиПоКоду("ДС");
	Если НЕ ЗначениеЗаполнено(Узел) Тогда
		Узел = ПланыОбмена.МИКО_стСопоставлениеСобытий.СоздатьУзел();
		Узел.Код = "ДС";
		Узел.Наименование = "Измененные документы событие";
		Узел.ДополнительныеСвойства.Вставить("ИзменениеНастроек", Истина);
	    Узел.Записать();
	КонецЕсли; 
	
	ЕстьПланОбменаCRM3 = Метаданные.ПланыОбмена.Найти("МИКО_стСозданиеТелефонныхЗвонковCRM3")<>Неопределено;
	Если ЕстьПланОбменаCRM3 Тогда
		Узел = ПланыОбмена.МИКО_стСозданиеТелефонныхЗвонковCRM3.НайтиПоКоду("ДЗ");
		Если НЕ ЗначениеЗаполнено(Узел) Тогда
			Узел = ПланыОбмена.МИКО_стСозданиеТелефонныхЗвонковCRM3.СоздатьУзел();
			Узел.Код = "ДЗ";
			Узел.Наименование = "Измененные документы записи истории звонков";
			Узел.ДополнительныеСвойства.Вставить("ИзменениеНастроек", Истина);
		    Узел.Записать();
		КонецЕсли;
	КонецЕсли;	
		
	ИспользоватьМодульСтатистики 	    = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ИспользоватьМодульСтатистики(ИспользоватьМодульСтатистики);
	Элементы.Дополнительно.Доступность  = ИспользоватьМодульСтатистики;
	Элементы.Основные.Доступность 		= ИспользоватьМодульСтатистики;
	
КонецПроцедуры

&НаКлиенте
// Очистка префиксов в КИ.
//
Процедура ПерезаполнитьТелефоннуюКнигу(Команда)
	ПерезаполнитьТелефоннуюКнигуНаСервере(КоличествоХранимыхЦифрТелефона);
КонецПроцедуры
&НаСервереБезКонтекста
Процедура ПерезаполнитьТелефоннуюКнигуНаСервере(КоличествоХранимыхЦифрТелефона)
	
	Попытка
		врМИКО_стОбработкаКонтактнойИнформации = Вычислить("МИКО_стОбработкаКонтактнойИнформации");
	Исключение
		Возврат;
	КонецПопытки; 
	врМИКО_стОбработкаКонтактнойИнформации.ОбработатьТелефоныВ_КИ_Справочников();
	врМИКО_стОбработкаКонтактнойИнформации.ПерезаполнитьТелефоннуюКнигу(КоличествоХранимыхЦифрТелефона);
	
КонецПроцедуры

&НаКлиенте
// Перезаполнение документов по данным регистров.
// 
Процедура ПерезаполнитьДокументыИстории(Команда)
	Если ТипАТС = 0 Тогда
		ПерезаполнитьДокументыИсторииНаСервере();
	ИначеЕсли ТипАТС = 1 Тогда
		ПерезаполнитьДокументыИсторииНаСервере_MyPBX();
	КонецЕсли;
	ПерезаполнитьДокументыИсторииНаСервере_Askozia();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПерезаполнитьДокументыИсторииНаСервере()
	Попытка
		врМИКО_стЗагрузкаИсторииЗвонков_v7 = Вычислить("МИКО_стЗагрузкаИсторииЗвонков_v7");
	Исключение
		Возврат;
	КонецПопытки; 

	МассивАТС = врМИКО_стЗагрузкаИсторииЗвонков_v7.ОпределитьПараметрыАТС();
	Индекс = 0;
	Пока Индекс < МассивАТС.Количество() Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	МИКО_стИсторияЗвонковCDR.UID
			|ИЗ
			|	РегистрСведений.МИКО_стИсторияЗвонковCDR КАК МИКО_стИсторияЗвонковCDR
			|ГДЕ
			|	МИКО_стИсторияЗвонковCDR.calldate > &calldate
			|	И МИКО_стИсторияЗвонковCDR.id_pbx = &id_pbx
			|
			|СГРУППИРОВАТЬ ПО
			|	МИКО_стИсторияЗвонковCDR.UID";
			
		Запрос.УстановитьПараметр("calldate", ДобавитьМесяц(ТекущаяДата(),-2));
		Запрос.УстановитьПараметр("id_pbx",   МассивАТС[Индекс].Получить("id_pbx"));

		РезультатЗапроса = Запрос.Выполнить();
		МассивUID = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("UID");
		ДанныеИзБазы = врМИКО_стЗагрузкаИсторииЗвонков_v7.ПолучитьДанныеЗвонковCEL_CDR(МассивUID, МассивАТС[Индекс].Получить("id_pbx"));		

		// Итоговая таблица истории.
		Для каждого ТекущийUID Из МассивUID Цикл
