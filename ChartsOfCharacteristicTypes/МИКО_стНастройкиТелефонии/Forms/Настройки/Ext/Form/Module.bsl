&НаСервере
// Производится попытка преобразовать строку в дату
// 
Функция ПреобразоватьВДату(Знач парамДата)
	Если ТипЗнч(парамДата) = Тип("Дата") Тогда
		Возврат парамДата;
	КонецЕсли; 
	НачалоВремен 	= Дата("19700101");
	ПустаяДата 		= Дата("00010101");
	
	Если НЕ ЗначениеЗаполнено(парамДата) Тогда
		Возврат ПустаяДата;
	КонецЕсли; 
	
	Если Найти(""+парамДата, ".")>0 Тогда
		// Формат даты UNIX
		Если ТипЗнч(парамДата) = Тип("Строка") Тогда
			Попытка
			  	парамДата = Число(парамДата);
			Исключение
				Возврат ПустаяДата;
			КонецПопытки; 
		ИначеЕсли ТипЗнч(парамДата) = Тип("Число") Тогда
			// тут все ок	
		Иначе
			Возврат ПустаяДата;
		КонецЕсли; 
		Если (ПустаяДата + парамДата) < НачалоВремен Тогда
			парамДата = НачалоВремен + парамДата;	
		КонецЕсли;
	Иначе	
		Попытка
			парамДата = Дата(парамДата);
		Исключение
			Возврат ПустаяДата;
		КонецПопытки; 	
	КонецЕсли; 
	
	Возврат парамДата;
КонецФункции // ПреобразоватьВДату()

&НаКлиенте 
Процедура ОбновитьТекстЛицензии(Знач ИнформацияПоКлючамЗащиты = Неопределено, Знач MIKO_Error = Неопределено)
	Если ТипЗнч(ИнформацияПоКлючамЗащиты) <> Тип("Структура") Тогда
		Возврат;	
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(MIKO_Error) Тогда
		нТекстЛицензии = MIKO_Error;
	Иначе	
		// Отобразим информацию по остатку дней лицензии.
		Если ЗначениеЗаполнено(ИнформацияПоКлючамЗащиты.РегистрационныйНомер) Тогда
			Если ИнформацияПоКлючамЗащиты.ОстатокДнейЛицензии = 0 Тогда
				нТекстЛицензии 	= 	""; // безсрочная.
			ИначеЕсли ИнформацияПоКлючамЗащиты.ОстатокДнейЛицензии < 0 Тогда
				нТекстЛицензии 	= 	"Срок действия лицензии истек.";
			Иначе	
				ДатаОкончания = ТекущаяДата() + 60*60*24*ИнформацияПоКлючамЗащиты.ОстатокДнейЛицензии;
			    нТекстЛицензии 	= 	"Лицензия действует до "+ Формат(ДатаОкончания,"ДЛФ=DD") + ".";
			КонецЕсли; 
		Иначе
			нТекстЛицензии 	= 	"Не найден ключ защиты.";
		КонецЕсли;
	КонецЕсли; 
	
	ИнформацияПоКлючамЗащиты.Вставить("нТекстЛицензии", нТекстЛицензии);
	Оповестить("MIKO_ТекстЛицензии_stat", ИнформацияПоКлючамЗащиты, ЭтаФорма);
КонецПроцедуры

