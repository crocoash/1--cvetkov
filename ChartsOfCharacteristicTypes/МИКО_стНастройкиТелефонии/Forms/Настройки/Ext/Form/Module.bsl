			Выполнить("НачатьУстановкуВнешнейКомпоненты(Описание,АдресАрхиваКомпонента)");
		Исключение
			Комнонент = Неопределено;
		КонецПопытки;
	ИначеЕсли ВерсияПлатформы = "8.2" Тогда
		Попытка
			УстановитьВнешнююКомпоненту(АдресАрхиваКомпонента);
		Исключение
			Комнонент = Неопределено;
		КонецПопытки;
		ПодключитьКомпоненту();
