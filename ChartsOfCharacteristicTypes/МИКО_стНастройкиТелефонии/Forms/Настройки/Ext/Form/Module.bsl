&НаКлиенте
// Обработка оповещения об установке компонента
// 
Процедура ОповещениеОВыполненииМетода(Результат, ПараметрыВызова, ИмяМетода) Экспорт
	
	ВГраница = ПараметрыВызова.ВГраница();
	Если ВГраница = -1 Тогда
	  	// ошибка
		Возврат;
	КонецЕсли; 

	РезультатРаботыКоманды = ПараметрыВызова[ВГраница];
	Если ИмяМетода = "GetLicenseInfo" Тогда
		ОбработатьGetLicenseInfo(РезультатРаботыКоманды);
		// Не обрабатываем дальше.
		Возврат;
	ИначеЕсли ИмяМетода = "GetTrialLicense" Тогда
		Если ЗначениеЗаполнено(Результат) Тогда
			Оповестить("MIKOLIC_Trial", РезультатРаботыКоманды, "");
			Оповестить("MIKO_GetSetTrialLicense_stat",РезультатРаботыКоманды, ЭтаФорма);
		Иначе
			Оповестить("MIKOLIC_Trial_Error", РезультатРаботыКоманды, "");
		КонецЕсли;
	ИначеЕсли ИмяМетода = "ActivateCoupone" Тогда
		Оповестить("MIKOLIC_Coupone", РезультатРаботыКоманды, "");
	ИначеЕсли ИмяМетода = "SendMetrika" Тогда
		// Не обрабатываем дальше.
		Возврат;	
	КонецЕсли; 

КонецПроцедуры

&НаКлиенте 
// Обработка ответа сервера лицензирования.
// 
Процедура ОбработатьGetLicenseInfo(Результат)
	ИнформацияПоКлючамЗащиты = ИнформацияПоКлючамЗащиты(Результат);
	ОбновитьТекстЛицензии(ИнформацияПоКлючамЗащиты);
	СведенияОЛицензировании = Новый Структура;
	
	Если ИнформацияПоКлючамЗащиты = Неопределено Тогда
		СведенияОЛицензировании.Вставить("ТипЛицензии",			"");
		СведенияОЛицензировании.Вставить("РегистрационныйНомер",	"");
	Иначе
		Если ЗначениеЗаполнено(ИнформацияПоКлючамЗащиты.РегистрационныйНомер) Тогда
			ТипЛицензии 		= ИнформацияПоКлючамЗащиты.ТипЛицензии;
			РегистрационныйНомер= ИнформацияПоКлючамЗащиты.РегистрационныйНомер;
		Иначе
			ТипЛицензии 		= ИнформацияПоКлючамЗащиты.HASP_ТипЛицензии;
			РегистрационныйНомер= ИнформацияПоКлючамЗащиты.HASP_РегистрационныйНомер;
		КонецЕсли;
		СведенияОЛицензировании.Вставить("ТипЛицензии",			 ТипЛицензии);
		СведенияОЛицензировании.Вставить("РегистрационныйНомер", РегистрационныйНомер);
	КонецЕсли; 
	
	Если ОтправилиМетрику = Ложь Тогда
		// SendMetrikaStat("", Компонент);
		ОтправилиМетрику = Истина;
	КонецЕсли; 
					
КонецПроцедуры
 
