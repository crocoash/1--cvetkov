///
// Регистрация лицензии
///

&НаКлиенте
// Обновляем информацию по ключу защиты.
// 
Процедура ОбовитьСтатусЛицензии(ИнформацияПоКлючамЗащиты)
	// Пример отображения статуса лицензии МИКО.	
	
	врСтатус=""; врТекстЛицензии="";
	// 	
	// Sentinel HASP.
	Если ЗначениеЗаполнено(ИнформацияПоКлючамЗащиты.HASP_РегистрационныйНомер) Тогда
		врТекстЛицензии = врТекстЛицензии + "*********************************************************************************************"+ Символы.ПС;
		врТекстЛицензии = врТекстЛицензии + " Sentinel HASP License"+ Символы.ПС;
		врТекстЛицензии = врТекстЛицензии + "*********************************************************"+ Символы.ПС;
		Если ИнформацияПоКлючамЗащиты.HASP_ОстатокДнейЛицензии<0 Тогда
			ДатаОкончания   = ТекущаяДата() + 60*60*24*ИнформацияПоКлючамЗащиты.HASP_ОстатокДнейЛицензии;
			врТекстЛицензии = врТекстЛицензии + "Регистрационный номер '"+ИнформацияПоКлючамЗащиты.HASP_РегистрационныйНомер+"'." + Символы.ПС;
			врТекстЛицензии = врТекстЛицензии + "Срок действия лицензии истек "+Формат(ДатаОкончания, "ДЛФ=DD")+".";
		ИначеЕсли ИнформацияПоКлючамЗащиты.HASP_ОстатокДнейЛицензии=0 Тогда	
			врТекстЛицензии = врТекстЛицензии + "Регистрационный номер '"+ИнформацияПоКлючамЗащиты.HASP_РегистрационныйНомер+"'.";
		Иначе
			ДатаОкончания = ТекущаяДата() + 60*60*24*ИнформацияПоКлючамЗащиты.HASP_ОстатокДнейЛицензии;
			врТекстЛицензии = врТекстЛицензии + "Регистрационный номер '"+ИнформацияПоКлючамЗащиты.HASP_РегистрационныйНомер+"'." + Символы.ПС;
			врТекстЛицензии = врТекстЛицензии + "Действует до " + Формат(ДатаОкончания, "ДЛФ=DD")+".";
		КонецЕсли; 
		врТекстЛицензии = врТекстЛицензии + Символы.ПС + Символы.ПС;
		врСтатус = врТекстЛицензии; 
	КонецЕсли; 
	
	ПродуктНайденВКлюче = Ложь;
	// МИКО SaaS License.
	Если ЗначениеЗаполнено(ИнформацияПоКлючамЗащиты.РегистрационныйНомер) Тогда
		врТекстЛицензии = врТекстЛицензии + "*********************************************************************************************"+ Символы.ПС;
		врТекстЛицензии = врТекстЛицензии + " MIKO SaaS License"+ Символы.ПС;
		врТекстЛицензии = врТекстЛицензии + "*********************************************************"+ Символы.ПС;
		Если ИнформацияПоКлючамЗащиты.ОстатокДнейЛицензии<0 Тогда
			врТекстЛицензии = врТекстЛицензии + "Регистрационный номер '"+ИнформацияПоКлючамЗащиты.РегистрационныйНомер+"'.";
			врСтатус=врТекстЛицензии + Символы.ПС;
			
			ДатаОкончания = ТекущаяДата() + 60*60*24*ИнформацияПоКлючамЗащиты.ОстатокДнейЛицензии;
			врТекстЛицензии=врСтатус + "Срок действия лицензии истек "+Формат(ДатаОкончания, "ДЛФ=DD")+".";
			врСтатус=врТекстЛицензии + Символы.ПС;
		ИначеЕсли Не ЗначениеЗаполнено(ИнформацияПоКлючамЗащиты.РегистрационныйНомер) Тогда
			врТекстЛицензии = врТекстЛицензии + "Лицензия не найдена или не активирована.";
			врСтатус=врТекстЛицензии + Символы.ПС;
		ИначеЕсли ИнформацияПоКлючамЗащиты.ОстатокДнейЛицензии=0 Тогда	
			врТекстЛицензии = врТекстЛицензии + "Регистрационный номер '"+ИнформацияПоКлючамЗащиты.РегистрационныйНомер+"'.";
			врСтатус=врТекстЛицензии + Символы.ПС;
		Иначе
			ДатаОкончания = ТекущаяДата() + 60*60*24*ИнформацияПоКлючамЗащиты.ОстатокДнейЛицензии;
			врТекстЛицензии = врТекстЛицензии + "Регистрационный номер '"+ИнформацияПоКлючамЗащиты.РегистрационныйНомер+"'.";
			врСтатус= врТекстЛицензии + Символы.ПС;
			врСтатус=врСтатус+ "Действует до " + Формат(ДатаОкончания, "ДЛФ=DD")+"" + Символы.ПС;
		КонецЕсли; 		
		
		Если ИнформацияПоКлючамЗащиты.Свойство("ТипЛицензии") Тогда
			врСтатус=врСтатус +"Тип лицензии: "+ИнформацияПоКлючамЗащиты.ТипЛицензии+ Символы.ПС;
		КонецЕсли;
		врСтатус=врСтатус + Символы.ПС;
		
		ДополнительнаяИнформация = Новый Структура;
		ДоступныеФункции		 = Новый Соответствие;
		Если ИнформацияПоКлючамЗащиты.Свойство("ДополнительнаяИнформация", ДополнительнаяИнформация)
			 И ДополнительнаяИнформация.Количество()>0 Тогда
			врСтатус=врСтатус+"Организация: '"+ДополнительнаяИнформация.companyname+"'" + Символы.ПС;
		 	врСтатус=врСтатус+"ФИО контактного лица: '"+ДополнительнаяИнформация.contact+"'" + Символы.ПС;
		 	врСтатус=врСтатус+"Email: '"+ДополнительнаяИнформация.email+"'" + Символы.ПС;
		 	врСтатус=врСтатус+"Телефон: '"+ДополнительнаяИнформация.tel+"'" + Символы.ПС;
			врСтатус=врСтатус + Символы.ПС;
			ВидимостьВкладкиАктивация = Ложь;
		КонецЕсли; 		
		
		version=""; ИнформацияПоКлючамЗащиты.Свойство("version",version);
		Если ЗначениеЗаполнено(version) Тогда 
		// Новый формат оповещения.
			Продукты = Новый Массив;
			ДополнительнаяИнформация.Свойство("Продукты",Продукты);
			Если ТипЗнч(Продукты) = Тип("Массив") И Продукты.Количество()>0 Тогда
				Для каждого Продукт Из Продукты Цикл
					Если Продукт.id = ИдентификаторПродукта Тогда
						ПродуктНайденВКлюче = Истина;
					КонецЕсли; 
					врСтатус=врСтатус + "" + Продукт.name;
					Если ЗначениеЗаполнено(Продукт.expired) Тогда
						врПрефикс = ?(Продукт.expired < ТекущаяДата(), ". Срок действия истек ", ". Действует до ");
						врСтатус=врСтатус + врПрефикс + Формат(Продукт.expired, "ДЛФ=DD")+"";
					КонецЕсли; 
					врСтатус=врСтатус+Символы.ПС;
					
					Для каждого feature Из Продукт.feature Цикл
						врСтатус=врСтатус + Символы.Таб+"- "+feature.name+": Всего '"+feature.count+"', Используется '"+feature.captured+"'"+ Символы.ПС;
					КонецЦикла; 
					врСтатус=врСтатус + Символы.ПС;
				КонецЦикла; 
			КонецЕсли; 
		ИначеЕсли ТипЗнч(ДополнительнаяИнформация) = Тип("Структура") Тогда	
			Продукты 			= Новый Массив;
			ДополнительнаяИнформация.Свойство("Продукты",		  Продукты);
			ДополнительнаяИнформация.Свойство("ДоступныеФункции", ДоступныеФункции);
			Если ТипЗнч(Продукты) = Тип("Массив") И Продукты.Количество()>0 Тогда
				врСтатус=врСтатус+"Продукты:" + Символы.ПС;
				Для каждого Продукт Из Продукты Цикл
					врСтатус=врСтатус + Символы.Таб + "- " + Продукт + Символы.ПС;
				КонецЦикла; 
				врСтатус=врСтатус + Символы.ПС;
			КонецЕсли; 
			
			ЗахваченныеЛицензии = Новый Соответствие;
			ДополнительнаяИнформация.Свойство("ЗахваченныеЛицензии",ЗахваченныеЛицензии);
			Если ИнформацияПоКлючамЗащиты.ОстатокДнейЛицензии>=0 И ДоступныеФункции <> Неопределено Тогда
				врСтатус=врСтатус+"Детали лицензии:" + Символы.ПС;
				Для каждого врФункция Из ДоступныеФункции Цикл
					врИспользуется = ?(ТипЗнч(ЗахваченныеЛицензии)=Тип("Соответствие"),ЗахваченныеЛицензии.Получить(врФункция.Ключ),0);
					врСтатус=врСтатус+ Символы.Таб + "- "+врФункция.Ключ+": Всего '"+врФункция.Значение+"', Используется '"+?(врИспользуется=Неопределено,0,врИспользуется)+"'" + Символы.ПС
				КонецЦикла; 	
			КонецЕсли; 	
		КонецЕсли; 
		
	КонецЕсли; 
	Элементы.грРегистрация.Видимость = (ПродуктНайденВКлюче = Ложь); 
	
	Если ЗначениеЗаполнено(врСтатус) Тогда
		СостояниеКлючаЗащиты = СокрЛП(врСтатус);
	Иначе	
	    СостояниеКлючаЗащиты = "Не найден ключ защиты на продукт ""Панель телефонии для 1С"".";
	КонецЕсли; 
КонецПроцедуры


