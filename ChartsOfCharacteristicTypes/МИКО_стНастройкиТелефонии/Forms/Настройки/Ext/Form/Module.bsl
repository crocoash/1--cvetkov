// Очистки регистра.
// Удаляем записи по 10000шт за раз.
Процедура ОчиститьРегистрВТранзакции(ИмяРегистра, id_pbx)

	Если Метаданные.РегистрыСведений.Найти(ИмяРегистра) = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	"+ИмяРегистра+".AcctId
		|ИЗ
		|	РегистрСведений."+ИмяРегистра+" КАК "+ИмяРегистра+"
		|ГДЕ
		|   "+ИмяРегистра+".id_pbx = "+id_pbx+"";
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	сч = 0;
	Пока Выборка.Следующий() Цикл
		Если сч = 0 Тогда
		 	НачатьТранзакцию();
		КонецЕсли; 
		
		МЗ = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Выборка);
		МЗ.id_pbx = id_pbx;
		МЗ.Удалить();
		
		сч = сч + 1;
		Если сч > 10000 Тогда
			ЗафиксироватьТранзакцию();
			сч = 0;
		КонецЕсли; 
	КонецЦикла; 
	
	Если сч > 0 Тогда
		ЗафиксироватьТранзакцию();
		сч = 0;
	КонецЕсли; 
	
КонецПроцедуры

