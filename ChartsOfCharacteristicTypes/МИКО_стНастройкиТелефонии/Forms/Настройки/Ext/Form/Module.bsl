	Иначе
		Элементы.РесурсCDR.Доступность = Истина;
		Элементы.РесурсCEL.Доступность = Истина;
		// Элементы.Проверить.Доступность = Истина;
	КонецЕсли; 
	
КонецПроцедуры

///
// Отчет по ошибкам.

&НаКлиенте
Процедура СформироватьОтчет(Команда)
	ПрочитатьЖурналРегистрации();
КонецПроцедуры

&НаСервере
Процедура ПрочитатьЖурналРегистрации()
	ОтчетЖурналРегистрации.Очистить();	
	ИдентификаторыДокументовСОшибкой.Очистить();
	ТаблицаРезультат = Новый ТаблицаЗначений;
		
	МакетОтчета = Новый ТабличныйДокумент;
	МакетОтчета = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПолучитьМакет("ОшибкиЖурналРегистрации");
	
	ОбластьШапка  = МакетОтчета.ПолучитьОбласть("ОбластьШапка");
	
	ОтчетЖурналРегистрации.Вывести(ОбластьШапка);
		
	Фильтр = Новый Структура();
	Фильтр.Вставить("Уровень", УровеньЖурналаРегистрации.Предупреждение); 
	Фильтр.Вставить("Событие", "МИКО.ЗагрузкаИсторииЗвонков");	
	ВыгрузитьЖурналРегистрации(ТаблицаРезультат, Фильтр,,, 100);  
	ТаблицаРезультат.Сортировать("Дата Убыв");
	Если ТаблицаРезультат.Количество()=0 Тогда
		ОбластьНетОшибок = МакетОтчета.ПолучитьОбласть("ОбластьНетОшибок");
		ОтчетЖурналРегистрации.Вывести(ОбластьНетОшибок);
	Иначе
		Для каждого СтрокаСОшибкой Из ТаблицаРезультат Цикл
			ОбластьСтрока = МакетОтчета.ПолучитьОбласть("ОбластьСтрока");		
			ОбластьСтрока.Параметры.Заполнить(СтрокаСОшибкой);
			ОтчетЖурналРегистрации.Вывести(ОбластьСтрока);
			
			ПозицияКомментария = Найти(СтрокаСОшибкой.Комментарий, "Ошибка загрузки звонка:");
			Если ПозицияКомментария >0 Тогда
				id = Прав(СтрокаСОшибкой.Комментарий, СтрДлина(СтрокаСОшибкой.Комментарий) - (ПозицияКомментария + 23));	
				id = МИКО_опЗаписьКИ.УбратьИзСтрокиТелефонаВсеБуквы(id);	
				Попытка
				ИдентификаторыДокументовСОшибкой.Добавить().id = Число(id);
				Исключение
				КонецПопытки; 
			КонецЕсли; 
			
		КонецЦикла; 
	КонецЕсли; 
	Элементы.СформироватьСообщениеВТехническуюПоддержку.Видимость = Истина;
	
КонецПроцедуры // ПрочитатьЖурналРегистрации()

&НаКлиенте
Процедура СформироватьСообщениеВТехническуюПоддержку(Команда)
	
		
	Режим = РежимДиалогаВыбораФайла.ВыборКаталога;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.Заголовок = "Выберите каталог, где будет сохранена отладочная информация:";
	
	Если ВерсияПлатформы = "8.3" Тогда
		ДопПараметры = "МИКО_СообщениеВТехническуюПоддержку";
		ОписаниеОповещения = Вычислить("Новый ОписаниеОповещения(""ОбработкаВыбораКаталога"", МИКО_стОбщегоНазначенияКлиент, ДопПараметры)");
		Попытка	
			Выполнить("ДиалогОткрытияФайла.Показать(ОписаниеОповещения)");
		Исключение
			Возврат;
		КонецПопытки; 
	ИначеЕсли ВерсияПлатформы = "8.2" Тогда
		Результат = Вычислить("ДиалогОткрытияФайла.Выбрать()");
		Если Результат = Истина Тогда
			
			МассивРезультат = Новый Массив;
			МассивРезультат.Добавить(ДиалогОткрытияФайла.Каталог);
			СохранитьОтладочнуюИнформацию(МассивРезультат);		
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

//
//
&НаКлиенте
Процедура СохранитьОтладочнуюИнформацию(ИменаФайлов)

	Если НЕ ТипЗнч(ИменаФайлов) = Тип("Массив") Тогда
	 	Возврат;
	КонецЕсли; 	
	МассивUID = Новый Массив;
	Для каждого ТекущаяСтрока Из ИдентификаторыДокументовСОшибкой Цикл
		МассивUID.Добавить(ТекущаяСтрока.id);	
	КонецЦикла; 
	Разделитель = ?(Найти(ИменаФайлов[0], "\")>0, "\","/");
	
	ИмяФайла = ИменаФайлов[0] + Разделитель + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_hh_mm") + "stat_log.txt";
	
	ТекстОтладки = ПолучитьДанныеЗвонков(МассивUID);
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ТекстОтладки);
	ТекстовыйДокумент.Записать(ИмяФайла);
	
	ИмяФайлаОтчета = ИменаФайлов[0] + Разделитель + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_hh_mm") + "stat_log_report.pdf";
	ОтчетЖурналРегистрации.Записать(ИмяФайлаОтчета, ТипФайлаТабличногоДокумента.PDF);
	
КонецПроцедуры // СохранитьОтладочнуюИнформацию()
&НаСервереБезКонтекста
Функция ПолучитьДанныеЗвонков(МассивUID)
	Попытка
		мод_МИКО_стЗагрузкаИсторииЗвонков_v7=Вычислить("МИКО_стЗагрузкаИсторииЗвонков_v7");
	Исключение
	 	Возврат "";
	КонецПопытки; 
	
	ДанныеИзБазы = мод_МИКО_стЗагрузкаИсторииЗвонков_v7.ПолучитьДанныеЗвонковCEL_CDR(МассивUID);
	Возврат ЗначениеВСтрокуВнутр(ДанныеИзБазы);
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если "8" <> ИдентификаторПродукта И НЕ ЗначениеЗаполнено(АдресАрхиваКомпонента) Тогда
