// Получаем последний ID записи.
//
&НаСервереБезКонтекста
Функция ПолучитьПоследнийПолученныйПакет(ИмяТаблицы, id_pbx)
	Если ИмяТаблицы <> "МИКО_стИсторияЗвонковCDR" 
		 И ИмяТаблицы <> "МИКО_стИсторияЗвонковCEL"
		 И "МИКО_стИсторияЗвонковAskozia" <> ИмяТаблицы Тогда
	   	Возврат 0;                                
	КонецЕсли;      
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ ПЕРВЫЕ 1
					|	МИКО_ИсторияЗвонков.AcctId КАК AcctId
					|ИЗ
					|	РегистрСведений."+ИмяТаблицы+" КАК МИКО_ИсторияЗвонков
					|ГДЕ
					|	МИКО_ИсторияЗвонков.AcctId > 0
				    |	И МИКО_ИсторияЗвонков.id_pbx = &id_pbx
					|
					|УПОРЯДОЧИТЬ ПО
					|	AcctId УБЫВ";
	Запрос.УстановитьПараметр("id_pbx", id_pbx);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ПоследнийПолученныйПакет = Выборка.AcctId;
	КонецЕсли;
	ПоследнийПолученныйПакет = ?(ЗначениеЗаполнено(ПоследнийПолученныйПакет),ПоследнийПолученныйПакет,0); 
   	Возврат ПоследнийПолученныйПакет;
КонецФункции // ПолучитьПоследнийПолученныйПакет()


&НаСервереБезКонтекста
Функция ПолучитьПоследний_id_pbx_ОсновнойАТС()
	id_pbx = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.id_pbx();
	
	ПризнакВыходаИзЦикла = Ложь;
	
	Пока НЕ ПризнакВыходаИзЦикла Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	МИКО_ДополнительныеАТС.Наименование
			|ИЗ
			|	Справочник.МИКО_ДополнительныеАТС КАК МИКО_ДополнительныеАТС
			|ГДЕ
			|	МИКО_ДополнительныеАТС.id_pbx = &id_pbx";
		
		Запрос.УстановитьПараметр("id_pbx", id_pbx);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			ПризнакВыходаИзЦикла = Истина;
		Иначе
			id_pbx = id_pbx - 1;
		КонецЕсли; 
		
	КонецЦикла;
	Возврат id_pbx;
КонецФункции // ПолучитьПоследний_id_pbx_ОсновнойАТС()

 

// Получаем последний ID записи.
//
&НаСервереБезКонтекста
Функция ПолучитьПоследнийПолученныйПакет_MyPBX(ИмяТаблицы)
	ПустаяДата = Дата("00010101");
	Если ИмяТаблицы <> "МИКО_стMyPBX_Asteriskcdr" И  ИмяТаблицы <> "МИКО_стMyPBX_Autorecord" Тогда
	   	Возврат ПустаяДата;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	МИКО_ИсторияЗвонков.datetime КАК datetime
	|ИЗ
	|	РегистрСведений."+ИмяТаблицы+" КАК МИКО_ИсторияЗвонков
	|
	|УПОРЯДОЧИТЬ ПО
	|	datetime УБЫВ";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		ПоследнийПолученныйПакет = Выборка.datetime;
	КонецЕсли;
	ПоследнийПолученныйПакет = ?(ЗначениеЗаполнено(ПоследнийПолученныйПакет),ПоследнийПолученныйПакет,ПустаяДата); 
   	Возврат ПоследнийПолученныйПакет;
КонецФункции // ПолучитьПоследнийПолученныйПакет()

