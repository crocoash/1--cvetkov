		// Пробуем подключить компоненту защиты.
		ПодключитьКомпоненту();
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКЛицензированию(Команда)
