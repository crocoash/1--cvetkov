&НаКлиенте
// Проверка доступа к АТС.
// 
Процедура Проверить(Команда)
	Попытка
		врМИКО_стСлужебный = Вычислить("МИКО_стСлужебный");
		врМИКО_стЗагрузкаИсторииЗвонков_v7 = Вычислить("МИКО_стЗагрузкаИсторииЗвонков_v7");
	Исключение
		Возврат;
	КонецПопытки; 
	
	Сохранить(Команда);
	Модифицированность = Ложь;
	
	Попытка
		врРезультатТеста = врМИКО_стЗагрузкаИсторииЗвонков_v7.ТестИнтерфейсовАТС();
		Элементы.ДекорацияВерсия.Заголовок = "Версия модуля: "+врМИКО_стСлужебный.ВерсияМодуляСтатистики() + ". Версия защищенного модуля: " + врМИКО_стЗагрузкаИсторииЗвонков_v7.ВерсияЗащищенногоМодуля();
	Исключение
		Элементы.ДекорацияВерсия.Заголовок = "Не найден ключ защиты.";
		Возврат;
	КонецПопытки;
	
	Если врРезультатТеста.Свойство("ЭтоMyPBX") Тогда
		ТипАТС = 1;
		ТипАТСПриИзменении(Неопределено);
	КонецЕсли; 
	
	Элементы.РезультатТеста.Заголовок = "Результат проверки: " + ?(врРезультатТеста.Количество()>0, "Успех", "Не вышло получить данные с АТС.");
	Элементы.РезультатТеста.Видимость = Истина;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, врРезультатТеста);
	Модифицированность = Истина;
	Если врРезультатТеста.Свойство("ТекстDOM") Тогда
		ЗагрузитьИзФайлаНаСервере(врРезультатТеста.ТекстDOM);
		ОбновитьИнтерфейс();
	КонецЕсли; 
	
КонецПроцедуры

