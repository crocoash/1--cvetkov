// Активация купона.
// 
Процедура ActivateCoupone(sCoupone)
	Если НЕ ЗначениеЗаполнено(sCoupone) Тогда
	  	Возврат;
	КонецЕсли; 
	
	Если Компонент = Неопределено Тогда 	
		Возврат;
	КонецЕсли; 
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("sCoupone", Строка(sCoupone));
	СтруктураПараметров.Вставить("result", "");

	Если ВерсияПлатформы = "8.3" Тогда
		Попытка	
			ОпОп = Вычислить("Новый ОписаниеОповещения(""ОповещениеОВыполненииМетода"", ЭтаФорма, ""ActivateCoupone"")"); 
			Компонент.BeginCallingActivateCoupone(ОпОп, СтруктураПараметров.sCoupone, СтруктураПараметров.result);
		Исключение
		КонецПопытки;
	ИначеЕсли ВерсияПлатформы = "8.2" Тогда
		ActivateCoupone82(sCoupone);
	КонецЕсли;

КонецПроцедуры // ActivateCoupone()

