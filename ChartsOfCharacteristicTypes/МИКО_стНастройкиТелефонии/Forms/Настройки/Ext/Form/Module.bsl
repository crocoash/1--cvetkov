// Получаем идентификаторы транка.
// 
Функция ПолучитьДанныеТранка(СсылкаНаТранк)
	врДанные = Новый Структура("Представление,did,accountcode,Значение,Идентификатор,Ссылка");	
    ЗаполнитьЗначенияСвойств(врДанные,СсылкаНаТранк);
	врДанные.Значение 	   = врДанные.Ссылка;
	врДанные.Представление = врДанные.Идентификатор;
	
