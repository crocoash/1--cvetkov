&НаКлиенте
// Регистрация клиента в системе.
// 
Процедура Зарегистрировать(Команда)	
	дСтатусРегистрацииКлюча = "";
	врСообщение = "";
	ЭтоНовыйКлиент = (Элементы.грСтраницы.ТекущаяСтраница = Элементы.грРегистрация);
	
	Если НЕ КонтрольЗаполненияПолей(врСообщение) Тогда
		ПоказатьСообщение(врСообщение);
		Возврат;
	КонецЕсли; 
	
	Если ЭтоНовыйКлиент = Истина Тогда
		Данные = Новый Структура;
		Данные.Вставить("sLicenseKey", 	КлючЗащиты);
		Данные.Вставить("sContact", 	ФИОКонтактногоЛица);
		Данные.Вставить("sCompanyname", ?(ЗначениеЗаполнено(НаименованиеКомпании), НаименованиеКомпании, ФИОКонтактногоЛица));
		Данные.Вставить("sEmail", 		ЭлектронныйАдрес);
		Данные.Вставить("sTel", 		НомерТелефона);
		Данные.Вставить("sDescription", Комментарий);
		Данные.Вставить("INN",			ИНН);
		Данные.Вставить("ЮрЛицо",		ЮрЛицо);

		Оповестить("MIKO_GetSetTrialLicense_stat", Данные, ЭтаФорма);
	Иначе
		Оповестить("MIKO_GetSetTrialLicense_stat", КлючЗащиты, ЭтаФорма);
		КонтрольРегистрации = Истина;
		Оповестить("MIKO_ActivateCoupone_stat", КлючКупон, ЭтаФорма);
	КонецЕсли; 

КонецПроцедуры

// Проеряем заполнение
//
&НаКлиенте
Функция КонтрольЗаполненияПолей(врСообщение)
	врСообщение = "";
	ПоляКПроверке = Новый Соответствие;
	
	Если ЭтоНовыйКлиент = Истина Тогда
		Если ЮрЛицо = Истина Тогда
			ПоляКПроверке.Вставить("ИНН", 		 			"Введите ИНН юридического лица.");
			ПоляКПроверке.Вставить("НаименованиеКомпании", 	"Введите наименование ораганизации.");
			ПоляКПроверке.Вставить("ФИОКонтактногоЛица", 	"Введите ФИО контактного лица.");
			ПоляКПроверке.Вставить("НомерТелефона", 		"Укажите контактный номер телефона.");
			ПоляКПроверке.Вставить("ЭлектронныйАдрес", 		"Укажите адрес электронной почты.");
		Иначе	
			ПоляКПроверке.Вставить("ФИОКонтактногоЛица", 	"Введите ФИО контактного лица.");
			ПоляКПроверке.Вставить("НомерТелефона", 		"Укажите контактный номер телефона.");
			ПоляКПроверке.Вставить("ЭлектронныйАдрес", 		"Укажите адрес электронной почты.");
		КонецЕсли; 
	Иначе
		ПоляКПроверке.Вставить("КлючЗащиты", 			"Введите регистрационный номер клиента клиента.");
	КонецЕсли; 

	Для каждого ИмяПоля Из ПоляКПроверке Цикл
		Если НЕ ЗначениеЗаполнено(ЭтаФорма[ИмяПоля.Ключ]) Тогда
		  	врСообщение = врСообщение + ИмяПоля.Значение + Символы.ПС;
		ИначеЕсли ИмяПоля.Ключ = "ЭлектронныйАдрес" Тогда 
			адрес = ЭтаФорма[ИмяПоля.Ключ];
			ВерныйФормат = Найти(адрес, "@")>1; 
			ВерныйФормат = МИН(ВерныйФормат, Найти(адрес, ".")>1);
			Если НЕ ВерныйФормат Тогда
		  		врСообщение = врСообщение + "Не вверный формат электронной почты """+адрес+"""." + Символы.ПС;
			КонецЕсли; 
		ИначеЕсли ИмяПоля.Ключ = "НомерТелефона" Тогда 
			Телефон = ЭтаФорма[ИмяПоля.Ключ];
			Если СтрДлина(Телефон) < 5 Тогда
		  		врСообщение = врСообщение + "Не вверный формат номера телефона """+Телефон+"""." + Символы.ПС;
			КонецЕсли; 
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат НЕ ЗначениеЗаполнено(врСообщение); 	
КонецФункции // КонтролльЗаполненияПолей()

