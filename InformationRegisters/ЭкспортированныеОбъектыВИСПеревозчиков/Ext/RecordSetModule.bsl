
Процедура ПриЗаписи(Отказ, Замещение)
	для Каждого ТекЗапись из ЭтотОбъект Цикл
		Если ТипЗнч(ТекЗапись.Объект) = тип("ДокументСсылка.ЗаказПокупателя") тогда
			попытка
				
				Заказ = ТекЗапись.Объект;
				Ф = Заказ.ПолучитьФорму();
				Если Ф.Открыта() Тогда
					Ф.Модифицированность = истина;
				Иначе	
					Заказ.получитьОбъект().Записать();
				КонецЕСли;	
 
			Исключение
			КонецПопытки;	
		КонецЕсли;	
	КонецЦикла;	
