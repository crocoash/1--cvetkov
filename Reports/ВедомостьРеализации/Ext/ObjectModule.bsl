				|					ТОГДА ВозвратТоваровОтПокупателяТовары.Ссылка.Контрагент.комиссия / 100 * ВозвратТоваровОтПокупателяТовары.Сумма
				|				ИНАЧЕ 0
				|			КОНЕЦ
				|	КОНЕЦ,
				|	NULL,
				|	ВозвратТоваровОтПокупателяТовары.ЗаказПокупателя,
				|	0,
				|	ВозвратТоваровОтПокупателяТовары.ЗаказПокупателя.referrer,
				|	ЗНАЧЕНИЕ(Справочник.РекламныеКампании.ПустаяСсылка)
				|ИЗ
				|	Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
				|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			МАКСИМУМ(ЦеныНоменклатуры.Период) КАК Период,
				|			ЦеныНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
				|			ВозвратТоваровОтПокупателяТовары.Ссылка КАК Реализация,
				|			ВозвратТоваровОтПокупателяТовары.НомерСтроки КАК НомерСтроки
				|		ИЗ
				|			РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
				|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипыЦенНоменклатуры КАК ТипыЦенНоменклатуры
				|				ПО ЦеныНоменклатуры.ТипЦен = ТипыЦенНоменклатуры.Ссылка
				|				ПОЛНОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
				|				ПО (ВозвратТоваровОтПокупателяТовары.ХарактеристикаНоменклатуры = ЦеныНоменклатуры.ХарактеристикаНоменклатуры)
				|					И (ВЫБОР
				|						КОГДА ВозвратТоваровОтПокупателяТовары.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
				|							ТОГДА ВозвратТоваровОтПокупателяТовары.Ссылка.Дата
				|						ИНАЧЕ ВозвратТоваровОтПокупателяТовары.ЗаказПокупателя.Дата
				|					КОНЕЦ >= ЦеныНоменклатуры.Период)
				|		ГДЕ
				|			ТипыЦенНоменклатуры.Код = ""000000001""
				|		
				|		СГРУППИРОВАТЬ ПО
				|			ЦеныНоменклатуры.ХарактеристикаНоменклатуры,
				|			ВозвратТоваровОтПокупателяТовары.Ссылка,
				|			ВозвратТоваровОтПокупателяТовары.НомерСтроки) КАК ПолучимПериодЦены
				|			ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|				ПолучимЦену.ХарактеристикаНоменклатуры КАК Характеристики,
				|				ПолучимЦену.Цена КАК Цена,
				|				ПолучимЦену.Период КАК Период
				|			ИЗ
				|				РегистрСведений.ЦеныНоменклатуры КАК ПолучимЦену
				|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипыЦенНоменклатуры КАК ТипыЦенНоменклатуры
				|					ПО ПолучимЦену.ТипЦен = ТипыЦенНоменклатуры.Ссылка
				|			ГДЕ
				|				ТипыЦенНоменклатуры.Ссылка = &БазовыйТипЦен) КАК ПолучимЦену
				|			ПО ПолучимПериодЦены.ХарактеристикаНоменклатуры = ПолучимЦену.Характеристики
				|				И ПолучимПериодЦены.Период = ПолучимЦену.Период
				|		ПО ВозвратТоваровОтПокупателяТовары.Ссылка = ПолучимПериодЦены.Реализация
				|			И ВозвратТоваровОтПокупателяТовары.НомерСтроки = ПолучимПериодЦены.НомерСтроки
				|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			ВозвратТоваровОтПокупателяТовары.Ссылка КАК Реализация,
				|			МАКСИМУМ(СкидкиНаценкиНоменклатуры.Период) КАК Период,
				|			ВозвратТоваровОтПокупателяТовары.НомерСтроки КАК НомерСтроки,
				|			СкидкиНаценкиНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
				|		ИЗ
				|			РегистрСведений.СкидкиНаценкиНоменклатуры КАК СкидкиНаценкиНоменклатуры
				|				ПОЛНОЕ СОЕДИНЕНИЕ Документ.ВозвратТоваровОтПокупателя.Товары КАК ВозвратТоваровОтПокупателяТовары
				|				ПО (ВозвратТоваровОтПокупателяТовары.ЗаказПокупателя.Дата = СкидкиНаценкиНоменклатуры.Период)
				|					И (СкидкиНаценкиНоменклатуры.ХарактеристикаНоменклатуры В
				|						(ВЫБРАТЬ
				|							ПолучимХарактеристикуНк.Ссылка КАК ХарактеристикаНк
				|						ИЗ
				|							Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
				|								ЛЕВОЕ СОЕДИНЕНИЕ ВТРостовка КАК ВТРостовка
				|									ПОЛНОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ПолучимХарактеристикуНк
				|									ПО
				|										ВТРостовка.Ростовка.Наименование = ПолучимХарактеристикуНк.Наименование
				|											И ВТРостовка.Характеристика.Владелец.Код = ПолучимХарактеристикуНк.Владелец.Нк
				|								ПО
				|									ХарактеристикиНоменклатуры.Ссылка = ВТРостовка.Характеристика
				|						ГДЕ
				|							ХарактеристикиНоменклатуры.Ссылка = ВозвратТоваровОтПокупателяТовары.ХарактеристикаНоменклатуры))
				|		
				|		СГРУППИРОВАТЬ ПО
				|			СкидкиНаценкиНоменклатуры.ХарактеристикаНоменклатуры,
				|			ВозвратТоваровОтПокупателяТовары.НомерСтроки,
				|			ВозвратТоваровОтПокупателяТовары.Ссылка) КАК ПолучимПериодСкидки
				|			ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|				СкидкиНаценкиНоменклатуры.ПроцентСкидкиНаценки КАК ПроцентСкидкиНаценки,
				|				СкидкиНаценкиНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
				|				СкидкиНаценкиНоменклатуры.Период КАК Период
				|			ИЗ
				|				РегистрСведений.СкидкиНаценкиНоменклатуры КАК СкидкиНаценкиНоменклатуры) КАК ПолучимСкидку
				|			ПО ПолучимПериодСкидки.Период = ПолучимСкидку.Период
				|				И ПолучимПериодСкидки.ХарактеристикаНоменклатуры = ПолучимСкидку.ХарактеристикаНоменклатуры
				|		ПО ВозвратТоваровОтПокупателяТовары.Ссылка = ПолучимПериодСкидки.Реализация
				|			И ВозвратТоваровОтПокупателяТовары.НомерСтроки = ПолучимПериодСкидки.НомерСтроки
				|ГДЕ
				|	ВозвратТоваровОтПокупателяТовары.Ссылка.Дата МЕЖДУ &НачДата И &КонДата
				|	И ВозвратТоваровОтПокупателяТовары.Ссылка.Проведен
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|// Расход на рекламу: строки без номенклатуры и без документа продажи.
				|// Ключ источника здесь тот же, что в referrer заказа («utm_source
				|// utm_campaign»), поэтому группировка по Referrer сводит выручку
				|// и расход одного канала/кампании в одну строку. Кампании без
				|// идентификатора приходят ключом уровня канала («google ads»).
				|ВЫБРАТЬ
				|	ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка),
				|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
				|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
				|	ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка),
				|	0,
				|	0,
				|	0,
				|	0,
				|	0,
				|	NULL,
				|	ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка),
				|	РекламныйРасход.Сумма,
				|	РекламныйРасход.Ключ,
				|	РекламныйРасход.Кампания
				|ИЗ
				|	РегистрСведений.РекламныйРасход КАК РекламныйРасход
				|ГДЕ
				|	РекламныйРасход.Период МЕЖДУ &НачДата И &КонДата
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	Общ.Документ КАК Документ,
				|	Общ.Контрагент КАК Контрагент,
				|	Общ.Номенклатура КАК Номенклатура,
				|	Общ.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
				|	Общ.Количество КАК Количество,
				|	ОКР(Общ.СуммаПродажи / &Курс, 0) КАК СуммаПродажи,
				|	ОКР(Общ.СуммаБазовая / &Курс, 0) КАК СуммаБазовая,
				|	ВЫБОР
				|		КОГДА &СчитатьПоВсейНоменклатуре
				|				ИЛИ Общ.Номенклатура.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
				|			ТОГДА ОКР(Общ.Розница, 0)
				|		ИНАЧЕ 0
				|	КОНЕЦ / &Курс КАК Розница,
				|	Общ.Комиссия / 2 / &Курс КАК Комиссия,
				|	ВЫБОР
				|		КОГДА &СчитатьПоВсейНоменклатуре
				|				ИЛИ Общ.Номенклатура.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
				|			ТОГДА ОКР(Общ.СуммаБазовая * 0.05, 0)
				|		ИНАЧЕ 0
				|	КОНЕЦ / &Курс КАК Проценты,
				|	ВЫБОР
				|		КОГДА &СчитатьПоВсейНоменклатуре
				|				ИЛИ Общ.Номенклатура.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
				|			ТОГДА ОКР(Общ.СуммаБазовая * 0.05 + Общ.Розница + Общ.Комиссия, 0)
				|		ИНАЧЕ 0
				|	КОНЕЦ / &Курс КАК Общий,
				|	ВЫБОР
				|		КОГДА &СчитатьПоВсейНоменклатуре
				|				ИЛИ Общ.Номенклатура.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
				|			ТОГДА ОКР(Общ.СуммаБазовая, 0) - Общ.Цена * 0.7
				|		ИНАЧЕ 0
				|	КОНЕЦ / &Курс КАК Цена,
				|	Общ.Реклама / &Курс КАК Реклама,
				|	(ВЫБОР
				|		КОГДА &СчитатьПоВсейНоменклатуре
				|				ИЛИ Общ.Номенклатура.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
				|			ТОГДА ОКР(Общ.СуммаБазовая * 0.05 + Общ.Розница + Общ.Комиссия, 0)
				|		ИНАЧЕ 0
				|	КОНЕЦ - Общ.Реклама) / &Курс КАК Прибыль,
				|	Общ.РекламнаяКампания КАК РекламнаяКампания,
				|	Общ.ЗаказПокупателя КАК ЗаказПокупателя,
				|	Общ.КлючИсточника КАК Referrer,
				|	Общ.ЗаказПокупателя.referrerSession КАК ReferrerSession
				|{ВЫБРАТЬ
				|	Документ.*,
				|	Контрагент.*,
				|	Номенклатура.*,
				|	ХарактеристикаНоменклатуры.*,
				|	Количество,
