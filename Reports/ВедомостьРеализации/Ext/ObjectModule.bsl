				|			ТОГДА ОКР(Общ.СуммаБазовая * 0.05, 0)
				|		ИНАЧЕ 0
				|	КОНЕЦ / &Курс КАК Проценты,
				|	ВЫБОР
				|		КОГДА &СчитатьПоВсейНоменклатуре
				|				ИЛИ Общ.Номенклатура.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
				|			ТОГДА ОКР(Общ.СуммаБазовая * 0.05 + Общ.Розница + Общ.Комиссия, 0)
				|		ИНАЧЕ 0
				|	КОНЕЦ / &Курс КАК Общий,
				|	ВЫБОР
				|		КОГДА &СчитатьПоВсейНоменклатуре
				|				ИЛИ Общ.Номенклатура.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
				|			ТОГДА ОКР(Общ.СуммаБазовая, 0) - Общ.Цена * 0.7
				|		ИНАЧЕ 0
				|	КОНЕЦ / &Курс КАК Цена,
				|	Общ.Реклама / &Курс КАК Реклама,
				|	(ВЫБОР
				|		КОГДА &СчитатьПоВсейНоменклатуре
				|				ИЛИ Общ.Номенклатура.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
				|			ТОГДА ОКР(Общ.СуммаБазовая * 0.05 + Общ.Розница + Общ.Комиссия, 0)
				|		ИНАЧЕ 0
				|	КОНЕЦ - Общ.Реклама) / &Курс КАК Прибыль,
				|	Общ.РекламнаяКампания КАК РекламнаяКампания,
				|	// Тип цен строки, а не документа: у поступления реквизит «Тип цен»
				|	// ссылается на ТипыЦенНоменклатурыКонтрагентов, а у реализации -
				|	// на ТипыЦенНоменклатуры. Это разные справочники, и через
				|	// «Документ.Тип цен» реклама с продажами не сойдётся никогда.
				|	// У продаж берём тип цен документа, у рекламы - тип цен кампании.
				|	Общ.ТипЦенСегмента КАК ТипЦенСегмента,
				|	Общ.ЗаказПокупателя КАК ЗаказПокупателя,
				|	// ИСТОЧНИК - ОДНО ПОЛЕ НА ВЕСЬ ОТЧЁТ. Заказ приезжает с сайта
				|	// с двумя источниками: referrer - первое касание (кука referrerMy,
				|	// живёт 30 дней), referrerSession - источник того визита, в котором
				|	// оформлен заказ. Здесь они сводятся в один по правилу «последний
				|	// непрямой клик»: берём источник визита, а если он прямой или пустой
				|	// (вернулся из закладки, умерла сессия) - отдаём кредит первому
				|	// касанию. Так считают и сами кабинеты, и дашборд сайта
				|	// (order_referrer). Замер 16.08.2026 по 258 сравнимым заказам: чистое
				|	// первое касание недодавало рекламе ~59 тыс. грн, чистая сессия
				|	// увела бы в «прямые» 45 тыс. грн - у половины заказов последний
				|	// переход прямой.
				|	// Расход рекламы садится сюда же: у его строк оба ключа - ключ
				|	// кампании, собранный так же, как источник в заказе.
				|	// Если у кампании заполнен старый ключ, переписываем им заказ
				|	// на текущий - тогда история садится на ту же строку, что и расход
				|	// (карта - ВТСтарыйКлюч выше).
				|	// Заказы контрагента «Марина Цветкова» (код 000000364) - целиком
				|	// инстаграм, независимо от того, что стоит в источнике. Это
				|	// аккаунт-менеджер: заказы из директа и комментариев она оформляет
				|	// сама, и в базе у них либо пусто, либо direct (по 2026 году:
				|	// 593 заказа, из них 151 без источника, остальные direct/direct
				|	// cvetkov, с рекламной меткой всего 2). Дашборд сайта считает их
				|	// инстаграмом давно (Shop::orderSrcSql по force_rozn), здесь - то же
				|	// самое, чтобы расход инстаграм-кабинета встречал свою выручку.
				|	// Заказ, пришедший по клику на рекламу, тоже уедет сюда - решение
				|	// сознательное («все заказы»), таких единицы.
				|	ВЫБОР
				|		КОГДА Общ.Контрагент.Код = ""000000364""
				|			ТОГДА ""instagram""
				|		КОГДА ЕСТЬNULL(ЕСТЬNULL(СтарыйКлючСессии.КлючИсточника, Общ.КлючИсточникаСессии), """") В ("""", ""direct"", ""direct cvetkov"")
				|			ТОГДА ЕСТЬNULL(СтарыйКлюч.КлючИсточника, Общ.КлючИсточника)
				|		ИНАЧЕ ЕСТЬNULL(СтарыйКлючСессии.КлючИсточника, Общ.КлючИсточникаСессии)
				|	КОНЕЦ КАК Referrer,
				|	// Периоды считаем от даты документа - той же, по которой отчёт
				|	// отбирает строки (&НачДата/&КонДата). Расход рекламы приходит
				|	// отдельным поступлением на каждый день, поэтому неделя и месяц
				|	// у выручки и у расхода сходятся.
				|	НАЧАЛОПЕРИОДА(Общ.ДатаДокумента, ДЕНЬ) КАК ПериодДень,
				|	НАЧАЛОПЕРИОДА(Общ.ДатаДокумента, НЕДЕЛЯ) КАК ПериодНеделя,
				|	НАЧАЛОПЕРИОДА(Общ.ДатаДокумента, МЕСЯЦ) КАК ПериодМесяц,
				|	НАЧАЛОПЕРИОДА(Общ.ДатаДокумента, КВАРТАЛ) КАК ПериодКвартал,
				|	НАЧАЛОПЕРИОДА(Общ.ДатаДокумента, ГОД) КАК ПериодГод
				|{ВЫБРАТЬ
				|	Документ.*,
				|	Контрагент.*,
				|	Номенклатура.*,
				|	ХарактеристикаНоменклатуры.*,
				|	Количество,
				|	СуммаПродажи,
				|	СуммаБазовая,
				|	Розница,
				|	Комиссия,
				|	Общий,
				|	Проценты,
				|	Цена,
				|	Реклама,
				|	Прибыль,
				|	РекламнаяКампания.*,
				|	ТипЦенСегмента.*,
				|	ЗаказПокупателя.*,
				|	Referrer,
				|	ПериодДень,
				|	ПериодНеделя,
				|	ПериодМесяц,
				|	ПериодКвартал,
				|	ПериодГод}
				|ИЗ
				|	Общ КАК Общ
				|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСтарыйКлюч КАК СтарыйКлюч
				|		ПО СтарыйКлюч.Старый = Общ.КлючИсточника
				|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСтарыйКлюч КАК СтарыйКлючСессии
				|		ПО СтарыйКлючСессии.Старый = Общ.КлючИсточникаСессии
				|{ГДЕ
				|	Общ.Документ.*,
				|	Общ.Контрагент.*,
				|	Общ.Номенклатура.*,
				|	Общ.ХарактеристикаНоменклатуры.*,
				|	Общ.Количество,
				|	Общ.СуммаПродажи,
				|	Общ.СуммаБазовая,
				|	Общ.Розница,
				|	Общ.Комиссия,
				|	Общ.Реклама,
				|	Общ.РекламнаяКампания.*,
				|	Общ.ТипЦенСегмента.*,
				|	Общ.ЗаказПокупателя.*}
				|{УПОРЯДОЧИТЬ ПО
				|	Документ.*,
				|	Контрагент.*,
				|	Номенклатура.*,
				|	ХарактеристикаНоменклатуры.*,
				|	Количество,
				|	СуммаПродажи,
				|	СуммаБазовая,
				|	Розница,
				|	Комиссия,
				|	Общий,
				|	Цена,
				|	Реклама,
				|	Прибыль,
				|	РекламнаяКампания.*,
				|	ТипЦенСегмента.*,
				|	ЗаказПокупателя.*,
				|	Referrer,
				|	ПериодДень,
				|	ПериодНеделя,
				|	ПериодМесяц,
				|	ПериодКвартал,
				|	ПериодГод}
				|ИТОГИ
				|	СУММА(Количество),
				|	СУММА(СуммаПродажи),
				|	СУММА(СуммаБазовая),
				|	СУММА(Розница),
				|	СУММА(Комиссия),
				|	СУММА(Проценты),
				|	СУММА(Общий),
				|	СУММА(Цена),
				|	СУММА(Реклама),
				|	СУММА(Прибыль)
				|ПО
				|	ОБЩИЕ,
				|	Документ,
				|	Контрагент,
				|	Номенклатура,
				|	ХарактеристикаНоменклатуры
				|{ИТОГИ ПО
				|	Документ.*,
				|	Контрагент.*,
				|	Номенклатура.*,
				|	ХарактеристикаНоменклатуры.*,
				|	Количество,
				|	СуммаПродажи,
				|	СуммаБазовая,
				|	Розница,
				|	Комиссия,
