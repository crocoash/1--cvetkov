#Если Клиент Тогда
	
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ НАЧАЛЬНОЙ НАСТРОЙКИ ОТЧЕТА

// Процедура установки начальных настроек отчета с использованием текста запроса
//
Процедура УстановитьНачальныеНастройкиУпр(ДополнительныеПараметры = Неопределено)
	
	// Дополнительные параметры, переданные из отчета, вызвавшего расшифровку.
	// Информация, передаваемая в переменной ДополнительныеПараметры, может быть использована
	// для реализации специфичных для данного отчета параметрических настроек.
	// Описание исходного текста запроса.
	

		Запрос = Новый Запрос;
		ТекстЗапроса = 
		
				"ВЫБРАТЬ
				|	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
				|	ВЫБОР
				|		КОГДА основная.Ссылка ЕСТЬ NULL
				|			ТОГДА неосновная.Ссылка
				|		ИНАЧЕ основная.Ссылка
				|	КОНЕЦ КАК Ростовка,
				|	ХарактеристикиНоменклатуры.Владелец КАК Владелец
				|ПОМЕСТИТЬ ВТРостовка
				|ИЗ
				|	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
				|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			МАКСИМУМ(ГруппыХарактеристикХарактеристики.Ссылка) КАК Ссылка,
				|			ГруппыХарактеристикХарактеристики.Характеристика КАК Характеристика
				|		ИЗ
				|			Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
				|		ГДЕ
				|			ГруппыХарактеристикХарактеристики.Ссылка.НеОсновная
				|		
				|		СГРУППИРОВАТЬ ПО
				|			ГруппыХарактеристикХарактеристики.Характеристика) КАК неосновная
	 			|		ПО ХарактеристикиНоменклатуры.Ссылка = неосновная.Характеристика
				|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			МАКСИМУМ(ГруппыХарактеристикХарактеристики.Ссылка) КАК Ссылка,
				|			ГруппыХарактеристикХарактеристики.Характеристика КАК Характеристика
				|		ИЗ
				|			Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
				|		ГДЕ
				|			НЕ ГруппыХарактеристикХарактеристики.Ссылка.НеОсновная
				|		
				|		СГРУППИРОВАТЬ ПО
				|			ГруппыХарактеристикХарактеристики.Характеристика) КАК основная
				|		ПО ХарактеристикиНоменклатуры.Ссылка = основная.Характеристика
				|ГДЕ
				|	ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры.Код В (""000000010"", ""000000001"")
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	РеализацияТоваровУслугТовары.Ссылка КАК Документ,
				|	РеализацияТоваровУслугТовары.Ссылка.Контрагент КАК Контрагент,
				|	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
				|	РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
				|	РеализацияТоваровУслугТовары.Количество КАК Количество,
				|	РеализацияТоваровУслугТовары.Сумма КАК СуммаПродажи,
				|	ПолучимЦену.Цена * РеализацияТоваровУслугТовары.Количество * (1 - (ЕСТЬNULL(ВЫБОР
				|			КОГДА &ПрименятьРучнуюСкидку
				|				ТОГДА РеализацияТоваровУслугТовары.ПроцентСкидкиНаценки
				|			ИНАЧЕ 0
				|		КОНЕЦ, 0) + ВЫБОР
				|		КОГДА ЕСТЬNULL(ПолучимСкидку.ПроцентСкидкиНаценки, 0) = 0
				|				И ЕСТЬNULL(РеализацияТоваровУслугТовары.ПроцентАвтоматическихСкидок, 0) > 0
				|			ТОГДА ЕСТЬNULL(РеализацияТоваровУслугТовары.ПроцентАвтоматическихСкидок, 0)
				|		ИНАЧЕ ЕСТЬNULL(ПолучимСкидку.ПроцентСкидкиНаценки, 0)
				|	КОНЕЦ) / 100) КАК СуммаБазовая,
				|	РеализацияТоваровУслугТовары.Сумма - ПолучимЦену.Цена * РеализацияТоваровУслугТовары.Количество * (1 - (ЕСТЬNULL(ВЫБОР
				|			КОГДА &ПрименятьРучнуюСкидку
				|				ТОГДА РеализацияТоваровУслугТовары.ПроцентСкидкиНаценки
				|			ИНАЧЕ 0
				|		КОНЕЦ, 0) + ВЫБОР
				|		КОГДА ЕСТЬNULL(ПолучимСкидку.ПроцентСкидкиНаценки, 0) = 0
				|				И ЕСТЬNULL(РеализацияТоваровУслугТовары.ПроцентАвтоматическихСкидок, 0) > 0
				|			ТОГДА ЕСТЬNULL(РеализацияТоваровУслугТовары.ПроцентАвтоматическихСкидок, 0)
				|		ИНАЧЕ ЕСТЬNULL(ПолучимСкидку.ПроцентСкидкиНаценки, 0)
				|	КОНЕЦ) / 100) КАК Розница,
				|	ВЫБОР
				|		КОГДА РеализацияТоваровУслугТовары.Ссылка.Контрагент.Код = ""000004317""
				|			ТОГДА ВЫБОР
				|					КОГДА РеализацияТоваровУслугТовары.Сумма > 2000
				|						ТОГДА 0.15 * РеализацияТоваровУслугТовары.Сумма
				|					ИНАЧЕ 0.2 * РеализацияТоваровУслугТовары.Сумма
				|				КОНЕЦ
				|		ИНАЧЕ ВЫБОР
				|				КОГДА НЕ РеализацияТоваровУслугТовары.Ссылка.Контрагент.комиссия = 0
				|					ТОГДА РеализацияТоваровУслугТовары.Ссылка.Контрагент.комиссия / 100 * РеализацияТоваровУслугТовары.Сумма
				|				ИНАЧЕ 0
				|			КОНЕЦ
				|	КОНЕЦ КАК Комиссия,
				|	ПолучимПервуюЦену.Цена КАК Цена,
				|	РеализацияТоваровУслугТовары.ЗаказПокупателя КАК ЗаказПокупателя,
				|	0 КАК Реклама,
				|	РеализацияТоваровУслугТовары.ЗаказПокупателя.referrer КАК КлючИсточника,
				|	ЗНАЧЕНИЕ(Справочник.РекламныеКампании.ПустаяСсылка) КАК РекламнаяКампания
				|ПОМЕСТИТЬ Общ
				|ИЗ
				|	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
				|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			МАКСИМУМ(ЦеныНоменклатуры.Период) КАК Период,
				|			ЦеныНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
				|			РеализацияТоваровУслугТовары.Ссылка КАК Реализация,
				|			РеализацияТоваровУслугТовары.НомерСтроки КАК НомерСтроки
				|		ИЗ
				|			Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
				|				ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
				|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипыЦенНоменклатуры КАК ТипыЦенНоменклатуры
				|					ПО ЦеныНоменклатуры.ТипЦен = ТипыЦенНоменклатуры.Ссылка
				|				ПО РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры = ЦеныНоменклатуры.ХарактеристикаНоменклатуры
				|					И (ВЫБОР
				|						КОГДА РеализацияТоваровУслугТовары.ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
				|							ТОГДА РеализацияТоваровУслугТовары.Ссылка.Дата
				|						ИНАЧЕ РеализацияТоваровУслугТовары.ЗаказПокупателя.Дата
				|					КОНЕЦ >= ЦеныНоменклатуры.Период)
				|		ГДЕ
				|			ТипыЦенНоменклатуры.Код = ""000000001""
				|		
				|		СГРУППИРОВАТЬ ПО
				|			ЦеныНоменклатуры.ХарактеристикаНоменклатуры,
				|			РеализацияТоваровУслугТовары.Ссылка,
				|			РеализацияТоваровУслугТовары.НомерСтроки) КАК ПолучимПериодЦены
				|			ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|				ПолучимЦену.ХарактеристикаНоменклатуры КАК Характеристики,
				|				ПолучимЦену.Цена КАК Цена,
				|				ПолучимЦену.Период КАК Период
				|			ИЗ
				|				РегистрСведений.ЦеныНоменклатуры КАК ПолучимЦену
				|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТипыЦенНоменклатуры КАК ТипыЦенНоменклатуры
				|					ПО ПолучимЦену.ТипЦен = ТипыЦенНоменклатуры.Ссылка
				|			ГДЕ
				|				ТипыЦенНоменклатуры.Ссылка = &БазовыйТипЦен) КАК ПолучимЦену
				|			ПО ПолучимПериодЦены.ХарактеристикаНоменклатуры = ПолучимЦену.Характеристики
				|				И ПолучимПериодЦены.Период = ПолучимЦену.Период
				|		ПО РеализацияТоваровУслугТовары.Ссылка = ПолучимПериодЦены.Реализация
				|			И РеализацияТоваровУслугТовары.НомерСтроки = ПолучимПериодЦены.НомерСтроки
				|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				|			РеализацияТоваровУслугТовары.Ссылка КАК Реализация,
				|			МАКСИМУМ(СкидкиНаценкиНоменклатуры.Период) КАК Период,
				|			РеализацияТоваровУслугТовары.НомерСтроки КАК НомерСтроки,
				|			СкидкиНаценкиНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
				|		ИЗ
				|			Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
				|				ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.СкидкиНаценкиНоменклатуры КАК СкидкиНаценкиНоменклатуры
				|				ПО РеализацияТоваровУслугТовары.ЗаказПокупателя.Дата >= СкидкиНаценкиНоменклатуры.Период
				|					И (СкидкиНаценкиНоменклатуры.ХарактеристикаНоменклатуры В
				|						(ВЫБРАТЬ
				|							ПолучимХарактеристикуНк.Ссылка КАК ХарактеристикаНк
				|						ИЗ
				|							Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
				|								ЛЕВОЕ СОЕДИНЕНИЕ ВТРостовка КАК ВТРостовка
				|									ПОЛНОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ПолучимХарактеристикуНк
				|									ПО
				|										ВТРостовка.Ростовка.Наименование = ПолучимХарактеристикуНк.Наименование
				|											И ВТРостовка.Характеристика.Владелец.Код = ПолучимХарактеристикуНк.Владелец.Нк
				|								ПО
				|									ХарактеристикиНоменклатуры.Ссылка = ВТРостовка.Характеристика
				|						ГДЕ
				|							ХарактеристикиНоменклатуры.Ссылка = РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры))
				|		
				|		СГРУППИРОВАТЬ ПО
