// ПРОЦЕДУРЫ И ФУНКЦИИ ФОРМИРОВАНИЯ ОТЧЕТА 
	
// Процедура формирования отчета
//
Процедура СформироватьОтчет(ТабличныйДокумент) Экспорт
	
	УниверсальныйОтчет.ПостроительОтчета.Параметры.Вставить("НачДата"              , УниверсальныйОтчет.ДатаНач);
	УниверсальныйОтчет.ПостроительОтчета.Параметры.Вставить("КонДата"              , КонецДня(УниверсальныйОтчет.ДатаКон));
	УниверсальныйОтчет.ПостроительОтчета.Параметры.Вставить("БазовыйТипЦен"        , БазовыйТипЦен);
	//УниверсальныйОтчет.ПостроительОтчета.Параметры.Вставить(" "                 , БазовыйТипЦен.ПроцентСкидкиНаценки);
	УниверсальныйОтчет.ПостроительОтчета.Параметры.Вставить("ПрименятьРучнуюСкидку", ПрименятьРучнуюСкидкуКБазовойСумме);
	// Ложь - Розница/Проценты/Общий/Цена считаются только по номенклатуре с незаполненной организацией (как было).
	// Истина - условие по организации снимается, считается по всей номенклатуре.
	УниверсальныйОтчет.ПостроительОтчета.Параметры.Вставить("СчитатьПоВсейНоменклатуре", СчитатьПоВсейНоменклатуре);
	УниверсальныйОтчет.ПостроительОтчета.Параметры.Вставить("ТекущаяДата", ТекущаяДата()); 
 	УниверсальныйОтчет.ПостроительОтчета.Параметры.Вставить("Курс",?(Курс = 0,1, Курс)); 

	
	УниверсальныйОтчет.ВыводитьДетальныеЗаписи = Ложь;
	// Перед формирование отчета можно установить необходимые параметры универсального отчета.
	
	УниверсальныйОтчет.СформироватьОтчет(ТабличныйДокумент);

КонецПроцедуры // СформироватьОтчет()

