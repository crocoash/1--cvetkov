		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказПокупателя.Ссылка,
	ЗаказПокупателя.Дропшипер,
	ЗаказПокупателя.СуммаДокумента,
	ЗаказПокупателя.СуммаНоваяПочта,
	ВЫБОР
		КОГДА ЗаказПокупателя.ТипОбратнойДоставки = ЗНАЧЕНИЕ(Справочник.ЛМ_ВидыОбратнойДоставки.ПредоплатаНаКарту)
			ТОГДА ВЫБОР
					КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;НеУдачные
							И ЗаказПокупателя.ОплатилПоставщику = ЛОЖЬ
						ТОГДА ЗаказПокупателя.СуммаНоваяПочта
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;Завершенные
					ТОГДА ЗаказПокупателя.СуммаДокумента - ЗаказПокупателя.СуммаНоваяПочта
				ИНАЧЕ 0
			КОНЕЦ
	КОНЕЦ КАК Поле1,
	ВЫБОР
		КОГДА ЗаказПокупателя.ТипОбратнойДоставки = ЗНАЧЕНИЕ(Справочник.ЛМ_ВидыОбратнойДоставки.ПредоплатаНаКарту)
			ТОГДА ВЫБОР
					КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;Завершенные
							И ЗаказПокупателя.ОплатилПоставщику = ИСТИНА
						ТОГДА 0 - ЗаказПокупателя.СуммаНоваяПочта
					ИНАЧЕ 0
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;НеУдачные
					ТОГДА 0 - ЗаказПокупателя.СтоимостьДоставки
				ИНАЧЕ 0
			КОНЕЦ
	КОНЕЦ КАК Поле2,
	ВЫБОР
		КОГДА ЗаказПокупателя.ТипОбратнойДоставки = ЗНАЧЕНИЕ(Справочник.ЛМ_ВидыОбратнойДоставки.ПредоплатаНаКарту)
			ТОГДА ВЫБОР
					КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;НеУдачные
							И ЗаказПокупателя.ОплатилПоставщику = ЛОЖЬ
						ТОГДА "оплачено посреднику"
					ИНАЧЕ ВЫБОР
							КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;Завершенные
								ТОГДА ВЫБОР
										КОГДА ЗаказПокупателя.ОплатилПоставщику = ИСТИНА
											ТОГДА "оплачено нам"
										ИНАЧЕ "оплачено посреднику"
									КОНЕЦ
							ИНАЧЕ "возврат"
						КОНЕЦ
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;Завершенные
					ТОГДА "доход с наложенного"
				ИНАЧЕ ВЫБОР
						КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;НеУдачные
							ТОГДА "возврат"
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК Поле3,
	ЗаказПокупателя.СтоимостьДоставки,
	ВЫБОР
		КОГДА ЗаказПокупателя.ТипОбратнойДоставки = ЗНАЧЕНИЕ(Справочник.ЛМ_ВидыОбратнойДоставки.ПредоплатаНаКарту)
			ТОГДА ВЫБОР
					КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;НеУдачные
							И ЗаказПокупателя.ОплатилПоставщику = ЛОЖЬ
						ТОГДА ЗаказПокупателя.СуммаНоваяПочта
					ИНАЧЕ ВЫБОР
							КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;Завершенные
									И ЗаказПокупателя.ОплатилПоставщику = ИСТИНА
								ТОГДА 0 - ЗаказПокупателя.СуммаНоваяПочта
							ИНАЧЕ 0
						КОНЕЦ
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;Завершенные
					ТОГДА ЗаказПокупателя.СуммаДокумента - ЗаказПокупателя.СуммаНоваяПочта
				ИНАЧЕ ВЫБОР
						КОГДА ЗаказПокупателя.СтатусЗаказа = &amp;НеУдачные
							ТОГДА 0 - ЗаказПокупателя.СтоимостьДоставки
						ИНАЧЕ 0
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК Поле4,
	ЗаказПокупателя.Комментарий
ИЗ
	Документ.ЗаказПокупателя КАК ЗаказПокупателя
ГДЕ
	ЗаказПокупателя.Проведен
	И ЗаказПокупателя.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И ЗаказПокупателя.Дропшипер.БыстрыйФильтр
	И ВЫБОР
			КОГДА НЕ &amp;ПоказыватьОплаченные
				ТОГДА ЗаказПокупателя.ОплаченоДропшиперу = ЛОЖЬ
			ИНАЧЕ ЗаказПокупателя.ОплаченоДропшиперу = ЛОЖЬ
					ИЛИ ЗаказПокупателя.ОплаченоДропшиперу = ИСТИНА
		КОНЕЦ</query>
	</dataSet>
