<?xml version="1.0" encoding="windows-1251"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:annotation>
		<xs:documentation>ПОДАТКОВА ДЕКЛАРАЦІЯ З ПОДАТКУ НА ДОДАНУ ВАРТІСТЬ
		(ЗАТВЕРДЖЕНО Наказ Міністерства фінансів України 25.11.2011 p. № 1492)
		 </xs:documentation>
	</xs:annotation>
	<xs:include schemaLocation="common_types.xsd"/>
	<xs:element name="DECLAR" type="DeclarContent"/>
	<xs:complexType name="DeclarContent">
		<xs:sequence>
			<xs:element name="DECLARHEAD" type="DHead"/>
			<xs:element name="DECLARBODY" type="DBody">
			<xs:unique name="UT1RXXXXG2S"><xs:selector xpath="T1RXXXXG2S"/><xs:field xpath="@ROWNUM"/></xs:unique>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DHead">
		<xs:sequence>
			<xs:element name="TIN" type="DGLong"/>
			<xs:element name="C_DOC" type="xs:string" fixed="F02"/>
			<xs:element name="C_DOC_SUB" type="xs:string" fixed="001"/>
			<xs:element name="C_DOC_VER" type="xs:string" fixed="11"/>
			<xs:element name="C_DOC_TYPE" type="xs:nonNegativeInteger"/>
			<xs:element name="C_DOC_CNT" type="xs:nonNegativeInteger"/>
			<xs:element name="C_REG" type="DGsti"/>
			<xs:element name="C_RAJ" type="DGsti"/>
			<xs:element name="PERIOD_MONTH" type="DGMonth"/>
			<xs:element name="PERIOD_TYPE" type="DGPType"/>
			<xs:element name="PERIOD_YEAR" type="DGYear"/>
			<xs:element name="C_STI_ORIG" type="DGc_dpi"/>
			<xs:element name="C_DOC_STAN" type="DGSTAN"/>
			<xs:element name="LINKED_DOCS" nillable="true" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="DOC" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="C_DOC" type="DGC_DOC"/>
									<xs:element name="C_DOC_SUB" type="DGC_DOC_SUB"/>
									<xs:element name="C_DOC_VER" type="DGC_DOC_VER"/>
									<xs:element name="C_DOC_TYPE" type="xs:nonNegativeInteger"/>
									<xs:element name="C_DOC_CNT" type="xs:nonNegativeInteger"/>
									<xs:element name="C_DOC_STAN" type="DGSTAN"/>
									<xs:element name="FILENAME" type="DGFilename"/>
								</xs:sequence>
								<xs:attribute name="NUM" type="xs:nonNegativeInteger"/>
								<xs:attribute name="TYPE" type="DGTypeLinkDoc"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
				<xs:unique name="UH_DOC_NUM">
					<xs:selector xpath="DOC"/>
					<xs:field xpath="@NUM"/>
				</xs:unique>
			</xs:element>
			<xs:element name="D_FILL" type="DGDate"/>
			<xs:element name="SOFTWARE" type="xs:string" nillable="true" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="DBody">
		<xs:sequence>
			<!--HEAD-->
			<xs:choice>
				<xs:element name="HZ" type="DGchk"/>
				<xs:element name="HZN" type="DGchk"/>
			</xs:choice>
			<xs:element name="HZY" type="DGYear"/>
			<xs:choice>
				<xs:element name="HZKV" type="DGKv"/>
				<xs:element name="HZM" type="DGMonth"/>
			</xs:choice>
			<xs:element name="HZYP" type="DGYear" nillable="true" minOccurs="0"/>
			<xs:choice>
				<xs:element name="HZKVP" type="DGKv" nillable="true" minOccurs="0"/>
				<xs:element name="HZMP" type="DGMonth" nillable="true" minOccurs="0"/>
			</xs:choice>
			<xs:element name="HVPP" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="HNAME" type="DGHNAME"/>

				<xs:element name="HTIN" type="DGHTINF"/>

			<xs:element name="HNPDV" type="DGHNPDV"/>
			<xs:element name="HNSPDV" type="DGHNSPDV"/>
			<xs:element name="HLOC" type="DGHLOC"/>
			<xs:element name="HZIP" type="DGHZIP" nillable="true" minOccurs="0"/>
			<xs:element name="HTEL" type="DGHTEL" nillable="true" minOccurs="0"/>
			<xs:element name="HFAX" type="DGHFAX" nillable="true" minOccurs="0"/>
			<xs:element name="HEMAIL" type="DGHEMAIL" nillable="true" minOccurs="0"/>
			<xs:element name="HSTI" type="DGHSTI"/>
			<xs:element name="H007" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="H008" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="H009" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="H010" type="DGchk" nillable="true" minOccurs="0"/>
			<!--BODY-->
			<xs:element name="R10GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R10GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R21GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R22GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R30GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R40GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R50GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R60GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R61GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R70GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R70GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R80GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R80GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R81GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R81GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R811GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R82GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R82GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R90GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R101GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R101GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R102GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R111GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R112GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R121GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R121GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R122GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R122GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R123GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R124GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R124GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R131GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R132GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R133GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R141GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R142GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R150GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R151G3" type="DGdecimal2" nillable="true" minOccurs="0"/>
			<xs:element name="R151GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R151GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R152GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R160GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R160GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R161GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R161GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R1611GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R1612GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R1612GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R1613GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R162GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R162GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R163GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R164GA" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R164GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R170GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R180GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R190GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R201GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R202GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R210GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R211GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R212GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R213GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R220GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R230GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R231GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R232GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R240GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="R250GB" type="DGdecimal0" nillable="true" minOccurs="0"/>
			<xs:element name="HVM" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="HSK" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="HSP" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="HPR" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="HUR" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="HRPN" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="HD1P" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="HD8" type="DGchk" nillable="true" minOccurs="0"/>
			<xs:element name="HVMD" type="DGInom" nillable="true" minOccurs="0"/>
			<xs:element name="HJAR" type="DGchk" nillable="true" minOccurs="0"/>

			<xs:element name="T1RXXXXG2S" type="StrColumn" nillable="true" minOccurs="0" maxOccurs="9999"/>

			<!--FOOTER-->
			<xs:element name="HFILL" type="DGDate"/>
			<xs:element name="HBOS" type="DGHBOS"/>
			<xs:element name="HBUH" type="DGHBUH" nillable="true" minOccurs="0"/>
			<xs:element name="HKBUH" type="DGLong" nillable="true" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
