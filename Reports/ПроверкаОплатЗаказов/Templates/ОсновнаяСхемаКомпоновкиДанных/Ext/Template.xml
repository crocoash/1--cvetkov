		<query>ВЫБРАТЬ
	ВЫРАЗИТЬ(Расчеты.Сделка КАК Документ.ЗаказПокупателя) КАК Заказ,
	Расчеты.СуммаВзаиморасчетовОстаток КАК Остаток
ПОМЕСТИТЬ ВсеОстаткиПоЗаказам
ИЗ
	РегистрНакопления.РасчетыСКонтрагентами.Остатки(, Сделка ССЫЛКА Документ.ЗаказПокупателя) КАК Расчеты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВсеОстаткиПоЗаказам.Заказ КАК Заказ,
	СУММА(ВсеОстаткиПоЗаказам.Остаток) КАК Остаток
ПОМЕСТИТЬ ОстаткиПоЗаказам
ИЗ
	ВсеОстаткиПоЗаказам КАК ВсеОстаткиПоЗаказам
ГДЕ
	ВсеОстаткиПоЗаказам.Заказ.Дата &gt;= ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&amp;ТекущаяДата, ГОД), ГОД, -3)

СГРУППИРОВАТЬ ПО
	ВсеОстаткиПоЗаказам.Заказ

ИМЕЮЩИЕ
	СУММА(ВсеОстаткиПоЗаказам.Остаток) &lt;&gt; 0
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВЫРАЗИТЬ(Обороты.Сделка КАК Документ.ЗаказПокупателя) КАК Заказ,
	СУММА(Обороты.СуммаВзаиморасчетовПриход) КАК Начислено,
	СУММА(Обороты.СуммаВзаиморасчетовРасход) КАК Оплачено
ПОМЕСТИТЬ ОборотыПоЗаказам
ИЗ
	РегистрНакопления.РасчетыСКонтрагентами.Обороты(, , , Сделка В
			(ВЫБРАТЬ
				ОстаткиПоЗаказам.Заказ
			ИЗ
				ОстаткиПоЗаказам КАК ОстаткиПоЗаказам)) КАК Обороты

СГРУППИРОВАТЬ ПО
	ВЫРАЗИТЬ(Обороты.Сделка КАК Документ.ЗаказПокупателя)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ОстаткиПоЗаказам.Заказ КАК Заказ,
	ОстаткиПоЗаказам.Заказ.Дата КАК Дата,
	ОстаткиПоЗаказам.Заказ.Номер КАК Номер,
	ОстаткиПоЗаказам.Заказ.Контрагент КАК Контрагент,
	ОстаткиПоЗаказам.Заказ.СтатусЗаказа КАК СтатусЗаказа,
	ОстаткиПоЗаказам.Заказ.ВидОплатыЗаказа КАК ВидОплатыЗаказа,
	ОстаткиПоЗаказам.Заказ.Ответственный КАК Ответственный,
	ОстаткиПоЗаказам.Заказ.НомерТТН КАК НомерТТН,
	ОстаткиПоЗаказам.Заказ.ПометкаУдаления КАК ПометкаУдаления,
	ОстаткиПоЗаказам.Заказ.СуммаДокумента КАК СуммаЗаказа,
	ОстаткиПоЗаказам.Заказ.СуммаНоваяПочта КАК СуммаНоваяПочта,
	ОстаткиПоЗаказам.Заказ.РазницаСумма КАК РазницаСНовойПочтой,
	ЕСТЬNULL(ОборотыПоЗаказам.Начислено, 0) КАК Начислено,
	ЕСТЬNULL(ОборотыПоЗаказам.Оплачено, 0) КАК Оплачено,
	ОстаткиПоЗаказам.Остаток КАК Остаток
ИЗ
	ОстаткиПоЗаказам КАК ОстаткиПоЗаказам
		ЛЕВОЕ СОЕДИНЕНИЕ ОборотыПоЗаказам КАК ОборотыПоЗаказам
		ПО ОстаткиПоЗаказам.Заказ = ОборотыПоЗаказам.Заказ</query>
