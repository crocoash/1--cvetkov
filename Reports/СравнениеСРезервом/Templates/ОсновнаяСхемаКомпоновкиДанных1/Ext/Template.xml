		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РеализацияТоваровУслугТовары.Номенклатура КАК Номенклатура,
	РеализацияТоваровУслугТовары.Сумма КАК Сумма1,
	РеализацияТоваровУслугТовары.Количество КАК Количество1,
	РеализацияТоваровУслугТовары.Ссылка.Контрагент КАК Контрагент,
	РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	NULL КАК Количество2,
	NULL КАК Сумма2
ПОМЕСТИТЬ Реализация
ИЗ
	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
ГДЕ
	РеализацияТоваровУслугТовары.Ссылка.Дата МЕЖДУ &amp;НачДата1 И &amp;КонДата1
	И РеализацияТоваровУслугТовары.Ссылка.Проведен

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	0,
	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток,
	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Контрагент,
	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры,
	NULL,
	NULL
ИЗ
	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(&amp;КонДата1, ) КАК ТоварыВРезервеНаСкладахОстатки

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	РеализацияТоваровУслугТовары.Номенклатура,
	NULL,
	NULL,
	РеализацияТоваровУслугТовары.Ссылка.Контрагент,
	РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры,
	РеализацияТоваровУслугТовары.Количество,
	РеализацияТоваровУслугТовары.Сумма
ИЗ
	Документ.РеализацияТоваровУслуг.Товары КАК РеализацияТоваровУслугТовары
ГДЕ
	РеализацияТоваровУслугТовары.Ссылка.Проведен
	И РеализацияТоваровУслугТовары.Ссылка.Дата МЕЖДУ &amp;НачДата2 И &amp;КонДата2

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ТоварыВРезервеНаСкладахОстатки.Номенклатура,
	NULL,
	NULL,
	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Контрагент,
	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры,
	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток,
	0
ИЗ
	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(&amp;КонДата2, ) КАК ТоварыВРезервеНаСкладахОстатки
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗначенияСвойствОбъектов.Значение КАК ТипИзделия,
	ЗначенияСвойствОбъектов.Объект КАК Объект
ПОМЕСТИТЬ ТипИзд
ИЗ
	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
ГДЕ
	ЗначенияСвойствОбъектов.Свойство.Код = "000000037"
	И ЗначенияСвойствОбъектов.Объект.Ссылка В
			(ВЫБРАТЬ
				ТЗ.Номенклатура КАК Ссылка
			ИЗ
				Реализация КАК ТЗ)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Реализация.Номенклатура КАК Номенклатура,
	СУММА(ЕСТЬNULL(Реализация.Количество1, 0)) КАК Количество1,
	Реализация.Контрагент КАК Контрагент,
	Реализация.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	СУММА(ЕСТЬNULL(Реализация.Количество2, 0)) КАК Количество2,
	Реализация.Количество1 - Реализация.Количество2 КАК Разница,
	ТипИзд.ТипИзделия КАК ТипИзделия
ИЗ
	Реализация КАК Реализация
		ЛЕВОЕ СОЕДИНЕНИЕ ТипИзд КАК ТипИзд
		ПО Реализация.Номенклатура = ТипИзд.Объект

СГРУППИРОВАТЬ ПО
	Реализация.Номенклатура,
	Реализация.Контрагент,
	Реализация.ХарактеристикаНоменклатуры,
	Реализация.Количество1 - Реализация.Количество2,
	ТипИзд.ТипИзделия</query>
