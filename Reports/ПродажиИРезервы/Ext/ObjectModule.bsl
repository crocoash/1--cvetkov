
Функция ПолучитьТаблицуРезервов(ДатаКон)
	
	ТипЦенМелкийОпт = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000014");
	ТипКомплект     = Перечисления.ТипыНоменклатуры.Комплект;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ЗаказПокупателя,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Организация КАК Организация,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Контрагент КАК Контрагент,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Контрагент.Регион КАК Регион,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.НК КАК НК,
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК Количество,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.ТипЦен КАК ТипЦен,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Дата КАК Дата,
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура.ЕдиницаХраненияОстатков КАК Единица,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.ВалютаДокумента КАК Валюта,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.КурсВзаиморасчетов КАК Курс,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.КратностьВзаиморасчетов КАК Кратность,
		|	0 КАК Сумма,
		|	0 КАК СуммаБезСкидок,
		|	0 КАК СуммаСкидки
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(&ДатаКон, ДокументРезерва <> НЕОПРЕДЕЛЕНО) КАК ТоварыВРезервеНаСкладахОстатки
		|ГДЕ
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток > 0";
	
	
	Запрос.УстановитьПараметр("ДатаКон", ДатаКон);
	
	ТЗРезервы = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТЗ Из ТЗРезервы Цикл
		
		Если ЗначениеЗаполнено(СтрокаТЗ.НК) Тогда
			
			НайденныеСтроки = СтрокаТЗ.ЗаказПокупателя.Товары.НайтиСтроки(Новый Структура("ХарактеристикаНоменклатуры", СтрокаТЗ.НК));
			
		Иначе
			
			НайденныеСтроки = СтрокаТЗ.ЗаказПокупателя.Товары.НайтиСтроки(Новый Структура("Номенклатура, ХарактеристикаНоменклатуры", СтрокаТЗ.Номенклатура, СтрокаТЗ.ХарактеристикаНоменклатуры));
			
		КонецЕсли;
		
		ТипЦен = СтрокаТЗ.ТипЦен;
		Скидка = 0;
		
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			Если ТипЦен.Код = "000000001" И
				 НайденныеСтроки[0].Номенклатура.ВидНоменклатуры.ТипНоменклатуры <> ТипКомплект Тогда
				
				ТипЦен = ТипЦенМелкийОпт;
				
			КонецЕсли;
			
			Скидка = НайденныеСтроки[0].ПроцентСкидкиНаценки + НайденныеСтроки[0].ПроцентАвтоматическихСкидок;
			
		КонецЕсли;
		
		ЦенаБС = Ценообразование.ПолучитьЦенуНоменклатуры(
														  СтрокаТЗ.Номенклатура,
														  СтрокаТЗ.ХарактеристикаНоменклатуры,
														  ТипЦен,
														  СтрокаТЗ.Дата,
														  СтрокаТЗ.Единица,
														  СтрокаТЗ.Валюта,
														  СтрокаТЗ.Курс,
														  СтрокаТЗ.Кратность,
														  ,
														  СтрокаТЗ.ДоговорКонтрагента);
		
		СтрокаТЗ.СуммаБезСкидок = СтрокаТЗ.Количество * ЦенаБС;
		СтрокаТЗ.СуммаСкидки    = СтрокаТЗ.СуммаБезСкидок * Скидка / 100;
		СтрокаТЗ.Сумма          = СтрокаТЗ.СуммаБезСкидок - СтрокаТЗ.СуммаСкидки;
		
	КонецЦикла;
	
	Возврат ТЗРезервы;
	
КонецФункции

Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Настройки = КомпоновщикНастроек.Настройки;
	
	Период1 = Настройки.ПараметрыДанных.Элементы.Найти("Период1").Значение;
	Период2 = Настройки.ПараметрыДанных.Элементы.Найти("Период2").Значение;
	Период3 = Настройки.ПараметрыДанных.Элементы.Найти("Период3").Значение;
	Период4 = Настройки.ПараметрыДанных.Элементы.Найти("Период4").Значение;
	Режим   = Настройки.ПараметрыДанных.Элементы.Найти("Режим").Значение;
	
	Если Режим = 1 Или Режим = 2 Тогда
		
		ТЗРезервы1 = ПолучитьТаблицуРезервов(Период1.ДатаОкончания);
		ТЗРезервы2 = ПолучитьТаблицуРезервов(Период2.ДатаОкончания);
		ТЗРезервы3 = ПолучитьТаблицуРезервов(Период3.ДатаОкончания);
		ТЗРезервы4 = ПолучитьТаблицуРезервов(Период4.ДатаОкончания);
		
	Иначе
		
		ТЗРезервы1 = Новый ТаблицаЗначений;
		
		ТЗРезервы1.Колонки.Добавить("ЗаказПокупателя"           , Новый ОписаниеТипов("ДокументСсылка.ЗаказПокупателя"));
		ТЗРезервы1.Колонки.Добавить("Организация"               , Новый ОписаниеТипов("СправочникСсылка.Организации"));
		ТЗРезервы1.Колонки.Добавить("Контрагент"                , Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		ТЗРезервы1.Колонки.Добавить("Регион"                    , Новый ОписаниеТипов("СправочникСсылка.Регионы"));
		ТЗРезервы1.Колонки.Добавить("ДоговорКонтрагента"        , Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
		ТЗРезервы1.Колонки.Добавить("Номенклатура"              , Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТЗРезервы1.Колонки.Добавить("ХарактеристикаНоменклатуры", Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
		ТЗРезервы1.Колонки.Добавить("Количество"                , Новый ОписаниеТипов("Число"));
		ТЗРезервы1.Колонки.Добавить("Сумма"                     , Новый ОписаниеТипов("Число"));
		ТЗРезервы1.Колонки.Добавить("СуммаБезСкидок"            , Новый ОписаниеТипов("Число"));
		ТЗРезервы1.Колонки.Добавить("СуммаСкидки"               , Новый ОписаниеТипов("Число"));
		
		ТЗРезервы2 = ТЗРезервы1.Скопировать();
		ТЗРезервы3 = ТЗРезервы1.Скопировать();
		ТЗРезервы4 = ТЗРезервы1.Скопировать();
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Резервы1.ЗаказПокупателя КАК ЗаказПокупателя,
		|	Резервы1.Организация КАК Организация,
		|	Резервы1.Контрагент КАК Контрагент,
		|	Резервы1.Регион КАК Регион,
		|	Резервы1.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	Резервы1.Номенклатура КАК Номенклатура,
		|	Резервы1.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	Резервы1.Количество КАК Количество,
		|	Резервы1.Сумма КАК Сумма,
		|	Резервы1.СуммаБезСкидок КАК СуммаБезСкидок,
		|	Резервы1.СуммаСкидки КАК СуммаСкидки
		|ПОМЕСТИТЬ ВТРезервы1
		|ИЗ
		|	&Резервы1 КАК Резервы1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Резервы2.ЗаказПокупателя КАК ЗаказПокупателя,
		|	Резервы2.Организация КАК Организация,
		|	Резервы2.Контрагент КАК Контрагент,
		|	Резервы2.Регион КАК Регион,
		|	Резервы2.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	Резервы2.Номенклатура КАК Номенклатура,
		|	Резервы2.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	Резервы2.Количество КАК Количество,
		|	Резервы2.Сумма КАК Сумма,
		|	Резервы2.СуммаБезСкидок КАК СуммаБезСкидок,
		|	Резервы2.СуммаСкидки КАК СуммаСкидки
		|ПОМЕСТИТЬ ВТРезервы2
		|ИЗ
		|	&Резервы2 КАК Резервы2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Резервы3.ЗаказПокупателя КАК ЗаказПокупателя,
		|	Резервы3.Организация КАК Организация,
		|	Резервы3.Контрагент КАК Контрагент,
		|	Резервы3.Регион КАК Регион,
		|	Резервы3.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	Резервы3.Номенклатура КАК Номенклатура,
