		<query>ВЫБРАТЬ
	ПропустившиеВызов.Ссылка.Дата,
	ПропустившиеВызов.Ссылка,
	ВЫБОР
		КОГДА ПропустившиеВызов.Dst_Ссылка = НЕОПРЕДЕЛЕНО
			ТОГДА ПропустившиеВызов.Dst
		ИНАЧЕ ПропустившиеВызов.Dst_Ссылка
	КОНЕЦ КАК Сотрудник,
	ПропустившиеВызов.Ссылка.Duration КАК Длительность,
	ВЫБОР
		КОГДА ПропустившиеВызов.Ссылка.Src_Владелец_Ссылка &lt;&gt; НЕОПРЕДЕЛЕНО
			ТОГДА ПропустившиеВызов.Ссылка.Src_Владелец_Ссылка
		КОГДА ПропустившиеВызов.Ссылка.Src_Ссылка &lt;&gt; НЕОПРЕДЕЛЕНО
			ТОГДА ПропустившиеВызов.Ссылка.Src_Ссылка
		ИНАЧЕ НЕОПРЕДЕЛЕНО
	КОНЕЦ КАК Клиент,
	ПропустившиеВызов.Ссылка.Src КАК НомерТелефона
ПОМЕСТИТЬ ВТ
ИЗ
	Документ.МИКО_стЗаписьИсторииЗвонков.CDR_ПропустившиеЗвонок КАК ПропустившиеВызов
ГДЕ
	ПропустившиеВызов.Дата МЕЖДУ &amp;НачалоПериода И &amp;ОкончаниеПериода
	И ПропустившиеВызов.Ссылка.Направление = ЗНАЧЕНИЕ(Перечисление.МИКО_стВидыТелефонныхЗвонков.Входящий)
	И НЕ ПропустившиеВызов.Dst = "submodule"
	И (ПропустившиеВызов.Ссылка.Пропущенный = ИСТИНА
			ИЛИ ПропустившиеВызов.Ссылка.НетСоединений = ИСТИНА)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	МИКО_стЗаписьИсторииЗвонков.Дата,
	МИКО_стЗаписьИсторииЗвонков.Ссылка,
	ВЫБОР
		КОГДА МИКО_стЗаписьИсторииЗвонков.Dst_Ссылка = НЕОПРЕДЕЛЕНО
			ТОГДА МИКО_стЗаписьИсторииЗвонков.Dst
		ИНАЧЕ МИКО_стЗаписьИсторииЗвонков.Dst_Ссылка
	КОНЕЦ,
	МИКО_стЗаписьИсторииЗвонков.Duration,
	ВЫБОР
		КОГДА МИКО_стЗаписьИсторииЗвонков.Src_Владелец_Ссылка &lt;&gt; НЕОПРЕДЕЛЕНО
			ТОГДА МИКО_стЗаписьИсторииЗвонков.Src_Владелец_Ссылка
		КОГДА МИКО_стЗаписьИсторииЗвонков.Src_Ссылка &lt;&gt; НЕОПРЕДЕЛЕНО
			ТОГДА МИКО_стЗаписьИсторииЗвонков.Src_Ссылка
		ИНАЧЕ НЕОПРЕДЕЛЕНО
	КОНЕЦ,
	МИКО_стЗаписьИсторииЗвонков.Src
ИЗ
	Документ.МИКО_стЗаписьИсторииЗвонков КАК МИКО_стЗаписьИсторииЗвонков
ГДЕ
	(МИКО_стЗаписьИсторииЗвонков.НетСоединений
			ИЛИ МИКО_стЗаписьИсторииЗвонков.НетСоединений)
	И МИКО_стЗаписьИсторииЗвонков.Ссылка.Направление = ЗНАЧЕНИЕ(Перечисление.МИКО_стВидыТелефонныхЗвонков.Входящий)
	И МИКО_стЗаписьИсторииЗвонков.Дата МЕЖДУ &amp;НачалоПериода И &amp;ОкончаниеПериода
;

