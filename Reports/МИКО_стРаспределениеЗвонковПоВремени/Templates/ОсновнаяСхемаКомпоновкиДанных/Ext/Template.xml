		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	МИКО_стЗаписьИсторииЗвонков.Дата,
	МИКО_стЗаписьИсторииЗвонков.OutLine,
	МИКО_стЗаписьИсторииЗвонков.Duration,
	МИКО_стЗаписьИсторииЗвонков.Billsec,
	МИКО_стЗаписьИсторииЗвонков.Ссылка КАК Количество,
	ВЫБОР
		КОГДА ДЕНЬНЕДЕЛИ(МИКО_стЗаписьИсторииЗвонков.Дата) = 1
			ТОГДА "Понедельник"
		КОГДА ДЕНЬНЕДЕЛИ(МИКО_стЗаписьИсторииЗвонков.Дата) = 2
			ТОГДА "Вторник"
		КОГДА ДЕНЬНЕДЕЛИ(МИКО_стЗаписьИсторииЗвонков.Дата) = 3
			ТОГДА "Среда"
		КОГДА ДЕНЬНЕДЕЛИ(МИКО_стЗаписьИсторииЗвонков.Дата) = 4
			ТОГДА "Четверг"
		КОГДА ДЕНЬНЕДЕЛИ(МИКО_стЗаписьИсторииЗвонков.Дата) = 5
			ТОГДА "Пятница"
		КОГДА ДЕНЬНЕДЕЛИ(МИКО_стЗаписьИсторииЗвонков.Дата) = 6
			ТОГДА "Суббота"
		ИНАЧЕ "Воскресенье"
	КОНЕЦ КАК ДеньНедели,
	МИКО_стЗаписьИсторииЗвонков.Направление,
	ДЕНЬНЕДЕЛИ(МИКО_стЗаписьИсторииЗвонков.Дата) КАК НомерДня,
	МИКО_стЗаписьИсторииЗвонков.Duration КАК СредняяДлительность,
	МИКО_стЗаписьИсторииЗвонков.Ссылка КАК Детали,
	ВЫБОР
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 1
			ТОГДА "01:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 2
			ТОГДА "02:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 3
			ТОГДА "03:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 4
			ТОГДА "04:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 6
			ТОГДА "06:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 7
			ТОГДА "07:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 8
			ТОГДА "08:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 9
			ТОГДА "09:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 10
			ТОГДА "10:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 11
			ТОГДА "11:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 12
			ТОГДА "12:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 13
			ТОГДА "13:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 14
			ТОГДА "14:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 15
			ТОГДА "15:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 16
			ТОГДА "16:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 17
			ТОГДА "17:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 18
			ТОГДА "18:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 19
			ТОГДА "19:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 20
			ТОГДА "20:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 21
			ТОГДА "21:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 22
			ТОГДА "22:00"
		КОГДА ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) = 23
			ТОГДА "23:00"
		ИНАЧЕ "00:00"
	КОНЕЦ КАК Час,
	ЧАС(МИКО_стЗаписьИсторииЗвонков.Дата) КАК ЧасЧислом,
	ВЫБОР
		КОГДА МИКО_стЗаписьИсторииЗвонков.Billsec &lt; 60
			ТОГДА "до 1 минуты"
		КОГДА МИКО_стЗаписьИсторииЗвонков.Billsec &gt;= 60
				И МИКО_стЗаписьИсторииЗвонков.Billsec &lt; 180
			ТОГДА "от 1 до 3 мин."
		КОГДА МИКО_стЗаписьИсторииЗвонков.Billsec &gt;= 180
				И МИКО_стЗаписьИсторииЗвонков.Billsec &lt; 300
			ТОГДА "от 3 до 5 мин."
		КОГДА МИКО_стЗаписьИсторииЗвонков.Billsec &gt;= 300
				И МИКО_стЗаписьИсторииЗвонков.Billsec &lt; 540
			ТОГДА "от 5 до 9 мин."
		ИНАЧЕ "более 9 мин."
	КОНЕЦ КАК СегментДлительности,
	ВЫБОР
		КОГДА МИКО_стЗаписьИсторииЗвонков.Billsec &lt; 60
			ТОГДА 1
		КОГДА МИКО_стЗаписьИсторииЗвонков.Billsec &gt;= 60
				И МИКО_стЗаписьИсторииЗвонков.Billsec &lt; 180
			ТОГДА 3
		КОГДА МИКО_стЗаписьИсторииЗвонков.Billsec &gt;= 180
				И МИКО_стЗаписьИсторииЗвонков.Billsec &lt; 300
			ТОГДА 5
		КОГДА МИКО_стЗаписьИсторииЗвонков.Billsec &gt;= 300
				И МИКО_стЗаписьИсторииЗвонков.Billsec &lt; 540
			ТОГДА 9
		ИНАЧЕ 10
	КОНЕЦ КАК ИндексСегментаДлительности
ИЗ
	Документ.МИКО_стЗаписьИсторииЗвонков КАК МИКО_стЗаписьИсторииЗвонков
ГДЕ
	МИКО_стЗаписьИсторииЗвонков.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И НЕ МИКО_стЗаписьИсторииЗвонков.ЛожныйЗвонок</query>
	</dataSet>
