<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сумма</dataPath>
			<field>Сумма</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДокументОприходования</dataPath>
			<field>ДокументОприходования</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЗаказПокупателя</dataPath>
			<field>ЗаказПокупателя</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Подразделение</dataPath>
			<field>Подразделение</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Проект</dataPath>
			<field>Проект</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ХарактеристикаНоменклатуры</dataPath>
			<field>ХарактеристикаНоменклатуры</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Дата</dataPath>
			<field>Дата</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Заказ</dataPath>
			<field>Заказ</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоСписания</dataPath>
			<field>КоличествоСписания</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Себестоимость</dataPath>
			<field>Себестоимость</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтатусЗаказа</dataPath>
			<field>СтатусЗаказа</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтоимостьОтправки</dataPath>
			<field>СтоимостьОтправки</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоДляСравнения</dataPath>
			<field>КоличествоДляСравнения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КоличествоСписанияДляСравнения</dataPath>
			<field>КоличествоСписанияДляСравнения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СебестоимостьДляСравнения</dataPath>
			<field>СебестоимостьДляСравнения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СтоимостьОтправкиДляСравнения</dataPath>
			<field>СтоимостьОтправкиДляСравнения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаДляСравнения</dataPath>
			<field>СуммаДляСравнения</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказПокупателяТовары.Номенклатура,
	СУММА(ЗаказПокупателяТовары.Сумма) КАК Сумма,
	СУММА(ЗаказПокупателяТовары.СтоимостьОтправки) КАК СтоимостьОтправки,
	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
	ЗаказПокупателяТовары.Ссылка
ПОМЕСТИТЬ Заказы
ИЗ
	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
ГДЕ
	ЗаказПокупателяТовары.Ссылка.НеУчитыватьВОтчете = ЛОЖЬ
	И ЗаказПокупателяТовары.Ссылка.СтатусЗаказа.Наименование &lt;&gt; "Не удачные"
	И ЗаказПокупателяТовары.Ссылка.Дата &gt;= &amp;НачалоПериода
	И ЗаказПокупателяТовары.Ссылка.Дата &lt;= &amp;КонецПериода

СГРУППИРОВАТЬ ПО
	ЗаказПокупателяТовары.Номенклатура,
	ЗаказПокупателяТовары.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПродажиСебестоимостьОбороты.СтоимостьОборот * КурсыВалютСрезПоследних.Курс КАК Себестоимость,
	Заказы.Ссылка,
	Заказы.Номенклатура,
	ПродажиСебестоимостьОбороты.КоличествоОборот КАК КоличествоСписания
ПОМЕСТИТЬ Себестоимость
ИЗ
	РегистрНакопления.ПродажиСебестоимость.Обороты(&amp;НачалоПериода {(&amp;НачалоПериода)}, &amp;КонецПериода {(&amp;КонецПериода)}, , ) КАК ПродажиСебестоимостьОбороты
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Заказы КАК Заказы
		ПО ПродажиСебестоимостьОбороты.Номенклатура = Заказы.Номенклатура
			И ПродажиСебестоимостьОбороты.ЗаказПокупателя = Заказы.Ссылка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&amp;КонецПериода {(&amp;КонецПериода)}, ) КАК КурсыВалютСрезПоследних
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константы КАК Константы
			ПО КурсыВалютСрезПоследних.Валюта = Константы.ВалютаУправленческогоУчета
		ПО (ИСТИНА)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказПокупателяТовары.Номенклатура,
	СУММА(ЗаказПокупателяТовары.Сумма) КАК Сумма,
	СУММА(ЗаказПокупателяТовары.СтоимостьОтправки) КАК СтоимостьОтправки,
	СУММА(ЗаказПокупателяТовары.Количество) КАК Количество,
	ЗаказПокупателяТовары.Ссылка
ПОМЕСТИТЬ Заказы2
ИЗ
	Документ.ЗаказПокупателя.Товары КАК ЗаказПокупателяТовары
ГДЕ
	ЗаказПокупателяТовары.Ссылка.НеУчитыватьВОтчете = ЛОЖЬ
	И ЗаказПокупателяТовары.Ссылка.СтатусЗаказа.Наименование &lt;&gt; "Не удачные"
{ГДЕ
	(ЗаказПокупателяТовары.Ссылка.Дата &gt;= &amp;НачалоПериодаДляСравнения),
	(ЗаказПокупателяТовары.Ссылка.Дата &lt;= &amp;КонецПериодаДляСравнения)}

СГРУППИРОВАТЬ ПО
	ЗаказПокупателяТовары.Номенклатура,
	ЗаказПокупателяТовары.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПродажиСебестоимостьОбороты.СтоимостьОборот * КурсыВалютСрезПоследних.Курс КАК Себестоимость,
	Заказы.Ссылка,
	Заказы.Номенклатура,
	ПродажиСебестоимостьОбороты.КоличествоОборот КАК КоличествоСписания
ПОМЕСТИТЬ Себестоимость2
ИЗ
	РегистрНакопления.ПродажиСебестоимость.Обороты(&amp;НачалоПериодаДляСравнения {(&amp;НачалоПериодаДляСравнения)}, &amp;КонецПериодаДляСравнения {(&amp;КонецПериодаДляСравнения)}, , ) КАК ПродажиСебестоимостьОбороты
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Заказы2 КАК Заказы
		ПО ПродажиСебестоимостьОбороты.Номенклатура = Заказы.Номенклатура
			И ПродажиСебестоимостьОбороты.ЗаказПокупателя = Заказы.Ссылка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&amp;КонецПериодаДляСравнения {(&amp;КонецПериодаДляСравнения)}, ) КАК КурсыВалютСрезПоследних
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Константы КАК Константы
			ПО КурсыВалютСрезПоследних.Валюта = Константы.ВалютаУправленческогоУчета
		ПО (ИСТИНА)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Заказы.Номенклатура,
	Заказы.Сумма,
	Заказы.СтоимостьОтправки,
	Заказы.Количество,
	Себестоимость_.КоличествоСписания,
	ЕСТЬNULL(ВЫБОР
			КОГДА ЕСТЬNULL(Себестоимость_.Себестоимость, 0) = 0
				ТОГДА 0
			ИНАЧЕ ВЫБОР
					КОГДА ЕСТЬNULL(Себестоимость_.КоличествоСписания, 0) = 0
						ТОГДА Себестоимость_.Себестоимость
					ИНАЧЕ Себестоимость_.Себестоимость / Себестоимость_.КоличествоСписания * Заказы.Количество
				КОНЕЦ
		КОНЕЦ, 0) КАК Себестоимость,
	Заказы.Ссылка КАК Заказ,
	Заказы.Ссылка.Контрагент КАК Контрагент,
	НАЧАЛОПЕРИОДА(Заказы.Ссылка.Дата, ДЕНЬ) КАК Дата,
	Заказы.Ссылка.СтатусЗаказа КАК СтатусЗаказа,
	0 КАК СуммаДляСравнения,
	0 КАК СтоимостьОтправкиДляСравнения,
	0 КАК СебестоимостьДляСравнения,
	0 КАК КоличествоДляСравнения,
	0 КАК КоличествоСписанияДляСравнения
ИЗ
	Заказы КАК Заказы
		ЛЕВОЕ СОЕДИНЕНИЕ Себестоимость КАК Себестоимость_
		ПО Заказы.Номенклатура = Себестоимость_.Номенклатура
			И Заказы.Ссылка = Себестоимость_.Ссылка

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ПрочиеЗатратыЗатраты.СтатьяЗатрат,
	-СУММА(ПрочиеЗатратыЗатраты.Сумма),
	0,
	0,
	0,
	0,
	"Затраты",
	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	НАЧАЛОПЕРИОДА(ПрочиеЗатратыЗатраты.Ссылка.Дата, ДЕНЬ),
	ЗНАЧЕНИЕ(Справочник.СтатусыЗаказов.ПустаяСсылка),
	0,
	0,
	0,
	0,
	0
ИЗ
	Документ.ПрочиеЗатраты.Затраты КАК ПрочиеЗатратыЗатраты
ГДЕ
	ПрочиеЗатратыЗатраты.Ссылка.Проведен
	И ПрочиеЗатратыЗатраты.Ссылка.Дата &gt;= &amp;НачалоПериода
	И ПрочиеЗатратыЗатраты.Ссылка.Дата &lt;= &amp;КонецПериода

СГРУППИРОВАТЬ ПО
	ПрочиеЗатратыЗатраты.СтатьяЗатрат,
	НАЧАЛОПЕРИОДА(ПрочиеЗатратыЗатраты.Ссылка.Дата, ДЕНЬ)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Заказы.Номенклатура,
	0,
	0,
	0,
	0,
	0,
	Заказы.Ссылка,
	Заказы.Ссылка.Контрагент,
	НАЧАЛОПЕРИОДА(Заказы.Ссылка.Дата, ДЕНЬ),
	Заказы.Ссылка.СтатусЗаказа,
	Заказы.Сумма,
	Заказы.СтоимостьОтправки,
	ЕСТЬNULL(ВЫБОР
			КОГДА ЕСТЬNULL(Себестоимость_.Себестоимость, 0) = 0
				ТОГДА 0
			ИНАЧЕ ВЫБОР
					КОГДА ЕСТЬNULL(Себестоимость_.КоличествоСписания, 0) = 0
						ТОГДА Себестоимость_.Себестоимость
					ИНАЧЕ Себестоимость_.Себестоимость / Себестоимость_.КоличествоСписания * Заказы.Количество
				КОНЕЦ
		КОНЕЦ, 0),
	Заказы.Количество,
	Себестоимость_.КоличествоСписания
ИЗ
	Заказы2 КАК Заказы
		ЛЕВОЕ СОЕДИНЕНИЕ Себестоимость2 КАК Себестоимость_
		ПО Заказы.Номенклатура = Себестоимость_.Номенклатура
			И Заказы.Ссылка = Себестоимость_.Ссылка

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ПрочиеЗатратыЗатраты.СтатьяЗатрат,
	NULL,
	0,
	0,
	0,
	0,
	"Затраты",
	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	НАЧАЛОПЕРИОДА(ПрочиеЗатратыЗатраты.Ссылка.Дата, ДЕНЬ),
	ЗНАЧЕНИЕ(Справочник.СтатусыЗаказов.ПустаяСсылка),
	-СУММА(ПрочиеЗатратыЗатраты.Сумма),
	0,
	0,
	0,
	0
ИЗ
	Документ.ПрочиеЗатраты.Затраты КАК ПрочиеЗатратыЗатраты
ГДЕ
	ПрочиеЗатратыЗатраты.Ссылка.Проведен
	И ПрочиеЗатратыЗатраты.Ссылка.Дата &gt;= &amp;НачалоПериодаДляСравнения
	И ПрочиеЗатратыЗатраты.Ссылка.Дата &lt;= &amp;КонецПериодаДляСравнения

СГРУППИРОВАТЬ ПО
	ПрочиеЗатратыЗатраты.СтатьяЗатрат,
	НАЧАЛОПЕРИОДА(ПрочиеЗатратыЗатраты.Ссылка.Дата, ДЕНЬ)</query>
	</dataSet>
	<calculatedField>
		<dataPath>СебестоимостьЕдиницы</dataPath>
		<expression>ISNULL(ВЫБОР КОГДА ЕСТЬNULL(КоличествоСписания,0) = 0 ТОГДА 0 ИНАЧЕ Себестоимость / КоличествоСписания КОНЕЦ,0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Себестоимость единицы</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="xs:string">ЧДЦ=2</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>Прибыль</dataPath>
		<expression>ISNULL(ВЫБОР КОГДА ЕСТЬNULL(СЕБЕСТОимость,0) = 0 и НЕ Заказ = "Затраты" тогда 0 ИНАЧЕ ISNULL(Сумма,0) - ISNULL(СтоимостьОтправки,0) - ISNULL(Себестоимость,0)  конец,0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Прибыль</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ПрибыльДляСравнения</dataPath>
		<expression>ISNULL(ВЫБОР КОГДА ЕСТЬNULL(СЕБЕСТОимостьДляСравнения,0) = 0  и НЕ Заказ = "Затраты" тогда 0 ИНАЧЕ ISNULL(СуммаДляСравнения,0) -  ISNULL(СтоимостьОтправкиДляСравнения,0) - ISNULL(СебестоимостьДляСравнения,0)  конец,0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Прибыль для сравнения</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>СуммаРазница</dataPath>
		<expression>ЕСТЬNULL(Сумма,0) - ЕСТЬNULL(СуммаДляСравнения,0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сумма разница</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>КоличествоРазница</dataPath>
		<expression>ЕСТЬNULL(Количество,0) - ЕСТЬNULL(КоличествоДляСравнения,0)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Количество разница</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ПрибыльРазница</dataPath>
		<expression>ВЫБОР КОГДА ЕСТЬNULL(СЕБЕСТОимость,0) = 0  и НЕ Заказ = "Затраты" тогда 0 ИНАЧЕ ISNULL(Сумма,0) - ISNULL(СтоимостьОтправки,0) - ISNULL(Себестоимость,0)  конец - ВЫБОР КОГДА ЕСТЬNULL(СЕБЕСТОимостьДляСравнения,0) = 0  и НЕ Заказ = "Затраты" тогда 0 ИНАЧЕ ISNULL(СуммаДляСравнения,0) - ISNULL(СтоимостьОтправкиДляСравнения,0) - ISNULL(СебестоимостьДляСравнения,0)  конец</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Прибыль разница</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>СуммаРазницаПроцент</dataPath>
		<expression>ВЫБОР КОГДА ЕСТЬNULL(СуммаДляСравнения,0) = 0 ТОГДА 0 ИНАЧЕ (ЕСТЬNULL(Сумма,0) - ЕСТЬNULL(СуммаДляСравнения,0)) /ЕСТЬNULL(СуммаДляСравнения,0) * 100 КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Сумма разница, %</v8:content>
			</v8:item>
		</title>
		<appearance>
			<dcscor:item xsi:type="dcsset:SettingsParameterValue">
				<dcscor:parameter>Формат</dcscor:parameter>
				<dcscor:value xsi:type="xs:string">ЧДЦ=2</dcscor:value>
			</dcscor:item>
		</appearance>
	</calculatedField>
	<calculatedField>
		<dataPath>КоличествоРазницаПроцент</dataPath>
