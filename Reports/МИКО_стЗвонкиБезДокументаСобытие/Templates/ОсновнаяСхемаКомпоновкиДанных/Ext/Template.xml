		<query>ВЫБРАТЬ
	МИКО_стЗаписьИсторииЗвонков.Ссылка,
	МИКО_стЗаписьИсторииЗвонков.Дата,
	ВЫБОР
		КОГДА МИКО_стЗаписьИсторииЗвонков.Направление = ЗНАЧЕНИЕ(Перечисление.МИКО_стВидыТелефонныхЗвонков.Входящий)
			ТОГДА МИКО_стЗаписьИсторииЗвонков.Src
		ИНАЧЕ МИКО_стЗаписьИсторииЗвонков.Dst
	КОНЕЦ КАК НомерТелефона,
	МИКО_стЗаписьИсторииЗвонков.Направление,
	ВЫБОР
		КОГДА МИКО_стЗаписьИсторииЗвонков.Направление = ЗНАЧЕНИЕ(Перечисление.МИКО_стВидыТелефонныхЗвонков.Входящий)
			ТОГДА ВЫБОР
					КОГДА МИКО_стЗаписьИсторииЗвонков.Src_Владелец_Ссылка = НЕОПРЕДЕЛЕНО
						ТОГДА МИКО_стЗаписьИсторииЗвонков.Src_Ссылка
					ИНАЧЕ МИКО_стЗаписьИсторииЗвонков.Src_Владелец_Ссылка
				КОНЕЦ
		ИНАЧЕ ВЫБОР
				КОГДА МИКО_стЗаписьИсторииЗвонков.Dst_Владелец_Ссылка = НЕОПРЕДЕЛЕНО
					ТОГДА МИКО_стЗаписьИсторииЗвонков.Dst_Ссылка
				ИНАЧЕ МИКО_стЗаписьИсторииЗвонков.Dst_Владелец_Ссылка
			КОНЕЦ
	КОНЕЦ КАК Клиент
ПОМЕСТИТЬ ДокументыЗаПериод
ИЗ
	Документ.МИКО_стЗаписьИсторииЗвонков КАК МИКО_стЗаписьИсторииЗвонков
ГДЕ
	МИКО_стЗаписьИсторииЗвонков.Дата МЕЖДУ &amp;НачалоПериода И &amp;ОкончаниеПериода
	И МИКО_стЗаписьИсторииЗвонков.Направление &lt;&gt; ЗНАЧЕНИЕ(Перечисление.МИКО_стВидыТелефонныхЗвонков.Внутренний)
	И МИКО_стЗаписьИсторииЗвонков.НетСоединений = ЛОЖЬ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МИКО_стЗаписьИсторииЗвонковДокументыСобытие.Ссылка,
	МИКО_стЗаписьИсторииЗвонковДокументыСобытие.Событие
ПОМЕСТИТЬ СобытияПоЗвонку
ИЗ
	Документ.МИКО_стЗаписьИсторииЗвонков.ДокументыСобытие КАК МИКО_стЗаписьИсторииЗвонковДокументыСобытие
ГДЕ
	МИКО_стЗаписьИсторииЗвонковДокументыСобытие.Ссылка В
			(ВЫБРАТЬ
				ДокументыЗаПериод.Ссылка
			ИЗ
				ДокументыЗаПериод КАК ДокументыЗаПериод)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДокументыЗаПериод.Ссылка,
	ВЫБОР
		КОГДА СобытияПоЗвонку.Событие ЕСТЬ NULL 
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ЕстьСобытие
ПОМЕСТИТЬ ЗвонкиССобытием
ИЗ
	ДокументыЗаПериод КАК ДокументыЗаПериод
		ЛЕВОЕ СОЕДИНЕНИЕ СобытияПоЗвонку КАК СобытияПоЗвонку
		ПО ДокументыЗаПериод.Ссылка = СобытияПоЗвонку.Ссылка
ГДЕ
	ВЫБОР
			КОГДА СобытияПоЗвонку.Событие ЕСТЬ NULL 
				ТОГДА ИСТИНА
			ИНАЧЕ ЛОЖЬ
		КОНЕЦ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка,
	ДокументыЗаПериод.Направление,
	ВЫРАЗИТЬ(ДокументыЗаПериод.НомерТелефона КАК СТРОКА(32)) КАК НомерКлиента,
	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Длительность,
	ДокументыЗаПериод.Дата,
	"Расшифровка звонка" КАК ПредставлениеРасшифровка,
	ДокументыЗаПериод.Клиент,
	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Src_Ссылка,
	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Dst_Ссылка,
	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Cidnum,
	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Peer
ПОМЕСТИТЬ CEL_Таблица
ИЗ
	Документ.МИКО_стЗаписьИсторииЗвонков.ДетализацияCEL КАК МИКО_стЗаписьИсторииЗвонковДетализацияCEL
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДокументыЗаПериод КАК ДокументыЗаПериод
		ПО МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка = ДокументыЗаПериод.Ссылка
ГДЕ
	МИКО_стЗаписьИсторииЗвонковДетализацияCEL.Ссылка В
			(ВЫБРАТЬ
				ЗвонкиССобытием.Ссылка
			ИЗ
				ЗвонкиССобытием КАК ЗвонкиССобытием)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	CEL_Таблица.Ссылка,
	CEL_Таблица.Направление,
	CEL_Таблица.НомерКлиента,
	CEL_Таблица.Длительность,
	CEL_Таблица.Дата,
	CEL_Таблица.ПредставлениеРасшифровка,
	CEL_Таблица.Клиент,
	CEL_Таблица.Src_Ссылка КАК Сотрудник,
	CEL_Таблица.Cidnum КАК НомерСотрудника
ИЗ
	CEL_Таблица КАК CEL_Таблица
ГДЕ
	CEL_Таблица.Src_Ссылка ССЫЛКА Справочник.Пользователи

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	CEL_Таблица.Ссылка,
	CEL_Таблица.Направление,
	CEL_Таблица.НомерКлиента,
	CEL_Таблица.Длительность,
	CEL_Таблица.Дата,
	CEL_Таблица.ПредставлениеРасшифровка,
	CEL_Таблица.Клиент,
	CEL_Таблица.Dst_Ссылка,
	CEL_Таблица.Peer
ИЗ
	CEL_Таблица КАК CEL_Таблица
ГДЕ
	CEL_Таблица.Dst_Ссылка ССЫЛКА Справочник.Пользователи

СГРУППИРОВАТЬ ПО
	CEL_Таблица.Ссылка,
	CEL_Таблица.Peer,
	CEL_Таблица.НомерКлиента,
	CEL_Таблица.Дата,
	CEL_Таблица.ПредставлениеРасшифровка,
	CEL_Таблица.Клиент,
	CEL_Таблица.Направление,
	CEL_Таблица.Dst_Ссылка,
	CEL_Таблица.Длительность</query>
