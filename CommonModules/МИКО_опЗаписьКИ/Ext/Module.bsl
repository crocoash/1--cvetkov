///
// Коды городов

// Функция рабивает номер телефона на составляющие.
// Параметры: 
//   НомерТелефона - передается по значению, тип "строка", номер телефона.
// Возвращаемое значение:
//   Неопределено - если разложить номер не получилось.
//   тип Структура("КодСтраны,КодГорода,Страна,Область,Город,НомерБезПрефиксов,Номер").
Функция РазложитьНомерТелефона(Знач НомерТелефона) Экспорт
	СтруктураНомера = Новый Структура("КодСтраны,КодГорода,Страна,Область,Город,НомерБезПрефиксов,Номер,ТипНомера,UTC");	
	
	Если НЕ ЭтоЧисловойНомер(НомерТелефона) Тогда
		Если ВСловеТолькоЛатиница(НомерТелефона) Тогда
		 	СтруктураНомера.Вставить("ТипНомера","Skype");
			СтруктураНомера.Вставить("Номер", НомерТелефона);
			СтруктураНомера.Вставить("НомерБезПрефиксов",НомерТелефона);
			Возврат СтруктураНомера;	
		Иначе	
			// кирилица в номере / недопустимые символы
			Возврат Неопределено;	
		КонецЕсли; 
	КонецЕсли; 
	НомерТелефона = УбратьИзСтрокиТелефонаВсеБуквы(НомерТелефона);
	Если Лев(НомерТелефона, 1) = "8" Тогда
		НомерТелефона = "7"+Прав(НомерТелефона,СтрДлина(НомерТелефона) - 1);
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Если Лев(НомерТелефона, 2) = "38" Тогда
		// Украина
		Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		        |	МИКО_опКодыГородов.ШаблонПоиска,
		        |	МИКО_опКодыГородов.КодСтраны,
		        |	МИКО_опКодыГородов.КодГорода,
		        |	МИКО_опКодыГородов.Город,
		        |	МИКО_опКодыГородов.Область,
		        |	МИКО_опКодыГородов.Страна,
		        |	МИКО_опКодыГородов.НачалоДиапазона,
		        |	МИКО_опКодыГородов.КонецДиапазона,
		        |	МИКО_опКодыГородов.Приоритетный КАК Приоритетный,
		        |	МИКО_опКодыГородов.UTC
		        |ПОМЕСТИТЬ ВТ
		        |ИЗ
		        |	РегистрСведений.МИКО_опКодыГородов КАК МИКО_опКодыГородов
		        |ГДЕ
		        |	МИКО_опКодыГородов.Индекс = 1380
		        |;
		        |
		        |////////////////////////////////////////////////////////////////////////////////
		        |ВЫБРАТЬ
		        |	ВТ.ШаблонПоиска,
		        |	ВТ.КодСтраны,
		        |	ВТ.КодГорода,
		        |	ВТ.Город,
		        |	ВТ.Область,
		        |	ВТ.Страна,
		        |	ВТ.НачалоДиапазона,
		        |	ВТ.КонецДиапазона,
		        |	ВТ.Приоритетный
		        |ИЗ
		        |	ВТ КАК ВТ
		        |ГДЕ
		        |	&НомерТелефона ПОДОБНО ВТ.ШаблонПоиска
		        |
		        |УПОРЯДОЧИТЬ ПО
		        |	ВТ.Приоритетный УБЫВ";
		Запрос.УстановитьПараметр("НомерТелефона", НомерТелефона);
	ИначеЕсли Лев(НомерТелефона, 1) = "7" Тогда	
		Индекс 		= Число(Лев(Формат(ПреобразоватьНомерДляСохранения(НомерТелефона, 32),"ЧГ="),9));
		НомерЧислом = Число(Формат(ПреобразоватьНомерДляСохранения(НомерТелефона, 32),"ЧГ="));
		// Россия
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		        |	МИКО_опКодыГородов.Индекс,
		        |	МИКО_опКодыГородов.НачалоДиапазона,
		        |	МИКО_опКодыГородов.КонецДиапазона,
		        |	МИКО_опКодыГородов.ШаблонПоиска,
		        |	МИКО_опКодыГородов.КодСтраны,
		        |	МИКО_опКодыГородов.Город,
		        |	МИКО_опКодыГородов.Область,
		        |	МИКО_опКодыГородов.Страна,
		        |	МИКО_опКодыГородов.Приоритетный,
		        |	МИКО_опКодыГородов.КодГорода,
		        |	МИКО_опКодыГородов.UTC
		        |ПОМЕСТИТЬ ПользовательскиеКоды
		        |ИЗ
		        |	РегистрСведений.МИКО_опКодыГородов КАК МИКО_опКодыГородов
		        |ГДЕ
		        |	МИКО_опКодыГородов.Приоритетный = &Приоритетный
		        |	И МИКО_опКодыГородов.НачалоДиапазона <= &НомерЧислом
		        |	И МИКО_опКодыГородов.КонецДиапазона >= &НомерЧислом
		        |;
		        |
		        |////////////////////////////////////////////////////////////////////////////////
		        |ВЫБРАТЬ
		        |	ПользовательскиеКоды.Индекс,
		        |	ПользовательскиеКоды.НачалоДиапазона,
		        |	ПользовательскиеКоды.КонецДиапазона,
		        |	ПользовательскиеКоды.ШаблонПоиска,
		        |	ПользовательскиеКоды.КодСтраны,
		        |	ПользовательскиеКоды.Город,
		        |	ПользовательскиеКоды.Область,
		        |	ПользовательскиеКоды.Страна,
		        |	ПользовательскиеКоды.Приоритетный,
		        |	ПользовательскиеКоды.КодГорода,
		        |	ПользовательскиеКоды.UTC
		        |ПОМЕСТИТЬ НайденныеПользовательскиеРегионы
		        |ИЗ
		        |	ПользовательскиеКоды КАК ПользовательскиеКоды
		        |ГДЕ
		        |	ПользовательскиеКоды.НачалоДиапазона <= &НомерЧислом
		        |	И ПользовательскиеКоды.КонецДиапазона >= &НомерЧислом
		        |;
		        |
		        |////////////////////////////////////////////////////////////////////////////////
		        |ВЫБРАТЬ ПЕРВЫЕ 5
		        |	МИКО_опКодыГородов.КодГорода,
		        |	МИКО_опКодыГородов.КодСтраны,
		        |	МИКО_опКодыГородов.Город,
		        |	МИКО_опКодыГородов.Область,
		        |	МИКО_опКодыГородов.Страна,
		        |	МИКО_опКодыГородов.UTC,
		        |	МИКО_опКодыГородов.Приоритетный КАК Приоритетный
		        |ИЗ
		        |	РегистрСведений.МИКО_опКодыГородов КАК МИКО_опКодыГородов
		        |ГДЕ
		        |	МИКО_опКодыГородов.Индекс = &Индекс
		        |
		        |ОБЪЕДИНИТЬ ВСЕ
		        |
		        |ВЫБРАТЬ
		        |	НайленныеПользовательскиеРегионы.КодГорода,
		        |	НайленныеПользовательскиеРегионы.КодСтраны,
		        |	НайленныеПользовательскиеРегионы.Город,
		        |	НайленныеПользовательскиеРегионы.Область,
		        |	НайленныеПользовательскиеРегионы.Страна,
		        |	НайленныеПользовательскиеРегионы.UTC,
		        |	НайленныеПользовательскиеРегионы.Приоритетный
		        |ИЗ
		        |	НайденныеПользовательскиеРегионы КАК НайленныеПользовательскиеРегионы
		        |
		        |УПОРЯДОЧИТЬ ПО
		        |	Приоритетный УБЫВ";
		Запрос.УстановитьПараметр("Индекс", 	  Индекс);			
		Запрос.УстановитьПараметр("НомерЧислом",  НомерЧислом);			
		Запрос.УстановитьПараметр("Приоритетный", 100);			
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Запрос.Текст = Текст;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли; 
	Выборка = РезультатЗапроса.Выбрать(); Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(СтруктураНомера, Выборка);
	
	Номер = Прав(НомерТелефона, СтрДлина(НомерТелефона) - СтрДлина(""+Выборка.КодСтраны + Выборка.КодГорода));
	СтруктураНомера.Вставить("Номер", Номер);
	СтруктураНомера.Вставить("НомерБезПрефиксов",""+Выборка.КодСтраны + Выборка.КодГорода + Номер);
	СтруктураНомера.Вставить("ТипНомера","Телефон");
	
	Возврат СтруктураНомера;
КонецФункции // РазложитьНомерТелефона()

// Заполнение регистра сведений "МИКО_опКодыГородов", кодов городов для разбора номера.
//
Процедура ЗагрузитьКодыГородов(НомерПопытки=0, КодыУкраиныЗаписаны=Истина, TimeZones=Неопределено) Экспорт
	
	Если TimeZones=Неопределено Тогда
		МакетКоды 	= ПолучитьОбщийМакет("МИКО_опКодыГородов");     
		врTimeZones = МакетКоды.ПолучитьОбласть("TimeZones");                 
		TimeZones = Новый Соответствие;
		Для KК = 1 По врTimeZones.ВысотаТаблицы Цикл
			Регион	= СокрЛП(врTimeZones.Область(KК, 1).Текст);
			UTC		= Число(СокрЛП(врTimeZones.Область(KК, 2).Текст));
			TimeZones.Вставить(Регион, UTC);
		КонецЦикла;
	КонецЕсли; 
	Если КодыУкраиныЗаписаны=Ложь Тогда
		Если МакетКоды = Неопределено Тогда
			МакетКоды = ПолучитьОбщийМакет("МИКО_опКодыГородов");     
		КонецЕсли; 
		// Коды городов Украины.
		ОбластьКодыГородов  = МакетКоды.ПолучитьОбласть("Коды_380");
		Для КК = 1 По ОбластьКодыГородов.ВысотаТаблицы Цикл
			СтрТЧ = РегистрыСведений.МИКО_опКодыГородов.СоздатьМенеджерЗаписи();
			
			СтрТЧ.Индекс	= 1380;
			СтрТЧ.Город		= ОбластьКодыГородов.Область(КК, 1).Текст;
			СтрТЧ.Область	= ОбластьКодыГородов.Область(КК, 2).Текст;
			СтрТЧ.Страна	= "Украина";
			СтрТЧ.КодСтраны	= "380";
			СтрТЧ.КодГорода	= ОбластьКодыГородов.Область(КК, 3).Текст;
			СтрТЧ.ШаблонПоиска	= СтрТЧ.КодСтраны + СтрТЧ.КодГорода + "%"; 
			Если СтрТЧ.ШаблонПоиска = "%" Тогда
			  	Продолжить;
			КонецЕсли;
			СтрТЧ.UTC 		   = 3;
			СтрТЧ.Приоритетный = 38;
			СтрТЧ.Записать();	
		КонецЦикла;
		КодыУкраиныЗаписаны = Истина;
	КонецЕсли; 
	
	КодыГородов   = ПолучитьОбщийМакет("МИКО_опКодыГородовРоссии").ПолучитьОбласть("КодыНомеров");
	// Попробуем ограничить число записей в регистр сведений.
	ПозицияЗагрузкиКодовГородов = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПозицияЗагрузкиКодовГородов();
	
	НачатьТранзакцию();
	ЧислоСтрокВТранзакции = 0;
	
	КэшИндексов = Новый Соответствие;
	// Тут используются диапазоны 
	// попробуем их преобразовать в шаблоны поиска.
	KК = ПозицияЗагрузкиКодовГородов;
	МаксОпераций = 50000;
	Пока KК < КодыГородов.ВысотаТаблицы Цикл
		
		KК = KК + 1;
		МаксОпераций = МаксОпераций - 1;
		КодГорода 	= СокрЛП(КодыГородов.Область(KК, 1).Текст);
		
		врДанные = Новый Структура;
		врДанные.Вставить("Страна", 	 "РФ");
		врДанные.Вставить("КодСтраны",   "7");
		врДанные.Вставить("Область", 	 СокрЛП(КодыГородов.Область(KК, 6).Текст));
		врДанные.Вставить("ШаблонПоиска","7");
		врДанные.Вставить("КодГорода", 	 КодГорода);
		врДанные.Вставить("Приоритетный",7);
		
		Для каждого текZone Из TimeZones Цикл
		 	Если Найти(врДанные.Область, текZone.Ключ)>0 Тогда
				врДанные.Вставить("UTC", текZone.Значение);
				Прервать;
			КонецЕсли; 
		КонецЦикла; 
		
		сч = ПреобразоватьНомерДляСохранения("7"+КодГорода + ДополнитьЛидирующиеНули(КодыГородов, KК, 2), 32);
		КонецДиапазона  = ПреобразоватьНомерДляСохранения("7"+КодГорода + ДополнитьЛидирующиеНули(КодыГородов, KК, 3), 32);
		
		Емкость = Число(СокрЛП(КодыГородов.Область(KК, 4).Текст));
		текИндекс = ""; ШагИндекса = 1000;
		Пока сч <= КонецДиапазона Цикл
			Индекс		 = Число(Лев(Формат(сч,"ЧГ="),9));
			
			// Приоритет за большей емкостью.
			врЕмкостьКэш = КэшИндексов.Получить(Индекс);
			Если врЕмкостьКэш <> Неопределено
				 И врЕмкостьКэш > Емкость Тогда
				сч = сч + ШагИндекса; 
				Продолжить;	
			КонецЕсли; 
			
			Если Индекс <> текИндекс Тогда
				СтрТЧ = РегистрыСведений.МИКО_опКодыГородов.СоздатьМенеджерЗаписи();
				СтрТЧ.Индекс = Индекс;
				ЗаполнитьЗначенияСвойств(СтрТЧ, врДанные);
				Попытка
					СтрТЧ.Записать();
					ЧислоСтрокВТранзакции = ЧислоСтрокВТранзакции + 1;
				Исключение
					Продолжить;
				КонецПопытки; 
				КэшИндексов.Вставить(Индекс, Емкость);
				текИндекс = Индекс;
				
				Если ЧислоСтрокВТранзакции > 3000 Тогда
					ЗафиксироватьТранзакцию();
					ЧислоСтрокВТранзакции = 1;
					НачатьТранзакцию();
				КонецЕсли; 
			КонецЕсли; 
			сч = сч + ШагИндекса;
		КонецЦикла;	
		
		Если МаксОпераций < 0 Тогда
		 	Прервать;		
		КонецЕсли; 
	КонецЦикла;
	Если ЧислоСтрокВТранзакции > 0 Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли; 
	
	KК = ?(KК >= КодыГородов.ВысотаТаблицы,0,KК);
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПозицияЗагрузкиКодовГородов(KК);
	
КонецПроцедуры

// В зависимости от длинны строки добавляет необходимо число лидирующих нулей.
// 
Функция ДополнитьЛидирующиеНули(КодыГородов, КK, NN)
   	Значение = СокрЛП(КодыГородов.Область(КK, NN).Текст);
	
	длСтроки = СтрДлина(Значение);
	Если длСтроки = 7 Тогда
	ИначеЕсли длСтроки = 6 Тогда	
		Значение = "0"+Значение;	
	ИначеЕсли длСтроки = 5 Тогда	
		Значение = "00"+Значение;		
	ИначеЕсли длСтроки = 4 Тогда	
		Значение = "000"+Значение;			
	ИначеЕсли длСтроки = 3 Тогда	
		Значение = "0000"+Значение;				
	ИначеЕсли длСтроки = 2 Тогда	
		Значение = "00000"+Значение;					
	ИначеЕсли длСтроки = 1 Тогда	
		Значение = "000000"+Значение;
	ИначеЕсли длСтроки = 0 ИЛИ длСтроки>7 Тогда
		Значение = "0000000"+Значение;
	КонецЕсли; 	
	Возврат Значение;
КонецФункции // ДополнитьЛидирующиеНули()

///
// Функции работы со строками.
/// 

// Оставляет в номере телефона только цифры, все остальные символы удаляются.
//
Функция УбратьИзСтрокиТелефонаВсеБуквы(Знач НомерТелефона) Экспорт
	ТолькоЦифрыНомера = "";
	Для а=1 По СтрДлина(НомерТелефона) Цикл
		Если СтрЧислоВхождений("1234567890",Сред(НомерТелефона,а,1)) > 0 Тогда
			ТолькоЦифрыНомера = ТолькоЦифрыНомера + Сред(НомерТелефона,а,1);
		КонецЕсли;
	КонецЦикла;
	Возврат ТолькоЦифрыНомера;
КонецФункции

// Функцией производится попытка преобразовать строку в дату.
// 
Функция ПреобразоватьВДату(Знач парамДата) Экспорт
	Если ТипЗнч(парамДата) = Тип("Дата") Тогда
		Возврат парамДата;
	КонецЕсли; 
	НачалоВремен 	= Дата("19700101");
	ПустаяДата 		= Дата("00010101");
	
	Если Найти(""+парамДата, ".")>0 И Найти(""+парамДата, "-")>0 Тогда
		// Это обычная дата с точностью до милисекунд.
		парамДата = Лев(парамДата, Найти(""+парамДата, ".")-1);	
	КонецЕсли;
	
	Если Найти(""+парамДата, ".")>0 Тогда
		// Формат даты UNIX
		Если ТипЗнч(парамДата) = Тип("Строка") Тогда
			Попытка
			  	парамДата = Число(парамДата);
			Исключение
				Возврат ПустаяДата;
			КонецПопытки; 
		ИначеЕсли ТипЗнч(парамДата) = Тип("Число") Тогда
			// тут все ок	
		Иначе
			Возврат ПустаяДата;
		КонецЕсли; 
		Если (ПустаяДата + парамДата) < НачалоВремен Тогда
			парамДата = НачалоВремен + парамДата;	
		КонецЕсли;
	Иначе	
		Если НЕ ЗначениеЗаполнено(парамДата) Тогда
			Возврат ПустаяДата;
		КонецЕсли; 
		Попытка
			парамДата = Дата(МИКО_опЗаписьКИ.УбратьИзСтрокиТелефонаВсеБуквы(парамДата));
		Исключение
			Возврат ПустаяДата;
		КонецПопытки; 	
	КонецЕсли; 
	
	Возврат парамДата;
КонецФункции // ПреобразоватьВДату()


// Функция сначала убирает из номера телефона все не относящееся к цифрам, а
// затем обрезает значащее количество цифр справа телефонного номера,
// количество этих цифр задается в константе КоличествоХранимыхЦифрТелефона
// возвращает число.
Функция ПреобразоватьНомерДляСохранения(Знач НомерТелефона, ЧислоСимволов = 9) Экспорт
	Префикс = "1";
	НомерТелефона = УбратьИзСтрокиТелефонаВсеБуквы(НомерТелефона);
	Возврат ?(НЕ ЗначениеЗаполнено(НомерТелефона), 0, Число(Префикс + Прав(СокрЛП(НомерТелефона), ЧислоСимволов)));
КонецФункции

// Функция убирает из номера телефона все префиксы, например, 999-99*99, будет 9999999. 
// 
Функция УбратьИзНомераТелефонаВсеПрефиксы(Знач НомерТелефона, Знач СтрокаПрефиксов=" /*-+=_.\,!;%:?()") Экспорт
	Для НомерПрефикс = 1 По СтрДлина(СтрокаПрефиксов) Цикл
		ТекущийПрефикс = Сред(СтрокаПрефиксов, НомерПрефикс, 1);
		НомерТелефона = СтрЗаменить(НомерТелефона, ТекущийПрефикс, "");
	КонецЦикла;
	Возврат НомерТелефона;
КонецФункции
 
// Проверка номера телефона на наличие букв.
// Параметры:
//   НомерТелефона - тип строка, номер телефона для анализа.
// Возвращаемое значение:
//   булево.
Функция ЭтоЧисловойНомер(Знач НомерТелефона) Экспорт
	НомерБезПрефиксов = УбратьИзНомераТелефонаВсеПрефиксы(НомерТелефона);
	НомерБезБукв 	  = УбратьИзСтрокиТелефонаВсеБуквы(НомерБезПрефиксов);
	Возврат (СтрДлина(НомерБезПрефиксов)=СтрДлина(НомерБезБукв));			
КонецФункции // ЭтоНеЧисловойНомер()

// Проверка на латинские символы
// 
Функция ВСловеТолькоЛатиница(знач Слово) Экспорт
	НовоеСлово= "";
	спТранслит = Новый ("Соответствие");
	
	спТранслит.Вставить("i","i"); 
	спТранслит.Вставить("q","q");
	спТранслит.Вставить("w","w");
	спТранслит.Вставить("e","e");
	спТранслит.Вставить("r","r");
	спТранслит.Вставить("t","t");
	спТранслит.Вставить("y","y");
	спТранслит.Вставить("u","u");
	спТранслит.Вставить("i","i");
	спТранслит.Вставить("o","o");
	спТранслит.Вставить("p","p");
	спТранслит.Вставить("a","a");
	спТранслит.Вставить("s","s");
	спТранслит.Вставить("d","d");
