// Ищем номер телефона из второго плеча Local канала.
// 
Функция ОпределитьНомерТелефонаLocal(Знач Канал, таб_CEL, Уровень=0) Экспорт
    Уровень = Уровень + 1;
	Если Уровень>20 Тогда
     	Возврат "";
	КонецЕсли; 
	LocalКанал = ОтсечьПлечоВLocal(Канал, Ложь);	
	ИмяПлеча = ?(Найти(Канал, ";2")>0, ";1", ";2");
	КаналДляПоиска = ""+LocalКанал+ИмяПлеча;
	
	Для каждого ТекущаяСтрока Из таб_CEL Цикл
		Если ВРег(ТекущаяСтрока.appname) = "APPDIAL" Тогда
		  	Продолжить;
		КонецЕсли; 
		Если ТекущаяСтрока.channame = КаналДляПоиска Тогда
			Если Найти(ВРег(ТекущаяСтрока.peer),"LOCAL")>0 Тогда
				Канал = ТекущаяСтрока.peer;
				Возврат ОпределитьНомерТелефонаLocal(Канал, таб_CEL, Уровень);
			КонецЕсли; 
			
			Если (ВРег(ТекущаяСтрока.appname) = "DIAL" ИЛИ ВРег(ТекущаяСтрока.appname) = "APPDIAL")
				 И СтрЧислоВхождений(ТекущаяСтрока.appdata, "&")=0 Тогда
				// Исключаем звонки на группу вызовов.
				// Пример SIP/104&SIP/105.                 
				// Тут нам интересен пир, ответивший на вызов.                                   
				Peer		= ПолучитьНомерВызываемогоАбонентаИзАтрибутаDialstring(ТекущаяСтрока.appdata);
			Иначе
				Peer		= ПолучитьНомерВызываемогоАбонентаИзАтрибутаDialstring(ТекущаяСтрока.peer);
			КонецЕсли;	
			Возврат Peer;
		КонецЕсли; 
		
		Если ТекущаяСтрока.peer = КаналДляПоиска Тогда
			Если Найти(ВРег(ТекущаяСтрока.channame),"LOCAL")>0 Тогда
				Канал = ТекущаяСтрока.channame;
				Возврат ОпределитьНомерТелефонаLocal(Канал, таб_CEL, Уровень);
			КонецЕсли; 
			Возврат ТекущаяСтрока.cidnum;
		КонецЕсли; 
	КонецЦикла;                      
	
	Возврат ОпределитьНомерТелефонаLocal(Канал, таб_CEL, Уровень);
КонецФункции // ОпределитьНомерТелефонаLocal()

// Из строки вида XXXXXXXXXX@Context или Provider/XXXXXXXXXX или Provider/SIP_namber/XXXXXXXXXX, выделяет номер.
// Параметры: 
//   СтрокаНабораНомера - тип значения "строка" передается по значению, строка: содержащая номер телефона.
// Возвращаемое значение:
//   НомерТелефона - тип значения "строка".
Функция ПолучитьНомерВызываемогоАбонентаИзАтрибутаDialstring(Знач СтрокаНабораНомера) Экспорт
	Если Найти(ВРЕГ(СтрокаНабораНомера),"LOCAL")>0 Тогда
		СтрокаНабораНомера = СтрЗаменить(СтрокаНабораНомера,"/n", "");	
	КонецЕсли; 
		
	// Получим позицию начала номера.
	НачалоНомера = ПолучитьПозициюДальнегоСимвола(СтрокаНабораНомера,"/") + 1; // Если > 0 то начало номера найдено.
	// Учтем формат DIAL.
	Если СтрЧислоВхождений(СтрокаНабораНомера,"@")=1 Тогда
		СимволыПоиска = "@";
	ИначеЕсли СтрЧислоВхождений(СтрокаНабораНомера,"/")=2 Тогда	
	 	СимволыПоиска = ",";
	Иначе
		СимволыПоиска = "-,";
	КонецЕсли;
	// Получим позицию конца номера.
	ДлинаНомера  = ПолучитьПозициюБлижнегоСимвола(СтрокаНабораНомера, СимволыПоиска) - ?(НачалоНомера>0,НачалоНомера,1); // если > 0 то конец номера найден.
	// НачалоНомера - если < 0, то Сред воспринимает параметр как "НачалоСтроки"). 
	// ДлинаНомера  - Если < 0, то Сред воспринимает параметр как "ДоКонцаСтроки". 
	НомерТелефона = Сред(СтрокаНабораНомера, НачалоНомера, ?(ДлинаНомера=0,-1,ДлинаНомера));
	НомерТелефона = СтрЗаменить(НомерТелефона, "sip:","");
	Возврат НомерТелефона;
КонецФункции

// Отсекает плече в канале.
// Local/04@internal-caller-transfer-000001f0;2.
// Local/04@internal-caller-transfer-000001f0.
Функция ОтсечьПлечоВLocal(Знач Канал, Врег=Истина) Экспорт
	Канал = СтрЗаменить(Канал,"<ZOMBIE>", "");
	
	ПозицияТочки = Найти(Канал, ";");
	Если ПозицияТочки > 0 Тогда
		Канал = Лев(Канал, ПозицияТочки - 1);
	КонецЕсли; 
	
	Если Врег=Истина Тогда
	    Возврат Врег(Канал);
	Иначе		
	    Возврат Канал;
	КонецЕсли; 
КонецФункции // ОтсечьПлечоВLocal()

// Из строки вида SIP/XXXXXXXXXX-ZZZ или IAX/XXXXXXXXXX или DAHDI/XXXXXXXXXX/ZZZ, выделяет номер.
// Параметры: 
//   СтрокаНабораНомера - тип значения "строка" передается по значению, строка: содержащая номер телефона.
// Возвращаемое значение:
//   XXXXXXXXXX - тип значения "строка".
Функция ПолучитьИмяУчеткиИзКанала(Знач СтрокаНабораНомера) Экспорт
	Если Найти(ВРЕГ(СтрокаНабораНомера),"LOCAL")>0 Тогда
		СтрокаНабораНомера = СтрЗаменить(СтрокаНабораНомера,"/n", "");	
	КонецЕсли; 
	Если СтрЧислоВхождений(СтрокаНабораНомера,"/")=2 Тогда	
	 	СимволыПоиска = "/";
	Иначе
		СимволыПоиска = "-";
	КонецЕсли;
	
	// Получим позицию начала номера.
	НачалоНомера = ПолучитьПозициюБлижнегоСимвола(СтрокаНабораНомера, "/") + 1; // Если > 0 то начало номера найдено.
	// Получим позицию конца номера.
	КонецНомера = ПолучитьПозициюДальнегоСимвола(СтрокаНабораНомера, СимволыПоиска);
	Если НачалоНомера = КонецНомера Тогда
		Возврат "";
	КонецЕсли; 
	
	ДлинаНомера = КонецНомера - ?(НачалоНомера>0,НачалоНомера,1); // Если > 0 то конец номера найден.
	// НачалоНомера - если < 0, то Сред воспринимает параметр как "НачалоСтроки"). 
	// ДлинаНомера  - Если < 0, то Сред воспринимает параметр как "ДоКонцаСтроки". 
	НомерТелефона = Сред(СтрокаНабораНомера, НачалоНомера, ?(ДлинаНомера=0,-1,ДлинаНомера));
	
	Возврат НомерТелефона;
КонецФункции

// Получаем номер позиции символа в строке, первое вхождение.
// Параметры:
//   ИсхСтрока - тип значения "строка", передается по значению. Строка: в которой необходимо произвести поиск.
//   СтрокаСимволов - тип значения "строка", должна содержать набор символов: которые ищем.
// Возвращаемое значение:
//   тип значения "число" - минимальный порядковый номер символа, 0 - если ни один из символов не найден.
//
Функция ПолучитьПозициюБлижнегоСимвола(Знач ИсхСтрока, СтрокаСимволов) Экспорт
	Позиция = 0;

	Для а=1 По СтрДлина(СтрокаСимволов) Цикл
		ТекПоз = Найти(ИсхСтрока,Сред(СтрокаСимволов,а,1));
		// не учитываем нулевые позиции
		Если ТекПоз = 0 Тогда Продолжить; КонецЕсли;
		Позиция = ?( Позиция = 0,ТекПоз,МИН(Позиция, ТекПоз) );		
	КонецЦикла;
	Возврат Позиция;
КонецФункции

// Получаем номер позиции символа в строке, последнее вхождение.
// Параметры:
//   ИсхСтрока - тип значения "строка", передается по значению. Строка: в которой необходимо произвести поиск.
//   СтрокаСимволов - тип значения "строка", должна содержать набор символов: которые ищем.
// Возвращаемое значение:
//   тип значения "число" - масимальный порядковый номер символа, 0 - если ни один из символов не найден.
//
Функция ПолучитьПозициюДальнегоСимвола(Знач ИсхСтрока, СтрокаСимволов) Экспорт
	
	ДлинаСтроки = СтрДлина(ИсхСтрока);
	Для к=0 по ДлинаСтроки Цикл 
		НомерСимвола = ДлинаСтроки-к; 
		Символ = Сред(ИсхСтрока,НомерСимвола,1);
		
		Если Найти(СтрокаСимволов,Символ)>0 Тогда 
			Возврат НомерСимвола; 
		КонецЕсли; 
	КонецЦикла;	

	Возврат -1;	
КонецФункции // ПолучитьПозициюДальнегоСимвола()

