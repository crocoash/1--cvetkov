// #Область СлужебныеПроцедурыИФункции

// Наполнение телефонной книги регистров "МИКО_опИндексНомераТелефонов" и "МИКО_опИндексНомераТелефоновБуквенные".
// 
Процедура СправочникСКонтактамиПриЗаписи(Источник, Отказ) Экспорт
	
Если Отказ Тогда Возврат; КонецЕсли; 
	// 1. Определим тип номера 
	Буквенные = Новый Соответствие;
	Числовые  = Новый Соответствие;

    ДополнитьИндексыНомеров_ТЧ_КИ(Числовые, Буквенные, Источник);
	ДополнитьИндексыНомеров_РС_КИ(Числовые, Буквенные, Источник);
	ЗполнитьИндексыНомеров(Числовые, Буквенные, Источник);
	
КонецПроцедуры

Процедура РегСведенийКИПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	Если Отказ Тогда Возврат; КонецЕсли; 
	// 1. Определим тип номера 
	Буквенные = Новый Соответствие;
	Числовые  = Новый Соответствие;
	
	ОбъектКИ = Источник.Отбор.Объект.Значение;
	
    ДополнитьИндексыНомеров_ТЧ_КИ(Числовые, Буквенные, ОбъектКИ);
	ДополнитьИндексыНомеров_РС_КИ(Числовые, Буквенные, ОбъектКИ);
	ЗполнитьИндексыНомеров(Числовые, Буквенные, ОбъектКИ); 

КонецПроцедуры

Процедура ДополнитьИндексыНомеров_ТЧ_КИ(Числовые, Буквенные, Источник) Экспорт

	Если НЕ ЗначениеЗаполнено(Источник) Тогда 
		Возврат; 
	КонецЕсли; 

	Если Источник.Метаданные().ТабличныеЧасти.Найти("КонтактнаяИнформация") = Неопределено Тогда 
		Возврат; 
	КонецЕсли;		
	КоличествоХранимыхЦифрТелефона = МИКО_стОбщегоНазначенияСерверПовторный.КоличествоХранимыхЦифрТелефона();
	
	Для каждого Контакт Из Источник.КонтактнаяИнформация Цикл
		Если Контакт.Тип <> Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Продолжить;	
		КонецЕсли;
		
		РедактируемаяИнформация = КонтактнаяИнформацияИзXML(Контакт.ЗначенияПолей, Контакт.Представление);
		Если РедактируемаяИнформация = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		Представление = РедактируемаяИнформация.Представление;
		Телефон 	  = РедактируемаяИнформация.Состав;
		НомерТелефона = "" + Телефон.КодСтраны + Телефон.КодГорода + Телефон.Номер;
		// Наполним массивы номеров для обновления информации в истории звонков.
		Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
			НомерТелефона = УбратьИзНомераТелефонаВсеПрефиксы(Представление, """' /*+=\,!;%:?()");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
			Продолжить;
		КонецЕсли; 

		Если ЭтоЧисловойНомер(НомерТелефона) Тогда
			НомерТелефона 		= Прав(УбратьИзНомераТелефонаВсеПрефиксы(НомерТелефона), КоличествоХранимыхЦифрТелефона);
			НомерТелефонаЧислом = ПреобразоватьНомерДляСохранения(НомерТелефона, 		 КоличествоХранимыхЦифрТелефона);
			
			Если ЗначениеЗаполнено(НомерТелефона) Тогда
				Числовые.Вставить(НомерТелефонаЧислом, НомерТелефона);
			КонецЕсли; 
		ИначеЕсли ВСловеТолькоЛатиница(НомерТелефона) Тогда
			// Это "Скайп".
			Буквенные.Вставить(НомерТелефона);
		Иначе
			Продолжить;
		КонецЕсли; 	

	КонецЦикла; // Обход контактной информации.

КонецПроцедуры
Процедура ДополнитьИндексыНомеров_РС_КИ(Числовые, Буквенные, Источник) Экспорт

	Если Метаданные.РегистрыСведений.Найти("КонтактнаяИнформация") = Неопределено Тогда
		Возврат;	
	КонецЕсли; 

	врКонтактнаяИнформация = Вычислить("РегистрыСведений.КонтактнаяИнформация");
	Попытка
		НаборЗаписей = врКонтактнаяИнформация.СоздатьНаборЗаписей();
	Исключение
		Возврат;
	КонецПопытки; 
	КоличествоХранимыхЦифрТелефона = МИКО_стОбщегоНазначенияСерверПовторный.КоличествоХранимыхЦифрТелефона();
	
	НаборЗаписей.Отбор.Объект.Установить(Источник);
	НаборЗаписей.Прочитать();
	
	ОбъектКИ = Источник;
	
	Для каждого ЗаписьКонтакт Из НаборЗаписей Цикл
		
		Если ЗаписьКонтакт.Тип <> Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Продолжить;	
		КонецЕсли;
		
		ПредставлениеНомера = ЗаписьКонтакт.Поле1 + ЗаписьКонтакт.Поле2 + ЗаписьКонтакт.Поле3;
		ПредставлениеБаза   = ЗаписьКонтакт.Представление;

		Если ЗначениеЗаполнено(ЗаписьКонтакт.Поле4) 
			 И НЕ ЗначениеЗаполнено(ПредставлениеНомера)
			 И ТипЗнч(Источник.Ссылка) = Тип("СправочникСсылка.Пользователи") Тогда
			// Это внутренний номер телефона. Такие номера могут быть только у пользователей. 
			НомерТелефона = ЗаписьКонтакт.Поле4;
		ИначеЕсли НЕ ЗначениеЗаполнено(ПредставлениеНомера + ЗаписьКонтакт.Поле4) И ЗначениеЗаполнено(ПредставлениеБаза) Тогда	
			НомерТелефона = ПредставлениеБаза;
		Иначе
			НомерТелефона = ПредставлениеНомера;
		КонецЕсли;
		
		// Наполним массивы номеров для обновления информации в истории звонков.
		Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
			НомерТелефона = УбратьИзНомераТелефонаВсеПрефиксы(ЗаписьКонтакт.Представление, """' /*+=\,!;%:?()");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
			Продолжить;
		КонецЕсли; 

		Если ЭтоЧисловойНомер(НомерТелефона) Тогда
			НомерТелефона 		= Прав(УбратьИзНомераТелефонаВсеПрефиксы(НомерТелефона), КоличествоХранимыхЦифрТелефона);
			НомерТелефонаЧислом = ПреобразоватьНомерДляСохранения(НомерТелефона, 		 КоличествоХранимыхЦифрТелефона);
			Если ЗначениеЗаполнено(НомерТелефона) Тогда
				Числовые.Вставить(НомерТелефонаЧислом, НомерТелефона);
			КонецЕсли; 
		ИначеЕсли ВСловеТолькоЛатиница(НомерТелефона) И ЗначениеЗаполнено(НомерТелефона) Тогда
			Буквенные.Вставить(НомерТелефона);		
		Иначе
			Продолжить;
		КонецЕсли; 	

	КонецЦикла; // Обход контактной информации


КонецПроцедуры

// По переданным массивам номеров числовых и буквенных выполняет запись
// в регистры сведений "МИКО_опИндексНомераТелефоновБуквенные" и "МИКО_опИндексНомераТелефонов".
// 
Процедура ЗполнитьИндексыНомеров(Числовые, Буквенные, ОбъектКИ) Экспорт

	НаборЗаписей = РегистрыСведений.МИКО_опИндексНомераТелефонов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СсылкаНаКлиента.Установить(ОбъектКИ);

	НаборЗаписейБуквенные = РегистрыСведений.МИКО_опИндексНомераТелефоновБуквенные.СоздатьНаборЗаписей();
	НаборЗаписейБуквенные.Отбор.СсылкаНаКлиента.Установить(ОбъектКИ);
		
	Если Числовые.Количество()>0 Тогда
		Для каждого текНомер Из Числовые Цикл
		 	новЗапись = НаборЗаписей.Добавить();
			новЗапись.НомерТелефонаИндекс = текНомер.Ключ;
		    новЗапись.СсылкаНаКлиента 	  = ОбъектКИ;
		    новЗапись.НомерТелефонаСтрокой= текНомер.Значение;
		КонецЦикла; 
	КонецЕсли; 
	
	Если Буквенные.Количество()>0 Тогда
		Для каждого текНомер Из Буквенные Цикл
		 	новЗапись = НаборЗаписейБуквенные.Добавить();
			новЗапись.НомерТелефонаИндекс 	= СтрЗаменить(текНомер.Ключ," ","");
		    новЗапись.СсылкаНаКлиента 		= ОбъектКИ;
		    новЗапись.НомерТелефонаСтрокой 	= СтрЗаменить(текНомер.Ключ," ","");
		КонецЦикла; 
	КонецЕсли; 
	
	Попытка
	НаборЗаписей.Записать();                                   
	Исключение
	КонецПопытки; 
	
	Попытка
	НаборЗаписейБуквенные.Записать();                                   
	Исключение
	КонецПопытки;

КонецПроцедуры // ЗполнитьИндексыНомеров()

// Поиск клиента.
// 
Функция НайтиКлиентаПоНомеруТелефона(Знач Параметр, Знач ПараметрыКонфигурации = Неопределено) Экспорт

	Если ТипЗнч(Параметр) = Тип("Строка") Тогда
		Возврат НайтиКлиентаПоНомеру(Параметр, ПараметрыКонфигурации);	
	ИначеЕсли ТипЗнч(Параметр) = Тип("Массив") Тогда
		Результат = Новый Массив;
		
		Для каждого ТекНомер Из Параметр Цикл
		 	врРез = НайтиКлиентаПоНомеру(ТекНомер, ПараметрыКонфигурации);
			Если НЕ врРез=Неопределено Тогда
				Результат.Добавить(врРез);	
			КонецЕсли; 
		КонецЦикла; 
		
		Возврат Результат;
	КонецЕсли; 
	
	Возврат Неопределено;
КонецФункции // НайтиКлиентаПоНомеруТелефона()

// Возвращает владльцев номера телефона.
// 
Функция КомуПринадлежитНомер(Знач Параметр) Экспорт
	Результат = Новый Массив;

	Если НЕ ТипЗнч(Параметр)=Тип("Строка") Тогда
		Возврат Результат;	
	КонецЕсли; 
	
	// Классическое представление номера 74952293042.
	Если ЭтоЧисловойНомер(Параметр) Тогда
		ЧислоЦифрДляХранения = МИКО_стОбщегоНазначенияСерверПовторный.КоличествоХранимыхЦифрТелефона();
		НомерТелефонаИндекс = ПреобразоватьНомерДляСохранения(Параметр, ЧислоЦифрДляХранения);
		ИмяРегистра = "МИКО_опИндексНомераТелефонов";		
	// Скайп номер телефона: пример miko_team.	
	ИначеЕсли ВСловеТолькоЛатиница(Параметр) Тогда
		НомерТелефонаИндекс = Параметр;
		ИмяРегистра = "МИКО_опИндексНомераТелефоновБуквенные";		
	Иначе
		Возврат Неопределено;                           
	КонецЕсли;
	   
	Запрос = Новый Запрос;
	
	//Доработки для последних релизов УНФ - НАЧАЛО
	Попытка
		ИзмененаПодчиненность = МИКО_стОбщегоНазначенияСерверПовторный.ИзмененаСтруктураПодчиненностиКонтактовУНФ();
		Если ИзмененаПодчиненность Тогда
			Запрос.Текст = МИКО_стОбщегоНазначенияСерверПовторный.ПолучитьЗапросКИДляУНФ("1", ИмяРегистра);
			РезультатЗапроса = Запрос.Выполнить().Выбрать();
			Пока РезультатЗапроса.Следующий() Цикл
				врРезультат = Новый Структура("Партнер,Абонент,НомерТелефона");
				ЗаполнитьЗначенияСвойств(врРезультат, РезультатЗапроса);
				Результат.Добавить(врРезультат);
			КонецЦикла; 
			Возврат Результат;
		КонецЕсли; 
	Исключение
		ИзмененаПодчиненность = Ложь;
	КонецПопытки; 
	//Доработки для последних релизов УНФ - КОНЕЦ
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИКО_опИндексНомераТелефонов.СсылкаНаКлиента,
		|	МИКО_опИндексНомераТелефонов.НомерТелефонаСтрокой
		|ИЗ
		|	РегистрСведений."+ИмяРегистра+" КАК МИКО_опИндексНомераТелефонов    
		|ГДЕ
		|	МИКО_опИндексНомераТелефонов.НомерТелефонаИндекс = &НомерТелефонаЧислом";
	Запрос.УстановитьПараметр("НомерТелефонаЧислом", НомерТелефонаИндекс);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Пока РезультатЗапроса.Следующий() Цикл
		врДанные = Новый Структура("Владелец,ОбъектВладелец");
		ЗаполнитьЗначенияСвойств(врДанные, РезультатЗапроса.СсылкаНаКлиента);
	    Если ЗначениеЗаполнено(врДанные.Владелец) Тогда
			врРезультат = Новый Структура("Партнер,Абонент,НомерТелефона",врДанные.Владелец, РезультатЗапроса.СсылкаНаКлиента, РезультатЗапроса.НомерТелефонаСтрокой);
		ИначеЕсли ЗначениеЗаполнено(врДанные.ОбъектВладелец) Тогда 	
			врРезультат = Новый Структура("Партнер,Абонент,НомерТелефона",врДанные.ОбъектВладелец, РезультатЗапроса.СсылкаНаКлиента, РезультатЗапроса.НомерТелефонаСтрокой);
		Иначе
			врРезультат = Новый Структура("Партнер,Абонент,НомерТелефона",РезультатЗапроса.СсылкаНаКлиента, Неопределено, РезультатЗапроса.НомерТелефонаСтрокой);
		КонецЕсли;
		Результат.Добавить(врРезультат);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции // НайтиКлиентаПоНомеру()

Функция НайтиКлиентаПоНомеру(Знач Параметр, Знач ПараметрыКонфигурации = Неопределено)
	Если НЕ ТипЗнч(Параметр)=Тип("Строка") Тогда
		Возврат Неопределено;	
	КонецЕсли; 
	
	
	// Классическое представление номера 74952293042.
	Если ЭтоЧисловойНомер(Параметр) Тогда
		ЧислоЦифрДляХранения = МИКО_стОбщегоНазначенияСерверПовторный.КоличествоХранимыхЦифрТелефона();
		НомерТелефонаИндекс  = ПреобразоватьНомерДляСохранения(Параметр, ЧислоЦифрДляХранения);
		ИмяРегистра = "МИКО_опИндексНомераТелефонов";		
		
		Если ПараметрыКонфигурации = Неопределено Тогда
			ТекстПорядок = 1;
		ИначеЕсли ПараметрыКонфигурации.Свойство("СправочникКлиентов")
				 И ПараметрыКонфигурации.Свойство("СправочникКонтЛиц") Тогда	
			ТекстПорядок = "ВЫБОР
							|	КОГДА МИКО_опИндексНомераТелефонов.СсылкаНаКлиента ССЫЛКА Справочник."+ПараметрыКонфигурации.СправочникКлиентов+"
							|			ТОГДА 1
							|	КОГДА МИКО_опИндексНомераТелефонов.СсылкаНаКлиента ССЫЛКА Справочник."+ПараметрыКонфигурации.СправочникКонтЛиц+"
							|			ТОГДА 2
							|	ИНАЧЕ 3
							|	КОНЕЦ";
		Иначе
			ТекстПорядок = 1;
		КонецЕсли; 
	// Скайп номер телефона: пример miko_team.	
	ИначеЕсли ВСловеТолькоЛатиница(Параметр) Тогда
		НомерТелефонаИндекс = Параметр;
		ИмяРегистра  = "МИКО_опИндексНомераТелефоновБуквенные";	
		ТекстПорядок = 1;
	Иначе
		Возврат Неопределено;                           
	КонецЕсли;
	   
	Запрос = Новый Запрос;
	
	//Доработки для последних релизов УНФ - НАЧАЛО
	Попытка
		ИзмененаПодчиненность = МИКО_стОбщегоНазначенияСерверПовторный.ИзмененаСтруктураПодчиненностиКонтактовУНФ();
		Если ИзмененаПодчиненность Тогда
			Запрос.Текст = МИКО_стОбщегоНазначенияСерверПовторный.ПолучитьЗапросКИДляУНФ(ТекстПорядок,ИмяРегистра);
			Запрос.УстановитьПараметр("НомерТелефонаЧислом", НомерТелефонаИндекс);
			РезультатЗапроса = Запрос.Выполнить().Выбрать();
			Если РезультатЗапроса.Следующий() Тогда
				Результат = Новый Структура("Партнер,Абонент,НомерТелефона");
				ЗаполнитьЗначенияСвойств(Результат, РезультатЗапроса);
				Возврат Результат;
			КонецЕсли; 
			Возврат Неопределено;
		КонецЕсли; 
	Исключение
		ИзмененаПодчиненность = Ложь;
	КонецПопытки; 
	//Доработки для последних релизов УНФ - КОНЕЦ
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИКО_опИндексНомераТелефонов.СсылкаНаКлиента,
		|	МИКО_опИндексНомераТелефонов.НомерТелефонаСтрокой,"+
		ТекстПорядок + " КАК Порядок
		|ИЗ
		|	РегистрСведений."+ИмяРегистра+" КАК МИКО_опИндексНомераТелефонов    
		|ГДЕ
		|	МИКО_опИндексНомераТелефонов.НомерТелефонаИндекс = &НомерТелефонаЧислом
		|УПОРЯДОЧИТЬ ПО 
		|  Порядок";
	Запрос.УстановитьПараметр("НомерТелефонаЧислом", НомерТелефонаИндекс);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда
		врДанные = Новый Структура("Владелец,ОбъектВладелец");
		ЗаполнитьЗначенияСвойств(врДанные, РезультатЗапроса.СсылкаНаКлиента);
	    Если ЗначениеЗаполнено(врДанные.Владелец) Тогда
			Результат = Новый Структура("Партнер,Абонент,НомерТелефона",врДанные.Владелец, РезультатЗапроса.СсылкаНаКлиента, РезультатЗапроса.НомерТелефонаСтрокой);
		ИначеЕсли ЗначениеЗаполнено(врДанные.ОбъектВладелец) Тогда 	
			Результат = Новый Структура("Партнер,Абонент,НомерТелефона",врДанные.ОбъектВладелец, РезультатЗапроса.СсылкаНаКлиента, РезультатЗапроса.НомерТелефонаСтрокой);
		Иначе
			Результат = Новый Структура("Партнер,Абонент,НомерТелефона",РезультатЗапроса.СсылкаНаКлиента, Неопределено, РезультатЗапроса.НомерТелефонаСтрокой);
		КонецЕсли;
		
		Возврат Результат;
	КонецЕсли;

КонецФункции // НайтиКлиентаПоНомеру()
 
// Десериализует представление XML контактной информации.
// Параметры 
//   ЗначенияПолей  <Строка> - XML представление контактной информации.
//   СтруктураНомера - комплексный тип: имеет свойство "Телефон" - содержит номер телефона.
// Возвращаемое значение
//   XDTO пакет.
//
Функция КонтактнаяИнформацияИзXML(Знач ЗначенияПолей, Знач Представление)
    пВерсияБиблиотекиБСП = Вычислить("СтандартныеПодсистемыСервер.ВерсияБиблиотеки()");
	
	длВерсияБиблиотекиБСП = Лев(пВерсияБиблиотекиБСП,5);
	Если длВерсияБиблиотекиБСП <= "2.2.3" Тогда
		врВыражение = "КонтактнаяИнформацияСлужебный.ДесериализацияТелефона(ЗначенияПолей, Представление, Перечисления.ТипыКонтактнойИнформации.Телефон)";
	Иначе	
		РезультатыЧтения = Неопределено;
		врВыражение = "УправлениеКонтактнойИнформациейСлужебный.КонтактнаяИнформацияИзXML(ЗначенияПолей, Перечисления.ТипыКонтактнойИнформации.Телефон, РезультатыЧтения)";
	КонецЕсли; 
	РедактируемаяИнформация = Вычислить(врВыражение);	
	
	Возврат РедактируемаяИнформация;
КонецФункции // КонтактнаяИнформацияИзXML()

