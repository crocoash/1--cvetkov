	 Исключение
		 ТабКонтактов = Новый ТаблицаЗначений;
		 ТабКонтактов.Колонки.Добавить("Контрагент");
	 КонецПопытки;
	 
	 Возврат ТабКонтактов.ВыгрузитьКолонку("Контрагент");
	
 КонецФункции
 
Процедура ЗаписатьНовыйКонтакт(Конт) Экспорт 
	 ТабК  = Константы.НовыеИзмененныеКонтакты.Получить();
	 Попытка 
		 ТабКонтактов  = ЗначениеИзСтрокиВнутр(ТабК);
	 Исключение
		 ТабКонтактов = Новый ТаблицаЗначений;
		 ТабКонтактов.Колонки.Добавить("Контрагент");
	 КонецПопытки;
	 НС = ТабКонтактов.Добавить();
	 НС.Контрагент = Конт;
	 Константы.НовыеИзмененныеКонтакты.Установить(ЗначениеВСтрокуВнутр(ТабКонтактов));
 КонецПроцедуры
 
Функция ИмяФайлаБезПути(Имя) Экспорт 
	Им = "";
	СЧ1 = СтрДлина(Имя);
	Для СЧ = 1 По Сч1 Цикл
		 Сим = Сред(Имя,Сч1,1);
		 Сч1= Сч1-1;
		 Если Сим = "/" ИЛИ Сим ="\" Тогда
			 Прервать;
		 КонецЕсли;
		 Им = Сим+Им;
	КонецЦикла;
	Возврат Им;
КонецФункции

