		//	|	КомплектующиеНоменклатуры.Номенклатура = &Номенклатура
		//	|	И (КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		//	|			ИЛИ &ХарактеристикаНоменклатурыВыбрана)
		//	|
		//	|СГРУППИРОВАТЬ ПО
		//	|	КомплектующиеНоменклатуры.Комплектующая,
		//	|	КомплектующиеНоменклатуры.ХарактеристикаКомплектующей
		//	|
		//	|ИМЕЮЩИЕ
		//	|	СУММА(КомплектующиеНоменклатуры.Количество) > 0
		//	|
		//	|ИНДЕКСИРОВАТЬ ПО
		//	|	Комплектующая,
		//	|	ХарактеристикаКомплектующей
		//	|;
		//	|
		//	|////////////////////////////////////////////////////////////////////////////////
		//	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		//	|	ГруппыХарактеристикХарактеристики.Характеристика КАК Характеристика,
		//	|	МАКСИМУМ(ГруппыХарактеристикХарактеристики.Ссылка.ИНКоличество) КАК ИНКоличество
		//	|ПОМЕСТИТЬ ВТИгнорироватьНоль
		//	|ИЗ
		//	|	Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
		//	|ГДЕ
		//	|	НЕ ГруппыХарактеристикХарактеристики.Ссылка.ПометкаУдаления
		//	|	И ГруппыХарактеристикХарактеристики.Ссылка.ИгнорироватьНоль
		//	|
		//	|СГРУППИРОВАТЬ ПО
		//	|	ГруппыХарактеристикХарактеристики.Характеристика
		//	|
		//	|ИНДЕКСИРОВАТЬ ПО
		//	|	Характеристика
		//	|;
		//	|
		//	|////////////////////////////////////////////////////////////////////////////////
		//	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		//	|	ВЫБОР
		//	|		КОГДА (ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)) / ВТКомплектующие.Количество > 0.5
		//	|			ТОГДА ВЫРАЗИТЬ((ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)) / ВТКомплектующие.Количество - 0.5 КАК ЧИСЛО(15, 0))
		//	|		ИНАЧЕ 0
		//	|	КОНЕЦ + ВЫБОР
		//	|		КОГДА ВТИгнорироватьНоль.ИНКоличество > 0
		//	|			ТОГДА ВТИгнорироватьНоль.ИНКоличество
		//	|		КОГДА ВТИгнорироватьНоль.ИНКоличество = 0
		//	|			ТОГДА 999999999
		//	|		ИНАЧЕ 0
		//	|	КОНЕЦ КАК КоличествоОстаток
		//	|ИЗ
		//	|	ВТКомплектующие КАК ВТКомплектующие
		//	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(
		//	|				&НаДату,
		//	|				Склад В (&Склад)
