Функция ПоправитьТелефон(Телефон) Экспорт 
	Телефон = СтрЗаменить(Телефон," ",""); 
	Телефон = СтрЗаменить(Телефон,"+",""); Телефон = СтрЗаменить(Телефон,"-","");
	Телефон = СтрЗаменить(Телефон,"(",""); Телефон = СтрЗаменить(Телефон,")","");
	//Если Лев(Телефон,1)="0" Тогда
	//	Телефон = "38"+Телефон;
	//КонецЕсли;
	Если Лев(Телефон,1)="8" Тогда
		Телефон = Прав(Телефон,СтрДлина(Телефон)-1);
	ИначеЕсли Лев(Телефон,2)="38" Тогда
		Телефон = Прав(Телефон,СтрДлина(Телефон)-2);
	КонецЕсли;
	Возврат Телефон
