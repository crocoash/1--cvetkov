КонецПроцедуры   

Процедура ИзмРезервЗаказов(Рез = Неопределено) Экспорт

	//ЗапущеноРезервирование = Константы.ЗапущеноРезервирование.Получить();
	//Если ЗапущеноРезервирование Тогда Возврат; КонецЕсли;
	//Константы.ЗапущеноРезервирование.Установить(Истина);

	Если Рез = Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ДокументРезерва,
		               |	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.ПорядковыйНомер КАК ПорядковыйНомер,
		               |	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Номер КАК Номер,
		               |	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.СтатусЗаказа КАК СтатусЗаказа,
		               |	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.ТипЦен.Наименование КАК ТипЦен,
		               |	5 КАК СтатусПорядок,
		               |	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Контрагент КАК Контрагент
		               |ИЗ
		               |	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ) КАК ТоварыВРезервеНаСкладахОстатки
		               |ГДЕ
		               |	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Проведен";

		Рез = Запрос.Выполнить().Выгрузить();

		Для Каждого Стр Из Рез Цикл
			Если Стр.ТипЦен = "Оптовая" ИЛИ Стр.ТипЦен = "не используетя" Тогда
				Стр.СтатусПорядок = 0; //1
			Иначе
				Стр.СтатусПорядок = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Рез.Сортировать("СтатусПорядок Возр,Номер Возр");

	МасДокРезерва = Рез.Скопировать();
	Контрагенты   = Рез.Скопировать();

	Контрагенты.Свернуть("Контрагент");
	МасДокРезерва.Свернуть("ДокументРезерва");

	Для Каждого Стр Из Рез Цикл

		Если ТипЗнч(Стр.ДокументРезерва) <> Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Продолжить;
		КонецЕсли;

		НачатьТранзакцию();
		Попытка

			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.ЗаказПокупателя");
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Стр.ДокументРезерва);
			Блокировка.Заблокировать();

			Об = Стр.ДокументРезерва.ПолучитьОбъект();

			// Битая ссылка в регистре — объекта уже нет
			Если Об = Неопределено Тогда

				ЗафиксироватьТранзакцию();

				ЗаписьЖурналаРегистрации(
					"ИзмРезервЗаказов",
					УровеньЖурналаРегистрации.Предупреждение,
					,
					,
					"Пропущен несуществующий заказ (битая ссылка): " + Строка(Стр.ДокументРезерва)
				);

				НайденДокР = МасДокРезерва.Найти(Стр.ДокументРезерва);
				Если НайденДокР <> Неопределено Тогда
					МасДокРезерва.Удалить(НайденДокР);
				КонецЕсли;

