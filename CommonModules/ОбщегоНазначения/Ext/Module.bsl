Функция СоответсвияСвойстваНаРус(Свойство,Значение) Экспорт 
	ТабСвойств = Константы.СоответсвияСвойствРозетка.Получить().Получить();
	Если НЕ ТипЗнч(ТабСвойств)= Тип("ТаблицаЗначений") ТОгда Возврат ""; КонецЕсли;
	
	НайденоСвойство = ТабСвойств.НайтиСтроки(Новый Структура("Свойство,Значение",Свойство,Значение));

	Для каждого зн из НайденоСвойство Цикл
		Наименование2 = зн.Наименование2;
		Если Наименование2 = "рус" Тогда 	
			Возврат зн.Соответствие2;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

Функция СоответвиеСвойстваЗначение(Свойство,Значение,Только1=Ложь,Соответствие="") Экспорт
	
	Если Не ЗначениеЗаполнено(Значение) Тогда Возврат "" КонецЕсли;
	
	ТабПараметры = ПараметрыКВыгрузке(Соответствие);
	
	НайденоСвойство = ТабПараметры.НайтиСтроки(Новый Структура("Свойство,Значение",Свойство,Значение));
	
	Если НайденоСвойство.Количество()=0 Тогда //ищем только по наименованию
		НайденоСвойство = ТабПараметры.Найти(Свойство,"Свойство");
		Если НайденоСвойство = Неопределено Тогда
			Возврат "";
		Иначе
			Если НайденоСвойство.Отметка1 ИЛИ Только1 Тогда
				Им = НайденоСвойство.Наименование1;
				Зн = Значение;
			КонецЕсли;
			
			Если НайденоСвойство.Отметка2  И НЕ Только1 Тогда
				Им = НайденоСвойство.Наименование2;
				Зн = НайденоСвойство.Соответствие2;
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		Если НайденоСвойство[0].Отметка1  ИЛИ Только1 Тогда
			Им = НайденоСвойство[0].Наименование1;
			Зн = Значение;
		КонецЕсли;
		
		Если НайденоСвойство[0].Отметка2  И НЕ Только1 Тогда
			Им = НайденоСвойство[0].Наименование2;
			Зн = НайденоСвойство[0].Соответствие2;
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("Имя,Зн",Им,Зн);
КонецФункции

Функция КлючевыйСловаГруппы(НоменклатурнаяГруппа) Экспорт
	
	Если Не ЗначениеЗаполнено(НоменклатурнаяГруппа) Тогда Возврат "" КонецЕсли;
	
	КлСл  = "";Ном = 0;
	Для Каждого Стр Из НоменклатурнаяГруппа.КлючевыеСлова Цикл
		Ном = Ном+1;
		Если Ном = НоменклатурнаяГруппа.КлючевыеСлова.Количество() Тогда
			КлСл = КлСл+Стр.КлючевоеСлово;
		Иначе
			КлСл = КлСл+Стр.КлючевоеСлово+",";
		КонецЕсли;
	КонецЦикла;
	
	Возврат КлСл;
	
КонецФункции

Функция ГруппаЦветовХарактеристики(Номенклатура,Характеристика) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГруппаЦветовХарактеристики.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ГруппаЦветов.Характеристики КАК ГруппаЦветовХарактеристики
	               |ГДЕ
	               |	ГруппаЦветовХарактеристики.Характеристика = &Характеристика
	               |	И ГруппаЦветовХарактеристики.Ссылка.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Характеристика",Характеристика);
	Запрос.УстановитьПараметр("Владелец",Номенклатура);
	
	Рез = Запрос.Выполнить().Выбрать();
	Если Рез.Следующий() Тогда
		Возврат  Рез.Ссылка;
	Иначе
		Возврат Неопределено
	КонецЕсли;

КонецФункции


