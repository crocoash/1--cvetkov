Функция ПеревестиНаУкр(ТекНаименование, НаправлениеПеревода = "ru-uk") Экспорт
	
	АПИКлюч = "";
	Выборка = Справочники.КарточныеСчета.Выбрать(); 
	Пока Выборка.Следующий() Цикл 
		Если Выборка.Активен Тогда 
			АПИКлюч = Выборка.АПИКлючПеревода;
			Прервать;
		КонецЕсли;	
	КонецЦикла; 
	Если НЕ ЗначениеЗаполнено(АПИКлюч) Тогда 
		Возврат ТекНаименование;
	КонецЕсли;		
	
	Адрес = "https://translate.yandex.net/api/v1.5/tr/translate?key="+СокрЛП(АПИКлюч)+"&text="+СокрЛП(ТекНаименование)+"&lang="+НаправлениеПеревода;
	Попытка
		XMLHTTP=Новый COMОбъект("MSXML2.XMLHTTP");
		XMLHTTP.Open("get",Адрес,Ложь);
		XMLHTTP.setRequestHeader("Content-Type", "text/xml; charset=Windows-1251");
		XMLHTTP.Send();
		ТекстОтвет = XMLHTTP.ResponseText();
		
		КодОтвета = "";
		НомерСимвола = найти(ТекстОтвет,"Translation code=");
		Если НомерСимвола <> 0 Тогда
			КодОтвета = Сред(ТекстОтвет, НомерСимвола+16+1+1,3);
			ТекстОшибки = "";
			Если КодОтвета = "200" Тогда 
			ИначеЕсли КодОтвета = "401" Тогда 
				ТекстОшибки = "Неправильный API-ключ"
			ИначеЕсли КодОтвета = "402" Тогда 
				ТекстОшибки = "API-ключ заблокирован"
			ИначеЕсли КодОтвета = "404" Тогда 
				ТекстОшибки = "Превышено суточное ограничение на объем переведенного текста"
			ИначеЕсли КодОтвета = "413" Тогда 
				ТекстОшибки = "Превышен максимально допустимый размер текста"
			ИначеЕсли КодОтвета = "422" Тогда 
				ТекстОшибки = "Текст не может быть переведен"
			ИначеЕсли КодОтвета = "501" Тогда 						
				ТекстОшибки = "Заданное направление перевода не поддерживается"
			КонецЕсли;	
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда 
				Возврат ТекНаименование;
			КонецЕсли;
		КонецЕсли; 
		
		НомерСимвола = найти(ТекстОтвет,"text>");
		Если НомерСимвола <> 0 Тогда
			ТекСтрока = Прав(ТекстОтвет, СтрДлина(ТекстОтвет)-НомерСимвола-4);
			НомерСимвола = Найти(ТекСтрока,"<"); 
			ТекстОтвет1 = Лев(ТекСтрока,НомерСимвола-1); 
		КонецЕсли; 
	Исключение
		
	КонецПопытки; 
	
	Возврат ТекстОтвет1;
	
КонецФункции

