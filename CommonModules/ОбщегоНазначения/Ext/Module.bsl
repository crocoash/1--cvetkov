Функция АвтомСкидка(Характеристика,НаДату="") Экспорт 
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда 
		НаДату = ТекущаяДата();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СкидкиНаценкиНоменклатурыСрезПоследних.ПроцентСкидкиНаценки КАК ПроцентСкидки,
	               |	СкидкиНаценкиНоменклатурыСрезПоследних.Период КАК Период
	               |ИЗ
	               |	РегистрСведений.СкидкиНаценкиНоменклатуры.СрезПоследних(
	               |			&НаДату,
	               |			ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	               |				И (ДатаОкончания >= &ДатаОкончания
	               |					ИЛИ ДатаОкончания = &ПустДата)) КАК СкидкиНаценкиНоменклатурыСрезПоследних
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период УБЫВ";
	
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",Характеристика);
	Запрос.УстановитьПараметр("ДатаОкончания",НачалоДня(НаДату));
	Запрос.УстановитьПараметр("ПустДата",Дата(1,1,1));
	Запрос.УстановитьПараметр("НаДату",НаДату);

	Рез = Запрос.Выполнить().Выбрать();
	
	Если Рез.Следующий() Тогда
		Возврат Рез.ПроцентСкидки;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция СкладРезерваПолучить(СтрНоменклатуры,Схема, МасИсклЗак =Неопределено)Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВложенныйЗапрос.Склад КАК Склад,
	               |	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	               |	СУММА(ВложенныйЗапрос.КоличествоОстаток) КАК Остаток
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад,
	               |		ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
	               |		-ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	               |	ИЗ
	               |		РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	               |				,
	               |				НЕ ДокументРезерва В (&ДокументРезерва)
	               |					И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ТоварыВРезервеНаСкладахОстатки
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ТоварыНаСкладахОстатки.Склад,
	               |		ТоварыНаСкладахОстатки.Номенклатура,
	               |		ТоварыНаСкладахОстатки.КоличествоОстаток
	               |	ИЗ
	               |		РегистрНакопления.ТоварыНаСкладах.Остатки(, ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ТоварыНаСкладахОстатки) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВложенныйЗапрос.Номенклатура,
	               |	ВложенныйЗапрос.Склад
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Остаток УБЫВ";
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",СтрНоменклатуры.ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("ДокументРезерва",МасИсклЗак);
	
	РезОстатков = Запрос.Выполнить().Выгрузить();
	Скл = Неопределено;
	Если ЗначениеЗаполнено(Схема) ТОгда
		ДЛя Каждого Стр Из Схема.Склады Цикл
			МасСкл = Новый Массив;
			МасСкл.Добавить(Стр.Склад);
			Ост = ОбщегоНазначения.ОстатокНоменклатуры(СтрНоменклатуры.Номенклатура,МасСкл,СтрНоменклатуры.ХарактеристикаНоменклатуры,ТекущаяДата());
			Рез = ОбщегоНазначения.РезервНоменклатуры(СтрНоменклатуры.Номенклатура,МасСкл,СтрНоменклатуры.ХарактеристикаНоменклатуры,ТекущаяДата());
			Если Ост-Рез<СтрНоменклатуры.Количество Тогда Продолжить; КонецЕсли;
			Скл = Стр.Склад;
			Прервать;
		КонецЦикла;
		
		//если не хватило из складов то берем из приоритетных складов где максимум
		Если Скл = Неопределено Тогда
			Макс  = 0;
			ДЛя Каждого Стр Из Схема.Склады Цикл
				МасСкл = Новый Массив;
				МасСкл.Добавить(Стр.Склад);
				Ост = ОбщегоНазначения.ОстатокНоменклатуры(СтрНоменклатуры.Номенклатура,МасСкл,СтрНоменклатуры.ХарактеристикаНоменклатуры,ТекущаяДата());
				Рез = ОбщегоНазначения.РезервНоменклатуры(СтрНоменклатуры.Номенклатура,МасСкл,СтрНоменклатуры.ХарактеристикаНоменклатуры,ТекущаяДата());

				Если Ост-Рез > Макс Тогда
					Макс = Ост-Рез; 
					Скл = Стр.Склад;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Скл = Неопределено  И РезОстатков.Количество()>0 Тогда // или когда не выбрана схема резервирования
		Скл = Справочники.Склады.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Скл;
	
КонецФункции

Процедура ПорядокПоменять(ПН,Вперед = Истина) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ПН) Тогда
		Сообщить("Не определен пор. номер!");
		Возврат;
	КонецЕсли;
	
	Если Вперед Тогда  //вперед -сортируем Порядок Возр
		
		Попытка
			СледПН = Число(ПН)+1;
		Исключение
			Сообщить("Не определен следующий пор. номер!");
			Возврат;
		КонецПопытки;
	
		СледЗак = Документы.ЗаказПокупателя.НайтиПоРеквизиту("ПорядковыйНомер",Строка(СледПН));
		ТекДок = Документы.ЗаказПокупателя.НайтиПоРеквизиту("ПорядковыйНомер",Строка(ПН));
		
		
		Если НЕ ЗначениеЗаполнено(СледЗак) ИЛИ НЕ ЗначениеЗаполнено(ТекДок) Тогда
			Сообщить("Не найден пор. номер заказа!");
			Возврат;
		КонецЕсли;

		ОбСлед = СледЗак.ПолучитьОбъект();
		ОбСлед.ПорядковыйНомер = ПН;
		ОбСлед.Записать(РежимЗаписиДокумента.Запись);
		
		Об = ТекДок.ПолучитьОбъект();
		Об.ПорядковыйНомер = СледПН;
		Об.Записать(РежимЗаписиДокумента.Запись);
		
	Иначе  //назад
		
		Попытка
			ПредПН = Число(ПН)-1;
		Исключение
			Сообщить("Не определен предыдущий пор. номер!");
			Возврат;
		КонецПопытки;
	
		ПредЗак = Документы.ЗаказПокупателя.НайтиПоРеквизиту("ПорядковыйНомер",Строка(ПредПН));
		ТекДок = Документы.ЗаказПокупателя.НайтиПоРеквизиту("ПорядковыйНомер",Строка(ПН));
		
		
		Если НЕ ЗначениеЗаполнено(ПредЗак) ИЛИ НЕ ЗначениеЗаполнено(ТекДок) Тогда
			Сообщить("Не найден пор. номер заказа!");
			Возврат;
		КонецЕсли;

		ОбПред = ПредЗак.ПолучитьОбъект();
		ОбПред.ПорядковыйНомер = ПН;
		ОбПред.Записать(РежимЗаписиДокумента.Запись);
		
		Об = ТекДок.ПолучитьОбъект();
		Об.ПорядковыйНомер = ПредПН;
		Об.Записать(РежимЗаписиДокумента.Запись);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПорядковыйНомерПолучить()  Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 3
	               |	ЗаказПокупателя.ПорядковыйНомер КАК ПорядковыйНомер
	               |ИЗ
	               |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорядковыйНомер УБЫВ";
	Рез = Запрос.Выполнить().Выбрать();
	
	Если Рез.следующий() Тогда
		Попытка
			Ном =Число(Рез.ПорядковыйНомер);
		Исключение
			Ном = 0;
		КонецПопытки;
		
		Возврат Строка(Ном+1); 	
	Иначе
		Возврат "1";
	КонецЕсли;
КонецФункции

Функция ТаблицаРостовок(ТЗ,Склад) Экспорт
	
	ТЗ.Колонки.Добавить("Р1"); ТЗ.Колонки.Добавить("В1"); ТЗ.Колонки.Добавить("В2");
	
	Для Каждого Стр Из ТЗ Цикл
		РазбиваетРостовку = ОбщегоНазначения.РазбиваетРостовкуСклада(Стр.ХарактеристикаНоменклатуры,Склад,Стр.Количество);
	
		ВсеИзГруппы = ОбщегоНазначения.ВсеИзГруппыВТаблице(Стр.ХарактеристикаНоменклатуры,ТЗ);
		
		Кол = Стр.Количество;
		
		Если НЕ ВсеИзГруппы Тогда //отдельная номенклатура
			//определяем в разные ячейки Врозь 1 - сколько можно взять не разбивая ростовку  склада Врозь 2 остальное количество
			
			Если  РазбиваетРостовку<0  Тогда
				Стр.В1 = Кол+РазбиваетРостовку;
				Стр.В2 = -РазбиваетРостовку;

			Иначе
				Стр.В1 =  Кол;
				Стр.В2 = 0;
			КонецЕсли;
		Иначе //группа
			
			ЛишниеИзГруппы = ОбщегоНазначения.ЛишнееИзГруппы(Стр.ХарактеристикаНоменклатуры,ТЗ);
			
			//определяем сколько нужно взять на ростовку чтобы не разбить ростовку на складе в яч ДляРостовки1 , а ДляРостовки2 - -остальное
			
			Если ЛишниеИзГруппы >0  Тогда
				
				КолРост = Кол-ЛишниеИзГруппы;
				
				РазбиваетРостовкуРост = ОбщегоНазначения.РазбиваетРостовкуСклада(Стр.ХарактеристикаНоменклатуры,Склад,ЛишниеИзГруппы,КолРост);
				
				// для ростовки
				
				Стр.Р1 = КолРост;
				
				//для лишнего
				Если РазбиваетРостовкуРост<0 Тогда
					Стр.В1 = ЛишниеИзГруппы+РазбиваетРостовкуРост;
					Стр.В2 = -РазбиваетРостовкуРост;
				Иначе
					Стр.В1 = ЛишниеИзГруппы;
					Стр.В2 = 0;
				КонецЕсли;

			Иначе
					
				Стр.Р1=Кол;


			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Возврат ТЗ;
	
КонецФункции

