Функция ЛишнееИзГруппы(Характеристика,Таб) Экспорт
	ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();	
	ГРХар = ХарактеристикаОбъект.ПолучитьРостовку();
	Если  НЕ ЗначениеЗаполнено(ГРХар) Тогда Возврат 0; КонецЕсли;
	
	Мин = 1000; Макс = 0;
	ДЛя Каждого Стр Из ГРХар.Характеристики ЦИкл
		НайденаХарактеристика = Таб.Найти(Стр.Характеристика,"ХарактеристикаНоменклатуры");
		Если НайденаХарактеристика = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		
			Если НайденаХарактеристика.Количество > Макс Тогда
				Макс = НайденаХарактеристика.Количество;
			КонецЕсли;
			Если НайденаХарактеристика.Количество < Мин Тогда
				Мин = НайденаХарактеристика.Количество;
			КонецЕсли;

	КонецЦикла;
		
	ДЛя Каждого Стр Из ГРХар.Характеристики ЦИкл
		НайденаХарактеристика = Таб.Найти(Стр.Характеристика,"ХарактеристикаНоменклатуры");
		Если НайденаХарактеристика = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		
		Если НайденаХарактеристика.Количество > Мин И НайденаХарактеристика.ХарактеристикаНоменклатуры = Характеристика
			Тогда
			Возврат НайденаХарактеристика.Количество-Мин;
		КонецЕсли;

	КонецЦикла;

	Возврат 0;
	
КонецФункции

Функция РазбиваетРостовкуСклада(Характеристика,Склад,Количество=1,КоличествоКор = 0) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГруппыХарактеристикХарактеристики.Ссылка.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
	               |ГДЕ
	               |	ГруппыХарактеристикХарактеристики.Характеристика = &Характеристика";
	Запрос.УстановитьПараметр("Характеристика",Характеристика);
	
	Рез = Запрос.Выполнить().Выбрать();
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Характеристика");
	ТЗ.Колонки.Добавить("Остаток");
	ТЗ.Колонки.Добавить("Доступна");
	
	Склады = Новый Массив;
	Склады.Добавить(Склад);
	
	Если Рез.Следующий() Тогда
		
		Для Каждого Стр Из Рез.Ссылка.Характеристики Цикл
			НС = ТЗ.Добавить();
			НС.Характеристика = Стр.Характеристика;
			НС.Остаток = ОстатокНоменклатуры(Стр.Характеристика.Владелец,Склады,стр.Характеристика,ТекущаяДата());
			//-РезервНоменклатуры(Стр.Характеристика.Владелец,Новый Массив,стр.Характеристика,ТекущаяДата())-КоличествоКор;
			НС.Доступна = Ложь;
		КонецЦикла;
		
		Мин = 1000; Макс = 0;
		Для Каждого Стр Из ТЗ Цикл
			Если Стр.Остаток> Макс Тогда
				Макс = Стр.Остаток;
			КонецЕсли;
			Если Стр.Остаток< Мин Тогда
				Мин = Стр.Остаток;
			КонецЕсли;
		КонецЦикла;
		
		//РР = Рез.Ссылка.РаспаковатьРостовок;  // можно ли распаковать ростовки?
		Для Каждого Стр Из ТЗ Цикл
			Если НЕ Стр.Характеристика =  Характеристика Тогда Продолжить; КонецЕсли;
			
			//Если Стр.Остаток - Количество < Мин Тогда
			//	Разбивает = Истина;
			//Иначе
			//	Разбивает = Ложь;
			//КонецЕсли;
			Возврат  Стр.Остаток - Количество - Мин; //если "-" тогда разбивает
			
		КонецЦикла;
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Возврат 0;	
	
КонецФункции
		
