функция ЗаписатьСвойстваДляХарактеритси(ТабПараметры, Категория, Характеристика, ЗаголовокПараметра, КодПараметра, ЗначениеАйди, ИсключениеСвойств = Неопределено, Jaison = Ложь, Разделитель=Неопределено) Экспорт
	
	Номенклатура = Характеристика.Владелец;
	
	ТабСвойств = ТабПараметры.скопировать();
	ТабСвойств.Свернуть("Свойство");
	Текст = "";
	Для Каждого Стр1 Из ТабСвойств Цикл
			
		Если ИсключениеСвойств <> Неопределено И ИсключениеСвойств.Найти(Стр1.Свойство.Код) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
				
		ЗнСв = ОбщегоНазначения.СвойстваОбъекта(Характеристика,Стр1.Свойство.Код);
		Если НЕ ЗначениеЗаполнено(ЗнСв) Тогда
			ЗнСв = ОбщегоНазначения.СвойстваОбъекта(Номенклатура,Стр1.Свойство.Код);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЗнСв) Тогда Продолжить; КонецЕсли;
		
		НайденоСвойство = ТабПараметры.НайтиСтроки(Новый Структура("Свойство",Стр1.Свойство));

		Для Каждого Св Из НайденоСвойство Цикл
			
			Если ЗначениеЗаполнено(Св.Значение) И Св.Значение <> ЗнСв  Тогда 
				Продолжить;
			КонецЕсли;
				             
			Если ЗначениеЗаполнено(Св.Категория) И Св.Категория <> Категория Тогда
				Продолжить;
			КонецЕсли;
			
			Если Св.Отметка1 Тогда
				
				Если ЗначениеЗаполнено(Св.Наименование1) ТОгда
					НаименованиеПараметра = СокрЛП(Св.Наименование1);
				Иначе 
					НаименованиеПараметра = Св.Свойство.Наименование;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Св.Значение) Тогда 
					Значение = СокрЛП(Св.Значение.Наименование);
				Иначе
			        Если ЗначениеЗаполнено(ЗнСв) Тогда
						Значение = ЗнСв.Наименование;
					иначе
						Продолжить;
					КонецЕсли;

				КонецЕсли;		
				
				Значение = СтрЗаменить(Значение,";"," ");   
				Значение = СтрЗаменить(Значение,":","-");
				
				КодПараметр = "";
				ЗначениеКод = "";
				
				// Проверка и присвоение значения КодПараметр
				Если КодПараметра <> "" Тогда
					Если Св.Наименование1Код <> 0 Тогда
				    	КодПараметр = КодПараметра + "=" + """" + Формат(Св.Наименование1Код, "ЧГ=0") + """" + " ";
					Иначе
						КодПараметр = КодПараметра + "=" + """" + Стр1.Свойство.код+ """" + " ";
					КонецЕсли;
				КонецЕсли;
				
				

				ЗначениеКод = "";
				// Проверка и присвоение значения ЗначениеКод
				Если ЗначениеАйди <> "" Тогда	
					Если Св.ЗначениеКод = "" Или Св.ЗначениеКод = 0  Тогда
				    	ЗначениеКод = ЗначениеАйди + "=" + """" + ЗнСв.код  + """" + " ";
					Иначе
						ЗначениеКод = ЗначениеАйди + "=" + """" + Формат(Св.ЗначениеКод, "ЧГ=0") + """" + " ";
					КонецЕсли;
				КонецЕсли;
				
				//КодПараметр = ?(Не (КодПараметра="" Или Св.Наименование1Код = 0),""+КодПараметра+"" + "=" + """" +Формат(Св.Наименование1Код, "ЧГ=0") +""""+" ","");
				//ЗначениеКод = ?(Не (ЗначениеАйди="" Или (Св.ЗначениеКод = "" Или Св.ЗначениеКод = 0)),""+ЗначениеАйди+"" + "=" + """" +Формат(Св.ЗначениеКод, "ЧГ=0") + """"+" " ,"") ;
				
				Если Не Jaison Тогда	
					Текст = Текст + ("<param " + ЗаголовокПараметра + "=""" + НаименованиеПараметра + """" + " " +КодПараметр + ЗначениеКод + ">" + Значение + "</param>") + Символы.ПС;
				Иначе
					Текст = Текст + (Разделитель + """" + НаименованиеПараметра + """" + ":" + """" + Значение + """" + ",") + Символы.ПС;
				КонецЕсли;	                                                    
			КонецЕсли;
			           
			Если Св.Отметка2 Тогда
				НаименованиеПараметра = СокрЛП(Св.Наименование2);
				
				Если ЗначениеЗаполнено(Св.Соответствие2) Тогда 
					Значение = СокрЛП(Св.Соответствие2);	
				Иначе 
					Если ЗначениеЗаполнено(ЗнСв) Тогда
						Если СтрНайти(НаименованиеПараметра,"ru") > 0 Тогда 
							Значение = ЗнСв.НаименованиеРус;
						ИначеЕсли СтрНайти(НаименованиеПараметра,"ua") Тогда
							Значение = ЗнСв.Наименование;
						ИначеЕсли СтрНайти(НаименованиеПараметра,"en") Тогда
							Значение = ЗнСв.НаименованиеИнгл;
