	                |			ВЫБОР
	                |				КОГДА КомплектующиеНоменклатуры.ХарактеристикаКомплектующей ЕСТЬ NULL
	                |					ТОГДА ХарактеристикиНоменклатуры.Ссылка
	                |				ИНАЧЕ КомплектующиеНоменклатуры.ХарактеристикаКомплектующей
	                |			КОНЕЦ КАК ХарактеристикаВыход,
	                |			ХарактеристикиНоменклатуры.Ссылка КАК характеристика
	                |		ИЗ
	                |			Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	                |				ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
	                |				ПО ХарактеристикиНоменклатуры.Ссылка = КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры) КАК ПолучимХарактеристикуДляОстатков
	                |			ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                |				ВТРостовка.Ростовка.ИгнорироватьНоль КАК РостовкаИгнорироватьНоль,
	                |				ЕСТЬNULL(ПолучимВРезерве.КоличествоОстаток, 0) КАК вРезерве,
	                |				ЕСТЬNULL(получимОстаток.КоличествоОстаток, 0) КАК Остаток,
	                |				ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
	                |			ИЗ
	                |				Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	                |					ПОЛНОЕ СОЕДИНЕНИЕ ВТРостовка КАК ВТРостовка
	                |					ПО ХарактеристикиНоменклатуры.Ссылка = ВТРостовка.Характеристика
	                |					ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                |						ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	                |						ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	                |					ИЗ
	                |						РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеНаСкладахОстатки
	                |					ГДЕ
	                |						ТоварыВРезервеНаСкладахОстатки.Склад.Активный) КАК ПолучимВРезерве
	                |					ПО ХарактеристикиНоменклатуры.Ссылка = ПолучимВРезерве.ХарактеристикаНоменклатуры
	                |					ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                |						ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	                |						ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	                |					ИЗ
	                |						РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
	                |					ГДЕ
	                |						ТоварыНаСкладахОстатки.Склад.Активный) КАК получимОстаток
	                |					ПО ХарактеристикиНоменклатуры.Ссылка = получимОстаток.ХарактеристикаНоменклатуры) КАК ПолучимОстаткиПоНоменклатуре
	                |			ПО ПолучимХарактеристикуДляОстатков.ХарактеристикаВыход = ПолучимОстаткиПоНоменклатуре.Характеристика
	                |		ПО ХарактеристикиНоменклатуры.Ссылка = ПолучимХарактеристикуДляОстатков.характеристика
	                |ГДЕ
	                |	ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры.Код В (""000000010"", ""000000001"")
	                |	И НЕ ХарактеристикиНоменклатуры.Владелец.НеВыгружатьНаРозетку
	                |	И (ПолучимОстаткиПоНоменклатуре.вРезерве <> 0
	                |			ИЛИ ПолучимОстаткиПоНоменклатуре.Остаток <> 0
	                |			ИЛИ ПолучимОстаткиПоНоменклатуре.РостовкаИгнорироватьНоль
	                |			ИЛИ &ВидВыгрузки = ""000000003"")
	                |	И (ХарактеристикиНоменклатуры.Владелец В (&МассивНоменклатура)
	                |			ИЛИ &МассивНоменклатурыПустой)
	                |	И (ХарактеристикиНоменклатуры.Владелец В ИЕРАРХИИ (&Родитель)
	                |			ИЛИ &Родитель = НЕОПРЕДЕЛЕНО)
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ХарактеристикиНоменклатуры.Владелец
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                |	ХарактеристикиНоменклатуры.Владелец.Родитель.Родитель КАК Группа,
	                |	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура,
	                |	ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры.Код = ""000000010"" КАК ЭтоНаборКомплектРучной,
	                |	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
	                |	ПолучимЦвет.Цвет КАК Цвет,
	                |	ВЫБОР
	                |		КОГДА ПолучимОстатокВсехРостовок.ДоступныйОстаток > 0
	                |			ТОГДА ""true""
	                |		ИНАЧЕ ""false""
	                |	КОНЕЦ КАК available,
	                |	ВЫБОР
	                |		КОГДА ПолучимОстаткиРозн.Доступна
	                |			ТОГДА ""true""
	                |		ИНАЧЕ ""false""
	                |	КОНЕЦ КАК Доступна,
	                |	ПолучимРостовку.Ростовка КАК Ростовка,
	                |	Штрихкоды.Штрихкод КАК Штрихкод,
	                |	ПолучимТкань.Значение КАК Ткань,
	                |	ВЫБОР
	                |		КОГДА ПолучимОстаткиРозн.ДоступныйОстаток < 0
	                |			ТОГДА 0
	                |		ИНАЧЕ ПолучимОстаткиРозн.ДоступныйОстаток
	                |	КОНЕЦ КАК ДоступныйОстатокРозн,
	                |	ВЫБОР
	                |		КОГДА ПолучимОстаткиОпт.ДоступныйОстаток < 0
	                |			ТОГДА 0
	                |		ИНАЧЕ ПолучимОстаткиОпт.ДоступныйОстаток
	                |	КОНЕЦ КАК ДоступныйОстатокОпт,
	                |	ПолучимФотографии.Ссылка КАК Фото,
	                |	ПолучимФотоЗамеров.фото КАК фотоЗамеров,
	                |	ПолучимСкидкуРостовки.ДатаОкончания КАК ДатаОкончанияСкидки,
	                |	ВЫБОР
	                |		КОГДА ПолучимОстаткиОпт.Доступна
	                |			ТОГДА ПолучимРостовку.Ростовка.ИгнорироватьНоль
	                |		ИНАЧЕ ЛОЖЬ
	                |	КОНЕЦ КАК ПредзаказОпт,
	                |	ВЫБОР
	                |		КОГДА ПолучимОстаткиРозн.Доступна
	                |			ТОГДА ПолучимРостовку.Ростовка.ИгнорироватьНоль
	                |		ИНАЧЕ ЛОЖЬ
	                |	КОНЕЦ КАК ПредзаказРозн,
	                |	ПолучимОптовуюЦену.Цена КАК ЦенаОпт,
	                |	НЕ ПолучимЦенуСтатическуюРозница.Цена ЕСТЬ NULL
