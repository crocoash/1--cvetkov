Функция ПорядковыйНомерСменаСтатуса(Заказ)  Экспорт
	//при смене статуса порядковый номер берем наименьший для статуса
	// а тот что был с наименьшим статусом двигается вниз
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 3
	               |	ЗаказПокупателя.ПорядковыйНомер КАК ПорядковыйНомер
	               |ИЗ
	               |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	               |ГДЕ
	               |	ЗаказПокупателя.СтатусЗаказа = &СтатусЗаказа
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорядковыйНомер";
	Запрос.УстановитьПараметр("СтатусЗаказа",Заказ.СтатусЗаказа);
	Рез = Запрос.Выполнить().Выбрать();
	
	Если Рез.следующий() Тогда
		Попытка
			Ном =Число(Рез.ПорядковыйНомер);
		Исключение
			Ном = 0;
		КонецПопытки;
		
		Возврат Строка(Ном+1); 	
	Иначе
		Возврат "1";
	КонецЕсли;
КонецФункции

Функция СтатусыДнейВСтатусе() Экспорт 
	
	Запрос = Новый Запрос;
	// ДнейВСтатусеРозница - порог для розничных заказов, переопределяет общий
	// (БИАС.ПроверкаЗадачь). Статус с одним только розничным порогом из выборки
	// выпадать не должен, поэтому условие по двум реквизитам.
	Запрос.Текст = "ВЫБРАТЬ
	               |	СтатусыЗаказов.Ссылка КАК Статус,
	               |	СтатусыЗаказов.ДнейВСтатусе КАК ДнейВСтатусе,
	               |	СтатусыЗаказов.ДнейВСтатусеРозница КАК ДнейВСтатусеРозница
	               |ИЗ
	               |	Справочник.СтатусыЗаказов КАК СтатусыЗаказов
	               |ГДЕ
	               |	(СтатусыЗаказов.ДнейВСтатусе <> 0
	               |			ИЛИ СтатусыЗаказов.ДнейВСтатусеРозница <> 0)
	               |	И НЕ СтатусыЗаказов.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СтатусыЗаказов.ДнейВСтатусе УБЫВ";
	
	Рез = Запрос.Выполнить().Выгрузить();
	
	Возврат Рез;

	
КонецФункции

