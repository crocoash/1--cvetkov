	Если ЗначениеЗаполнено(ГрЦв) тОгда
		ССНаКарт = "";
		Если ГрЦв.Фотографии.Количество()=1 Тогда
			Возврат "http://cvetkovtm.com/assets/shop/sync/imgJpg/"+СокрЛП(ГрЦв.Фотографии[0].Наименование);
		Иначе
			ДЛя Каждого Стр Из ГрЦв.Фотографии Цикл
				Если Стр.Главная Тогда 
					Возврат "http://cvetkovtm.com/assets/shop/sync/imgJpg/"+СокрЛП(ГрЦв.Фотографии[0].Наименование);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ФотографииГруппыЦветов(Группа, СЗамерами = Ложь, СВидео = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппаЦветовФотографии.Фото КАК Фото,
		|	ГруппаЦветовФотографии.Наименование КАК Наименование,
		|	ГруппаЦветовФотографии.НаименованиеWebp КАК НаименованиеWebp,
		|	ГруппаЦветовФотографии.Наименование КАК Название,
		|	ГруппаЦветовФотографии.Главная КАК Главная,
		|	ГруппаЦветовФотографии.НеВыгружать КАК НеВыгружать,
		|	ГруппаЦветовФотографии.НеВыгружатьРозница КАК НеВыгружатьРозница,
		|	ГруппаЦветовФотографии.НеВыгружатьОпт КАК НеВыгружатьОпт
		|ИЗ
		|	Справочник.ГруппаЦветов.Фотографии КАК ГруппаЦветовФотографии
		|ГДЕ
		|	ГруппаЦветовФотографии.Ссылка = &Группа
		|
		|УПОРЯДОЧИТЬ ПО
		|	Главная УБЫВ";
	
		
	Запрос.УстановитьПараметр("Группа", Группа);
	Рез = Запрос.Выполнить().Выгрузить();
	ЕстьДляРозницы = Ложь;
	 Для Каждого Строка Из Рез Цикл  
        Строка.НаименованиеWebp = НРег(Строка.НаименованиеWebp);
		Строка.Наименование = НРег(Строка.Наименование);
		Если НЕ Строка.НеВыгружать ИЛИ НЕ Строка.НеВыгружатьРозница Тогда
			ЕстьДляРозницы = Истина;
		КонецЕсли;
     КонецЦикла; 	

	 Если НЕ ЕстьДляРозницы Тогда
		Возврат рез;
	КонецЕсли;
	 
	Если СЗамерами Тогда
		фотоЗамеров = ПолучитьОбщееФотоПоНазванию(Группа.Владелец, "Замеры");
				
		Если фотоЗамеров <> Неопределено тогда
		
			НаваяСтр = Рез.Добавить();
			НаваяСтр.Главная = фотоЗамеров.Главная; 
			НаваяСтр.Наименование = НРег(фотоЗамеров.Наименование);
			НаваяСтр.Название = "Замеры";
			НаваяСтр.НеВыгружать = Ложь;
			НаваяСтр.НеВыгружатьРозница = Ложь;
			НаваяСтр.Фото = фотоЗамеров.Фото;
		КонецЕсли;
	
	КонецЕсли;
	
	Если СВидео Тогда

		видео = ПолучитьОбщееФотоПоНазванию(Группа.Владелец, "Видео");

		Если видео <> Неопределено тогда
		
			НаваяСтр = Рез.Добавить();
			НаваяСтр.Главная = видео.Главная; 
			НаваяСтр.Наименование = НРег(видео.Наименование);
			НаваяСтр.НеВыгружать = Ложь;
			НаваяСтр.НеВыгружатьРозница = Ложь;			
			НаваяСтр.Название = "Video"; 
			НаваяСтр.Фото = видео.Фото;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Рез
	
КонецФункции

функция ПолучитьОбщееФотоПоНазванию(Номенклатура, Название) Экспорт
			
	Запрос1 = Новый Запрос;
	Запрос1.Текст = "ВЫБРАТЬ
	                |	ГруппаЦветов.Фотографии.(
	                |		Главная КАК Главная,
	                |		НеВыгружать КАК НеВыгружать,
	                |		Наименование КАК Наименование,
	                |		Фото КАК Фото,
	                |		НеВыгружатьРозница КАК НеВыгружатьРозница
	                |	) КАК Фотографии
	                |ИЗ
	                |	Справочник.ГруппаЦветов КАК ГруппаЦветов
	                |ГДЕ
	                |	ГруппаЦветов.Владелец = &Владелец
	                |	И ГруппаЦветов.Наименование = &Наименование";
	
	Запрос1.УстановитьПараметр("Наименование",Название);
	Запрос1.УстановитьПараметр("Владелец",Номенклатура);
	Рез1 = Запрос1.Выполнить().Выгрузить();
	
	Если Рез1.Количество() тогда
		Возврат Рез1[0][0][0];
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

