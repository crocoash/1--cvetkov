	                |	СУММА(ВТОбщ3.ЦенаСп) КАК ЦенаСп,
	                |	СРЕДНЕЕ(ВТОбщ3.СкидкаРостовка) КАК СкидкаРостовка,
	                |	МАКСИМУМ(ВТОбщ3.НужноРасчитатьСкидку) КАК НужноРасчитатьСкидку,
	                |	СРЕДНЕЕ(ВТОбщ3.СкидкаХарактеристики) КАК СкидкаХарактеристики,
	                |	СРЕДНЕЕ(ВТОбщ3.УточняющийПроцент) КАК УточняющийПроцент,
	                |	СУММА(ОКР(ВТОбщ3.ЦенаОпт)) КАК ЦенаОпт,
	                |	СУММА(ОКР(ВТОбщ3.ЦенаРозница / ВТОбщ3.ТипЦеныРозница.ПорядокОкругления.Порядок, 0) * ВТОбщ3.ТипЦеныРозница.ПорядокОкругления.Порядок) КАК ЦенаРозница,
	                |	СУММА(ВТОбщ3.НаценкаРозница) КАК НаценкаРозница,
	                |	СРЕДНЕЕ(ВТОбщ3.НаценкаРозницаСУточняющим) КАК НаценкаРозницаСУточняющим,
	                |	СУММА(ВТОбщ3.РозницаКонечнаяДляРасчетов) КАК РозницаКонечнаяДляРасчетов,
	                |	СРЕДНЕЕ(ВТОбщ3.СкидкаРозница) КАК СкидкаРозница,
	                |	СУММА(ОКР(ВТОбщ3.ЦенаРозница * (1 - ВТОбщ3.СкидкаРозница / 100) / ВТОбщ3.ТипЦеныРозница.ПорядокОкругления.Порядок, 0) * ВТОбщ3.ТипЦеныРозница.ПорядокОкругления.Порядок) КАК Проверка
	                |ИЗ
	                |	ВТОбщ3 КАК ВТОбщ3
	                |
	                |СГРУППИРОВАТЬ ПО
	                |	ВТОбщ3.фотоЗамеров,
	                |	ВТОбщ3.Ткань,
	                |	ВТОбщ3.Ростовка,
	                |	ВТОбщ3.Штрихкод,
	                |	ВТОбщ3.ЭтоНаборКомплектРучной,
	                |	ВТОбщ3.Фото,
	                |	ВТОбщ3.Цвет,
	                |	ВТОбщ3.Номенклатура,
	                |	ВТОбщ3.Характеристика,
	                |	ВТОбщ3.Группа
	                |
	                |УПОРЯДОЧИТЬ ПО
	                |	Номенклатура,
	                |	ВТОбщ3.Характеристика.Наименование";
	
	
	Возврат Запрос.Выполнить().Выбрать();	
		
КонецФункции

функция ПолучитьТаблицуНк(Номенкл,ВыбХарактеристика, ВариантВыгрузки, ВыгружатьБезЦен = Истина, ВыгружатьБезФото = Ложь) Экспорт
	
	МассивНоменклатуры = Новый Массив;
	Если ЗначениеЗаполнено(Номенкл) И Номенкл <> Тип("Массив") Тогда
	   		МассивНоменклатуры.Добавить(Номенкл);
	КонецЕсли;
   		
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("ТекущаяДата"         , ТекущаяДата());
	Запрос.УстановитьПараметр("ВыгружатьБезЦен"     , ВыгружатьБезЦен);
	Запрос.УстановитьПараметр("выгружатьБезФото"    , ВыгружатьБезФото);
	Запрос.УстановитьПараметр("МассивНоменклатура"  , МассивНоменклатуры);
	Запрос.УстановитьПараметр("МассивНоменклатурыПустой"  , (МассивНоменклатуры.Количество() = 0));
	Запрос.УстановитьПараметр("ВидВыгрузки"         , ВариантВыгрузки);

	
	Запрос.Текст = "ВЫБРАТЬ
	               |	Склады.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТСкладыОпт
	               |ИЗ
	               |	Справочник.Склады КАК Склады
	               |ГДЕ
	               |	Склады.Активный
	               |	И НЕ Склады.Розница
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СкидкиНаценкиНоменклатурыСрезПоследних.ПроцентСкидкиНаценки КАК ПроцентСкидкиНаценки,
	               |	СкидкиНаценкиНоменклатурыСрезПоследних.Регистратор КАК Регистратор,
	               |	СкидкиНаценкиНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |	СкидкиНаценкиНоменклатурыСрезПоследних.ДатаОкончания КАК ДатаОкончания
	               |ПОМЕСТИТЬ ВТСкидки
	               |ИЗ
	               |	РегистрСведений.СкидкиНаценкиНоменклатуры.СрезПоследних(
	               |			&ТекущаяДата,
	               |			ДатаОкончания >= &ТекущаяДата
	               |				ИЛИ ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	               |					И Регистратор.ДляВсехПолучателей
	               |					И Регистратор.ВидСкидки = ЗНАЧЕНИЕ(Перечисление.ВидыСкидок.Оптовая)) КАК СкидкиНаценкиНоменклатурыСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Склады.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТСкладыРозн
	               |ИЗ
	               |	Справочник.Склады КАК Склады
	               |ГДЕ
	               |	Склады.Активный
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
	               |	ВЫБОР
	               |		КОГДА основная.Ссылка ЕСТЬ NULL
	               |			ТОГДА неосновная.Ссылка
	               |		ИНАЧЕ основная.Ссылка
	               |	КОНЕЦ КАК Ростовка,
	               |	ХарактеристикиНоменклатуры.Владелец КАК Владелец
	               |ПОМЕСТИТЬ ВТРостовка
	               |ИЗ
	               |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МАКСИМУМ(ГруппыХарактеристикХарактеристики.Ссылка) КАК Ссылка,
	               |			ГруппыХарактеристикХарактеристики.Характеристика КАК Характеристика
	               |		ИЗ
	               |			Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
	               |		ГДЕ
	               |			ГруппыХарактеристикХарактеристики.Ссылка.НеОсновная
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ГруппыХарактеристикХарактеристики.Характеристика) КАК неосновная
	               |		ПО ХарактеристикиНоменклатуры.Ссылка = неосновная.Характеристика
	               |		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МАКСИМУМ(ГруппыХарактеристикХарактеристики.Ссылка) КАК Ссылка,
	               |			ГруппыХарактеристикХарактеристики.Характеристика КАК Характеристика
	               |		ИЗ
	               |			Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
	               |		ГДЕ
	               |			НЕ ГруппыХарактеристикХарактеристики.Ссылка.НеОсновная
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ГруппыХарактеристикХарактеристики.Характеристика) КАК основная
	               |		ПО ХарактеристикиНоменклатуры.Ссылка = основная.Характеристика
	               |ГДЕ
	               |	ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры.Код В (""000000010"", ""000000001"")
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ХарактеристикиНоменклатуры.Владелец КАК Владелец,
	               |	МАКСИМУМ(ПолучимОстаткиПоНоменклатуре.РостовкаИгнорироватьНоль) КАК РостовкаИгнорироватьНоль,
	               |	СУММА(ПолучимОстаткиПоНоменклатуре.вРезерве) КАК вРезерве,
	               |	СУММА(ПолучимОстаткиПоНоменклатуре.Остаток) КАК Остаток
	               |ПОМЕСТИТЬ ВТноменклатура
	               |ИЗ
	               |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ВЫБОР
	               |				КОГДА КомплектующиеНоменклатуры.ХарактеристикаКомплектующей ЕСТЬ NULL
	               |					ТОГДА ХарактеристикиНоменклатуры.Ссылка
	               |				ИНАЧЕ КомплектующиеНоменклатуры.ХарактеристикаКомплектующей
	               |			КОНЕЦ КАК ХарактеристикаВыход,
	               |			ХарактеристикиНоменклатуры.Ссылка КАК характеристика
	               |		ИЗ
	               |			Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |				ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
	               |				ПО ХарактеристикиНоменклатуры.Ссылка = КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры) КАК ПолучимХарактеристикуДляОстатков
	               |			ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				ВТРостовка.Ростовка.ИгнорироватьНоль КАК РостовкаИгнорироватьНоль,
	               |				ЕСТЬNULL(ПолучимВРезерве.КоличествоОстаток, 0) КАК вРезерве,
	               |				ЕСТЬNULL(получимОстаток.КоличествоОстаток, 0) КАК Остаток,
	               |				ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
	               |			ИЗ
	               |				Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |					ПОЛНОЕ СОЕДИНЕНИЕ ВТРостовка КАК ВТРостовка
	               |					ПО ХарактеристикиНоменклатуры.Ссылка = ВТРостовка.Характеристика
	               |					ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |						ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |						ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	               |					ИЗ
	               |						РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки КАК ТоварыВРезервеНаСкладахОстатки
	               |					ГДЕ
	               |						ТоварыВРезервеНаСкладахОстатки.Склад.Активный) КАК ПолучимВРезерве
	               |					ПО ХарактеристикиНоменклатуры.Ссылка = ПолучимВРезерве.ХарактеристикаНоменклатуры
	               |					ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |						ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	               |						ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	               |					ИЗ
	               |						РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
	               |					ГДЕ
	               |						ТоварыНаСкладахОстатки.Склад.Активный) КАК получимОстаток
	               |					ПО ХарактеристикиНоменклатуры.Ссылка = получимОстаток.ХарактеристикаНоменклатуры) КАК ПолучимОстаткиПоНоменклатуре
	               |			ПО ПолучимХарактеристикуДляОстатков.ХарактеристикаВыход = ПолучимОстаткиПоНоменклатуре.Характеристика
	               |		ПО ХарактеристикиНоменклатуры.Ссылка = ПолучимХарактеристикуДляОстатков.характеристика
	               |ГДЕ
	               |	ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры.Код В (""000000001"", ""000000010"")
	               |	И НЕ ХарактеристикиНоменклатуры.Владелец.НеВыгружатьНаРозетку
	               |	И (ПолучимОстаткиПоНоменклатуре.вРезерве <> 0
	               |			ИЛИ ПолучимОстаткиПоНоменклатуре.Остаток <> 0
	               |			ИЛИ ПолучимОстаткиПоНоменклатуре.РостовкаИгнорироватьНоль
	               |			ИЛИ &ВидВыгрузки = ""000000003"")
	               |	И (ХарактеристикиНоменклатуры.Владелец В (&МассивНоменклатура)
	               |			ИЛИ &МассивНоменклатурыПустой)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ХарактеристикиНоменклатуры.Владелец
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
