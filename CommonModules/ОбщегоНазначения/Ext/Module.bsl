Функция РезервНоменклатуры(Номенклатура,Склад=Неопределено,Характеристика=Неопределено,НаДату,ДокументРезерва=Неопределено,  МасИсклЗак =Неопределено)Экспорт 
	Запрос = Новый Запрос;  
	
	Если Номенклатура.ВидНоменклатуры.Код = "000000010" Тогда
		
		Запрос.Текст = ПолучитьЗапросДляНаборКомплект(); 
		
	иначе 
		Запрос.Текст = "ВЫБРАТЬ
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстатокРезерва
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
		|			&НаДату,
		|			Номенклатура = &Номенклатура
		|				И (ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		|					ИЛИ &ХарактеристикаНоменклатурыВыбрана)
		|				И (Склад В (&Склад)
		|					ИЛИ &СкладнеВыбран)
		|				И ДокументРезерва <> &ДокументРезерва
		|				И НЕ ДокументРезерва В (&МасИскл)) КАК ТоварыВРезервеНаСкладахОстатки";
		
		
		
	КонецЕсли;
	
	
	Запрос.УстановитьПараметр("НаДату",НаДату);
	Запрос.УстановитьПараметр("Номенклатура",Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",Характеристика);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатурыВыбрана",СокрЛП(Характеристика)="<без характеристики>");
	Запрос.УстановитьПараметр("Склад",Склад);
	Запрос.УстановитьПараметр("СкладнеВыбран",Склад.Количество()=0);
	
	Запрос.УстановитьПараметр("ДокументРезерва",ДокументРезерва);
	Запрос.УстановитьПараметр("МасИскл",МасИсклЗак);
	
	Рез = Запрос.Выполнить().Выгрузить();
	Возврат Рез.Итог("КоличествоОстатокРезерва");
КонецФункции

