	               |			ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				ВЫБОР
	               |					КОГДА ЕСТЬNULL(НайдемПроцентРодителя.Период, ДАТАВРЕМЯ(1, 1, 1)) >= ЕСТЬNULL(ПолучимПроцентНоменклатурыПоЦвету.Период, ДАТАВРЕМЯ(1, 1, 1))
	               |							И ЕСТЬNULL(НайдемПроцентРодителя.Период, ДАТАВРЕМЯ(1, 1, 1)) >= ЕСТЬNULL(ПолучимПроцентНоменклатурыБезЦвета.Период, ДАТАВРЕМЯ(1, 1, 1))
	               |						ТОГДА НайдемПроцентРодителя.УточняющийПроцент
	               |					КОГДА ЕСТЬNULL(ПолучимПроцентНоменклатурыПоЦвету.Период, ДАТАВРЕМЯ(1, 1, 1)) >= ЕСТЬNULL(ПолучимПроцентНоменклатурыБезЦвета.Период, ДАТАВРЕМЯ(1, 1, 1))
	               |						ТОГДА ПолучимПроцентНоменклатурыПоЦвету.УточняющийПроцент
	               |					ИНАЧЕ ПолучимПроцентНоменклатурыБезЦвета.УточняющийПроцент
	               |				КОНЕЦ КАК Процент,
	               |				ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
	               |			ИЗ
	               |				Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |					ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |						ВЫБОР
	               |							КОГДА НЕ цветСтар.Значение ЕСТЬ NULL
	               |								ТОГДА цветСтар.Значение
	               |							ИНАЧЕ ЦветПредопределенный.Значение
	               |						КОНЕЦ КАК Цвет,
	               |						ХарактеристикиНоменклатуры.Ссылка КАК Характеристика
	               |					ИЗ
	               |						(ВЫБРАТЬ
	               |							ЗначенияСвойствОбъектов.Значение КАК Значение,
	               |							ЗначенияСвойствОбъектов.Объект КАК Объект
	               |						ИЗ
	               |							РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	               |						ГДЕ
	               |							ЗначенияСвойствОбъектов.Свойство.Код = ""000000069"") КАК ЦветПредопределенный
	               |							ПОЛНОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |								ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |									ЗначенияСвойствОбъектов.Значение КАК Значение,
	               |									ЗначенияСвойствОбъектов.Объект КАК Объект
	               |								ИЗ
	               |									РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	               |								ГДЕ
	               |									ЗначенияСвойствОбъектов.Свойство.Код = ""000000072"") КАК цветСтар
	               |								ПО (цветСтар.Объект = ХарактеристикиНоменклатуры.Ссылка)
	               |							ПО ЦветПредопределенный.Объект = ХарактеристикиНоменклатуры.Ссылка) КАК ПолучимЦвет
	               |						ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.УточнениеРасчетаЦенПоНоменклатуре.СрезПоследних(
	               |								&текущаяДата,
	               |								НоменклатураИлиГруппа В
	               |										(ВЫБРАТЬ
	               |											Номенклатура.Ссылка КАК Номенклатура
	               |										ИЗ
	               |											Справочник.Номенклатура КАК Номенклатура)
	               |									И Цвет <> ЗНАЧЕНИЕ(Справочник.АСБ_ЦветаНоменклатуры.ПустаяСсылка)
	               |									И Период <= &ТекущаяДата) КАК ПолучимПроцентНоменклатурыПоЦвету
	               |						ПО ПолучимЦвет.Цвет = ПолучимПроцентНоменклатурыПоЦвету.Цвет
	               |							И ПолучимЦвет.Характеристика.Владелец = ПолучимПроцентНоменклатурыПоЦвету.НоменклатураИлиГруппа
	               |					ПО ХарактеристикиНоменклатуры.Ссылка = ПолучимЦвет.Характеристика
	               |					ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.УточнениеРасчетаЦенПоНоменклатуре.СрезПоследних(
	               |							&текущаяДата,
	               |							НоменклатураИлиГруппа В
	               |									(ВЫБРАТЬ
	               |										Номенклатура.Ссылка КАК Номенклатура
	               |									ИЗ
	               |										Справочник.Номенклатура КАК Номенклатура)
	               |								И Цвет = ЗНАЧЕНИЕ(Справочник.АСБ_ЦветаНоменклатуры.ПустаяСсылка)
	               |								И Период <= &ТекущаяДата) КАК ПолучимПроцентНоменклатурыБезЦвета
	               |					ПО ХарактеристикиНоменклатуры.Владелец = ПолучимПроцентНоменклатурыБезЦвета.НоменклатураИлиГруппа
	               |					ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.УточнениеРасчетаЦенПоНоменклатуре.СрезПоследних(
	               |							&текущаяДата,
	               |							НоменклатураИлиГруппа В
	               |									(ВЫБРАТЬ
	               |										Номенклатура.Родитель КАК Родитель
	               |									ИЗ
	               |										Справочник.Номенклатура КАК Номенклатура)
	               |								И Цвет = ЗНАЧЕНИЕ(Справочник.АСБ_ЦветаНоменклатуры.ПустаяСсылка)
	               |								И Период <= &ТекущаяДата) КАК НайдемПроцентРодителя
	               |					ПО ХарактеристикиНоменклатуры.Владелец.Родитель = НайдемПроцентРодителя.НоменклатураИлиГруппа) КАК ПолучимУточняющийПроцент
	               |			ПО ПолучимХарактеристикуДляОстатков.ХарактеристикаВыход = ПолучимУточняющийПроцент.Характеристика
	               |			ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры КАК Характеристика,
	               |				СУММА(ЦеныНоменклатурыСрезПоследних.Цена) КАК Цена
	               |			ИЗ
	               |				РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&текущаяДата, ) КАК ЦеныНоменклатурыСрезПоследних
	               |					ПОЛНОЕ СОЕДИНЕНИЕ Справочник.ТипыЦенНоменклатуры КАК ТипыЦенНоменклатуры
	               |					ПО ЦеныНоменклатурыСрезПоследних.ТипЦен = ТипыЦенНоменклатуры.Ссылка
	               |			ГДЕ
	               |				ТипыЦенНоменклатуры.Код = ""000000001""
	               |			
	               |			СГРУППИРОВАТЬ ПО
	               |				ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры) КАК ПолучимОптовуюЦену
	               |			ПО ПолучимХарактеристикуДляОстатков.ХарактеристикаВыход = ПолучимОптовуюЦену.Характеристика
	               |			ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				ЦеныНоменклатурыСрезПоследних.ХарактеристикаНоменклатуры КАК Характеристика,
	               |				ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	               |			ИЗ
	               |				РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&текущаяДата, ) КАК ЦеныНоменклатурыСрезПоследних
	               |					ПОЛНОЕ СОЕДИНЕНИЕ Справочник.ТипыЦенНоменклатуры КАК ТипыЦенНоменклатуры
	               |					ПО ЦеныНоменклатурыСрезПоследних.ТипЦен = ТипыЦенНоменклатуры.Ссылка
	               |			ГДЕ
	               |				ТипыЦенНоменклатуры.Код = ""000000020"") КАК ПолучимЦенуСтатическуюРозница
	               |			ПО ПолучимХарактеристикуДляОстатков.характеристика = ПолучимЦенуСтатическуюРозница.Характеристика
	               |		ПО (ПолучимХарактеристикуДляОстатков.ХарактеристикаВыход = ПолучимОстаткиОпт.Характеристика)
	               |ГДЕ
	               |	ХарактеристикиНоменклатуры.Владелец В (ВТноменклатура.Владелец)
	               |	И (&ВыгружатьБезЦен
	               |			ИЛИ НЕ ПолучимОптовуюЦену.Цена ЕСТЬ NULL)
	               |
	               |ДЛЯ ИЗМЕНЕНИЯ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТОбщ.Группа КАК Группа,
	               |	ВТОбщ.Номенклатура КАК Номенклатура,
	               |	ВТОбщ.ХарактеристикаНк КАК ХарактеристикаНк,
	               |	ВТОбщ.Ростовка КАК Ростовка,
	               |	ВТОбщ.ДоступныйОстатокОпт КАК ДоступныйОстатокОпт,
	               |	ВТОбщ.СкидкаРостовка КАК СкидкаРостовка,
	               |	ВТОбщ.ДатаОкончанияСкидки КАК ДатаОкончанияСкидки,
	               |	ВТОбщ.ЦенаОпт КАК ЦенаОпт,
	               |	ВТОбщ.ПредзаказОпт КАК ПредзаказОпт,
	               |	ВТОбщ.Цвет КАК Цвет,
	               |	ВТОбщ.ОстатокВЦвете КАК ОстатокВЦвете
	               |ПОМЕСТИТЬ ВТОбщ1
	               |ИЗ
	               |	ВТОбщ КАК ВТОбщ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТОбщ1.Группа КАК Группа,
	               |	ВТОбщ1.Номенклатура КАК Номенклатура,
	               |	ВТОбщ1.ХарактеристикаНк КАК ХарактеристикаНк,
	               |	ВТОбщ1.Ростовка КАК Ростовка,
	               |	МИНИМУМ(ВТОбщ1.ДоступныйОстатокОпт) КАК ДоступныйОстатокОпт,
	               |	МИНИМУМ(ВТОбщ1.СкидкаРостовка) КАК СкидкаРостовка,
	               |	ВТОбщ1.ДатаОкончанияСкидки КАК ДатаОкончанияСкидки,
	               |	СУММА(ВТОбщ1.ЦенаОпт) КАК ЦенаОпт,
	               |	МИНИМУМ(ВТОбщ1.ПредзаказОпт) КАК Предзаказ,
	               |	МИНИМУМ(ВЫБОР
	               |			КОГДА ВТОбщ1.ДоступныйОстатокОпт > 0
	               |				ТОГДА ""true""
	               |			ИНАЧЕ ""false""
	               |		КОНЕЦ) КАК available,
	               |	ВТОбщ1.ХарактеристикаНк.Владелец КАК Нк,
	               |	ВТОбщ1.Цвет КАК Цвет,
	               |	МИНИМУМ(ВТОбщ1.ОстатокВЦвете) КАК ОстатокВЦвете,
	               |	МИНИМУМ(ВЫБОР
	               |			КОГДА ВТОбщ1.Ростовка.НеВыгружать
	               |				ТОГДА 1
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК Скрыта
	               |ИЗ
	               |	ВТОбщ1 КАК ВТОбщ1
	               |ГДЕ
	               |	НЕ ВТОбщ1.ХарактеристикаНк ЕСТЬ NULL
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТОбщ1.ХарактеристикаНк,
	               |	ВТОбщ1.Номенклатура,
	               |	ВТОбщ1.Группа,
	               |	ВТОбщ1.Ростовка,
	               |	ВТОбщ1.ДатаОкончанияСкидки,
	               |	ВТОбщ1.Цвет,
	               |	ВТОбщ1.ХарактеристикаНк.Владелец
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВТОбщ1.ХарактеристикаНк.Наименование";
	
	 Возврат Запрос.Выполнить().Выгрузить();	
	
КонецФункции 

функция ПолучитьОстаткиКВыгрузке(Номенкл, ГруппаСклада = Неопределено, ВГруппеНоменклатур = Неопределено, ИмяРеквизитаОтбора = "", ТолькоСНаличием = Истина, ХарактеритсикаВыбранная = Неопределено) Экспорт	
	
	Если ЗначениеЗаполнено(Номенкл) И Номенкл <> Тип("Массив") Тогда
        Номенклатура = Новый Массив;
		Номенклатура.Добавить(Номенкл);
	Иначе 
		Номенклатура = Номенкл;
    КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КомплектующиеНоменклатуры.Номенклатура КАК Номенклатура,
		|	КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	КомплектующиеНоменклатуры.Комплектующая КАК Комплектующая,
		|	КомплектующиеНоменклатуры.ХарактеристикаКомплектующей КАК ХарактеристикаКомплектующей,
		|	СУММА(КомплектующиеНоменклатуры.Количество) КАК Количество
		|ПОМЕСТИТЬ ВТКомплектующие
		|ИЗ
		|	РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
		|ГДЕ
		|	КомплектующиеНоменклатуры.Номенклатура.ВидНоменклатуры.Наименование = ""набор комплект ручной""
		|	И (КомплектующиеНоменклатуры.Номенклатура В (&Номенклатура)
		|			ИЛИ &НоменклатураВыбрана)
		|	И НЕ КомплектующиеНоменклатуры.Номенклатура.НеВыгружатьНаРозетку
		|	И (КомплектующиеНоменклатуры.Номенклатура.Родитель В (&Родитель)
		|			ИЛИ &РодительВыбран)
		|
		|СГРУППИРОВАТЬ ПО
		|	КомплектующиеНоменклатуры.Комплектующая,
		|	КомплектующиеНоменклатуры.ХарактеристикаКомплектующей,
		|	КомплектующиеНоменклатуры.Номенклатура,
		|	КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Комплектующая,
		|	ХарактеристикаКомплектующей
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТКомплектующие.Номенклатура КАК Номенклатура,
		|	ВТКомплектующие.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	ВТКомплектующие.Комплектующая КАК Комплектующая,
		|	ВТКомплектующие.ХарактеристикаКомплектующей КАК ХарактеристикаКомплектующей,
		|	ВТКомплектующие.Количество КАК Количество
		|ИЗ
		|	ВТКомплектующие КАК ВТКомплектующие
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыНаСкладахОстатки.Номенклатура.Родитель.Родитель КАК Группа,
		|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры КАК Характеристика,
		|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) КАК Остаток,
		|	ЛОЖЬ КАК ЭтоНаборКомплектРучной
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			,
		|			Склад В (&МассивСкладов)
		|				И (Номенклатура В (&Номенклатура)
		|					ИЛИ &НоменклатураВыбрана)
		|				И (Номенклатура.Родитель В (&Родитель)
		|					ИЛИ &РодительВыбран)
		|				И НЕ Номенклатура.НеВыгружатьНаРозетку) КАК ТоварыНаСкладахОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад В (&МассивСкладов)) КАК ТоварыВРезервеНаСкладахОстатки
		|		ПО ТоварыНаСкладахОстатки.Номенклатура = ТоварыВРезервеНаСкладахОстатки.Номенклатура
		|			И ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
		|ГДЕ
		|	ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0) > 0
		|	И (ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		|			ИЛИ НЕ &ХарактеристикаВыбрана)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВТКомплектующие.Номенклатура.Родитель.Родитель,
		|	ВТКомплектующие.Номенклатура,
		|	ВТКомплектующие.ХарактеристикаНоменклатуры,
		|	МИНИМУМ(ВЫБОР
		|			КОГДА ВТКомплектующие.Количество > 0
		|					И (ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)) / ВТКомплектующие.Количество > 0.5
		|				ТОГДА ВЫРАЗИТЬ((ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)) / ВТКомплектующие.Количество - 0.5 КАК ЧИСЛО(15, 0))
		|			ИНАЧЕ 0
		|		КОНЕЦ),
		|	ИСТИНА
		|ИЗ
		|	ВТКомплектующие КАК ВТКомплектующие
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(, Склад В (&МассивСкладов)) КАК ТоварыНаСкладахОстатки
		|		ПО ВТКомплектующие.Комплектующая = ТоварыНаСкладахОстатки.Номенклатура
		|			И ВТКомплектующие.ХарактеристикаКомплектующей = ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, Склад В (&МассивСкладов)) КАК ТоварыВРезервеНаСкладахОстатки
		|		ПО ВТКомплектующие.Комплектующая = ТоварыВРезервеНаСкладахОстатки.Номенклатура
		|			И ВТКомплектующие.ХарактеристикаКомплектующей = ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТКомплектующие.Номенклатура.Родитель.Родитель,
		|	ВТКомплектующие.Номенклатура,
		|	ВТКомплектующие.ХарактеристикаНоменклатуры
		|
		|ИМЕЮЩИЕ
		|	МИНИМУМ(ВЫБОР
		|			КОГДА ВТКомплектующие.Количество > 0
		|					И (ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)) / ВТКомплектующие.Количество > 0.5
		|				ТОГДА ВЫРАЗИТЬ((ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток, 0)) / ВТКомплектующие.Количество - 0.5 КАК ЧИСЛО(15, 0))
		|			ИНАЧЕ 0
		|		КОНЕЦ) > 0";
	
	Если ГруппаСклада <> Неопределено Тогда
		МассивСкладовПоГруппе = Справочники.Склады.ПолучитьМассивСкладов(ГруппаСклада);
	Иначе
		МассивСкладовПоГруппе = Справочники.Склады.ПолучитьСкладыМаркетПлейс();
	КонецЕсли;
	
	Запрос.УстановитьПараметр("МассивСкладов", МассивСкладовПоГруппе);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("НоменклатураВыбрана", Не ЗначениеЗаполнено(Номенклатура));
	
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", ХарактеритсикаВыбранная);
	Запрос.УстановитьПараметр("ХарактеристикаВыбрана", ЗначениеЗаполнено(ХарактеритсикаВыбранная));
		
	Запрос.УстановитьПараметр("Родитель"                         , ВГруппеНоменклатур);
	Запрос.УстановитьПараметр("РодительВыбран"                   , Не ЗначениеЗаполнено(ВГруппеНоменклатур));

	Если ЗначениеЗаполнено(ИмяРеквизитаОтбора) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НЕ КомплектующиеНоменклатуры.Номенклатура.НеВыгружатьНаРозетку", 
		"И КомплектующиеНоменклатуры.Номенклатура." + ИмяРеквизитаОтбора);
	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И НЕ Номенклатура.НеВыгружатьНаРозетку", 
		"И Номенклатура." + ИмяРеквизитаОтбора);
	КонецЕсли;	
	
	Запрос1 = Новый Запрос; 
	Запрос1.УстановитьПараметр("Номенклатура", Номенклатура);
	
	Запрос1.Текст = 
	    "ВЫБРАТЬ
	    |	ХарактеристикиНоменклатуры.Владелец.Родитель КАК Группа,
	    |	ХарактеристикиНоменклатуры.Владелец КАК Номенклатура,
	    |	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
	    |	1 КАК Остаток,
	    |	ЛОЖЬ КАК ЭтоНаборКомплектРучной
	    |ИЗ
	    |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	    |ГДЕ
	    |	(&Номенклатура ЕСТЬ NULL
	    |			ИЛИ ХарактеристикиНоменклатуры.Владелец В (&Номенклатура))
	    |	И НЕ ХарактеристикиНоменклатуры.Владелец.НеВыгружатьНаРозетку
	    |	И ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры.Код = ""000000001""";

	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	Комплектующие = РезультатыЗапроса[1].Выгрузить();
		
	Если ТолькоСНаличием Тогда
		Остатки = РезультатыЗапроса[2].Выгрузить();
	Иначе
		Остатки = Запрос1.Выполнить().Выгрузить();
	КонецЕсли;

	Если ГруппаСклада <> Неопределено Тогда
		Запрос3 = Новый Запрос;
		Запрос3.Текст = 
		    "ВЫБРАТЬ РАЗЛИЧНЫЕ
		    |	ГруппыХарактеристикХарактеристики.Ссылка.Владелец.Ссылка КАК Владелец,
		    |	1 КАК Остаток,
		    |	ЛОЖЬ КАК ЭтоНаборКомплектРучной,
		    |	ГруппыХарактеристикХарактеристики.Ссылка.Владелец.Родитель КАК Группа,
		    |	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
		    |	ГруппыХарактеристикХарактеристики.Ссылка КАК Ссылка,
		    |	ГруппыХарактеристикХарактеристики.Ссылка.ИгнорироватьНоль КАК ИгнорироватьНоль
		    |ИЗ
		    |	Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
		    |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		    |		ПО ГруппыХарактеристикХарактеристики.Характеристика.Ссылка = ХарактеристикиНоменклатуры.Ссылка
		    |ГДЕ
		    |	ГруппыХарактеристикХарактеристики.Ссылка.ИгнорироватьНоль
		    |	И НЕ ГруппыХарактеристикХарактеристики.Ссылка.Владелец.НеВыгружатьНаРозетку
		    |	И ИСТИНА
		    |	И (ГруппыХарактеристикХарактеристики.Ссылка.Владелец В (&Номенклатура)
		    |			ИЛИ НЕ &НоменклатураВыбрана)
		    |	И НЕ ГруппыХарактеристикХарактеристики.Ссылка.НеОсновная";


			Запрос3.УстановитьПараметр("Номенклатура", Номенклатура);
			Запрос3.УстановитьПараметр("НоменклатураВыбрана", ЗначениеЗаполнено(Номенклатура));

			Результат3 = Запрос3.Выполнить().Выгрузить();

		// Добавляем данные из запроса в таблицу Остатки
		Для Каждого Строка Из Результат3 Цикл
		    НоваяСтрока = Остатки.Добавить();
		    НоваяСтрока.Группа = Строка.Группа;
		    НоваяСтрока.Номенклатура = Строка.Владелец;
		    НоваяСтрока.Остаток = Строка.Остаток;
		    НоваяСтрока.Характеристика = Строка.Характеристика;
		    НоваяСтрока.ЭтоНаборКомплектРучной = Ложь;
		КонецЦикла;
	КонецЕсли;
	
	Остатки.Сортировать("Номенклатура, Характеристика, Группа");
		
	Возврат (Новый Структура("Комплектующие,Остатки",Комплектующие,Остатки));	
	
конецФункции

функция ПолучитьТаблицуХарактеристикДляВыгрузки(Остатки, ТипЦены, Категория, ПроверятьРазбитиеРостовок, ВариантВыгрузки, ГруппаСклада = Неопределено, ВыгружатьБезФото = Ложь, Наценка = Неопределено, ТолькоСНаличием = Истина, Контрагент = НеОпределено, Договор = Неопределено, НеВыгружатьБезЦен = Истина) Экспорт
	
	ВариантВыгрузкиТолькоНаличие     = (Справочники.ВариантыВыгрузкиХарактеристик.НайтиПоКоду("000000001") = ВариантВыгрузки);
	ВариантВыгрузкиВсеПоЦвету        = (Справочники.ВариантыВыгрузкиХарактеристик.НайтиПоКоду("000000002") = ВариантВыгрузки);
	ВариантВыгрузкиВсеПоНоменклатуре = (Справочники.ВариантыВыгрузкиХарактеристик.НайтиПоКоду("000000003") = ВариантВыгрузки);
	
	ИнформацияОВыгрузке = Новый Структура;
	ИнформацияОВыгрузке.Вставить("ГруппаСклада", ГруппаСклада);
	ИнформацияОВыгрузке.Вставить("ТипЦены", ТипЦены);
	ИнформацияОВыгрузке.Вставить("ПроверятьРазбитиеРостовок", ПроверятьРазбитиеРостовок);
	ИнформацияОВыгрузке.Вставить("ВыгружатьБезФото",ВыгружатьБезФото);
	ИнформацияОВыгрузке.Вставить("Категория",Категория);
	ИнформацияОВыгрузке.Вставить("Наценка",Наценка);
	ИнформацияОВыгрузке.Вставить("Контрагент",Контрагент);
	ИнформацияОВыгрузке.Вставить("Договор",Договор);
	ИнформацияОВыгрузке.Вставить("НеВыгружатьБезЦен",НеВыгружатьБезЦен);
	
	ТЗНоменклатуры = Новый ТаблицаЗначений;
	ТЗНоменклатуры.Колонки.Добавить("Номенклатура");
	ТЗНоменклатуры.Колонки.Добавить("Характеристика");
	ТЗНоменклатуры.Колонки.Добавить("ГруппаЦвета");
	ТЗНоменклатуры.Колонки.Добавить("Остаток");
	ТЗНоменклатуры.Колонки.Добавить("Цена");	
	ТЗНоменклатуры.Колонки.Добавить("ПерваяЦена");
	ТЗНоменклатуры.Колонки.Добавить("Доступна");
	ТЗНоменклатуры.Колонки.Добавить("ЦветКод");
	ТЗНоменклатуры.Колонки.Добавить("ТканьКод");
	ТЗНоменклатуры.Колонки.Добавить("markup");
	ТЗНоменклатуры.Колонки.Добавить("Наценка");

	ТЗНоменклатуры.Колонки.Добавить("Предзаказ"); 
	ТЗНоменклатуры.Колонки.Добавить("Ид");
	ТЗНоменклатуры.Колонки.Добавить("ИдГуппы");
	ТЗНоменклатуры.Колонки.Добавить("ШтрихКод");
	ТЗНоменклатуры.Колонки.Добавить("Скидка");
	ТЗНоменклатуры.Колонки.Добавить("ДатаОкончанияСкидки");
	
	ТЗНоменклатуры.Колонки.Добавить("Ростовка");
	
	ТабХар = Новый ТаблицаЗначений;
	ТабХар.Колонки.Добавить("Характеристика");
	
	ПредидХарактеристика = Неопределено;
	ПредидЦвет = Неопределено;
	ПредидТкань = Неопределено;
	ПредидПодкладка = Неопределено;
	ПредидНоменклатура = Неопределено;
	
	ТаблицаОбработанныхХарактеристик = Новый ТаблицаЗначений;
	ТаблицаОбработанныхХарактеристик.Колонки.Добавить("Характеристика");
	ТаблицаОбработанныхХарактеристик.Колонки.Добавить("Цвет");
	ТаблицаОбработанныхХарактеристик.Колонки.Добавить("Номенклатура");
	
	Для Каждого Стр Из Остатки Цикл
		
			
		Характеристика = Стр.Характеристика; 
		 
		
		ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
		Номенклатура = Стр.Номенклатура; 
		Если Номенклатура.ВидНоменклатуры.Код = "000000010" Тогда
			Если ГруппаСклада = Неопределено Тогда
				МассСкладов = Справочники.Склады.ПолучитьСкладыМаркетПлейс();
			Иначе
				МассСкладов = Справочники.Склады.ПолучитьМассивСкладов(ГруппаСклада);
			КонецЕсли;
			
		    Остаток = ХарактеристикаОбъект.СвободныйОстаток(МассСкладов);

			
		иначе
			Остаток = Стр.Остаток;
		КонецЕсли;
		
		
		СпрГруппыЦветов = ОбщегоНазначения.ГруппаЦветовХарактеристики(Номенклатура, Характеристика);
		
		ПозицияВНаличии = Истина;
		Если ИнформацияОВыгрузке.ПроверятьРазбитиеРостовок и ТолькоСНаличием Тогда
			ГруппаСклада = ИнформацияОВыгрузке.ГруппаСклада;
			Остаток = ХарактеристикаОбъект.ПолучитьКоличествоКВыгрузкеСУчетомРазбитияРостовкок(,ИнформацияОВыгрузке.ГруппаСклада);
		КонецЕсли;
		МожемВыгрузить = ПроверитьЗаполненость(Характеристика, ПозицияВНаличии, Остаток, СпрГруппыЦветов, ИнформацияОВыгрузке, ТолькоСНаличием);

		Если Не МожемВыгрузить  Тогда 
			Продолжить;
		КонецЕсли; 
		
		ЦветХарактеристики = ХарактеристикаОбъект.ЦветХарактеристики();
		ТканьХарактеристики = ОбщегоНазначения.ТканьХарактеристики(Характеристика); 
		ПодкладкаХарактеристики = ОбщегоНазначения.ПодкладкаХарактеристики(Характеристика);
		
		Если ВариантВыгрузкиВсеПоЦвету Тогда
			
			Если ЗначениеЗаполнено(ПредидНоменклатура) И Номенклатура            <> ПредидНоменклатура   Или 
			     ((ЗначениеЗаполнено(ПредидЦвет)       И ПредидЦвет              <> ЦветХарактеристики ) Или  
			     (ЗначениеЗаполнено(ПредидПодкладка)   И ПодкладкаХарактеристики <> ПредидПодкладка    ) Или
			     (ЗначениеЗаполнено(ПредидТкань)       И ТканьХарактеристики     <> ПредидТкань        ))			 
			    Тогда
			     ДобавитьВТаблицуХарКиНеВНаличии(ПредидНоменклатура, ПредидЦвет, ПредидПодкладка, ПредидТкань, ТЗНоменклатуры, ТаблицаОбработанныхХарактеристик, ИнформацияОВыгрузке, ТолькоСНаличием); 	
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(ПредидНоменклатура) И Номенклатура <> ПредидНоменклатура И ВариантВыгрузкиВсеПоНоменклатуре Тогда
			 ДобавитьВТаблицуХарКиНеВНаличии(ПредидНоменклатура, "", "", "", ТЗНоменклатуры, ТаблицаОбработанныхХарактеристик, ИнформацияОВыгрузке,ТолькоСНаличием);			
		КонецЕсли;
				
		ПредидХарактеристика = Характеристика;
		ПредидЦвет           = ЦветХарактеристики;
		ПредидТкань          = ТканьХарактеристики;
		ПредидПодкладка      = ПодкладкаХарактеристики;
		ПредидНоменклатура   = Номенклатура;
			
		ДобавитьСтрокуДляВыгрузкиНоменклатуры(Характеристика, Остаток, СпрГруппыЦветов, ТЗНоменклатуры, ИнформацияОВыгрузке, ТаблицаОбработанныхХарактеристик);
	
	КонецЦикла;
	
	
	Если ЗначениеЗаполнено(ПредидХарактеристика) И ВариантВыгрузкиВсеПоЦвету Тогда
		ДобавитьВТаблицуХарКиНеВНаличии(ПредидНоменклатура, ПредидЦвет, ПредидПодкладка, ПредидТкань, ТЗНоменклатуры, ТаблицаОбработанныхХарактеристик, ИнформацияОВыгрузке, ТолькоСНаличием); 
	ИначеЕсли  ЗначениеЗаполнено(ПредидНоменклатура) И ВариантВыгрузкиВсеПоНоменклатуре Тогда
	    ДобавитьВТаблицуХарКиНеВНаличии(ПредидНоменклатура, "", "", "", ТЗНоменклатуры, ТаблицаОбработанныхХарактеристик, ИнформацияОВыгрузке, ТолькоСНаличием);	
	КонецЕсли;
	
	Возврат ТЗНоменклатуры;
	
КонецФункции

Процедура ДобавитьВТаблицуХарКиНеВНаличии(Номенклатура, Цвет, Подкладка, Ткань, ТЗНоменклатуры, ТаблицаОбработанныхХарактеристик, ИнформацияОВыгрузке, ТолькоСНаличием)
	
	ТабЦветовХарактеристик = Справочники.ХарактеристикиНоменклатуры.ПолучитьТаблицуХарактеристик(Номенклатура, Цвет, Ткань, Подкладка);
	
	Для Каждого Строка Из ТабЦветовХарактеристик Цикл
		
		Характеристика = Строка.Характеристика; ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();

		Номенклатура = Характеристика.Владелец;
		СпрГруппыЦветов = ОбщегоНазначения.ГруппаЦветовХарактеристики(Номенклатура, Характеристика);	
		
		Если ИнформацияОВыгрузке.ПроверятьРазбитиеРостовок Тогда  
			Остаток = ХарактеристикаОбъект.ПолучитьКоличествоКВыгрузкеСУчетомРазбитияРостовкок(,ИнформацияОВыгрузке.ГруппаСклада);
		Иначе
			МассивСкладов = Справочники.Склады.ПолучитьМассивСкладов(ИнформацияОВыгрузке.ГруппаСклада);
			Остаток = ХарактеристикаОбъект.СвободныйОстаток(МассивСкладов);	
		КонецЕсли;
		ПозицияВНаличии = Ложь;
		
		МожемВыгрузить = ПроверитьЗаполненость(Характеристика, ПозицияВНаличии, Остаток, СпрГруппыЦветов, ИнформацияОВыгрузке, ТолькоСНаличием);
		Если Не МожемВыгрузить Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСтрокуДляВыгрузкиНоменклатуры(Характеристика, 0, СпрГруппыЦветов, ТЗНоменклатуры, ИнформацияОВыгрузке, ТаблицаОбработанныхХарактеристик);
	
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтрокуДляВыгрузкиНоменклатуры(Характеристика, Остаток, ТабФотографий, ВТаблицу, ИнформацияОВыгрузке, ТаблицаОбработанныхХарактеристик)
	
	Номенклатура = Характеристика.Владелец;
	ПараметрыПоиска = Новый Структура("Характеристика, Номенклатура", Характеристика, Номенклатура);
	НайденаХарактеристика = ТаблицаОбработанныхХарактеристик.НайтиСтроки(ПараметрыПоиска);		

	Если НайденаХарактеристика.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	//Добавим в обработанные
	Строка = ТаблицаОбработанныхХарактеристик.Добавить();
	Строка.Характеристика = Характеристика;
	Строка.Номенклатура = Номенклатура;
	
	Номенклатура = Характеристика.Владелец;
	ХарактеристикаОбъект = Характеристика.ПолучитьОбъект(); 	
	Штрихкод = ОбщегоНазначения.ШтрихкодХарактеристики(Характеристика);
	
	ИнфоПоСкидке = ЦеноОбразование.ПолучитьОбщуюСкидку(Номенклатура, Характеристика,, ИнформацияОВыгрузке.Контрагент, ИнформацияОВыгрузке.Договор);
	Скидка = ИнфоПоСкидке.ПроцентСкидкиНаценки;   
	
	ИнфоПоСкидкеMarkup = ЦеноОбразование.ПолучитьОбщуюСкидку(Номенклатура, Характеристика, Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000014"), ИнформацияОВыгрузке.Контрагент, ИнформацияОВыгрузке.Договор);
	markup = ИнфоПоСкидкеMarkup.ПроцентСкидкиНаценки;
	
	ДатаОкончанияСкидки = ИнфоПоСкидке.ДатаОкончанияСкидки;
	
	Ид = ХарактеристикаОбъект.ИдДляВыгрузки();

	Цена = ХарактеристикаОбъект.ПолучитьЦену(ИнформацияОВыгрузке.ТипЦены);
	ПерваяЦена = ХарактеристикаОбъект.ПолучитьЦенуПервую(ИнформацияОВыгрузке.ТипЦены, ИнформацияОВыгрузке.Наценка);
	
	Если НЕ ИнформацияОВыгрузке.НеВыгружатьБезЦен Тогда
		//Сообщить("нулевая цена! "+ СокрЛП(Номенклатура)+" "+СокрЛП(Характеристика));	
		Возврат;
	КонецЕсли;
	
	Если Не (ИнформацияОВыгрузке.ВыгружатьБезФото Или ЗначениеЗаполнено(ТабФотографий)) Тогда 
		//Сообщить("нет фотографии! "+ СокрЛП(Номенклатура)+" "+СокрЛП(Характеристика));	
		Возврат;
	КонецЕсли;
	
	// Проверим уникальность ид в выгруженной таблице
	НайденаНоменклатура = ВТаблицу.НайтиСтроки(Новый Структура("ИД",Ид));
	Если НайденаНоменклатура.Количество()>1 Тогда
		//Сообщить("У характеристики дублируется код! "+ Номенклатура.Наименование+" "+ Характеристика.Наименование, СтатусСообщения.Важное);
		Возврат;
	КонецЕсли;	
	
	Ростовка = ХарактеристикаОбъект.ПолучитьРостовку(Истина);
	
	Предзаказ = Ростовка.ИгнорироватьНоль;
	
	Доступна = Не(Остаток <= 0 и Не Предзаказ); 	
				
	НоваяСтрока = ВТаблицу.Добавить();
	
	НоваяСтрока.Номенклатура   = Характеристика.Владелец;   
	НоваяСтрока.markup   = markup;

	НоваяСтрока.Характеристика = Характеристика;
	НоваяСтрока.ЦветКод        = ХарактеристикаОбъект.ПолучитьКодЦвета(); 
	НоваяСтрока.ТканьКод       = ХарактеристикаОбъект.ПолучитьКодТкани();

	
	НоваяСтрока.ГруппаЦвета    = ТабФотографий;
	НоваяСтрока.Ростовка       = Ростовка;	
	НоваяСтрока.Остаток        = Остаток;
	НоваяСтрока.Предзаказ      = Предзаказ;
	НоваяСтрока.Цена           = Цена;
	НоваяСтрока.ПерваяЦена     = ПерваяЦена;
	
	
	
	НоваяСтрока.Наценка = ЦеноОбразование.ПолучитьУточняющийПроцент(текущаяДата(), ИнформацияОВыгрузке.ТипЦены,  Номенклатура, Характеристика);

		
	НоваяСтрока.Доступна       = Доступна;
	НоваяСтрока.ШтрихКод       = Штрихкод;
	НоваяСтрока.Ид             = Ид;
	НоваяСтрока.ИдГуппы        = СтрЗаменить(ХарактеристикаОбъект.ИдГруппыПолучить(), " ", "");
	НоваяСтрока.Скидка         = Скидка;
	НоваяСтрока.ДатаОкончанияСкидки         = ДатаОкончанияСкидки;
	
КонецПроцедуры

функция ПроверитьЗаполненость(Характеристика, ПозицияВналичии, Остаток, СпрГруппыЦветов, ИнформацияОВыгрузке, ТолькоСНаличием) 
	
	ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
	Номенклатура = Характеристика.Владелец;
	
	ЕстьФотоДляВыгрузки = Ложь;
	Если ЗначениеЗаполнено(СпрГруппыЦветов) Тогда
		Для Каждого ЗаписьИзТабличнойЧасти Из СпрГруппыЦветов.Фотографии Цикл
  			Если НЕ ЗаписьИзТабличнойЧасти.НеВыгружать Тогда
       			ЕстьФотоДляВыгрузки = Истина;
        	Прервать;
    		КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	 // проверим Фотографии
	Если Не ( ЕстьФотоДляВыгрузки ИЛИ (ЗначениеЗаполнено(СпрГруппыЦветов) Или ИнформацияОВыгрузке.ВыгружатьБезФото)) Тогда
		Сообщить("Для "+СокрЛП(Номенклатура)+" "+СокрЛП(Характеристика)+" не найдено фотографий, номенклатура пропущена!");
		Возврат Ложь;
	КонецЕсли;	
			
	// Проверим Заполненость Категории
	Если НЕ ЗначениеЗаполнено(Номенклатура[ИнформацияОВыгрузке.Категория]) Тогда
		Сообщить("Для "+СокрЛП(Номенклатура)+" "+СокрЛП(Характеристика)+" не задана категория, номенклатура пропущена!");
		Возврат Ложь;
	КонецЕсли;
	
	// Проверим Ростовку на разрешение выгрузить	
	Ростовка = ХарактеристикаОбъект.ПолучитьРостовку(Истина);			
	Если Не ЗначениеЗаполнено(Ростовка) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	// Проверим 
	Если ПозицияВналичии Тогда			
		// Проверим по разбитию ростовки 
		Если ИнформацияОВыгрузке.ПроверятьРазбитиеРостовок Тогда 
			Если Не (Остаток>0 Или Ростовка.ИгнорироватьНоль) И ТолькоСНаличием Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ОбновитьВсеСчетаИДокиРезерва() Экспорт
	 Справочники.ВыставленныеСчета.ОбновитьВсеСчетаИДокиРезерва();
КонецПроцедуры

Функция ПолучитьСчетаMonobank(Знач Токен) Экспорт

	Токен = СокрЛП(Токен);

	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Не заполнен токен Monobank.";
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Token", Токен);
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить("User-Agent", "Cvetkov-1C-BankStatements");

	Соединение = Новый HTTPСоединение(
		"api.monobank.ua",
		443,
		,
		,
		,
		,
		Новый ЗащищенноеСоединениеOpenSSL);

	HTTPЗапрос = Новый HTTPЗапрос(
		"/personal/client-info",
		Заголовки);

	Попытка

		HTTPОтвет = Соединение.Получить(HTTPЗапрос);

	Исключение

		ВызватьИсключение
			"Ошибка подключения к Monobank: "
			+ ОписаниеОшибки();

	КонецПопытки;

	КодСостояния = HTTPОтвет.КодСостояния;

	Попытка
		ТекстОтвета =
			HTTPОтвет.ПолучитьТелоКакСтроку(
				КодировкаТекста.UTF8);
	Исключение
		ТекстОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	КонецПопытки;

	Если КодСостояния <> 200 Тогда

		ВызватьИсключение
			БанковскиеВыписки.ПолучитьТекстОшибкиMonobank(
				КодСостояния,
				ТекстОтвета);

	КонецЕсли;

	Возврат
		БанковскиеВыписки.ПрочитатьОтветJSONMonobank(
			ТекстОтвета);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРИЗНАК "НЕТ ЗАМЕРОВ" У НОМЕНКЛАТУРЫ
//
// Признак = Истина, если хотя бы у одной характеристики (размера) номенклатуры
// нет заполненных замеров в РегистрСведений.Замеры. Нигде не хранится, считается
// на лету: используется для подсветки строк в списке номенклатуры
// (ПриВыводеСтроки) - см. НетЗамеровУНоменклатуры().

// Рассчитывает признак "нет замеров" по номенклатуре.
// Характеристика считается замеренной, если в РегистрСведений.Замеры есть запись
// с Замер > 0 по размеру, совпадающему с одной из частей наименования характеристики
// (наименование разбирается по запятой, как в РазмерПолнота()). Замеры ищутся не только
// по самой номенклатуре, но и по цепочке реквизита НоменклатураЗаполнения: если замеры
// берутся с модели-донора, они считаются заполненными.
// Проверяется только номенклатура с заполненным свойством "Тип изделия" (код 000000037):
// именно по нему подбираются поля замеров, для остальной номенклатуры замеры не ведутся.
//
// Параметры:
//  МассивНоменклатуры - Массив, СправочникСсылка.Номенклатура - что пересчитывать,
//                       Неопределено - вся номенклатура.
//
// Возвращаемое значение:
//  Соответствие - ключ СправочникСсылка.Номенклатура, значение Булево (Истина = нет замеров).
//
Функция РассчитатьПризнакНетЗамеров(МассивНоменклатуры = Неопределено) Экспорт

	Номенклатуры = НоменклатураДляПересчетаЗамеров(МассивНоменклатуры);
	ВсяНоменклатура = (Номенклатуры.Количество() = 0);

	СвойствоТипИзделия = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду("000000037");

	Результат = Новый Соответствие;

	// 1. Номенклатура в области пересчета. По умолчанию считаем, что замеры есть.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатуры", Номенклатуры);
	Запрос.УстановитьПараметр("ВсяНоменклатура", ВсяНоменклатура);
	Запрос.УстановитьПараметр("СвойствоТипИзделия", СвойствоТипИзделия);
	Запрос.УстановитьПараметр("ТипИзделияНеНайден", НЕ ЗначениеЗаполнено(СвойствоТипИзделия));
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Номенклатура.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ТипИзделия
	               |		ПО Номенклатура.Ссылка = ТипИзделия.Объект
	               |			И ТипИзделия.Свойство = &СвойствоТипИзделия
	               |ГДЕ
	               |	НЕ Номенклатура.ЭтоГруппа
	               |	И НЕ Номенклатура.ПометкаУдаления
	               |	И (Номенклатура.Ссылка В (&Номенклатуры)
	               |			ИЛИ &ВсяНоменклатура)
	               |	И (ТипИзделия.Объект ЕСТЬ НЕ NULL
	               |			ИЛИ &ТипИзделияНеНайден)";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Ложь);
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	// 2. Откуда берутся замеры: сама номенклатура плюс цепочка моделей-доноров
	// (реквизит НоменклатураЗаполнения, поле над таблицей в форме "Замеры").
	КартаДоноров = КартаНоменклатурыЗаполнения(Номенклатуры);

	ИсточникиЗамеров = Новый Соответствие;
	НоменклатурыСДонорами = Новый Массив;

	Для Каждого КлючИЗначение Из Результат Цикл
		Источники = ЦепочкаИсточниковЗамеров(КлючИЗначение.Ключ, КартаДоноров);
		ИсточникиЗамеров.Вставить(КлючИЗначение.Ключ, Источники);
		Для Каждого Источник Из Источники Цикл
			Если НоменклатурыСДонорами.Найти(Источник) = Неопределено Тогда
				НоменклатурыСДонорами.Добавить(Источник);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// 3. Размеры, по которым замеры уже заполнены.
	РазмерыСЗамерами = РазмерыСЗамерамиПоИсточникам(НоменклатурыСДонорами, ВсяНоменклатура);

	// 4. Характеристики: у каждой должен быть замер хотя бы по одной части наименования.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатуры", Номенклатуры);
	Запрос.УстановитьПараметр("ВсяНоменклатура", ВсяНоменклатура);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Характеристики.Владелец КАК Номенклатура,
	               |	Характеристики.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.ХарактеристикиНоменклатуры КАК Характеристики
	               |ГДЕ
	               |	НЕ Характеристики.ПометкаУдаления
	               |	И (Характеристики.Владелец В (&Номенклатуры)
	               |			ИЛИ &ВсяНоменклатура)";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если Результат.Получить(Выборка.Номенклатура) <> Ложь Тогда
			// номенклатуры нет в области пересчета либо признак уже взведен
			Продолжить;
		КонецЕсли;

		Источники = ИсточникиЗамеров.Получить(Выборка.Номенклатура);

		Если НЕ ХарактеристикаЗамерена(Выборка.Наименование, Источники, РазмерыСЗамерами) Тогда
			Результат.Вставить(Выборка.Номенклатура, Истина);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает Истина, если у номенклатуры есть характеристики без замеров.
// Для одного элемента, например для раскраски строки списка. Для пачки элементов
// дешевле один вызов РассчитатьПризнакНетЗамеров() с массивом.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура.
//
// Возвращаемое значение:
//  Булево.
//
Функция НетЗамеровУНоменклатуры(Номенклатура) Экспорт

	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Ложь;
	КонецЕсли;

	Признаки = РассчитатьПризнакНетЗамеров(Номенклатура);

	Возврат Признаки.Получить(Номенклатура) = Истина;

КонецФункции

// Характеристики номенклатуры, у которых нет заполненных замеров.
// Критерий тот же, что и у РассчитатьПризнакНетЗамеров() (замеры ищутся по цепочке
// моделей-доноров), но с разбивкой по характеристикам - для подсветки строк таблицы
// характеристик в карточке номенклатуры.
// Номенклатура без свойства "Тип изделия" (код 000000037) не проверяется: замеры по ней
// не ведутся, кнопка "Замеры" в карточке для нее недоступна.
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура.
//
// Возвращаемое значение:
//  Соответствие - ключ СправочникСсылка.ХарактеристикиНоменклатуры,
//                 значение Булево (Истина = замеров нет).
//
Функция ХарактеристикиБезЗамеров(Номенклатура) Экспорт

	Результат = Новый Соответствие;

	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СвойстваОбъекта(Номенклатура, "000000037")) Тогда
		Возврат Результат;
	КонецЕсли;

	Источники = ЦепочкаИсточниковЗамеров(Номенклатура,
		КартаНоменклатурыЗаполнения(НоменклатураДляПересчетаЗамеров(Номенклатура)));

	РазмерыСЗамерами = РазмерыСЗамерамиПоИсточникам(Источники);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Характеристики.Ссылка КАК Ссылка,
	               |	Характеристики.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.ХарактеристикиНоменклатуры КАК Характеристики
	               |ГДЕ
	               |	НЕ Характеристики.ПометкаУдаления
	               |	И Характеристики.Владелец = &Номенклатура";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка,
			НЕ ХарактеристикаЗамерена(Выборка.Наименование, Источники, РазмерыСЗамерами));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Карта "номенклатура -> номенклатура заполнения".
// Для пустого массива строится по всему справочнику одним запросом, иначе обходится
// точечно по ссылкам: реквизит НоменклатураЗаполнения не индексирован, и сканировать
// из-за него весь справочник на каждую строку списка незачем.
Функция КартаНоменклатурыЗаполнения(Номенклатуры)

	Результат = Новый Соответствие;
	Запрос = Новый Запрос;

	Если Номенклатуры.Количество() = 0 Тогда

		Запрос.Текст = "ВЫБРАТЬ
		               |	Номенклатура.Ссылка КАК Ссылка,
		               |	Номенклатура.НоменклатураЗаполнения КАК Донор
		               |ИЗ
		               |	Справочник.Номенклатура КАК Номенклатура
		               |ГДЕ
		               |	Номенклатура.НоменклатураЗаполнения <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		               |	И Номенклатура.НоменклатураЗаполнения <> Номенклатура.Ссылка";

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, Выборка.Донор);
		КонецЦикла;

		Возврат Результат;

	КонецЕсли;

	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Ссылка,
	               |	Номенклатура.НоменклатураЗаполнения КАК Донор
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Ссылка В (&Ссылки)
	               |	И Номенклатура.НоменклатураЗаполнения <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |	И Номенклатура.НоменклатураЗаполнения <> Номенклатура.Ссылка";

	Ссылки = Номенклатуры;

	Для Сч = 1 По 5 Цикл

		Запрос.УстановитьПараметр("Ссылки", Ссылки);
		Выборка = Запрос.Выполнить().Выбрать();

		Следующие = Новый Массив;
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.Ссылка, Выборка.Донор);
			Если Результат.Получить(Выборка.Донор) = Неопределено
				И Следующие.Найти(Выборка.Донор) = Неопределено Тогда
				Следующие.Добавить(Выборка.Донор);
			КонецЕсли;
		КонецЦикла;

		Если Следующие.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;

		Ссылки = Следующие;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сама номенклатура и цепочка ее моделей-доноров, откуда берутся замеры.
// Глубина ограничена, зацикливание отсекается.
Функция ЦепочкаИсточниковЗамеров(Номенклатура, КартаДоноров)

	МаксимальнаяГлубина = 5;

	Источники = Новый Массив;
	Источники.Добавить(Номенклатура);

	Текущая = Номенклатура;
	Для Сч = 1 По МаксимальнаяГлубина Цикл

		Донор = КартаДоноров.Получить(Текущая);
		Если Донор = Неопределено ИЛИ Источники.Найти(Донор) <> Неопределено Тогда
			Прервать;
		КонецЕсли;

		Источники.Добавить(Донор);
		Текущая = Донор;

	КонецЦикла;

	Возврат Источники;

КонецФункции

// Размеры, по которым замеры уже заполнены, по перечисленным источникам замеров
// (сама номенклатура и ее модели-доноры). Ключ - КлючРазмераЗамеров().
Функция РазмерыСЗамерамиПоИсточникам(Источники, ВсяНоменклатура = Ложь)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номенклатуры", Источники);
	Запрос.УстановитьПараметр("ВсяНоменклатура", ВсяНоменклатура);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Замеры.Номенклатура КАК Номенклатура,
	               |	Замеры.Размер КАК Размер
	               |ИЗ
	               |	РегистрСведений.Замеры КАК Замеры
	               |ГДЕ
	               |	Замеры.Замер > 0
	               |	И (Замеры.Номенклатура В (&Номенклатуры)
	               |			ИЛИ &ВсяНоменклатура)";

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(КлючРазмераЗамеров(Выборка.Номенклатура, Выборка.Размер), Истина);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Истина, если хотя бы по одной части наименования характеристики (наименование
// разбирается по запятой, как в РазмерПолнота()) есть замер у себя или у донора.
Функция ХарактеристикаЗамерена(Наименование, Источники, РазмерыСЗамерами)

	Для Каждого Часть Из СтрРазделить(Наименование, ",", Ложь) Цикл

		Размер = СокрЛП(Часть);
		Если Размер = "" Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Источник Из Источники Цикл
			Если РазмерыСЗамерами.Получить(КлючРазмераЗамеров(Источник, Размер)) = Истина Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция КлючРазмераЗамеров(Номенклатура, Размер)

	Возврат Строка(Номенклатура.УникальныйИдентификатор()) + "|" + СокрЛП(Размер);

КонецФункции

Функция НоменклатураДляПересчетаЗамеров(Значение)

	Результат = Новый Массив;

	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если ЗначениеЗаполнено(Элемент) И Результат.Найти(Элемент) = Неопределено Тогда
				Результат.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
		Результат.Добавить(Значение);
	КонецЕсли;

	Возврат Результат;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// НОМЕР ЗАКАЗА НА САЙТЕ (ЗаказПокупателя.НомерЗаказа2ССайта)
//
// Сайт показывает номер заказа всегда шестью знаками, добивая слева нулями:
// заказ 32760 покупатель видит как «032760» (shop/shop.class.php, js/shop.js —
// orderNumFormat). В 1С номер до 16.08.2026 лежал так, как пришёл в атрибуте
// id выгрузки, то есть без нулей — и менеджер, копируя номер из письма или с
// сайта, не находил заказ поиском по строке: «032760» не содержится в «32760».
//
// Теперь номер НАШЕГО сайта хранится в том же виде, в каком его видит
// покупатель. Номера маркетплейсов лежат в этом же реквизите (Розетка и Каста
// пишут девятизначные, Пром — свои, бывают и буквенные), поэтому дополняются
// только чисто цифровые значения короче шести знаков: длинные и буквенные
// не трогаются вовсе.
//
// Пока в базе живут оба формата, поиск обязан понимать оба — для этого
// ВариантыПоискаНомераЗаказаССайта. Разово выровнять старые заказы можно
// обработкой «Номера заказов с сайта: дописать нули».
//

// Номер заказа с сайта в том виде, в каком его видит покупатель.
//
// Параметры:
//  Номер - Строка - номер как пришёл из обмена.
//
// Возвращаемое значение:
//  Строка - шесть знаков с ведущими нулями, если это цифры и их меньше шести;
//           в остальных случаях - исходное значение без крайних пробелов.
//
Функция НомерЗаказаССайтаНормализованный(Знач Номер) Экспорт

	Результат = СокрЛП(Строка(Номер));

	Если ПустаяСтрока(Результат) Тогда
		Возврат "";
	КонецЕсли;

	Если СтрДлина(Результат) >= 6 Тогда
		Возврат Результат;
	КонецЕсли;

	Если НЕ ТолькоЦифрыВСтроке(Результат) Тогда
		Возврат Результат;
	КонецЕсли;

	Пока СтрДлина(Результат) < 6 Цикл
		Результат = "0" + Результат;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Все написания одного и того же номера заказа с сайта: как пришёл,
// нормализованное (с нулями) и без ведущих нулей. Дубли не повторяются.
//
// Возвращаемое значение:
//  Массив - строки; пустой массив, если номер не задан.
//
Функция ВариантыПоискаНомераЗаказаССайта(Знач Номер) Экспорт

	Результат = Новый Массив;

	Исходный = СокрЛП(Строка(Номер));

	Если ПустаяСтрока(Исходный) Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.Добавить(Исходный);

	СНулями = НомерЗаказаССайтаНормализованный(Исходный);

	Если Результат.Найти(СНулями) = Неопределено Тогда
		Результат.Добавить(СНулями);
	КонецЕсли;

	БезНулей = Исходный;

	Пока СтрДлина(БезНулей) > 1 И Лев(БезНулей, 1) = "0" Цикл
		БезНулей = Сред(БезНулей, 2);
	КонецЦикла;

	Если Результат.Найти(БезНулей) = Неопределено Тогда
		Результат.Добавить(БезНулей);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Заказ покупателя по номеру на сайте, в любом из форматов хранения.
//
// Параметры:
//  Номер              - Строка - номер сайта в любом написании.
//  ВключаяПомеченные  - Булево - Истина: помеченные на удаление тоже годятся.
//                       Так работал НайтиПоРеквизиту, на который эта функция
//                       заменяется в дедупе обмена, - поведение сохраняем.
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПокупателя - пустая ссылка, если не найден. Самый
//  свежий - первым: один и тот же номер сайта может оказаться у отменённого
//  дубля.
//
Функция ЗаказПоНомеруЗаказаССайта(Знач Номер, Знач ВключаяПомеченные = Ложь) Экспорт

	Варианты = ВариантыПоискаНомераЗаказаССайта(Номер);

	Если Варианты.Количество() = 0 Тогда
		Возврат Документы.ЗаказПокупателя.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.НомерЗаказа2ССайта В (&Варианты)
	|	И (&ВключаяПомеченные ИЛИ НЕ ЗаказПокупателя.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата УБЫВ";

	Запрос.УстановитьПараметр("Варианты",          Варианты);
	Запрос.УстановитьПараметр("ВключаяПомеченные", ВключаяПомеченные);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Документы.ЗаказПокупателя.ПустаяСсылка();

КонецФункции
