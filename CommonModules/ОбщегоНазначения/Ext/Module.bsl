		//	|		ПО ВТКомплектующие.Комплектующая = ТоварыНаСкладахОстатки.Номенклатура
		//	|			И ВТКомплектующие.ХарактеристикаКомплектующей = ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры
		//	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
		//	|				&НаДату,
		//	|				Склад В (&Склад)
		//	|					ИЛИ &СкладВыбран) КАК ТоварыВРезервеНаСкладахОстатки
		//	|		ПО ВТКомплектующие.Комплектующая = ТоварыВРезервеНаСкладахОстатки.Номенклатура
		//	|			И ВТКомплектующие.ХарактеристикаКомплектующей = ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
		//	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТИгнорироватьНоль КАК ВТИгнорироватьНоль
		//	|		ПО ВТКомплектующие.Комплектующая = ВТИгнорироватьНоль.Характеристика.Владелец
		//	|			И ВТКомплектующие.ХарактеристикаКомплектующей = ВТИгнорироватьНоль.Характеристика
		//	|
		//	|УПОРЯДОЧИТЬ ПО
		//	|	КоличествоОстаток";   
		
		
		ТекстЗапроса =  ПолучитьЗапросДляНаборКомплект();
		
		
		
		
		
		
	Иначе
		
		ТекстЗапроса = 
		
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|			&НаДату,
		|			Номенклатура = &Номенклатура
		|				И (ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
		|					ИЛИ &ХарактеристикаНоменклатурыВыбрана)
		|				И (Склад В (&Склад)
		|					ИЛИ &СкладнеВыбран)) КАК ТоварыНаСкладахОстатки";
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("НаДату"                           , НаДату);
	Запрос.УстановитьПараметр("Номенклатура"                     , Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры"       , Характеристика);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатурыВыбрана", СокрЛП(Характеристика) = "<без характеристики>");
	Запрос.УстановитьПараметр("Склад"                            , Склад1);
	Запрос.УстановитьПараметр("СкладнеВыбран"                    , Склад1.Количество()=0);
	
	Рез = Запрос.Выполнить().Выгрузить();
	
	Возврат Рез.Итог("КоличествоОстаток");
	
КонецФункции


функция ПолучитьЗапросДляНаборКомплект() Экспорт 
		
  Возврат  "ВЫБРАТЬ
           |	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
           |	ВЫБОР
           |		КОГДА основная.Ссылка ЕСТЬ NULL
           |			ТОГДА неосновная.Ссылка
           |		ИНАЧЕ основная.Ссылка
           |	КОНЕЦ КАК Ростовка,
           |	ХарактеристикиНоменклатуры.Владелец КАК Владелец
           |ПОМЕСТИТЬ ВТРостовка
           |ИЗ
           |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
           |		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
           |			МАКСИМУМ(ГруппыХарактеристикХарактеристики.Ссылка) КАК Ссылка,
           |			ГруппыХарактеристикХарактеристики.Характеристика КАК Характеристика
           |		ИЗ
           |			Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
           |		ГДЕ
           |			ГруппыХарактеристикХарактеристики.Ссылка.НеОсновная
           |		
           |		СГРУППИРОВАТЬ ПО
           |			ГруппыХарактеристикХарактеристики.Характеристика) КАК неосновная
           |		ПО ХарактеристикиНоменклатуры.Ссылка = неосновная.Характеристика
           |		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
           |			МАКСИМУМ(ГруппыХарактеристикХарактеристики.Ссылка) КАК Ссылка,
           |			ГруппыХарактеристикХарактеристики.Характеристика КАК Характеристика
           |		ИЗ
           |			Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
           |		ГДЕ
           |			НЕ ГруппыХарактеристикХарактеристики.Ссылка.НеОсновная
           |		
           |		СГРУППИРОВАТЬ ПО
           |			ГруппыХарактеристикХарактеристики.Характеристика) КАК основная
           |		ПО ХарактеристикиНоменклатуры.Ссылка = основная.Характеристика
           |ГДЕ
           |	ХарактеристикиНоменклатуры.Владелец.ВидНоменклатуры.Код В (""000000010"", ""000000001"")
           |;
           |
           |////////////////////////////////////////////////////////////////////////////////
           |ВЫБРАТЬ
           |	МИНИМУМ(ЕСТЬNULL(ПолучимВРезерве.КоличествоОстаток, 0)) КАК КоличествоОстатокРезерва,
           |	МИНИМУМ(ЕСТЬNULL(ПолучимОстаток.КоличествоОстаток, 0) + ВЫБОР
           |			КОГДА &СкладНеВыбран
           |				ТОГДА ЕСТЬNULL(ПолучимПредзаказ.КоличествоОстаток, 0)
           |			ИНАЧЕ 0
           |		КОНЕЦ) КАК КоличествоОстаток,
           |	МИНИМУМ(ЕСТЬNULL(ПолучимОстаток.КоличествоОстаток, 0) - ЕСТЬNULL(ПолучимВРезерве.КоличествоОстаток, 0) + ВЫБОР
           |			КОГДА &СкладНеВыбран
           |				ТОГДА ЕСТЬNULL(ПолучимПредзаказ.КоличествоОстаток, 0)
           |			ИНАЧЕ 0
           |		КОНЕЦ) КАК Остаток
           |ИЗ
           |	РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
           |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
           |			МИНИМУМ(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток) КАК КоличествоОстаток,
           |			ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
           |		ИЗ
           |			РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
           |					&НаДату,
           |					(Склад В (&Склад)
           |						ИЛИ &СкладнеВыбран)
           |						И (&ХарактеристикаНоменклатурыВыбрана
           |							ИЛИ ХарактеристикаНоменклатуры В
           |								(ВЫБРАТЬ
           |									КомплектующиеНоменклатуры.ХарактеристикаКомплектующей КАК ХарактеристикаКомплектующей
           |								ИЗ
           |									РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
           |								ГДЕ
           |									КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры))) КАК ТоварыВРезервеНаСкладахОстатки
           |		
           |		СГРУППИРОВАТЬ ПО
           |			ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры) КАК ПолучимВРезерве
           |		ПО КомплектующиеНоменклатуры.ХарактеристикаКомплектующей = ПолучимВРезерве.ХарактеристикаНоменклатуры
           |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
           |			МИНИМУМ(ЕСТЬNULL(ТоварыНаСкладахОстатки.КоличествоОстаток, 0)) КАК КоличествоОстаток,
           |			ХарактеристикиНоменклатуры.Ссылка КАК ХарактеристикаВход
           |		ИЗ
           |			РегистрНакопления.ТоварыНаСкладах.Остатки(
           |					&НаДату,
           |					(Склад В (&Склад)
           |						ИЛИ &СкладнеВыбран)
           |						И (&ХарактеристикаНоменклатурыВыбрана
           |							ИЛИ ХарактеристикаНоменклатуры В
           |								(ВЫБРАТЬ
           |									КомплектующиеНоменклатуры.ХарактеристикаКомплектующей КАК ХарактеристикаКомплектующей
           |								ИЗ
           |									РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
           |								ГДЕ
           |									КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры))) КАК ТоварыНаСкладахОстатки
           |				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
           |				ПО ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = ХарактеристикиНоменклатуры.Ссылка
           |		
           |		СГРУППИРОВАТЬ ПО
           |			ХарактеристикиНоменклатуры.Ссылка) КАК ПолучимОстаток
           |		ПО КомплектующиеНоменклатуры.ХарактеристикаКомплектующей = ПолучимОстаток.ХарактеристикаВход
           |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
           |			МИНИМУМ(ВЫБОР
           |					КОГДА ПолучимРостовку.Ростовка.ИгнорироватьНоль
           |						ТОГДА ВЫБОР
           |								КОГДА ПолучимРостовку.Ростовка.ИНКоличество = 0
           |									ТОГДА 10
           |								ИНАЧЕ ПолучимРостовку.Ростовка.ИНКоличество
           |							КОНЕЦ
           |					ИНАЧЕ 0
           |				КОНЕЦ) КАК КоличествоОстаток,
           |			ПолучимРостовку.Ростовка КАК Ростовка,
           |			ХарактеристикиНоменклатуры.Ссылка КАК ХарактеристикаВход
           |		ИЗ
           |			Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
           |				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
           |					ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
           |					ВТРостовка.Ростовка КАК Ростовка
           |				ИЗ
           |					ВТРостовка КАК ВТРостовка
           |						ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
           |						ПО ВТРостовка.Характеристика = ХарактеристикиНоменклатуры.Ссылка) КАК ПолучимРостовку
           |				ПО ХарактеристикиНоменклатуры.Ссылка = ПолучимРостовку.Характеристика
           |		
           |		СГРУППИРОВАТЬ ПО
           |			ПолучимРостовку.Ростовка,
           |			ХарактеристикиНоменклатуры.Ссылка) КАК ПолучимПредзаказ
           |		ПО КомплектующиеНоменклатуры.ХарактеристикаКомплектующей = ПолучимПредзаказ.ХарактеристикаВход
           |ГДЕ
           |	КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры"; 
  
  
КонецФункции


// Функция преобразует строку к множественному числу
//
// Параметры: 
//  Слово1 - форма слова в ед числе      ("шкаф")
//  Слово2 - форма слова для числит 2-4  ("шкафа")
//  Слово3 - форма слова для числит 5-10 ("шкафов")
//  ЦелоеЧисло - целое число
//
// Возвращаемое значение:
//  строку - одну из строк в зависимости от параметра ЦелоеЧисло
//
// Описание:
//  Предназначена для формирования "правильной" подписи к числительным
//
Функция ФормаМножественногоЧисла(Слово1, Слово2, Слово3, ЦелоеЧисло) Экспорт

	Если ЦелоеЧисло <> Цел(ЦелоеЧисло) Тогда 
		// для нецелых чисел - всегда вторая форма
		Возврат Слово2;
	КонецЕсли;
	
	// остаток
	Остаток = ЦелоеЧисло%10;
	Если (ЦелоеЧисло >10) И (ЦелоеЧисло<20) Тогда
		// для второго десятка - всегда третья форма
		Возврат Слово3;
	ИначеЕсли Остаток=1 Тогда
		Возврат Слово1;
	ИначеЕсли (Остаток>1) И (Остаток<5) Тогда
		Возврат Слово2;
	Иначе
		Возврат Слово3;
	КонецЕсли;

КонецФункции

