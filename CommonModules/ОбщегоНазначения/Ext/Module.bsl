					иначе
						Продолжить;
					КонецЕсли;

				КонецЕсли;

				//Если ЗначениеЗаполнено(НаименованиеПараметра) И ЗначениеЗаполнено(Значение) Тогда
					Наименование2Код = СтрЗаменить(Строка(Св.Наименование2Код),символы.НПП, "");
					
					КодПараметр = "";
					// Проверка и присвоение значения КодПараметр
					Если КодПараметра <> "" Тогда
						
						Если Наименование2Код = "" Или Наименование2Код = "0" Тогда
							КодПараметр = КодПараметра + "=" + """" + Стр1.Свойство.код + """" + " "; 
						Иначе
							КодПараметр = КодПараметра + "=" + """" + Наименование2Код + """" + " ";
						КонецЕсли;
					КонецЕсли;

					// Форматирование значения Соответствие2Код
					Соответствие2Код = Формат(Св.Соответствие2Код, "ЧГ=0");

					ЗначениеКод = "";

					// Проверка и присвоение значения ЗначениеКод
					Если ЗначениеАйди <> "" Тогда	
						Если КодПараметра <> "" И ЗнСв <> Неопределено Тогда
							Если Соответствие2Код = "" Тогда
								ЗначениеКод = ЗначениеАйди + "=" + """" + ЗнСв.код + """" + " ";	
							Иначе
								ЗначениеКод = ЗначениеАйди + "=" + """" + Соответствие2Код + """" + " ";
							КонецЕсли;
						
						КонецЕсли;
					КонецЕсли;

					//КодПараметр = ?(Не(Наименование2Код="" Или Наименование2Код= "0" Или КодПараметра = "") ,""+КодПараметра+"" +"=" + """" + Наименование2Код +"""" + " ","");
					//
					//Соответствие2Код = Формат(Св.Соответствие2Код, "ЧГ=0");
					//
					//ЗначениеКод = ?(Не(Соответствие2Код ="" Или КодПараметра = ""),""+ЗначениеАйди+"" + "=" + """" + Соответствие2Код + """"  + " ","");
									
					Если Не ЗначениеЗаполнено(Св.Свойство) Тогда
						Если Значение = "ИнфаКг" Тогда
							Коэфициэнт = 0.001; 
						ИначеЕсли Значение = "ИнфаСм" Тогда
							Коэфициэнт = 0.01;
						ИначеЕсли Значение = "ИнфаМм" Тогда
							Коэфициэнт = 1;	
						КонецЕсли;	
						
					
						Упаковка = Номенклатура.Родитель.Родитель.Упаковка;
						Если Св.Наименование1 = "Вес" Тогда //гр
							Значение = формат(Номенклатура.Родитель.Родитель.Упаковка.Вес * Коэфициэнт, "ЧГ=0"); 
						ИначеЕсли Св.Наименование1 = "Высота" Тогда //мм
							Значение = формат(Номенклатура.Родитель.Родитель.Упаковка.Высота * Коэфициэнт, "ЧГ=0"); 
						ИначеЕсли Св.Наименование1 = "Глубина" Тогда //мм
							Значение = формат(Номенклатура.Родитель.Родитель.Упаковка.Глубина * Коэфициэнт, "ЧГ=0"); 
						ИначеЕсли Св.Наименование1 = "Ширина" Тогда //мм
							 Значение = формат(Номенклатура.Родитель.Родитель.Упаковка.Ширина * Коэфициэнт, "ЧГ=0"); 
						КонецЕсли;
						
					КонецЕсли;
					
					
					Если Не Jaison Тогда	
						Текст = Текст + ("<param " + ЗаголовокПараметра + "=""" + НаименованиеПараметра + """" + " " +КодПараметр + ЗначениеКод + ">" + Значение + "</param>") + Символы.ПС;
					Иначе
						Текст = Текст + (Разделитель + """" + НаименованиеПараметра + """" + ":"+ """" + Значение + """"+ ",") + Символы.ПС;
					КонецЕсли;	 					
				
			КонецЕсли;		
		КонецЦикла;		
	КонецЦикла;
	
	Возврат Текст;
КонецФункции

Функция ОписаниеДляХарактеристики(Характеристика, Рус, ПринудительноДобавлятьЗамеры = Ложь) Экспорт 
	
	Номенклатура = Характеристика.Владелец;
	
	Описание = ОписаниеНоменклатуры(Номенклатура, Рус);
	
	ФотоЗамеров = ПолучитьОбщееФотоПоНазванию(Номенклатура, "Замеры");	
	НетФотоЗамеров = Не значениеЗаполнено(ФотоЗамеров);
	
	Если НетФотоЗамеров Или ПринудительноДобавлятьЗамеры Тогда
		Возврат Описание + ЗамерыТовара(Характеристика);
	КонецЕсли;  
	
	Возврат Описание ;
	
КонецФункции   

функция ЗамерыТовара(Характеристика, Рус = Неопределено) Экспорт   
	
	Номенклатура = Характеристика.Владелец;

	// Определяем рабочие поля и тексты в зависимости от Рус
	Если Рус = Истина Тогда
		ПолеИмя = "ПолеРус";
		НаименованиеМодели = Номенклатура.НаименованиеПолноеРус;
	ИначеЕсли Рус = Ложь Тогда
		ПолеИмя = "Поле";
		НаименованиеМодели = Номенклатура.НаименованиеПолное;
	Иначе // Рус = Неопределено
		ПолеИмя = "ПолеПеревод";
		НаименованиеМодели = Номенклатура.Транслитирация; // твое поле с транслитом
	КонецЕсли;  
	
	// Получаем замеры
	ТабЗамеров = ЗамерыПолучитьТЗВсехРазмеров(Номенклатура, Характеристика);

	Если ТабЗамеров.Количество() > 0 Тогда
		
		// Формируем начало описания
		Описание = "|<table style=""width: 600px; height: 100px;"" class=""table-price-size""><tbody>";
		
		//?(Описание = Неопределено, "", Описание)
		//	+ "
		//	|<p>[#486#] " + НаименованиеМодели + "</p>" // можно вынести текст в чанк
		//	+ "
		//	|<p>[#485#]</p>"
		//	+ "
			;
		
		// Формируем таблицу размеров
		ТабРазмеров = ТабЗамеров.Скопировать();
		ТабРазмеров.Свернуть("Размер");
		ТабРазмеров.Колонки.Добавить("РазмерС");

		Для Каждого Стр1 Из ТабРазмеров Цикл
			Попытка
				Стр1.РазмерС = Число(Стр1.Размер);
			Исключение
			КонецПопытки;
		КонецЦикла;
		ТабРазмеров.Сортировать("РазмерС");
		
		// Формируем таблицу полей
		ТабПолей = ТабЗамеров.Скопировать();
		ТабПолей.Свернуть(ПолеИмя);
		ТабЗамеров.Сортировать(ПолеИмя);
		
		// --- Шапка таблицы ---
		Описание = Описание + "
			|<tr>
			|	<td>
			|		<div class=""size-color2"">[#484#]</div>
			|	</td>";

		Для Каждого Стр1 Из ТабРазмеров Цикл
			Описание = Описание + "
			|	<td>" + СокрЛП(Стр1.Размер) + "</td>";
		КонецЦикла;

		Описание = Описание + "
			|</tr>"; // шапка
		
		// --- Строки таблицы (замеры) ---
		Для Каждого Стр1 Из ТабПолей Цикл
			
			Описание = Описание + "
			|<tr>
			|    <td>
			|        <div class=""size-color2"">" 
			+ ?(Рус = Неопределено, "[#" + СокрЛП(Стр1[ПолеИмя]) + "#]", СокрЛП(Стр1[ПолеИмя])) 
			+ "</div>
			|    </td>";			Для Каждого Стр2 Из ТабРазмеров Цикл
				
				ОтборПоЗамеру = ТабЗамеров.НайтиСтроки(Новый Структура(ПолеИмя + ",Размер", Стр1[ПолеИмя], Стр2.Размер));
				
				Если ОтборПоЗамеру.Количество() > 0 Тогда
					Замер = ОтборПоЗамеру[0].Замер;
				Иначе 
					Замер = "";
				КонецЕсли;
				
				Описание = Описание + "
				|	<td>" + ?(СокрЛП(Замер) = "", "-", СокрЛП(Замер)) + "</td>";
				
			КонецЦикла;
			
			Описание = Описание + "
			|</tr>";
			
		КонецЦикла;

		// Закрываем таблицу
		Описание = Описание + "
		|</tbody>
		|</table>";
		
	КонецЕсли;
	
	Возврат Описание;
КонецФункции 

Функция НаименованиеДляВыгрузки(Характеристика, РусскийЯзык, ДобавитьТкань = Ложь, ДобавитьРажмер = Истина, ДобавлитьШтрихКод = Истина) Экспорт
	
	ХарактеристикаОбъект = Характеристика.ПолучитьОбъект();
	Номенклатура = Характеристика.Владелец;
	НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
	
	ТипИзделия = НоменклатураОбъект.ПолучитьТипИзделия(РусскийЯзык);	
	Разм = СвойстваОбъекта(Характеристика,"000000099");
	    
	Арт = ?(ДобавлитьШтрихКод,ШтрихкодХарактеристики(Характеристика),"");
	Ткань = ?(ДобавитьТкань,ТканьХарактеристики(Характеристика,РусскийЯзык, Истина) + " ","");
	ЦветНазвание = ХарактеристикаОбъект.ЦветХарактеристики(РусскийЯзык, Истина); 
	
	Имя = НоменклатураОбъект.Наименование(РусскийЯзык);	
	        
	Размер = ?(ДобавитьРажмер,ХарактеристикаОбъект.ПолучитьРазмер(),"");	
	Возвраст = НоменклатураОбъект.ПолучитьНаименованиеДляВыгрузки(Истина,Истина,Истина);
	
	Свойство = СвойстваОбъекта(Номенклатура, "000000055");
	
	Принадлежность = "";
	
	Если ТипЗнч(Свойство) = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") Тогда
		
		Принадлежность = Свойство.Примечание;
		
	КонецЕсли;
	
	
	Возврат Возвраст + " " + НРег(ТипИзделия + " " + Принадлежность +  " Cvetkov "+ Имя +" "+ Ткань + ЦветНазвание + " " + Размер + "см  " + Арт);
КонецФункции
 


Функция СоставныеПоРазделителю (СоставнаяСтрока1,Разд) Экспорт
	СоставнаяСтрока = СоставнаяСтрока1;
	СписокСоставных = Новый СписокЗначений;
	ПозицияПлюса = 1;
	Пока ПозицияПлюса>0 Цикл
		ПозицияПлюса = Найти(СоставнаяСтрока,Разд);
		Составная1 = Сред(СоставнаяСтрока,0,ПозицияПлюса-1);
		СоставнаяСтрока = Сред(СоставнаяСтрока,ПозицияПлюса+1,СтрДлина(СоставнаяСтрока));
		Если СокрЛП(Составная1)<>""  Тогда
			 СписокСоставных.Добавить(СокрЛП(Составная1));
		КонецЕсли;
	КонецЦикла;
	Возврат СписокСоставных
КонецФункции

