Функция НормальноеЧисло(СтрокаПроверки) Экспорт
	НЧ = "";
	ДЛя Сч =1 По СтрДлина(СтрокаПроверки) Цикл
		СимволПроверки = Сред(СтрокаПроверки,Сч,1);
		если СимволПроверки = "1" Или СимволПроверки = "2" Или СимволПроверки = "3" Или СимволПроверки = "4" Или СимволПроверки = "5" Или СимволПроверки = "," Или СимволПроверки = "."
			Или СимволПроверки = "6" Или СимволПроверки = "7"  Или СимволПроверки = "8" Или СимволПроверки = "9" Или СимволПроверки = "0" Тогда
			НЧ = НЧ+СимволПроверки;
		КонецЕсли;
	КонецЦикла;
	Возврат НЧ;
КонецФункции

