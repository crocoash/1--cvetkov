Функция ПреобразоватьТелефон(Номер)Экспорт 
	
	Если ТипЗнч(Номер) = Тип("Число") Тогда
        Номер = Формат(Номер, "ЧЦ=0; ЧГ="); // Преобразуем число в строку без разделителей
    КонецЕсли;

	Номер = СтрЗаменить(Номер," ","");
	Номер = СтрЗаменить(Номер," ","");	
	Номер = СтрЗаменить(Номер,"(","");
	Номер = СтрЗаменить(Номер,"-","");
	Номер = СтрЗаменить(Номер,")","");
	Номер = СтрЗаменить(Номер,"+38","");
	Если Лев(Номер, 2) = "38" Тогда
   	 Номер = Сред(Номер, 3); // Удаляем первые два символа
	КонецЕсли;
	Номер = СтрЗаменить(Номер,"+3","");

	Возврат Номер;
