
// Проверить легальность получения обновления.
//
// Параметры
//  ТекущаяВерсияИБ  - Строка - номер версии ИБ.
//
// Возвращаемое значение:
//   Булево   - Истина, если проверка завершилась успешно.
//
Функция ПроверитьЛегальностьПолученияОбновления(Знач ТекущаяВерсияИБ) Экспорт

#Если Клиент Тогда
	 
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТекущаяВерсияИБ <> Метаданные.Версия И ТекущаяВерсияИБ <> "" Тогда
		Форма = Обработки.ЛегальностьПолученияОбновлений.ПолучитьФорму();
		Форма.ПоказыватьПредупреждениеОПерезапуске = Истина;
		Результат = Форма.ОткрытьМодально();
		Если Результат <> Истина Тогда
			ЗавершитьРаботуСистемы(Ложь);
			Возврат Ложь;
		КонецЕсли; 
	КонецЕсли;
#КонецЕсли
	Возврат Истина;

КонецФункции

Функция Транслитерация(СтрокаНаРусском, ПробелКакТире = Ложь) Экспорт
    // Приведение строки к нижнему регистру
    Строка = НРег(СтрокаНаРусском);
    
    Соответствия = Новый Соответствие;
    Соответствия.Вставить("а", "a");
    Соответствия.Вставить("б", "b");
    Соответствия.Вставить("в", "v");
    Соответствия.Вставить("г", "g");
    Соответствия.Вставить("д", "d");
    Соответствия.Вставить("е", "e");
    Соответствия.Вставить("ё", "e");
    Соответствия.Вставить("ж", "zh");
    Соответствия.Вставить("з", "z");
    Соответствия.Вставить("и", "i");
    Соответствия.Вставить("й", "j");  // Изменено для правильного отображения "й" как "y"
    Соответствия.Вставить("к", "k");
    Соответствия.Вставить("л", "l");
    Соответствия.Вставить("м", "m");
    Соответствия.Вставить("н", "n");
    Соответствия.Вставить("о", "o");
    Соответствия.Вставить("п", "p");
    Соответствия.Вставить("р", "r");
    Соответствия.Вставить("с", "s");
    Соответствия.Вставить("т", "t");
    Соответствия.Вставить("у", "u");
    Соответствия.Вставить("ф", "f");
    Соответствия.Вставить("х", "kh");
    Соответствия.Вставить("ц", "ts");
    Соответствия.Вставить("ч", "ch");
    Соответствия.Вставить("ш", "sh");
    Соответствия.Вставить("щ", "shch");
    Соответствия.Вставить("ы", "y");
    Соответствия.Вставить("э", "e");
    Соответствия.Вставить("ю", "yu");
    Соответствия.Вставить("я", "ya");
    Соответствия.Вставить("ь", "");
    Соответствия.Вставить("ъ", "");
	 Соответствия.Вставить("і", "i");
	//Соответствия.Вставить(".", "");
    Соответствия.Вставить(",", "");
    Соответствия.Вставить(" ", ?(ПробелКакТире, "_", ""));
    
    // Добавляем замену тире на дефис
    Соответствия.Вставить("–", "-"); // En dash (U+2013)
    Соответствия.Вставить("—", "-"); // Em dash (U+2014)

    // Транслитерация строки
    Результат = "";
    Для Индекс = 1 По СтрДлина(Строка) Цикл
        Символ = Сред(Строка, Индекс, 1);
        Если Соответствия[Символ] <> Неопределено Тогда
            Результат = Результат + Соответствия.Получить(Символ);
        Иначе
            Результат = Результат + Символ;
        КонецЕсли;
    КонецЦикла;
    
    Возврат Результат;
КонецФункции

Функция НК_Характеристики(Характеристика) Экспорт //))
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КомплектующиеНоменклатуры.Номенклатура КАК Номенклатура,
	               |	КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры
	               |ИЗ
	               |	РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
	               |ГДЕ
	               |	КомплектующиеНоменклатуры.Комплектующая = &Комплектующая
	               |	И КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры <> &ХарактеристикаНоменклатуры
	               |	И КомплектующиеНоменклатуры.ХарактеристикаКомплектующей = &ХарактеристикаКомплектующей";
	Запрос.УстановитьПараметр("Комплектующая",Характеристика.Владелец);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры",Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	Запрос.УстановитьПараметр("ХарактеристикаКомплектующей",Характеристика);
	
	Рез = Запрос.Выполнить().Выбрать();
	
	Если Рез.Следующий() Тогда
		Возврат Новый Структура("НК,Характеристика",Рез.Номенклатура,Рез.ХарактеристикаНоменклатуры);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

