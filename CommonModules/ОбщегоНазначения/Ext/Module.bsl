Процедура ПеревестиНаРусский(ТД)Экспорт
	РусскоеСлово = "";
	
	Для НомерСимвола = 1 По СтрДлина(ТД) Цикл
		Буква = Сред(ТД, НомерСимвола, 1);
 
		
		Если буква = "і" Тогда 
			РусскоеСлово = РусскоеСлово + "и";
			
		//ИначеЕсли буква = "и" Тогда
		//	
		//	РусскоеСлово = РусскоеСлово + "ы";
			
		ИначеЕсли буква = "і"Тогда
			
			РусскоеСлово = РусскоеСлово + "и";
			
		ИначеЕсли буква = "І" Тогда
			
			РусскоеСлово = РусскоеСлово + "И";
			
		ИначеЕсли буква = "Є" Тогда
			
			РусскоеСлово = РусскоеСлово + "Е";
			
		ИначеЕсли буква = "є" Тогда
			
			РусскоеСлово = РусскоеСлово + "е";
						
		//ИначеЕсли буква = "Е" Тогда
		//	
		//	РусскоеСлово = РусскоеСлово + "Э";
			
		//ИначеЕсли буква = "е" Тогда
		//	
		//	РусскоеСлово = РусскоеСлово + "э";
					                                     
		ИначеЕсли буква = "'" Тогда
			
			РусскоеСлово = РусскоеСлово + "";
			
		Иначе 
			РусскоеСлово = РусскоеСлово + буква;
		КонецЕсли;	
		
	КонецЦикла;
	
	Тд = РусскоеСлово; 
КонецПроцедуры

Процедура ПеревестиНаУкраинский(ТД)Экспорт
	
	УкраинскоеСлово = "";
	Для НомерСимвола = 1 По СтрДлина(ТД) Цикл
		Буква = Сред(ТД, НомерСимвола, 1);
  		
		Если буква = "ы" Тогда
			 
			УкраинскоеСлово = УкраинскоеСлово + "и";
			
		ИначеЕсли буква = "э" Тогда
			
			УкраинскоеСлово = УкраинскоеСлово + "е";
		ИначеЕсли буква = "Э" Тогда
			
			УкраинскоеСлово = УкраинскоеСлово + "Е";

		ИначеЕсли буква = "ё" Тогда
			
			УкраинскоеСлово = УкраинскоеСлово + "о";

		Иначе	
			УкраинскоеСлово = УкраинскоеСлово + буква;
		КонецЕсли;	
		
	КонецЦикла;
	
	ТД =  УкраинскоеСлово; 
	
КонецПроцедуры

функция ПолучитьЗначениеСвойстваХаракетристики(ТабСвойства, Характеристика ,РусЯзык, СтрокаПоиска = "Наименование", ПереводитьНазвание = Истина) Экспорт
	
	Сост = ОбщегоНазначения.СоставныеПоРазделителю(Характеристика.Наименование,",");
	ИмяЗначения = "";
	Если ТабСвойства.Количество() Тогда
		Для Каждого Стр Из Сост Цикл
			НайденоСвойство = ТабСвойства.Найти(Стр.Значение,СтрокаПоиска);
			Если НЕ НайденоСвойство = Неопределено Тогда
				Если СтрокаПоиска <> "Наименование" Тогда
					ИмяЗначения = НайденоСвойство[0];
					Прервать;
				КонецЕсли;
				Значение = НайденоСвойство[0];
				Если РусЯзык Тогда 
					НаименованиеРус = Значение.НаименованиеРус;
					Если Не ЗначениеЗаполнено(НаименованиеРус) Тогда
						ИмяЗначения = Значение.Наименование;
						Если ПереводитьНазвание Тогда
							ПеревестиНаРусский(ИмяЗначения);
						КонецЕсли;
					Иначе 
						ИмяЗначения = НаименованиеРус; 
					КонецЕсли;
				Иначе
					ИмяЗначения = Значение.Наименование;
					Если ПереводитьНазвание Тогда
						ПеревестиНаУкраинский(ИмяЗначения);
					КонецЕсли;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ПереводитьНазвание Тогда	
			ИмяЗначения = СтрЗаменить(СтрЗаменить(ИмяЗначения,",",""),"."," ");
		КонецЕсли;
	КонецЕсли;	

	Возврат ИмяЗначения; 
КонецФункции

Функция СвойстваЗначенияНоменклатура(Свойство,Номенклатура) Экспорт 

	ЗапросСвойстваНоменклатуры = Новый Запрос;
	ЗапросСвойстваНоменклатуры.Текст = "ВЫБРАТЬ
	                                   |	ЗначенияСвойствОбъектов.Значение.Наименование КАК Значение
	                                   |ИЗ
	                                   |	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
	                                   |ГДЕ
	                                   |	ЗначенияСвойствОбъектов.Свойство = &Свойство
	                                   |	И (ЗначенияСвойствОбъектов.Объект = &Объект
	                                   |			ИЛИ &ОбъектВыбран)";
	
	ЗапросСвойстваНоменклатуры.УстановитьПараметр("Свойство", Свойство);
	ЗапросСвойстваНоменклатуры.УстановитьПараметр("Объект", Номенклатура);
	ЗапросСвойстваНоменклатуры.УстановитьПараметр("ОбъектВыбран", НЕ ЗначениеЗаполнено(Номенклатура));
	ВыборкаСвойстваНоменклатуры = ЗапросСвойстваНоменклатуры.Выполнить().Выгрузить();
	ВыборкаСвойстваНоменклатуры.Свернуть("Значение");
	
	Для Каждого Стр Из ВыборкаСвойстваНоменклатуры Цикл
		Стр.Значение = СокрЛП(Стр.Значение);
	КонецЦикла;
	
	Возврат ВыборкаСвойстваНоменклатуры;
		
КонецФункции

