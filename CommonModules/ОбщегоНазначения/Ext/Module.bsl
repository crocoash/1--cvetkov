Функция ПроверкаКомплектностиТЗ(Таб, ПроверятьНаНедостачу = Ложь) Экспорт 
	Таб.Свернуть("Номенклатура,ХарактеристикаНоменклатуры","Количество");
	ВсеОк = Истина;
	ВыводилиПоХке = Новый СписокЗначений;
	
	Для Каждого Стр Из Таб Цикл
		Хка = Стр.ХарактеристикаНоменклатуры;
		ХкаОбъект = Хка.ПолучитьОбъект(); 
		ГрХки = ХкаОбъект.ПолучитьРостовку();
		Если ЗначениеЗаполнено(ГрХки) Тогда
			
			//минимальное максимальное в товаре для группы хк
			Мин = 1000;  Макс = 0;
			ДЛя Каждого Гр Из ГрХки.Характеристики Цикл
				НайденаХка = Таб.Найти(Гр.Характеристика,"ХарактеристикаНоменклатуры");
				Если НЕ НайденаХка= Неопределено Тогда
					Если НайденаХка.Количество<Мин Тогда
						Мин = НайденаХка.Количество;
					КонецЕсли;
					
					Если НайденаХка.Количество>Макс Тогда
						Макс = НайденаХка.Количество;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			//проверим превышает ли минимум для группы
			ДЛя Каждого Гр Из ГрХки.Характеристики Цикл
				НайденаХка = Таб.Найти(Гр.Характеристика,"ХарактеристикаНоменклатуры");
				Если НЕ НайденаХка= Неопределено Тогда
					Если НайденаХка.Количество>Мин  И ВыводилиПоХке.НайтиПоЗначению(НайденаХка.ХарактеристикаНоменклатуры)= Неопределено Тогда
						Сообщить(НайденаХка.ХарактеристикаНоменклатуры.Владелец.Наименование+" "+НайденаХка.ХарактеристикаНоменклатуры.Наименование+" лишние "+Строка(НайденаХка.Количество-Мин));
						ВыводилиПоХке.Добавить(НайденаХка.ХарактеристикаНоменклатуры);
						ВсеОк = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			//проверим недостачу для группы
			Если ПроверятьНаНедостачу Тогда
				ДЛя Каждого Гр Из ГрХки.Характеристики Цикл
					НайденаХка = Таб.Найти(Гр.Характеристика,"ХарактеристикаНоменклатуры");
					Если НЕ НайденаХка= Неопределено Тогда
						Если НайденаХка.Количество<Макс И ВыводилиПоХке.НайтиПоЗначению(НайденаХка.ХарактеристикаНоменклатуры)= Неопределено Тогда
							Сообщить(НайденаХка.ХарактеристикаНоменклатуры.Владелец.Наименование+" "+НайденаХка.ХарактеристикаНоменклатуры.Наименование+" в недостаче "+Строка(Макс-НайденаХка.Количество));
							ВыводилиПоХке.Добавить(НайденаХка.ХарактеристикаНоменклатуры);
							ВсеОк = Ложь;
						КонецЕсли;
					Иначе
						Сообщить(Гр.Характеристика.Владелец.Наименование+" "+Гр.Характеристика.Наименование+" отсутствует!");
						ВыводилиПоХке.Добавить(Гр.Характеристика);
						ВсеОк = Ложь;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	
	Возврат ВсеОк;
КонецФункции

Функция УбратьНоликиСлева(СтрокаСНоликами) Экспорт 
	Ф=0;  НоваяСтрока = "";
	Для Сч = 1 По СтрДлина(СтрокаСНоликами) Цикл 
		Символ = Сред(СтрокаСНоликами,Сч,1);
		Если  НЕ Символ = "0" и Ф=0 Тогда
			//первый ненулевой символ
			Ф=1
		КонецЕсли;
		Если Ф=1 Тогда
			//дальше берем все и нолики тоже
			НоваяСтрока = НоваяСтрока+Символ
		КонецЕсли;
	КонецЦикла;
	Возврат НоваяСтрока
КонецФункции

Функция ПараметрыКВыгрузке(Соответствие="") Экспорт
	ТабСвойств = Константы["СоответсвияСвойств"+Соответствие].Получить().Получить();
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Свойство");
	Если НЕ ТипЗнч(ТабСвойств)= Тип("ТаблицаЗначений") ТОгда Возврат ТЗ; КонецЕсли;
	НужноуДалить = Новый Массив;
	Для Каждого Стр Из ТабСвойств Цикл
		Если НЕ Стр.Отметка1 И НЕ Стр.Отметка2 Тогда
			НужноуДалить.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	
	ДЛя Каждого Стр Из НужноуДалить Цикл                      
		ТабСвойств.Удалить(Стр);
	КонецЦикла;
	
	Табсвойств.Сортировать("Свойство");
	
	Возврат ТабСвойств;
	
КонецФункции


