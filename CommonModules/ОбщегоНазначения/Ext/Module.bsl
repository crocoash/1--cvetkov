Функция РазмерПолнота(Номенклатура,Характеристика) Экспорт 
	
	Размерс = ""; ПолнотаС = "";
	
	//Размер
	СвойствоРазмер = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду("000000099");
	//37 тип изделия
	ТабСвойства = ОбщегоНазначения.СвойстваЗначенияНоменклатура(СвойствоРазмер,Характеристика);
	Сост = ОбщегоНазначения.СоставныеПоРазделителю(Характеристика,",");
	Размерс = "";
	Для Каждого Стр Из Сост Цикл
		НайденоСвойство = ТабСвойства.Найти(Стр.Значение,"Значение");
		Если НЕ НайденоСвойство = Неопределено Тогда
			Размерс = Стр.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	//полнота
	СвойствоПолнота = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду("000000001");
	ТабСвойства = ОбщегоНазначения.СвойстваЗначенияНоменклатура(СвойствоПолнота,Номенклатура);
	Сост = ОбщегоНазначения.СоставныеПоРазделителю(Характеристика,",");
	ПолнотаС = "";
	Для Каждого Стр Из Сост Цикл
		НайденоСвойство = ТабСвойства.Найти(Стр.Значение,"Значение");
		Если НЕ НайденоСвойство = Неопределено Тогда
			ПолнотаС = Стр.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("Размер,Полнота",Размерс,ПолнотаС);
	
КонецФункции

