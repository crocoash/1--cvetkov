Функция УбратьПробелы(СтрокаСПробелами) Экспорт 
	ПробелПервый = Ложь;  НоваяСтрока = "";
	Для Сч = 1 По СтрДлина(СтрокаСПробелами) Цикл 
		Символ = Сред(СтрокаСПробелами,Сч,1);
		Если   Символ = " " и НЕ ПробелПервый Тогда
			//первый Пробел оставляем
			ПробелПервый = Истина;
		Иначе
			Пробел = Ложь;
		КонецЕсли;
		Если НЕ Символ = " " ИЛИ  ПробелПервый  Тогда 
			НоваяСтрока = НоваяСтрока+Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат НоваяСтрока
КонецФункции

