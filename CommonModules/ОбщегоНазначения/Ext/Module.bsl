			тс.Договор     = тс.Заказ.ДоговорКонтрагента;
			тс.Загружать   = Истина;
			
			ОплаченоПозаказу(тс);
			
		КонецЕсли;
		
		Если НЕ бЗаказНайден Тогда 
			сПоиска = ""+Терминал1+" "+Содержание1;
			чПоз = Найти(сПоиска,"Комментарий к платежу:");
			Если чПоз > 0 Тогда 
				сПоиска = Сред(сПоиска,чПоз+22);
			КонецЕсли;	
			аСтрок = ОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(сПоиска, " ");
			Для Каждого ЭлементМассива Из аСтрок Цикл 
				ЭлементМассива = СокрЛП(ЭлементМассива); 
				тсНайденныйВозможныйЗаказ = тзНеоплЗаказы.Найти(ЭлементМассива,"Номер");
				Если тсНайденныйВозможныйЗаказ <> Неопределено Тогда					
					СумД = тсНайденныйВозможныйЗаказ.СуммаДокумента;
					Если ОплатаВДиапазонеЗаказа(Сумма1, СумД, СтруктураПараметров) Тогда
						бЗаказНайден = Истина;	
						тс.ИдентификацияЗаказа = Перечисления.ИдентификацияЗаказа.ПоПолномуНомеруЗаказаИСумме;
						Прервать;
					КонецЕсли; 		
				КонецЕсли;
				
				чЭлементМассива = ПроверкаНаЧисло(ЭлементМассива);
				Если чЭлементМассива <> 0 Тогда 		
					чВозможныйЗаказ = Число(ЭлементМассива); 
					тсНайденныйВозможныйЗаказ = тзНеоплЗаказы.Найти(чВозможныйЗаказ,"НомерЗаказа");
					Если тсНайденныйВозможныйЗаказ <> Неопределено Тогда					
						СумД = тсНайденныйВозможныйЗаказ.СуммаДокумента;
						Если ОплатаВДиапазонеЗаказа(Сумма1, СумД, СтруктураПараметров) Тогда
							бЗаказНайден = Истина;	
							тс.ИдентификацияЗаказа = Перечисления.ИдентификацияЗаказа.ПоНомеруЗаказаИСумме;
							Прервать;
						КонецЕсли		
					КонецЕсли	
				КонецЕсли;
				
				ЭлементМассива = СокрЛП(ЭлементМассива); 
				тсНайденныйВозможныйЗаказ = тзНеоплЗаказы.Найти(ЭлементМассива,"Номер2");
				Если тсНайденныйВозможныйЗаказ <> Неопределено Тогда					
					СумД = тсНайденныйВозможныйЗаказ.СуммаДокумента;
					Если ОплатаВДиапазонеЗаказа(Сумма1, СумД, СтруктураПараметров) Тогда
						бЗаказНайден = Истина;	
						тс.ИдентификацияЗаказа = Перечисления.ИдентификацияЗаказа.ПоНомеру2ЗаказаИСумме;
						Прервать;
					КонецЕсли; 		
				КонецЕсли;	
			КонецЦикла;
			
			Если бЗаказНайден Тогда
				
				тс.Заказ       = тсНайденныйВозможныйЗаказ.Ссылка;
				тс.СуммаЗаказа = тсНайденныйВозможныйЗаказ.Ссылка.СуммаДокумента;
				тс.Контрагент  = тсНайденныйВозможныйЗаказ.Ссылка.Контрагент;
				//тс.Договор     = ДоговорКонтрагентаПокПост(тс.Контрагент, Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
				тс.Договор     = тс.Заказ.ДоговорКонтрагента;
				тс.Загружать   = Истина;
				
				ОплаченоПозаказу(тс);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиНеоплЗаказ(тсОплат, стрПоиска, стрКолонка, бЗаказНайден, тзНеоплЗаказы, СтруктураПараметров)
	
	уЗаказ = 0;
	
	Для Каждого тс1 Из тзНеоплЗаказы Цикл 
		уЗаказ = уЗаказ + 1;
		Если тс1.Загружен Тогда
			Продолжить;
		КонецЕсли;
		Для уЯзык = 1 По 3 Цикл 	
			Если уЯзык = 1 Тогда
				РасширениеЯзыка = "";
			ИначеЕсли уЯзык = 2 Тогда
				РасширениеЯзыка = "Ру";
			ИначеЕсли уЯзык = 3 Тогда
				РасширениеЯзыка = "Юа";
			КонецЕсли;	
			Если СокрЛП(тс1[стрКолонка+РасширениеЯзыка]) <> стрПоиска Тогда 	
				Продолжить;
			КонецЕсли;
			Если ОплатаВДиапазонеЗаказа(тсОплат.СуммаДокумента, тс1.СуммаДокумента, СтруктураПараметров) Тогда
				бЗаказНайден = Истина;	
				Возврат тс1.Ссылка;
			КонецЕсли		
		КонецЦикла;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ОплаченоПоЗаказу(СтрокаТЗ)
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("Сделка", СтрокаТЗ.Заказ);
	
	ТЗ = РегистрыНакопления.РасчетыСКонтрагентами.Обороты(, , Отбор, "Сделка", "СуммаВзаиморасчетов");
	
	СуммаОплаты = ТЗ.Итог("СуммаВзаиморасчетовРасход");
	
	СтрокаТЗ.СуммаОплаченоПоЗаказу = СуммаОплаты;
	
	//ПлатежноеПоручение = Документы.ПлатежноеПоручениеВходящее.НайтиПоРеквизиту("НомерВходящегоДокумента", СокрЛП(СтрокаТЗ.НомерДок));
	ПлатежноеПоручение = БИАС.НайтиДокументПоБанковскойОперации(СтрокаТЗ.НомерДок);
	
	Если ЗначениеЗаполнено(ПлатежноеПоручение) Тогда
		
		СтрокаТЗ.ПлатежноеПоручениеВходящее = ПлатежноеПоручение;
		СтрокаТЗ.Заказ                      = СтрокаТЗ.ПлатежноеПоручениеВходящее.ДокументОснование;
		СтрокаТЗ.СуммаЗаказа                = СтрокаТЗ.ПлатежноеПоручениеВходящее.СуммаДокумента;
		СтрокаТЗ.Контрагент                 = СтрокаТЗ.ПлатежноеПоручениеВходящее.Контрагент;
		СтрокаТЗ.Договор                    = СтрокаТЗ.ПлатежноеПоручениеВходящее.ДоговорКонтрагента;
		СтрокаТЗ.Загружать                  = Ложь;
		СтрокаТЗ.ИдентификацияЗаказа        = Перечисления.ИдентификацияЗаказа.РучнойВыборЗаказаПоОплате;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ОплатаВДиапазонеЗаказа(СуммаОплаты, СуммаЗаказа, СтруктураПараметров)
	
	чСуммаОт = СуммаЗаказа;
	чСуммаДо = СуммаЗаказа;
	
	ДельтаСуммы   = 0;
	ДельтаПроцент = 0;
	Дельта        = 0;
	
	Если СтруктураПараметров.ТочностьСуммы <> 0 Тогда
		
		ДельтаСуммы = СтруктураПараметров.ТочностьСуммы;
		
	КонецЕсли;
	
	Если СтруктураПараметров.ТочностьПроцент <> 0 Тогда
		
		ДельтаПроцент = СуммаЗаказа * (СтруктураПараметров.ТочностьПроцент / 100);
		
	КонецЕсли;
	
	Если ДельтаПроцент < ДельтаСуммы Тогда
		
		Дельта = ДельтаСуммы;
		
	Иначе
		
		Дельта = ДельтаПроцент;
		
	КонецЕсли;
	
	чСуммаОт = СуммаЗаказа - Дельта;
	чСуммаОт = ?(чСуммаОт < 0, 0, чСуммаОт);
	чСуммаДо = СуммаЗаказа + Дельта;
	
	Если ((СуммаОплаты >= чСуммаОт) И (СуммаОплаты <= чСуммаДо)) Тогда
		
		бВозврат = Истина;
		
	Иначе
		
		бВозврат = Ложь;
		
	КонецЕсли;
	
	Возврат бВозврат;
	
КонецФункции

Процедура ЗагрузитьВПП(СтруктураПараметров, ДокументыКИмпорту)
	
	Для Каждого тс Из ДокументыКИмпорту Цикл
		
		Если Не тс.Загружать Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПоискаВхПП = СокрЛП(тс.НомерДок);
		
		//СсылкаПП = Документы.ПлатежноеПоручениеВходящее.НайтиПоРеквизиту("НомерВходящегоДокумента",СтрокаПоискаВхПП);
		СсылкаПП = БИАС.НайтиДокументПоБанковскойОперации(СтрокаПоискаВхПП);
		
		Если НЕ СсылкаПП=Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка() Тогда
			//тс.НормальнаяОбработка = 3;
		Иначе	
			Док = Документы.ПлатежноеПоручениеВходящее.СоздатьДокумент();
			
			Док.ДокументОснование              = тс.Заказ;
			Док.ДатаВходящегоДокумента         = тс.ДатаПроведения;
			Док.НомерВходящегоДокумента        = СтрокаПоискаВхПП;
			Док.Организация                    = СтруктураПараметров.Организация;
			Док.СчетОрганизации                = тс.ПлатежнаяКарта.БанковскийСчетКарточный;
			Док.Контрагент                     = тс.Контрагент;
			//Док.ДоговорКонтрагента             = ДоговорКонтрагентаПокПост(тс.Контрагент,Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
			Док.ДоговорКонтрагента             = ?(ЗначениеЗаполнено(тс.Договор), тс.Договор, ?(ЗначениеЗаполнено(тс.Заказ), тс.Заказ.ДоговорКонтрагента, ДоговорКонтрагентаПокПост(тс.Контрагент, Перечисления.ВидыДоговоровКонтрагентов.СПокупателем)));
			Док.СуммаДокумента                 = тс.СуммаПоступило;
			Док.ВалютаДокумента                = Справочники.Валюты.НайтиПоКоду(980);
			Док.ВидОперации                    = Перечисления.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ОплатаПокупателя;
			Док.Оплачено                       = Истина;
			Док.ДатаОплаты                     = тс.ДатаПроведения;
			Док.Ответственный                  = ПараметрыСеанса.ТекущийПользователь;
			Док.ОтражатьВУправленческомУчете   = Истина;
			Док.СчетУчетаРасчетовСКонтрагентом = ПланыСчетов.Хозрасчетный.РасчетыСОтечественнымиПокупателями;
			Док.СчетБанк                       = ПланыСчетов.Хозрасчетный.ТекущиеСчетаВНациональнойВалюте;
			Док. Подразделение                 = тс.Заказ.Подразделение; 
			Док.НазначениеПлатежа             = СокрЛП(тс.Терминал) +" ; "+СокрЛП(тс.Содержание);
			
			Док.Комментарий = "1";
			Док.РасшифровкаПлатежа.Очистить();
			
			СтрТЧ = Док.РасшифровкаПлатежа.Добавить();
			
			СтрТЧ.ДоговорКонтрагента = Док.ДоговорКонтрагента;
			СтрТЧ.Сделка             = тс.Заказ;
			
			Если ЗначениеЗаполнено(тс.Заказ.ДоговорКонтрагента) Тогда		
				СтруктураКурсаВзаиморасчетов = МодульВалютногоУчета.ПолучитьКурсВалюты(тс.Заказ.ДоговорКонтрагента.ВалютаВзаиморасчетов, ТекущаяДата());
				СтрТЧ.КурсВзаиморасчетов      = СтруктураКурсаВзаиморасчетов.Курс;
				СтрТЧ.СуммаПлатежа       = тс.СуммаПоступило;
				СтрТЧ.КратностьВзаиморасчетов = СтруктураКурсаВзаиморасчетов.Кратность;
				СтрТЧ.СуммаВзаиморасчетов = тс.СуммаПоступило/СтрТЧ.КурсВзаиморасчетов*СтрТЧ. КратностьВзаиморасчетов;
			Иначе 
				СтрТЧ.КурсВзаиморасчетов      = 1;
				СтрТЧ.КратностьВзаиморасчетов = 1;
				СтрТЧ.СуммаВзаиморасчетов = тс.СуммаПоступило;
			КонецЕсли;
			СтрТЧ.СуммаПлатежа = тс.СуммаПоступило;		
			
			СтрТЧ.СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПокупателя;
			
			Док.Дата = тс.ДатаПроведения;
			тс.ПлатежноеПоручениеВходящее = Док.Ссылка;
			
			Попытка
				Док.Записать(РежимЗаписиДокумента.Запись);  
				//тс.НормальнаяОбработка = 1;
			Исключение 
				//тс.НормальнаяОбработка = -1;
			КонецПопытки;
			Попытка
				Док.Записать(РежимЗаписиДокумента.Проведение);  
				//тс.НормальнаяОбработка = 2;
			Исключение 
				//тс.НормальнаяОбработка = -2;
			КонецПопытки;
		КонецЕсли;					
		
		Если НЕ тс.Заказ = Документы.ЗаказПокупателя.ПустаяСсылка() И НЕ тс.НеПереводитьВОжидаетОтправки Тогда
			ДокЗаказ = тс.Заказ.ПолучитьОбъект();			
			ДокЗаказ.ИдентификацияЗаказа = тс.ИдентификацияЗаказа;
			ДокЗаказ.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Ожидает отправки");
			
			Если тс.Заказ.ДоговорКонтрагента.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом Тогда
			Иначе
				СсылкаДокумент = Неопределено;
				СуммаДолга = УправлениеВзаиморасчетами.ТекущийДолг(тс.Заказ.ДоговорКонтрагента, тс.Заказ, СсылкаДокумент);
				Сумма1 = тс.СуммаПоступило - СтруктураПараметров.ТочностьСуммы; Сумма1=?(Сумма1<0,0,Сумма1);
				Сумма2 = тс.СуммаПоступило + СтруктураПараметров.ТочностьСуммы;
				Если ((Абс(СуммаДолга)>=Сумма1)И(Абс(СуммаДолга)<=Сумма2)) Тогда 
					ДокЗаказ.ДатаОплаты = тс.ДатаПроведения;
				КонецЕсли;
			КонецЕсли;	
			Попытка				
				ДокЗаказ.Записать(РежимЗаписиДокумента.Проведение);  
				//тс.НормальнаяОбработка = 5;
			Исключение 
				//тс.НормальнаяОбработка = -5;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ДоговорКонтрагентаПокПост(Контрагент, ВидДоговора)
	
	ПустойДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат ПустойДоговор;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец = &Контрагент
		|	И НЕ ДоговорыКонтрагентов.ПометкаУдаления
		|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора";
	
	
	Запрос.УстановитьПараметр("Контрагент" , Контрагент);
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;
		
	Иначе
		
		Возврат ПустойДоговор;
		
	КонецЕсли;
	
КонецФункции

Функция Абс(Знач ВхЧисло)
	
	Возврат ?(ВхЧисло < 0, -ВхЧисло, ВхЧисло);
	
КонецФункции

Функция ПолучитьИмяВрФайла(Расширение) Экспорт

	ПолноеИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	ФайлЗапроса = Новый Файл(ПолноеИмяФайла);
	Если Не ФайлЗапроса.Существует() Тогда
		ТекстовыйДокумент = Новый ТекстовыйДокумент;
		ТекстовыйДокумент.Записать(ФайлЗапроса.ПолноеИмя)
	КонецЕсли;
	Возврат ФайлЗапроса

