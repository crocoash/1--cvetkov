// Услуга кампании. Номенклатура заводится один раз и запоминается в самой
// кампании: имя кампании в кабинете может смениться, ссылка - нет.
Функция НоменклатураКампании(Кампания, Канал)

	Если Не ЗначениеЗаполнено(Кампания) Тогда
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецЕсли;

	Номенклатура = Кампания.Номенклатура;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Номенклатура;
	КонецЕсли;

	Попытка

		Элемент = Справочники.Номенклатура.СоздатьЭлемент();
		Элемент.Наименование = Лев("Реклама: " + СокрЛП(Кампания.Наименование), 100);
		Элемент.Услуга = Истина;
		Элемент.Записать();

		Кампания1 = Кампания.ПолучитьОбъект();
		Кампания1.Номенклатура = Элемент.Ссылка;
		Кампания1.Записать();

		Возврат Элемент.Ссылка;

	Исключение

		ЗаписьЖурналаРегистрации(
			"ЗагрузкаРекламногоРасхода",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось завести услугу для кампании " + Строка(Кампания) + ": " + ОписаниеОшибки()
		);

		Возврат Справочники.Номенклатура.ПустаяСсылка();

	КонецПопытки;

КонецФункции

// Найти или завести кампанию. Ищем по идентификатору кабинета, а не по имени:
// имя кампании переживает переименования только как подпись.
// Сегмент подсказкой сайта заполняется ТОЛЬКО при создании - дальше он
// назначается руками в 1С и подсказку переопределяет.
Функция КампанияПоСтроке(Стр, Ключ, Кэш)

	Ид   = СокрЛП(Строка(Стр.Получить("campaign_id")));
	Имя  = Лев(СокрЛП(Строка(Стр.Получить("campaign"))), 150);
	Канал = Лев(СокрЛП(Строка(Стр.Получить("channel"))), 32);

	Если ПустаяСтрока(Ид) И ПустаяСтрока(Имя) Тогда
		Возврат Справочники.РекламныеКампании.ПустаяСсылка();
	КонецЕсли;

	КлючКэша = ?(ПустаяСтрока(Ид), "имя:" + Канал + "|" + Имя, "ид:" + Ид);

	Ссылка = Кэш.Получить(КлючКэша);
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;

	Ссылка = НайтиКампанию(Ид, Имя, Канал);

	Если Ссылка = Неопределено Тогда

		Элемент = Справочники.РекламныеКампании.СоздатьЭлемент();
		Элемент.Наименование = Имя;
		Элемент.ИдентификаторКампании = Ид;
		Элемент.Канал = Канал;
		Элемент.КлючИсточника = Ключ;
		Элемент.Сегмент = СегментПоПодсказке(Стр.Получить("segment_hint"));

		Попытка
			Элемент.Записать();
			Ссылка = Элемент.Ссылка;
		Исключение
			ЗаписьЖурналаРегистрации(
				"ЗагрузкаРекламногоРасхода",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"Не удалось создать кампанию """ + Имя + """: " + ОписаниеОшибки()
			);
			Ссылка = Справочники.РекламныеКампании.ПустаяСсылка();
		КонецПопытки;

	Иначе

		ОбновитьКампанию(Ссылка, Имя, Канал, Ключ);

	КонецЕсли;

	Кэш.Вставить(КлючКэша, Ссылка);

	Возврат Ссылка;

КонецФункции

Функция НайтиКампанию(Ид, Имя, Канал)

	Запрос = Новый Запрос;

	Если Не ПустаяСтрока(Ид) Тогда
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	РекламныеКампании.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.РекламныеКампании КАК РекламныеКампании
			|ГДЕ
			|	РекламныеКампании.ИдентификаторКампании = &Ид";
		Запрос.УстановитьПараметр("Ид", Ид);
	Иначе
		// Кампания без идентификатора (ручной ввод на сайте, история до разметки
		// кабинетов): другого признака, кроме имени в своём канале, у неё нет
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	РекламныеКампании.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.РекламныеКампании КАК РекламныеКампании
			|ГДЕ
			|	РекламныеКампании.Наименование = &Имя
			|	И РекламныеКампании.Канал = &Канал
			|	И РекламныеКампании.ИдентификаторКампании = """"";
		Запрос.УстановитьПараметр("Имя", Имя);
		Запрос.УстановитьПараметр("Канал", Канал);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Переименование в кабинете подтягиваем, сегмент и тип цен не трогаем.
Процедура ОбновитьКампанию(Ссылка, Имя, Канал, Ключ)

	Если ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;

	Если СокрЛП(Ссылка.Наименование) = Имя
		И СокрЛП(Ссылка.Канал) = Канал
		И СокрЛП(Ссылка.КлючИсточника) = Ключ Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Элемент = Ссылка.ПолучитьОбъект();
		Элемент.Наименование = Имя;
		Элемент.Канал = Канал;
		Элемент.КлючИсточника = Ключ;
		Элемент.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(
			"ЗагрузкаРекламногоРасхода",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не удалось обновить кампанию """ + Имя + """: " + ОписаниеОшибки()
		);
	КонецПопытки;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНОЕ

// Одна кампания может прийти двумя строками одного дня - складываем заранее,
// иначе в документе будут две строки услуг на одну услугу.
Функция СвернутьСтроки(Массив)

	Свод = Новый Соответствие;

	Для Каждого Стр Из Массив Цикл
		КлючСтроки = Строка(Стр.Кампания) + Символы.ПС + Стр.Ключ;
		Текущая = Свод.Получить(КлючСтроки);
		Если Текущая = Неопределено Тогда
			Свод.Вставить(КлючСтроки, Новый Структура("Кампания, Ключ, Сумма",
				Стр.Кампания, Стр.Ключ, Стр.Сумма));
		Иначе
			Текущая.Сумма = Текущая.Сумма + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого КЗ Из Свод Цикл
		Результат.Добавить(КЗ.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СегментПоПодсказке(Подсказка)

	Значение = НРег(СокрЛП(Строка(Подсказка)));

	Если Значение = "opt" Тогда
		Возврат Перечисления.СегментыРекламы.Опт;
	ИначеЕсли Значение = "drop" Тогда
		Возврат Перечисления.СегментыРекламы.Дропшип;
	ИначеЕсли Значение = "rozn" Тогда
		Возврат Перечисления.СегментыРекламы.Розница;
	КонецЕсли;

	Возврат Перечисления.СегментыРекламы.ПустаяСсылка();

КонецФункции

Функция ДатаИзСтроки(Значение, ПоУмолчанию)

	Стр = СокрЛП(Строка(Значение));

	Если СтрДлина(Стр) < 10 Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Попытка
		Возврат Дата(Число(Лев(Стр, 4)), Число(Сред(Стр, 6, 2)), Число(Сред(Стр, 9, 2)));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;

КонецФункции

Функция ЧислоИзЗначения(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Число(СтрЗаменить(СокрЛП(Строка(Значение)), ",", "."));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции
