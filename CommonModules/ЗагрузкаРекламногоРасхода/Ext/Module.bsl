// ДОКУМЕНТЫ НАЧИСЛЕНИЯ

// Маркер в комментарии документа: по нему документ находится при следующем
// прогоне. Реквизита под это в типовом документе нет, а комментарий свободен
// и виден человеку - в журнале сразу понятно, что документ автоматический.
Функция МаркерДокумента(День, Канал, ТипЦен)

	Возврат "АвтоРеклама|" + Формат(День, "ДФ=yyyy-MM-dd") + "|" + Канал
		+ "|" + СокрЛП(Строка(ТипЦен));

КонецФункции

Функция ЗаписатьДокументы(Организация, ОкноНачало, ОкноКонец, Группы)

	Итог = Новый Структура("Документов, НеПроведено, Лишних", 0, 0, 0);

	Существующие = НайтиДокументыОкна(ОкноНачало, ОкноКонец);
	Использованные = Новый Соответствие;

	Для Каждого КЗ Из Группы Цикл

		Группа = КЗ.Значение;
		Маркер = МаркерДокумента(Группа.День, Группа.Канал, Группа.ТипЦен);

		Ссылка = Существующие.Получить(Маркер);
		Использованные.Вставить(Маркер, Истина);

		Попытка
			Проведён = ЗаписатьДокументГруппы(Организация, Группа, Маркер, Ссылка);
			Итог.Документов = Итог.Документов + 1;
			Если Не Проведён Тогда
				Итог.НеПроведено = Итог.НеПроведено + 1;
			КонецЕсли;
		Исключение
			ЗаписьЖурналаРегистрации(
				"ЗагрузкаРекламногоРасхода",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"Не удалось записать документ " + Маркер + ": " + ОписаниеОшибки()
			);
		КонецПопытки;

	КонецЦикла;

	// Расход дня мог обнулиться - документ без строк держать нельзя.
	// Не удаляем физически: на нём могли повиснуть взаиморасчёты, поэтому
	// только пометка удаления и запись в журнал.
	Для Каждого КЗ Из Существующие Цикл
		Если Использованные.Получить(КЗ.Ключ) = Неопределено Тогда
			Попытка
				Объект = КЗ.Значение.ПолучитьОбъект();
				Объект.УстановитьПометкуУдаления(Истина);
				Итог.Лишних = Итог.Лишних + 1;
			Исключение
				ЗаписьЖурналаРегистрации(
					"ЗагрузкаРекламногоРасхода",
					УровеньЖурналаРегистрации.Предупреждение,
					,
					,
					"Не удалось пометить на удаление " + КЗ.Ключ + ": " + ОписаниеОшибки()
				);
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;

КонецФункции

// Соответствие вида «маркер - ссылка» по документам окна.
Функция НайтиДокументыОкна(ОкноНачало, ОкноКонец)

	Результат = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка,
		|	ПоступлениеТоваровУслуг.Комментарий КАК Комментарий
		|ИЗ
		|	Документ.ПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Дата МЕЖДУ &Начало И &Конец
		|	И ПоступлениеТоваровУслуг.Комментарий ПОДОБНО &Маркер";
	Запрос.УстановитьПараметр("Начало", НачалоДня(ОкноНачало));
	Запрос.УстановитьПараметр("Конец", КонецДня(ОкноКонец));
	Запрос.УстановитьПараметр("Маркер", "АвтоРеклама|%");

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Результат.Вставить(СокрЛП(Выборка.Комментарий), Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Записать один документ группы. Возвращает Истина, если удалось провести.
Функция ЗаписатьДокументГруппы(Организация, Группа, Маркер, Ссылка)

	Если Ссылка = Неопределено Тогда
		Документ = Документы.ПоступлениеТоваровУслуг.СоздатьДокумент();
		Документ.Дата = НачалоДня(Группа.День) + 12 * 3600;
	Иначе
		Документ = Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Контрагент = КонтрагентКанала(Группа.Канал);
	Договор    = ДоговорПоставщика(Контрагент, Организация);

	Документ.Организация      = Организация;
	Документ.Контрагент       = Контрагент;
	Документ.ДоговорКонтрагента = Договор;
	Документ.ВалютаДокумента  = ВалютаГривна();
	Документ.КурсВзаиморасчетов    = 1;
	Документ.КратностьВзаиморасчетов = 1;
	Документ.ТипЦен           = Группа.ТипЦен;
	Документ.ВидОперации      = Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия;
	Документ.Комментарий      = Маркер;
	// Реклама Google и Meta приходит без украинского НДС; бухгалтерский учёт
	// не включаем - иначе проведение требует счетов учёта, которых у этих
	// поставщиков в базе нет
	Документ.УчитыватьНДС     = Ложь;
	Документ.СуммаВключаетНДС = Истина;
	Документ.ОтражатьВУправленческомУчете = Истина;
	Документ.ОтражатьВБухгалтерскомУчете  = Ложь;

	Документ.Услуги.Очистить();

	СтатьяЗатрат = СтатьяЗатратРекламы();
	НоменклатурнаяГруппа = НоменклатурнаяГруппаРекламы();
	Всего = 0;

	Для Каждого СтрокаРасхода Из СвернутьСтроки(Группа.Строки) Цикл

		Номенклатура = НоменклатураКампании(СтрокаРасхода.Кампания, Группа.Канал);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;

		// Ключа склейки в строке услуг держать негде: «Содержание» здесь - ссылка
		// на номенклатуру, а не текст. Ключ живёт в самой кампании
		// (реквизит КлючИсточника), отчёт достаёт его соединением по номенклатуре.
		СтрокаУслуг = Документ.Услуги.Добавить();
		СтрокаУслуг.Номенклатура = Номенклатура;
		СтрокаУслуг.Количество   = 1;
		СтрокаУслуг.Цена         = СтрокаРасхода.Сумма;
		СтрокаУслуг.Сумма        = СтрокаРасхода.Сумма;
		СтрокаУслуг.СтавкаНДС    = Перечисления.СтавкиНДС.БезНДС;
		СтрокаУслуг.СуммаНДС     = 0;
		СтрокаУслуг.СтатьяЗатрат = СтатьяЗатрат;
		СтрокаУслуг.НоменклатурнаяГруппа = НоменклатурнаяГруппа;

		Всего = Всего + СтрокаРасхода.Сумма;

	КонецЦикла;

	Документ.СуммаДокумента = Всего;

	Если Документ.Услуги.Количество() = 0 Тогда
		// Нечего начислять - документ не заводим
		Возврат Истина;
	КонецЕсли;

	Попытка
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		Возврат Истина;
	Исключение
		ЗаписьЖурналаРегистрации(
			"ЗагрузкаРекламногоРасхода",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Документ " + Маркер + " записан без проведения: " + ОписаниеОшибки()
		);
	КонецПопытки;

	Документ.Записать(РежимЗаписиДокумента.Запись);

	Возврат Ложь;

КонецФункции

