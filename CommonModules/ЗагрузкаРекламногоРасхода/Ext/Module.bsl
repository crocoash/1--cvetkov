// Загрузка расхода рекламных кабинетов с сайта в регистр сведений
// РекламныйРасход. Источник - shop/ad_spend_export.php на cvetkovtm.com:
// он отдаёт то, что уже собрали крон Meta и скрипт кабинета Google Ads.
//
// Ключ склейки с выручкой - поле "key": ровно та строка, которая лежит
// в реквизите referrer заказа покупателя («utm_source utm_campaign»).
// Строки без идентификатора кампании получают ключ уровня канала
// («google ads» / «facebook ads») и в отчёте садятся на заказы,
// у которых кампания не определилась.
//
// Адрес и токен зашиты прямо здесь: заполнять их в базе после каждой загрузки
// конфигурации - лишний шаг, о котором забывают, и загрузка молча стоит.
// Одноимённые константы, если их заполнить, значение переопределяют - это путь
// сменить токен без Конфигуратора.
//
// Расписание регламентного задания в метаданных не хранится, его задают
// в самой базе.

// Адрес выгрузки на сайте: константа, иначе зашитое значение.
Функция АдресВыгрузки() Экспорт

	Значение = СокрЛП(Строка(Константы.АдресРекламногоРасхода.Получить()));

	Если ПустаяСтрока(Значение) Тогда
		Значение = "https://cvetkovtm.com/assets/shop/ad_spend_export.php";
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Токен выгрузки: константа, иначе зашитое значение.
// Совпадает с AD_SPEND_EXPORT_TOKEN в shop/ad_spend_export.php - меняются парой.
Функция ТокенВыгрузки() Экспорт

	Значение = СокрЛП(Строка(Константы.ТокенРекламногоРасхода.Получить()));

	Если ПустаяСтрока(Значение) Тогда
		Значение = "4f1c9d0a7b3e42a58c6d10e9fb27a453";
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Точка входа регламентного задания: скользящее окно последних дней.
// Кабинеты уточняют расход задним числом, поэтому перезагружаем неделю,
// а не только вчера.
Процедура ЗаданиеЗагрузка() Экспорт

	Рез = ЗагрузитьЗаПериод(НачалоДня(ТекущаяДатаСеанса() - 7 * 86400), НачалоДня(ТекущаяДатаСеанса()));

	Если Рез.Успешно Тогда
		ЗаписьЖурналаРегистрации(
			"ЗагрузкаРекламногоРасхода",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			Рез.Сообщение
		);
	Иначе
		ЗаписьЖурналаРегистрации(
			"ЗагрузкаРекламногоРасхода",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			Рез.Сообщение
		);
	КонецЕсли;

КонецПроцедуры

// Загрузить расход за период. Дни окна перезаписываются целиком: день,
// у которого расход обнулился, обязан обнулиться и здесь, а простая
// дозапись оставила бы старые строки навсегда.
//
// Возврат: структура Успешно / Сообщение / Строк / Сумма.
Функция ЗагрузитьЗаПериод(ДатаНач, ДатаКон) Экспорт

	Рез = Новый Структура("Успешно, Сообщение, Строк, Сумма", Ложь, "", 0, 0);

	Начало = НачалоДня(?(ЗначениеЗаполнено(ДатаНач), ДатаНач, ТекущаяДатаСеанса() - 30 * 86400));
	Конец  = НачалоДня(?(ЗначениеЗаполнено(ДатаКон), ДатаКон, ТекущаяДатаСеанса()));

	Если Начало > Конец Тогда
		Врем   = Начало;
		Начало = Конец;
		Конец  = Врем;
	КонецЕсли;

	Ответ = ПолучитьВыгрузку(Начало, Конец);
	Если Не Ответ.Успешно Тогда
		Рез.Сообщение = Ответ.Сообщение;
		Возврат Рез;
	КонецЕсли;

	Данные = Ответ.Данные;

	Если Данные.Получить("ok") <> Истина Тогда
		Рез.Сообщение = "Сайт ответил ошибкой: " + Строка(Данные.Получить("error"));
		Возврат Рез;
	КонецЕсли;

	// Окно берём из ответа, а не из запроса: сайт мог обрезать его своим потолком,
	// и чистить дни, которых он не присылал, нельзя
	ОкноНачало = ДатаИзСтроки(Данные.Получить("from"), Начало);
	ОкноКонец  = ДатаИзСтроки(Данные.Получить("to"), Конец);

	Строки = Данные.Получить("rows");
	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Рез.Сообщение = "В ответе нет массива rows.";
		Возврат Рез;
	КонецЕсли;

	КэшКампаний = Новый Соответствие;
	ПоДням = Новый Соответствие;
	ВсегоСумма = 0;

	Для Каждого Стр Из Строки Цикл

		Если ТипЗнч(Стр) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		День = ДатаИзСтроки(Стр.Получить("date"), Дата(1, 1, 1));
		Если Не ЗначениеЗаполнено(День) Тогда
			Продолжить;
		КонецЕсли;

		Сумма = ЧислоИзЗначения(Стр.Получить("spend_uah"));
		Если Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;

		// Ключ режем по длине измерения: реквизит referrer заказа тоже Строка(200),
		// и платформа усекает его молча - обрезать надо одинаково с обеих сторон,
		// иначе длинные ключи никогда не совпадут
		Ключ = Лев(СокрЛП(Строка(Стр.Получить("key"))), 200);

		Кампания = КампанияПоСтроке(Стр, КэшКампаний);

		Записи = ПоДням.Получить(День);
		Если Записи = Неопределено Тогда
			Записи = Новый Массив;
			ПоДням.Вставить(День, Записи);
		КонецЕсли;

		Записи.Добавить(Новый Структура("Кампания, Ключ, Сумма", Кампания, Ключ, Сумма));
		ВсегоСумма = ВсегоСумма + Сумма;

	КонецЦикла;

	Записано = ЗаписатьОкно(ОкноНачало, ОкноКонец, ПоДням);

	Рез.Успешно  = Истина;
	Рез.Строк    = Записано;
	Рез.Сумма    = ВсегоСумма;
	Рез.Сообщение =
		"Рекламный расход "
		+ Формат(ОкноНачало, "ДФ=dd.MM.yyyy") + "-" + Формат(ОкноКонец, "ДФ=dd.MM.yyyy")
		+ ": строк " + Строка(Записано)
		+ ", сумма " + Формат(ВсегоСумма, "ЧДЦ=2; ЧРГ=' '") + " грн.";

	Возврат Рез;

КонецФункции

// Запросить выгрузку у сайта и разобрать JSON.
Функция ПолучитьВыгрузку(Начало, Конец)

	Рез = Новый Структура("Успешно, Сообщение, Данные", Ложь, "", Неопределено);

	Адрес = АдресВыгрузки();
	Токен = ТокенВыгрузки();

	Хост = Адрес;
	Хост = СтрЗаменить(Хост, "https://", "");
	Хост = СтрЗаменить(Хост, "http://", "");

	Поз = Найти(Хост, "/");
	Если Поз = 0 Тогда
		Рез.Сообщение = "В адресе выгрузки нет пути к файлу: " + Адрес;
		Возврат Рез;
	КонецЕсли;

	Путь = Сред(Хост, Поз);
	Хост = Лев(Хост, Поз - 1);

	Ресурс = Путь
		+ "?token=" + Токен
		+ "&from=" + Формат(Начало, "ДФ=yyyy-MM-dd")
		+ "&to=" + Формат(Конец, "ДФ=yyyy-MM-dd");

	Попытка

		Соединение = Новый HTTPСоединение(Хост, 443, , , , 60, Истина);
		Запрос = Новый HTTPЗапрос(Ресурс);
		HTTPОтвет = Соединение.Получить(Запрос);

		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Рез.Сообщение = "Сайт вернул код " + Строка(HTTPОтвет.КодСостояния)
				+ " по адресу " + Хост + Путь;
			Возврат Рез;
		КонецЕсли;

		Тело = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");

		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Рез.Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();

	Исключение

		Рез.Сообщение = "Не удалось получить рекламный расход: " + ОписаниеОшибки();
		Возврат Рез;

	КонецПопытки;

	Если ТипЗнч(Рез.Данные) <> Тип("Соответствие") Тогда
		Рез.Сообщение = "Сайт вернул не JSON-объект.";
		Возврат Рез;
	КонецЕсли;

	Рез.Успешно = Истина;

	Возврат Рез;

КонецФункции

// Найти или завести кампанию. Ищем по идентификатору кабинета, а не по имени:
// имя кампании переживает переименования только как подпись.
// Сегмент подсказкой сайта заполняется ТОЛЬКО при создании - дальше он
// назначается руками в 1С и подсказку переопределяет.
Функция КампанияПоСтроке(Стр, Кэш)

	Ид   = СокрЛП(Строка(Стр.Получить("campaign_id")));
	Имя  = Лев(СокрЛП(Строка(Стр.Получить("campaign"))), 150);
	Канал = Лев(СокрЛП(Строка(Стр.Получить("channel"))), 32);

	Если ПустаяСтрока(Ид) И ПустаяСтрока(Имя) Тогда
		// Расход канала без разбивки - кампании у него нет
		Возврат Справочники.РекламныеКампании.ПустаяСсылка();
	КонецЕсли;

	КлючКэша = ?(ПустаяСтрока(Ид), "имя:" + Канал + "|" + Имя, "ид:" + Ид);

	Ссылка = Кэш.Получить(КлючКэша);
	Если Ссылка <> Неопределено Тогда
		Возврат Ссылка;
	КонецЕсли;

	Ссылка = НайтиКампанию(Ид, Имя, Канал);

	Если Ссылка = Неопределено Тогда

		Элемент = Справочники.РекламныеКампании.СоздатьЭлемент();
		Элемент.Наименование = Имя;
		Элемент.ИдентификаторКампании = Ид;
		Элемент.Канал = Канал;
		Элемент.Сегмент = СегментПоПодсказке(Стр.Получить("segment_hint"));

		Попытка
			Элемент.Записать();
			Ссылка = Элемент.Ссылка;
		Исключение
			ЗаписьЖурналаРегистрации(
				"ЗагрузкаРекламногоРасхода",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"Не удалось создать кампанию """ + Имя + """: " + ОписаниеОшибки()
			);
			Ссылка = Справочники.РекламныеКампании.ПустаяСсылка();
		КонецПопытки;

	Иначе

		ОбновитьКампанию(Ссылка, Имя, Канал);

	КонецЕсли;

	Кэш.Вставить(КлючКэша, Ссылка);

	Возврат Ссылка;

КонецФункции

Функция НайтиКампанию(Ид, Имя, Канал)

	Запрос = Новый Запрос;

	Если Не ПустаяСтрока(Ид) Тогда
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	РекламныеКампании.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.РекламныеКампании КАК РекламныеКампании
			|ГДЕ
			|	РекламныеКампании.ИдентификаторКампании = &Ид";
		Запрос.УстановитьПараметр("Ид", Ид);
	Иначе
		// Кампания без идентификатора (ручной ввод на сайте, история до разметки
		// кабинетов): другого признака, кроме имени в своём канале, у неё нет
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	РекламныеКампании.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.РекламныеКампании КАК РекламныеКампании
			|ГДЕ
			|	РекламныеКампании.Наименование = &Имя
			|	И РекламныеКампании.Канал = &Канал
			|	И РекламныеКампании.ИдентификаторКампании = """"";
		Запрос.УстановитьПараметр("Имя", Имя);
		Запрос.УстановитьПараметр("Канал", Канал);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Переименование в кабинете подтягиваем, сегмент не трогаем.
Процедура ОбновитьКампанию(Ссылка, Имя, Канал)

	Если ПустаяСтрока(Имя) Тогда
		Возврат;
	КонецЕсли;

	Если СокрЛП(Ссылка.Наименование) = Имя И СокрЛП(Ссылка.Канал) = Канал Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Элемент = Ссылка.ПолучитьОбъект();
		Элемент.Наименование = Имя;
		Элемент.Канал = Канал;
		Элемент.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(
			"ЗагрузкаРекламногоРасхода",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не удалось обновить кампанию """ + Имя + """: " + ОписаниеОшибки()
		);
	КонецПопытки;

КонецПроцедуры

// Перезаписать окно по дням. День без строк остаётся пустым - расход
// действительно мог обнулиться, и старые записи там держать нельзя.
Функция ЗаписатьОкно(ОкноНачало, ОкноКонец, ПоДням)

	Записано = 0;
	День = ОкноНачало;

	Пока День <= ОкноКонец Цикл

		НаборЗаписей = РегистрыСведений.РекламныйРасход.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Период.Установить(День);

		Записи = ПоДням.Получить(День);

		Если Записи <> Неопределено Тогда
			Для Каждого ЗаписьДня Из СвернутьЗаписи(Записи) Цикл
				Запись = НаборЗаписей.Добавить();
				Запись.Период   = День;
				Запись.Кампания = ЗаписьДня.Кампания;
				Запись.Ключ     = ЗаписьДня.Ключ;
				Запись.Сумма    = ЗаписьДня.Сумма;
				Записано = Записано + 1;
			КонецЦикла;
		КонецЕсли;

		НаборЗаписей.Записать(Истина);

		День = День + 86400;

	КонецЦикла;

	Возврат Записано;

КонецФункции

// Строки одного дня могут прийти двумя строками с одинаковым ключом
// (одна кампания в двух строках выгрузки) - набор записей независимого
// регистра такого дубля не примет, поэтому сворачиваем заранее.
Функция СвернутьЗаписи(Массив)

	Свод = Новый Соответствие;

	Для Каждого Стр Из Массив Цикл
		КлючСтроки = Строка(Стр.Кампания) + Символы.ПС + Стр.Ключ;
		Текущая = Свод.Получить(КлючСтроки);
		Если Текущая = Неопределено Тогда
			Свод.Вставить(КлючСтроки, Новый Структура("Кампания, Ключ, Сумма",
				Стр.Кампания, Стр.Ключ, Стр.Сумма));
		Иначе
			Текущая.Сумма = Текущая.Сумма + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Для Каждого КЗ Из Свод Цикл
		Результат.Добавить(КЗ.Значение);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СегментПоПодсказке(Подсказка)

	Значение = НРег(СокрЛП(Строка(Подсказка)));

	Если Значение = "opt" Тогда
		Возврат Перечисления.СегментыРекламы.Опт;
	ИначеЕсли Значение = "drop" Тогда
		Возврат Перечисления.СегментыРекламы.Дропшип;
	ИначеЕсли Значение = "rozn" Тогда
		Возврат Перечисления.СегментыРекламы.Розница;
	КонецЕсли;

	Возврат Перечисления.СегментыРекламы.ПустаяСсылка();

КонецФункции

Функция ДатаИзСтроки(Значение, ПоУмолчанию)

	Стр = СокрЛП(Строка(Значение));

	Если СтрДлина(Стр) < 10 Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Попытка
		Возврат Дата(Число(Лев(Стр, 4)), Число(Сред(Стр, 6, 2)), Число(Сред(Стр, 9, 2)));
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;

КонецФункции

Функция ЧислоИзЗначения(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Число(СтрЗаменить(СокрЛП(Строка(Значение)), ",", "."));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции
