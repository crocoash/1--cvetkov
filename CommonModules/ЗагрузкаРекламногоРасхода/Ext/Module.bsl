// Загрузка расхода рекламных кабинетов с сайта в документы «Поступление
// товаров и услуг». Источник - shop/ad_spend_export.php на cvetkovtm.com:
// он отдаёт то, что уже собрали крон Meta и скрипт кабинета Google Ads.
//
// Почему документами, а не регистром: расход - это покупка услуги у поставщика.
// Документ даёт контрагента, номенклатуру и кредиторку, которую закрывает
// исходящий платёж из обмена Приват24. Заодно строки расхода ложатся на те же
// группировки отчёта «Ведомость реализации», что и продажи.
//
// Документ = день х канал х тип цен. Тип цен берётся у кампании и нужен затем,
// чтобы расход попал в ту же ветку отчёта, что и продажи своего сегмента;
// в одном канале за день бывают и оптовые, и розничные кампании, а тип цен
// в документе один - отсюда и деление.
//
// Идемпотентность: документ находится по маркеру в комментарии
// (см. МаркерДокумента), строки услуг перезаписываются целиком. Повторный
// прогон того же окна дублей не создаёт.
//
// Ключ склейки с выручкой - поле "key" сайта: ровно та строка, которая лежит
// в реквизите referrer заказа покупателя («utm_source utm_campaign»).
// Он кладётся в «Содержание» строки услуг, оттуда его читает отчёт.
//
// Адрес и токен зашиты в АдресВыгрузки и ТокенВыгрузки; одноимённые константы,
// если их заполнить, значение переопределяют. Расписание регламентного задания
// в метаданных не хранится, его задают в самой базе.

// Адрес выгрузки на сайте: константа, иначе зашитое значение.
Функция АдресВыгрузки() Экспорт

	Значение = СокрЛП(Строка(Константы.АдресРекламногоРасхода.Получить()));

	Если ПустаяСтрока(Значение) Тогда
		Значение = "https://cvetkovtm.com/assets/shop/ad_spend_export.php";
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Токен выгрузки: константа, иначе зашитое значение.
// Совпадает с AD_SPEND_EXPORT_TOKEN в shop/ad_spend_export.php - меняются парой.
Функция ТокенВыгрузки() Экспорт

	Значение = СокрЛП(Строка(Константы.ТокенРекламногоРасхода.Получить()));

	Если ПустаяСтрока(Значение) Тогда
		Значение = "4f1c9d0a7b3e42a58c6d10e9fb27a453";
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Точка входа регламентного задания: скользящее окно последних дней.
// Кабинеты уточняют расход задним числом, поэтому перезагружаем неделю,
// а не только вчера.
Процедура ЗаданиеЗагрузка() Экспорт

	Рез = ЗагрузитьЗаПериод(НачалоДня(ТекущаяДатаСеанса() - 7 * 86400), НачалоДня(ТекущаяДатаСеанса()));

	Если Рез.Успешно Тогда
		Уровень = УровеньЖурналаРегистрации.Информация;
	Иначе
		Уровень = УровеньЖурналаРегистрации.Ошибка;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ЗагрузкаРекламногоРасхода", Уровень, , , Рез.Сообщение);

КонецПроцедуры

// Загрузить расход за период и разложить по документам поступления.
// Возврат: структура Успешно / Сообщение / Документов / Сумма.
Функция ЗагрузитьЗаПериод(ДатаНач, ДатаКон) Экспорт

	Рез = Новый Структура("Успешно, Сообщение, Документов, Сумма", Ложь, "", 0, 0);

	Начало = НачалоДня(?(ЗначениеЗаполнено(ДатаНач), ДатаНач, ТекущаяДатаСеанса() - 30 * 86400));
	Конец  = НачалоДня(?(ЗначениеЗаполнено(ДатаКон), ДатаКон, ТекущаяДатаСеанса()));

	Если Начало > Конец Тогда
		Врем   = Начало;
		Начало = Конец;
		Конец  = Врем;
	КонецЕсли;

	Ответ = ПолучитьВыгрузку(Начало, Конец);
	Если Не Ответ.Успешно Тогда
		Рез.Сообщение = Ответ.Сообщение;
		Возврат Рез;
	КонецЕсли;

	Данные = Ответ.Данные;

	Если Данные.Получить("ok") <> Истина Тогда
		Рез.Сообщение = "Сайт ответил ошибкой: " + Строка(Данные.Получить("error"));
		Возврат Рез;
	КонецЕсли;

	Организация = ОрганизацияНачисления();
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Рез.Сообщение =
			"Не определена организация: в справочнике их несколько,"
			+ " заполните константу ОрганизацияРекламы.";
		Возврат Рез;
	КонецЕсли;

	// Окно берём из ответа: сайт мог обрезать его своим потолком, и трогать дни,
	// которых он не присылал, нельзя
	ОкноНачало = ДатаИзСтроки(Данные.Получить("from"), Начало);
	ОкноКонец  = ДатаИзСтроки(Данные.Получить("to"), Конец);

	Строки = Данные.Получить("rows");
	Если ТипЗнч(Строки) <> Тип("Массив") Тогда
		Рез.Сообщение = "В ответе нет массива rows.";
		Возврат Рез;
	КонецЕсли;

	КэшКампаний = Новый Соответствие;
	Группы = Новый Соответствие;
	ВсегоСумма = 0;

	Для Каждого Стр Из Строки Цикл

		Если ТипЗнч(Стр) <> Тип("Соответствие") Тогда
			Продолжить;
		КонецЕсли;

		День = ДатаИзСтроки(Стр.Получить("date"), Дата(1, 1, 1));
		Если Не ЗначениеЗаполнено(День) Тогда
			Продолжить;
		КонецЕсли;

		Сумма = ЧислоИзЗначения(Стр.Получить("spend_uah"));
		Если Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;

		Канал = Лев(СокрЛП(Строка(Стр.Получить("channel"))), 32);

		// Ключ режем по длине реквизита referrer заказа - Строка(200). Платформа
		// усекает молча, обрезать надо одинаково с обеих сторон, иначе длинные
		// ключи никогда не совпадут
		Ключ = Лев(СокрЛП(Строка(Стр.Получить("key"))), 200);

		Кампания = КампанияПоСтроке(Стр, Ключ, КэшКампаний);

		ТипЦен = Неопределено;
		Если ЗначениеЗаполнено(Кампания) Тогда
			ТипЦен = Кампания.ТипЦен;
		КонецЕсли;
		Если ТипЦен = Неопределено Тогда
			ТипЦен = Справочники.ТипыЦенНоменклатуры.ПустаяСсылка();
		КонецЕсли;

		КлючГруппы = Формат(День, "ДФ=yyyyMMdd") + "|" + Канал + "|" + Строка(ТипЦен.УникальныйИдентификатор());

		Группа = Группы.Получить(КлючГруппы);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("День, Канал, ТипЦен, Строки", День, Канал, ТипЦен, Новый Массив);
			Группы.Вставить(КлючГруппы, Группа);
		КонецЕсли;

		Группа.Строки.Добавить(Новый Структура("Кампания, Ключ, Сумма", Кампания, Ключ, Сумма));
		ВсегоСумма = ВсегоСумма + Сумма;

	КонецЦикла;

	Итог = ЗаписатьДокументы(Организация, ОкноНачало, ОкноКонец, Группы);

	Рез.Успешно   = Истина;
	Рез.Документов = Итог.Документов;
	Рез.Сумма     = ВсегоСумма;
	Рез.Сообщение =
		"Рекламный расход "
		+ Формат(ОкноНачало, "ДФ=dd.MM.yyyy") + "-" + Формат(ОкноКонец, "ДФ=dd.MM.yyyy")
		+ ": документов " + Строка(Итог.Документов)
		+ ", сумма " + Формат(ВсегоСумма, "ЧДЦ=2; ЧРГ=' '") + " грн."
		+ ?(Итог.НеПроведено = 0, "", " НЕ ПРОВЕДЕНО: " + Строка(Итог.НеПроведено))
		+ ?(Итог.Лишних = 0, "", " помечено на удаление: " + Строка(Итог.Лишних));

	Возврат Рез;

КонецФункции

// Запросить выгрузку у сайта и разобрать JSON.
Функция ПолучитьВыгрузку(Начало, Конец)

	Рез = Новый Структура("Успешно, Сообщение, Данные", Ложь, "", Неопределено);

	Адрес = АдресВыгрузки();
	Токен = ТокенВыгрузки();

	Хост = Адрес;
	Хост = СтрЗаменить(Хост, "https://", "");
	Хост = СтрЗаменить(Хост, "http://", "");

	Поз = Найти(Хост, "/");
	Если Поз = 0 Тогда
		Рез.Сообщение = "В адресе выгрузки нет пути к файлу: " + Адрес;
		Возврат Рез;
	КонецЕсли;

	Путь = Сред(Хост, Поз);
	Хост = Лев(Хост, Поз - 1);

	Ресурс = Путь
		+ "?token=" + Токен
		+ "&from=" + Формат(Начало, "ДФ=yyyy-MM-dd")
		+ "&to=" + Формат(Конец, "ДФ=yyyy-MM-dd");

	Попытка

		Соединение = Новый HTTPСоединение(Хост, 443, , , , 60, Истина);
		Запрос = Новый HTTPЗапрос(Ресурс);
		HTTPОтвет = Соединение.Получить(Запрос);

		Если HTTPОтвет.КодСостояния <> 200 Тогда
			Рез.Сообщение = "Сайт вернул код " + Строка(HTTPОтвет.КодСостояния)
				+ " по адресу " + Хост + Путь;
			Возврат Рез;
		КонецЕсли;

		Тело = HTTPОтвет.ПолучитьТелоКакСтроку("UTF-8");

		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Рез.Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();

	Исключение

		Рез.Сообщение = "Не удалось получить рекламный расход: " + ОписаниеОшибки();
		Возврат Рез;

	КонецПопытки;

	Если ТипЗнч(Рез.Данные) <> Тип("Соответствие") Тогда
		Рез.Сообщение = "Сайт вернул не JSON-объект.";
		Возврат Рез;
	КонецЕсли;

	Рез.Успешно = Истина;

	Возврат Рез;

КонецФункции

