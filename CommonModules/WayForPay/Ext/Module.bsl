Функция ПолучитьСтатусПлатежа(OrderReference) Экспорт

	Рез = Новый Структура;

	Рез.Вставить("Успешно", Ложь);
	Рез.Вставить("Сообщение", "");
	Рез.Вставить("СтатусОплаты", "");
	Рез.Вставить("КодОтвета", "");
	Рез.Вставить("Причина", "");
	Рез.Вставить("НомерЗаказа", "");
	Рез.Вставить("AuthCode", "");
	Рез.Вставить("Сумма", 0);
	Рез.Вставить("Валюта", "");
	Рез.Вставить("ДатаСоздания", 0);
	Рез.Вставить("ДатаОплаты", 0);
	Рез.Вставить("Карта", "");
	Рез.Вставить("ТипКарты", "");
	Рез.Вставить("Банк", "");
	Рез.Вставить("СистемаОплаты", "");
	Рез.Вставить("Комиссия", 0);
	Рез.Вставить("СуммаВозврата", 0);
	Рез.Вставить("ОтветСервера", "");

	OrderReference = СокрЛП(Строка(OrderReference));

	Если ПустаяСтрока(OrderReference) Тогда

		Рез.Сообщение =
			"Не указан orderReference платежа.";

		Возврат Рез;

	КонецЕсли;

	MerchantAccount =
		СокрЛП(
			Строка(
				Константы.WayForPayMerchantAccount.Получить()
			)
		);

	MerchantSecretKey =
		СокрЛП(
			Строка(
				Константы.MerchantSecretKey.Получить()
			)
		);

	Если ПустаяСтрока(MerchantAccount) Тогда

		Рез.Сообщение =
			"Не заполнена константа WayForPayMerchantAccount.";

		Возврат Рез;

	КонецЕсли;

	Если ПустаяСтрока(MerchantSecretKey) Тогда

		Рез.Сообщение =
			"Не заполнена константа WayForPayMerchantSecretKey.";

		Возврат Рез;

	КонецЕсли;

	ИмяИсходящегоФайла =
		ПолучитьИмяВременногоФайла("json");

	ИмяФайлаОтвета =
		ПолучитьИмяВременногоФайла("json");

	СтрокаШифрования =
		MerchantAccount
		+ ";"
		+ OrderReference;

	СекретныйКлючHex =
		ПолучитьСтрокуHex(
			MerchantSecretKey
		);

	Попытка

		MerchantSignature =
			HMAC(
				СекретныйКлючHex,
				СтрокаШифрования,
				"MD5"
			);

	Исключение

		Рез.Сообщение =
			"Ошибка формирования merchantSignature: "
			+ ОписаниеОшибки();

		Возврат Рез;

	КонецПопытки;

	Попытка

		ЗаписьJSON = Новый ЗаписьJSON;

		ЗаписьJSON.ПроверятьСтруктуру =
			Истина;

		ПараметрыЗаписиJSON =
			Новый ПараметрыЗаписиJSON(
				ПереносСтрокJSON.Нет
			);

		ЗаписьJSON.ОткрытьФайл(
			ИмяИсходящегоФайла,
			КодировкаТекста.UTF8,
			Ложь,
			ПараметрыЗаписиJSON
		);

		ЗаписьJSON.ЗаписатьНачалоОбъекта();

		ЗаписьJSON.ЗаписатьИмяСвойства(
			"transactionType"
		);

		ЗаписьJSON.ЗаписатьЗначение(
			"CHECK_STATUS"
		);

		ЗаписьJSON.ЗаписатьИмяСвойства(
			"merchantAccount"
		);

		ЗаписьJSON.ЗаписатьЗначение(
			MerchantAccount
		);

		ЗаписьJSON.ЗаписатьИмяСвойства(
			"orderReference"
		);

		ЗаписьJSON.ЗаписатьЗначение(
			OrderReference
		);

		ЗаписьJSON.ЗаписатьИмяСвойства(
			"merchantSignature"
		);

		ЗаписьJSON.ЗаписатьЗначение(
			MerchantSignature
		);

		ЗаписьJSON.ЗаписатьИмяСвойства(
			"apiVersion"
		);

		ЗаписьJSON.ЗаписатьЗначение(1);

		ЗаписьJSON.ЗаписатьКонецОбъекта();

		ЗаписьJSON.Закрыть();

	Исключение

		Рез.Сообщение =
			"Ошибка формирования запроса CHECK_STATUS: "
			+ ОписаниеОшибки();

		УдалитьВременныйФайл(
			ИмяИсходящегоФайла
		);

		УдалитьВременныйФайл(
			ИмяФайлаОтвета
		);

		Возврат Рез;

	КонецПопытки;

	Попытка

		Соединение =
			СоздатьHTTPСоединениеWayForPay();

		ОтветHTTP =
			Соединение.ОтправитьДляОбработки(
				ИмяИсходящегоФайла,
				"/api",
				ИмяФайлаОтвета
			);

	Исключение

		Рез.Сообщение =
			"Ошибка подключения к WayForPay: "
			+ ОписаниеОшибки();

		УдалитьВременныйФайл(
			ИмяИсходящегоФайла
		);

		УдалитьВременныйФайл(
			ИмяФайлаОтвета
		);

		Возврат Рез;

	КонецПопытки;

	ФайлОтвета =
		Новый Файл(
			ИмяФайлаОтвета
		);

	Если Не ФайлОтвета.Существует() Тогда

		Рез.Сообщение =
			"WayForPay не вернул файл ответа.";

		УдалитьВременныйФайл(
			ИмяИсходящегоФайла
		);

		Возврат Рез;

	КонецЕсли;

	ТекстОтвета =
		Новый ТекстовыйДокумент;

	Попытка

		ТекстОтвета.Прочитать(
			ИмяФайлаОтвета
		);

	Исключение

		Рез.Сообщение =
			"Не удалось прочитать ответ WayForPay: "
			+ ОписаниеОшибки();

		УдалитьВременныйФайл(
			ИмяИсходящегоФайла
		);

		УдалитьВременныйФайл(
			ИмяФайлаОтвета
		);

		Возврат Рез;

	КонецПопытки;

	Если ТекстОтвета.КоличествоСтрок() = 0 Тогда

		Рез.Сообщение =
			"WayForPay вернул пустой ответ.";

		УдалитьВременныйФайл(
			ИмяИсходящегоФайла
		);

		УдалитьВременныйФайл(
			ИмяФайлаОтвета
		);

		Возврат Рез;

	КонецЕсли;

	СтрокаОтвета =
		ТекстОтвета.ПолучитьТекст();

	Рез.ОтветСервера =
		СтрокаОтвета;

	Попытка

		ЧтениеJSON =
			Новый ЧтениеJSON;

		ЧтениеJSON.ОткрытьФайл(
			ИмяФайлаОтвета
		);

		Записи =
			ПрочитатьJSON(
				ЧтениеJSON
			);

		ЧтениеJSON.Закрыть();

	Исключение

		Рез.Сообщение =
			"Ошибка разбора ответа WayForPay: "
			+ ОписаниеОшибки()
			+ Символы.ПС
			+ СтрокаОтвета;

		УдалитьВременныйФайл(
			ИмяИсходящегоФайла
		);

		УдалитьВременныйФайл(
			ИмяФайлаОтвета
		);

		Возврат Рез;

	КонецПопытки;

	СтатусОплаты = "";
	КодОтвета = "";
	Причина = "";
	НомерОтвета = "";
	AuthCode = "";
	Сумма = 0;
	Валюта = "";
	ДатаСоздания = 0;
	ДатаОплаты = 0;
	Карта = "";
	ТипКарты = "";
	Банк = "";
	СистемаОплаты = "";
	Комиссия = 0;
	СуммаВозврата = 0;

	Для Каждого Запись Из Записи Цикл

		Если Запись.Ключ = "orderReference" Тогда

			НомерОтвета =
				БезопасноПолучитьСтроку(
					Запись.Значение
				);

		ИначеЕсли Запись.Ключ = "transactionStatus" Тогда

			СтатусОплаты =
				БезопасноПолучитьСтроку(
					Запись.Значение
				);

		ИначеЕсли Запись.Ключ = "authCode" Тогда

			AuthCode =
				БезопасноПолучитьСтроку(
					Запись.Значение
				);

		ИначеЕсли Запись.Ключ = "reasonCode" Тогда

			КодОтвета =
				БезопасноПолучитьСтроку(
					Запись.Значение
				);

			КодОтвета =
				СтрЗаменить(
					КодОтвета,
					" ",
					""
				);

			КодОтвета =
				СтрЗаменить(
					КодОтвета,
					Символ(160),
					""
				);

		ИначеЕсли Запись.Ключ = "reason" Тогда

			Причина =
				БезопасноПолучитьСтроку(
					Запись.Значение
				);

		ИначеЕсли Запись.Ключ = "amount" Тогда

			Сумма =
				БезопасноПолучитьЧисло(
					Запись.Значение
				);

		ИначеЕсли Запись.Ключ = "currency" Тогда

			Валюта =
				БезопасноПолучитьСтроку(
					Запись.Значение
				);

		ИначеЕсли Запись.Ключ = "createdDate" Тогда

			ДатаСоздания =
				Запись.Значение;

		ИначеЕсли Запись.Ключ = "processingDate" Тогда

			ДатаОплаты =
				Запись.Значение;

		ИначеЕсли Запись.Ключ = "cardPan" Тогда

			Карта =
				БезопасноПолучитьСтроку(
					Запись.Значение
				);

		ИначеЕсли Запись.Ключ = "cardType" Тогда

			ТипКарты =
				БезопасноПолучитьСтроку(
					Запись.Значение
				);

		ИначеЕсли Запись.Ключ = "issuerBankName" Тогда

			Банк =
				БезопасноПолучитьСтроку(
					Запись.Значение
				);

		ИначеЕсли Запись.Ключ = "paymentSystem" Тогда

			СистемаОплаты =
				БезопасноПолучитьСтроку(
					Запись.Значение
				);

		ИначеЕсли Запись.Ключ = "fee" Тогда

			Комиссия =
				БезопасноПолучитьЧисло(
					Запись.Значение
				);

		ИначеЕсли Запись.Ключ = "refundAmount" Тогда

			СуммаВозврата =
				БезопасноПолучитьЧисло(
					Запись.Значение
				);

		КонецЕсли;

	КонецЦикла;

	Рез.СтатусОплаты = СтатусОплаты;
	Рез.КодОтвета = КодОтвета;
	Рез.Причина = Причина;
	Рез.НомерЗаказа = НомерОтвета;
	Рез.AuthCode = AuthCode;
	Рез.Сумма = Сумма;
	Рез.Валюта = Валюта;
	Рез.ДатаСоздания = ДатаСоздания;
	Рез.ДатаОплаты = ДатаОплаты;
	Рез.Карта = Карта;
	Рез.ТипКарты = ТипКарты;
	Рез.Банк = Банк;
	Рез.СистемаОплаты = СистемаОплаты;
	Рез.Комиссия = Комиссия;
	Рез.СуммаВозврата = СуммаВозврата;

	УдалитьВременныйФайл(
		ИмяИсходящегоФайла
	);

	УдалитьВременныйФайл(
		ИмяФайлаОтвета
	);

	Если КодОтвета <> "1100" Тогда

		Рез.Сообщение =
			КодОтвета
			+ " "
			+ Причина;

		Возврат Рез;

	КонецЕсли;

	Если ЗначениеЗаполнено(НомерОтвета)
		И НомерОтвета <> OrderReference Тогда

		Рез.Сообщение =
			"WayForPay вернул статус другого платежа: "
			+ НомерОтвета;

		Возврат Рез;

	КонецЕсли;

	Рез.Успешно = Истина;
	Рез.Сообщение = "";

	Возврат Рез;

КонецФункции


// Проверяет платёж WayForPay и при подтверждении (Approved)
// регистрирует входящий платёж по заказу.
// Повторный вызов безопасен: СоздатьДокументПрограмно не создаёт
// дубль при совпадении ДокументОснование + НомерВходящегоДокумента.
Функция ПроверитьИЗарегистрироватьОплату(Заказ, OrderReference, Счет = Неопределено) Экспорт

	Результат = ПолучитьСтатусПлатежа(OrderReference);
	Результат.Вставить("ПлатежЗарегистрирован", Ложь);

	Если Не Результат.Успешно Тогда
		Возврат Результат;
	КонецЕсли;

	Если Результат.СтатусОплаты = "Approved" Тогда

		СчетОплаты = ?(Счет = Неопределено,
			Справочники.БанковскиеСчета.НайтиПоКоду("000000071"), // счёт-эквайринг WayForPay
			Счет);

		Документы.ПлатежноеПоручениеВходящее.СоздатьДокументПрограмно(
			Заказ,
			Результат.Сумма,
			СчетОплаты,
			Результат.НомерЗаказа // ВхНомер = orderReference — защита от дублей
		);

		Результат.ПлатежЗарегистрирован = Истина;

	КонецЕсли;

	Возврат Результат;

КонецФункции


// Получает список транзакций WayForPay за период (TRANSACTION_LIST).
// Возвращает Массив Структур с сырыми полями транзакции (orderReference,
// amount, currency, createdDate, processingDate, transactionStatus, email,
// phone) — без привязки к структуре очереди импорта БанковскиеВыписки,
// конвертацию делает вызывающий модуль.
// Отладка загрузки транзакций WayForPay.
// Поставьте Ложь, когда подробные сообщения больше не нужны.
Функция ВключенаОтладкаWayForPay() Экспорт
	Возврат Истина;
КонецФункции


// Диагностика видна при нажатии кнопки «Получить из Приват24»,
// т.к. использует Сообщить — в фоне регламента не выводится.
// Включается/выключается функцией ВключенаОтладкаWayForPay().
Процедура ОтладкаWayForPaySообщить(Текст) Экспорт
	Если ВключенаОтладкаWayForPay() Тогда
		Сообщить("[WayForPay] " + Строка(Текст));
	КонецЕсли;
КонецПроцедуры


Функция ПолучитьСписокТранзакций(ДатаНачала, ДатаКонца) Экспорт

	Результат = Новый Массив;

	MerchantAccount =
		СокрЛП(
			Строка(
				Константы.WayForPayMerchantAccount.Получить()
			)
		);

	MerchantSecretKey =
		СокрЛП(
			Строка(
				Константы.MerchantSecretKey.Получить()
			)
		);

	Если ПустаяСтрока(MerchantAccount) Тогда

		ЗаписьЖурналаРегистрации(
			"WayForPay.ПолучитьСписокТранзакций",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не заполнена константа WayForPayMerchantAccount.");

		ОтладкаWayForPaySообщить(
			"WayForPayMerchantAccount не заполнен — транзакции не запрашиваются.");

		Возврат Результат;

	КонецЕсли;

	Если ПустаяСтрока(MerchantSecretKey) Тогда

		ЗаписьЖурналаРегистрации(
			"WayForPay.ПолучитьСписокТранзакций",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не заполнена константа MerchantSecretKey.");

		ОтладкаWayForPaySообщить(
			"MerchantSecretKey не заполнен — транзакции не запрашиваются.");

		Возврат Результат;

	КонецЕсли;

	ОтладкаWayForPaySообщить(
		"MerchantAccount: """ + MerchantAccount + """"
		+ ", MerchantSecretKey: заполнен ("
		+ Строка(СтрДлина(MerchantSecretKey)) + " симв.)");

	// Unix-время — без доп. конвертации часовых поясов (сервер и WayForPay
	// работают в одном и том же местном времени, как и остальной конвейер).
	ДатаБеза1970 = Дата(1970, 1, 1);

	DateBegin = Цел(НачалоДня(ДатаНачала) - ДатаБеза1970);
	DateEnd   = Цел(КонецДня(ДатаКонца) - ДатаБеза1970);

	// Строка(Число) в этой локали вставляет разделитель разрядов (пробел) —
	// это ломает подпись ("Invalid signature", reasonCode 1113). Формат с
	// ЧГ=0 отключает группировку, ровно как в БезопасноПолучитьСтроку.
	СтрокаDateBegin = Формат(DateBegin, "ЧГ=0");
	СтрокаDateEnd   = Формат(DateEnd,   "ЧГ=0");

	ОтладкаWayForPaySообщить(
		"период " + Формат(НачалоДня(ДатаНачала), "ДФ=dd.MM.yyyy HH:mm:ss")
		+ " - " + Формат(КонецДня(ДатаКонца), "ДФ=dd.MM.yyyy HH:mm:ss")
		+ ", dateBegin=" + СтрокаDateBegin
		+ ", dateEnd=" + СтрокаDateEnd);

	СтрокаШифрования =
		MerchantAccount
		+ ";"
		+ СтрокаDateBegin
		+ ";"
		+ СтрокаDateEnd;

	СекретныйКлючHex =
		ПолучитьСтрокуHex(
			MerchantSecretKey
		);

	Попытка

		MerchantSignature =
			HMAC(
				СекретныйКлючHex,
				СтрокаШифрования,
				"MD5"
			);

	Исключение

		ЗаписьЖурналаРегистрации(
			"WayForPay.ПолучитьСписокТранзакций",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка формирования merchantSignature: "
			+ ОписаниеОшибки());

		Возврат Результат;

	КонецПопытки;

	ИмяИсходящегоФайла =
		ПолучитьИмяВременногоФайла("json");

	ИмяФайлаОтвета =
		ПолучитьИмяВременногоФайла("json");

	Попытка

		ЗаписьJSON = Новый ЗаписьJSON;

		ЗаписьJSON.ПроверятьСтруктуру =
			Истина;

		ПараметрыЗаписиJSON =
			Новый ПараметрыЗаписиJSON(
				ПереносСтрокJSON.Нет
			);

		ЗаписьJSON.ОткрытьФайл(
			ИмяИсходящегоФайла,
			КодировкаТекста.UTF8,
			Ложь,
			ПараметрыЗаписиJSON
		);

		ЗаписьJSON.ЗаписатьНачалоОбъекта();

		ЗаписьJSON.ЗаписатьИмяСвойства("transactionType");
		ЗаписьJSON.ЗаписатьЗначение("TRANSACTION_LIST");

		ЗаписьJSON.ЗаписатьИмяСвойства("merchantAccount");
		ЗаписьJSON.ЗаписатьЗначение(MerchantAccount);

		ЗаписьJSON.ЗаписатьИмяСвойства("merchantSignature");
		ЗаписьJSON.ЗаписатьЗначение(MerchantSignature);

		ЗаписьJSON.ЗаписатьИмяСвойства("dateBegin");
		ЗаписьJSON.ЗаписатьЗначение(DateBegin);

		ЗаписьJSON.ЗаписатьИмяСвойства("dateEnd");
		ЗаписьJSON.ЗаписатьЗначение(DateEnd);

		ЗаписьJSON.ЗаписатьИмяСвойства("apiVersion");
		ЗаписьJSON.ЗаписатьЗначение(1);

		ЗаписьJSON.ЗаписатьКонецОбъекта();

		ЗаписьJSON.Закрыть();

	Исключение

		ЗаписьЖурналаРегистрации(
			"WayForPay.ПолучитьСписокТранзакций",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка формирования запроса TRANSACTION_LIST: "
			+ ОписаниеОшибки());

		УдалитьВременныйФайл(ИмяИсходящегоФайла);
		УдалитьВременныйФайл(ИмяФайлаОтвета);

		Возврат Результат;

	КонецПопытки;

	Попытка

		Соединение =
			СоздатьHTTPСоединениеWayForPay();

		ОтветHTTP =
			Соединение.ОтправитьДляОбработки(
				ИмяИсходящегоФайла,
				"/api",
				ИмяФайлаОтвета
			);

		ОтладкаWayForPaySообщить(
			"запрос отправлен, код результата обработки: "
			+ Строка(ОтветHTTP));

	Исключение

		ЗаписьЖурналаРегистрации(
			"WayForPay.ПолучитьСписокТранзакций",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка подключения к WayForPay: "
			+ ОписаниеОшибки());

		УдалитьВременныйФайл(ИмяИсходящегоФайла);
		УдалитьВременныйФайл(ИмяФайлаОтвета);

		Возврат Результат;

	КонецПопытки;

	ФайлОтвета =
		Новый Файл(
			ИмяФайлаОтвета
		);

	Если Не ФайлОтвета.Существует() Тогда

		ЗаписьЖурналаРегистрации(
			"WayForPay.ПолучитьСписокТранзакций",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"WayForPay не вернул файл ответа.");

		УдалитьВременныйФайл(ИмяИсходящегоФайла);

		Возврат Результат;

	КонецЕсли;

	ТекстОтвета =
		Новый ТекстовыйДокумент;

	Попытка

		ТекстОтвета.Прочитать(
			ИмяФайлаОтвета
		);

	Исключение

		ЗаписьЖурналаРегистрации(
			"WayForPay.ПолучитьСписокТранзакций",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось прочитать ответ WayForPay: "
			+ ОписаниеОшибки());

		УдалитьВременныйФайл(ИмяИсходящегоФайла);
		УдалитьВременныйФайл(ИмяФайлаОтвета);

		Возврат Результат;

	КонецПопытки;

	СтрокаОтвета =
		ТекстОтвета.ПолучитьТекст();

	УдалитьВременныйФайл(ИмяИсходящегоФайла);
	УдалитьВременныйФайл(ИмяФайлаОтвета);

	ОтладкаWayForPaySообщить(
		"тело ответа: " + Лев(СокрЛП(СтрокаОтвета), 1500));

	Если ПустаяСтрока(СокрЛП(СтрокаОтвета)) Тогда

		ЗаписьЖурналаРегистрации(
			"WayForPay.ПолучитьСписокТранзакций",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"WayForPay вернул пустой ответ.");

		Возврат Результат;

	КонецЕсли;

	Попытка

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

	Исключение

		ЗаписьЖурналаРегистрации(
			"WayForPay.ПолучитьСписокТранзакций",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка разбора ответа WayForPay: "
			+ ОписаниеОшибки()
			+ Символы.ПС
			+ Лев(СтрокаОтвета, 1500));

		Возврат Результат;

	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	КодОтвета = "";
	Данные.Свойство("reasonCode", КодОтвета);
	КодОтвета = БезопасноПолучитьСтроку(КодОтвета);

	Если КодОтвета <> "1100" Тогда

		Причина = "";
		Данные.Свойство("reason", Причина);

		ЗаписьЖурналаРегистрации(
			"WayForPay.ПолучитьСписокТранзакций",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"WayForPay вернул код " + КодОтвета
			+ " " + БезопасноПолучитьСтроку(Причина));

		Возврат Результат;

	КонецЕсли;

	СписокТранзакций = Неопределено;
	Данные.Свойство("transactionList", СписокТранзакций);

	Если ТипЗнч(СписокТранзакций) <> Тип("Массив") Тогда

		ОтладкаWayForPaySообщить(
			"transactionList отсутствует или не массив.");

		Возврат Результат;

	КонецЕсли;

	ОтладкаWayForPaySообщить(
		"transactionList: элементов " + Строка(СписокТранзакций.Количество()));

	Для Каждого Транзакция Из СписокТранзакций Цикл

		Если ТипЗнч(Транзакция) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		OrderReference = "";
		Транзакция.Свойство("orderReference", OrderReference);
		OrderReference = БезопасноПолучитьСтроку(OrderReference);

		Если ПустаяСтрока(OrderReference) Тогда
			Продолжить;
		КонецЕсли;

		Amount = 0;
		Транзакция.Свойство("amount", Amount);

		Currency = "";
		Транзакция.Свойство("currency", Currency);

		CreatedDate = 0;
		Транзакция.Свойство("createdDate", CreatedDate);

		TransactionStatus = "";
		Транзакция.Свойство("transactionStatus", TransactionStatus);

		Email = "";
		Транзакция.Свойство("email", Email);

		Phone = "";
		Транзакция.Свойство("phone", Phone);

		СтрокаРезультата = Новый Структура;
		СтрокаРезультата.Вставить("orderReference", OrderReference);
		СтрокаРезультата.Вставить("amount", БезопасноПолучитьЧисло(Amount));
		СтрокаРезультата.Вставить("currency", БезопасноПолучитьСтроку(Currency));
		СтрокаРезультата.Вставить("createdDate", БезопасноПолучитьЧисло(CreatedDate));
		СтрокаРезультата.Вставить("transactionStatus", БезопасноПолучитьСтроку(TransactionStatus));
		СтрокаРезультата.Вставить("email", БезопасноПолучитьСтроку(Email));
		СтрокаРезультата.Вставить("phone", БезопасноПолучитьСтроку(Phone));

		ОтладкаWayForPaySообщить(
			"транзакция orderReference=" + OrderReference
			+ ", status=" + БезопасноПолучитьСтроку(TransactionStatus)
			+ ", amount=" + Строка(БезопасноПолучитьЧисло(Amount)));

		Результат.Добавить(СтрокаРезультата);

	КонецЦикла;

	ОтладкаWayForPaySообщить(
		"итого возвращено записей: " + Строка(Результат.Количество()));

	Возврат Результат;

КонецФункции


Функция СоздатьHTTPСоединениеWayForPay()

	Адрес =
		"api.wayforpay.com";

	Порт =
		443;

	ЗащищенноеСоединение =
		Новый ЗащищенноеСоединениеOpenSSL;

	Соединение =
		Новый HTTPСоединение(
			Адрес,
			Порт,
			,
			,
			,
			,
			ЗащищенноеСоединение
		);

	Возврат Соединение;

КонецФункции


Функция ПолучитьСтрокуHex(ИсходнаяСтрока)

	ИсходнаяСтрока =
		Строка(
			ИсходнаяСтрока
		);

	Результат =
		"";

	Для К = 1 По СтрДлина(ИсходнаяСтрока) Цикл

		Результат =
			Результат
			+ ПреобразоватьДесятичнуюСИВHex(
				КодСимвола(
					Сред(
						ИсходнаяСтрока,
						К,
						1
					)
				)
			);

	КонецЦикла;

	Возврат Результат;

КонецФункции


Функция БезопасноПолучитьСтроку(Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если Значение = Null Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда

		Результат =
			Формат(
				Значение,
				"ЧГ=0;ЧН="
			);

	Иначе

		Результат =
			СокрЛП(
				Строка(
					Значение
				)
			);

	КонецЕсли;

	Результат =
		СтрЗаменить(
			Результат,
			Символ(160),
			""
		);

	Возврат Результат;

КонецФункции


Функция БезопасноПолучитьЧисло(Значение)

	Если Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если Значение = Null Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	СтрокаЧисла =
		СокрЛП(
			Строка(
				Значение
			)
		);

	СтрокаЧисла =
		СтрЗаменить(
			СтрокаЧисла,
			Символ(160),
			""
		);

	СтрокаЧисла =
		СтрЗаменить(
			СтрокаЧисла,
			" ",
			""
		);

	// Число() в этой базе ожидает точку как разделитель дробной части
	// (см. БанковскиеВыписки.ЧислоИзСтрокиПриват24, которая по этой же
	// причине приводит запятую к точке). Раньше здесь была обратная замена
	// "." на "," — из-за неё Число("1,00") падало по исключению, и суммы
	// WayForPay (включая Результат.Сумма в ПроверитьИЗарегистрироватьОплату)
	// всегда получались 0.
	СтрокаЧисла =
		СтрЗаменить(
			СтрокаЧисла,
			",",
			"."
		);

	Попытка

		Возврат Число(
			СтрокаЧисла
		);

	Исключение

		Возврат 0;

	КонецПопытки;

КонецФункции


Процедура УдалитьВременныйФайл(ИмяФайла)

	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Файл =
			Новый Файл(
				ИмяФайла
			);

		Если Файл.Существует() Тогда
			УдалитьФайлы(ИмяФайла);
		КонецЕсли;

	Исключение
	КонецПопытки;

КонецПроцедуры


// -----------------------------------------------------------------
// HMAC
// K — секретный ключ в шестнадцатеричном виде.
// Text — строка, которую подписываем.
// Hash — MD5.
// -----------------------------------------------------------------

Функция HMAC(Знач K, Знач Text, Знач Hash)

	Перем KResult;
	Перем K0;

	Если СтрДлина(K) > 128 Тогда
		K = SHA1(K, Hash);
	КонецЕсли;

	StringSHA1 =
		Лев(
			K,
			128
		);

	Для Счетчик =
		СтрДлина(K)
		По 128 Цикл

		StringSHA1 =
			StringSHA1
			+ "0";

	КонецЦикла;

	K0 =
		StringSHA1;

	B =
		ПреобразоватьЧислоВДвоичнуюСИ(
			ПреобразоватьHexВДесятичнуюСИ(
				"36"
			)
		);

	Счетчик =
		1;

	Пока Счетчик < 128 Цикл

		A =
			ПреобразоватьЧислоВДвоичнуюСИ(
				ПреобразоватьHexВДесятичнуюСИ(
					Сред(
						StringSHA1,
						Счетчик,
						2
					)
				)
			);

		C =
			XOR(
				A,
				B
			);

		StringSHA1 =
			Лев(
				StringSHA1,
				Счетчик - 1
			)
			+ C
			+ Прав(
				StringSHA1,
				128 - Счетчик
			);

		Счетчик =
			Счетчик + 2;

	КонецЦикла;

	StringSHA1 =
		Лев(
			StringSHA1,
			128
		);

	Для Счетчик = 1 По СтрДлина(Text) Цикл

		StringSHA1 =
			StringSHA1
			+ ПреобразоватьДесятичнуюСИВHex(
				КодСимвола(
					Сред(
						Text,
						Счетчик,
						1
					)
				)
			);

	КонецЦикла;

	StringSHA1 =
		SHA1(
			StringSHA1,
			Hash
		);

	KResult =
		StringSHA1;

	StringSHA1 =
		K0;

	B =
		ПреобразоватьЧислоВДвоичнуюСИ(
			ПреобразоватьHexВДесятичнуюСИ(
				"5c"
			)
		);

	Счетчик =
		1;

	Пока Счетчик < 128 Цикл

		A =
			ПреобразоватьЧислоВДвоичнуюСИ(
				ПреобразоватьHexВДесятичнуюСИ(
					Сред(
						StringSHA1,
						Счетчик,
						2
					)
				)
			);

		C =
			XOR(
				A,
				B
			);

		StringSHA1 =
			Лев(
				StringSHA1,
				Счетчик - 1
			)
			+ C
			+ Прав(
				StringSHA1,
				128 - Счетчик
			);

		Счетчик =
			Счетчик + 2;

	КонецЦикла;

	StringSHA1 =
		Лев(
			StringSHA1,
			128
		);

	StringSHA1 =
		StringSHA1
		+ KResult;

	StringSHA1 =
		SHA1(
			StringSHA1,
			Hash
		);

	Возврат StringSHA1;

КонецФункции


Функция SHA1(Знач NString, Hash)

	Хеширование =
		Новый ХешированиеДанных(
			ХешФункция[Hash]
		);

	ТипHexBinary =
		ФабрикаXDTO.Тип(
			"http://www.w3.org/2001/XMLSchema",
			"hexBinary"
		);

	ДвоичныеДанные =
		ФабрикаXDTO.Создать(
			ТипHexBinary,
			NString
		);

	Хеширование.Добавить(
		ДвоичныеДанные.Значение
	);

	Sign =
		Хеширование.ХешСумма;

	Sign =
		СтрЗаменить(
			НРег(Sign),
			" ",
			""
		);

	Возврат Sign;

КонецФункции


Функция ПреобразоватьДесятичнуюСИВHex(Знач Int)

	Если Int < 256 Тогда

		Возврат Прав(
			"00"
			+ ПреобразоватьДесятичнуюСИВОднобайтовыйHex(
				Int
			),
			2
		);

	Иначе

		Возврат Прав(
			"0000"
			+ ПреобразоватьДесятичнуюСИВДвухбайтовыйHex(
				Int
			),
			4
		);

	КонецЕсли;

КонецФункции


Функция ПреобразоватьHexВДесятичнуюСИ(Знач Hex)

	Hex =
		НРег(
			Hex
		);

	Символ =
		СтрДлина(Hex) - 1;

	Dec =
		0;

	I =
		1;

	Пока Символ >= 0 Цикл

		СимволHex =
			Сред(
				Hex,
				I,
				1
			);

		Res =
			Найти(
				"0123456789abcdef",
				СимволHex
			) - 1;

		Dec =
			Dec
			+ Res
			* Pow(
				16,
				Символ
			);

		Символ =
			Символ - 1;

		I =
			I + 1;

	КонецЦикла;

	Возврат Dec;

КонецФункции


Функция ПреобразоватьЧислоВДвоичнуюСИ(
	Знач Int,
	RBit = 8)

	B =
		"";

	Для K = 1 По RBit Цикл

		M =
			Pow(
				2,
				RBit - K
			);

		Bit =
			Цел(
				Int / M
			);

		Int =
			Int
			- M
			* Bit;

		B =
			B
			+ Bit;

	КонецЦикла;

	Возврат B;

КонецФункции


Функция XOR(A, B)

	Res =
		0;

	S =
		1;

	K =
		Мин(
			СтрДлина(A),
			СтрДлина(B)
		);

	Пока K > 0 Цикл

		A1 =
			Сред(
				A,
				K,
				1
			);

		B1 =
			Сред(
				B,
				K,
				1
			);

		Res =
			Res
			+ S
			* ?(
				A1 = B1,
				0,
				Макс(A1, B1)
			);

		S =
			S * 2;

		K =
			K - 1;

	КонецЦикла;

	Возврат ПреобразоватьДесятичнуюСИВHex(
		Res
	);

КонецФункции


Функция ПреобразоватьДесятичнуюСИВДвухбайтовыйHex(Знач Int)

	BinaryData =
		ПреобразоватьЧислоВДвоичнуюСИ(
			Int,
			11
		);

	BinaryData =
		"110"
		+ Лев(
			BinaryData,
			5
		)
		+ "10"
		+ Прав(
			BinaryData,
			6
		);

	DecimalData =
		ПолучитьДесятичноеЧислоИзДвоичного(
			BinaryData
		);

	HexData =
		ПреобразоватьДесятичнуюСИВОднобайтовыйHex(
			DecimalData
		);

	Возврат HexData;

КонецФункции


Функция ПолучитьДесятичноеЧислоИзДвоичного(B)

	Res =
		0;

	S =
		1;

	K =
		СтрДлина(B);

	Пока K > 0 Цикл

		Bit =
			Сред(
				B,
				K,
				1
			);

		Res =
			Res
			+ S
			* Bit;

		S =
			S * 2;

		K =
			K - 1;

	КонецЦикла;

	Возврат Res;

КонецФункции


Функция ПреобразоватьДесятичнуюСИВОднобайтовыйHex(Знач Int)

	Hex =
		"";

	Если Int = 0 Тогда
		Возврат "0";
	КонецЕсли;

	Пока Int <> 0 Цикл

		P =
			Int % 16;

		Hex =
			Сред(
				"0123456789abcdef",
				P + 1,
				1
			)
			+ Hex;

		Int =
			Цел(
				Int / 16
			);

	КонецЦикла;

	Возврат Hex;

КонецФункции