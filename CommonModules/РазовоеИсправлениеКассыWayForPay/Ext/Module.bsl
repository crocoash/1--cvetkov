// ШАГИ

Функция ПеренестиОплату(Знач Описание, Знач СчетЭквайринга, Знач Применять)

	Итог = НоваяСтрокаИтога("А", Описание.Номер);

	Ссылка = НайтиДокумент("ПлатежноеПоручениеВходящее", Описание.Номер, Итог);

	Если Ссылка = Неопределено Тогда
		Возврат Итог;
	КонецЕсли;

	Если Ссылка.СчетОрганизации = СчетЭквайринга Тогда
		Итог.ok      = Истина;
		Итог.skipped = "уже на счёте " + Строка(СчетЭквайринга);
		Возврат Итог;
	КонецЕсли;

	Итог.error = ПроверитьПроведенный(Ссылка, Описание.Сумма);

	Если ПустаяСтрока(Итог.error) И Ссылка.СчетОрганизации.Код <> Описание.КодСчета Тогда
		Итог.error = "документ на счёте " + Строка(Ссылка.СчетОрганизации)
			+ " (" + Ссылка.СчетОрганизации.Код + "), ожидался " + Описание.КодСчета;
	КонецЕсли;

	Если ПустаяСтрока(Итог.error) И Ссылка.Организация <> СчетЭквайринга.Владелец Тогда
		Итог.error = "организация документа " + Строка(Ссылка.Организация)
			+ " не владеет счётом " + Строка(СчетЭквайринга);
	КонецЕсли;

	Если Не ПустаяСтрока(Итог.error) Тогда
		Возврат Итог;
	КонецЕсли;

	Итог.change = "счёт " + Строка(Ссылка.СчетОрганизации) + " -> " + Строка(СчетЭквайринга)
		+ ", " + ФорматСуммы(Ссылка.СуммаДокумента) + ", " + Строка(Ссылка.ДокументОснование);

	ДобавитьДвижение(Итог, КодСчетаЭквайринга(), Ссылка.СуммаДокумента);
	ДобавитьДвижение(Итог, Описание.КодСчета, -Ссылка.СуммаДокумента);

	Если Применять Тогда

		Объект = Ссылка.ПолучитьОбъект();
		Объект.СчетОрганизации = СчетЭквайринга;

		Итог.error = ЗаписатьДокумент(Объект, РежимЗаписиДокумента.Проведение);

		Если Не ПустаяСтрока(Итог.error) Тогда
			Возврат Итог;
		КонецЕсли;

		Итог.saved = Истина;

	КонецЕсли;

	Итог.ok = Истина;

	Возврат Итог;

КонецФункции

Функция ПометитьПрочееПоступление(Знач Описание, Знач СчетЭквайринга, Знач Применять)

	Итог = НоваяСтрокаИтога("Б", Описание.Номер);

	Ссылка = НайтиДокумент("ПлатежноеПоручениеВходящее", Описание.Номер, Итог);

	Если Ссылка = Неопределено Тогда
		Возврат Итог;
	КонецЕсли;

	Если Ссылка.ПометкаУдаления Тогда
		Итог.ok      = Истина;
		Итог.skipped = "уже помечен на удаление";
		Возврат Итог;
	КонецЕсли;

	Итог.error = ПроверитьПроведенный(Ссылка, Описание.Сумма);

	Если ПустаяСтрока(Итог.error) И Ссылка.СчетОрганизации <> СчетЭквайринга Тогда
		Итог.error = "документ на счёте " + Строка(Ссылка.СчетОрганизации) + ", ожидался " + Строка(СчетЭквайринга);
	КонецЕсли;

	Если ПустаяСтрока(Итог.error) И Ссылка.ВидОперации <>
		Перечисления.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ПрочееПоступлениеБезналичныхДенежныхСредств Тогда

		Итог.error = "вид операции «" + Строка(Ссылка.ВидОперации) + "», ожидалось прочее поступление";

	КонецЕсли;

	Если ПустаяСтрока(Итог.error) И СокрЛП(Ссылка.НомерВходящегоДокумента) <> Описание.НомерПлатежа Тогда
		Итог.error = "номер платежа «" + СокрЛП(Ссылка.НомерВходящегоДокумента) + "», ожидался " + Описание.НомерПлатежа;
	КонецЕсли;

	Если Не ПустаяСтрока(Итог.error) Тогда
		Возврат Итог;
	КонецЕсли;

	Итог.change = "пометка удаления (проведение снимется), " + ФорматСуммы(Ссылка.СуммаДокумента)
		+ ", платёж " + Описание.НомерПлатежа;

	ДобавитьДвижение(Итог, КодСчетаЭквайринга(), -Ссылка.СуммаДокумента);

	Если Применять Тогда

		Объект = Ссылка.ПолучитьОбъект();

		Итог.error = ЗаписатьДокумент(Объект, Неопределено);

		Если Не ПустаяСтрока(Итог.error) Тогда
			Возврат Итог;
		КонецЕсли;

		Итог.saved = Истина;

	КонецЕсли;

	Итог.ok = Истина;

	Возврат Итог;

КонецФункции

Функция ВернутьПолнуюСумму(Знач Описание, Знач СчетЭквайринга, Знач Применять)

	Итог = НоваяСтрокаИтога("В", Описание.Номер);

	Ссылка = НайтиДокумент("ПлатежноеПоручениеВходящее", Описание.Номер, Итог);

	Если Ссылка = Неопределено Тогда
		Возврат Итог;
	КонецЕсли;

	Если Ссылка.СуммаДокумента = Описание.Станет Тогда
		Итог.ok      = Истина;
		Итог.skipped = "сумма уже " + ФорматСуммы(Описание.Станет);
		Возврат Итог;
	КонецЕсли;

	Итог.error = ПроверитьПроведенный(Ссылка, Описание.Было);

	Если ПустаяСтрока(Итог.error) И Ссылка.СчетОрганизации <> СчетЭквайринга Тогда
		Итог.error = "документ на счёте " + Строка(Ссылка.СчетОрганизации) + ", ожидался " + Строка(СчетЭквайринга);
	КонецЕсли;

	Если ПустаяСтрока(Итог.error) И Ссылка.ВидОперации <>
		Перечисления.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ОплатаПокупателя Тогда

		Итог.error = "вид операции «" + Строка(Ссылка.ВидОперации) + "», ожидалась оплата покупателя";

	КонецЕсли;

	Если ПустаяСтрока(Итог.error) И Ссылка.РасшифровкаПлатежа.Количество() <> 1 Тогда
		Итог.error = "в расшифровке " + Формат(Ссылка.РасшифровкаПлатежа.Количество(), "ЧН=0; ЧГ=0")
			+ " строк, ожидалась одна";
	КонецЕсли;

	Если ПустаяСтрока(Итог.error) И Ссылка.РасшифровкаПлатежа[0].СуммаПлатежа <> Описание.Было Тогда
		Итог.error = "в расшифровке сумма " + ФорматСуммы(Ссылка.РасшифровкаПлатежа[0].СуммаПлатежа)
			+ ", ожидалась " + ФорматСуммы(Описание.Было);
	КонецЕсли;

	Если Не ПустаяСтрока(Итог.error) Тогда
		Возврат Итог;
	КонецЕсли;

	Итог.change = "сумма " + ФорматСуммы(Описание.Было) + " -> " + ФорматСуммы(Описание.Станет)
		+ ", " + Строка(Ссылка.РасшифровкаПлатежа[0].Сделка);

	ДобавитьДвижение(Итог, КодСчетаЭквайринга(), Описание.Станет - Описание.Было);

	Если Применять Тогда

		Объект = Ссылка.ПолучитьОбъект();

		Объект.СуммаДокумента = Описание.Станет;

		// Реквизит в коде не используется, но если в нём сумма до правки -
		// оставлять её расходиться с суммой документа незачем.
		Если Объект.СуммаДокументаБезПроцента = Описание.Было Тогда
			Объект.СуммаДокументаБезПроцента = Описание.Станет;
		КонецЕсли;

		СтрокаПлатежа = Объект.РасшифровкаПлатежа[0];

		// Валюта договора - гривна (курс 1), но пересчитываем пропорцией, а не
		// приравниваем: так верно и при любом курсе.
		СтрокаПлатежа.СуммаВзаиморасчетов = Окр(СтрокаПлатежа.СуммаВзаиморасчетов * Описание.Станет / Описание.Было, 2);
		СтрокаПлатежа.СуммаПлатежа        = Описание.Станет;

		// НДС в строке есть не у каждой редакции документа - отсутствие поля
		// не должно обрывать исправление посреди списка.
		Попытка
			СтрокаПлатежа.СуммаНДС = Окр(СтрокаПлатежа.СуммаНДС * Описание.Станет / Описание.Было, 2);
		Исключение
		КонецПопытки;

		Итог.error = ЗаписатьДокумент(Объект, РежимЗаписиДокумента.Проведение);

		Если Не ПустаяСтрока(Итог.error) Тогда
			Возврат Итог;
		КонецЕсли;

		Итог.saved = Истина;

	КонецЕсли;

	Итог.ok = Истина;

	Возврат Итог;

КонецФункции

Функция СписатьКомиссию(Знач Описание, Знач СчетЭквайринга, Знач Применять)

	Итог = НоваяСтрокаИтога("Г", Описание.Ключ);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Д.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПлатежноеПоручениеИсходящее КАК Д
		|ГДЕ
		|	Д.НомерВходящегоДокумента = &Ключ
		|	И НЕ Д.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ключ", Описание.Ключ);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Итог.ok      = Истина;
		Итог.skipped = "списание уже есть: " + Строка(Выборка.Ссылка);
		Возврат Итог;
	КонецЕсли;

	// Сама выплата должна быть на месте и с той суммой, из которой считали
	// комиссию, - иначе списывать не из чего.
	Выплата = НайтиДокумент("ПлатежноеПоручениеИсходящее", Описание.НомерВыплаты, Итог);

	Если Выплата = Неопределено Тогда
		Итог.error = "выплата " + Описание.НомерВыплаты + ": " + Итог.error;
		Возврат Итог;
	КонецЕсли;

	Если Выплата.ПометкаУдаления
		Или Не Выплата.Проведен
		Или Выплата.СчетОрганизации <> СчетЭквайринга
		Или Выплата.СуммаДокумента <> Описание.СуммаВыплаты Тогда

		Итог.error = "выплата " + Строка(Выплата) + " не та: счёт " + Строка(Выплата.СчетОрганизации)
			+ ", сумма " + ФорматСуммы(Выплата.СуммаДокумента)
			+ ", ожидалась " + ФорматСуммы(Описание.СуммаВыплаты);

		Возврат Итог;

	КонецЕсли;

	Итог.change = "новое прочее списание " + ФорматСуммы(Описание.Сумма) + " от "
		+ Формат(Описание.Дата, "ДФ='dd.MM.yyyy HH:mm'") + " - " + Описание.Текст;

	ДобавитьДвижение(Итог, КодСчетаЭквайринга(), -Описание.Сумма);

	Если Применять Тогда

		// Заполнено так же, как прочие списания менеджеров в этой базе
		// (например 00000004326): без договора, только управленческий учёт,
		// статья «Прочие расходы денежных средств».
		Док = Документы.ПлатежноеПоручениеИсходящее.СоздатьДокумент();

		Док.Дата        = Описание.Дата;
		Док.ВидОперации = Перечисления.ВидыОперацийППИсходящее.ПрочееСписаниеБезналичныхДенежныхСредств;

		Док.Организация     = СчетЭквайринга.Владелец;
		Док.СчетОрганизации = СчетЭквайринга;

		Док.СуммаДокумента  = Описание.Сумма;
		Док.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду("980");

		Док.Оплачено   = Истина;
		Док.ДатаОплаты = НачалоДня(Описание.Дата);

		Док.ОтражатьВУправленческомУчете = Истина;
		Док.ОтражатьВБухгалтерскомУчете  = Ложь;

		Док.СчетБанк = ПланыСчетов.Хозрасчетный.ТекущиеСчетаВНациональнойВалюте;

		Док.НомерВходящегоДокумента = Описание.Ключ;
		Док.НазначениеПлатежа       = Описание.Текст;
		Док.Комментарий             = Описание.Текст + " (разовое исправление счёта wayforpay)";

		// Сеанс HTTP-сервиса: пользователь может быть не определён - тогда
		// ответственный остаётся пустым, а не роняет создание документа.
		Попытка
			Док.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Исключение
		КонецПопытки;

		СтрокаПлатежа = Док.РасшифровкаПлатежа.Добавить();

		СтрокаПлатежа.КурсВзаиморасчетов      = 1;
		СтрокаПлатежа.КратностьВзаиморасчетов = 1;
		СтрокаПлатежа.СуммаПлатежа            = Описание.Сумма;
		СтрокаПлатежа.СуммаВзаиморасчетов     = Описание.Сумма;

		СтрокаПлатежа.СтатьяДвиженияДенежныхСредств =
			Справочники.СтатьиДвиженияДенежныхСредств.ПрочиеРасходыДенежныхСредств;

		Итог.error = ЗаписатьДокумент(Док, РежимЗаписиДокумента.Проведение);

		Если Не ПустаяСтрока(Итог.error) Тогда
			Возврат Итог;
		КонецЕсли;

		Итог.change = Итог.change + "; создан " + Строка(Док.Ссылка);
		Итог.saved  = Истина;

	КонецЕсли;

	Итог.ok = Истина;

	Возврат Итог;

КонецФункции

