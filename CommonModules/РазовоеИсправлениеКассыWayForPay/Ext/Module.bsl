////////////////////////////////////////////////////////////////////////////////
// РАЗОВОЕ ИСПРАВЛЕНИЕ ОСТАТКА СЧЁТА «wayforpay» (БанковскиеСчета 000000074)
//
// Остаток счёта эквайринга должен быть нулём: всё, что покупатели платят через
// WayForPay, WayForPay раз в сутки выплачивает на «Р.с антон моно», и эти
// выплаты уже списаны с «wayforpay» переводами. На 15.09.2026 остаток был
// -8 139,82. Поштучная сверка с выгрузкой транзакций WayForPay (TRANSACTION_LIST:
// 141 оплата на 72 804,00 и возврат 150,00 - ровно сумма выплат) разложила его
// без остатка:
//
//  А. 25 оплат WayForPay проведены на чужие счета: 24 на «Р.с антон моно»
//     (000000071), одна на «Моно» (000000021). Кнопка WayForPay в форме заказа
//     регистрировала оплату на 071 - исправлено в
//     WayForPay.ПроверитьИЗарегистрироватьОплату. Переносим на «wayforpay»,
//     сумма, заказ и контрагент не меняются.                        +13 780,00
//  Б. 6 «Прочих поступлений» без заказа, с номером платежа, обрезанным до 15
//     символов, и за вычетом 1% - вторые экземпляры тех же оплат WayForPay
//     (настоящие - оплаты покупателей 26248, 26255, 26256, 26271 из пункта А
//     и 26287, 26289). Помечаем на удаление.                         -5 613,30
//  В. 6 оплат покупателей приняты за вычетом 1% «комиссии некарточного счёта»,
//     хотя комиссию платит покупатель. Возвращаем полную сумму.          +32,30
//  Г. Выплаты за 19.07 и 20.07 пришли за вычетом настоящей комиссии WayForPay
//     (тогда её платил магазин), и её не списали. Два «Прочих списания». -59,18
//                                                                     ---------
//                                                                         0,00
//
// Список документов зашит здесь, снаружи приходит только apply. Без apply =
// true не пишется ничего: по каждой строке возвращается «было -> станет» и
// ожидаемые остатки. Каждая строка сначала сверяется с тем, что видели при
// разборе (счёт, сумма, вид операции, номер платежа) - расхождение даёт отказ,
// а не правку. Повторный вызов безопасен: исправленные строки пропускаются.
//
// Вход - HTTPСервис.ТелеграмВебхук, действие "fixwfp"; на сайте
// assets/shop/fix_1c_wfp_cash.php. После применения модуль, ветку в сервисе
// и скрипт на сайте удалить.
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Выполнить исправление либо показать, что оно сделает.
//
// Параметры:
//  Данные - Структура - разобранное тело команды, читается только apply.
//
// Возвращаемое значение:
//  Структура - ok, apply, saved, items, balances.
//
Функция ИсправитьКассу(Знач Данные) Экспорт

	// Пользователь публикации базы - служебный, прав на документы у него нет.
	// Канал защищён общим токеном, это и есть проверка «свой - чужой».
	УстановитьПривилегированныйРежим(Истина);

	Применять = Ложь;
	Данные.Свойство("apply", Применять);
	Применять = (Применять = Истина);

	Итог = Новый Структура;
	Итог.Вставить("ok",    Ложь);
	Итог.Вставить("apply", Применять);

	СчетЭквайринга = Справочники.БанковскиеСчета.НайтиПоКоду(КодСчетаЭквайринга());

	Если СчетЭквайринга.Пустая() Тогда
		Итог.Вставить("error", "не найден банковский счёт " + КодСчетаЭквайринга());
		Возврат Итог;
	КонецЕсли;

	ОстаткиДо = ОстаткиСчетов();

	Результаты = Новый Массив;

	Для Каждого Описание Из ОплатыНаЧужихСчетах() Цикл
		Результаты.Добавить(ПеренестиОплату(Описание, СчетЭквайринга, Применять));
	КонецЦикла;

	Для Каждого Описание Из ЛишниеПрочиеПоступления() Цикл
		Результаты.Добавить(ПометитьПрочееПоступление(Описание, СчетЭквайринга, Применять));
	КонецЦикла;

	Для Каждого Описание Из ОплатыЗаВычетомПроцента() Цикл
		Результаты.Добавить(ВернутьПолнуюСумму(Описание, СчетЭквайринга, Применять));
	КонецЦикла;

	Для Каждого Описание Из НесписанныеКомиссии() Цикл
		Результаты.Добавить(СписатьКомиссию(Описание, СчетЭквайринга, Применять));
	КонецЦикла;

	Записано = 0;

	Для Каждого Результат Из Результаты Цикл
		Если Результат.saved Тогда
			Записано = Записано + 1;
		КонецЕсли;
	КонецЦикла;

	ОстаткиПосле = ?(Применять, ОстаткиСчетов(), Неопределено);

	Итог.Вставить("ok",       Истина);
	Итог.Вставить("saved",    Записано);
	Итог.Вставить("items",    Результаты);
	Итог.Вставить("balances", СводкаОстатков(ОстаткиДо, ОстаткиПосле, Результаты));

	ЗаписатьВЖурнал(Применять, Результаты, Записано);

	Возврат Итог;

КонецФункции

