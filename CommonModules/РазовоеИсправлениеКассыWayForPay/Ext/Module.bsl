// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция НоваяСтрокаИтога(Знач Шаг, Знач Документ)

	Итог = Новый Структура;
	Итог.Вставить("step",    Шаг);
	Итог.Вставить("doc",     Документ);
	Итог.Вставить("ok",      Ложь);
	Итог.Вставить("saved",   Ложь);
	Итог.Вставить("skipped", "");
	Итог.Вставить("error",   "");
	Итог.Вставить("change",  "");
	Итог.Вставить("moves",   Новый Массив);

	Возврат Итог;

КонецФункции

// Документ по номеру в пределах разбираемого периода. Номер у документов
// может повторяться по годам, поэтому ищем с датой и отказываемся при двух.
Функция НайтиДокумент(Знач ИмяДокумента, Знач Номер, Итог)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Д.Ссылка КАК Ссылка
		|ИЗ
		|	Документ." + ИмяДокумента + " КАК Д
		|ГДЕ
		|	Д.Номер = &Номер
		|	И Д.Дата МЕЖДУ &Начало И &Конец";
	Запрос.УстановитьПараметр("Номер",  Номер);
	Запрос.УстановитьПараметр("Начало", Дата(2026, 7, 1));
	Запрос.УстановитьПараметр("Конец",  Дата(2026, 9, 30, 23, 59, 59));

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		Итог.error = "документ " + Номер + " за июль-сентябрь 2026 не найден";
		Возврат Неопределено;
	КонецЕсли;

	Найденный = Выборка.Ссылка;

	Если Выборка.Следующий() Тогда
		Итог.error = "документов с номером " + Номер + " больше одного";
		Возврат Неопределено;
	КонецЕсли;

	Возврат Найденный;

КонецФункции

// Пустая строка, если документ проведён, не помечен и сумма та, что видели.
Функция ПроверитьПроведенный(Знач Ссылка, Знач Сумма)

	Если Ссылка.ПометкаУдаления Тогда
		Возврат "документ помечен на удаление";
	КонецЕсли;

	Если Не Ссылка.Проведен Тогда
		Возврат "документ не проведён";
	КонецЕсли;

	Если Ссылка.СуммаДокумента <> Сумма Тогда
		Возврат "сумма документа " + ФорматСуммы(Ссылка.СуммаДокумента) + ", ожидалась " + ФорматСуммы(Сумма);
	КонецЕсли;

	Возврат "";

КонецФункции

// Записать документ. Режим - РежимЗаписиДокумента.Проведение либо Неопределено
// для пометки удаления. Возвращает текст ошибки либо пустую строку.
Функция ЗаписатьДокумент(Объект, Знач Режим)

	// Проведение сообщает о причинах отказа через Сообщить - собираем их, иначе
	// снаружи было бы видно только «Операция не выполнена».
	ПолучитьСообщенияПользователю(Истина);

	Попытка

		Если Режим = Неопределено Тогда
			Объект.УстановитьПометкуУдаления(Истина);
		Иначе
			// Документы прошлых месяцев: оперативное проведение для них недоступно.
			Объект.Записать(Режим, РежимПроведенияДокумента.Неоперативный);
		КонецЕсли;

	Исключение

		Текст = ОписаниеОшибки();

		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Текст = Текст + "; " + Сообщение.Текст;
		КонецЦикла;

		Возврат Текст;

	КонецПопытки;

	ПолучитьСообщенияПользователю(Истина);

	Возврат "";

КонецФункции

Процедура ДобавитьДвижение(Итог, Знач КодСчета, Знач Сумма)

	Итог.moves.Добавить(Новый Структура("code, sum", КодСчета, Сумма));

КонецПроцедуры

// Остатки по регистру ДенежныеСредства на затронутых счетах: код -> сумма.
Функция ОстаткиСчетов()

	Коды = Новый Массив;
	Коды.Добавить(КодСчетаЭквайринга());
	Коды.Добавить("000000071");
	Коды.Добавить("000000021");

	Счета = Новый Массив;

	Для Каждого Код Из Коды Цикл
		Счета.Добавить(Справочники.БанковскиеСчета.НайтиПоКоду(Код));
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Остатки.БанковскийСчетКасса КАК Счет,
		|	СУММА(Остатки.СуммаОстаток) КАК Остаток
		|ИЗ
		|	РегистрНакопления.ДенежныеСредства.Остатки(, БанковскийСчетКасса В (&Счета)) КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.БанковскийСчетКасса";
	Запрос.УстановитьПараметр("Счета", Счета);

	Выгрузка = Запрос.Выполнить().Выгрузить();

	Остатки = Новый Соответствие;

	Для Индекс = 0 По Коды.ВГраница() Цикл

		Найденная = Выгрузка.Найти(Счета[Индекс], "Счет");
		Остатки.Вставить(Коды[Индекс], Новый Структура("name, sum",
			Строка(Счета[Индекс]), ?(Найденная = Неопределено, 0, Найденная.Остаток)));

	КонецЦикла;

	Возврат Остатки;

КонецФункции

// Остаток до, после (при записи - фактический, при проверке - ожидаемый
// по строкам, которые записались бы) и сколько ожидалось.
Функция СводкаОстатков(Знач ОстаткиДо, Знач ОстаткиПосле, Знач Результаты)

	Сводка = Новый Массив;

	Для Каждого Элемент Из ОстаткиДо Цикл

		Ожидается = Элемент.Значение.sum;

		Для Каждого Результат Из Результаты Цикл

			Если Не Результат.ok Или Не ПустаяСтрока(Результат.skipped) Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого Движение Из Результат.moves Цикл
				Если Движение.code = Элемент.Ключ Тогда
					Ожидается = Ожидается + Движение.sum;
				КонецЕсли;
			КонецЦикла;

		КонецЦикла;

		СтрокаСводки = Новый Структура;
		СтрокаСводки.Вставить("code",     Элемент.Ключ);
		СтрокаСводки.Вставить("name",     Элемент.Значение.name);
		СтрокаСводки.Вставить("before",   Элемент.Значение.sum);
		СтрокаСводки.Вставить("expected", Ожидается);
		СтрокаСводки.Вставить("after",    ?(ОстаткиПосле = Неопределено, Ожидается, ОстаткиПосле.Получить(Элемент.Ключ).sum));

		Сводка.Добавить(СтрокаСводки);

	КонецЦикла;

	Возврат Сводка;

КонецФункции

Функция ФорматСуммы(Знач Сумма)

	Возврат Формат(Сумма, "ЧДЦ=2; ЧРД=,; ЧН=0,00");

КонецФункции

// Журнал - единственный след того, что документы меняли снаружи. Пишем и
// проверку тоже.
Процедура ЗаписатьВЖурнал(Знач Применять, Знач Результаты, Знач Записано)

	Текст = ?(Применять, "ЗАПИСЬ", "проверка без записи")
		+ ": разовое исправление счёта wayforpay, строк "
		+ Формат(Результаты.Количество(), "ЧН=0; ЧГ=0")
		+ ", записано документов " + Формат(Записано, "ЧН=0; ЧГ=0");

	Для Каждого Результат Из Результаты Цикл

		Текст = Текст + Символы.ПС + "  " + Результат.step + " " + Результат.doc + ": "
			+ ?(Не Результат.ok, "ОТКАЗ: " + Результат.error,
				?(ПустаяСтрока(Результат.skipped), Результат.change, Результат.skipped));

	КонецЦикла;

	ЗаписьЖурналаРегистрации("База.Запись",
		?(Применять, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Примечание),
		Метаданные.Документы.ПлатежноеПоручениеВходящее, , Лев(Текст, 8000));

КонецПроцедуры
