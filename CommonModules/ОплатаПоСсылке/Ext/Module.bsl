	Возврат "/assets/shop/order_msg.php";
КонецФункции

Функция НовыйРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ссылка", "");
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("КодОшибки", "");

	Возврат Результат;

КонецФункции

Функция ТекстОшибкиПоКоду(КодОшибки)

	Если КодОшибки = "not_found" Тогда
		Возврат "Заказа с таким номером на сайте нет. Проверьте номер: заказ мог ещё не уехать в обмен.";
	ИначеЕсли КодОшибки = "paid" Тогда
		Возврат "Заказ уже оплачен, ссылка не нужна.";
	ИначеЕсли КодОшибки = "no_sum" Тогда
		Возврат "У заказа нулевая сумма - сайту нечего выставлять к оплате.";
	ИначеЕсли КодОшибки = "currency" Тогда
		Возврат "Заказ не в гривне, а оплата картой работает только для гривны.";
	ИначеЕсли КодОшибки = "opt" Тогда
		Возврат "Клиент оптовый (опт, СП, дроп, представитель) - онлайн-оплата у опта не подключена.";
	ИначеЕсли КодОшибки = "forbidden" Тогда
		Возврат "Сайт не принял ключ обмена. Сверьте константу ""Ключ обмена с сайтом"".";
	ИначеЕсли КодОшибки = "no_column" Тогда
		Возврат "На сайте не применена миграция - сообщите разработчику сайта.";
	КонецЕсли;

	Возврат "Сайт отказал в выдаче ссылки" + ?(ПустаяСтрока(КодОшибки), ".", " (" + КодОшибки + ").");

КонецФункции

Функция СтрокаJSON(Данные, Имя)

	Значение = Неопределено;
	Если Не Данные.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция БулевоJSON(Данные, Имя)

	Значение = Неопределено;
	Если Не Данные.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	ТекстЗначения = НРег(СокрЛП(Строка(Значение)));
	Возврат ТекстЗначения = "true" Или ТекстЗначения = "1" Или ТекстЗначения = "да";

КонецФункции

Процедура ЗаписатьОшибку(Заказ, Текст)

	ЗаписьЖурналаРегистрации("ОплатаПоСсылке.Ошибка",
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.Документы.ЗаказПокупателя,
		Заказ,
		Текст);

КонецПроцедуры

