////////////////////////////////////////////////////////////////////////////////
// Ссылки на страницы сайта cvetkovtm.com для менеджера: оплата заказа и
// готовый текст сообщения клиенту.
//
// Сайт по номеру заказа отдаёт постоянную ссылку вида https://cvetkovtm.com/pay/xxxx,
// на которой клиент выбирает передоплату 150 грн (остальное при получении)
// либо полную оплату картой. Дальше - страница WayForPay.
//
// Ссылка не протухает: повторный запрос по тому же заказу возвращает её же,
// поэтому запрашивать можно при каждой отправке сообщения клиенту.
//
// Об оплате по ссылке сайт в 1С не сообщает (как и об оплате из корзины) -
// статус оплаты заказа здесь не меняется.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Запрашивает у сайта ссылку на оплату заказа.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ, ссылку на оплату которого получаем.
//  Сумма - Число        - сумма заказа в гривне. Если не передана, берётся СуммаДокумента.
//                         Сумму передаём всегда: у заказов, заведённых менеджером,
//                         на сайте её может ещё не быть.
//        - Неопределено
//  Язык  - Строка       - язык страницы оплаты: ua (по умолчанию), ru, en, de, pl, sk, cs, ro, lv, lt, hr.
//
// Возвращаемое значение:
//  Структура:
//   * Успех     - Булево - ссылка получена.
//   * Ссылка    - Строка - адрес страницы оплаты, его и отправляем клиенту.
//   * Сообщение - Строка - что показать менеджеру, если ссылку выдать нельзя.
//   * КодОшибки - Строка - not_found, no_sum, currency, opt, forbidden, no_column.
//
// Данные сайта об оплате (paid, rest, advance, can_advance) здесь сознательно не
// разбираются: оплачен заказ или нет, 1С решает только по своим платёжным документам.
//
Функция ПолучитьСсылкуНаОплатуЗаказа(Заказ, Знач Сумма = Неопределено, Знач Язык = "ua") Экспорт

	Результат = НовыйРезультат();

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Результат.Сообщение = "Не указан заказ.";
		Возврат Результат;
	КонецЕсли;

	КлючОбмена = "b8c41d7ae9f2456db3a0c1e58f7d29a6";//СокрЛП(Строка(Константы.КлючОбменаСайтом.Получить()));
	Если ПустаяСтрока(КлючОбмена) Тогда
		Результат.Сообщение = "Не заполнена константа ""Ключ обмена с сайтом"".";
		ЗаписатьОшибку(Заказ, Результат.Сообщение);
		Возврат Результат;
	КонецЕсли;

	// Сайт ищет заказ сначала по номеру 1С (<order_code>), а если не нашёл и номер числовой -
	// по номеру заказа на сайте. Номера 1С уже вошли в диапазон номеров сайта, поэтому запрос
	// по заказу, которого на сайте ещё нет, находит чужой заказ и перезаписывает ему сумму.
	// Пока сайт не научится искать строго по order_code, работаем только по номеру сайта.
	Номер = СокрЛП(Строка(Заказ.НомерЗаказа2ССайта));
	Если ПустаяСтрока(Номер) Тогда
		Результат.Сообщение = "У заказа не заполнен ""Н-р заказа2 с сайта"" - заказ ещё не уехал в обмен."
			+ " Ссылку запрашивать нельзя: сайт может найти чужой заказ с таким номером.";
		ЗаписатьОшибку(Заказ, Результат.Сообщение);
		Возврат Результат;
	КонецЕсли;

	Если Сумма = Неопределено Тогда
		Сумма = Заказ.СуммаДокумента;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Строка(Язык))) Тогда
		Язык = "ua";
	КонецЕсли;

	Параметры = "token=" + КодироватьСтроку(КлючОбмена, СпособКодированияСтроки.КодировкаURL)
		+ "&order=" + КодироватьСтроку(Номер, СпособКодированияСтроки.КодировкаURL)
		+ "&lang=" + КодироватьСтроку(НРег(СокрЛП(Строка(Язык))), СпособКодированияСтроки.КодировкаURL);

	Если Сумма > 0 Тогда
		Параметры = Параметры + "&sum=" + Формат(Сумма, "ЧЦ=15; ЧДЦ=2; ЧРД=.; ЧГ=0");
	КонецЕсли;

	Попытка
		Соединение = Новый HTTPСоединение(АдресСайта(), 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
		Запрос = Новый HTTPЗапрос(ПутьСервиса() + "?" + Параметры);
		Ответ = Соединение.Получить(Запрос);
	Исключение
		Результат.Сообщение = "Сайт недоступен: " + ОписаниеОшибки();
		ЗаписатьОшибку(Заказ, Результат.Сообщение);
		Возврат Результат;
	КонецПопытки;

	Если Ответ.КодСостояния <> 200 Тогда
		Результат.Сообщение = "Сайт вернул код " + Строка(Ответ.КодСостояния) + ".";
		ЗаписатьОшибку(Заказ, Результат.Сообщение);
		Возврат Результат;
	КонецЕсли;

	Попытка
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		Результат.Сообщение = "Не удалось прочитать ответ сайта: " + ОписаниеОшибки();
		ЗаписатьОшибку(Заказ, Результат.Сообщение);
		Возврат Результат;
	КонецПопытки;

	Если ПустаяСтрока(СокрЛП(ТелоОтвета)) Тогда
		Результат.Сообщение = "Сайт вернул пустой ответ.";
		ЗаписатьОшибку(Заказ, Результат.Сообщение);
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Результат.Сообщение = "Не удалось разобрать ответ сайта: " + ОписаниеОшибки();
		ЗаписатьОшибку(Заказ, Результат.Сообщение + Символы.ПС + Лев(ТелоОтвета, 1000));
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Результат.Сообщение = "Сайт вернул неожиданный ответ.";
		ЗаписатьОшибку(Заказ, Результат.Сообщение + Символы.ПС + Лев(ТелоОтвета, 1000));
		Возврат Результат;
	КонецЕсли;

	// Поля sum/paid/rest/advance/can_advance из ответа не читаем: об оплате заказа
	// сайт для нас не источник, всё решают платёжные документы 1С.
	Если Не БулевоJSON(Данные, "ok") Тогда

		Результат.КодОшибки = СтрокаJSON(Данные, "error");
		Результат.Сообщение = СтрокаJSON(Данные, "message");

		Если ПустаяСтрока(Результат.Сообщение) Тогда
			Результат.Сообщение = ТекстОшибкиПоКоду(Результат.КодОшибки);
		КонецЕсли;

		ЗаписатьОшибку(Заказ, "Сайт не выдал ссылку на оплату (" + Результат.КодОшибки + "): " + Результат.Сообщение);
		Возврат Результат;

	КонецЕсли;

	Результат.Ссылка = СтрокаJSON(Данные, "url");

	Если ПустаяСтрока(Результат.Ссылка) Тогда
		Результат.Сообщение = "Сайт ответил успехом, но не вернул ссылку.";
		ЗаписатьОшибку(Заказ, Результат.Сообщение + Символы.ПС + Лев(ТелоОтвета, 1000));
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;

	ЗаписьЖурналаРегистрации("ОплатаПоСсылке.Выдана",
		УровеньЖурналаРегистрации.Информация,
		Метаданные.Документы.ЗаказПокупателя,
		Заказ,
		"Ссылка на оплату: " + Результат.Ссылка
			+ "; сумма заказа " + Формат(Сумма, "ЧДЦ=2; ЧГ=0") + " грн");

	Возврат Результат;

КонецФункции

// Отдаёт готовый текст сообщения клиенту и адрес страницы с ним же.
//
// Текст собирает сайт, а не 1С: в нём нужны эмодзи, а в модуле формы они не
// переживают выгрузку конфигурации в файлы - от них остаются вопросики.
// Отсюда уезжают только данные заказа, а формулировки лежат в
// assets/shop/order_msg_tpl.txt и правятся без Конфигуратора.
//
// Текст приходит одним куском, без строки-разделителя "---": на два сообщения
// менеджер делит его сам при отправке. Ссылка на страницу - запасной путь:
// эмодзи здесь идут через строку 1С и COM-буфер обмена, и если они всё же
// покалечатся, со страницы текст копируется как есть.
//
// Параметры:
//  Данные - Структура - поля см. в шапке assets/shop/order_msg.php:
//           order, sum, scenario, paid, rest, advance, pay_url, cod,
//           recipient (Структура), items (Массив структур).
//  Заказ  - ДокументСсылка.ЗаказПокупателя - только для журнала регистрации.
//         - Неопределено
//
// Возвращаемое значение:
//  Структура:
//   * Успех     - Булево - текст получен.
//   * Текст     - Строка - готовое сообщение для клиента.
//   * Ссылка    - Строка - адрес страницы с тем же текстом.
//   * Сообщение - Строка - что показать менеджеру при отказе.
//
Функция ПолучитьСсылкуНаТекстДляКлиента(Данные, Знач Заказ = Неопределено) Экспорт

	Результат = НовыйРезультат();
	Результат.Вставить("Текст", "");

	КлючОбмена = "b8c41d7ae9f2456db3a0c1e58f7d29a6";

	Попытка
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, Данные);
		ДанныеJSON = ЗаписьJSON.Закрыть();
	Исключение
		Результат.Сообщение = "Не удалось собрать данные заказа: " + ОписаниеОшибки();
		ЗаписатьОшибку(Заказ, Результат.Сообщение);
		Возврат Результат;
	КонецПопытки;

	ТелоЗапроса = "token=" + КодироватьСтроку(КлючОбмена, СпособКодированияСтроки.КодировкаURL)
		+ "&data=" + КодироватьСтроку(ДанныеJSON, СпособКодированияСтроки.КодировкаURL);

	Попытка
		Соединение = Новый HTTPСоединение(АдресСайта(), 443, , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
		Запрос = Новый HTTPЗапрос(ПутьСервисаТекста());
		Запрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		Результат.Сообщение = "Сайт недоступен: " + ОписаниеОшибки();
		ЗаписатьОшибку(Заказ, Результат.Сообщение);
		Возврат Результат;
	КонецПопытки;

	Если Ответ.КодСостояния <> 200 Тогда
		Результат.Сообщение = "Сайт вернул код " + Строка(Ответ.КодСостояния) + ".";
		ЗаписатьОшибку(Заказ, Результат.Сообщение);
		Возврат Результат;
	КонецЕсли;

	Попытка
		ТелоОтвета = СокрЛП(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
	Исключение
		Результат.Сообщение = "Не удалось прочитать ответ сайта: " + ОписаниеОшибки();
		ЗаписатьОшибку(Заказ, Результат.Сообщение);
		Возврат Результат;
	КонецПопытки;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Результат.Сообщение = "Не удалось разобрать ответ сайта: " + ОписаниеОшибки();
		ЗаписатьОшибку(Заказ, Результат.Сообщение + Символы.ПС + Лев(ТелоОтвета, 1000));
		Возврат Результат;
	КонецПопытки;

	Если ТипЗнч(ДанныеОтвета) <> Тип("Структура") Или Не БулевоJSON(ДанныеОтвета, "ok") Тогда
		Результат.Сообщение = СтрокаJSON(ДанныеОтвета, "error");
		Если ПустаяСтрока(Результат.Сообщение) Тогда
			Результат.Сообщение = "Сайт не отдал текст для клиента.";
		КонецЕсли;
		ЗаписатьОшибку(Заказ, "Текст для клиента не получен: " + Результат.Сообщение);
		Возврат Результат;
	КонецЕсли;

	Результат.Текст  = СтрокаJSON(ДанныеОтвета, "text");
	Результат.Ссылка = СтрокаJSON(ДанныеОтвета, "url");

	// Отправка клиенту в Telegram, если её просили (Данные.send_tg): сайт
	// возвращает, скольким чатам клиента текст поставлен в очередь бота,
	// и причину, когда никому (нет привязанного чата, заказ не найден).
	ТелеграмОтправлено = 0;
	Попытка
		ТелеграмОтправлено = Число(СтрокаJSON(ДанныеОтвета, "tg_sent"));
	Исключение
		ТелеграмОтправлено = 0;
	КонецПопытки;

	Результат.Вставить("ТелеграмОтправлено", ТелеграмОтправлено);
	Результат.Вставить("ТелеграмЗаметка", СтрокаJSON(ДанныеОтвета, "tg_note"));

	Если ПустаяСтрока(Результат.Текст) Тогда
		Результат.Сообщение = "Сайт вернул пустой текст.";
		ЗаписатьОшибку(Заказ, Результат.Сообщение);
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;

	ЗаписьЖурналаРегистрации("ОплатаПоСсылке.ТекстДляКлиента",
		УровеньЖурналаРегистрации.Информация,
		Метаданные.Документы.ЗаказПокупателя,
		Заказ,
		"Текст для клиента получен, страница: " + Результат.Ссылка);

	Возврат Результат;

КонецФункции

// Готовый текст для клиента по заказу - тот же, что собирает кнопка "Оплата"
// в форме заказа, - для кнопки на карточке заказа в боте менеджера.
// Данные заказа собираются здесь, на сервере (у бота нет формы), текст
// строит сайт (шаблоны с эмодзи живут у него). Клиенту сайт ничего НЕ шлёт:
// текст возвращается менеджеру, дальше он пересылает его сам.
//
// Возвращаемое значение:
//  Структура - как у ПолучитьСсылкуНаТекстДляКлиента (Успех, Текст, Ссылка,
//  Сообщение).
//
Функция ТекстЗаказаДляКлиента(Заказ) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Возврат ПолучитьСсылкуНаТекстДляКлиента(ДанныеЗаказаДляТекста(Заказ), Заказ);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Данные заказа для текста клиенту - серверный аналог сборки из кнопки
// "Оплата" формы заказа (КоманднаяПанельТабРезерваОстатокОплата). Отличие
// одно: форма идёт по своей таблице остатка резерва, здесь берём товары
// документа - у вызова из бота формы нет.
//
// Сценарий, суммы и получатель считаются той же логикой, что в форме:
// оплата - по деньгам в 1С (СуммаОплатПоЗаказу), опт - по контрагенту
// (Маруся считается розницей), наложка уменьшается на передоплату там,
// где мы её просим этим же сообщением.
Функция ДанныеЗаказаДляТекста(Заказ)

	НомерЗаказа = ?(ЗначениеЗаполнено(Заказ.НомерЗаказа2ССайта),
		Заказ.НомерЗаказа2ССайта,
		ОбщегоНазначения.УбратьНоликиСлева(Заказ.Номер));

	Позиции = Новый Массив;

	Для Каждого Стр Из Заказ.Товары Цикл

		Характеристика = Стр.ХарактеристикаНоменклатуры;

		Если ЗначениеЗаполнено(Характеристика) Тогда

			ХарОб = Характеристика.ПолучитьОбъект();

			Если ХарОб.ЭтоХарактеристикаРучнойНК() Тогда
				Характеристика = ХарОб.Комплектующие_НК()[0].ХарактеристикаКомплектующей;
			КонецЕсли;

		КонецЕсли;

		// В товарах документа срок - дата (в форме была строка); "пустая" дата
		// значит "готово", её клиенту не показываем.
		Готовность = "";
		Если ЗначениеЗаполнено(Стр.СрокИзготовления) Тогда
			Готовность = Формат(Стр.СрокИзготовления, "ДФ=dd.MM.yyyy");
		КонецЕсли;

		СсылкаНаЗамеры = "";

		Если ЗначениеЗаполнено(Характеристика) Тогда

			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	""http://cvetkovtm.com/assets/shop/sync/imgJpg/"" + ГруппаЦветовФотографии.Наименование КАК Ссылка
				|ИЗ
				|	Справочник.ГруппаЦветов.Фотографии КАК ГруппаЦветовФотографии
				|ГДЕ
				|	ГруппаЦветовФотографии.Ссылка.Наименование = &Наименование
				|	И ГруппаЦветовФотографии.Ссылка.Владелец = &Владелец
				|
				|УПОРЯДОЧИТЬ ПО
				|	Ссылка";

			Запрос.УстановитьПараметр("Владелец", Характеристика.Владелец);
			Запрос.УстановитьПараметр("Наименование", "Замеры");

			Выборка = Запрос.Выполнить().Выбрать();

			Если Выборка.Следующий() Тогда
				СсылкаНаЗамеры = Строка(Выборка.Ссылка);
			КонецЕсли;

		КонецЕсли;

		Позиция = Новый Структура;
		Позиция.Вставить("name", ?(ЗначениеЗаполнено(Характеристика),
			Строка(Характеристика.Владелец.Наименование), Строка(Стр.Номенклатура)));
		Позиция.Вставить("variant", ?(ЗначениеЗаполнено(Характеристика),
			Строка(Характеристика.Наименование), ""));
		Позиция.Вставить("ready", Готовность);
		Позиция.Вставить("measure_url", СсылкаНаЗамеры);

		Позиции.Добавить(Позиция);

	КонецЦикла;

	СуммаЗаказа = Заказ.СуммаДокумента;
	Если СуммаЗаказа = 0 Тогда
		СуммаЗаказа = Заказ.Товары.Итог("Сумма");
	КонецЕсли;

	ЭтоОпт = Ложь;
	Если ЗначениеЗаполнено(Заказ.Контрагент) Тогда
		КонтрагентОбъект = Заказ.Контрагент.ПолучитьОбъект();
		ЭтоОпт = КонтрагентОбъект.ЭтоОптовик() И Не КонтрагентОбъект.ЭтоМаруся();
	КонецЕсли;

	Оплачено = Документы.ЗаказПокупателя.СуммаОплатПоЗаказу(Заказ);

	ЗаказОплачен = СуммаЗаказа > 0 И Оплачено >= СуммаЗаказа;
	НужнаОплата = Не ЭтоОпт И Не ЗаказОплачен;

	// Размер передоплаты - тот же, что зашит на странице оплаты (WFP_COD_ADVANCE).
	РазмерПередоплаты = 150;

	СсылкаОплаты = "";

	Если НужнаОплата Тогда

		РезультатОплаты = ПолучитьСсылкуНаОплатуЗаказа(Заказ, СуммаЗаказа);

		Если РезультатОплаты.Успех Тогда
			СсылкаОплаты = РезультатОплаты.Ссылка;
		КонецЕсли;

	КонецЕсли;

	ЕстьПредоплата = Не ЗаказОплачен И Оплачено > 0;
	ОсталосьОплатить = СуммаЗаказа - Оплачено;

	Если ЗаказОплачен Тогда
		Сценарий = "paid";
	ИначеЕсли ЭтоОпт Тогда
		Сценарий = "opt";
	ИначеЕсли ЕстьПредоплата Тогда
		Сценарий = ?(ПустаяСтрока(СсылкаОплаты), "advance", "advance_link");
	ИначеЕсли Не ПустаяСтрока(СсылкаОплаты) Тогда
		Сценарий = ?(СуммаЗаказа > РазмерПередоплаты, "pay_link", "pay_link_full");
	Иначе
		Сценарий = "no_link";
	КонецЕсли;

	// Наложка объявлена на всю сумму; если этим же сообщением просим
	// передоплату - клиенту называем то, что он реально доплатит при получении.
	Наложка = 0;

	Если ЗначениеЗаполнено(Заказ.СуммаНоваяПочта) Тогда

		ТекстНаложки = СтрЗаменить(Строка(Заказ.СуммаНоваяПочта), Символ(160), "");
		ТекстНаложки = СтрЗаменить(ТекстНаложки, " ", "");
		ТекстНаложки = СтрЗаменить(ТекстНаложки, ",", ".");

		Попытка
			Наложка = Число(ТекстНаложки);
		Исключение
			Наложка = 0;
		КонецПопытки;

	КонецЕсли;

	Если Наложка > РазмерПередоплаты
		И (Сценарий = "pay_link" Или Сценарий = "pay_link_full" Или Сценарий = "no_link") Тогда

		Наложка = Наложка - РазмерПередоплаты;

	КонецЕсли;

	Город = Строка(Заказ.ГородНовойПочтыЗначение);
	Склад = Строка(Заказ.СкладНовойПочтыЗначение);

	ДанныеПолучателя = Новый Структура;
	ДанныеПолучателя.Вставить("known", Не ПустаяСтрока(Город));
	ДанныеПолучателя.Вставить("name", Строка(Заказ.Получатель));
	ДанныеПолучателя.Вставить("phone", Строка(Заказ.ТелефонКонтрагента));
	ДанныеПолучателя.Вставить("city", Город);
	ДанныеПолучателя.Вставить("branch", Склад);

	Данные = Новый Структура;
	Данные.Вставить("order", Строка(НомерЗаказа));
	Данные.Вставить("order_1c", ОбщегоНазначения.УбратьНоликиСлева(Заказ.Номер));
	Данные.Вставить("sum", СуммаЗаказа);
	Данные.Вставить("scenario", Сценарий);
	Данные.Вставить("paid", Оплачено);
	Данные.Вставить("rest", ОсталосьОплатить);
	Данные.Вставить("advance", РазмерПередоплаты);
	Данные.Вставить("pay_url", СсылкаОплаты);
	Данные.Вставить("cod", Наложка);
	Данные.Вставить("recipient", ДанныеПолучателя);
	Данные.Вставить("items", Позиции);

	Возврат Данные;

КонецФункции

Функция АдресСайта()
	Возврат "cvetkovtm.com";
КонецФункции

Функция ПутьСервиса()
	Возврат "/assets/shop/pay_link.php";
КонецФункции

