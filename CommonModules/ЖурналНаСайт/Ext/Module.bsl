// Пересылка ошибок журнала регистрации на сайт.
//
// Зачем. База и Конфигуратор стоят на другой машине, журнал регистрации виден
// только там. Любой разбор "почему не сработало" упирается в просьбу открыть
// журнал и переслать текст оттуда. Этот модуль забирает из журнала свежие
// Ошибки и Предупреждения - ЛЮБЫЕ, не только по нашим доработкам, - и кладёт
// их в лог на хостинге, откуда их видно по токену из браузера.
//
// Позицию "докуда уже отправлено" хранит САЙТ, а не 1С: спрашиваем у него дату
// последнего принятого события и продолжаем с неё. Так не нужны ни константа,
// ни регистр сведений - никаких структурных изменений в базе, только модуль.
// Побочная польза: лог на сайте можно очистить, и 1С зальёт его заново с
// глубины ГлубинаПервогоЗапуска().
//
// Границу берём ВКЛЮЧИТЕЛЬНО (с той же секунды, что и последнее событие) -
// иначе терялись бы события, попавшие в ту же секунду. Дубли отсекает сайт
// по хешу строки.
//
// Свои собственные ошибки модуль пишет в журнал отдельным событием
// (ИмяСобытия) и это же событие выкидывает из выгрузки. Иначе неудачная
// отправка поехала бы следующей порцией, снова упала - и журнал начал бы
// расти сам от себя.
//
// Отдельного регламентного задания НЕТ: ОтправитьОшибки() вызывается из
// ТелеграмБот.ОбменСБотом(), то есть заданием ТелеграмОбмен раз в 1-2 минуты.
// Так сделано намеренно: расписание предопределённых заданий в метаданных не
// хранится, и новое задание пришлось бы заводить в базе руками - а забытое
// расписание не даёт никакой ошибки, просто ничего не приезжает.

#Область ПрограммныйИнтерфейс

// Отправляет на сайт очередную порцию ошибок журнала регистрации.
// Точка входа; вызывается из ТелеграмБот.ОбменСБотом().
//
Процедура ОтправитьОшибки() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Попытка
		ОтправитьПорцию();
	Исключение
		ЗаписатьСвоюОшибку("Отправка ошибок на сайт не удалась: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Ручная проверка из консоли кода: ЖурналНаСайт.Проверка();
// Ничего не отправляет - только показывает, что видит с обеих сторон.
//
// Возвращаемое значение:
//  Строка - что ответил сайт и сколько событий готово к отправке.
//
Функция Проверка() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Позиция = ПозицияССайта();

	Если Позиция = Неопределено Тогда
		Возврат "Сайт не ответил на запрос позиции. Причина - в журнале"
			+ " регистрации, событие """ + ИмяСобытия() + """."
			+ Символы.ПС + "Адрес приёмника: https://" + ХостСайта() + ПутьПриемника();
	КонецЕсли;

	Таблица = СобытияЖурнала(Позиция);

	Если Таблица = Неопределено Тогда
		Возврат "Позиция на сайте: " + ДатаВСтроку(Позиция) + Символы.ПС
			+ "Прочитать журнал регистрации не удалось - смотрите событие """
			+ ИмяСобытия() + """.";
	КонецЕсли;

	События = СобранныеСобытия(Таблица);

	Результат = "Приёмник: https://" + ХостСайта() + ПутьПриемника() + Символы.ПС
		+ "Позиция на сайте: " + ДатаВСтроку(Позиция) + Символы.ПС
		+ "Прочитано из журнала: " + Строка(Таблица.Количество())
		+ " (потолок порции " + Строка(РазмерПорции()) + ")" + Символы.ПС
		+ "Готово к отправке: " + Строка(События.Количество()) + Символы.ПС;

	Для Каждого Запись Из События Цикл

		Результат = Результат + Символы.ПС
			+ Запись.date + "  " + Запись.level + "  " + Запись.event + "  "
			+ Лев(Запись.text, 120);

		Если СтрЧислоСтрок(Результат) > 30 Тогда
			Результат = Результат + Символы.ПС + "...";
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтправитьПорцию()

	Позиция = ПозицияССайта();

	// Сайт не ответил - причина уже в журнале, ждём следующего прогона.
	// Отправлять "вслепую" нельзя: без позиции мы не знаем, с чего начинать,
	// и залили бы журнал заново целиком.
	Если Позиция = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Таблица = СобытияЖурнала(Позиция);

	Если Таблица = Неопределено Или Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	События = СобранныеСобытия(Таблица);

	Если События.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("token",  ТокенСайта());
	Тело.Вставить("action", "push");
	Тело.Вставить("events", События);

	Ответ = ЗапросКСайту(ВJSON(Тело));

	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Принято = Ложь;
	Ответ.Свойство("ok", Принято);

	Если Принято <> Истина Тогда

		Ошибка = "";
		Ответ.Свойство("error", Ошибка);

		ЗаписатьСвоюОшибку("Сайт отказался принять ошибки: " + Строка(Ошибка));

	КонецЕсли;

КонецПроцедуры

// Дата последнего события, которое уже лежит в логе на сайте.
//
// Возвращаемое значение:
//  Дата         - с неё (включительно) читаем журнал;
//  Неопределено - сайт недоступен или ответил невнятно.
//
Функция ПозицияССайта()

	Параметры = Новый Структура;
	Параметры.Вставить("token",  ТокенСайта());
	Параметры.Вставить("action", "last");

	Ответ = ЗапросКСайту(ВJSON(Параметры));

	Если Ответ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Последняя = "";
	Ответ.Свойство("last", Последняя);
	Последняя = СокрЛП(Строка(Последняя));

	// Лога на сайте ещё нет (первый запуск или его очистили) - берём недавнее
	// прошлое, а не журнал целиком: на типовой базе это сотни тысяч записей.
	Если СтрДлина(Последняя) <> 14 Тогда
		Возврат ТекущаяДата() - ГлубинаПервогоЗапуска();
	КонецЕсли;

	Попытка
		Возврат Дата(Последняя);
	Исключение
		Возврат ТекущаяДата() - ГлубинаПервогоЗапуска();
	КонецПопытки;

КонецФункции

// Порция записей журнала начиная с указанной даты включительно.
//
// Возвращаемое значение:
//  ТаблицаЗначений - записи журнала;
//  Неопределено    - журнал прочитать не удалось.
//
Функция СобытияЖурнала(Знач НачальнаяДата)

	Отбор = Новый Структура;
	Отбор.Вставить("ДатаНачала", НачальнаяДата);
	Отбор.Вставить("Уровень",    УровниОтбора());

	Таблица = Новый ТаблицаЗначений;

	// Журнал может быть недоступен (формат, права, размер) - это не повод
	// ронять регламент, который кроме нас делает ещё три полезных дела.
	Попытка
		ВыгрузитьЖурналРегистрации(Таблица, Отбор, , РазмерПорции());
	Исключение
		ЗаписатьСвоюОшибку("Прочитать журнал регистрации не удалось: " + ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

	Возврат Таблица;

КонецФункции

// Записи журнала -> массив структур для сайта.
Функция СобранныеСобытия(Таблица)

	События = Новый Массив;

	Для Каждого СтрокаЖурнала Из Таблица Цикл

		Событие = ЗначениеКолонки(Таблица, СтрокаЖурнала, "Событие");

		// Свои же ошибки отправлять нельзя - см. шапку модуля.
		Если Событие = ИмяСобытия() Тогда
			Продолжить;
		КонецЕсли;

		Запись = Новый Структура;
		Запись.Вставить("date",     ДатаВСтроку(ДатаКолонки(Таблица, СтрокаЖурнала)));
		Запись.Вставить("level",    Лев(ЗначениеКолонки(Таблица, СтрокаЖурнала, "Уровень"), 20));
		Запись.Вставить("event",    Лев(Событие, 100));
		Запись.Вставить("user",     Лев(ЗначениеКолонки(Таблица, СтрокаЖурнала, "ИмяПользователя"), 60));
		Запись.Вставить("computer", Лев(ЗначениеКолонки(Таблица, СтрокаЖурнала, "Компьютер"), 40));
		Запись.Вставить("app",      Лев(ЗначениеКолонки(Таблица, СтрокаЖурнала, "ИмяПриложения"), 40));
		Запись.Вставить("meta",     Лев(ЗначениеКолонки(Таблица, СтрокаЖурнала, "ПредставлениеМетаданных"), 150));
		Запись.Вставить("data",     Лев(ЗначениеКолонки(Таблица, СтрокаЖурнала, "ПредставлениеДанных"), 200));
		Запись.Вставить("text",     Лев(ЗначениеКолонки(Таблица, СтрокаЖурнала, "Комментарий"), 3000));

		События.Добавить(Запись);

	КонецЦикла;

	Возврат События;

КонецФункции

// Значение колонки строкой. Набор колонок выгрузки зависит от версии
// платформы, поэтому обращаемся только к тем, что реально есть.
Функция ЗначениеКолонки(Таблица, СтрокаЖурнала, Знач ИмяКолонки)

	Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = СтрокаЖурнала[ИмяКолонки];

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

// Дата записи журнала. Пустая дата сломала бы позицию на сайте (сайт взял бы
// её за "последнюю" и следующая порция поехала бы от начала времён), поэтому
// подставляем текущую.
Функция ДатаКолонки(Таблица, СтрокаЖурнала)

	Если Таблица.Колонки.Найти("Дата") = Неопределено Тогда
		Возврат ТекущаяДата();
	КонецЕсли;

	Значение = СтрокаЖурнала["Дата"];

	Если ТипЗнч(Значение) <> Тип("Дата") Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат ТекущаяДата();
	КонецЕсли;

	Возврат Значение;

КонецФункции

// POST на сайт: сначала штатным HTTPСоединением, при отказе - через WinHttp.
// Ровно тот же порядок, что в ТелеграмБот.ЗапросКСайту: какой способ доступен
// на сервере, выясняется только на живой базе.
//
// Возвращаемое значение:
//  Структура    - разобранный JSON-ответ сайта;
//  Неопределено - сайт недоступен или ответил не JSON.
//
Функция ЗапросКСайту(Знач ТелоЗапроса)

	Адрес      = "https://" + ХостСайта() + ПутьПриемника();
	ТелоОтвета = "";

	Попытка

		Соединение = Новый HTTPСоединение(ХостСайта(), 443, , , , 30,
			Новый ЗащищенноеСоединениеOpenSSL);

		Запрос = Новый HTTPЗапрос(ПутьПриемника());
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8",
			ИспользованиеByteOrderMark.НеИспользовать);

		Ответ      = Соединение.ОтправитьДляОбработки(Запрос);
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");

	Исключение

		ОшибкаHTTPСоединения = ОписаниеОшибки();
		ТелоОтвета           = "";

		Попытка

			HTTP = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");
			HTTP.Open("POST", Адрес, Ложь);
			HTTP.SetRequestHeader("Content-Type", "application/json; charset=utf-8");
			HTTP.SetTimeouts(15000, 15000, 30000, 30000);
			HTTP.Send(ТелоЗапроса);

			ТелоОтвета = Строка(HTTP.ResponseText);

		Исключение

			ЗаписатьСвоюОшибку("Сайт недоступен."
				+ Символы.ПС + "HTTPСоединение: " + ОшибкаHTTPСоединения
				+ Символы.ПС + "WinHttp: " + ОписаниеОшибки());

			Возврат Неопределено;

		КонецПопытки;

	КонецПопытки;

	Если ПустаяСтрока(СокрЛП(ТелоОтвета)) Тогда
		ЗаписатьСвоюОшибку("Сайт вернул пустой ответ.");
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		ЗаписатьСвоюОшибку("Не удалось разобрать ответ сайта: " + ОписаниеОшибки()
			+ Символы.ПС + Лев(ТелоОтвета, 500));
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ЗаписатьСвоюОшибку("Сайт вернул неожиданный ответ: " + Лев(ТелоОтвета, 500));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция ВJSON(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

Функция ДатаВСтроку(Знач Значение)

	Возврат Формат(Значение, "ДФ='yyyyMMddHHmmss'");

КонецФункции

// Уровни, которые отправляем. Предупреждения включены намеренно: половина
// проблем обмена (не найден товар, не разобран файл) пишется именно ими.
// Станет шумно - убрать вторую строку, больше нигде править не нужно.
Функция УровниОтбора()

	Уровни = Новый Массив;
	Уровни.Добавить(УровеньЖурналаРегистрации.Ошибка);
	Уровни.Добавить(УровеньЖурналаРегистрации.Предупреждение);

	Возврат Уровни;

КонецФункции

// Потолок одной порции. Если за прогон накопилось больше, остальное уедет
// следующим прогоном через минуту - позиция сдвигается по факту отправленного.
Функция РазмерПорции()

	Возврат 300;

КонецФункции

// С какой глубины начинать, когда на сайте ещё ничего нет. Сутки: хватает,
// чтобы разобрать вчерашнюю поломку, и не поднимает архив за годы.
Функция ГлубинаПервогоЗапуска()

	Возврат 24 * 60 * 60;

КонецФункции

// Приёмник на сайте и его секрет. Секрет тот же, что у уведомлений менеджеру
// (ТелеграмБот.ТокенСайта) - граница доверия одна и та же: 1С пишет на сайт.
Функция ХостСайта()

	Возврат "cvetkovtm.com";

КонецФункции

Функция ПутьПриемника()

	Возврат "/assets/shop/cron_1c_log.php";

КонецФункции

Функция ТокенСайта()

	Возврат "e4cfdff6ad370ca2f0e26d8eb82bcda9";

КонецФункции

// Имя события журнала для СВОИХ ошибок. Оно же - фильтр в СобранныеСобытия:
// эти записи на сайт не уезжают, иначе неудачная отправка размножала бы себя.
Функция ИмяСобытия()

	Возврат "ЖурналНаСайт";

КонецФункции

Процедура ЗаписатьСвоюОшибку(Знач Текст)

	ЗаписьЖурналаРегистрации(ИмяСобытия(),
		УровеньЖурналаРегистрации.Ошибка, , , Лев(Текст, 3000));

КонецПроцедуры

#КонецОбласти
