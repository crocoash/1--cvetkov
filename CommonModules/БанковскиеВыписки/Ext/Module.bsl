            Процедура ЗагрузитьБанковскиеВыписки(
	ПараметрыЗагрузки) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		Если ПараметрыЗагрузки = Неопределено Тогда
			
			Сообщить(
				"Загрузка банковских выписок: "
				+ "не переданы параметры загрузки.");
			
			Возврат;
			
		КонецЕсли;
		
		Организация = Неопределено;
		ДатаНачала  = Неопределено;
		ДатаКонца   = Неопределено;
		
		Если Не ПараметрыЗагрузки.Свойство(
			"Организация",
			Организация) Тогда
			
			Сообщить(
				"Загрузка банковских выписок: "
				+ "не передана организация.");
			
			Возврат;
			
		КонецЕсли;
		
		Если Не ПараметрыЗагрузки.Свойство(
			"ДатаНачала",
			ДатаНачала) Тогда
			
			Сообщить(
				"Загрузка банковских выписок: "
				+ "не передана дата начала.");
			
			Возврат;
			
		КонецЕсли;
		
		Если Не ПараметрыЗагрузки.Свойство(
			"ДатаКонца",
			ДатаКонца) Тогда
			
			Сообщить(
				"Загрузка банковских выписок: "
				+ "не передана дата окончания.");
			
			Возврат;
			
		КонецЕсли;
		
		Если ТипЗнч(ДатаНачала) <> Тип("Дата")
			Или ТипЗнч(ДатаКонца) <> Тип("Дата") Тогда
			
			Сообщить(
				"Загрузка банковских выписок: "
				+ "период должен быть передан типом Дата.");
			
			Возврат;
			
		КонецЕсли;
		
		ДокументыКИмпорту =
			ПолучитьТаблицуДокументовКИмпорту();
		
		Если ДокументыКИмпорту = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ДокументыКИмпорту.Очистить();
		
		ТаблицаСчетов =
			ПолучитьСчетаДляЗагрузкиВыписок(
				Организация);
		
		Если ТаблицаСчетов.Количество() = 0 Тогда
			
			Сообщить(
				"Загрузка банковских выписок: "
				+ "не найдено ни одного настроенного банковского счета.");
			
			СохранитьТаблицуДокументовКИмпорту(
				ДокументыКИмпорту);
			
			Возврат;
			
		КонецЕсли;
		
		ОтладкаВыписокСообщить(
			"Организация: " + Строка(Организация)
			+ ", период " + Формат(ДатаНачала, "ДФ=dd.MM.yyyy")
			+ " - " + Формат(ДатаКонца, "ДФ=dd.MM.yyyy")
			+ ", найдено счетов: " + Строка(ТаблицаСчетов.Количество()));
		
		Для Каждого СтрокаОтладкиСчета Из ТаблицаСчетов Цикл
			ОтладкаВыписокСообщить(
				"  счёт: " + Строка(СтрокаОтладкиСчета.БанковскийСчет)
				+ ", источник: " + Строка(СтрокаОтладкиСчета.Источник));
		КонецЦикла;
		
		Для Каждого СтрокаСчета Из ТаблицаСчетов Цикл

			ЗагрузитьВыпискуПоСчету(

			СтрокаСчета.БанковскийСчет,
			СтрокаСчета.БанковскийСчет.ИсточникБанковскойВыписки,
			ДатаНачала,
			ДатаКонца,
			ДокументыКИмпорту,
			СтрокаСчета.Направление);
		КонецЦикла;

		// Карточные выписки НЕ запрашиваются: старое API p24api/rest_fiz
		// закрыто банком 25.11.2022 (проверено 22.07.2026 — все карты
		// отвечают "The service closed"). API для личных карт у Привата нет;
		// операции текущего дня по расчётному счёту закрывает interim.

		ДокументыКИмпорту.Сортировать(
		"ДатаПроведения Убыв");
		
		СохранитьТаблицуДокументовКИмпорту(
			ДокументыКИмпорту);
		
		ОбновитьДатуСледующейЗагрузки(
			ДокументыКИмпорту,
			ДатаКонца);

		// Пришли поступления, которых менеджеры ещё не видели, - сигнал им задачей.
		// В отдельной Попытке: сбой задачи не должен ронять саму загрузку выписки.
		Попытка

			ОбновитьЗадачуПоНовымПлатежам(
				ДокументыКИмпорту);

		Исключение

			ОтладкаВыписокСообщить(
				"Задача по новым платежам не обновлена: "
				+ ОписаниеОшибки());

		КонецПопытки;

		Сообщить(
			"Загрузка банковских выписок завершена. "
			+ "Получено операций: "
			+ Строка(ДокументыКИмпорту.Количество()) + ".");
		
	Исключение
		
		Сообщить(
			"Ошибка загрузки банковских выписок: "
			+ ОписаниеОшибки());
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


Функция ПолучитьСчетаДляЗагрузкиВыписок(
	Организация) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	
	Результат.Колонки.Добавить("БанковскийСчет");
	Результат.Колонки.Добавить("Источник");
	Результат.Колонки.Добавить("Токен");
	Результат.Колонки.Добавить("ИдентификаторСчета");
	Результат.Колонки.Добавить("Направление");

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	БанковскиеСчета.Ссылка КАК БанковскийСчет,
	|	БанковскиеСчета.ИсточникБанковскойВыписки КАК Источник,
	|	БанковскиеСчета.Токен КАК Токен,
	|	БанковскиеСчета.Айди КАК ИдентификаторСчета,
	|	БанковскиеСчета.НаправлениеОпераций КАК Направление
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Организация
	|	И БанковскиеСчета.ЗагружатьБанковскуюВыписку
	|	И НЕ БанковскиеСчета.ПометкаУдаления
	|	И БанковскиеСчета.ИсточникБанковскойВыписки
	|		<> &НеИспользуется
	|
	|УПОРЯДОЧИТЬ ПО
	|	БанковскиеСчета.Наименование";
	
	Запрос.УстановитьПараметр(
		"Организация",
		Организация);
	
	Запрос.УстановитьПараметр(
		"НеИспользуется",
		Перечисления.ИсточникиБанковскихВыписок
			.НеИспользуется);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		// У WayForPay нет пер-счётных токенов — реквизиты берутся из общих
		// констант (WayForPayMerchantAccount/MerchantSecretKey), поэтому
		// счёт не пропускаем из-за пустых Токен/Айди.
		Если Выборка.Источник <>
			Перечисления.ИсточникиБанковскихВыписок.WayForPay Тогда

			Если Не ЗначениеЗаполнено(Выборка.Токен) Тогда

				Сообщить(
					"Банковский счет «"
					+ Строка(Выборка.БанковскийСчет)
					+ "» пропущен: не заполнен токен.");

				Продолжить;

			КонецЕсли;

			Если Не ЗначениеЗаполнено(
				Выборка.ИдентификаторСчета) Тогда

				Сообщить(
					"Банковский счет «"
					+ Строка(Выборка.БанковскийСчет)
					+ "» пропущен: не заполнен идентификатор счета.");

				Продолжить;

			КонецЕсли;

		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		
		НоваяСтрока.БанковскийСчет =
			Выборка.БанковскийСчет;
		
		НоваяСтрока.Источник =
			Выборка.Источник;
		
		НоваяСтрока.Токен =
			СокрЛП(Выборка.Токен);
		
		НоваяСтрока.ИдентификаторСчета =
			СокрЛП(Выборка.ИдентификаторСчета);

		НоваяСтрока.Направление =
			Выборка.Направление;

	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗагрузитьВыпискуПоСчету(
	БанковскийСчет,
	ИсточникВыписки,
	ДатаНачала,
	ДатаКонца,
	ДокументыКИмпорту,
	Направление = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Операции = Новый Массив;
	
	Если ИсточникВыписки =
		Перечисления.ИсточникиБанковскихВыписок.Приват24Бизнес Тогда
		
		Операции =
			ПолучитьОперацииПриват24Бизнес(
				БанковскийСчет,
				ДатаНачала,
				ДатаКонца);
		
	ИначеЕсли ИсточникВыписки =
		Перечисления.ИсточникиБанковскихВыписок.Monobank Тогда

		Операции =
			ПолучитьОперацииMonobank(
				БанковскийСчет,
				ДатаНачала,
				ДатаКонца);

	ИначеЕсли ИсточникВыписки =
		Перечисления.ИсточникиБанковскихВыписок.WayForPay Тогда

		Операции =
			ПолучитьОперацииWayForPay(
				БанковскийСчет,
				ДатаНачала,
				ДатаКонца);

	ИначеЕсли ИсточникВыписки =
		Перечисления.ИсточникиБанковскихВыписок.АБанк Тогда

		Операции =
			ПолучитьОперацииАБанк(
				БанковскийСчет,
				ДатаНачала,
				ДатаКонца);

	КонецЕсли;
	
	ОтладкаВыписокСообщить(
		"Счёт """ + Строка(БанковскийСчет)
		+ """, источник: " + Строка(ИсточникВыписки)
		+ ", направление: " + ?(ЗначениеЗаполнено(Направление), Строка(Направление), "Все")
		+ ", операций получено из банка: " + Строка(Операции.Количество()));
	
	Для Каждого БанковскаяОперация Из Операции Цикл

		Если Не ОперацияПодходитПоНаправлению(
			БанковскаяОперация,
			Направление) Тогда

			Продолжить;

		КонецЕсли;

		ДобавитьБанковскуюОперациюВТаблицу(
			БанковскаяОперация,
			ДокументыКИмпорту);

	КонецЦикла;

КонецПроцедуры


// Направление = Неопределено/пустая ссылка/"Все" — операция подходит всегда
// (так уже настроенные счета продолжают загружать и то, и то без изменений).
Функция ОперацияПодходитПоНаправлению(БанковскаяОперация, Направление)

	Если Не ЗначениеЗаполнено(Направление)
		Или Направление = Перечисления.НаправлениеБанковскихОпераций.Все Тогда

		Возврат Истина;

	КонецЕсли;

	ЭтоВходящийПлатеж = Ложь;
	БанковскаяОперация.Свойство("Входящий", ЭтоВходящийПлатеж);

	Если Направление =
		Перечисления.НаправлениеБанковскихОпераций.Входящие Тогда

		Возврат ЭтоВходящийПлатеж;

	КонецЕсли;

	Если Направление =
		Перечисления.НаправлениеБанковскихОпераций.Исходящие Тогда

		Возврат Не ЭтоВходящийПлатеж;

	КонецЕсли;

	Возврат Истина;

КонецФункции


Функция ПолучитьТаблицуДокументовКИмпорту()
	
	ДокументыКИмпорту =
		ХранилищеОбщихНастроек.Загрузить(
			"ОбменПриват24",
			"ДокументыКИмпорту",
			,
			"Пользователь");
	
	Если ТипЗнч(ДокументыКИмпорту) <> Тип("ТаблицаЗначений") Тогда

		Сообщить(
			"Не удалось загрузить таблицу ДокументыКИмпорту "
			+ "из хранилища общих настроек.");

		Возврат Неопределено;

	КонецЕсли;

	// Тип колонки НомерДок зафиксирован в хранилище ещё с момента первого
	// сохранения этой таблицы (Строка(15) — под формат Приват24 "D"+REF) и
	// не меняется от правки типа реквизита формы в Конфигураторе: хранилище
	// просто десериализует блоб со старым типом колонки при каждой загрузке.
	// У WayForPay orderReference бывает длиннее 15 символов — снимаем
	// ограничение типа колонки программно, иначе значение обрежется прямо
	// при присвоении НоваяСтрока.НомерДок = ...
	// У ТаблицаЗначений.Колонки нет метода "Изменить" — тип существующей
	// колонки можно поменять только удалив её и добавив заново (с переносом
	// уже накопленных значений строк, чтобы их не потерять).
	ДлинаДо = 0;
	Попытка
		КвалификаторыСтарые =
			ДокументыКИмпорту.Колонки.НомерДок.ТипЗначения.КвалификаторыСтроки();
		Если КвалификаторыСтарые <> Неопределено Тогда
			ДлинаДо = КвалификаторыСтарые.Длина;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка

		СтарыеЗначения = Новый Массив;
		Для Каждого СтрокаТаблицы Из ДокументыКИмпорту Цикл
			СтарыеЗначения.Добавить(СтрокаТаблицы.НомерДок);
		КонецЦикла;

		ДокументыКИмпорту.Колонки.Удалить("НомерДок");

		ДокументыКИмпорту.Колонки.Добавить(
			"НомерДок",
			Новый ОписаниеТипов("Строка"));

		Индекс = 0;
		Для Каждого СтрокаТаблицы Из ДокументыКИмпорту Цикл
			СтрокаТаблицы.НомерДок = СтарыеЗначения[Индекс];
			Индекс = Индекс + 1;
		КонецЦикла;

		ОтладкаВыписокСообщить(
			"НомерДок: тип колонки пересоздан без ограничения длины "
			+ "(было ограничение: "
			+ ?(ДлинаДо = 0, "нет/неограничено", Строка(ДлинаДо))
			+ ").");

	Исключение

		ОтладкаВыписокСообщить(
			"НомерДок: не удалось пересоздать колонку без ограничения — "
			+ ОписаниеОшибки());

	КонецПопытки;

	Возврат ДокументыКИмпорту;

КонецФункции


Процедура СохранитьТаблицуДокументовКИмпорту(
	ДокументыКИмпорту)
	
	ХранилищеОбщихНастроек.Сохранить(
		"ОбменПриват24",
		"ДокументыКИмпорту",
		ДокументыКИмпорту,
		,
		"Пользователь");
	
	ХранилищеОбщихНастроек.Сохранить(
		"ОбменПриват24",
		"ДатаПоследнейЗагрузки",
		ТекущаяДата(),
		,
		"Пользователь");
	
	КонецПроцедуры
	
	
	Процедура ОбновитьДатуСледующейЗагрузки(
	ДокументыКИмпорту,
	ДатаКонца)
	
	ДатаСледующейЗагрузки =
		НачалоДня(ДатаКонца);
	
	Для Каждого СтрокаДокумента Из ДокументыКИмпорту Цикл
		
		Если Не ЗначениеЗаполнено(
			СтрокаДокумента.ДатаПроведения) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(
			СтрокаДокумента.ПлатежноеПоручениеВходящее) Тогда
			
			ДатаОперации =
				НачалоДня(
					СтрокаДокумента.ДатаПроведения);
			
			Если ДатаОперации <
				ДатаСледующейЗагрузки Тогда
				
				ДатаСледующейЗагрузки =
					ДатаОперации;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Небольшой нахлест, чтобы не потерять операции
	// на границе периодов.
	ДатаСледующейЗагрузки =
		ДатаСледующейЗагрузки - 2 * 24 * 60 * 60;
	
	Константы.Приват24НачалПериод.Установить(
		ДатаСледующейЗагрузки);
	
	КонецПроцедуры   
	
	
	Функция СоздатьБанковскуюОперацию() Экспорт
	
	Операция = Новый Структура;
	
	Операция.Вставить("Источник", Неопределено);
	Операция.Вставить("Идентификатор", "");
	Операция.Вставить("КлючДубляСтраниц", "");
	Операция.Вставить("БанковскийСчет", Неопределено);
	
	Операция.Вставить("Дата", Неопределено);
	
	Операция.Вставить("Сумма", 0);
	Операция.Вставить("Валюта", Неопределено);
	
	Операция.Вставить("Входящий", Ложь);
	
	Операция.Вставить("Остаток", 0);
	Операция.Вставить("Терминал", "");
	Операция.Вставить("Назначение", "");

	// Для операций по карте (rest_fiz) - ссылка на КарточныеСчета;
	// от нее зависит счет организации и расчет суммы без комиссии в ЗагрузитьВПП.
	Операция.Вставить("ПлатежнаяКарта", Неопределено);

	Возврат Операция;

КонецФункции


Процедура ДобавитьБанковскуюОперациюВТаблицу(
	БанковскаяОперация,
	ДокументыКИмпорту) Экспорт
	
	Если БанковскаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДокументыКИмпорту)
		<> Тип("ТаблицаЗначений") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ИдентификаторОперации = "";
	ДатаОперации          = Неопределено;
	СуммаОперации         = 0;
	ВалютаОперации        = Неопределено;
	ЭтоВходящийПлатеж     = Ложь;
	БанковскийСчет        = Неопределено;
	Остаток               = 0;
	Терминал              = "";
	Назначение            = "";
	Источник              = Неопределено;

	БанковскаяОперация.Свойство(
		"Источник",
		Источник);

	БанковскаяОперация.Свойство(
		"Идентификатор",
		ИдентификаторОперации);
	
	БанковскаяОперация.Свойство(
		"Дата",
		ДатаОперации);
	
	БанковскаяОперация.Свойство(
		"Сумма",
		СуммаОперации);
	
	БанковскаяОперация.Свойство(
		"Валюта",
		ВалютаОперации);
	
	БанковскаяОперация.Свойство(
		"Входящий",
		ЭтоВходящийПлатеж);
	
	БанковскаяОперация.Свойство(
		"БанковскийСчет",
		БанковскийСчет);
	
	БанковскаяОперация.Свойство(
		"Остаток",
		Остаток);
	
	БанковскаяОперация.Свойство(
		"Терминал",
		Терминал);
	
	БанковскаяОперация.Свойство(
		"Назначение",
		Назначение);

	ПлатежнаяКарта = Неопределено;
	БанковскаяОперация.Свойство(
		"ПлатежнаяКарта",
		ПлатежнаяКарта);

	ИдентификаторОперации =
		СокрЛП(Строка(ИдентификаторОперации));
	
	Если ПустаяСтрока(ИдентификаторОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат;
	КонецЕсли;
	
	Если СуммаОперации < 0 Тогда

	СуммаОперации = -СуммаОперации;

КонецЕсли;
	
	НоваяСтрока = ДокументыКИмпорту.Добавить();

	// Пока оставляем старое имя колонки таблицы.
	// Колонка теперь без ограничения длины (см. ПолучитьТаблицуДокументовКИмпорту),
	// но для Приват24/Monobank НАРОЧНО усекаем до 15 симв., как раньше это
	// молча делал сам тип колонки: их существующие документы созданы именно
	// с усечённым ключом (Приват24 "D"+REF ровно 15, Monobank id длиннее и
	// усекался) — если начать хранить их полностью, дедуп с уже принятыми
	// платежами сломается. WayForPay так не создаёт документы (см. ниже
	// подбор ключа поиска), поэтому для него храним значение целиком.
	Если Источник = "WayForPay" Тогда
		НоваяСтрока.НомерДок = ИдентификаторОперации;
	Иначе
		НоваяСтрока.НомерДок = Лев(ИдентификаторОперации, 15);
	КонецЕсли;

	ОтладкаВыписокСообщить(
		"НомерДок записан: """ + НоваяСтрока.НомерДок + """"
		+ " (длина " + Строка(СтрДлина(НоваяСтрока.НомерДок)) + ")"
		+ ?(НоваяСтрока.НомерДок <> ИдентификаторОперации,
			" — ОБРЕЗАН из """ + ИдентификаторОперации
				+ """ (длина " + Строка(СтрДлина(ИдентификаторОперации)) + ")",
			""));

	НоваяСтрока.СчетОрганизации =
		БанковскийСчет;
	
	НоваяСтрока.ДатаПроведения =
		ДатаОперации;
	
	НоваяСтрока.СуммаДокумента =
		СуммаОперации;
	
	НоваяСтрока.Валюта =
		ВалютаОперации;
	
	Если ЭтоВходящийПлатеж Тогда
		
		НоваяСтрока.СуммаПоступило =
			СуммаОперации;
		
		НоваяСтрока.СуммаСписано = 0;
		
	Иначе
		
		НоваяСтрока.СуммаПоступило = 0;
		
		НоваяСтрока.СуммаСписано =
			СуммаОперации;
		
	КонецЕсли;
	
	НоваяСтрока.Остаток =
		Остаток;
	
	НоваяСтрока.Терминал =
		СокрЛП(Терминал);
	
	НоваяСтрока.Содержание =
		СокрЛП(Назначение);

	Если ЗначениеЗаполнено(ПлатежнаяКарта) Тогда
		Попытка
			НоваяСтрока.ПлатежнаяКарта = ПлатежнаяКарта;
		Исключение
		КонецПопытки;
	КонецЕсли;

	// Новую операцию автоматически не загружаем.
	НоваяСтрока.Загружать = Ложь;

	// Ключ поиска документа = значение, ФАКТИЧЕСКИ сохранённое в колонке НомерДок
	// (колонка формы короче полного идентификатора — например Строка(15) — и
	// платформа молча усекает значение; документы Приват24 создаются с
	// усечённым НомерВходящегоДокумента, поэтому для них ищем по усечённому
	// значению — иначе поиск по полному ключу такие документы не находит.
	// WayForPay — ИСКЛЮЧЕНИЕ: документ создаётся не отсюда, а напрямую при
	// чекауте (WayForPay.СоздатьДокументПрограмно) с ПОЛНЫМ orderReference,
	// колонку вообще не затрагивает — поэтому для WayForPay ключ поиска
	// должен быть полным, неусечённым (иначе дедуп с чекаутом не сработает
	// для orderReference длиннее ширины колонки).
	Если Источник = "WayForPay" Тогда
		КлючПоискаДокумента = ИдентификаторОперации;
	Иначе
		КлючПоискаДокумента = СокрЛП(Строка(НоваяСтрока.НомерДок));
	КонецЕсли;

	БанковскаяОперация.Вставить(
		"Идентификатор",
		КлючПоискаДокумента);

	НайденныйДокумент =
		БИАС.НайтиДокументПоБанковскойОперации(
			БанковскаяОперация);

	// ВРЕМЕННАЯ ДИАГНОСТИКА (видна при нажатии кнопки «Получить из Приват24»;
	// регламент — в фоне, сообщений не покажет). Убрать после разбора.
	ОтладкаВыписокСообщить(
		"Операция [" + ИдентификаторОперации + "]"
		+ " | " + ?(ЭтоВходящийПлатеж, "поступление", "списание")
		+ " | " + Формат(ДатаОперации, "ДФ=dd.MM.yyyy HH:mm:ss")
		+ " | сумма " + Строка(СуммаОперации)
		+ " | документ: "
		+ ?(ЗначениеЗаполнено(НайденныйДокумент),
			Строка(НайденныйДокумент), "НЕ НАЙДЕН"));

	Если ЗначениеЗаполнено(НайденныйДокумент) Тогда

		ЗаполнитьСтрокуНайденнымДокументом(
			НоваяСтрока,
			НайденныйДокумент);

		ОтладкаВыписокСообщить(
			"    маркер в строке: "
			+ ?(ЗначениеЗаполнено(НоваяСтрока.ПлатежноеПоручениеВходящее),
				"ЗАПИСАН (" + Строка(НоваяСтрока.ПлатежноеПоручениеВходящее) + ")",
				"ПУСТО — не записался"));

	ИначеЕсли ЭтоВходящийПлатеж И Источник = "WayForPay" Тогда

		// Новый платёж WayForPay без документа: заказ ищем точным совпадением
		// по WayForPayOrderReference, а не разбором текста назначения.
		ЗаполнитьЗаказПоWayForPayOrderReference(НоваяСтрока, ИдентификаторОперации);

	ИначеЕсли ЭтоВходящийПлатеж Тогда

		// Новый платёж-поступление без документа: подставляем контрагента
		// и его первый активный заказ по коду/ФИО из назначения,
		// чтобы платежи в списке были уже сопоставлены.
		ЗаполнитьКонтрагентаИЗаказаПоНазначению(НоваяСтрока, Назначение);

		ОтладкаВыписокСообщить(
			"    авто-подстановка: контрагент "
			+ ?(ЗначениеЗаполнено(НоваяСтрока.Контрагент), Строка(НоваяСтрока.Контрагент), "—")
			+ ", заказ "
			+ ?(ЗначениеЗаполнено(НоваяСтрока.Заказ), Строка(НоваяСтрока.Заказ), "—")
			+ ", к загрузке: "
			+ ?(НоваяСтрока.Загружать, "ДА", "нет"));

	КонецЕсли;

КонецПроцедуры


Процедура ЗаполнитьСтрокуНайденнымДокументом(
	СтрокаИмпорта,
	ДокументОплаты) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументОплаты) Тогда
		Возврат;
	КонецЕсли;

	// Маркер «строка уже принята» — по нему фильтр «Новые» на форме
	// убирает уже загруженные платежи (и входящие, и исходящие ПП, и ПКО).
	// Обёрнуто в Попытка: если тип колонки-маркера окажется у́же, чем
	// нужно, одна непомеченная строка не должна срывать всю загрузку выписки.
	Попытка
		СтрокаИмпорта.ПлатежноеПоручениеВходящее =
			ДокументОплаты;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаИмпорта.Заказ =
			ДокументОплаты.ДокументОснование;
	Исключение
	КонецПопытки;
	
	Попытка
		СтрокаИмпорта.СуммаЗаказа =
			ДокументОплаты.СуммаДокумента;
	Исключение
	КонецПопытки;
	
	Попытка
		СтрокаИмпорта.Контрагент =
			ДокументОплаты.Контрагент;
	Исключение
	КонецПопытки;
	
	Попытка
		СтрокаИмпорта.Договор =
			ДокументОплаты.ДоговорКонтрагента;
	Исключение
	КонецПопытки;
	
	СтрокаИмпорта.Загружать = Ложь;
	
	СтрокаИмпорта.ИдентификацияЗаказа =
		Перечисления.ИдентификацияЗаказа
			.РучнойВыборЗаказаПоОплате;
	
		КонецПроцедуры
		
		
		
	
// Авто-подстановка контрагента и заказа для нового платежа-поступления
// по тексту назначения ("Від: <ФИО>. ... <код контрагента>").
Процедура ЗаполнитьКонтрагентаИЗаказаПоНазначению(СтрокаИмпорта, Назначение)

	Если ПустаяСтрока(СокрЛП(Строка(Назначение))) Тогда
		Возврат;
	КонецЕсли;

	НайденоПоКоду = Ложь;
	Контрагент = НайтиКонтрагентаПоНазначению(Назначение, НайденоПоКоду);

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СтрокаИмпорта.Контрагент = Контрагент;
	Исключение
	КонецПопытки;

	// Контрагент опознан по коду из назначения — платёж сразу отмечаем к загрузке.
	Если НайденоПоКоду Тогда
		Попытка
			СтрокаИмпорта.Загружать = Истина;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Заказ = НайтиПервыйАктивныйЗаказКонтрагента(Контрагент);

	Если ЗначениеЗаполнено(Заказ) Тогда

		Попытка
			СтрокаИмпорта.Заказ = Заказ;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаИмпорта.Договор = Заказ.ДоговорКонтрагента;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаИмпорта.СуммаЗаказа = Заказ.СуммаДокумента;
		Исключение
		КонецПопытки;

		Попытка
			СтрокаИмпорта.ИдентификацияЗаказа =
				Перечисления.ИдентификацияЗаказа.РучнойВыборЗаказаПоОплате;
		Исключение
		КонецПопытки;

	КонецЕсли;

КонецПроцедуры


// Заказ для платежа WayForPay ищем точным совпадением по
// ЗаказПокупателя.WayForPayOrderReference — надёжнее, чем разбор текста
// назначения (как для Приват24), т.к. это прямая ссылка на заказ.
// Если реквизит у заказа пуст (заказ приехал с сайта без payment_ref или
// создан до появления реквизита), ищем по номеру заказа на сайте: сам
// orderReference имеет вид "<номер заказа на сайте>_<timestamp>[_adv]"
// (сайт, shop/wayforpay.php: wfpNewOrderReference / wfpNewAdvanceReference),
// поэтому часть до первого "_" сверяем с ЗаказПокупателя.НомерЗаказа2ССайта.
// Сумму при этом НЕ сверяем: суффикс _adv — это предоплата 150 грн при
// наложенном платеже, она заведомо меньше суммы заказа, а номер заказа
// в orderReference однозначен.
Процедура ЗаполнитьЗаказПоWayForPayOrderReference(СтрокаИмпорта, OrderReference)

	OrderReference = СокрЛП(Строка(OrderReference));

	Если ПустаяСтрока(OrderReference) Тогда
		Возврат;
	КонецЕсли;

	КакНайден = "";
	Заказ = НайтиЗаказПоWayForPayOrderReference(OrderReference, КакНайден);

	Если Не ЗначениеЗаполнено(Заказ) Тогда

		ОтладкаВыписокСообщить(
			"    WayForPay [" + OrderReference + "]: заказ не найден"
			+ " ни по WayForPayOrderReference, ни по номеру заказа с сайта");

		Возврат;

	КонецЕсли;

	Попытка
		СтрокаИмпорта.Заказ = Заказ;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаИмпорта.Контрагент = Заказ.Контрагент;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаИмпорта.Договор = Заказ.ДоговорКонтрагента;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаИмпорта.СуммаЗаказа = Заказ.СуммаДокумента;
	Исключение
	КонецПопытки;

	Попытка
		СтрокаИмпорта.ИдентификацияЗаказа =
			Перечисления.ИдентификацияЗаказа.РучнойВыборЗаказаПоОплате;
	Исключение
	КонецПопытки;

	// Заказ опознан по идентификатору самого платежа — сопоставление
	// однозначное, поэтому платёж сразу отмечаем к загрузке (как это делается
	// для платежей с опознанным по коду контрагентом).
	Попытка
		СтрокаИмпорта.Загружать = Истина;
	Исключение
	КонецПопытки;

	ОтладкаВыписокСообщить(
		"    WayForPay [" + OrderReference + "]: заказ " + Строка(Заказ)
		+ " (" + КакНайден + "), отмечен к загрузке");

КонецПроцедуры


// Заказ по идентификатору платежа WayForPay: сначала по прямой ссылке
// (WayForPayOrderReference), затем по номеру заказа с сайта из самого
// orderReference. КакНайден возвращает пояснение для отладочного лога.
Функция НайтиЗаказПоWayForPayOrderReference(OrderReference, КакНайден = "")

	КакНайден = "";

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.WayForPayOrderReference = &OrderReference
	|	И НЕ ЗаказПокупателя.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата УБЫВ";

	Запрос.УстановитьПараметр("OrderReference", OrderReference);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда

		КакНайден = "по WayForPayOrderReference";

		Возврат Выборка.Ссылка;

	КонецЕсли;

	НомерЗаказаНаСайте =
		НомерЗаказаНаСайтеИзOrderReference(OrderReference);

	Если ПустаяСтрока(НомерЗаказаНаСайте) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// orderReference несёт номер так, как его знал сайт на момент оплаты, то
	// есть без ведущих нулей. В базе с 16.08.2026 номер хранится с нулями
	// («032760»), а заказы до перехода лежат без них - сверяем все написания,
	// иначе платёж не найдёт свой заказ ни в одном из двух форматов.
	Варианты =
		ОбщегоНазначения.ВариантыПоискаНомераЗаказаССайта(НомерЗаказаНаСайте);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.НомерЗаказа2ССайта В (&ВариантыНомера)
	|	И НЕ ЗаказПокупателя.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата УБЫВ";

	Запрос.УстановитьПараметр(
		"ВариантыНомера",
		Варианты);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда

		КакНайден = "по номеру заказа с сайта " + НомерЗаказаНаСайте;

		Возврат Выборка.Ссылка;

	КонецЕсли;

	Возврат Неопределено;

КонецФункции


// "32575_1785914775_adv" -> "32575". Пустая строка, если формат не тот
// (нет "_" или до него не только цифры) — тогда по номеру не ищем вовсе.
Функция НомерЗаказаНаСайтеИзOrderReference(OrderReference)

	ПозицияРазделителя = Найти(OrderReference, "_");

	Если ПозицияРазделителя < 2 Тогда
		Возврат "";
	КонецЕсли;

	Номер = СокрЛП(Лев(OrderReference, ПозицияРазделителя - 1));

	Если ПустаяСтрока(Номер) Тогда
		Возврат "";
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Номер) Цикл

		Если Найти("0123456789", Сред(Номер, Позиция, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;

	КонецЦикла;

	Возврат Номер;

КонецФункции


// Контрагент по назначению: сначала по коду (9 цифр), затем по ФИО из "Від:".
// НайденоПоКоду возвращает Истина, если совпал именно код (надёжный признак).
Функция НайтиКонтрагентаПоНазначению(Назначение, НайденоПоКоду = Ложь)

	НайденоПоКоду = Ложь;

	Код = ИзвлечьКодКонтрагентаИзНазначения(Назначение);

	Если Не ПустаяСтрока(Код) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Код = &Код
		|	И НЕ Контрагенты.ПометкаУдаления";

		Запрос.УстановитьПараметр("Код", Код);

		Выборка = Запрос.Выполнить().Выбрать();

		Если Выборка.Следующий() Тогда
			НайденоПоКоду = Истина;
			Возврат Выборка.Ссылка;
		КонецЕсли;

	КонецЕсли;

	ФИО = ИзвлечьФИООтправителяИзНазначения(Назначение);

	Если Не ПустаяСтрока(ФИО) Тогда

		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(ФИО, Истина);

		Если ЗначениеЗаполнено(Контрагент) Тогда
			Возврат Контрагент;
		КонецЕсли;

	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции


// Код контрагента — ровно 9 цифр (Контрагенты, фикс. длина 9).
Функция ИзвлечьКодКонтрагентаИзНазначения(Назначение)

	Текст = Строка(Назначение);
	Цифры = "";

	Для Позиция = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Позиция, 1);

		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		Иначе
			Если СтрДлина(Цифры) = 9 Тогда
				Возврат Цифры;
			КонецЕсли;
			Цифры = "";
		КонецЕсли;

	КонецЦикла;

	Если СтрДлина(Цифры) = 9 Тогда
		Возврат Цифры;
	КонецЕсли;

	Возврат "";

КонецФункции


// ФИО отправителя после "Від:" / "От:" / "Отправитель:" — до первой точки.
Функция ИзвлечьФИООтправителяИзНазначения(Назначение)

	Текст = Строка(Назначение);

	Метки = Новый Массив;
	Метки.Добавить("Від:");
	Метки.Добавить("От:");
	Метки.Добавить("Отправитель:");

	Для Каждого Метка Из Метки Цикл

		Поз = Найти(Текст, Метка);

		Если Поз > 0 Тогда

			Хвост = Сред(Текст, Поз + СтрДлина(Метка));

			ПозТочки = Найти(Хвост, ".");
			Если ПозТочки > 0 Тогда
				Хвост = Лев(Хвост, ПозТочки - 1);
			КонецЕсли;

			Возврат СокрЛП(Хвост);

		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции


// Первый по дате активный заказ контрагента.
Функция НайтиПервыйАктивныйЗаказКонтрагента(Контрагент)

	Статусы = Новый Массив;
	ДобавитьСтатусЗаказаПоНаименованию(Статусы, "Ожидает оплаты");
	ДобавитьСтатусЗаказаПоНаименованию(Статусы, "Продано");
	ДобавитьСтатусЗаказаПоНаименованию(Статусы, "Резерв");
	ДобавитьСтатусЗаказаПоНаименованию(Статусы, "Ожидает отправки");

	Если Статусы.Количество() = 0 Тогда
		Возврат Документы.ЗаказПокупателя.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.Контрагент = &Контрагент
	|	И ЗаказПокупателя.СтатусЗаказа В (&Статусы)
	|	И НЕ ЗаказПокупателя.ПометкаУдаления
	|	И ЗаказПокупателя.Проведен
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказПокупателя.Дата";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Статусы", Статусы);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Документы.ЗаказПокупателя.ПустаяСсылка();

КонецФункции


Процедура ДобавитьСтатусЗаказаПоНаименованию(Статусы, Наименование)

	Ссылка = Справочники.СтатусыЗаказов.НайтиПоНаименованию(Наименование);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Статусы.Добавить(Ссылка);
	КонецЕсли;

КонецПроцедуры


  Функция ПолучитьОперацииMonobankЗаПериод(
	БанковскийСчет,
	ДатаНачала,
	ДатаКонца) Экспорт
	
	Операции = Новый Массив;
	
	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат Операции;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда
		
		Возврат Операции;
		
	КонецЕсли;
	
	Токен = "";
	ИдентификаторСчета = "";
	
	Попытка
		Токен = СокрЛП(БанковскийСчет.Токен);
	Исключение
	КонецПопытки;
	
	Попытка
		ИдентификаторСчета =
			СокрЛП(БанковскийСчет.Айди);
	Исключение
	КонецПопытки;
	
	Если ПустаяСтрока(Токен) Тогда
		
		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			БанковскийСчет,
			"Не заполнен токен Monobank.");
		
		Возврат Операции;
		
	КонецЕсли;
	
	Если ПустаяСтрока(ИдентификаторСчета) Тогда
		
		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			БанковскийСчет,
			"Не заполнен идентификатор счета Monobank.");
		
		Возврат Операции;
		
	КонецЕсли;
	
	UnixДатаНачала =
		ДатаВUnixTimeMonobank(
			НачалоДня(ДатаНачала));
	
	UnixДатаКонца =
		ДатаВUnixTimeMonobank(
			КонецДня(ДатаКонца));
	
	ПутьЗапроса =
		"/personal/statement/"
		+ ИдентификаторСчета
		+ "/"
		+ Формат(UnixДатаНачала, "ЧГ=0")
		+ "/"
		+ Формат(UnixДатаКонца, "ЧГ=0");
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Token", Токен);
	Заголовки.Вставить("Accept", "application/json");
	Заголовки.Вставить(
		"User-Agent",
		"Cvetkov-1C-BankStatements");
	
	Соединение = Новый HTTPСоединение(
		"api.monobank.ua",
		443,
		,
		,
		,
		,
		Новый ЗащищенноеСоединениеOpenSSL);
	
	HTTPЗапрос = Новый HTTPЗапрос(
		ПутьЗапроса,
		Заголовки);
	
	Попытка
		
		HTTPОтвет =
			Соединение.Получить(HTTPЗапрос);
		
	Исключение
		
		ТекстОшибки =
			"Ошибка подключения к Monobank: "
			+ ОписаниеОшибки();
		
		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Ошибка,
			,
			БанковскийСчет,
			ТекстОшибки);
		
		Возврат Операции;
		
	КонецПопытки;
	
	КодСостояния = HTTPОтвет.КодСостояния;
	
	Попытка
		
		ТекстОтвета =
			HTTPОтвет.ПолучитьТелоКакСтроку(
				КодировкаТекста.UTF8);
		
	Исключение
		
		ТекстОтвета =
			HTTPОтвет.ПолучитьТелоКакСтроку();
		
	КонецПопытки;
	
	ОтладкаВыписокСообщить(
		"Monobank: код ответа " + Строка(КодСостояния)
		+ ", тело: " + Лев(СокрЛП(ТекстОтвета), 1500));
	
	Если КодСостояния <> 200 Тогда
		
		ТекстОшибки =
			ПолучитьТекстОшибкиMonobank(
				КодСостояния,
				ТекстОтвета);
		
		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Ошибка,
			,
			БанковскийСчет,
			ТекстОшибки);
		
		Возврат Операции;
		
	КонецЕсли;
	
	Если ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		Возврат Операции;
	КонецЕсли;
	
	Попытка
		
		ДанныеОтвета =
			ПрочитатьОтветJSONMonobank(
				ТекстОтвета);
		
	Исключение
		
		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Monobank",
			УровеньЖурналаРегистрации.Ошибка,
			,
			БанковскийСчет,
			"Не удалось разобрать JSON Monobank: "
			+ ОписаниеОшибки());
		
		Возврат Операции;
		
	КонецПопытки;
	
	Если ДанныеОтвета = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;
	
	Для Каждого ДанныеОперации Из ДанныеОтвета Цикл
		
		ИдентификаторОперации =
			ПолучитьЗначениеJSONMonobank(
				ДанныеОперации,
				"id",
				"");
		
		ИдентификаторОперации =
			СокрЛП(
				Строка(ИдентификаторОперации));
		
		Если ПустаяСтрока(
			ИдентификаторОперации) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ДатаUnix =
			ПолучитьЗначениеJSONMonobank(
				ДанныеОперации,
				"time",
				0);
		
		Если ДатаUnix = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаВКопейках =
		ПолучитьЗначениеJSONMonobank(
		ДанныеОперации,
		"amount",
		0);
		
		СуммаОперации = СуммаВКопейках;
		
		Если СуммаОперации < 0 Тогда
			
			СуммаОперации = -СуммаОперации;
			
		КонецЕсли;
		
		СуммаОперации =
		
		Окр(
		СуммаОперации / 100,
		2);		
		Если СуммаОперации = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОстатокВКопейках =
			ПолучитьЗначениеJSONMonobank(
				ДанныеОперации,
				"balance",
				0);
		
		Остаток =
			Окр(
				ОстатокВКопейках / 100,
				2);
		
		КодВалюты =
			ПолучитьЗначениеJSONMonobank(
				ДанныеОперации,
				"currencyCode",
				980);
		
		ОписаниеОперации =
			ПолучитьЗначениеJSONMonobank(
				ДанныеОперации,
				"description",
				"");
		
		КомментарийОперации =
			ПолучитьЗначениеJSONMonobank(
				ДанныеОперации,
				"comment",
				"");
		
		MCC =
			ПолучитьЗначениеJSONMonobank(
				ДанныеОперации,
				"mcc",
				0);
		
		Назначение =
			СокрЛП(
				Строка(ОписаниеОперации));
		
		Если Не ПустаяСтрока(
			СокрЛП(Строка(КомментарийОперации))) Тогда
			
			Если Не ПустаяСтрока(Назначение) Тогда
				Назначение =
					Назначение + ". ";
			КонецЕсли;
			
			Назначение =
				Назначение
				+ СокрЛП(
					Строка(КомментарийОперации));
			
		КонецЕсли;
		
		БанковскаяОперация =
			СоздатьБанковскуюОперацию();
		
		БанковскаяОперация.Источник =
			"Monobank";
		
		БанковскаяОперация.Идентификатор =
			ИдентификаторОперации;
		
		БанковскаяОперация.БанковскийСчет =
			БанковскийСчет;
		
		БанковскаяОперация.Дата =
			UnixTimeВДатуMonobank(
				ДатаUnix);
		
		БанковскаяОперация.Сумма =
			СуммаОперации;
		
		БанковскаяОперация.Валюта =
			ПолучитьВалютуПоКодуMonobank(
				КодВалюты);
		
		БанковскаяОперация.Входящий =
			СуммаВКопейках > 0;
		
		БанковскаяОперация.Остаток =
			Остаток;
		
		БанковскаяОперация.Терминал =
			?(MCC = 0,
				"",
				"MCC " + Строка(MCC));
		
		БанковскаяОперация.Назначение =
			Назначение;
		
		Операции.Добавить(
			БанковскаяОперация);
		
	КонецЦикла;
	
	Возврат Операции;
	
КонецФункции


Функция ДатаВUnixTimeMonobank(
	ДатаЗначение) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаЗначение) Тогда
		Возврат 0;
	КонецЕсли;
	
	НачалоUnix =
		Дата(1970, 1, 1, 0, 0, 0);
	
	// В базе используется украинское время.
	// Для API переводим локальное время в UTC.
	СмещениеЧасовогоПояса = 3 * 60 * 60;
	
	Возврат Цел(
		ДатаЗначение
		- НачалоUnix
		- СмещениеЧасовогоПояса);
	
	КонецФункции
	
	Функция UnixTimeВДатуMonobank(
	UnixTime) Экспорт
	
	Если UnixTime = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		UnixTime = Число(UnixTime);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если UnixTime <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НачалоUnix =
		Дата(1970, 1, 1, 0, 0, 0);
	
	СмещениеЧасовогоПояса = 3 * 60 * 60;
	
	Возврат
		НачалоUnix
		+ UnixTime
		+ СмещениеЧасовогоПояса;
	
	КонецФункции
	
	
	Функция ПолучитьЗначениеJSONMonobank(
	ОбъектJSON,
	ИмяСвойства,
	ЗначениеПоУмолчанию) Экспорт
	
	Если ОбъектJSON = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ЗначениеСвойства =
		ЗначениеПоУмолчанию;
	
	Если ТипЗнч(ОбъектJSON) = Тип("Структура") Тогда
		
		Если ОбъектJSON.Свойство(
			ИмяСвойства,
			ЗначениеСвойства) Тогда
			
			Возврат ЗначениеСвойства;
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ОбъектJSON)
		= Тип("Соответствие") Тогда
		
		Если ОбъектJSON.СодержитКлюч(
			ИмяСвойства) Тогда
			
			Возврат
				ОбъектJSON.Получить(
					ИмяСвойства);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции


Функция ПолучитьТекстОшибкиMonobank(
	КодСостояния,
	ТекстОтвета) Экспорт
	
	Если КодСостояния = 401 Тогда
		
		Возврат
			"Monobank вернул ошибку 401. "
			+ "Токен отсутствует или недействителен.";
		
	ИначеЕсли КодСостояния = 403 Тогда
		
		Возврат
			"Monobank вернул ошибку 403. "
			+ "Доступ к API запрещен.";
		
	ИначеЕсли КодСостояния = 429 Тогда
		
		Возврат
			"Monobank вернул ошибку 429. "
			+ "Превышена частота запросов. "
			+ "Повторите загрузку позже.";
		
	КонецЕсли;
	
	ТекстОшибки =
		"Ошибка Monobank. Код HTTP: "
		+ Строка(КодСостояния);
	
	Если Не ПустаяСтрока(
		СокрЛП(ТекстОтвета)) Тогда
		
		ТекстОшибки =
			ТекстОшибки
			+ ". Ответ: "
			+ Лев(ТекстОтвета, 1000);
		
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция ПолучитьВалютуПоКодуMonobank(
	КодВалюты) Экспорт
	
	КодВалюты =
		СокрЛП(Строка(КодВалюты));
	
	СимвольныйКод = "";
	
	Если КодВалюты = "980" Тогда
		СимвольныйКод = "UAH";
	ИначеЕсли КодВалюты = "840" Тогда
		СимвольныйКод = "USD";
	ИначеЕсли КодВалюты = "978" Тогда
		СимвольныйКод = "EUR";
	ИначеЕсли КодВалюты = "985" Тогда
		СимвольныйКод = "PLN";
	КонецЕсли;
	
	Если Не ПустаяСтрока(
		СимвольныйКод) Тогда
		
		Валюта =
			Справочники.Валюты.НайтиПоКоду(
				СимвольныйКод);
		
		Если ЗначениеЗаполнено(Валюта) Тогда
			Возврат Валюта;
		КонецЕсли;
		
		Валюта =
			Справочники.Валюты.НайтиПоНаименованию(
				СимвольныйКод);
		
		Если ЗначениеЗаполнено(Валюта) Тогда
			Возврат Валюта;
		КонецЕсли;
		
	КонецЕсли;
	
	// Для гривневых счетов используем валюту управленческого учета.
	Если КодВалюты = "980" Тогда
		
		Возврат
			Константы.ВалютаУправленческогоУчета
				.Получить();
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции  

Функция ПрочитатьОтветJSONMonobank(ТекстОтвета) Экспорт
	
	Если ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ЧтениеJSON = Новый ЧтениеJSON;
	
	Попытка
		
		ЧтениеJSON.УстановитьСтроку(ТекстОтвета);
		
		Результат =
			ПрочитатьJSON(ЧтениеJSON);
		
		ЧтениеJSON.Закрыть();
		
	Исключение
		
		Попытка
			ЧтениеJSON.Закрыть();
		Исключение
		КонецПопытки;
		
		ВызватьИсключение
			"Ошибка разбора JSON Monobank: "
			+ ОписаниеОшибки();
		
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции  

Функция ПолучитьОперацииMonobank(
	БанковскийСчет,
	ДатаНачала,
	ДатаКонца) Экспорт
	
	Операции = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда
		
		Возврат Операции;
		
	КонецЕсли;
	
	ТекущаяДатаНачала = НачалоДня(ДатаНачала);
	
	Пока ТекущаяДатаНачала <= ДатаКонца Цикл
		
		ТекущаяДатаКонца =
			ТекущаяДатаНачала + 29 * 24 * 60 * 60;
		
		Если ТекущаяДатаКонца > ДатаКонца Тогда
			ТекущаяДатаКонца = ДатаКонца;
		Иначе
			ТекущаяДатаКонца =
				КонецДня(ТекущаяДатаКонца);
		КонецЕсли;
		
		ОперацииЗаПериод =
			ПолучитьОперацииMonobankЗаПериод(
				БанковскийСчет,
				ТекущаяДатаНачала,
				ТекущаяДатаКонца);
		
		Для Каждого Операция Из ОперацииЗаПериод Цикл
			Операции.Добавить(Операция);
		КонецЦикла;
		
		ТекущаяДатаНачала =
			НачалоДня(ТекущаяДатаКонца + 1);
		
	КонецЦикла;
	
	Возврат Операции;
	
КонецФункции

Функция ПолучитьОперацииПриват24Бизнес(
	БанковскийСчет,
	ДатаНачала,
	ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат Операции;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат Операции;

	КонецЕсли;

	Токен = "";
	ИдентификаторКлиента = "";

	Попытка
		Токен = СокрЛП(БанковскийСчет.Токен);
	Исключение
	КонецПопытки;

	Попытка
		ИдентификаторКлиента = СокрЛП(БанковскийСчет.Айди);
	Исключение
	КонецПопытки;

	Если ПустаяСтрока(Токен) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Приват24Бизнес",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			БанковскийСчет,
			"Не заполнен токен Приват24 Бизнес.");

		Возврат Операции;

	КонецЕсли;

	Если ПустаяСтрока(ИдентификаторКлиента) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.Приват24Бизнес",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			БанковскийСчет,
			"Не заполнен идентификатор (Айди) Приват24 Бизнес.");

		Возврат Операции;

	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	SSL = Новый ЗащищенноеСоединениеOpenSSL();

	UserAgentHeaders =
		"1C+EnterpriseV2|8.3|TcK|2434509383|3.0.3.4|UTP|1.2.11.1"
		+ "|8.3.10.2772|CS|OP|ru|Windows|Windows x86|";

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("User-Agent", UserAgentHeaders);
	Заголовки.Вставить("id", ИдентификаторКлиента);
	Заголовки.Вставить("token", Токен);
	Заголовки.Вставить("Content-Type", "application/json;charset=utf8");

	сДатаНачала = Формат(НачалоДня(ДатаНачала), "ДФ=dd-MM-yyyy");
	сДатаКонца  = Формат(НачалоДня(ДатаКонца),  "ДФ=dd-MM-yyyy");

	Соединение = Новый HTTPСоединение(
		"acp.privatbank.ua", , , , , , SSL);

	ОбработанныеИД = Новый Соответствие;
	СледующаяСтраница = "";
	ЕстьСледующаяСтраница = Истина;
	ОбработаноСтраниц = 0;
	МаксимумСтраниц = 1000; // страховка от зацикливания

	// Периодный эндпоинт отдаёт операции только за ЗАКРЫТЫЕ операционные дни.
	// Операции текущего дня доступны только через interim — запрашиваем его
	// второй фазой, если период захватывает сегодня. Дубли между фазами
	// отсекаются по ОбработанныеИД, дубли документов — по "D"+REF.
	ОчередьРесурсов = Новый Массив;
	ОчередьРесурсов.Добавить(
		"/api/statements/transactions?startDate=" + сДатаНачала
		+ "&endDate=" + сДатаКонца
		+ "&limit=200");

	Если КонецДня(ДатаКонца) >= НачалоДня(ТекущаяДата()) Тогда
		// у interim максимум limit=100 (по документации Автоклиента)
		ОчередьРесурсов.Добавить(
			"/api/statements/transactions/interim?limit=100");
	КонецЕсли;

	ИндексРесурса = 0;

	Пока ЕстьСледующаяСтраница И ОбработаноСтраниц < МаксимумСтраниц Цикл

		ОбработаноСтраниц = ОбработаноСтраниц + 1;

		РесурсНаСервере = ОчередьРесурсов[ИндексРесурса];

		Если Не ПустаяСтрока(СледующаяСтраница) Тогда
			РесурсНаСервере = РесурсНаСервере
				+ "&followId=" + СледующаяСтраница;
		КонецЕсли;

		Запрос = Новый HTTPЗапрос(РесурсНаСервере, Заголовки);

		Попытка
			Ответ = Соединение.Получить(Запрос);
		Исключение
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				БанковскийСчет,
				"Ошибка подключения к Приват24 Бизнес: "
				+ ОписаниеОшибки());
			Прервать;
		КонецПопытки;

		КодСостояния = Ответ.КодСостояния;
		СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();

		ОтладкаВыписокСообщить(
			"Приват24: запрос " + РесурсНаСервере
			+ ", код ответа " + Строка(КодСостояния));
		ОтладкаВыписокСообщить(
			"Приват24: тело ответа: " + Лев(СокрЛП(СтрокаОтвета), 1500));

		Если КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				БанковскийСчет,
				"Приват24 Бизнес вернул код HTTP " + Строка(КодСостояния)
				+ ". Ответ: " + Лев(СтрокаОтвета, 1000));
			Прервать;
		КонецЕсли;

		Если ПустаяСтрока(СокрЛП(СтрокаОтвета)) Тогда
			Прервать;
		КонецЕсли;

		Попытка
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
			Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
			ЧтениеJSON.Закрыть();
		Исключение
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				БанковскийСчет,
				"Не удалось разобрать JSON Приват24 Бизнес: "
				+ ОписаниеОшибки());
			Прервать;
		КонецПопытки;

		Статус = "";
		Попытка
			Данные.Свойство("status", Статус);
		Исключение
		КонецПопытки;

		Если ВРег(СокрЛП(Строка(Статус))) <> "SUCCESS" Тогда
			ЗаписьЖурналаРегистрации(
				"БанковскиеВыписки.Приват24Бизнес",
				УровеньЖурналаРегистрации.Ошибка,
				,
				БанковскийСчет,
				"Приват24 Бизнес вернул статус """ + Строка(Статус)
				+ """. Ответ: " + Лев(СтрокаОтвета, 1000));
			Прервать;
		КонецЕсли;

		Транзакции = Неопределено;
		Данные.Свойство("transactions", Транзакции);

		Если ТипЗнч(Транзакции) = Тип("Массив") Тогда

			Для Каждого Оплата Из Транзакции Цикл

				Операция = ПреобразоватьОперациюПриват24Бизнес(
					Оплата, БанковскийСчет);

				Если Операция = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				// защита от дублей между страницами — по полному ID (уникальному),
				// т.к. Идентификатор теперь строится из REF и может повторяться (REFN).
				КлючДубля = Операция.КлючДубляСтраниц;
				Если ПустаяСтрока(КлючДубля) Тогда
					КлючДубля = Операция.Идентификатор;
				КонецЕсли;

				Если ОбработанныеИД.Получить(КлючДубля) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;

				ОбработанныеИД.Вставить(КлючДубля, Истина);
				Операции.Добавить(Операция);

			КонецЦикла;

		КонецЕсли;

		// постраничная выборка, если API её поддерживает
		ЕстьСледующаяСтраница = Ложь;
		ПризнакСледующей = Ложь;

		Попытка
			Данные.Свойство("exist_next_page", ПризнакСледующей);
		Исключение
		КонецПопытки;

		Если ПризнакСледующей = Истина Тогда

			НовыйИдСтраницы = "";
			Попытка
				Данные.Свойство("next_page_id", НовыйИдСтраницы);
			Исключение
			КонецПопытки;

			НовыйИдСтраницы = СокрЛП(Строка(НовыйИдСтраницы));

			Если Не ПустаяСтрока(НовыйИдСтраницы)
				И НовыйИдСтраницы <> СледующаяСтраница Тогда

				СледующаяСтраница = НовыйИдСтраницы;
				ЕстьСледующаяСтраница = Истина;

			КонецЕсли;

		КонецЕсли;

		// страницы текущего эндпоинта кончились — переходим к следующему
		// (interim за текущий день)
		Если Не ЕстьСледующаяСтраница
			И ИндексРесурса < ОчередьРесурсов.Количество() - 1 Тогда

			ИндексРесурса = ИндексРесурса + 1;
			СледующаяСтраница = "";
			ЕстьСледующаяСтраница = Истина;

		КонецЕсли;

	КонецЦикла;

	ОтладкаВыписокСообщить(
		"Приват24: итого операций получено: " + Строка(Операции.Количество()));

	Возврат Операции;

КонецФункции


Функция ПреобразоватьОперациюПриват24Бизнес(
	Оплата,
	БанковскийСчет)

	Если ТипЗнч(Оплата) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Полный ID Приват24 (REF+REFN+дата+время+тип) — уникальный, нужен только
	// для защиты от дублей между страницами ответа.
	ПолныйИД = "";
	Оплата.Свойство("ID", ПолныйИД);
	ПолныйИД = СокрЛП(Строка(ПолныйИД));

	// REF — по нему исторически формируется НомерВходящегоДокумента ("D" + REF).
	// Идентификатор операции (ключ поиска и создания документов) строим из REF,
	// иначе он не совпадёт с уже созданными документами (у них короткий "D"+REF).
	Реф = "";
	Оплата.Свойство("REF", Реф);
	Реф = СокрЛП(Строка(Реф));

	// Подстраховка: если REF пуст — берём полный ID, чтобы не потерять операцию.
	Если ПустаяСтрока(Реф) Тогда
		Реф = ПолныйИД;
	КонецЕсли;

	Если ПустаяСтрока(Реф) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДатаСтрокой = "";
	Оплата.Свойство("DATE_TIME_DAT_OD_TIM_P", ДатаСтрокой);
	ДатаОперации = ДатаИзСтрокиПриват24(ДатаСтрокой);

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	СуммаСтрокой = "";
	Оплата.Свойство("SUM", СуммаСтрокой);
	СуммаОперации = ЧислоИзСтрокиПриват24(СуммаСтрокой);

	ТипТранзакции = "";
	Оплата.Свойство("TRANTYPE", ТипТранзакции);
	ТипТранзакции = ВРег(СокрЛП(Строка(ТипТранзакции)));
	ЭтоВходящий = (ТипТранзакции = "C");

	Терминал = "";
	Оплата.Свойство("AUT_CNTR_MFO_NAME", Терминал);

	Назначение = "";
	Оплата.Свойство("OSND", Назначение);

	Операция = СоздатьБанковскуюОперацию();

	Операция.Источник       = "Приват24Бизнес";
	Операция.Идентификатор    = "D" + Реф;
	Операция.КлючДубляСтраниц  = "D" + ?(ПустаяСтрока(ПолныйИД), Реф, ПолныйИД);
	Операция.БанковскийСчет = БанковскийСчет;
	Операция.Дата           = ДатаОперации;
	Операция.Сумма          = СуммаОперации;
	Операция.Валюта         = Справочники.Валюты.НайтиПоКоду("980");
	Операция.Входящий       = ЭтоВходящий;
	Операция.Остаток        = 0;
	Операция.Терминал       = СокрЛП(Строка(Терминал));
	Операция.Назначение     = СокрЛП(Строка(Назначение));

	Возврат Операция;

КонецФункции


Функция ПолучитьОперацииWayForPay(
	БанковскийСчет,
	ДатаНачала,
	ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат Операции;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат Операции;

	КонецЕсли;

	Транзакции =
		WayForPay.ПолучитьСписокТранзакций(
			ДатаНачала,
			ДатаКонца);

	ОтладкаВыписокСообщить(
		"WayForPay: транзакций получено: "
		+ Строка(Транзакции.Количество()));

	Для Каждого Транзакция Из Транзакции Цикл

		Операция =
			ПреобразоватьОперациюWayForPay(
				Транзакция,
				БанковскийСчет);

		Если Операция = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Операции.Добавить(Операция);

	КонецЦикла;

	Возврат Операции;

КонецФункции


// Только успешные (Approved) платежи попадают в очередь импорта — остальные
// статусы (Declined/InProcessing/Refunded и т.п.) сейчас не обрабатываются.
Функция ПреобразоватьОперациюWayForPay(
	Транзакция,
	БанковскийСчет)

	Если ТипЗнч(Транзакция) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	OrderReference = "";
	Транзакция.Свойство("orderReference", OrderReference);
	OrderReference = СокрЛП(Строка(OrderReference));

	Если ПустаяСтрока(OrderReference) Тогда
		Возврат Неопределено;
	КонецЕсли;

	TransactionStatus = "";
	Транзакция.Свойство("transactionStatus", TransactionStatus);

	Если TransactionStatus <> "Approved" Тогда
		Возврат Неопределено;
	КонецЕсли;

	CreatedDate = 0;
	Транзакция.Свойство("createdDate", CreatedDate);

	ДатаОперации = Дата(1970, 1, 1) + CreatedDate;

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сумма = 0;
	Транзакция.Свойство("amount", Сумма);

	Email = "";
	Транзакция.Свойство("email", Email);

	Phone = "";
	Транзакция.Свойство("phone", Phone);

	Назначение = "WayForPay, заказ " + OrderReference;

	Если Не ПустаяСтрока(Email) Тогда
		Назначение = Назначение + ", " + Email;
	КонецЕсли;

	Если Не ПустаяСтрока(Phone) Тогда
		Назначение = Назначение + ", " + Phone;
	КонецЕсли;

	Операция = СоздатьБанковскуюОперацию();

	// Идентификатор — РОВНО orderReference, без префиксов: именно это
	// значение WayForPay.СоздатьДокументПрограмно пишет в
	// НомерВходящегоДокумента при оплате через чекаут (см. проверку
	// БИАС.НайтиВходящийБанковскийПлатеж по точному совпадению).
	Операция.Источник          = "WayForPay";
	Операция.Идентификатор      = OrderReference;
	Операция.КлючДубляСтраниц   = OrderReference;
	Операция.БанковскийСчет     = БанковскийСчет;
	Операция.Дата               = ДатаОперации;
	Операция.Сумма              = Сумма;
	Операция.Валюта             = Справочники.Валюты.НайтиПоКоду("980");
	Операция.Входящий           = Истина;
	Операция.Остаток            = 0;
	Операция.Терминал           = "WayForPay";
	Операция.Назначение         = Назначение;

	Возврат Операция;

КонецФункции


Функция ДатаИзСтрокиПриват24(Знач Текст)

	Текст = СокрЛП(Строка(Текст));

	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастиДатаВремя = СтрРазделить(Текст, " ", Ложь);

	Если ЧастиДатаВремя.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	ЧастьДаты = ЧастиДатаВремя[0];
	ЧастьВремени = ?(ЧастиДатаВремя.Количество() > 1,
		ЧастиДатаВремя[1], "00:00:00");

	КомпонентыДаты = СтрРазделить(ЧастьДаты, ".", Ложь);

	Если КомпонентыДаты.Количество() < 3 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КомпонентыВремени = СтрРазделить(ЧастьВремени, ":", Ложь);

	Попытка
		Год     = Число(КомпонентыДаты[2]);
		Месяц   = Число(КомпонентыДаты[1]);
		День    = Число(КомпонентыДаты[0]);
		Час     = ?(КомпонентыВремени.Количество() > 0, Число(КомпонентыВремени[0]), 0);
		Минута  = ?(КомпонентыВремени.Количество() > 1, Число(КомпонентыВремени[1]), 0);
		Секунда = ?(КомпонентыВремени.Количество() > 2, Число(КомпонентыВремени[2]), 0);
		Возврат Дата(Год, Месяц, День, Час, Минута, Секунда);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции


Функция ЧислоИзСтрокиПриват24(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Текст = СтрЗаменить(Текст, " ", "");
	Текст = СтрЗаменить(Текст, ",", ".");

	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;

	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции


Функция ВключенаОтладкаБанковскихВыписок()
	// Отладка загрузки банковских выписок.
	// Пока Истина — подробные сообщения выводятся на экран.
	// Поставьте Ложь, когда отладка больше не нужна.
	Возврат Истина;
КонецФункции


Процедура ОтладкаВыписокСообщить(Текст)
	Если ВключенаОтладкаБанковскихВыписок() Тогда
		Сообщить("[Выписки] " + Строка(Текст));
	КонецЕсли;
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ЗАДАЧА МЕНЕДЖЕРАМ ПО НОВЫМ ПОСТУПЛЕНИЯМ
//
// Вызывается в конце каждой загрузки выписки: и из регламента ЗагрузкаПриват24
// (-> БИАС.ЗагрузкаБанковскихВыписок -> ЗагрузитьБанковскиеВыписки), и с кнопки
// на форме обработки "Обмен Приват24".
//
// Новый платёж = входящее поступление, по которому в 1С ещё нет документа
// (пустая колонка ПлатежноеПоручениеВходящее) И о котором ещё не сигналили.
// Список уже отсигналенных платежей лежит в хранилище общих настроек рядом
// с самой таблицей ДокументыКИмпорту, поэтому повторные запуски регламента
// по одним и тем же (ещё не принятым) платежам задачу не поднимают.
//
// Задача на группу пользователей "Менеджеры" всегда ОДНА активная:
//   - активная задача есть  -> переносится (дата/оповещение на текущий момент,
//                              описание переписывается под новые платежи);
//   - активной задачи нет   -> создаётся новая.
// Открытие задачи сразу помечает её выполненной и открывает обработку
// "Обмен Приват24" - см. ВыполнитьЗадачуНовыхПлатежейПриОткрытии().
//

// Ключ, по которому задача этого типа отличается от всех остальных
// задач пользователей (реквизит ИдентификаторСобытия).
//
Функция ИдентификаторЗадачиНовыхПлатежей() Экспорт

	Возврат "НовыеПлатежиПриват24";

КонецФункции


Функция ЭтоЗадачаНовыхПлатежей(Задача) Экспорт

	Если Задача = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка

		Возврат СокрЛП(Строка(Задача.ИдентификаторСобытия))
			= ИдентификаторЗадачиНовыхПлатежей();

	Исключение

		Возврат Ложь;

	КонецПопытки;

КонецФункции


// Помечает задачу выполненной в момент её открытия: менеджер, открыв задачу,
// идёт принимать платёж сразу, а сама задача больше не всплывает в оповещениях.
// Если платежи так и останутся непринятыми, следующая порция поступлений
// поднимет уже новую задачу.
//
// Вызов уже стоит в модуле обычной формы Задача.ЗадачиПользователя.ФормаЗадачи,
// в начале ПриОткрытии():
//
//     Если БанковскиеВыписки.ЭтоЗадачаНовыхПлатежей(ЭтотОбъект) Тогда
//         БанковскиеВыписки.ВыполнитьЗадачуНовыхПлатежейПриОткрытии(ЭтотОбъект);
//         ПодключитьОбработчикОжидания("ОткрытьОбработкуОбменПриват24", 0.1, Истина);
//     КонецЕсли;
//
// Саму обработку открывает процедура формы ОткрытьОбработкуОбменПриват24():
// Обработки.ОбменПриват24.ПолучитьФорму().Открыть(). Здесь этого нет намеренно -
// модуль компилируется и на сервере, где работа с формами недоступна.
//
Процедура ВыполнитьЗадачуНовыхПлатежейПриОткрытии(ЗадачаОбъект) Экспорт

	Если Не ЭтоЗадачаНовыхПлатежей(ЗадачаОбъект) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Если ЗадачаОбъект.Выполнена Тогда
			Возврат;
		КонецЕсли;

		ЗадачаОбъект.Выполнена  = Истина;
		ЗадачаОбъект.Оповещение = Ложь;

		ЗадачаОбъект.Записать();

	Исключение

		// Не смогли записать (например, форма открыта только на чтение) -
		// задача просто останется активной, открытие формы не срываем.

	КонецПопытки;

КонецПроцедуры


Процедура ОбновитьЗадачуПоНовымПлатежам(ДокументыКИмпорту) Экспорт

	Если ТипЗнч(ДокументыКИмпорту) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;

	// Непринятые поступления: деньги пришли, документа по ним в 1С ещё нет.
	НепринятыеПлатежи = Новый Массив;
	КлючиНепринятых   = Новый Массив;

	Для Каждого СтрокаИмпорта Из ДокументыКИмпорту Цикл

		Если ЗначениеЗаполнено(
			СтрокаИмпорта.ПлатежноеПоручениеВходящее) Тогда

			Продолжить;

		КонецЕсли;

		Если Не (СтрокаИмпорта.СуммаПоступило > 0) Тогда
			Продолжить;
		КонецЕсли;

		КлючПлатежа =
			СокрЛП(Строка(СтрокаИмпорта.НомерДок));

		Если ПустаяСтрока(КлючПлатежа) Тогда
			Продолжить;
		КонецЕсли;

		НепринятыеПлатежи.Добавить(СтрокаИмпорта);
		КлючиНепринятых.Добавить(КлючПлатежа);

	КонецЦикла;

	ОповещенныеРанее = ПолучитьОповещенныеПлатежи();

	НовыеПлатежи = Новый Массив;

	Для Каждого СтрокаИмпорта Из НепринятыеПлатежи Цикл

		КлючПлатежа =
			СокрЛП(Строка(СтрокаИмпорта.НомерДок));

		Если ОповещенныеРанее.Найти(КлючПлатежа) = Неопределено Тогда
			НовыеПлатежи.Добавить(СтрокаИмпорта);
		КонецЕсли;

	КонецЦикла;

	Если НовыеПлатежи.Количество() = 0 Тогда

		// Новых поступлений нет - задачу не трогаем. Список отсигналенных
		// переписываем текущими непринятыми: принятые платежи уходят из него
		// сами и он не растёт бесконечно.
		СохранитьОповещенныеПлатежи(КлючиНепринятых);

		Возврат;

	КонецЕсли;

	ГруппаМенеджеры = ПолучитьГруппуМенеджеров();

	Если Не ЗначениеЗаполнено(ГруппаМенеджеры) Тогда

		ОтладкаВыписокСообщить(
			"Задача по новым платежам не создана: "
			+ "не найдена группа пользователей ""Менеджеры"".");

		// Список отсигналенных НЕ сохраняем: платежи менеджерам не показаны,
		// после появления группы о них должны сигналить как о новых.
		Возврат;

	КонецЕсли;

	СуществующаяЗадача =
		НайтиАктивнуюЗадачуНовыхПлатежей(
			ГруппаМенеджеры);

	Если ЗначениеЗаполнено(СуществующаяЗадача) Тогда

		Задача        = СуществующаяЗадача.ПолучитьОбъект();
		ЭтоПеренос    = Истина;

	Иначе

		Задача        = Задачи.ЗадачиПользователя.СоздатьЗадачу();
		ЭтоПеренос    = Ложь;

	КонецЕсли;

	ТекущийМомент = ТекущаяДата();

	Задача.ИдентификаторСобытия =
		ИдентификаторЗадачиНовыхПлатежей();

	Задача.Наименование = "Новые платежи Приват24";
	Задача.Исполнитель  = ГруппаМенеджеры;

	Задача.Описание =
		ОписаниеЗадачиПоНовымПлатежам(
			НовыеПлатежи,
			НепринятыеПлатежи);

	// Задача одна на все новые платежи, поэтому основание не заполняем:
	// привязка к одному заказу вводила бы в заблуждение, когда в задаче
	// перечислено несколько поступлений. При переносе активной задачи
	// старое основание тоже очищаем.
	Задача.Объект = Неопределено;

	// "Перенос" активной задачи = дата и оповещение сдвигаются на текущий
	// момент, чтобы менеджер увидел её снова - уже с новыми платежами.
	Задача.Дата           = ТекущийМомент;
	Задача.Оповещение     = Истина;
	Задача.СрокОповещения = ТекущийМомент;
	Задача.СрокИсполнения = ТекущийМомент + 24 * 60 * 60;

	Попытка

		Задача.Записать();

		СохранитьОповещенныеПлатежи(КлючиНепринятых);

		ОтладкаВыписокСообщить(
			?(ЭтоПеренос,
				"Задача по новым платежам перенесена",
				"Создана задача по новым платежам")
			+ ": новых " + Строка(НовыеПлатежи.Количество())
			+ ", всего непринятых "
			+ Строка(НепринятыеПлатежи.Количество()) + ".");

	Исключение

		ОтладкаВыписокСообщить(
			"Не удалось записать задачу по новым платежам: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры


Функция ПолучитьГруппуМенеджеров()

	Группа =
		Справочники.Пользователи.НайтиПоНаименованию(
			"Менеджеры",
			Истина);

	Если Не ЗначениеЗаполнено(Группа)
		Или Не Группа.ЭтоГруппа Тогда

		Возврат Справочники.Пользователи.ПустаяСсылка();

	КонецЕсли;

	Возврат Группа;

КонецФункции


Функция НайтиАктивнуюЗадачуНовыхПлатежей(Исполнитель)

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗадачиПользователя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
	|ГДЕ
	|	НЕ ЗадачиПользователя.Выполнена
	|	И НЕ ЗадачиПользователя.ПометкаУдаления
	|	И ЗадачиПользователя.ИдентификаторСобытия = &Идентификатор
	|	И ЗадачиПользователя.Исполнитель = &Исполнитель
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗадачиПользователя.Дата УБЫВ";

	Запрос.УстановитьПараметр(
		"Идентификатор",
		ИдентификаторЗадачиНовыхПлатежей());

	Запрос.УстановитьПараметр(
		"Исполнитель",
		Исполнитель);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции


Функция ОписаниеЗадачиПоНовымПлатежам(НовыеПлатежи, НепринятыеПлатежи)

	Текст =
		"Новых поступлений: "
		+ Строка(НовыеПлатежи.Количество()) + ".";

	Если НепринятыеПлатежи.Количество()
		> НовыеПлатежи.Количество() Тогда

		Текст = Текст
			+ " Всего непринятых: "
			+ Строка(НепринятыеПлатежи.Количество()) + ".";

	КонецЕсли;

	Текст = Текст + Символы.ПС + Символы.ПС;

	МаксимумСтрок = 15;
	Выведено      = 0;

	Для Каждого СтрокаИмпорта Из НовыеПлатежи Цикл

		Если Выведено >= МаксимумСтрок Тогда

			Текст = Текст
				+ "... и ещё "
				+ Строка(НовыеПлатежи.Количество() - Выведено)
				+ "." + Символы.ПС;

			Прервать;

		КонецЕсли;

		Текст = Текст
			+ Формат(СтрокаИмпорта.ДатаПроведения, "ДФ='dd.MM.yyyy HH:mm'")
			+ " | "
			+ Формат(СтрокаИмпорта.СуммаПоступило, "ЧДЦ=2")
			+ " " + Строка(СтрокаИмпорта.Валюта)
			+ " | "
			+ ?(ЗначениеЗаполнено(СтрокаИмпорта.Контрагент),
				Строка(СтрокаИмпорта.Контрагент),
				"контрагент не определён")
			+ ?(ЗначениеЗаполнено(СтрокаИмпорта.Заказ),
				" | " + Строка(СтрокаИмпорта.Заказ),
				"")
			+ Символы.ПС
			+ "    "
			+ Лев(СокрЛП(Строка(СтрокаИмпорта.Содержание)), 150)
			+ Символы.ПС;

		Выведено = Выведено + 1;

	КонецЦикла;

	Текст = Текст + Символы.ПС
		+ "Принять платежи: обработка ""Обмен Приват24"" -> "
		+ "отметить ""Загружать"" -> загрузить в ВПП.";

	Возврат Текст;

КонецФункции


// Ключи (НомерДок) платежей, о которых менеджерам уже сигналили.
// Лежат там же, где таблица ДокументыКИмпорту, - в хранилище общих настроек
// под тем же условным пользователем, чтобы регламент (фон) и форма (сеанс
// менеджера) видели один и тот же список.
//
Функция ПолучитьОповещенныеПлатежи()

	Результат = Новый Массив;

	Попытка

		ЗначениеИзХранилища =
			ХранилищеОбщихНастроек.Загрузить(
				"ОбменПриват24",
				"ОповещенныеПлатежи",
				,
				"Пользователь");

	Исключение

		ЗначениеИзХранилища = Неопределено;

	КонецПопытки;

	Если ТипЗнч(ЗначениеИзХранилища) = Тип("Массив") Тогда

		Для Каждого КлючПлатежа Из ЗначениеИзХранилища Цикл
			Результат.Добавить(СокрЛП(Строка(КлючПлатежа)));
		КонецЦикла;

	КонецЕсли;

	Возврат Результат;

КонецФункции


Процедура СохранитьОповещенныеПлатежи(Ключи)

	Попытка

		ХранилищеОбщихНастроек.Сохранить(
			"ОбменПриват24",
			"ОповещенныеПлатежи",
			Ключи,
			,
			"Пользователь");

	Исключение

		ОтладкаВыписокСообщить(
			"Не удалось сохранить список отсигналенных платежей: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// А-БАНК (Open API)
//
// Документация: https://sites.google.com/a-bank.com.ua/open-api
// Все запросы - POST JSON на open-api.a-bank.com.ua, каждый подписывается
// приватным ключом RSA (SHA1withRSA от тела запроса). Подпись и системный
// идентификатор идут в заголовках "signature" и "system".
//
// Используемые методы:
//   EXAPI0001 /legal-entity/link/get       - разовое получение токена (онбординг)
//   EXAPI0002 /legal-entity/accounts-list  - список счетов (проверка связи)
//   EXAPI0003 /legal-entity/payments-list  - выписка (основной режим)
//
// Настройка счёта в справочнике БанковскиеСчета:
//   ИсточникБанковскойВыписки = А-Банк
//   Токен = токен, привязанный к предприятию (EXAPI0001 + подтверждение в
//           мобильном приложении A-Business)
//   Айди  = IBAN счёта (именно он передаётся в запрос выписки)
//
// Общие настройки лежат в константах:
//   АБанкСистемныйИдентификатор - выдаёт банк в ответ на публичный ключ
//   АБанкПутьOpenSSL            - путь к openssl.exe НА СЕРВЕРЕ 1С
//   АБанкПутьКлюча              - путь к privatekey.pem НА СЕРВЕРЕ 1С
//

Функция ПолучитьОперацииАБанк(
	БанковскийСчет,
	ДатаНачала,
	ДатаКонца) Экспорт

	Операции = Новый Массив;

	Если Не ЗначениеЗаполнено(БанковскийСчет) Тогда
		Возврат Операции;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаНачала)
		Или Не ЗначениеЗаполнено(ДатаКонца) Тогда

		Возврат Операции;

	КонецЕсли;

	Токен = "";
	IBANСчета = "";

	Попытка
		Токен = СокрЛП(БанковскийСчет.Токен);
	Исключение
	КонецПопытки;

	Попытка
		IBANСчета = СокрЛП(БанковскийСчет.Айди);
	Исключение
	КонецПопытки;

	Если ПустаяСтрока(Токен) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.АБанк",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			БанковскийСчет,
			"Не заполнен токен А-Банка.");

		Возврат Операции;

	КонецЕсли;

	Если ПустаяСтрока(IBANСчета) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.АБанк",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			БанковскийСчет,
			"Не заполнен IBAN счёта (реквизит «Айди»).");

		Возврат Операции;

	КонецЕсли;

	// Пагинации у выписки нет - период запрашивается одним запросом целиком.
	// Границы берём с запасом по времени внутри суток.
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("request_ref", НовыйКлючЗапросаАБанк());
	ТелоЗапроса.Вставить("token",       Токен);
	ТелоЗапроса.Вставить("iban",        IBANСчета);

	ТелоЗапроса.Вставить(
		"date_from",
		ДатаВСтрокуАБанк(НачалоДня(ДатаНачала)));

	ТелоЗапроса.Вставить(
		"date_to",
		ДатаВСтрокуАБанк(КонецДня(ДатаКонца)));

	Данные = ВыполнитьЗапросАБанк(
		"/legal-entity/payments-list",
		ТелоЗапроса,
		БанковскийСчет);

	Если Данные = Неопределено Тогда
		Возврат Операции;
	КонецЕсли;

	Платежи = Неопределено;
	Данные.Свойство("payments", Платежи);

	Если ТипЗнч(Платежи) <> Тип("Массив") Тогда

		ОтладкаВыписокСообщить(
			"А-Банк: в ответе нет массива payments.");

		Возврат Операции;

	КонецЕсли;

	ОбработанныеИД = Новый Соответствие;

	Для Каждого Оплата Из Платежи Цикл

		Операция = ПреобразоватьОперациюАБанк(
			Оплата,
			БанковскийСчет,
			IBANСчета);

		Если Операция = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ОбработанныеИД.Получить(Операция.КлючДубляСтраниц)
			<> Неопределено Тогда

			Продолжить;

		КонецЕсли;

		ОбработанныеИД.Вставить(Операция.КлючДубляСтраниц, Истина);
		Операции.Добавить(Операция);

	КонецЦикла;

	Возврат Операции;

КонецФункции


// Направление операции у А-Банка знаком суммы не задаётся: есть объекты
// debit и credit, и наш счёт стоит в одном из них. Поступление - когда наш
// IBAN в credit.
//
Функция ПреобразоватьОперациюАБанк(
	Оплата,
	БанковскийСчет,
	IBANСчета)

	Если ТипЗнч(Оплата) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Реф = "";
	Оплата.Свойство("payment_ref", Реф);
	Реф = СокрЛП(Строка(Реф));

	Если ПустаяСтрока(Реф) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Дата создания документа точнее (в ней есть время), дата ОДБ - запасной путь.
	ДатаОперации = ДатаИзСтрокиАБанк(
		ЗначениеСвойстваАБанк(Оплата, "date_create"));

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда

		ДатаОперации = ДатаИзСтрокиАБанк(
			ЗначениеСвойстваАБанк(Оплата, "date"));

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;

	СуммаОперации = 0;
	Оплата.Свойство("amount", СуммаОперации);
	СуммаОперации = ?(ТипЗнч(СуммаОперации) = Тип("Число"), СуммаОперации, 0);

	Дебет  = Неопределено;
	Кредит = Неопределено;

	Оплата.Свойство("debit",  Дебет);
	Оплата.Свойство("credit", Кредит);

	НашIBAN = IBANВСравнимыйВид(IBANСчета);

	IBANДебета  = IBANВСравнимыйВид(ЗначениеСвойстваАБанк(Дебет,  "iban"));
	IBANКредита = IBANВСравнимыйВид(ЗначениеСвойстваАБанк(Кредит, "iban"));

	Если НашIBAN = IBANКредита Тогда

		ЭтоВходящий = Истина;
		Корреспондент = Дебет;

	ИначеЕсли НашIBAN = IBANДебета Тогда

		ЭтоВходящий = Ложь;
		Корреспондент = Кредит;

	Иначе

		// Ни дебет, ни кредит не наши - операция к этому счёту не относится.
		ОтладкаВыписокСообщить(
			"А-Банк: операция " + Реф + " пропущена, наш IBAN не найден"
			+ " (дебет " + IBANДебета + ", кредит " + IBANКредита + ").");

		Возврат Неопределено;

	КонецЕсли;

	КодВалюты = Неопределено;
	Оплата.Свойство("currency", КодВалюты);

	Валюта = ВалютаПоЧисловомуКоду(КодВалюты);

	// Наименование корреспондента - в ту же колонку, что и у Приват24
	// (для формы это «терминал»/плательщик).
	Терминал = СокрЛП(Строка(
		ЗначениеСвойстваАБанк(Корреспондент, "name")));

	Назначение = "";
	Оплата.Свойство("title", Назначение);

	НомерДокумента = СокрЛП(Строка(
		ЗначениеСвойстваАБанк(Оплата, "payment_num")));

	Операция = СоздатьБанковскуюОперацию();

	Операция.Источник         = "АБанк";
	Операция.Идентификатор    = "A" + Реф;
	Операция.КлючДубляСтраниц = "A" + Реф;
	Операция.БанковскийСчет   = БанковскийСчет;
	Операция.Дата             = ДатаОперации;
	Операция.Сумма            = СуммаОперации;
	Операция.Валюта           = Валюта;
	Операция.Входящий         = ЭтоВходящий;
	Операция.Остаток          = 0;
	Операция.Терминал         = Терминал;
	Операция.Назначение       = СокрЛП(Строка(Назначение));

	ОтладкаВыписокСообщить(
		"А-Банк: " + ?(ЭтоВходящий, "поступление", "списание")
		+ " " + Формат(СуммаОперации, "ЧДЦ=2")
		+ ", ключ " + Операция.Идентификатор
		+ ", док. " + НомерДокумента
		+ ", " + Лев(Операция.Назначение, 100));

	Возврат Операция;

КонецФункции


// Единая точка отправки запроса в А-Банк: собирает JSON, подписывает ровно те
// байты, которые уйдут в тело, отправляет и разбирает ответ.
// Возвращает разобранный ответ (Структура) или Неопределено при любой ошибке.
//
Функция ВыполнитьЗапросАБанк(
	Ресурс,
	ТелоЗапроса,
	ОбъектЖурнала = Неопределено)

	СистемныйИдентификатор = "";

	Попытка
		СистемныйИдентификатор =
			СокрЛП(Константы.АБанкСистемныйИдентификатор.Получить());
	Исключение
	КонецПопытки;

	Если ПустаяСтрока(СистемныйИдентификатор) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.АБанк",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ОбъектЖурнала,
			"Не заполнена константа «АБанкСистемныйИдентификатор»"
			+ " (идентификатор выдаёт банк в ответ на публичный ключ).");

		Возврат Неопределено;

	КонецЕсли;

	Попытка

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
		ТелоСтрокой = ЗаписьJSON.Закрыть();

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.АБанк",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ОбъектЖурнала,
			"Не удалось сформировать JSON запроса: " + ОписаниеОшибки());

		Возврат Неопределено;

	КонецПопытки;

	// Подпись считается по байтам тела, поэтому тело и отправляем двоичными
	// данными - никаких повторных перекодировок между подписью и отправкой.
	ДвоичноеТело = ПолучитьДвоичныеДанныеИзСтроки(ТелоСтрокой, "UTF-8", Ложь);

	ТекстОшибкиПодписи = "";

	Подпись = ПодписатьТелоАБанк(
		ДвоичноеТело,
		ТекстОшибкиПодписи);

	Если ПустаяСтрока(Подпись) Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.АБанк",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ОбъектЖурнала,
			"Не удалось подписать запрос: " + ТекстОшибкиПодписи);

		Возврат Неопределено;

	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Заголовки.Вставить("Accept",       "application/json");
	Заголовки.Вставить("system",       СистемныйИдентификатор);
	Заголовки.Вставить("signature",    Подпись);

	Попытка

		Соединение = Новый HTTPСоединение(
			"open-api.a-bank.com.ua",
			,
			,
			,
			,
			60,
			Новый ЗащищенноеСоединениеOpenSSL());

		Запрос = Новый HTTPЗапрос(Ресурс, Заголовки);
		Запрос.УстановитьТелоИзДвоичныхДанных(ДвоичноеТело);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.АБанк",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ОбъектЖурнала,
			"Ошибка подключения к А-Банку (" + Ресурс + "): "
			+ ОписаниеОшибки());

		Возврат Неопределено;

	КонецПопытки;

	СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();

	ОтладкаВыписокСообщить(
		"А-Банк: запрос " + Ресурс
		+ ", код ответа " + Строка(Ответ.КодСостояния));

	ОтладкаВыписокСообщить(
		"А-Банк: тело ответа: " + Лев(СокрЛП(СтрокаОтвета), 1500));

	Если Ответ.КодСостояния <> 200 Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.АБанк",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ОбъектЖурнала,
			"А-Банк вернул код HTTP " + Строка(Ответ.КодСостояния)
			+ " (" + Ресурс + "). Ответ: " + Лев(СтрокаОтвета, 1000));

		Возврат Неопределено;

	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(СтрокаОтвета)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка

		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

	Исключение

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.АБанк",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ОбъектЖурнала,
			"Не удалось разобрать JSON А-Банка: " + ОписаниеОшибки());

		Возврат Неопределено;

	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = "";
	Данные.Свойство("result", Результат);

	Если НРег(СокрЛП(Строка(Результат))) <> "ok" Тогда

		ЗаписьЖурналаРегистрации(
			"БанковскиеВыписки.АБанк",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ОбъектЖурнала,
			"А-Банк вернул result «" + Строка(Результат) + "» ("
			+ Ресурс + "). Ошибка: "
			+ ОписаниеОшибкиАБанк(Данные)
			+ ". Ответ: " + Лев(СтрокаОтвета, 1000));

		Возврат Неопределено;

	КонецЕсли;

	Возврат Данные;

КонецФункции


// SHA1withRSA приватным ключом. Штатными средствами 1С это не считается
// (КриптоМенеджер умеет только CMS через хранилище сертификатов), поэтому
// подпись делает openssl на сервере 1С.
//
Функция ПодписатьТелоАБанк(
	ДвоичноеТело,
	ТекстОшибки)

	// Если банк не примет base64 - переключить на Истина (тогда подпись
	// уйдёт шестнадцатеричной строкой). В документации формат не указан.
	ПодписьВHex = Ложь;

	ТекстОшибки = "";

	ПутьOpenSSL = "";
	ПутьКлюча   = "";

	Попытка
		ПутьOpenSSL = СокрЛП(Константы.АБанкПутьOpenSSL.Получить());
	Исключение
	КонецПопытки;

	Попытка
		ПутьКлюча = СокрЛП(Константы.АБанкПутьКлюча.Получить());
	Исключение
	КонецПопытки;

	Если ПустаяСтрока(ПутьOpenSSL) Тогда
		ТекстОшибки = "не заполнена константа «АБанкПутьOpenSSL».";
		Возврат "";
	КонецЕсли;

	Если ПустаяСтрока(ПутьКлюча) Тогда
		ТекстОшибки = "не заполнена константа «АБанкПутьКлюча».";
		Возврат "";
	КонецЕсли;

	ФайлТела    = ПолучитьИмяВременногоФайла("json");
	ФайлПодписи = ПолучитьИмяВременногоФайла("sig");

	Подпись = "";

	Попытка

		ДвоичноеТело.Записать(ФайлТела);

		КоманднаяСтрока =
			"""" + ПутьOpenSSL + """ dgst -sha1 -sign """ + ПутьКлюча
			+ """ -out """ + ФайлПодписи + """ """ + ФайлТела + """";

		КодВозврата = 0;

		ЗапуститьПриложение(
			КоманднаяСтрока,
			,
			Истина,
			КодВозврата);

		ФайлРезультата = Новый Файл(ФайлПодписи);

		Если КодВозврата <> 0 Тогда

			ТекстОшибки =
				"openssl завершился с кодом " + Строка(КодВозврата)
				+ " (проверьте путь к openssl.exe и к приватному ключу,"
				+ " а также права пользователя сервера 1С на эти файлы).";

		ИначеЕсли Не ФайлРезультата.Существует() Тогда

			ТекстОшибки = "openssl не создал файл подписи.";

		Иначе

			ДанныеПодписи = Новый ДвоичныеДанные(ФайлПодписи);

			Если ПодписьВHex Тогда

				Подпись = HexСтрокаИзДвоичныхДанных(ДанныеПодписи);

			Иначе

				// Base64Строка переносит строки каждые 76 символов -
				// в заголовок HTTP такое класть нельзя.
				Подпись = Base64Строка(ДанныеПодписи);
				Подпись = СтрЗаменить(Подпись, Символы.ВК, "");
				Подпись = СтрЗаменить(Подпись, Символы.ПС, "");
				Подпись = СокрЛП(Подпись);

			КонецЕсли;

		КонецЕсли;

	Исключение

		ТекстОшибки = ОписаниеОшибки();

	КонецПопытки;

	УдалитьВременныйФайлАБанк(ФайлТела);
	УдалитьВременныйФайлАБанк(ФайлПодписи);

	Возврат Подпись;

КонецФункции


Функция HexСтрокаИзДвоичныхДанных(ДвоичныеДанные)

	Символы16 = "0123456789abcdef";
	Результат = "";

	ЧтениеДанных = Новый ЧтениеДанных(ДвоичныеДанные);
	Буфер = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных();
	ЧтениеДанных.Закрыть();

	Для Позиция = 0 По Буфер.Размер - 1 Цикл

		Байт = Буфер.Получить(Позиция);

		Результат = Результат
			+ Сред(Символы16, Цел(Байт / 16) + 1, 1)
			+ Сред(Символы16, Байт % 16 + 1, 1);

	КонецЦикла;

	Возврат Результат;

КонецФункции


Процедура УдалитьВременныйФайлАБанк(ИмяФайла)

	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
	КонецПопытки;

КонецПроцедуры


Функция ОписаниеОшибкиАБанк(Данные)

	Ошибка = Неопределено;

	Попытка
		Данные.Свойство("error", Ошибка);
	Исключение
	КонецПопытки;

	Если ТипЗнч(Ошибка) <> Тип("Структура") Тогда
		Возврат "не указана";
	КонецЕсли;

	Статус = ЗначениеСвойстваАБанк(Ошибка, "status");
	Текст  = ЗначениеСвойстваАБанк(Ошибка, "title");

	Возврат СокрЛП(Строка(Статус)) + " / " + СокрЛП(Строка(Текст));

КонецФункции


Функция ЗначениеСвойстваАБанк(Данные, ИмяСвойства)

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Значение = "";

	Попытка
		Данные.Свойство(ИмяСвойства, Значение);
	Исключение
		Возврат "";
	КонецПопытки;

	Возврат ?(Значение = Неопределено, "", Значение);

КонецФункции


Функция IBANВСравнимыйВид(Значение)

	Возврат ВРег(СтрЗаменить(СокрЛП(Строка(Значение)), " ", ""));

КонецФункции


// Числовой код валюты по ISO-4217 (980, 840, 978) - в код справочника Валюты.
Функция ВалютаПоЧисловомуКоду(КодВалюты)

	КодСтрокой = "980";

	Если ТипЗнч(КодВалюты) = Тип("Число") Тогда
		КодСтрокой = Формат(КодВалюты, "ЧЦ=3; ЧГ=0");
	ИначеЕсли Не ПустаяСтрока(СокрЛП(Строка(КодВалюты))) Тогда
		КодСтрокой = СокрЛП(Строка(КодВалюты));
	КонецЕсли;

	Валюта = Справочники.Валюты.НайтиПоКоду(КодСтрокой);

	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Справочники.Валюты.НайтиПоКоду("980");
	КонецЕсли;

	Возврат Валюта;

КонецФункции


// Дата -> "yyyy-MM-dd HH:mm:ss" (формат периода в запросе выписки).
// Собирается из двух частей: литеральный пробел внутри ДФ 1С трактует
// по-своему, а склейка работает предсказуемо.
Функция ДатаВСтрокуАБанк(Значение)

	Возврат Формат(Значение, "ДФ=yyyy-MM-dd")
		+ " " + Формат(Значение, "ДФ=HH:mm:ss");

КонецФункции


// "2019-12-18 14:50:57.743" / "2019-12-18 14:50:57" / "2019-12-18" -> Дата.
Функция ДатаИзСтрокиАБанк(Значение)

	Стр = СокрЛП(Строка(Значение));

	Если ПустаяСтрока(Стр) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Цифры = "";

	Для Позиция = 1 По СтрДлина(Стр) Цикл

		Символ = Сред(Стр, Позиция, 1);

		Если Найти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		КонецЕсли;

		// 14 цифр - это ггггммддччммсс, дробные доли секунды уже не нужны.
		Если СтрДлина(Цифры) >= 14 Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;

	Если СтрДлина(Цифры) < 8 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Пока СтрДлина(Цифры) < 14 Цикл
		Цифры = Цифры + "0";
	КонецЦикла;

	Попытка
		Возврат Дата(Цифры);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции


Функция НовыйКлючЗапросаАБанк()

	Возврат ВРег(Строка(Новый УникальныйИдентификатор));

КонецФункции


