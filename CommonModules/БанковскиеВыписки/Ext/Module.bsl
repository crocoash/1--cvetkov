// А-БАНК: сервисные вызовы для настройки (разово, из консоли кода)
//

// EXAPI0001. Возвращает токен и deep link. Токен создаётся НЕАКТИВНЫМ:
// ссылку надо открыть на телефоне, подтвердить в приложении A-Business
// согласие по нужному предприятию, после чего выслать банку токен, ОКПО и
// название компании - только тогда он начнёт работать.
//
Функция ПолучитьДеплинкАБанк(
	Телефон,
	ИдентификаторКлиента = "",
	АдресУведомления = "") Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("request_ref",  НовыйКлючЗапросаАБанк());
	ТелоЗапроса.Вставить("phone",        СокрЛП(Строка(Телефон)));

	ТелоЗапроса.Вставить(
		"client_id",
		?(ПустаяСтрока(СокрЛП(Строка(ИдентификаторКлиента))),
			НовыйКлючЗапросаАБанк(),
			СокрЛП(Строка(ИдентификаторКлиента))));

	ТелоЗапроса.Вставить(
		"callback_url",
		СокрЛП(Строка(АдресУведомления)));

	Данные = ВыполнитьЗапросАБанк(
		"/legal-entity/link/get",
		ТелоЗапроса);

	Если Данные = Неопределено Тогда
		Сообщить("А-Банк: получить deep link не удалось, см. журнал регистрации.");
		Возврат Неопределено;
	КонецЕсли;

	Сообщить("А-Банк токен: " + ЗначениеСвойстваАБанк(Данные, "token"));
	Сообщить("А-Банк deep link: " + ЗначениеСвойстваАБанк(Данные, "link"));

	Возврат Данные;

КонецФункции


// EXAPI0002. Проверка связи и заодно источник IBAN для реквизита «Айди».
Функция ПолучитьСчетаАБанк(Токен) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("request_ref", НовыйКлючЗапросаАБанк());
	ТелоЗапроса.Вставить("token",       СокрЛП(Строка(Токен)));

	Данные = ВыполнитьЗапросАБанк(
		"/legal-entity/accounts-list",
		ТелоЗапроса);

	Если Данные = Неопределено Тогда
		Сообщить("А-Банк: список счетов получить не удалось, см. журнал регистрации.");
		Возврат Неопределено;
	КонецЕсли;

	Компании = Неопределено;
	Данные.Свойство("companies", Компании);

	Если ТипЗнч(Компании) = Тип("Массив") Тогда

		Для Каждого Компания Из Компании Цикл

			Сообщить("Компания: "
				+ ЗначениеСвойстваАБанк(Компания, "name"));

			Счета = Неопределено;

			Если ТипЗнч(Компания) = Тип("Структура") Тогда
				Компания.Свойство("accounts", Счета);
			КонецЕсли;

			Если ТипЗнч(Счета) <> Тип("Массив") Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого Счет Из Счета Цикл

				Сообщить("    "
					+ ЗначениеСвойстваАБанк(Счет, "iban")
					+ "  вал. " + Строка(ЗначениеСвойстваАБанк(Счет, "currency"))
					+ "  остаток " + Строка(ЗначениеСвойстваАБанк(Счет, "balance"))
					+ "  " + ЗначениеСвойстваАБанк(Счет, "name_short"));

			КонецЦикла;

		КонецЦикла;

	КонецЕсли;

	Возврат Данные;

КонецФункции
