////////////////////////////////////////////////////////////////////////////////
// Изменение справочников снаружи: создать элемент, поправить реквизиты,
// поставить или снять пометку удаления.
//
// Вход - HTTPСервис.ТелеграмВебхук, действие "edit". Защита - тот же общий токен
// ТелеграмБот.ТокенСайта, которым сайт уже пишет в базу номера накладных;
// новой дырки наружу этот модуль не открывает.
//
// Соседний модуль ЧтениеДанныхБазы писать не умеет вовсе - и не должен. Запись
// вынесена сюда именно затем, чтобы «читалка» осталась читалкой: у неё нет ни
// одной строки, способной изменить данные.
//
// ЧЕГО ЗДЕСЬ НЕТ НАМЕРЕННО
//
//  * Документы, регистры, константы. Только справочники. Документ - это движения
//    по регистрам, проведение и последствия в отчётности; менять его снаружи
//    одной строкой JSON нельзя. Единственное исключение уже существует и живёт
//    отдельно - запись номера накладной (ЗаписатьНомераТТН).
//  * Физическое удаление. Элемент можно только пометить на удаление; удаляет
//    их пользователь обработкой «Удаление помеченных объектов», которая проверит
//    ссылки. Снаружи удалить объект, на который ссылаются документы, - это тихо
//    битые ссылки в закрытых периодах.
//
// ГЛАВНЫЙ ПРЕДОХРАНИТЕЛЬ - РЕЖИМ ПРОВЕРКИ
//
// Без явного apply = true не пишется НИЧЕГО: команда находит элементы, считает
// «было -> станет» и возвращает это списком. То есть случайный, повторно
// отправленный или неправильно понятый вызов по умолчанию безвреден, а увидеть
// последствия можно до того, как они наступят.
//
// Каждый вызов идёт в журнал регистрации, событие «База.Запись», с составом
// изменений по каждому элементу - и запись, и проверка.
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Изменить элементы справочника.
//
// Тело команды:
//   {"action": "edit",
//    "catalog": "Справочник.Склады",
//    "apply": true,
//    "items": [
//      {"id":   "e1c2…",         "set": {"Наименование": "Склад Болото"}},
//      {"code": "000000055",     "set": {"Активный": false}},
//      {"name": "Абсолютно все", "mark": true},
//      {"new":  true,            "set": {"Наименование": "Новый склад",
//                                        "ВидСклада": {"type": "ссылка",
//                                          "table": "Перечисление.ВидыСкладов",
//                                          "value": "Оптовый"}}}
//    ]}
//
// Элемент ищется по id, коду или наименованию - что задано, в этом порядке.
// Поиск по наименованию ненадёжен по своей природе (тёзки), поэтому при двух
// и более совпадениях строка отклоняется, а не берёт первое попавшееся.
//
// Пачку не роняем целиком: у каждой строки свой ok/error - так же, как
// в ЗаписатьНомераТТН. Один ненайденный элемент не должен отменять двадцать
// нормальных.
//
// Параметры:
//  Данные - Структура - разобранное тело команды.
//
// Возвращаемое значение:
//  Структура - ok, apply, catalog, saved, items.
//
Функция Изменить(Знач Данные) Экспорт

	// Пользователь публикации базы - служебный, прав на запись справочников
	// у него нет. Канал защищён токеном, это и есть проверка «свой - чужой».
	УстановитьПривилегированныйРежим(Истина);

	Итог = Новый Структура;
	Итог.Вставить("ok", Ложь);

	ИмяСправочника = "";
	Данные.Свойство("catalog", ИмяСправочника);
	ИмяСправочника = СокрЛП(Строка(ИмяСправочника));

	// «Справочник.Склады» и «Склады» - одно и то же: писать вид каждый раз
	// незачем, а перепутать его с документом здесь невозможно.
	Если СтрНачинаетсяС(ИмяСправочника, "Справочник.") Тогда
		ИмяСправочника = Сред(ИмяСправочника, СтрДлина("Справочник.") + 1);
	КонецЕсли;

	Если ПустаяСтрока(ИмяСправочника) Тогда
		Итог.Вставить("error", "не указан справочник (поле catalog)");
		Возврат Итог;
	КонецЕсли;

	МетаСправочника = Метаданные.Справочники.Найти(ИмяСправочника);

	Если МетаСправочника = Неопределено Тогда
		Итог.Вставить("error", "справочник """ + ИмяСправочника + """ в конфигурации не найден");
		Возврат Итог;
	КонецЕсли;

	Элементы = Неопределено;
	Данные.Свойство("items", Элементы);

	Если ТипЗнч(Элементы) <> Тип("Массив") ИЛИ Элементы.Количество() = 0 Тогда
		Итог.Вставить("error", "нет элементов для изменения (поле items)");
		Возврат Итог;
	КонецЕсли;

	// Потолок на пачку. Больше двухсот за раз - это уже не правка, а обработка
	// данных, и делать её надо в базе, где видно ход и можно остановить.
	Если Элементы.Количество() > 200 Тогда
		Итог.Вставить("error", "за один вызов не больше 200 элементов, прислано "
			+ Формат(Элементы.Количество(), "ЧГ=0"));
		Возврат Итог;
	КонецЕсли;

	Применять = Ложь;
	Данные.Свойство("apply", Применять);
	Применять = (Применять = Истина);

	Менеджер = Справочники[МетаСправочника.Имя];

	Результаты = Новый Массив;
	Записано   = 0;

	Для Каждого Элемент Из Элементы Цикл

		Результат = ОбработатьЭлемент(Менеджер, МетаСправочника, Элемент, Применять);
		Результаты.Добавить(Результат);

		Если Результат.ok И Применять Тогда
			Записано = Записано + 1;
		КонецЕсли;

	КонецЦикла;

	Итог.Вставить("ok",      Истина);
	Итог.Вставить("apply",   Применять);
	Итог.Вставить("catalog", МетаСправочника.ПолноеИмя());
	Итог.Вставить("saved",   Записано);
	Итог.Вставить("items",   Результаты);

	ЗаписатьВЖурнал(МетаСправочника, Применять, Результаты, Записано);

	Возврат Итог;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ОбработатьЭлемент(Знач Менеджер, Знач МетаСправочника, Знач Элемент, Знач Применять)

	Результат = Новый Структура;
	Результат.Вставить("ok",    Ложь);
	Результат.Вставить("error", "");

	Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
		Результат.error = "строка не является объектом";
		Возврат Результат;
	КонецЕсли;

	Попытка
		Объект = НайтиИлиСоздать(Менеджер, МетаСправочника, Элемент, Результат);
	Исключение
		Результат.error = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Если Объект = Неопределено Тогда
		// Причина уже записана в Результат.error.
		Возврат Результат;
	КонецЕсли;

	Изменения = Новый Массив;

	// Пометка удаления. Ставим свойством, а не УстановитьПометкуУдаления:
	// тот метод пишет объект сам и заодно тащит за собой подчинённые элементы,
	// то есть делает больше, чем просили, и мимо режима проверки.
	Пометка = Неопределено;

	Если Элемент.Свойство("mark", Пометка) И Пометка <> Неопределено Тогда

		НоваяПометка = (Пометка = Истина);

		Если Объект.ПометкаУдаления <> НоваяПометка Тогда
			ДобавитьИзменение(Изменения, "ПометкаУдаления", Объект.ПометкаУдаления, НоваяПометка);
			Объект.ПометкаУдаления = НоваяПометка;
		КонецЕсли;

	КонецЕсли;

	Значения = Неопределено;
	Элемент.Свойство("set", Значения);

	Если ТипЗнч(Значения) = Тип("Структура") Тогда

		Для Каждого КлючЗначение Из Значения Цикл

			Ошибка = УстановитьРеквизит(Объект, МетаСправочника, КлючЗначение.Ключ,
				КлючЗначение.Значение, Изменения);

			Если Не ПустаяСтрока(Ошибка) Тогда
				Результат.error = Ошибка;
				Возврат Результат;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Результат.Вставить("changes", Изменения);

	Если Изменения.Количество() = 0 И Не Объект.ЭтоНовый() Тогда
		Результат.ok = Истина;
		Результат.Вставить("skipped", "менять нечего: значения уже такие");
		ДополнитьПредставлением(Результат, Объект);
		Возврат Результат;
	КонецЕсли;

	Если Применять Тогда

		Попытка
			Объект.Записать();
		Исключение
			// Проверка заполнения, подписки на события, блокировки - всё это
			// живёт в самой базе и должно отработать. Ошибку отдаём построчно.
			Результат.error = ОписаниеОшибки();
			Возврат Результат;
		КонецПопытки;

	КонецЕсли;

	Результат.ok = Истина;
	ДополнитьПредставлением(Результат, Объект);

	Возврат Результат;

КонецФункции

// Найти элемент по id, коду или наименованию - либо создать новый по new = true.
//
// Возвращает объект (не ссылку): дальше ему правят реквизиты. При неудаче -
// Неопределено, причина уходит в Результат.error.
Функция НайтиИлиСоздать(Знач Менеджер, Знач МетаСправочника, Знач Элемент, Результат)

	Создавать = Ложь;
	Элемент.Свойство("new", Создавать);

	Если Создавать = Истина Тогда
		Результат.Вставить("created", Истина);
		Возврат Менеджер.СоздатьЭлемент();
	КонецЕсли;

	Идентификатор = "";
	Элемент.Свойство("id", Идентификатор);
	Идентификатор = СокрЛП(Строка(Идентификатор));

	Если Не ПустаяСтрока(Идентификатор) Тогда

		// ПолучитьСсылку идентификатор не проверяет - ссылка на несуществующий
		// объект строится молча. Существование выясняется только попыткой
		// прочитать объект: у несуществующего это Неопределено.
		Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
		Объект = Ссылка.ПолучитьОбъект();

		Если Объект = Неопределено Тогда
			Результат.error = "элемент с идентификатором " + Идентификатор + " не найден";
			Возврат Неопределено;
		КонецЕсли;

		Возврат Объект;

	КонецЕсли;

	Код = "";
	Элемент.Свойство("code", Код);
	Код = СокрЛП(Строка(Код));

	Если Не ПустаяСтрока(Код) Тогда

		Ссылка = Менеджер.НайтиПоКоду(Код);

		Если Ссылка.Пустая() Тогда
			Результат.error = "элемент с кодом " + Код + " не найден";
			Возврат Неопределено;
		КонецЕсли;

		Возврат Ссылка.ПолучитьОбъект();

	КонецЕсли;

	Наименование = "";
	Элемент.Свойство("name", Наименование);
	Наименование = СокрЛП(Строка(Наименование));

	Если ПустаяСтрока(Наименование) Тогда
		Результат.error = "не задано, что менять: нужен id, code, name или new";
		Возврат Неопределено;
	КонецЕсли;

	// Тёзки в справочниках - обычное дело, и молча взять первого попавшегося
	// значит однажды переименовать не тот объект. Считаем совпадения запросом
	// и при неоднозначности отказываемся.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Таблица.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + МетаСправочника.Имя + " КАК Таблица
		|ГДЕ
		|	Таблица.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", Наименование);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Не Выборка.Следующий() Тогда
		Результат.error = "элемент с наименованием """ + Наименование + """ не найден";
		Возврат Неопределено;
	КонецЕсли;

	Найденная = Выборка.Ссылка;

	Если Выборка.Следующий() Тогда
		Результат.error = "наименованию """ + Наименование
			+ """ отвечает больше одного элемента - искать по code или id";
		Возврат Неопределено;
	КонецЕсли;

	Возврат Найденная.ПолучитьОбъект();

КонецФункции

// Установить один реквизит. Возвращает текст ошибки либо пустую строку.
Функция УстановитьРеквизит(Объект, Знач МетаСправочника, Знач Имя, Знач ЗначениеJSON, Изменения)

	Если Не ЕстьРеквизит(МетаСправочника, Имя) Тогда
		Возврат "реквизита """ + Имя + """ у справочника " + МетаСправочника.Имя + " нет";
	КонецЕсли;

	Попытка
		Значение = ЧтениеДанныхБазы.ЗначениеИзJSON(ЗначениеJSON);
	Исключение
		Возврат "реквизит """ + Имя + """: " + ОписаниеОшибки();
	КонецПопытки;

	// Строковые реквизиты платформа усекает МОЛЧА - длинное значение просто
	// теряет хвост, и об этом никто не узнает до первого несошедшегося поиска.
	// Поэтому проверяем длину сами и отказываемся, а не «сохраняем как влезло».
	Если ТипЗнч(Значение) = Тип("Строка") Тогда

		Предел = ПредельнаяДлина(МетаСправочника, Имя);

		Если Предел > 0 И СтрДлина(Значение) > Предел Тогда
			Возврат "реквизит """ + Имя + """: значение длиной "
				+ Формат(СтрДлина(Значение), "ЧГ=0") + " не влезает в "
				+ Формат(Предел, "ЧГ=0") + " символов и было бы усечено молча";
		КонецЕсли;

	КонецЕсли;

	Попытка
		Прежнее = Объект[Имя];
	Исключение
		Возврат "реквизит """ + Имя + """: " + ОписаниеОшибки();
	КонецПопытки;

	Если Прежнее = Значение Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Объект[Имя] = Значение;
	Исключение
		// Чаще всего это несовпадение типа: строку в число, строку в ссылку.
		Возврат "реквизит """ + Имя + """: " + ОписаниеОшибки();
	КонецПопытки;

	ДобавитьИзменение(Изменения, Имя, Прежнее, Значение);

	Возврат "";

КонецФункции

Функция ЕстьРеквизит(Знач МетаСправочника, Знач Имя)

	Если Имя = "Наименование" ИЛИ Имя = "Код" ИЛИ Имя = "Родитель"
		ИЛИ Имя = "Владелец" ИЛИ Имя = "ПометкаУдаления" Тогда

		Возврат Истина;

	КонецЕсли;

	Возврат МетаСправочника.Реквизиты.Найти(Имя) <> Неопределено;

КонецФункции

// Предельная длина строкового реквизита; 0 - не строка либо длина не ограничена.
Функция ПредельнаяДлина(Знач МетаСправочника, Знач Имя)

	Попытка

		Если Имя = "Наименование" Тогда
			Возврат МетаСправочника.ДлинаНаименования;
		КонецЕсли;

		Если Имя = "Код" Тогда
			Возврат МетаСправочника.ДлинаКода;
		КонецЕсли;

		Реквизит = МетаСправочника.Реквизиты.Найти(Имя);

		Если Реквизит = Неопределено Тогда
			Возврат 0;
		КонецЕсли;

		Возврат Реквизит.Тип.КвалификаторыСтроки.Длина;

	Исключение

		Возврат 0;

	КонецПопытки;

КонецФункции

Процедура ДобавитьИзменение(Изменения, Знач Имя, Знач Прежнее, Знач Новое)

	Изменение = Новый Структура;
	Изменение.Вставить("field", Имя);
	Изменение.Вставить("from",  ТекстЗначения(Прежнее));
	Изменение.Вставить("to",    ТекстЗначения(Новое));

	Изменения.Добавить(Изменение);

КонецПроцедуры

Функция ТекстЗначения(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "да", "нет");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='yyyy-MM-dd HH:mm:ss'");
	КонецЕсли;

	Попытка
		Возврат Строка(Значение);
	Исключение
		Возврат "<значение не преобразуется в строку>";
	КонецПопытки;

КонецФункции

Процедура ДополнитьПредставлением(Результат, Знач Объект)

	Попытка
		Результат.Вставить("name", Строка(Объект.Наименование));
	Исключение
		// У справочника может не быть наименования - это не повод падать.
	КонецПопытки;

	Попытка
		Результат.Вставить("code", Строка(Объект.Код));
	Исключение
		// Ровно так же с кодом.
	КонецПопытки;

	Попытка
		// У нового, ещё не записанного объекта ссылки нет - в режиме проверки
		// её не будет никогда, и это нормально.
		Если Не Объект.Ссылка.Пустая() Тогда
			Результат.Вставить("id", Строка(Объект.Ссылка.УникальныйИдентификатор()));
		КонецЕсли;
	Исключение
		// Ссылки нет - идентификатор просто не показываем.
	КонецПопытки;

	Попытка
		Если Объект.Предопределенный Тогда
			Результат.Вставить("predefined", Истина);
		КонецЕсли;
	Исключение
		// В старых режимах совместимости свойства может не быть.
	КонецПопытки;

КонецПроцедуры

// Журнал - единственный след того, что кто-то менял данные снаружи. Пишем и
// проверку тоже: знать, что запрашивали, но не применили, бывает не менее важно.
Процедура ЗаписатьВЖурнал(Знач МетаСправочника, Знач Применять, Знач Результаты, Знач Записано)

	Текст = ?(Применять, "ЗАПИСЬ", "проверка без записи")
		+ ": " + МетаСправочника.ПолноеИмя()
		+ ", строк " + Формат(Результаты.Количество(), "ЧГ=0")
		+ ", записано " + Формат(Записано, "ЧГ=0");

	Для Каждого Результат Из Результаты Цикл

		Кусок = Символы.ПС + "  ";

		Наименование = "";
		Результат.Свойство("name", Наименование);
		Кусок = Кусок + ?(ПустаяСтрока(Наименование), "<без наименования>", Наименование);

		Если Не Результат.ok Тогда

			Кусок = Кусок + " - ОТКАЗ: " + Результат.error;

		Иначе

			Изменения = Неопределено;
			Результат.Свойство("changes", Изменения);

			Если ТипЗнч(Изменения) = Тип("Массив") Тогда
				Для Каждого Изменение Из Изменения Цикл
					Кусок = Кусок + Символы.ПС + "    " + Изменение.field
						+ ": " + Изменение.from + " -> " + Изменение.to;
				КонецЦикла;
			КонецЕсли;

		КонецЕсли;

		Текст = Текст + Кусок;

	КонецЦикла;

	ЗаписьЖурналаРегистрации("База.Запись",
		?(Применять, УровеньЖурналаРегистрации.Информация, УровеньЖурналаРегистрации.Примечание),
		МетаСправочника, , Лев(Текст, 4000));

КонецПроцедуры
