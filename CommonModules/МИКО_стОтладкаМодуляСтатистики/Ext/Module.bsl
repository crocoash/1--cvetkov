&НаСервере
Процедура ВывестиРезультатыВПротоколОтладки(ТабДок) Экспорт
	ПротоколОтладки  = ПолучитьОбщийМакет("МИКО_стПротоколОтладки");
	ОбластьЗаголовок = ПротоколОтладки.Получитьобласть("Шапка");
	ТабДок.Вывести(ОбластьЗаголовок);
	
	мод_стЗагрузкаИсторииЗвонков_v7 = Вычислить("МИКО_стЗагрузкаИсторииЗвонков_v7");
	МассивАТС = мод_стЗагрузкаИсторииЗвонков_v7.ОпределитьПараметрыАТС();
	
	Индекс = 0;
	Пока Индекс < МассивАТС.Количество() Цикл
		
		// инфа об АТС
		ОбластьАТС = ПротоколОтладки.Получитьобласть("НаименованиеАТС");
		Если Индекс = 0 Тогда
		   id_pbx = ""+ МассивАТС[Индекс].Получить("id_pbx")+" (Основная АТС с адресом: "+МассивАТС[Индекс].Получить("АдресСервера")+" )"
	    Иначе
		   id_pbx = ""+ МассивАТС[Индекс].Получить("id_pbx")+" (Дополнительная АТС с адресом: "+МассивАТС[Индекс].Получить("АдресСервера")+" )"
		КонецЕсли; 
		ОбластьАТС.Параметры.id_pbx = id_pbx;
		ТабДок.Вывести(ОбластьАТС);
		
		// CDR
		ОбластьШапка = ПротоколОтладки.Получитьобласть("ТабCDR");
		ТабДок.Вывести(ОбластьШапка);
		
		ОбластьЗначениеCDR = ПротоколОтладки.Получитьобласть("ЗначТабCDR");
		ПервыйПакетДанныхCDR = ""; ПоследнийПакетДанныхCDR = "";
		ВыполнитьПроверкуСервер("CDR", МассивАТС[Индекс], ПервыйПакетДанныхCDR, ПоследнийПакетДанныхCDR);
		ОбластьЗначениеCDR.Параметры.ПервыйПакетCDR = ПервыйПакетДанныхCDR;
		ОбластьЗначениеCDR.Параметры.ПоследнийПакетCDR = ПоследнийПакетДанныхCDR;
		ТабДок.Вывести(ОбластьЗначениеCDR);
		
		ОбластьПробел = ПротоколОтладки.Получитьобласть("Пробел");
		ТабДок.Вывести(ОбластьПробел);
		
		// CEL
		ОбластьШапка = ПротоколОтладки.Получитьобласть("ТабCEL");
		ТабДок.Вывести(ОбластьШапка);

		ОбластьЗначениеCEL = ПротоколОтладки.Получитьобласть("ЗначТабCEL");
		ПервыйПакетДанныхCEL = ""; ПоследнийПакетДанныхCEL = "";
		ВыполнитьПроверкуСервер("CEL",  МассивАТС[Индекс], ПервыйПакетДанныхCEL, ПоследнийПакетДанныхCEL);
		ОбластьЗначениеCEL.Параметры.ПервыйПакетCEL = ПервыйПакетДанныхCEL;
		ОбластьЗначениеCEL.Параметры.ПоследнийПакетCEL = ПоследнийПакетДанныхCEL;
		ТабДок.Вывести(ОбластьЗначениеCEL);
		
		ТабДок.Вывести(ОбластьПробел);

		// выводим проверочную ссылку
		ХостAsterisk = МассивАТС[Индекс].Получить("АдресСервера"); 
		ПортСервера  = МассивАТС[Индекс].Получить("ПортСервера"); 
		Ресурс       = МассивАТС[Индекс].Получить("РесурсCDR");
		ОбластьСправка = ПротоколОтладки.Получитьобласть("Справка");
		ОбластьСправка.Параметры.ПроверочнаяСсылка = "http://"+ХостAsterisk+":"+ПортСервера+Ресурс+"?limit=450&offset=0";
		ТабДок.Вывести(ОбластьСправка);
		
		// выводим результат CDR из браузера
		ОбластьПроверочнаяСсылка = ПротоколОтладки.Получитьобласть("ПроверочнаяСсылка");
		limit=20;
		Ресурс = ПолучитьРесурсCDR(limit,,МассивАТС[Индекс].Получить("id_pbx"), МассивАТС[Индекс].Получить("РесурсCDR"));
		РезультатКлиент = ОтправитьДляОбработкиНаАТС(Ресурс, Истина, МассивАТС[Индекс]);
		ОбластьПроверочнаяСсылка.Параметры.РезультатКлиентCDR = РезультатКлиент;
		Ресурс = СтрЗаменить(Ресурс, "&offset=", Символы.ПС);
		Ресурс = СтрЗаменить(Ресурс, "limit=", Символы.ПС);         
		ОбластьПроверочнаяСсылка.Параметры.offsetCDR = СтрПолучитьСтроку(Ресурс,3);
		ОбластьПроверочнаяСсылка.Параметры.limitCDR = СтрПолучитьСтроку(Ресурс,2);
		
		// выводим результат CEL из браузера
		Ресурс = ПолучитьРесурсCEL(limit,,МассивАТС[Индекс].Получить("id_pbx"),МассивАТС[Индекс].Получить("РесурсCEL"));
		РезультатКлиент = ОтправитьДляОбработкиНаАТС(Ресурс, Истина, МассивАТС[Индекс]);
		ОбластьПроверочнаяСсылка.Параметры.РезультатКлиентCEL = РезультатКлиент;
		Ресурс = СтрЗаменить(Ресурс, "&offset=", Символы.ПС);
		Ресурс = СтрЗаменить(Ресурс, "limit=", Символы.ПС);         
		ОбластьПроверочнаяСсылка.Параметры.offsetCEL = СтрПолучитьСтроку(Ресурс,3);
		ОбластьПроверочнаяСсылка.Параметры.limitCEL = СтрПолучитьСтроку(Ресурс,2);
		ТабДок.Вывести(ОбластьПроверочнаяСсылка);
		
		Индекс = Индекс + 1;
	КонецЦикла;	

КонецПроцедуры // ()

&НаСервере
Процедура ВыполнитьПроверкуСервер(ТипПроверки = "CDR", ПараметрыАТС, ПервыйПакетДанных, ПоследнийПакетДанных)
	
	ПервыеЗаписиПрисутствуют 	= Ложь;
	ПоследниеЗаписиПрисутствуют = Ложь;
	ПоследниеДанныеПолучены 	= Истина;
	ПервыеДанныеПолучены 		= Истина;
	ОписаниеОшибкиПервый 		= "";
	ОписаниеОшибкиПоследний		= "";
	
	ПервыеЗаписи         = "";
	ПоследниеЗаписи      = "";
	
	// Получим первые записи истории звонков с АТС.	
	Ресурс = Вычислить("ПолучитьРесурс"+ТипПроверки+"(1,0,"+ПараметрыАТС.Получить("id_pbx")+","+""""+ПараметрыАТС.Получить("Ресурс"+ТипПроверки+"")+""""+")");	
   	ДокументDOM_Первый = ОтправитьДляОбработкиНаАТС(Ресурс,,ПараметрыАТС,,ОписаниеОшибкиПервый);
	
	Если Найти(ДокументDOM_Первый, "Ошибка подключения к АТС")>0 Тогда
		Сообщить(ДокументDOM_Первый);
		Возврат;
	КонецЕсли; 
	
	ДанныеСтроки = РазобратьОтветСервераCDR_CEL(ДокументDOM_Первый, ТипПроверки);
	Если ЗначениеЗаполнено(ДанныеСтроки.AcctId) Тогда
		ПервыеЗаписиПрисутствуют = ПроверитьНаличиеЗаписиВРегистре(ДанныеСтроки, ТипПроверки, ПараметрыАТС.Получить("id_pbx"));
		
		Если ПервыеЗаписиПрисутствуют Тогда
			Если ТипПроверки = "CDR" Тогда	
				ПервыеЗаписи = "Первые данные совпадают: 
				 | ActId = "+ДанныеСтроки.AcctId+"
				 | Start = "+ДанныеСтроки.Start+"
				 | End = "+ДанныеСтроки.End+"";
			 Иначе
				 ПервыеЗаписи = "Первые данные совпадают: 
				 | ActId = "+ДанныеСтроки.AcctId+"
				 | eventtime = "+ДанныеСтроки.eventtime+"";
			
			 КонецЕсли; 
		Иначе
			 Если ТипПроверки = "CDR" Тогда	
				ПервыеЗаписи = ""+ Символы.ПС + "Первые данные проверочной ссылки: 
				 | ActId = "+ДанныеСтроки.AcctId+"
				 | Start = "+ДанныеСтроки.Start+"
				 | End = "+ДанныеСтроки.End+"";
				 
				ПерваяЗаписьВРегистре = ПолучитьПакетРегистраСведений(0,ТипПроверки, ПараметрыАТС.Получить("id_pbx"));
				ПерваяЗаписьВРегистре = СтрЗаменить(ПерваяЗаписьВРегистре,"@", Символы.ПС);
				
				ПервыеЗаписи = ПервыеЗаписи + Символы.ПС + "Первые данные регистра сведений: 
				 | ActId    = "+СтрПолучитьСтроку(ПерваяЗаписьВРегистре,1)+"
				 | UID      = "+СтрПолучитьСтроку(ПерваяЗаписьВРегистре,2)+"
				 | Start    = "+СтрПолучитьСтроку(ПерваяЗаписьВРегистре,3)+"
				 | End      = "+СтрПолучитьСтроку(ПерваяЗаписьВРегистре,4)+"
				 | linkedid = "+СтрПолучитьСтроку(ПерваяЗаписьВРегистре,5)+"";
				 
			 Иначе
				 ПервыеЗаписи = ""+ Символы.ПС +"Первые данные проверочной ссылки: 
				 | ActId     = "+ДанныеСтроки.AcctId+"
				 | eventtime = "+ДанныеСтроки.eventtime+"";
				 
				ПерваяЗаписьВРегистре = ПолучитьПакетРегистраСведений(0,ТипПроверки, ПараметрыАТС.Получить("id_pbx"));
				ПерваяЗаписьВРегистре = СтрЗаменить(ПерваяЗаписьВРегистре,"@", Символы.ПС);
				
				ПервыеЗаписи = ПервыеЗаписи + Символы.ПС +"Первые данные регистра сведений: 
				 | ActId     = "+СтрПолучитьСтроку(ПерваяЗаписьВРегистре,1)+"
				 | UID       = "+СтрПолучитьСтроку(ПерваяЗаписьВРегистре,2)+"
				 | eventtime = "+СтрПолучитьСтроку(ПерваяЗаписьВРегистре,3)+"";
			
			 КонецЕсли; 		
		КонецЕсли; 

	Иначе
		ПервыеДанныеПолучены 	= Ложь;
	КонецЕсли; 	
	
	// Получим последние записи истории звонков с АТС.
	Ресурс = Вычислить("ПолучитьРесурс"+ТипПроверки+"(10, Неопределено, "+ПараметрыАТС.Получить("id_pbx")+","+""""+ПараметрыАТС.Получить("Ресурс"+ТипПроверки+"")+""""+",-1)");	
   	ДокументDOM = ОтправитьДляОбработкиНаАТС(Ресурс,,ПараметрыАТС,, ОписаниеОшибкиПоследний);
	ДанныеСтроки = РазобратьОтветСервераCDR_CEL(ДокументDOM, ТипПроверки);
	Если ЗначениеЗаполнено(ДанныеСтроки.AcctId) Тогда
		ПоследниеЗаписиПрисутствуют = ПроверитьНаличиеЗаписиВРегистре(ДанныеСтроки, ТипПроверки, ПараметрыАТС.Получить("id_pbx"));	
		
		Если ПоследниеЗаписиПрисутствуют Тогда
			Если ТипПроверки = "CDR" Тогда	
				ПоследниеЗаписи = "Последние данные совпадают: 
				 | ActId = "+ДанныеСтроки.AcctId+"
				 | Start = "+ДанныеСтроки.Start+"
				 | End = "+ДанныеСтроки.End+"";
			 Иначе
				 ПоследниеЗаписи = "Последние данные совпадают: 
				 | ActId = "+ДанныеСтроки.AcctId+"
				 | eventtime = "+ДанныеСтроки.eventtime+"";
			
			 КонецЕсли; 
		Иначе
			 Если ТипПроверки = "CDR" Тогда	
				ПоследниеЗаписи = ""+ Символы.ПС +"Последние данные проверочной ссылки: 
				 | ActId = "+ДанныеСтроки.AcctId+"
				 | Start = "+ДанныеСтроки.Start+"
				 | End = "+ДанныеСтроки.End+"";
				 
				ПоследняяЗаписьВРегистре = ПолучитьПакетРегистраСведений(1,ТипПроверки, ПараметрыАТС.Получить("id_pbx"));
				ПоследняяЗаписьВРегистре = СтрЗаменить(ПоследняяЗаписьВРегистре,"@", Символы.ПС);
				
				ПоследниеЗаписи = ПоследниеЗаписи + Символы.ПС + "Последние данные регистра сведений: 
				 | ActId    = "+СтрПолучитьСтроку(ПоследняяЗаписьВРегистре,1)+"
				 | UID      = "+СтрПолучитьСтроку(ПоследняяЗаписьВРегистре,2)+"
				 | Start    = "+СтрПолучитьСтроку(ПоследняяЗаписьВРегистре,3)+"
				 | End      = "+СтрПолучитьСтроку(ПоследняяЗаписьВРегистре,4)+"
				 | linkedid = "+СтрПолучитьСтроку(ПоследняяЗаписьВРегистре,5)+"";
				 
			 Иначе
				 ПоследниеЗаписи = ""+ Символы.ПС + "Последние данные проверочной ссылки: 
				 | ActId     = "+ДанныеСтроки.AcctId+"
				 | eventtime = "+ДанныеСтроки.eventtime+"";
				 
				ПоследняяЗаписьВРегистре = ПолучитьПакетРегистраСведений(1,ТипПроверки, ПараметрыАТС.Получить("id_pbx"));
				ПоследняяЗаписьВРегистре = СтрЗаменить(ПоследняяЗаписьВРегистре,"@", Символы.ПС);
				
				ПоследниеЗаписи = ПоследниеЗаписи + Символы.ПС + "Последние данные регистра сведений: 
				 | ActId     = "+СтрПолучитьСтроку(ПоследняяЗаписьВРегистре,1)+"
				 | UID       = "+СтрПолучитьСтроку(ПоследняяЗаписьВРегистре,2)+"
				 | eventtime = "+СтрПолучитьСтроку(ПоследняяЗаписьВРегистре,3)+"";
			
			 КонецЕсли; 		
		КонецЕсли; 
					
	Иначе
		ПоследниеДанныеПолучены 	= Ложь;
	КонецЕсли;
	
	
	Если ПервыеЗаписиПрисутствуют Тогда
		ПервыйПакетДанных = "Ошибок не обнаружено. История успешно загружается. " + ПервыеЗаписи;
	Иначе
		Если ПоследниеЗаписиПрисутствуют = Истина Тогда
			// Ранее была начата загрузка с начала.
			ПервыйПакетДанных = "Ошибок не обнаружено. История"+ ТипПроверки +" успешно загружается. "+ ПервыеЗаписи;
		Иначе
			// Вероятно следует начать загрузку данных с начала
			ПервыйПакетДанных = "История по "+ ТипПроверки +" НЕ совпадает. Первые записи не совпадают. "+ ПервыеЗаписи;
		КонецЕсли;
	КонецЕсли;
	
	Если ПервыеДанныеПолучены = Ложь Тогда
		// Проблемы с доступом к АТС.
		ПервыйПакетДанных = "Данные с АТС НЕ получены. Проблемы с доступом к АТС. Описание ошибки: " + ОписаниеОшибкиПервый;
	КонецЕсли;	
	
	Если ПоследниеЗаписиПрисутствуют Тогда
		ПоследнийПакетДанных = "Ошибок не обнаружено. История успешно загружается. " + ПоследниеЗаписи;
	Иначе
		ПоследнийПакетДанных = "История по "+ ТипПроверки +" НЕ совпадает. Последние записи не совпадают. "+ ПоследниеЗаписи;
	КонецЕсли;
	
	Если ПоследниеДанныеПолучены = Ложь Тогда
		// Проблемы с доступом к АТС.               
		ПоследнийПакетДанных = "Данные с АТС НЕ получены. Проблемы с достпом к АТС. Описание ошибки: " + ОписаниеОшибкиПоследний;
	КонецЕсли;
	
	
КонецПроцедуры // ВыполнитьПроверкуСервер()
 
&НаСервере
// ИндексПакета = 0 - первый пакет, ина че последний пакет
Функция ПолучитьПакетРегистраСведений(ИндексПакета, ТипПроверки = "CDR", id_pbx)
	
	Запрос = Новый Запрос;
	Если ТипПроверки = "CDR" Тогда					   
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	МИКО_ИсторияЗвонков.AcctId КАК AcctId
		               |ПОМЕСТИТЬ МаксAcctId
		               |ИЗ
		               |	РегистрСведений.МИКО_стИсторияЗвонковCDR КАК МИКО_ИсторияЗвонков
		               |ГДЕ
		               |	МИКО_ИсторияЗвонков.AcctId > 0
		               |	И МИКО_ИсторияЗвонков.id_pbx = &id_pbx
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	МИКО_ИсторияЗвонков.calldate УБЫВ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ ПЕРВЫЕ 1
		               |	МИКО_ИсторияЗвонков.AcctId КАК AcctId
		               |ПОМЕСТИТЬ МинAcctId
		               |ИЗ
		               |	РегистрСведений.МИКО_стИсторияЗвонковCDR КАК МИКО_ИсторияЗвонков
		               |ГДЕ
		               |	МИКО_ИсторияЗвонков.AcctId > 0
		               |	И МИКО_ИсторияЗвонков.id_pbx = &id_pbx
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	МИКО_ИсторияЗвонков.calldate
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	МИКО_стИсторияЗвонковCDR.UID,
		               |	МИКО_стИсторияЗвонковCDR.start,
		               |	МИКО_стИсторияЗвонковCDR.end,
		               |	МИКО_стИсторияЗвонковCDR.linkedid,
		               |	МаксAcctId.AcctId КАК МаксAcctId,
		               |	МинAcctId.AcctId КАК МинAcctId,
		               |	МИКО_стИсторияЗвонковCDR.AcctId
		               |ИЗ
		               |	РегистрСведений.МИКО_стИсторияЗвонковCDR КАК МИКО_стИсторияЗвонковCDR
		               |		ЛЕВОЕ СОЕДИНЕНИЕ МаксAcctId КАК МаксAcctId
		               |		ПО (ИСТИНА),
		               |	МинAcctId КАК МинAcctId
		               |ГДЕ
		               |	ВЫБОР
		               |			КОГДА &ИндексПакета = 0
		               |				ТОГДА МИКО_стИсторияЗвонковCDR.AcctId = МинAcctId.AcctId
		               |			ИНАЧЕ МИКО_стИсторияЗвонковCDR.AcctId = МаксAcctId.AcctId
		               |		КОНЕЦ
		               |	И МИКО_стИсторияЗвонковCDR.id_pbx = &id_pbx";

		Запрос.УстановитьПараметр("id_pbx", id_pbx);
		Запрос.УстановитьПараметр("ИндексПакета", ИндексПакета);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПакетРегистраСведений = ""+Выборка.AcctId+"@"+Выборка.UID+"@"+Выборка.start+"@"+Выборка.end+"@"+Выборка.linkedid;
		КонецЦикла; 
	Иначе	
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	МИКО_ИсторияЗвонков.AcctId КАК AcctId
		               |ПОМЕСТИТЬ МаксAcctId
		               |ИЗ
		               |	РегистрСведений.МИКО_стИсторияЗвонковCEL КАК МИКО_ИсторияЗвонков
		               |ГДЕ
		               |	МИКО_ИсторияЗвонков.AcctId > 0
		               |	И МИКО_ИсторияЗвонков.id_pbx = &id_pbx
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	МИКО_ИсторияЗвонков.eventtime УБЫВ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ ПЕРВЫЕ 1
		               |	МИКО_ИсторияЗвонков.AcctId КАК AcctId
		               |ПОМЕСТИТЬ МинAcctId
		               |ИЗ
		               |	РегистрСведений.МИКО_стИсторияЗвонковCEL КАК МИКО_ИсторияЗвонков
		               |ГДЕ
		               |	МИКО_ИсторияЗвонков.AcctId > 0
		               |	И МИКО_ИсторияЗвонков.id_pbx = &id_pbx
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	МИКО_ИсторияЗвонков.eventtime
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	МИКО_стИсторияЗвонковCEL.UID,
		               |	МИКО_стИсторияЗвонковCEL.eventtime,
		               |	МаксAcctId.AcctId КАК МаксAcctId,
		               |	МинAcctId.AcctId КАК МинAcctId,
		               |	МИКО_стИсторияЗвонковCEL.AcctId
		               |ИЗ
		               |	РегистрСведений.МИКО_стИсторияЗвонковCEL КАК МИКО_стИсторияЗвонковCEL
		               |		ЛЕВОЕ СОЕДИНЕНИЕ МаксAcctId КАК МаксAcctId
		               |		ПО (ИСТИНА),
		               |	МинAcctId КАК МинAcctId
		               |ГДЕ
		               |	ВЫБОР
		               |			КОГДА &ИндексПакета = 0
		               |				ТОГДА МИКО_стИсторияЗвонковCEL.AcctId = МинAcctId.AcctId
		               |			ИНАЧЕ МИКО_стИсторияЗвонковCEL.AcctId = МаксAcctId.AcctId
		               |		КОНЕЦ
		               |	И МИКО_стИсторияЗвонковCEL.id_pbx = &id_pbx";

		Запрос.УстановитьПараметр("id_pbx", id_pbx);			   
		Запрос.УстановитьПараметр("ИндексПакета", ИндексПакета);
	    Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПакетРегистраСведений = ""+Выборка.AcctId+"@"+Выборка.UID+"@"+Выборка.eventtime;
		КонецЦикла;
	КонецЕсли; 
	
	Возврат ПакетРегистраСведений;

КонецФункции // ПолучитьПакетРегистраСведений()

&НаСервере
Функция ПроверитьНаличиеЗаписиВРегистре(ДанныеСтроки, ТипПроверки = "CDR", id_pbx)

	Запрос = Новый Запрос;
	Если ТипПроверки = "CDR" Тогда
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	МИКО_ИсторияЗвонков.AcctId КАК AcctId
		               |ИЗ
		               |	РегистрСведений.МИКО_стИсторияЗвонковCDR КАК МИКО_ИсторияЗвонков
		               |ГДЕ
		               |	МИКО_ИсторияЗвонков.AcctId > 0
		               |	И МИКО_ИсторияЗвонков.AcctId = &acctid
		               |	И МИКО_ИсторияЗвонков.start = &start
		               |	И МИКО_ИсторияЗвонков.end = &end
		               |	И МИКО_ИсторияЗвонков.id_pbx = &id_pbx
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	AcctId";
		Запрос.УстановитьПараметр("acctid", Число(ДанныеСтроки.AcctId));	
		Запрос.УстановитьПараметр("start", 	ДанныеСтроки.start);	
		Запрос.УстановитьПараметр("end", 	ДанныеСтроки.end);	
		Запрос.УстановитьПараметр("id_pbx", id_pbx);	
		
	Иначе	
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	МИКО_ИсторияЗвонков.AcctId КАК AcctId
		               |ИЗ
		               |	РегистрСведений.МИКО_стИсторияЗвонковCEL КАК МИКО_ИсторияЗвонков
		               |ГДЕ
		               |	МИКО_ИсторияЗвонков.AcctId > 0
		               |	И МИКО_ИсторияЗвонков.AcctId = &acctid
		               |	И МИКО_ИсторияЗвонков.eventtime = &eventtime
		               |	И МИКО_ИсторияЗвонков.id_pbx = &id_pbx
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	AcctId";
		Запрос.УстановитьПараметр("acctid", Число(ДанныеСтроки.AcctId));	
		Запрос.УстановитьПараметр("eventtime", 	ДанныеСтроки.eventtime);
		Запрос.УстановитьПараметр("id_pbx", id_pbx);
	КонецЕсли; 
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции // ПроверитьНаличиеЗаписиВРегистре()
 
// Синхронизация таблицы CDR.
// 
Функция ПолучитьРесурсCDR(limit=450, offset=Неопределено, id_pbx, РесурсCDR, Сдвиг=0)
	
	Если НЕ ТипЗнч(offset) = Тип("Число") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	МИКО_ИсторияЗвонков.AcctId КАК AcctId
		               |ИЗ
		               |	РегистрСведений.МИКО_стИсторияЗвонковCDR КАК МИКО_ИсторияЗвонков
		               |ГДЕ
		               |	МИКО_ИсторияЗвонков.AcctId > 0
		               |	И МИКО_ИсторияЗвонков.id_pbx = &id_pbx
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	AcctId УБЫВ";
		
		Запрос.УстановитьПараметр("id_pbx", id_pbx);			   
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ПоследнийПолученныйПакет = Выборка.AcctId;
		КонецЕсли;
		ПоследнийПолученныйПакет = ?(ЗначениеЗаполнено(ПоследнийПолученныйПакет),ПоследнийПолученныйПакет + Сдвиг,0); 
	Иначе
		ПоследнийПолученныйПакет = offset;
	КонецЕсли; 
	
	РесурсНаСервере=""+РесурсCDR+"?limit="+limit+"&offset="+Формат(ПоследнийПолученныйПакет,"ЧН=0; ЧГ=");
	
	Возврат РесурсНаСервере;
	
КонецФункции

