// Отправка запроса на сервер, получение ответа
//
// ХостAsterisk = "sip.asterisk.ru"; 
// ПортСервера = 23600;
// ПользовательСтатистики = "statistic"; 
// ПарольПользователяСтатистики = "863****6";
Функция ОтправитьДляОбработкиНаАТС(РесурсНаСервере, КакТекст=Ложь, ПараметрыАТС, ПортСервера=0, ОписаниеОшибкиПоследний="")
	ДокументDOM = Неопределено;
	
	Если ПараметрыАТС = Неопределено Тогда
		ХостAsterisk 				= ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.АдресСервера(); 
		ПортСервера 				= ?(ПортСервера=0, ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПортСервера(), ПортСервера);
		ПользовательСтатистики 		= ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПользовательСтатистики(); 
		ПарольПользователяСтатистики= ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.Пароль();
		Таймаут 					= ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ВремяОжиданияОтвета();
	Иначе
		ХостAsterisk 				= ПараметрыАТС.Получить("АдресСервера"); 
		ПортСервера 				= ?(ПортСервера=0, ПараметрыАТС.Получить("ПортСервера"), ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ПортСервера());
		ПользовательСтатистики 		= ПараметрыАТС.Получить("Логин");
		ПарольПользователяСтатистики= ПараметрыАТС.Получить("Пароль");
		Таймаут 					= ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.ВремяОжиданияОтвета();
	КонецЕсли; 
	
	Попытка
		HTTPЗапрос = Новый HTTPЗапрос(РесурсНаСервере);
		HTTP = Новый HTTPСоединение(ХостAsterisk,ПортСервера,ПользовательСтатистики,ПарольПользователяСтатистики,,Таймаут);
		ОтветСервера = HTTP.Получить(HTTPЗапрос);
	Исключение
		ОписаниеОшибкиПоследний = "Ошибка подключения к АТС. Нет доступа" + ОписаниеОшибки();
		Возврат ОписаниеОшибкиПоследний;
	КонецПопытки; 	
	
	Если ОтветСервера.КодСостояния = 302 Тогда
	// Это переадресация на другой ресурс, чаще на https.
		Location 	= ОтветСервера.Заголовки.Получить("Location");
		врДанныеURL = МИКО_стОбщегоНазначения.мвРазложитьСтрокуВМассив(Location, "/");
		Если врДанныеURL.Количество()>=2 Тогда
			врСокет    	   = МИКО_стОбщегоНазначения.мвРазложитьСтрокуВМассив(врДанныеURL[1], ":");
			врХостAsterisk = ?(врСокет.Количество()>0,врСокет[0], ХостAsterisk);
			
			ПортПоУмолчанию = 80;
			ЗащищенноеСоединение= Неопределено;
			Если Найти(НРег(врДанныеURL[0]), "http:")=0 Тогда
			 	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
				ПортПоУмолчанию = 443;
			КонецЕсли; 
			врПортСервера  = ?(врСокет.Количество()>1,врСокет[1], ПортПоУмолчанию);
			
			// Вычисляем ресурс
			врАдресСервера = Прав(Location, СтрДлина(Location) - (Найти(Location, врДанныеURL[1]) + СтрДлина(врДанныеURL[1]) - 1) );
			
			Попытка
				HTTP = Новый HTTPСоединение(врХостAsterisk, врПортСервера,ПользовательСтатистики,ПарольПользователяСтатистики,,Таймаут, ЗащищенноеСоединение);
				HTTPЗапрос = Новый HTTPЗапрос(врАдресСервера);
				ОтветСервера = HTTP.Получить(HTTPЗапрос);
			Исключение
				ОписаниеОшибкиПоследний = "Ошибка подключения к АТС. Нет доступа" + ОписаниеОшибки();
				Возврат ОписаниеОшибкиПоследний;
			КонецПопытки; 
		КонецЕсли; 
	КонецЕсли; 
	
	Если НЕ ОтветСервера.КодСостояния = 200 Тогда
		СообщениеHTTP = "Ошибка подключения к АТС: """ + ХостAsterisk + """. "+ Символы.ПС +
						"Код состояния HTTP " + Формат(ОтветСервера.КодСостояния, "ЧРГ=; ЧН=0; ЧГ=")+".";
		ОписаниеОшибкиПоследний = СообщениеHTTP;				
		Возврат СообщениеHTTP;
	КонецЕсли; 
	
	ТекстДокумента = ОтветСервера.ПолучитьТелоКакСтроку();
	Если КакТекст=Истина Тогда
	 	Возврат ТекстДокумента;
	КонецЕсли; 	
	// 3. Разбор ответа
	ЧтениеHTML 	 	= Новый ЧтениеHTML;	
	ПостроительDOM 	= Новый ПостроительDOM; 
	ЧтениеHTML.УстановитьСтроку(ТекстДокумента);
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеHTML);
	
	Возврат ДокументDOM;
КонецФункции

&НаСервере
Функция РазобратьОтветСервераCDR_CEL(ДокументDOM, ТипПроверки = "CDR")

	ScrptCtrl = Неопределено; Это83 = Неопределено;
	Если ТипПроверки = "CDR" Тогда
		ДанныеСтроки = Новый Структура("acctid,start,end");
		СтрокаОтвета = ДокументDOM.ПолучитьЭлементыПоИмени("cdr-row");
		Для каждого СтрокаCDR  Из СтрокаОтвета Цикл
			
			Для каждого Атрибут Из СтрокаCDR.Атрибуты Цикл
			
				Параметр = НРег(Атрибут.Имя);                     
				Значение = Атрибут.Значение;
				
				Значение = МИКО_стСлужебный.URLDecode(Атрибут.Значение, ScrptCtrl, Это83);
				Если Параметр="id" ИЛИ Параметр="acctid" Тогда
					Параметр = "acctid";
					ДанныеСтроки["acctid"] = Значение;
				КонецЕсли;
				
				Если Параметр="end" ИЛИ Параметр="start" Тогда
					Значение = МИКО_опЗаписьКИ.ПреобразоватьВДату(Значение);
					ДанныеСтроки[Параметр] = Значение;
				КонецЕсли;

			КонецЦикла; 

		КонецЦикла;
	Иначе
		ДанныеСтроки = Новый Структура("acctid,eventtime");
		СтрокаОтвета = ДокументDOM.ПолучитьЭлементыПоИмени("cel-row");
		Для каждого СтрокаCDR  Из СтрокаОтвета Цикл
			
			Для каждого Атрибут Из СтрокаCDR.Атрибуты Цикл
			
				Параметр = НРег(Атрибут.Имя);                     
				Значение = Атрибут.Значение;
				
				Значение = МИКО_стСлужебный.URLDecode(Атрибут.Значение, ScrptCtrl, Это83);
				Если Параметр="id" ИЛИ Параметр="acctid" Тогда
					Параметр = "acctid";
					ДанныеСтроки["acctid"] = Значение;
				КонецЕсли;
				
				Если Параметр="eventtime" Тогда
					Значение = МИКО_опЗаписьКИ.ПреобразоватьВДату(Значение);
					ДанныеСтроки[Параметр] = Значение;
				КонецЕсли;

			КонецЦикла; 
		КонецЦикла; 
	КонецЕсли; 
	
    Возврат ДанныеСтроки;
КонецФункции // РазобратьОтветСервераCDR()
