Функция ШаблонСМСВТекст(ВыбТекст,ЗаказПокупателя)  Экспорт
	
	ВыбТекст = СтрЗаменить(ВыбТекст, "[НомерТТН]", ЗаказПокупателя.НомерТТН);
	
	ВыбТекст = СтрЗаменить(ВыбТекст, "[СкладНовойПочты]", ЗаказПокупателя.СкладНовойПочтыЗначение.Наименование);
			
	ВыбТекст = СтрЗаменить(ВыбТекст, "[Сумма]", Формат(ЗаказПокупателя.Товары.Итог("Сумма")+ЗаказПокупателя.Услуги.Итог("Сумма"), "ЧДЦ=0"));
	
	ВыбТекст = СтрЗаменить(ВыбТекст,"[ДатаДоставки]",Формат(ЗаказПокупателя.ДатаДоставки,"ДФ=dd.MM.yyyy"));
	ВыбТекст = СтрЗаменить(ВыбТекст,"[НомерЗаказа2]",СокрЛП(ЗаказПокупателя.НомерЗаказа2ССайта));
	ВыбТекст = СтрЗаменить(ВыбТекст,"[Получатель]",СокрЛП(ЗаказПокупателя.Получатель));

	Если ЗначениеЗаполнено(ЗаказПокупателя.СуммаНоваяПочта) <> 0 Тогда
	   ВыбТекст = СтрЗаменить(ВыбТекст, "[Наложка]", "Післяплата " + Формат(ЗаказПокупателя.СуммаНоваяПочта, "ЧДЦ=0") + " Грн");
   	Иначе
	   ВыбТекст = СтрЗаменить(ВыбТекст, "[Наложка]","");
   	КонецЕсли;
   
	Если ЗначениеЗаполнено(ЗаказПокупателя.НомерЗаказа2ССайта) Тогда 	
		ВыбТекст = СтрЗаменить(ВыбТекст,"[НомерЗаказа]",СокрЛП(ЗаказПокупателя.НомерЗаказа2ССайта));
	Иначе	                                           
		ВыбТекст = СтрЗаменить(ВыбТекст,"[НомерЗаказа]",УбратьНоликиСлева(ЗаказПокупателя.Номер));
	КонецЕсли;

	Возврат ВыбТекст;	
КонецФункции

Функция УбратьНоликиСлева(СтрокаСНоликами) Экспорт 
	Ф=0;  НоваяСтрока = "";
	Для Сч = 1 По СтрДлина(СтрокаСНоликами) Цикл 
		Символ = Сред(СтрокаСНоликами,Сч,1);
		Если  НЕ Символ = "0" и Ф=0 Тогда
			//первый ненулевой символ
			Ф=1
		КонецЕсли;
		Если Ф=1 Тогда
			//дальше берем все и нолики тоже
			НоваяСтрока = НоваяСтрока+Символ
		КонецЕсли;
	КонецЦикла;
	Возврат НоваяСтрока
КонецФункции

Функция ДополнитьНомерНулями(СтрокаНомера,ДлинаНомера)     Экспорт
 Номер = "";
 Для Сч = 1 По СтрДлина(СтрокаНомера) Цикл
	Симв = Сред(СтрокаНомера,Сч,1); 
	Если Симв <> " " Тогда  //уберем разделитель триад
		Номер = Номер+Симв;
	КонецЕсли;
КонецЦикла;
Для Сч = 1 По ДлинаНомера-СтрДлина(Номер) Цикл
	 Номер = "0"+Номер;
КонецЦикла;
Возврат Номер
КонецФункции

