Функция base64_encode(Стр) Экспорт 
	
	ИмяФайла = "sms.txt"; 
	КаталогВременныхФайлов = КаталогВременныхФайлов();

	
	ФайлSMS = Новый ЗаписьТекста(КаталогВременныхФайлов+ИмяФайла, КодировкаТекста.ANSI);
	ФайлSMS.Записать(СокрЛП(Стр));
	ФайлSMS.Закрыть();

	ФайлДвоичныеДанные = Новый ДвоичныеДанные(КаталогВременныхФайлов+ИмяФайла);
	Возврат Base64Строка(ФайлДвоичныеДанные);
		
КонецФункции

Функция ДатаISO8601(Д) Экспорт 
	Возврат "" + Формат(Год(Д), "ЧГ=0") + "-" + Формат(Месяц(Д), "ЧЦ=2; ЧВН=") + "-" + Формат(День(Д), "ЧЦ=2; ЧВН=") + "T" + 
			Формат(Час(Д), "ЧЦ=2; ЧВН=") + ":" + Формат(Минута(Д), "ЧЦ=2; ЧВН=") + ":" + Формат(Секунда(Д), "ЧЦ=2; ЧВН=") + "+0200";
КонецФункции
		
Процедура ЗапросHTTP(СтрокаПолучения, Сервер, ИмяВходящегоФайла, Текст, ВыбНомер) Экспорт
	Попытка
		Соединение = Новый HTTPСоединение(Сервер,,,);
		Соединение.Получить(СтрокаПолучения, ИмяВходящегоФайла,);
		ВходящийФайл = Новый Файл(ИмяВходящегоФайла);
		Если НЕ ВходящийФайл.Существует() Тогда
			Сообщить("Не удалось получить ответ с сервера"); 
			Возврат;
		КонецЕсли;
		Сообщить("SMS отправлена.");
		Возврат;
		ВыбСтатус = "";
		Текст.Прочитать(ИмяВходящегоФайла, КодировкаТекста.UTF8);
		КолСтрок = Текст.КоличествоСтрок();
		Для Инд = 1 По КолСтрок Цикл
			Стр = Текст.ПолучитьСтроку(Инд);
			ВыбСтатус = ВыбСтатус + Стр + Символы.ПС;
			Сообщить(Стр);
			Если Лев(Стр, 8) = "balance:" Тогда
				Стр = СтрЗаменить(Стр, "balance:", "");
				ВыбБаланс = Число(Стр);
			ИначеЕсли Лев(Стр, 3) = "id:" Тогда
				Стр = СтрЗаменить(Стр, "id:", "");
				ВыбID = Число(Стр);
			ИначеЕсли Лев(Стр, 5) = "code:" Тогда
			КонецЕсли;
		КонецЦикла;
	Исключение
		Сообщить("Помилка: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция ПолучитьНомерТелефонаКонтрагента(Контрагент) Экспорт 
	
	МенеджерЗаписи = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Контрагент;
	МенеджерЗаписи.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
	МенеджерЗаписи.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
	МенеджерЗаписи.Прочитать();
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТекТелефонКонтрагента = МенеджерЗаписи.Представление;
	ТекТелефонКонтрагента = ФормированиеПечатныхФорм.ПолучитьТелефонДляНалоговойНакладной(ТекТелефонКонтрагента);
	
	Возврат ТекТелефонКонтрагента;
	
КонецФункции

Функция ПроверитьНомерТТН(Знач НомерДокумента)
	
	Если ПустаяСтрока(НомерДокумента) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Итератор = 0 По 9 Цикл
		НомерДокумента = СтрЗаменить(НомерДокумента,СокрЛП(Итератор),"");
	КонецЦикла;
	
	Возврат ПустаяСтрока(НомерДокумента);

КонецФункции

// Читает из регистра сведений "КонтактнаяИнформация" актуальное значение телефона
// того же вида, что используется как "ОсновнойКонтакт" контрагента (Вид = ТелефонКонтрагента).
// Возвращает пустую строку, если телефон в регистре не заполнен/удалён.
//
Функция ПолучитьАктуальныйОсновнойТелефонКонтрагента(Знач Контрагент) Экспорт

	МенеджерЗаписи = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Объект = Контрагент;
	МенеджерЗаписи.Тип    = Перечисления.ТипыКонтактнойИнформации.Телефон;
	МенеджерЗаписи.Вид    = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
	МенеджерЗаписи.Прочитать();

	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(МенеджерЗаписи.Представление);

КонецФункции

// Обработчик подписки на событие "ПриЗаписи" регистра сведений "КонтактнаяИнформация".
// Синхронизирует кэширующий реквизит Контрагенты.ОсновнойКонтакт с фактическим
// значением телефона в регистре — иначе при очистке/удалении телефона в карточке
// контрагента реквизит ОсновнойКонтакт остаётся заполнен старым (уже неактуальным) значением.
//
Процедура СинхронизироватьОсновнойКонтактКонтрагентаПриЗаписиКИ(Источник, Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Объект = Источник.Отбор.Объект.Значение;

	Если Не ЗначениеЗаполнено(Объект)
		Или ТипЗнч(Объект) <> Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат;
	КонецЕсли;

	АктуальныйТелефон = ПолучитьАктуальныйОсновнойТелефонКонтрагента(Объект);

	Если Объект.ОсновнойКонтакт = АктуальныйТелефон Тогда
		Возврат;
	КонецЕсли;

	КонтрагентОбъект = Объект.ПолучитьОбъект();
	КонтрагентОбъект.ОсновнойКонтакт = АктуальныйТелефон;
	КонтрагентОбъект.Записать();

КонецПроцедуры

// Разовая обработка: приводит реквизит Контрагенты.ОсновнойКонтакт в соответствие
// с фактическим содержимым регистра "КонтактнаяИнформация" для контрагентов, у которых
// телефон в карточке был очищен/удалён ДО появления подписки
// "СинхронизироватьОсновнойКонтактКонтрагентаПриЗаписиКИ".
// Запускать один раз через "Вычислить выражение" в отладчике Конфигуратора:
//   ОбщийМодульПодписокНаСобытия.ОчиститьНеактуальныеОсновныеКонтактыКонтрагентов()
//
Процедура ОчиститьНеактуальныеОсновныеКонтактыКонтрагентов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	ЗНАЧЕНИЕЗАПОЛНЕНО(Контрагенты.ОсновнойКонтакт)";

	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоИсправлено = 0;

	Пока Выборка.Следующий() Цикл

		АктуальныйТелефон = ПолучитьАктуальныйОсновнойТелефонКонтрагента(Выборка.Ссылка);

		Если Выборка.Ссылка.ОсновнойКонтакт = АктуальныйТелефон Тогда
			Продолжить;
		КонецЕсли;

		КонтрагентОбъект = Выборка.Ссылка.ПолучитьОбъект();
		КонтрагентОбъект.ОсновнойКонтакт = АктуальныйТелефон;
		КонтрагентОбъект.Записать();

		КоличествоИсправлено = КоличествоИсправлено + 1;

	КонецЦикла;

	Сообщить("Исправлено контрагентов: " + КоличествоИсправлено);

КонецПроцедуры

// Проверка: сверяет Контрагенты.ОсновнойКонтакт с фактическим телефоном в регистре
// "КонтактнаяИнформация" и выводит список расхождений (если есть).
// Ничего не изменяет — только диагностика.
// Вызывать через "Вычислить выражение" в отладчике Конфигуратора:
//   ОбщийМодульПодписокНаСобытия.ПроверитьОсновныеКонтактыКонтрагентов()
// Результат = 0 значит расхождений не осталось.
//
Функция ПроверитьОсновныеКонтактыКонтрагентов() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка КАК Контрагент,
	|	Контрагенты.ОсновнойКонтакт КАК ОсновнойКонтакт,
	|	ЕСТЬNULL(КонтактнаяИнформация.Представление, """") КАК ТелефонВРегистре
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|	ПО  КонтактнаяИнформация.Объект = Контрагенты.Ссылка
	|	И   КонтактнаяИнформация.Тип    = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|	И   КонтактнаяИнформация.Вид    = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)
	|ГДЕ
	|	ЗНАЧЕНИЕЗАПОЛНЕНО(Контрагенты.ОсновнойКонтакт)
	|	И Контрагенты.ОсновнойКонтакт <> ЕСТЬNULL(КонтактнаяИнформация.Представление, """")";

	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоРасхождений = 0;

	Пока Выборка.Следующий() Цикл

		КоличествоРасхождений = КоличествоРасхождений + 1;

		Сообщить(
			"Расхождение: " + Выборка.Контрагент
			+ " | ОсновнойКонтакт = '" + Выборка.ОсновнойКонтакт + "'"
			+ " | в регистре = '" + Выборка.ТелефонВРегистре + "'"
		);

	КонецЦикла;

	Если КоличествоРасхождений = 0 Тогда
		Сообщить("Расхождений не найдено, всё синхронизировано.");
	КонецЕсли;

	Возврат КоличествоРасхождений;

КонецФункции

// Запись в журнал регистрации ошибки, которая иначе подавляется блоком Исключение.
// ВАЖНО: намеренно не обращается к базе данных. После исключения внутри транзакции
// любое чтение из БД вызывает "В данной транзакции уже были ошибки", поэтому здесь
// нет ни представления ссылки, ни чтения реквизитов: только идентификатор заказа
// (не требует чтения) и текст ошибки.
// Логику заказа не меняет: существующее поведение обработчиков сохранено как было.
//
Процедура ЛогОшибкиСтатуса(Знач Заказ, Знач Событие, Знач ТекстОшибки)

	Попытка

		Идентификатор = "";
		Попытка
			Идентификатор = Строка(Заказ.Ссылка.УникальныйИдентификатор());
		Исключение
			// Идентификатор недоступен, пишем хотя бы текст ошибки.
		КонецПопытки;

		ЗаписьЖурналаРегистрации(
			"СтатусЗаказа." + Событие,
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЗаказПокупателя,
			,
			"Заказ (идентификатор): " + Идентификатор + "; ошибка: " + ТекстОшибки);

	Исключение
		// Диагностика не должна влиять на запись заказа.
	КонецПопытки;

КонецПроцедуры

// Диагностика подписки "ИзменениСтатусаЗаказа".
// Пишет в журнал регистрации факт срабатывания ветки обработчика.
// Логику заказа не меняет: нужна, чтобы по фактическим данным решить,
// какие настройки статуса реально работают, а какие нет.
// Смотреть: Журнал регистрации, отбор по событию, начинающемуся на "СтатусЗаказа."
//
Процедура ЛогСтатуса(Знач Заказ, Знач Событие, Знач Комментарий = "") Экспорт

	Попытка

		// Ссылка, а не объект: строковое преобразование объекта документа ненадёжно.
		ЗаказСсылка = Заказ.Ссылка;

		Текст = "Заказ: " + СокрЛП(ЗаказСсылка) + "; статус: " + СокрЛП(ЗаказСсылка.СтатусЗаказа);

		Если ЗначениеЗаполнено(Комментарий) Тогда
			Текст = Текст + "; " + СокрЛП(Комментарий);
		КонецЕсли;

		ЗаписьЖурналаРегистрации(
			"СтатусЗаказа." + Событие,
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.ЗаказПокупателя,
			ЗаказСсылка,
			Текст);

	Исключение
		// Диагностика не должна влиять на запись заказа.
	КонецПопытки;

КонецПроцедуры
