
Процедура ИзменениСтатусаЗаказаПриЗаписи(Источник, Отказ) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если Источник.ОбменДанными.Загрузка = Истина ИЛИ Не ЗначениеЗаполнено(Источник.СтатусЗаказа) Тогда
		Возврат;
	КонецЕсли;
		
	//возврат товаров
	Если Источник.СтатусЗаказа.ФормироватьВозвратТоваров И Источник.НеУчитыватьВОтчете = Ложь Тогда
		СоздатьВозвратТоваров(Источник.Ссылка);
	КонецЕсли;
	
	//вн перемещение
	Если Источник.СтатусЗаказа.ФормироватьВнПеремещение И ЗначениеЗаполнено(Источник.СтатусЗаказа.КассаВнПеремещения) Тогда
		СоздатьВнПеремещение(Источник.Ссылка);
	КонецЕсли;
	
	// ВНИМАНИЕ: флаг называется "Закрывать резерв", но здесь исторически вызывается
	// создание внутреннего перемещения (похоже на копипасту ветки выше), а обёртка
	// ЗакрытьРезерв() -> ЗакрытиеЗаказа() не вызывается ниоткуда.
	// Поведение НЕ меняем: только фиксируем факт срабатывания в журнале регистрации.
	Если Источник.СтатусЗаказа.ЗакрыватьРезерв  Тогда
		ЛогСтатуса(Источник, "ЗакрыватьРезерв_ВызовВнПеремещения");
		СоздатьВнПеремещение(Источник.Ссылка);
	КонецЕсли;

	
	ПоследнееЗначение = РегистрыСведений.ИсторияИзмененияСтатусовЗаказов.ПолучитьПоследнее(,Новый Структура("ЗаказПокупателя",Источник.Ссылка));
	Если ПоследнееЗначение.СтатусЗаказа <> Источник.СтатусЗаказа Тогда
		МенеджерЗаписи = РегистрыСведений.ИсторияИзмененияСтатусовЗаказов.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Период = ТекущаяДата();
		МенеджерЗаписи.ЗаказПокупателя = Источник.Ссылка;
		МенеджерЗаписи.СтатусЗаказа = Источник.СтатусЗаказа;
		МенеджерЗаписи.Записать();
		
		Если Источник.НеОтправлятьСообщение <> Истина
			 И (Источник.СтатусЗаказа.ОтправлятьСМСПриУстановке 
			 ИЛИ Источник.СтатусЗаказа.ОтправлятьСМСПоШаблону)
			 И Источник.СтатусЗаказа.ПредыдущиеСтатусыУсловиеОтправкиСМС.Найти(ПоследнееЗначение.СтатусЗаказа)<>Неопределено 
			Тогда
			ОтправкаСМСУведомленияПокупателю(Источник.Ссылка);
		КонецЕсли;
		
		Если Источник.ДополнительныеСвойства.Свойство("ЭтоНовый") И Источник.ДополнительныеСвойства.ЭтоНовый = Истина 
																	И Источник.СтатусЗаказа.ОтправлятьСМСПоШаблону Тогда  //СМС для Нового
			ОтправкаСМСУведомленияПокупателю(Источник.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	//Если НЕ Источник.ИзРеализации Тогда
	Заказ = Источник.Ссылка;
	СтатусЗаказаПоследний = РегистрыСведений.ИсторияИзмененияСтатусовЗаказов.ПолучитьПоследнее(,Новый Структура("ЗаказПокупателя",Заказ)).СтатусЗаказа;
	Если Источник.СтатусЗаказа.ФормироватьРеализацию И Источник.НеУчитыватьВОтчете = Ложь  Тогда
		Если НЕ РеализацияЕсть(Источник.Ссылка) Тогда
			РН = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
			РН.Заполнить(Источник.Ссылка);
			РН.Товары.Загрузить(Источник.Товары.Выгрузить());
			РН.ОтражатьВБухгалтерскомУчете = Ложь;
			РН.Дата = ТекущаяДата();
			Для каждого ТекСтрТЧ Из РН.Товары Цикл
				ТекСтрТЧ.ЗаказПокупателя = Источник.Ссылка;
				ТекСтрТЧ.СпособСписанияОстаткаТоваров = Перечисления.СпособыСписанияОстаткаТоваров.ИзРезерва;
			КонецЦикла;
			Попытка
				РН.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ЛогОшибкиСтатуса(Источник, "ИзменениСтатусаЗаказаПриЗаписи_РН", ОписаниеОшибки());
				РН.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				//РН.Записать(РежимЗаписиДокумента.Запись);
			КонецПопытки;
		КонецЕсли;
	Иначе
		
		Если Источник.ДополнительныеСвойства.Свойство("ОтменитьРеализацию") И Источник.ДополнительныеСвойства.ОтменитьРеализацию = Истина  Тогда
		
			Запрос = новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	РеализацияТоваровУслуг.Ссылка
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
			|ГДЕ
			|	РеализацияТоваровУслуг.Сделка = &Сделка И РеализацияТоваровУслуг.Проведен";
			Запрос.УстановитьПараметр("Сделка", Источник.Ссылка);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока выборка.Следующий() Цикл
				РН = выборка.Ссылка.Получитьобъект();
				РН.ПометкаУдаления = Истина;
				РН.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	
	//Открывать Маркет Плэйс

	РозницаПлатформа = Источник.МожноОткрытьМаркетПлэйст();
	Если Источник.СтатусЗаказа.ОткрыватьМаркетПлэйс И РозницаПлатформа
		И Источник.СтатусЗаказа = СтатусЗаказаПоследний Тогда
		// Ветка ниже практически недостижима: СтатусЗаказаПоследний читается уже ПОСЛЕ
		// записи истории статусов, поэтому всегда равен текущему статусу.
		// Логируем, чтобы подтвердить это по фактическим данным.
		// Просто "починить" условие нельзя: ОткрытьМаркетПлэйс() использует COMОбъект
		// и ЗапуститьПриложение, это клиентский код и на сервере он упадёт.
		ЛогСтатуса(Источник, "МаркетПлэйс_НеОткрыт", "текущий статус равен последнему в истории");
	КонецЕсли;

	Если Источник.СтатусЗаказа.ОткрыватьМаркетПлэйс И РозницаПлатформа И Источник.СтатусЗаказа <> СтатусЗаказаПоследний Тогда 
		Источник.ОткрытьМаркетПлэйс();	
		Сообщить("Нужно изменить статус заказа на маркетплэйс");			
	КонецЕсли;
				

	НайденПКО = НайтиПКО(Источник.Ссылка);
	НайденППО = НайтиППО(Источник.Ссылка);
    СуммаНоваяПочта = Источник.Ссылка.СуммаНоваяПочта; 
	Попытка 
		ЭтоОпт = Источник.ТипЦен.ПолучитьОбъект().ЭтоОптоваяЦена();
	Исключение  
		ЭтоОпт = Ложь;
	КонецПопытки; 
	
	Если Источник.Контрагент.ПолучитьОбъект().ЭтоОптовик() Тогда  
		 СуммаНоваяПочта = СуммаНоваяПочта - Источник.ДваПроцентаУслуга;
	КонецЕсли;
	
	ОстаткиРезервов = Документы.ЗаказПокупателя.РезервПоЗаказуОстаток(Источник.Ссылка);
		
	КонтрольОплаты = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000012");
	Наложка = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000009");

	
	//ПКО
	Если Источник.СтатусЗаказа.ФормироватьПКО И Источник.НеУчитыватьВОтчете = Ложь Тогда
		//Если НЕ ОплатаЕсть(Источник.Ссылка) Тогда

					
			ТипОбратнойДоставки = Источник.Ссылка.ТипОбратнойДоставки;		
						
			Если СуммаНоваяПочта <> 0 И  ЗначениеЗаполнено(ТипОбратнойДоставки) Тогда
				Если ТипОбратнойДоставки = Наложка Тогда 					
				
					Если ОстаткиРезервов.Количество() > 0 ИЛИ
						Источник.СтатусЗаказа.Наименование <> "Ожидает отправки" и Источник.НомерТТН = ""
						Тогда
						Если ЗначениеЗаполнено(НайденПКО) Тогда
							ПКО = НайденПКО.ПолучитьОбъект();
							ПКО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
							ПКО.ПометкаУдаления = Истина;
							ПКО.Записать();
						КонецЕсли;
						
						Сообщить("Есть не закрытый резерв Приходный ордер не создан или отмене");
						// Возврат ниже выходит из ВСЕГО обработчика, а не только из блока ПКО:
						// ФормироватьВозвратДенег в конце процедуры не выполнится.
						ЛогСтатуса(Источник, "ВыходИзОбработчика", "незакрытый резерв, ПКО (наложка); ФормироватьВозвратДенег пропущен");
						Возврат;
					КонецЕсли;
										
					Если ЗначениеЗаполнено(НайденПКО) Тогда
						
						ПКО = НайденПКО.ПолучитьОбъект();
						
						Если НЕ ПКО.проведен ИЛИ 
							 ПКО.СуммаДокумента <> СуммаНоваяПочта
							 Тогда                                        
							ПКО.ПометкаУдаления = Ложь;
							ПКО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
							ПКО.СуммаДокумента = СуммаНоваяПочта ;
							ПКО.РасшифровкаПлатежа[0].СуммаВзаиморасчетов = СуммаНоваяПочта;
							ПКО.РасшифровкаПлатежа[0].СуммаПлатежа = СуммаНоваяПочта;
							ПКО.Комментарий = "";

							Попытка
							ПКО.Записать(РежимЗаписиДокумента.Проведение);
							Исключение
							ЛогОшибкиСтатуса(Источник, "ИзменениСтатусаЗаказаПриЗаписи_ПКО", ОписаниеОшибки());
							ПКО.Записать(РежимЗаписиДокумента.Запись);
						КонецПопытки;
					КонецЕсли;
					Иначе
						ПКО = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();							
						ПКО.Дата = ТекущаяДата() + (60*60*24);
						Сум = СуммаНоваяПочта; // ; ?(,Источник.Ссылка.СуммаДокумента,Источник.Ссылка.СуммаНоваяПочта);
						ПКОСсылка = ПКО.НаОснованииЗаказаПокупателя(Источник.Ссылка,Сум,Источник.СтатусЗаказа.Касса);
					    ПКО.ДокументОснование = Источник;
						Попытка
						ПКО.Записать(РежимЗаписиДокумента.Проведение);
						Исключение
						ЛогОшибкиСтатуса(Источник, "ИзменениСтатусаЗаказаПриЗаписи_ПКО", ОписаниеОшибки());
						ПКО.Записать(РежимЗаписиДокумента.Запись);
						КонецПопытки;
					КонецЕсли;
					
				ИначеЕсли ТипОбратнойДоставки = КонтрольОплаты Тогда
					
					 Если ((ОстаткиРезервов.Количество() > 0 И Источник.СтатусЗаказа.Наименование <> "Завершенные") ИЛИ 		
						(Источник.СтатусЗаказа.Наименование <> "Ожидает отправки" и Источник.НомерТТН = "") ИЛИ 
						Не ЗначениеЗаполнено(Источник.БанковскийСчетКонтрольОплаты)) И НЕ Источник.СпособОтправки.Код = "000000006" 
						Тогда
						Если ЗначениеЗаполнено(НайденППО) Тогда
							ППО = НайденППО.ПолучитьОбъект();
							ППО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
							ППО.ПометкаУдаления = Истина;
							ППО.Комментарий = "Отмена 2  " + ТекущаяДата() + " " + ОстаткиРезервов.Количество() + " " + Источник.СтатусЗаказа.Наименование + " " + Источник.НомерТТН + " " + Источник.БанковскийСчетКонтрольОплаты;			

							ППО.Записать();
						КонецЕсли;
						
						Сообщить("Есть не закрытый резерв Платежное поручение входящее не создано или отменено");
						// Возврат ниже выходит из ВСЕГО обработчика, а не только из блока ППО:
						// ФормироватьВозвратДенег в конце процедуры не выполнится.
						ЛогСтатуса(Источник, "ВыходИзОбработчика", "незакрытый резерв, ППО (контроль оплаты); ФормироватьВозвратДенег пропущен");
						Возврат;
					КонецЕсли;	
					
					Если ЗначениеЗаполнено(НайденППО) Тогда
						
						ППО = НайденППО.ПолучитьОбъект();

						Если НЕ ППО.проведен ИЛИ 
							 ППО.СуммаДокумента <> СуммаНоваяПочта
							 Тогда
						
							ППО.ПометкаУдаления = Ложь;
							ППО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
							ППО.СуммаДокумента = СуммаНоваяПочта;
							ППО.РасшифровкаПлатежа[0].СуммаВзаиморасчетов =СуммаНоваяПочта;
							ППО.РасшифровкаПлатежа[0].СуммаПлатежа =СуммаНоваяПочта;
							ППО.Комментарий = "";
							Попытка
								ППО.Записать(РежимЗаписиДокумента.Проведение);
							Исключение
								ЛогОшибкиСтатуса(Источник, "ИзменениСтатусаЗаказаПриЗаписи_ППО", ОписаниеОшибки());
								ППО.Записать(РежимЗаписиДокумента.Запись);
							КонецПопытки;
						КонецЕсли;

					Иначе
						//ППО = Документы.ПлатежноеПоручениеВходящее.СоздатьДокумент();							
						//ППО.Дата = ТекущаяДата() + (60*60*24);
						
						Сум = СуммаНоваяПочта; // ; ?(,Источник.Ссылка.СуммаДокумента,Источник.Ссылка.СуммаНоваяПочта);

						ППО =Документы.ПлатежноеПоручениеВходящее.СоздатьДок(Источник.Ссылка,Сум,Источник.Ссылка.БанковскийСчетКонтрольОплаты);
	         		  	ППО.НазначениеПлатежа = "Наложка";
						//ПКОСсылка = ППО.НаОснованииЗаказаПокупателя(Источник.Ссылка,Сум,Источник.СтатусЗаказа.Касса)
						Попытка
						ППО.Записать(РежимЗаписиДокумента.Проведение);
						Исключение
						ЛогОшибкиСтатуса(Источник, "ИзменениСтатусаЗаказаПриЗаписи_ППО", ОписаниеОшибки());
						ППО.Записать(РежимЗаписиДокумента.Запись);
						КонецПопытки;
					КонецЕсли;
					
					
										
                   Если ЗначениеЗаполнено(НайденПКО) И НайденПКО.Проведен Тогда    
						
						Попытка
							
					//		Ответ = Вопрос("Найден ПКО. Отменить проведение документа?", РежимДиалогаВопрос.ДаНет);
					//
					//		Если Ответ = КодВозвратаДиалога.Да Тогда
						        ПКО = НайденПКО.ПолучитьОбъект();
                                ПКО.Комментарий = "Отменен так как есть платежное поручение";     
								ПКО.Записать(РежимЗаписиДокумента.ОтменаПроведения); 
							//КонецЕсли;
						
						Исключение 
							ЛогОшибкиСтатуса(Источник, "ИзменениСтатусаЗаказаПриЗаписи_ПКО_ПодавленнаяОшибка", ОписаниеОшибки());
						//	ЗаписьЖурналаРегистрации(ОписаниеОшибки() + " ПКО "  + НайденПКО.Номер, УровеньЖурналаРегистрации.Ошибка);	
						КонецПопытки;
		
					КонецЕсли;


					
					
					
					
					
					
					
				ИначеЕсли ЗначениеЗаполнено(НайденПКО) Тогда
					
					Если Источник.СтатусЗаказа.Наименование = "Ожидает отправки" Тогда
						ЛогСтатуса(Источник, "ВыходИзОбработчика", "статус 'Ожидает отправки', найден ПКО; ФормироватьВозвратДенег пропущен");
						Возврат;
					КонецЕсли;
					
					ПКО = НайденПКО.ПолучитьОбъект();
					ПКО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					ПКО.ПометкаУдаления = Истина;
					ПКО.Записать();
					Сообщить("Приходный кассовый документ отменен!!" + ПКО);
					
				ИначеЕсли ЗначениеЗаполнено(НайденППО) Тогда
					Если Источник.СтатусЗаказа.Наименование = "Ожидает отправки" Тогда
						ЛогСтатуса(Источник, "ВыходИзОбработчика", "статус 'Ожидает отправки', найдено ППО; ФормироватьВозвратДенег пропущен");
						Возврат;
					КонецЕсли;
					
					ППО = НайденППО.ПолучитьОбъект();
					ППО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					ППО.ПометкаУдаления = Истина;
					ППО.Комментарий = "Отмена 3";

					ППО.Записать();
					Сообщить("Платежное Поручение отменено!!" + ППО);		
				КонецЕсли;
			Иначе
			
				Если ЗначениеЗаполнено(НайденПКО) И
					 Источник.СтатусЗаказа.Наименование = "Ожидает отправки" 
				Тогда
					ПКО = НайденПКО.ПолучитьОбъект();
					ПКО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					ПКО.ПометкаУдаления = Истина;
					ПКО.Записать();
					Сообщить("Приходный кассовый документ отменен!!" + ПКО);
				ИначеЕсли ЗначениеЗаполнено(НайденППО) И
					 Источник.СтатусЗаказа.Наименование = "Ожидает отправки" Тогда
					 
					ППО = НайденППО.ПолучитьОбъект();
					ППО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
					ППО.ПометкаУдаления = Истина;
					ППО.Комментарий = "Отмена 4";

					ППО.Записать();
					Сообщить("Платежное Поручение отменено!!" + ППО);
					
				КонецЕсли;
			КонецЕсли;
				

			
	Иначе 
		Если ЗначениеЗаполнено(НайденПКО) Тогда
			ПКО = НайденПКО.ПолучитьОбъект();
			ПКО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			ПКО.ПометкаУдаления = Истина;
			ПКО.Записать();
			Сообщить("Приходный кассовый документ отменен!!" + ПКО);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденППО) Тогда
			ППО = НайденППО.ПолучитьОбъект();
			ППО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			ППО.ПометкаУдаления = Истина;
			ППО.Комментарий = "Отмена 1";

			ППО.Записать();
			Сообщить("Платежное поручение входящее отменено!!" + ППО);
		КонецЕсли;					

		
	КонецЕсли;
	
	Если Источник.СтатусЗаказа.ФормироватьВозвратДенег И Источник.НеУчитыватьВОтчете = Ложь Тогда
		СоздатьВозвратДенег(Источник.Ссылка); 
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Процедура СоздатьВнПеремещение(Заказ)
	Если Заказ.Дата<= Дата(2019,01,04) Тогда
		Возврат;
	КонецЕсли;
	
	//проверка на вхождение в статус из
	ПоследнееЗначение = РегистрыСведений.ИсторияИзмененияСтатусовЗаказов.ПолучитьПоследнее(,Новый Структура("ЗаказПокупателя",Заказ));
	Если Заказ.СтатусЗаказа.ПредыдущиеСтатусыУсловиеОтправкиСМС.Найти(ПоследнееЗначение.СтатусЗаказа)=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтрольОплаты = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000012");			
	ТипОбратнойДоставки = Заказ.ТипОбратнойДоставки;

	Если КонтрольОплаты = ТипОбратнойДоставки Тогда
		Возврат;
	КонецЕсли;


	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВнутреннееПеремещениеНаличныхДенежныхСредств.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ВнутреннееПеремещениеНаличныхДенежныхСредств КАК ВнутреннееПеремещениеНаличныхДенежныхСредств
	               |ГДЕ
	               |	ВнутреннееПеремещениеНаличныхДенежныхСредств.Основание = &Основание
	               |	И НЕ ВнутреннееПеремещениеНаличныхДенежныхСредств.ПометкаУдаления";
	Запрос.УстановитьПараметр("Основание",Заказ);
	Рез = Запрос.Выполнить().Выбрать();
	
	Если Рез.Следующий() Тогда 
		Если Рез.Ссылка.СуммаДокумента = Заказ.СуммаНоваяПочта И Рез.Ссылка.Проведен Тогда
			Возврат;
		КонецЕсли;
		Док = Рез.Ссылка.ПолучитьОбъект();
	Иначе
		Док = Документы.ВнутреннееПеремещениеНаличныхДенежныхСредств.СоздатьДокумент();
		Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();
		//Задача.ос
		Док.Дата = ТекущаяДата();
	КонецЕсли;
	
	Док.Касса = Справочники.Кассы.НайтиПоКоду("000000020");
	Док.КассаПолучатель = Заказ.СтатусЗаказа.КассаВнПеремещения;
	Док.ОрганизацияОтправитель = Заказ.Организация;
	Док.ОрганизацияПолучатель = Заказ.Организация;
	Док.Оплачено = Истина;
	Док.Основание = Заказ;
	Док.СуммаДокумента = Заказ.СуммаНоваяПочта;
	Док.ВалютаДокумента = Заказ.ВалютаДокумента;
	
	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЛогОшибкиСтатуса(Заказ, "СоздатьВнПеремещение_Док", ОписаниеОшибки());
		ФД = Док.ПолучитьФорму("ФормаДокумента");
		ФД.Открыть();
	КонецПопытки;
	
КонецПроцедуры

процедура ЗакрытьРезерв(Заказ) 
	Заказ.ПолучитьОбъект().ЗакрытиеЗаказа();	
КонецПроцедуры


Процедура СоздатьВозвратДенег(Заказ)
	
	Если Заказ.Дата<= Дата(2017,12,05) Тогда
		Возврат;
	КонецЕсли;
	
	
	КонтрольОплаты = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000012");
	Наложка = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000009");
	ТипОбратнойДоставки = Заказ.ТипОбратнойДоставки;

	Если ТипОбратнойДоставки = КонтрольОплаты Тогда
		ППО = НайтиППО(Заказ).ПолучитьОбъект();
		ППО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ППО.ПометкаУдаления = Истина;
		ППО.Комментарий = "Отмена 4";
		ППО.Записать();
		Возврат;
	КонецЕсли;

	//НайтиППО(Сделка)
	
	//проверка на вхождение в статус из
	ПоследнееЗначение = РегистрыСведений.ИсторияИзмененияСтатусовЗаказов.ПолучитьПоследнее(,Новый Структура("ЗаказПокупателя",Заказ));
	Если Заказ.СтатусЗаказа.ПредыдущиеСтатусыУсловиеОтправкиСМС.Найти(ПоследнееЗначение.СтатусЗаказа)=Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка
	               |ИЗ
	               |	Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасходныйКассовыйОрдерРасшифровкаПлатежа
	               |ГДЕ
	               |	РасходныйКассовыйОрдерРасшифровкаПлатежа.Сделка = &Сделка";
	Запрос.УстановитьПараметр("Сделка",Заказ);			   
	
	Рез = Запрос.Выполнить().Выбрать();
	
	Если Рез.Следующий() Тогда 
		Сум = ?(Заказ.СуммаНоваяПочта =0,Заказ.СуммаДокумента,Заказ.СуммаНоваяПочта);

		Если Рез.Ссылка.СуммаДокумента = Сум И Рез.Ссылка.Проведен Тогда
			Возврат;
		КонецЕсли;

		Док = Рез.Ссылка.ПолучитьОбъект();
	Иначе
		Док = Документы.РасходныйКассовыйОрдер.СоздатьДокумент();
		НайденПКО = НайтиПКО(Заказ);
		Если ЗначениеЗаполнено(НайденПКО) Тогда
			Док.Дата = ТекущаяДата();
			//Док.Дата = НайденПКО.Дата+5;
		Иначе
			Док.Дата = ТекущаяДата();
		КонецЕсли;
	КонецЕсли;
	
	Док.ОтражатьВУправленческомУчете = Истина;
	Док.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Док.Организация = Справочники.Организации.НайтиПоКоду("000000001");
	Док.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду("980");
	Док.Оплачено = Истина;
	Док.Комментарий = "Возврат денег";
				
	Док.Касса = Справочники.Кассы.НайтиПоКоду("000000001");

	Если НЕ ЗначениеЗаполнено(Док.Касса) Тогда	
		Док.Касса = Док.Организация.ОсновнаяКасса;
	КонецЕсли;

	Док.ВидОперации = Перечисления.ВидыОперацийРКО.ВозвратДенежныхСредствПокупателю;
	Док.Контрагент = Заказ.Контрагент;
	Дог =  Заказ.ДоговорКонтрагента;
	Сум = ?(Заказ.СуммаНоваяПочта =0,Заказ.СуммаДокумента,Заказ.СуммаНоваяПочта);
	Док.РасшифровкаПлатежа.Очистить();
	РП = Док.РасшифровкаПлатежа.Добавить();
	РП.КратностьВзаиморасчетов = 1;
	РП.КурсВзаиморасчетов = 1;
	РП.СуммаПлатежа = Сум;
	РП.Сделка  = Заказ;
	РП.СуммаВзаиморасчетов = РП.СуммаПлатежа;
	РП.ДоговорКонтрагента = Дог;
	
	Док.СуммаДокумента = Сум;
	Док.Контрагент = Заказ.Контрагент;

	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЛогОшибкиСтатуса(Заказ, "СоздатьВозвратДенег_Док", ОписаниеОшибки());
		//ФД = Док.ПолучитьФорму("ФормаДокумента");
		//ФД.Открыть();
		Док.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;
	
КонецПроцедуры

Процедура СоздатьВозвратТоваров(Заказ)
	
	КонтрольОплаты = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000012");
	Наложка = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000009");
	ТипОбратнойДоставки = Заказ.ТипОбратнойДоставки;
	НайденППВ = НайтиППО(Заказ.Ссылка);	
	
	Если Заказ.Дата<= Дата(2017,12,05) Тогда
		Возврат;
	КонецЕсли;
	
	// В отличие от СоздатьВнПеремещение и СоздатьВозвратДенег здесь НЕ проверяется
	// таблица "ПредыдущиеСтатусыУсловиеОтправкиСМС": возврат формируется при любой
	// записи заказа в статусе с флагом, а не только при переходе из разрешённого статуса.
	// Поведение НЕ меняем: логируем, попал бы предыдущий статус в таблицу или нет.
	ПредыдущийСтатусДиагностика = РегистрыСведений.ИсторияИзмененияСтатусовЗаказов.ПолучитьПоследнее(,Новый Структура("ЗаказПокупателя",Заказ)).СтатусЗаказа;
	ЛогСтатуса(Заказ, "ВозвратТоваров_БезПроверкиПредыдущегоСтатуса",
		"предыдущий статус: " + СокрЛП(ПредыдущийСтатусДиагностика)
		+ "; в таблице разрешённых переходов: "
		+ ?(Заказ.СтатусЗаказа.ПредыдущиеСтатусыУсловиеОтправкиСМС.Найти(ПредыдущийСтатусДиагностика) = Неопределено, "нет", "да"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВозвратТоваровОтПокупателя.Ссылка
	               |ИЗ
	               |	Документ.ВозвратТоваровОтПокупателя КАК ВозвратТоваровОтПокупателя
	               |ГДЕ
	               |	ВозвратТоваровОтПокупателя.Сделка = &Сделка";
	Запрос.УстановитьПараметр("Сделка",Заказ);
	Рез = Запрос.Выполнить().Выбрать();
	
	ОстаткиРезервов = Документы.ЗаказПокупателя.РезервПоЗаказуОстаток(Заказ);
	
	Если Заказ.СуммаДокумента = 0 Тогда 
			//Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			//Док.Комментарий = "Сумма заказа 0";
			//Док.Записать(РежимЗаписиДокумента.Запись);
			Возврат; 
	КонецЕсли;
	
	Если ОстаткиРезервов.Количество() > 0 Тогда
		//Если Рез.Следующий() Тогда 
		//	Док = Рез.Ссылка.ПолучитьОбъект();
		//	Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		//	Док.Комментарий = "Есть не закрытый резерв";
		//	Док.Записать(РежимЗаписиДокумента.Запись);
		//	Сообщить("Есть не закрытый резерв");
		//КонецЕсли;
		Возврат;
	КонецЕсли;

	
	Если Рез.Следующий() Тогда
		//Если Рез.Ссылка.СуммаДокумента = Заказ.СуммаДокумента И Рез.Ссылка.Проведен Тогда
		//	Возврат;
		//КонецЕсли;
		Док = Рез.Ссылка.ПолучитьОбъект();
	Иначе
		Док = Документы.ВозвратТоваровОтПокупателя.СоздатьДокумент();
		Док.Дата = ТекущаяДата();
	КонецЕсли;
	//Заказ=Документы.ЗаказПокупателя.СоздатьДокумент();
	
	Док.ОтражатьВУправленческомУчете = Истина;
	Док.Ответственный = ПараметрыСеанса.ТекущийПользователь;
	Док.Организация = Справочники.Организации.НайтиПоКоду("000000001");
	Док.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду("980");
	Док.Комментарий = "Возврат товара" + Док.Дата;
	Док.КурсВзаиморасчетов = 1;
	Док.НеВозвращатьРезерв = Истина;
	Док.ТипЦен = Заказ.ТипЦен;
	Док.КратностьВзаиморасчетов = 1;
	Док.ВидОперации = Перечисления.ВидыОперацийВозвратТоваровОтПокупателя.ПродажаКомиссия;
	Док.Контрагент = Заказ.Контрагент;
	Док.ДоговорКонтрагента = Заказ.ДоговорКонтрагента;
	Док.СуммаДокумента = Заказ.СуммаДокумента;
	
	Если Заказ.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоНаименованию("На возврате") Тогда
		Док.СкладОрдер = Справочники.Склады.НайтиПоКоду("000000126");
	ИначеЕсли Заказ.СтатусЗаказа = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Отказ") Тогда 
		Если Док.СкладОрдер = Справочники.Склады.НайтиПоКоду("000000126") Тогда
			Док.СкладОрдер = Справочники.Склады.НайтиПоКоду("000000014");
		КонецЕсли;
	КонецЕсли;
	 
	//Док.СкладОрдер = Заказ.СкладГруппа;
	Док.ВидПоступления = Перечисления.ВидыПоступленияТоваров.НаСклад;
	Док.Сделка = Заказ;
	
	Док.Товары.Очистить();
	Для Каждого Стр Из Заказ.Товары Цикл
		НС = Док.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НС,Стр);
		НС.Качество = Справочники.Качество.Новый;
		НС.Склад = Заказ.СкладГруппа;
		Если Не ЗначениеЗаполнено(НС.Склад) Тогда
			НС.Склад  = Справочники.Склады.НайтиПоКоду("000000002");
		КонецЕсли;
	КонецЦикла;

	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ЛогОшибкиСтатуса(Заказ, "СоздатьВозвратТоваров_Док", ОписаниеОшибки());
		//ФД = Док.ПолучитьФорму("ФормаДокумента");
		//ФД.Открыть();
		Док.Записать(РежимЗаписиДокумента.Запись);
	КонецПопытки;

КонецПроцедуры

Функция ОплатаЕсть (Заказ) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка
	               |ИЗ
	               |	Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК ПриходныйКассовыйОрдерРасшифровкаПлатежа
	               |ГДЕ
	               |	НЕ ПриходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.ПометкаУдаления
	               |	И ПриходныйКассовыйОрдерРасшифровкаПлатежа.Сделка = &Сделка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ПлатежноеПоручениеВходящееРасшифровкаПлатежа.Ссылка
	               |ИЗ
	               |	Документ.ПлатежноеПоручениеВходящее.РасшифровкаПлатежа КАК ПлатежноеПоручениеВходящееРасшифровкаПлатежа
	               |ГДЕ
	               |	НЕ ПлатежноеПоручениеВходящееРасшифровкаПлатежа.Ссылка.ПометкаУдаления
	               |	И ПлатежноеПоручениеВходящееРасшифровкаПлатежа.Сделка = &Сделка";
				   
	Запрос.УстановитьПараметр("Сделка",Заказ);
	Рез = Запрос.Выполнить().Выгрузить();
	
	Если Рез.Количество()>0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
