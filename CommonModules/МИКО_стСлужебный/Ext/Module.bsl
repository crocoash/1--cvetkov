// Функция возвращает служебную информацию по конфигурации.
// 
Функция ПолучитьСлужебнуюИнформацию() Экспорт

	СтруктураОтвета = Новый Структура("ВерсияПлатформы, ИспользоватьРежимМодальности");
	
	СисИнфо = Новый СистемнаяИнформация;
	ВерсияПлатформы = Лев(СисИнфо.ВерсияПриложения,3);
	
	Если ВерсияПлатформы = "8.2" Тогда
		ИспользоватьРежимМодальности = Истина;
	Иначе
		ИспользоватьРежимМодальности = Вычислить("Метаданные.РежимИспользованияМодальности = Метаданные.СвойстваОбъектов.РежимИспользованияМодальности.Использовать");
		Если НЕ ЗначениеЗаполнено(ИспользоватьРежимМодальности) ИЛИ НЕ ТипЗнч(ИспользоватьРежимМодальности) = Тип("Булево") Тогда
			ИспользоватьРежимМодальности = Ложь;
		КонецЕсли; 
	КонецЕсли; 
	
	СтруктураОтвета.ВерсияПлатформы = ВерсияПлатформы;
	
	СтруктураОтвета.ИспользоватьРежимМодальности = ИспользоватьРежимМодальности;
	
	Возврат СтруктураОтвета;
	
КонецФункции // ПолучитьСлужебнуюИнформацию()

