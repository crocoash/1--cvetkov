// Создает новый объект ЧтениеXML и инициализирует переданным xml кодом
//
Функция НовыйЧтениеXML(СтрокаХМЛ) Экспорт
	
	Результат = Неопределено;
	
	Попытка
		ЧтениеХМЛ = Новый ЧтениеXML;
		ЧтениеХМЛ.УстановитьСтроку(СтрокаХМЛ);
		Если ЧтениеХМЛ.Прочитать() Тогда
			Результат = ЧтениеХМЛ;
		КонецЕсли;
	Исключение
		// Невозможно разобрать данные XML
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // НовыйЧтениеXML()

// Разбирает XML-текст в соответсвие атрибут - значение, без использования
// объекта ЧтениеXML. Подходит для использования на веб-клиенте.
//
Функция мвРазложитьXMLПоАтрибутам(Данные) Экспорт
	
	Результат = Новый Соответствие;
	
	МассивПодстрок = РазложитьСтрокуВМассивПодстрок(Данные, " ");
	
	Для Индекс = 0 По МассивПодстрок.Количество() - 1 Цикл
		
		СтрокаДляРазбора	= СокрЛП(МассивПодстрок[Индекс]);
		ПозицияРазделителя	= Найти(СтрокаДляРазбора, "=");
		
		Если ПозицияРазделителя > 0 Тогда
			Атрибут	= Лев(СтрокаДляРазбора, ПозицияРазделителя - 1);
			Значение= Прав(СтрокаДляРазбора, СтрДлина(СтрокаДляРазбора) - ПозицияРазделителя - 1);
			Значение= Лев(Значение, СтрДлина(Значение) - 1);
			
			Результат.Вставить(Атрибут, Значение);
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // РазложитьXMLПоАтрибутам()


