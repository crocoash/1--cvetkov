// ФУНКЦИИ ПРЕОБРАЗОВАНИЯ ЧИСЕЛ И ДАТ

Функция ПреобразоватьЧислоВоВремя(ЧислоСекунд) Экспорт
	
	Минуты = Цел(ЧислоСекунд / 60);
	Часы = Цел(Минуты / 60);
	Секунды = ЧислоСекунд - Минуты * 60;
	
	Результат = "";
	Если Часы > 0 Тогда
		Возврат Результат = Строка(Часы) + ":";
	КонецЕсли;
		
	Возврат Результат + Формат(Минуты, "ЧЦ=2; ЧН=; ЧВН=") + ":" + Формат(Секунды, "ЧЦ=2; ЧН=; ЧВН=");
	
КонецФункции // ПреобразоватьЧислоВоВремя()


