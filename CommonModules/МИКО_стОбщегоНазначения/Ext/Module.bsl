// Создает новый критерий для поиска данных в таблицах по условию
//
Функция НовыйКритерий(ЛевоеЗначение = Неопределено, ВидСравнения, ПравоеЗначение = Неопределено) Экспорт
	
	Возврат Новый Структура("ЛевоеЗначение,ВидСравнения,ПравоеЗначение", ЛевоеЗначение, ВидСравнения, ПравоеЗначение);
	
КонецФункции // НовыйКритерий()

// Создает и инициализирует массиив значений
//
Функция НовыйМассив(Элемент1, Элемент2 = Неопределено, Элемент3 = Неопределено, Элемент4 = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить(Элемент1);
	Если Элемент2 <> Неопределено Тогда
		Результат.Добавить(Элемент2);
	КонецЕсли;
	Если Элемент3 <> Неопределено Тогда
		Результат.Добавить(Элемент3);
	КонецЕсли;
	Если Элемент4 <> Неопределено Тогда
		Результат.Добавить(Элемент4);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // НовыйМассив()

Функция СвойствоДокументаИдентификаторЗвонка() Экспорт
	
	Возврат "ID_Звонок";
	
КонецФункции // СвойствоДокументаИдентификаторЗвонка()

Функция ПустаяТаблицаПоОбъектуМетаданных(ПолноеИмяОбъекта) Экспорт
	
	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Таблица.*
		|ИЗ
		|	&ПолноеИмяОбъекта КАК Таблица";
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолноеИмяОбъекта", ПолноеИмяОбъекта);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	РезультатТаблица = РезультатЗапроса.Выгрузить().СкопироватьКолонки();
	
	Возврат РезультатТаблица;
	
КонецФункции


