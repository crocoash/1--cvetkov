////////////////////////////////////////////////////////////////////////////////
// Производство через возврат: контроль цены 1 грн.
//
// Сшитое производителями организации "через Возврат" приходуется документом
// ВозвратТоваровОтПокупателя от контрагента "Цветков Произ" (код 000009930),
// в комментарии - номер кроя: "Кр № 19 Алиса рубашка 146 - 158р кол - во 72 шт".
// Цена в таком возврате - цена пошива: в 2025 году 380-1315 грн. С 2026 года
// её стали ставить 1 грн (к 15.09.2026 пять документов, 315 шт.), и деньги
// за пошив из базы пропадают.
//
// На каждый такой документ заводится задача Антону (решение пользователя
// 15.09.2026). Задача одна на документ и живёт, пока цена не исправлена:
// вручную её не закрыть (ПроверитьЗакрытиеЗадачи из ПередЗаписью задачи),
// а закрытую в обход проверки регламент открывает снова. Цену исправили
// (строк по 1 грн в проведённом документе не осталось), документ распровели
// или пометили на удаление - задача закрывается сама.
//
// Запускается регламентом ТелеграмОбмен (ТелеграмБот.ОбменСБотом) рядом с
// задачами на замеры и по той же причине: это единственное задание с
// расписанием раз в 1-2 минуты, а расписание нового задания пришлось бы
// заводить в базе руками.
////////////////////////////////////////////////////////////////////////////////

// Точка входа регламента: закрывает отработанные задачи и заводит новые.
Процедура ЗадачиПоЦенеОдинГривна() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Контрагент = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагентаПроизводства());

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		ЗаписьЖурналаРегистрации("Производство.Задачи", УровеньЖурналаРегистрации.Ошибка, , ,
			"Контрагент с кодом " + КодКонтрагентаПроизводства()
			+ " (Цветков Произ) не найден - цена 1 грн в возвратах не отслеживается.");
		Возврат;
	КонецЕсли;

	Документы_ = ДокументыПоЦенеОдинГривна(Контрагент);

	ЗакрытьЗадачиПоИсправленнымДокументам(Документы_);
	ЗавестиЗадачиПоДокументам(Документы_);

КонецПроцедуры

// Контрагент, от которого возвратом приходуется производство.
Функция КодКонтрагентаПроизводства()
	Возврат "000009930"; // Цветков Произ
КонецФункции

// Кому уходят задачи. Как и у задач на замеры, пользователь ищется по
// наименованию: у элементов справочника Пользователи код равен наименованию.
Функция ИмяИсполнителя()
	Возврат "Антон";
КонецФункции

// Начало ИдентификатораСобытия задачи. Дефис, а не подчёркивание: по маске
// с этим префиксом идёт поиск через ПОДОБНО, а "_" там значит "любой символ".
Функция ПрефиксЗадачи()
	Возврат "ЦенаПроизводства-";
КонецФункции

// Строки дешевле этой цены (включительно) считаются незаполненной ценой пошива.
// Включительно - чтобы нулевая цена тоже попадала.
Функция ПороговаяЦена()
	Возврат 1;
КонецФункции

// Проведённые возвраты от контрагента производства со строками по 1 грн.
// Соответствие: документ -> массив структур (Номенклатура, Организация, Количество).
// Документ задан - смотрим только его: так проверка при закрытии задачи идёт
// по тем же условиям, что и регламент.
Функция ДокументыПоЦенеОдинГривна(Знач Контрагент, Знач Документ = Неопределено)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Цена",       ПороговаяЦена());
	Запрос.УстановитьПараметр("Документ",   Документ);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Товары.Ссылка КАК Документ,
	               |	Товары.Номенклатура КАК Номенклатура,
	               |	Товары.Номенклатура.Организация КАК Организация,
	               |	СУММА(Товары.Количество) КАК Количество
	               |ИЗ
	               |	Документ.ВозвратТоваровОтПокупателя.Товары КАК Товары
	               |ГДЕ
	               |	Товары.Ссылка.Проведен
	               |	И Товары.Ссылка.Контрагент = &Контрагент
	               |	И Товары.Цена <= &Цена
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Товары.Ссылка,
	               |	Товары.Номенклатура,
	               |	Товары.Номенклатура.Организация
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Документ,
	               |	Номенклатура";

	Если Документ <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Товары.Цена <= &Цена",
			"И Товары.Цена <= &Цена И Товары.Ссылка = &Документ");
	КонецЕсли;

	Результат = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Строки = Результат[Выборка.Документ];

		Если Строки = Неопределено Тогда
			Строки = Новый Массив;
			Результат.Вставить(Выборка.Документ, Строки);
		КонецЕсли;

		Строки.Добавить(Новый Структура("Номенклатура, Организация, Количество",
			Выборка.Номенклатура, Выборка.Организация, Выборка.Количество));

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИдентификаторЗадачи(Знач Документ)
	Возврат ПрефиксЗадачи() + Строка(Документ.УникальныйИдентификатор());
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Заведение задач.

Процедура ЗавестиЗадачиПоДокументам(Знач Документы_)

	Если Документы_.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Исполнитель = Справочники.Пользователи.НайтиПоНаименованию(ИмяИсполнителя(), Истина);

	Если НЕ ЗначениеЗаполнено(Исполнитель) Тогда
		ЗаписьЖурналаРегистрации("Производство.Задачи", УровеньЖурналаРегистрации.Ошибка, , ,
			"Пользователь """ + ИмяИсполнителя()
			+ """ не найден - задачи по цене 1 грн создавать не на кого.");
		Возврат;
	КонецЕсли;

	// Что уже заведено: идентификатор -> Структура(ЕстьОткрытая, Закрытая).
	// Помеченные на удаление не в счёт - вместо такой заводится новая.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Маска", ПрефиксЗадачи() + "%");
	Запрос.Текст = "ВЫБРАТЬ
	               |	Задачи.Ссылка КАК Ссылка,
	               |	Задачи.ИдентификаторСобытия КАК Идентификатор,
	               |	Задачи.Выполнена КАК Выполнена
	               |ИЗ
	               |	Задача.ЗадачиПользователя КАК Задачи
	               |ГДЕ
	               |	Задачи.ИдентификаторСобытия ПОДОБНО &Маска
	               |	И НЕ Задачи.ПометкаУдаления";

	Заведенные = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Ключ   = СокрЛП(Выборка.Идентификатор);
		Данные = Заведенные[Ключ];

		Если Данные = Неопределено Тогда
			Данные = Новый Структура("ЕстьОткрытая, Закрытая", Ложь, Неопределено);
			Заведенные.Вставить(Ключ, Данные);
		КонецЕсли;

		Если Выборка.Выполнена Тогда
			Данные.Закрытая = Выборка.Ссылка;
		Иначе
			Данные.ЕстьОткрытая = Истина;
		КонецЕсли;

	КонецЦикла;

	Для Каждого Элемент Из Документы_ Цикл

		Данные = Заведенные[ИдентификаторЗадачи(Элемент.Ключ)];

		Если Данные = Неопределено Тогда
			СоздатьЗадачу(Исполнитель, Элемент.Ключ, Элемент.Значение);
		ИначеЕсли НЕ Данные.ЕстьОткрытая Тогда
			ПереоткрытьЗадачу(Данные.Закрытая, Элемент.Ключ, Исполнитель);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Задачу закрыли, а цена в документе так и осталась 1 грн: закрыли в обход
// проверки ПередЗаписью или вернули цену обратно после автозакрытия.
// Открываем ту же задачу снова, а не заводим вторую.
Процедура ПереоткрытьЗадачу(Знач Задача, Знач Документ, Знач Исполнитель)

	Срок = НачалоДня(ТекущаяДата()) + 32400;

	Попытка

		Объект = Задача.ПолучитьОбъект();

		Объект.Выполнена      = Ложь;
		Объект.ДатаИсполнения = Дата(1, 1, 1);
		Объект.Исполнитель    = Исполнитель; // ПриВыполнении ставит того, кто закрыл
		Объект.Дата           = Срок;
		Объект.СрокИсполнения = Срок;
		Объект.Оповещение     = Истина;
		Объект.СрокОповещения = Срок;
		Объект.Описание       = "Открыта снова " + Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy")
			+ ": цена " + ПороговаяЦена() + " грн в документе не исправлена."
			+ Символы.ПС + Объект.Описание;

		Объект.Записать();

		ЗаписьЖурналаРегистрации("Производство.Задачи",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.ВозвратТоваровОтПокупателя, Документ,
			"Задача по цене " + ПороговаяЦена() + " грн открыта снова: цена не исправлена.");

	Исключение

		ЗаписьЖурналаРегистрации("Производство.Задачи",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ВозвратТоваровОтПокупателя, Документ,
			"Задача по цене " + ПороговаяЦена() + " грн не открыта снова: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

Процедура СоздатьЗадачу(Знач Исполнитель, Знач Документ, Знач Строки)

	// 9:00 сегодняшнего дня - как у остальных задач базы
	// (ЗамерыНоменклатуры.СоздатьЗадачуНаЗамеры, ТелеграмБот.ЗадачаДляЗаказа).
	Срок = НачалоДня(ТекущаяДата()) + 32400;

	Описание = Новый Массив;
	Описание.Добавить("Производство оприходовано возвратом от ""Цветков Произ"" по цене "
		+ ПороговаяЦена() + " грн. Проставить в документе цену пошива -"
		+ " задача закроется сама.");
	Описание.Добавить("Документ: " + СокрЛП(Строка(Документ)));

	Комментарий = СокрЛП(Документ.Комментарий);

	Если НЕ ПустаяСтрока(Комментарий) Тогда
		Описание.Добавить("Комментарий: " + Комментарий);
	КонецЕсли;

	Описание.Добавить("Строки по " + ПороговаяЦена() + " грн:");

	ЕстьПолнаяОплата = Ложь;

	Для Каждого Стр Из Строки Цикл

		Организация = ?(ЗначениеЗаполнено(Стр.Организация),
			СокрЛП(Стр.Организация.Наименование), "не заполнена");

		Описание.Добавить("  " + СокрЛП(Строка(Стр.Номенклатура))
			+ " - " + Формат(Стр.Количество, "ЧГ=0") + " шт., организация: " + Организация);

		Если Организация = "Полная оплата" Тогда
			ЕстьПолнаяОплата = Истина;
		КонецЕсли;

	КонецЦикла;

	// Организация номенклатуры задаёт способ оприходования (пользователь,
	// 15.09.2026): у "Полной оплаты" приход - только отчёт производства за смену.
	Если ЕстьПолнаяОплата Тогда
		Описание.Добавить("У модели организация ""Полная оплата"" - её приход оформляется"
			+ " отчётом производства за смену, а не возвратом.");
	КонецЕсли;

	Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();

	Задача.ИдентификаторСобытия = ИдентификаторЗадачи(Документ);
	Задача.Наименование         = Лев("Цена " + ПороговаяЦена() + " грн: возврат "
		+ СокрЛП(Документ.Номер) + " от " + Формат(Документ.Дата, "ДФ=dd.MM.yyyy"), 100);
	Задача.Описание             = СтрСоединить(Описание, Символы.ПС);
	Задача.Исполнитель          = Исполнитель;
	Задача.Объект               = Документ;
	Задача.Дата                 = Срок;
	Задача.СрокИсполнения       = Срок;
	Задача.Оповещение           = Истина;
	Задача.СрокОповещения       = Срок;

	Попытка

		Задача.Записать();

		ЗаписьЖурналаРегистрации("Производство.Задачи",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.ВозвратТоваровОтПокупателя, Документ,
			"Заведена задача по цене " + ПороговаяЦена() + " грн в возврате производства.");

	Исключение

		ЗаписьЖурналаРегистрации("Производство.Задачи",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ВозвратТоваровОтПокупателя, Документ,
			"Задача по цене " + ПороговаяЦена() + " грн не создана: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Закрытие отработанных задач.

// Документа больше нет среди возвратов по 1 грн - цену исправили, документ
// распровели или удалили. Закрываем сами, иначе список копит сделанную работу.
Процедура ЗакрытьЗадачиПоИсправленнымДокументам(Знач Документы_)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Маска", ПрефиксЗадачи() + "%");
	Запрос.Текст = "ВЫБРАТЬ
	               |	Задачи.Ссылка КАК Ссылка,
	               |	Задачи.Объект КАК Объект
	               |ИЗ
	               |	Задача.ЗадачиПользователя КАК Задачи
	               |ГДЕ
	               |	НЕ Задачи.Выполнена
	               |	И Задачи.ИдентификаторСобытия ПОДОБНО &Маска";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если Документы_[Выборка.Объект] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка

			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Объект.Выполнена = Истина;

			Если НЕ ЗначениеЗаполнено(Объект.ДатаИсполнения) Тогда
				Объект.ДатаИсполнения = ТекущаяДата();
			КонецЕсли;

			Объект.Записать();

			ЗаписьЖурналаРегистрации("Производство.Задачи",
				УровеньЖурналаРегистрации.Информация, , Выборка.Объект,
				"Задача по цене " + ПороговаяЦена() + " грн закрыта: строк по этой цене"
				+ " в проведённом документе не осталось.");

		Исключение

			ЗаписьЖурналаРегистрации("Производство.Задачи",
				УровеньЖурналаРегистрации.Ошибка, , Выборка.Объект,
				"Задача по цене " + ПороговаяЦена() + " грн не закрыта: " + ОписаниеОшибки());

		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Не даёт закрыть задачу по цене 1 грн, пока цена в документе не исправлена.
// Вызывается из ПередЗаписью задачи. Иначе задачу можно отметить выполненной
// и цену не исправлять (пользователь, 15.09.2026). Закрывает такие задачи
// только регламент - и только когда строк по 1 грн не осталось.
Процедура ПроверитьЗакрытиеЗадачи(Знач Задача, Отказ) Экспорт

	Если НЕ Задача.Выполнена
		ИЛИ Лев(Задача.ИдентификаторСобытия, СтрДлина(ПрефиксЗадачи())) <> ПрефиксЗадачи() Тогда
		Возврат;
	КонецЕсли;

	// Перезапись уже закрытой задачи (правка описания и т.п.) - не закрытие.
	Если НЕ Задача.ЭтоНовый() И Задача.Ссылка.Выполнена Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Задача.Объект) <> Тип("ДокументСсылка.ВозвратТоваровОтПокупателя")
		ИЛИ НЕ ЗначениеЗаполнено(Задача.Объект) Тогда
		Возврат;
	КонецЕсли;

	Контрагент = Справочники.Контрагенты.НайтиПоКоду(КодКонтрагентаПроизводства());

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Если ДокументыПоЦенеОдинГривна(Контрагент, Задача.Объект).Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Отказ = Истина;

	Сообщить("Задачу нельзя закрыть: в документе """ + СокрЛП(Строка(Задача.Объект))
		+ """ остались строки по цене " + ПороговаяЦена() + " грн. Проставьте цену пошива -"
		+ " задача закроется сама.", СтатусСообщения.Важное);

КонецПроцедуры
