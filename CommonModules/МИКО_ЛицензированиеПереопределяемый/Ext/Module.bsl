////////////////////////////////////////////////////////////////////////////////
// Настройка системы лицензирования.
//
////////////////////////////////////////////////////////////////////////////////
Функция ОписаниеПродуктаМодульСтатистики() Экспорт
	ОписаниеПродукта = Новый Структура;
	// Наименование продукта (по этому полю выполняется поиск остальных параметров).
	ОписаниеПродукта.Вставить("Наименование",                    "Модуль статистики");
	// Идентификатор конфигурации (указан в окне конфигурации продукта "МИКО:Защита конфигураций").
	ОписаниеПродукта.Вставить("ИдентификаторКонфигурации",       "f935e94a-c297-11e6-816c-00505681710a");
	// Перикс-ключ (указан в настройках личного кабинета разработчика).
	ОписаниеПродукта.Вставить("ПрефиксКлюч",                     "MIKO");
	// Идентификатор главной фичи (используется при вызове МИКО_Лицензирование.НачатьРаботу).
	ОписаниеПродукта.Вставить("ИдентификаторФичи",               "31");
	// Идентификатор триального продукта (этот продукт будет зашит в триальный ключ при регистрации).
	ОписаниеПродукта.Вставить("ИдентификаторТриальногоПродукта", "8");
	
	ОписаниеПродукта.Вставить("КомпонентРегистрацииПродукта",	"МИКОст_КомпонентРегистрацииПродукта");
	ОписаниеПродукта.Вставить("КомпонентЗакрытогоМодуля",   	"МИКОст_КомпонентЗакрытогоМодуля");
	ОписаниеПродукта.Вставить("ЛицензионныйКлюч", 				 КлючЗащитыМодульСтатистики());
	ОписаниеПродукта.Вставить("ИмяМетодаСохраненияКлюча", 		"КлючЗащитыМодульСтатистики");
	
	Возврат ОписаниеПродукта;	
КонецФункции // ИдентификаторКонфигурации()

Функция ОписаниеПродуктаМодульУмнойМаршрутизации() Экспорт
	ОписаниеПродукта = Новый Структура;
	// Наименование продукта (по этому полю выполняется поиск остальных параметров).
	ОписаниеПродукта.Вставить("Наименование",                    "Модуль умной маршрутизации");
	// Идентификатор конфигурации (указан в окне конфигурации продукта "МИКО:Защита конфигураций").
	ОписаниеПродукта.Вставить("ИдентификаторКонфигурации",       "f935e94a-c297-11e6-816c-00505681710a");
	// Перикс-ключ (указан в настройках личного кабинета разработчика).
	ОписаниеПродукта.Вставить("ПрефиксКлюч",                     "MIKO");
	// Идентификатор главной фичи (используется при вызове МИКО_Лицензирование.НачатьРаботу).
	ОписаниеПродукта.Вставить("ИдентификаторФичи",               "32");
	// Идентификатор триального продукта (этот продукт будет зашит в триальный ключ при регистрации).
	ОписаниеПродукта.Вставить("ИдентификаторТриальногоПродукта", "9");
	
	ОписаниеПродукта.Вставить("КомпонентРегистрацииПродукта",	"МИКОст_КомпонентРегистрацииПродукта");
	ОписаниеПродукта.Вставить("КомпонентЗакрытогоМодуля",   	"МИКОст_КомпонентЗакрытогоМодуля");
	ОписаниеПродукта.Вставить("ЛицензионныйКлюч", 				 КлючЗащитыМодульСтатистики());
	ОписаниеПродукта.Вставить("ИмяМетодаСохраненияКлюча", 		"КлючЗащитыМодульСтатистики");
	
	Возврат ОписаниеПродукта;	
КонецФункции // ИдентификаторКонфигурации()


Функция КлючЗащитыМодульСтатистики(Знач Ключ=Неопределено, Знач ИспользоватьКЭШ=Истина) Экспорт

	Если Ключ = Неопределено И ИспользоватьКЭШ = Истина Тогда
		Ключ = МИКО_стОбщегоНазначенияСерверПовторный.ПолучитьКлючЗащиты()
	ИначеЕсли Ключ = Неопределено Тогда
		Ключ = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.КлючЗащиты();
	Иначе
		Ключ = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.КлючЗащиты(Ключ);
	КонецЕсли; 	
 
	Возврат Ключ; 
КонецФункции // КлючЗащитыМодульСтатистики()
 
// Перечисление списка защищаемых продуктов.
//
// Параметры:
//  Продукты - Массив структур.
//
Функция ЛицензируемыеПродукты(Продукты=Неопределено) Экспорт
	Если Тип("Массив") <> ТипЗнч(Продукты) Тогда
		Продукты = Новый Массив;
	КонецЕсли; 

	Продукты.Добавить(ОписаниеПродуктаМодульСтатистики());
	Продукты.Добавить(ОписаниеПродуктаМодульУмнойМаршрутизации());
	
	Возврат Продукты;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Вызывается при инициализации системы защиты для работы с закрытым модулем.
//
// Параметры:
//  ПрефиксКлюч - Строка.
//  МестоположениеКомпонента - Строка.
//
Процедура ПриИнициализацииЗакрытогоМодуля(ПрефиксКлюч, МестоположениеКомпонента) Экспорт
	Продукты = ЛицензируемыеПродукты();
	Для каждого ОписаниеПродукта Из Продукты Цикл
		Если ПрефиксКлюч = ОписаниеПродукта.ПрефиксКлюч Тогда
			МестоположениеКомпонента = "ОбщийМакет." + ОписаниеПродукта.КомпонентЗакрытогоМодуля;
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры
// Вызывается при инициализации формы регистрации продукта.
//
// Параметры:
//  ПрефиксКлюч - Строка.
//  МестоположениеКомпонента - Строка.
//
Процедура ПриИнициализацииФормыРегистрации(ПрефиксКлюч, МестоположениеКомпонента) Экспорт
	Продукты = ЛицензируемыеПродукты();
	Для каждого ОписаниеПродукта Из Продукты Цикл
		Если ПрефиксКлюч = ОписаниеПродукта.ПрефиксКлюч Тогда
			МестоположениеКомпонента = "ОбщийМакет." + ОписаниеПродукта.КомпонентРегистрацииПродукта;
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры
////////////////////////////////////////////////////////////////////////////////
Процедура ПриЧтенииЛицензионногоКлюча(ИдентификаторКонфигурации, ЛицензионныйКлюч) Экспорт
	Продукты = ЛицензируемыеПродукты();
	Для каждого ОписаниеПродукта Из Продукты Цикл
		Если ИдентификаторКонфигурации = ОписаниеПродукта.ИдентификаторКонфигурации Тогда
			ЛицензионныйКлюч = ОписаниеПродукта.ЛицензионныйКлюч;
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

Процедура ПриЗаписиЛицензионногоКлюча(ИдентификаторКонфигурации, ЛицензионныйКлюч) Экспорт
	Продукты = ЛицензируемыеПродукты();
	Для каждого ОписаниеПродукта Из Продукты Цикл
		Если ИдентификаторКонфигурации = ОписаниеПродукта.ИдентификаторКонфигурации Тогда
			Выполнить(""+ОписаниеПродукта.ИмяМетодаСохраненияКлюча+"(ЛицензионныйКлюч)");
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры
