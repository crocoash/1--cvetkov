		ТекстЗапроса = ТекстЗапроса + ЗапросПоОплатам;
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + КонецЗапроса;
		
	//ЗапросПоЗаказам
	//ЗапросПоОтгрузкам
	//ЗапросПоТоварамЗаказов
	//ЗапросПоТоварамОтгрузок
