Процедура ВыгрузитьДокументы(ПараметрыОбмена, ТаблицаДокументов)
	
	ТаблицаДокументов.Колонки.Добавить("Дата");
	Для каждого ТекСтрока из ТаблицаДокументов Цикл
		
		Если ЗначениеЗаполнено(ТекСтрока.Объект) тогда
			ТекСтрока.Дата = ТекСтрока.Объект.Дата;	
		КонецЕсли;
		
	КонецЦикла;           
	
	лКоличествоСтрок 	= ТаблицаДокументов.Количество();
	КоличествоПакетов 	= ?(лКоличествоСтрок > 0, ТаблицаДокументов[лКоличествоСтрок - 1].Пакет, 0); 
	
	ТаблицаДокументов.Сортировать("Дата");
	
	лИмяСохраняемогоФайла = "";
	
	Если КоличествоПакетов > 0 тогда
		
		ПараметрыОбмена.МояФабрикаXDTO 	= СоздатьФабрикуXDTO(ПараметрыОбмена.ФайлСхемы); 
		
		XDTOКоммерческаяИнформацияТип 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "КоммерческаяИнформация");  
		XDTOКонтейнерТип				= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучениеТипОбъектаXDTO(ПараметрыОбмена,  "Контейнер", Истина, XDTOКоммерческаяИнформацияТип);

		Для Пакет = 1 по КоличествоПакетов Цикл

			КоличествоКонтейнеров 	= 0;
			КоличествоЗаказов 		= 0;
			КоличествоОтгрузок 		= 0;
			КоличествоОплат 		= 0;
			
			ВыгруженныеДокументы = Новый ТаблицаЗначений;
			ВыгруженныеДокументы.Колонки.Добавить("Объект");
			
			НайденныеДокументы = ТаблицаДокументов.НайтиСтроки(Новый Структура("Пакет",Пакет));

			ВремТаб = ТаблицаДокументов.СкопироватьКолонки("Объект");
			Для каждого НайденныйДокумент из НайденныеДокументы Цикл
				ВремТаб.Добавить().Объект = НайденныйДокумент.Объект;
			КонецЦикла;

			лМенеджерВременныхТаблиц 	= СформироватьВременныеТаблицыПоДокументам(ПараметрыОбмена, ВремТаб);

			XDTOКоммерческаяИнформация 	= Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьXDTOКоммерческаяИнформация(ПараметрыОбмена, XDTOКоммерческаяИнформацияТип); 
			
			Для каждого ТекДокумент из НайденныеДокументы Цикл

				XDTOКонтейнер = ПараметрыОбмена.МояФабрикаXDTO.Создать(XDTOКонтейнерТип);
			                                                                                         
				Если ТекДокумент.ТипОбъекта = "Заказ" тогда
					
					Запрос = Новый Запрос();
					Запрос.МенеджерВременныхТаблиц = лМенеджерВременныхТаблиц;
					Запрос.УстановитьПараметр("Заказ", ТекДокумент.Объект);
					Запрос.Текст = "ВЫБРАТЬ *
					|ИЗ
					|	ВремИнформацияОЗаказах КАК ВремИнформацияОЗаказах
					|ГДЕ
					|ВремИнформацияОЗаказах.Заказ = &Заказ";
					МассивЗаказов = Запрос.Выполнить().Выгрузить();
					
					Для каждого ТекЗаказ из МассивЗаказов Цикл 
						
						XDTOДокумент = ВыгрузитьЗаказXDTO(ПараметрыОбмена, лМенеджерВременныхТаблиц, ТекЗаказ, КоличествоЗаказов);
						XDTOКонтейнер.Документ.Добавить(XDTOДокумент);
						
						ВыгруженныеДокументы.Добавить().Объект =  ТекЗаказ.Объект;
						
					КонецЦикла;
					
					Если ПараметрыОбмена.ВыгрузкаОтгрузок тогда
					
						Запрос = Новый Запрос();
						Запрос.МенеджерВременныхТаблиц = лМенеджерВременныхТаблиц;
						Запрос.УстановитьПараметр("Заказ", ТекДокумент.Объект);
						Запрос.Текст = "ВЫБРАТЬ *
						|ИЗ
						|	ВремИнформацияООтгрузках КАК ВремИнформацияООтгрузках
						|ГДЕ
						|ВремИнформацияООтгрузках.Заказ = &Заказ";
						МассивОтгрузок = Запрос.Выполнить().Выгрузить();
						
						Для каждого ТекОтгрузка из МассивОтгрузок Цикл 
							
							XDTOДокумент = ВыгрузитьОтгрузкуXDTO(ПараметрыОбмена, лМенеджерВременныхТаблиц, ТекОтгрузка, КоличествоОтгрузок);
							XDTOКонтейнер.Документ.Добавить(XDTOДокумент);
							
							ВыгруженныеДокументы.Добавить().Объект =  ТекОтгрузка.Объект;
							
						КонецЦикла;
					КонецЕсли;
					
					Если ПараметрыОбмена.ВыгрузкаОплат тогда
						
						Запрос = Новый Запрос();
						Запрос.МенеджерВременныхТаблиц = лМенеджерВременныхТаблиц;
						Запрос.УстановитьПараметр("Заказ", ТекДокумент.Объект);
						Запрос.Текст = "ВЫБРАТЬ *
						|ИЗ
						|	ВремИнформацияООплатах КАК ВремИнформацияООплатах
						|ГДЕ
						|ВремИнформацияООплатах.Заказ = &Заказ";
						МассивОплат = Запрос.Выполнить().Выгрузить();
						
						Для каждого ТекОплата из МассивОплат Цикл 
							
							XDTOДокумент = ВыгрузитьОплатуXDTO(ПараметрыОбмена, лМенеджерВременныхТаблиц, ТекОплата, КоличествоОплат); 						
							XDTOКонтейнер.Документ.Добавить(XDTOДокумент);
							
							ВыгруженныеДокументы.Добавить().Объект =  ТекОплата.Объект;
							
						КонецЦикла;
					КонецЕсли;
					
				ИначеЕсли ТекДокумент.ТипОбъекта = "Отгрузка" тогда
					
					Запрос = Новый Запрос();
					Запрос.МенеджерВременныхТаблиц = лМенеджерВременныхТаблиц;
					Запрос.УстановитьПараметр("Документ", ТекДокумент.Объект);
					Запрос.Текст = "ВЫБРАТЬ *
					|ИЗ
					|	ВремИнформацияООтгрузках КАК ВремИнформацияООтгрузках
					|ГДЕ
					|ВремИнформацияООтгрузках.Документ = &Документ";
					МассивОтгрузок = Запрос.Выполнить().Выгрузить();
					
					Для каждого ТекОтгрузка из МассивОтгрузок Цикл 
						
						XDTOДокумент = ВыгрузитьОтгрузкуXDTO(ПараметрыОбмена, лМенеджерВременныхТаблиц, ТекОтгрузка, КоличествоОтгрузок);
						XDTOКонтейнер.Документ.Добавить(XDTOДокумент);
							
						ВыгруженныеДокументы.Добавить().Объект =  ТекОтгрузка.Объект;
							
					КонецЦикла;
					
				КонецЕсли;

				XDTOКоммерческаяИнформация.Контейнер.Добавить(XDTOКонтейнер);
						
				КоличествоКонтейнеров = КоличествоКонтейнеров + 1;	
	
			КонецЦикла;
			
			ИмяКаталогаXMLфайлов = Б_ОбщиеПроцедурыИФункцииОбменаССайтом.ПолучитьПутьДляПлатформы(ПараметрыОбмена.ПлатформаWindows, ПараметрыОбмена.КаталогНаДиске + "\documents\" +  Строка(Пакет)); 
			
			Успешно = ЗаписьИОтправкаXMLДанныхНаСайт(ПараметрыОбмена, XDTOКоммерческаяИнформация, ИмяКаталогаXMLфайлов, "documents", "sale", Пакет);		
			
			УдалениеПакетовИРегистрацийИзмененияПослеВыгрузкиНаСайт(Успешно, ПараметрыОбмена, "Документы", Пакет, "Документы", ВыгруженныеДокументы);
			
			Б_ОбщиеПроцедурыИФункцииОбменаССайтом.СообщитьПодробно("Выгрузка пакета " + Строка(Пакет) + " контейнеров документов завершено. Выгружено " + Строка(КоличествоКонтейнеров) + " контейнеров.", ПараметрыОбмена);
		
			лМенеджерВременныхТаблиц.Закрыть();
			
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры 			

Функция ПолучитьТаблицуДанныхДляПакетовКонтейнеровДокументов(ПараметрыОбмена, Операция)
	
	ЗапросПостроителя = ПолучитьЗапросДляВыгрузкиДанных(ПараметрыОбмена, Операция, "Заказы");
	ТаблицаВыгрузкиЗаказов = ЗапросПостроителя.Выполнить().Выгрузить(); 
	
	ТаблицаВыгрузкиОплат 	= ТаблицаВыгрузкиЗаказов.СкопироватьКолонки();
	ТаблицаВыгрузкиОтгрузок = ТаблицаВыгрузкиЗаказов.СкопироватьКолонки();
	
	Если ПараметрыОбмена.ВыгрузкаОплат тогда
		
		ЗапросПостроителя = ПолучитьЗапросДляВыгрузкиДанных(ПараметрыОбмена, Операция, "Оплаты");
		ТаблицаВыгрузкиОплат = ЗапросПостроителя.Выполнить().Выгрузить(); 
		
	КонецЕсли;
	
	Если ПараметрыОбмена.ВыгрузкаОтгрузок тогда
		
		ЗапросПостроителя = ПолучитьЗапросДляВыгрузкиДанных(ПараметрыОбмена, Операция, "Отгрузки");
		ТаблицаВыгрузкиОтгрузок = ЗапросПостроителя.Выполнить().Выгрузить(); 
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ВыгружаемыеЗаказыПоОтборам"		, ПараметрыОбмена.ВыгружаемыеЗаказыПоОтборам);
	Запрос.УстановитьПараметр("ВыгружаемыеОплатыПоОтборам"		, ПараметрыОбмена.ВыгружаемыеОплатыПоОтборам);
	Запрос.УстановитьПараметр("ВыгружаемыеОтгрузкиПоОтборам"	, ПараметрыОбмена.ВыгружаемыеОтгрузкиПоОтборам);
	
	Запрос.УстановитьПараметр("ИспользоватьОтборПоЗаказам"		, ?(ПараметрыОбмена.ВыгружаемыеЗаказыПоОтборам = Неопределено, Ложь, Истина));
	Запрос.УстановитьПараметр("ИспользоватьОтборПоОплатам"		, ?(ПараметрыОбмена.ВыгружаемыеОплатыПоОтборам = Неопределено, Ложь, Истина));
	Запрос.УстановитьПараметр("ИспользоватьОтборПоОтгрузкам"	, ?(ПараметрыОбмена.ВыгружаемыеОтгрузкиПоОтборам = Неопределено, Ложь, Истина));
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ВремЗаказы.Объект,
	|	ВремЗаказы.Заказ,
	|	ВремЗаказы.ТипОбъекта
	|ПОМЕСТИТЬ ВремЗаказы
	|ИЗ
	|	&ВремЗаказы КАК ВремЗаказы
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЗаказам
	|				ТОГДА  ВремЗаказы.Объект В (&ВыгружаемыеЗаказыПоОтборам)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремОплаты.Объект,
	|	ВремОплаты.Заказ,
	|	ВремОплаты.ТипОбъекта
	|ПОМЕСТИТЬ ВремОплаты
	|ИЗ
	|	&ВремОплаты КАК ВремОплаты
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ИспользоватьОтборПоОплатам
	|				ТОГДА  ВремОплаты.Объект В (&ВыгружаемыеОплатыПоОтборам)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|И
	|	ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЗаказам
	|				ТОГДА  ВремОплаты.Заказ В (&ВыгружаемыеЗаказыПоОтборам)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВремОтгрузки.Объект,
	|	ВремОтгрузки.Заказ,
	|	ВремОтгрузки.ТипОбъекта
	|ПОМЕСТИТЬ ВремОтгрузки
	|ИЗ
	|	&ВремОтгрузки КАК ВремОтгрузки
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ИспользоватьОтборПоОтгрузкам
	|				ТОГДА  ВремОтгрузки.Объект В (&ВыгружаемыеОтгрузкиПоОтборам)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|И
	|	ВЫБОР
	|			КОГДА &ИспользоватьОтборПоЗаказам
	|				ТОГДА  ВремОтгрузки.Заказ В (&ВыгружаемыеЗаказыПоОтборам)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВремЗаказы.Заказ КАК Объект,
	|	ВремЗаказы.ТипОбъекта
	|ИЗ
	|	ВремЗаказы КАК ВремЗаказы
	|ГДЕ
	|	ВремЗаказы.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|	И ВремЗаказы.Заказ <> НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВремОплаты.Заказ,
	|	""Заказ""
	|ИЗ
	|	ВремОплаты КАК ВремОплаты
	|ГДЕ
	|	ВремОплаты.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|	И ВремОплаты.Заказ <> НЕОПРЕДЕЛЕНО
	|	И ВремОплаты.Заказ ССЫЛКА Документ.ЗаказПокупателя
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НЕ ВремОтгрузки.Заказ ССЫЛКА Документ.ЗаказПокупателя  ИЛИ ВремОтгрузки.Заказ ЕСТЬ NULL
	|				ИЛИ ВремОтгрузки.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка) 
	|			ТОГДА ВремОтгрузки.Объект
	|		ИНАЧЕ ВремОтгрузки.Заказ
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА НЕ ВремОтгрузки.Заказ ССЫЛКА Документ.ЗаказПокупателя  ИЛИ ВремОтгрузки.Заказ ЕСТЬ NULL
	|				ИЛИ ВремОтгрузки.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка) 
	|			ТОГДА ВремОтгрузки.ТипОбъекта
	|		ИНАЧЕ ""Заказ""
	|	КОНЕЦ
	|ИЗ
	|	ВремОтгрузки КАК ВремОтгрузки
	|ГДЕ
	|	ВЫБОР
	|			КОГДА НЕ ВремОтгрузки.Заказ ССЫЛКА Документ.ЗаказПокупателя  ИЛИ ВремОтгрузки.Заказ ЕСТЬ NULL
	|					ИЛИ ВремОтгрузки.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка) 
	|				ТОГДА ВремОтгрузки.Объект
	|			ИНАЧЕ ВремОтгрузки.Заказ
	|		КОНЕЦ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|	И ВЫБОР
	|			КОГДА НЕ ВремОтгрузки.Заказ ССЫЛКА Документ.ЗаказПокупателя  ИЛИ ВремОтгрузки.Заказ ЕСТЬ NULL
	|					ИЛИ ВремОтгрузки.Заказ = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка) 
	|				ТОГДА ВремОтгрузки.Объект
	|			ИНАЧЕ ВремОтгрузки.Заказ
	|		КОНЕЦ <> НЕОПРЕДЕЛЕНО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремЗаказы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремОплаты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВремОтгрузки";
	
	Запрос.УстановитьПараметр("ВремЗаказы",ТаблицаВыгрузкиЗаказов);
	Запрос.УстановитьПараметр("ВремОплаты",ТаблицаВыгрузкиОплат);
	Запрос.УстановитьПараметр("ВремОтгрузки",ТаблицаВыгрузкиОтгрузок);
	
	ТаблицаОбъектовОбменаВыгрузки = Запрос.Выполнить().Выгрузить();
	ТаблицаОбъектовОбменаВыгрузки.Свернуть("Объект, ТипОбъекта");
	
	Возврат ТаблицаОбъектовОбменаВыгрузки; 
	
КонецФункции

Функция СформироватьВременныеТаблицыПоДокументам(ПараметрыОбмена, МассивДанных)
	
	ОбщийЗапрос = Новый Запрос;
	
	ОбщийЗапрос.УстановитьПараметр("МассивДанных"			, МассивДанных);
	ОбщийЗапрос.УстановитьПараметр("СвойствоИдМетодаОплаты"	, ПараметрыОбмена.СвойствоИдМетодаОплаты);
	ОбщийЗапрос.УстановитьПараметр("СвойствоИдентификаторОтправления", ПараметрыОбмена.СвойствоИдентификаторОтправления);
	
	
	лИспользуетсяСтатусЗаказаСвойство 	= Ложь;
	лСтатусЗаказаСвойство 				= Ложь;
	
	лНастройкиСтатусовЗаказа = ПланыОбмена.Б_ОбменССайтом.ПолучитьЗначениеКлючаСтруктурыНастроек(ПараметрыОбмена, "НастройкиСтатусовЗаказа");
	Если лНастройкиСтатусовЗаказа <> Неопределено тогда
		лИспользуетсяСтатусЗаказаСвойство = Истина;
		лСтатусЗаказаСвойство = ПараметрыОбмена.НастройкиСтатусовЗаказа.СвойствоЗаказа;
	КонецЕсли;
			
	ОбщийЗапрос.УстановитьПараметр("ИспользуетсяСтатусЗаказаСвойство"	, лИспользуетсяСтатусЗаказаСвойство);
	ОбщийЗапрос.УстановитьПараметр("СтатусЗаказаСвойство"				, лСтатусЗаказаСвойство);
	
	
	лИспользуетсяСлужбыДоставкиЗаказаСвойство 	= Ложь;
	лИспользуетсяСлужбыДоставкиОтгрузкиСвойство = Ложь;
	лСлужбаДоставкиЗаказСвойство 	= Ложь;
	лСлужбаДоставкиОтгрузкиСвойство = Ложь;
	
	лНастройкиСлужбДоставкиДокументов = ПланыОбмена.Б_ОбменССайтом.ПолучитьЗначениеКлючаСтруктурыНастроек(ПараметрыОбмена, "НастройкиСлужбДоставкиДокументов");
	Если лНастройкиСлужбДоставкиДокументов <> Неопределено тогда
		
		лСлужбаДоставкиЗаказСвойство 	= ПараметрыОбмена.НастройкиСлужбДоставкиДокументов.СвойствоЗаказа;
		лСлужбаДоставкиОтгрузкиСвойство = ПараметрыОбмена.НастройкиСлужбДоставкиДокументов.СвойствоОтгрузки;
		
		лИспользуетсяСлужбыДоставкиЗаказаСвойство = Истина;
		
		Если ПараметрыОбмена.ВыгрузкаОтгрузок тогда
			лИспользуетсяСлужбыДоставкиОтгрузкиСвойство = Истина;
		КонецЕсли;
		
	КонецЕсли;
			
	ОбщийЗапрос.УстановитьПараметр("ИспользуетсяСлужбыДоставкиЗаказаСвойство"	, лИспользуетсяСлужбыДоставкиЗаказаСвойство);
	ОбщийЗапрос.УстановитьПараметр("ИспользуетсяСлужбыДоставкиОтгрузкиСвойство"	, лИспользуетсяСлужбыДоставкиОтгрузкиСвойство);
	ОбщийЗапрос.УстановитьПараметр("СлужбаДоставкиЗаказСвойство"				, лСлужбаДоставкиЗаказСвойство);
	ОбщийЗапрос.УстановитьПараметр("СлужбаДоставкиОтгрузкиСвойство"				, лСлужбаДоставкиОтгрузкиСвойство);
	
	ОбщийЗапрос.УстановитьПараметр("ВыгружаемыеОплатыПоОтборам"		, ПараметрыОбмена.ВыгружаемыеОплатыПоОтборам);
	ОбщийЗапрос.УстановитьПараметр("ВыгружаемыеОтгрузкиПоОтборам"	, ПараметрыОбмена.ВыгружаемыеОтгрузкиПоОтборам);
	
	ОбщийЗапрос.УстановитьПараметр("ИспользоватьОтборПоОплатам"		, ?(ПараметрыОбмена.ВыгружаемыеОплатыПоОтборам = Неопределено, Ложь, Истина));
	ОбщийЗапрос.УстановитьПараметр("ИспользоватьОтборПоОтгрузкам"	, ?(ПараметрыОбмена.ВыгружаемыеОтгрузкиПоОтборам = Неопределено, Ложь, Истина));
	
	МенеджерВременныхТаблицДокументов 	= Новый МенеджерВременныхТаблиц;
	ОбщийЗапрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблицДокументов;
	
	ЗапросПоЗаказам = "ВЫБРАТЬ
	|	МассивДанных.Объект КАК Объект
	|ПОМЕСТИТЬ ВремМассивДанных
	|ИЗ
	|	&МассивДанных КАК МассивДанных
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателя.Ссылка КАК Документ,
	|	""Заказ"" КАК ТипДокумента
	|ПОМЕСТИТЬ ВремЗаказы
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ Ссылка В (ВЫБРАТЬ Объект ИЗ ВремМассивДанных)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗакрытиеЗаказовПокупателейЗаказы.ЗаказПокупателя КАК ЗаказПокупателя
	|ПОМЕСТИТЬ ВремОтмененныеЗаказы
	|ИЗ
	|Документ.ЗакрытиеЗаказовПокупателей.Заказы КАК ЗакрытиеЗаказовПокупателейЗаказы
	|ГДЕ ЗаказПокупателя В (ВЫБРАТЬ Документ ИЗ ВремЗаказы)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЗаказПокупателя
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
