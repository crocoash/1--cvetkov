// #Область СлужебныеПроцедурыИФункции
 
// Наполнение телефонной книги регистров "МИКО_опИндексНомераТелефонов" и "МИКО_опИндексНомераТелефоновБуквенные".
// 
Процедура СправочникСКонтактамиПриЗаписи(Источник, Отказ) Экспорт
	
	Если Метаданные.Имя = "ЖурналЗвонковСЭлементамиСтатистики" Тогда
	 	Возврат;
	КонецЕсли; 
	СпрСсылка = Источник.Ссылка;
	МИКО_опЗаписьКИ.СправочникСКонтактамиПриЗаписи(СпрСсылка, Отказ);

КонецПроцедуры

Процедура РегСведенийКИПриЗаписи(Источник, Отказ, Замещение) Экспорт
	
	ЕстьРегистрКИ = Метаданные.РегистрыСведений.Найти("КонтактнаяИнформация")<>Неопределено;
	 
	Если НЕ ЕстьРегистрКИ ИЛИ ТипЗнч(Источник) <> Тип(("РегистрСведенийНаборЗаписей.КонтактнаяИнформация")) Тогда
		Возврат;	
	КонецЕсли;
	
	Если Отказ Тогда Возврат; КонецЕсли; 
	// 1. Определим тип номера 
	Буквенные = Новый Соответствие;
	Числовые  = Новый Соответствие;
	
	ОбъектКИ = Источник.Отбор.Объект.Значение;
	
    МИКО_опЗаписьКИ.ДополнитьИндексыНомеров_ТЧ_КИ(Числовые, Буквенные, ОбъектКИ);
	МИКО_опЗаписьКИ.ДополнитьИндексыНомеров_РС_КИ(Числовые, Буквенные, ОбъектКИ);
	МИКО_опЗаписьКИ.ЗполнитьИндексыНомеров(Числовые, Буквенные, ОбъектКИ); 
	
КонецПроцедуры

