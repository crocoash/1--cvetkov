////////////////////////////////////////////////////////////////////////////////
// Чтение данных базы снаружи: произвольный запрос на языке запросов и справка
// по метаданным.
//
// Вход - HTTPСервис.ТелеграмВебхук, действия "query" и "meta". Защита - общий
// токен ТелеграмБот.ТокенСайта, тот же, которым сайт уже пишет номера накладных.
// Наружу база видна только сайту и подсетям Telegram (правило firewall
// «Telegram webhook 1C (8443)»), своей авторизации здесь нет.
//
// ПОЧЕМУ ПРОИЗВОЛЬНЫЙ ТЕКСТ ЗАПРОСА, А НЕ БЕЛЫЙ СПИСОК ГОТОВЫХ
//
// В языке запросов 1С нет ни INSERT, ни UPDATE, ни DELETE, а Запрос.Текст
// никакой код не выполняет - он разбирается построителем запросов. То есть
// изменить данные этим путём нельзя в принципе, и худшее, что делает кривой
// запрос, - грузит сервер и возвращает мусор. Белый список стоил бы круга
// «правка -> push -> pull -> загрузка конфигурации» на КАЖДЫЙ новый вопрос
// к базе, а вопросы возникают по ходу разбора, а не заранее.
//
// Ограничители:
//  * число строк в ответе - limit, по умолчанию 500, максимум 5000;
//  * каждый запрос пишется в журнал регистрации, событие «База.Запрос»
//    (текст, число строк, время) - чтобы было видно, кто и что спрашивал;
//  * запись остаётся невозможной, поэтому откатывать после этого канала нечего.
//
// Чего здесь НЕТ и почему: ограничения по времени выполнения. Оборвать уже
// запущенный запрос платформа не даёт, поэтому тяжёлый запрос честно займёт
// рабочий процесс до конца. Это осознанный размен: канал служебный, вызывающих
// двое (сайт и я), и очередь из тяжёлых запросов тут не образуется.
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Выполнить запрос и вернуть результат в виде, пригодном для JSON.
//
// Поля тела команды:
//  q      - Строка - текст запроса. Допускается пакет через ";": в ответ идёт
//           результат ПОСЛЕДНЕГО запроса пакета, у которого есть колонки, - так
//           работают «ПОМЕСТИТЬ ВТ; ... ВЫБРАТЬ ... ИЗ ВТ».
//  limit  - Число  - сколько строк вернуть, 1..5000, по умолчанию 500. Общего
//           числа строк ответ не содержит: считать их - значит прочитать всю
//           выборку. Нужно количество - спрашивайте КОЛИЧЕСТВО(*) запросом.
//  ids    - Булево - ссылки отдавать не строкой представления, а структурой
//           {v: представление, id: уникальный идентификатор, t: полное имя
//           таблицы}. Нужно, когда по найденному объекту надо ходить дальше.
//  params - Структура - параметры запроса, см. ЗначениеПараметра.
//
// Параметры:
//  Данные - Структура - разобранное тело команды.
//
// Возвращаемое значение:
//  Структура - ok, columns, rows, count, truncated, ms; при отказе - ok, error.
//
Функция ВыполнитьЗапрос(Знач Данные) Экспорт

	// Пользователь публикации базы - служебный, прав на чтение справочников
	// у него может не быть вовсе. Канал защищён токеном, это и есть проверка
	// «свой - чужой»; ролями её не дублируем - так же сделано в ЗаписатьНомераТТН.
	УстановитьПривилегированныйРежим(Истина);

	Итог = Новый Структура;
	Итог.Вставить("ok", Ложь);

	Текст = "";
	Данные.Свойство("q", Текст);
	Текст = СокрЛП(Строка(Текст));

	Если ПустаяСтрока(Текст) Тогда
		Итог.Вставить("error", "пустой текст запроса (поле q)");
		Возврат Итог;
	КонецЕсли;

	Предел = 500;
	ЗначениеЧисла(Данные, "limit", Предел);
	Если Предел < 1 Тогда
		Предел = 1;
	ИначеЕсли Предел > 5000 Тогда
		Предел = 5000;
	КонецЕсли;

	СИдентификаторами = Ложь;
	Данные.Свойство("ids", СИдентификаторами);
	СИдентификаторами = (СИдентификаторами = Истина);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Запрос = Новый Запрос;
	Запрос.Текст = Текст;

	// Менеджер временных таблиц нужен даже для одиночного запроса: без него
	// «ВЫБРАТЬ ... ПОМЕСТИТЬ ВТ» падает, а пакеты с временными таблицами -
	// обычный способ считать что-то в два шага.
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	ОшибкаПараметров = ЗаполнитьПараметры(Запрос, Данные);
	Если Не ПустаяСтрока(ОшибкаПараметров) Тогда
		Итог.Вставить("error", ОшибкаПараметров);
		Возврат Итог;
	КонецЕсли;

	Попытка

		Пакет = Запрос.ВыполнитьПакет();

	Исключение

		// Текст ошибки отдаём наружу как есть, в отличие от остальных команд
		// сервиса: почти всегда это синтаксическая ошибка в самом запросе,
		// и она нужна тому, кто запрос писал. Канал служебный, покупатель
		// этого текста не видит никогда.
		Итог.Вставить("error", ОписаниеОшибки());

		ЗаписьЖурналаРегистрации("База.Запрос",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Запрос не выполнен: " + ОписаниеОшибки() + Символы.ПС + Лев(Текст, 1000));

		Возврат Итог;

	КонецПопытки;

	// Запросы вида «ВЫБРАТЬ ... ПОМЕСТИТЬ ВТ» возвращают результат без колонок.
	// Идём с конца до первого результата с колонками - это и есть ответ пакета.
	Результат = Неопределено;
	Для Сч = 1 По Пакет.Количество() Цикл
		Результат = Пакет[Пакет.Количество() - Сч];
		Если Результат.Колонки.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Колонки = Новый Массив;
	Строки  = Новый Массив;
	Обрезано = Ложь;

	Если Результат <> Неопределено Тогда

		Для Каждого Колонка Из Результат.Колонки Цикл
			Колонки.Добавить(Колонка.Имя);
		КонецЦикла;

		Выборка = Результат.Выбрать();

		Пока Выборка.Следующий() Цикл

			Если Строки.Количество() >= Предел Тогда
				Обрезано = Истина;
				Прервать;
			КонецЕсли;

			СтрокаОтвета = Новый Массив;

			Для Каждого ИмяКолонки Из Колонки Цикл
				СтрокаОтвета.Добавить(ЗначениеДляОтвета(Выборка[ИмяКолонки], СИдентификаторами));
			КонецЦикла;

			Строки.Добавить(СтрокаОтвета);

		КонецЦикла;

	КонецЕсли;

	Миллисекунды = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;

	Итог.Вставить("ok",        Истина);
	Итог.Вставить("columns",   Колонки);
	Итог.Вставить("rows",      Строки);
	Итог.Вставить("count",     Строки.Количество());
	Итог.Вставить("truncated", Обрезано);
	Итог.Вставить("ms",        Миллисекунды);

	ЗаписьЖурналаРегистрации("База.Запрос",
		УровеньЖурналаРегистрации.Информация, , ,
		"строк " + Формат(Строки.Количество(), "ЧГ=0")
		+ ", мс " + Формат(Миллисекунды, "ЧГ=0")
		+ Символы.ПС + Лев(Текст, 1000));

	Возврат Итог;

КонецФункции

// Справка по метаданным: чем спрашивать имена таблиц и полей у человека,
// дешевле спросить у самой базы.
//
// Поля тела команды:
//  object - Строка - полное имя объекта («Документ.ЗаказПокупателя»,
//           «РегистрНакопления.ТоварыНаСкладах»). Пусто - список объектов.
//  like   - Строка - подстрока для отбора в списке (по имени и синониму).
//
// Возвращаемое значение:
//  Структура - для списка: ok, objects; для объекта: ok, object, synonym,
//              fields, tables, values, movements.
//
Функция ОписаниеМетаданных(Знач Данные) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Итог = Новый Структура;
	Итог.Вставить("ok", Истина);

	ИмяОбъекта = "";
	Данные.Свойство("object", ИмяОбъекта);
	ИмяОбъекта = СокрЛП(Строка(ИмяОбъекта));

	Фильтр = "";
	Данные.Свойство("like", Фильтр);
	Фильтр = НРег(СокрЛП(Строка(Фильтр)));

	// «*» - привычный способ попросить всё; отдельным случаем не делаем.
	Если ИмяОбъекта = "*" Тогда
		ИмяОбъекта = "";
	КонецЕсли;

	Если ПустаяСтрока(ИмяОбъекта) Тогда
		Итог.Вставить("objects", СписокОбъектов(Фильтр));
		Возврат Итог;
	КонецЕсли;

	Объект = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);

	Если Объект = Неопределено Тогда
		Итог.Вставить("ok", Ложь);
		Итог.Вставить("error", "объект """ + ИмяОбъекта + """ в метаданных не найден");
		Возврат Итог;
	КонецЕсли;

	Итог.Вставить("object", Объект.ПолноеИмя());
	Итог.Вставить("synonym", ТекстСинонима(Объект));

	Поля = Новый Массив;
	ДобавитьОписания(Поля, СвойствоМетаданных(Объект, "СтандартныеРеквизиты"), "стандартный");
	ДобавитьОписания(Поля, СвойствоМетаданных(Объект, "Измерения"),            "измерение");
	ДобавитьОписания(Поля, СвойствоМетаданных(Объект, "Ресурсы"),              "ресурс");
	ДобавитьОписания(Поля, СвойствоМетаданных(Объект, "Реквизиты"),            "реквизит");
	Итог.Вставить("fields", Поля);

	// Табличные части - отдельные таблицы запроса
	// («Документ.ЗаказПокупателя.Товары»), поэтому их поля перечисляем сразу:
	// иначе за каждой второй понадобился бы ещё один вызов.
	ТабличныеЧасти = СвойствоМетаданных(Объект, "ТабличныеЧасти");

	Если ТабличныеЧасти <> Неопределено Тогда

		Таблицы = Новый Массив;

		Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл

			ПоляЧасти = Новый Массив;
			ДобавитьОписания(ПоляЧасти, СвойствоМетаданных(ТабличнаяЧасть, "СтандартныеРеквизиты"), "стандартный");
			ДобавитьОписания(ПоляЧасти, СвойствоМетаданных(ТабличнаяЧасть, "Реквизиты"), "реквизит");

			Описание = Новый Структура;
			Описание.Вставить("name",   ТабличнаяЧасть.Имя);
			Описание.Вставить("fields", ПоляЧасти);

			Таблицы.Добавить(Описание);

		КонецЦикла;

		Если Таблицы.Количество() > 0 Тогда
			Итог.Вставить("tables", Таблицы);
		КонецЕсли;

	КонецЕсли;

	// Значения перечисления в метаданных есть, а в базе их нет вовсе - запросом
	// их не увидеть, только так.
	Значения = СвойствоМетаданных(Объект, "ЗначенияПеречисления");

	Если Значения <> Неопределено Тогда

		Список = Новый Массив;

		Для Каждого Значение Из Значения Цикл
			Элемент = Новый Структура;
			Элемент.Вставить("name",    Значение.Имя);
			Элемент.Вставить("synonym", ТекстСинонима(Значение));
			Список.Добавить(Элемент);
		КонецЦикла;

		Итог.Вставить("values", Список);

	КонецЕсли;

	// По каким регистрам документ двигает - самый короткий ответ на вопрос
	// «где искать последствия этого документа».
	Движения = СвойствоМетаданных(Объект, "Движения");

	Если Движения <> Неопределено Тогда

		Список = Новый Массив;

		Для Каждого Регистр Из Движения Цикл
			Список.Добавить(Регистр.ПолноеИмя());
		КонецЦикла;

		Если Список.Количество() > 0 Тогда
			Итог.Вставить("movements", Список);
		КонецЕсли;

	КонецЕсли;

	Возврат Итог;

КонецФункции

// Значение из JSON в значение 1С: то же преобразование, что для параметров
// запроса. Отдельной точкой входа - им пользуется ИзменениеСправочников,
// а дублировать разбор «{"type":"ссылка", …}» в двух модулях означало бы
// два расходящихся набора правил.
//
// Параметры:
//  Значение - Произвольный - разобранное из JSON значение.
//
// Возвращаемое значение:
//  Произвольный
//
Функция ЗначениеИзJSON(Знач Значение) Экспорт

	Возврат ЗначениеПараметра(Значение);

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Параметры запроса из тела команды.
//
// Скаляры пишутся как есть: {"params": {"Склад": "Основной", "Порог": 100}}.
// Типы, которых в JSON нет, задаются структурой с полем type:
//   {"НачалоПериода": {"type": "дата",    "value": "2026-08-01"}}
//   {"Номенклатура":  {"type": "ссылка",  "table": "Справочник.Номенклатура",
//                      "id": "e1c2..."}}
//   {"Статус":        {"type": "ссылка",  "table": "Перечисление.СтатусыЗаказов",
//                      "value": "ВРаботе"}}
// Массив превращается в массив значений - для конструкции «В (&Список)».
//
// Даты часто проще писать прямо в тексте запроса - ДАТАВРЕМЯ(2026, 8, 1),
// - и тогда параметры не нужны вовсе.
//
// Возвращаемое значение:
//  Строка - текст ошибки; пустая строка, если всё разложилось.
//
Функция ЗаполнитьПараметры(Запрос, Знач Данные)

	Параметры = Неопределено;
	Данные.Свойство("params", Параметры);

	Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого КлючЗначение Из Параметры Цикл

		Попытка
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, ЗначениеПараметра(КлючЗначение.Значение));
		Исключение
			Возврат "параметр """ + КлючЗначение.Ключ + """: " + ОписаниеОшибки();
		КонецПопытки;

	КонецЦикла;

	Возврат "";

КонецФункции

Функция ЗначениеПараметра(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Массив") Тогда

		Список = Новый Массив;

		Для Каждого Элемент Из Значение Цикл
			Список.Добавить(ЗначениеПараметра(Элемент));
		КонецЦикла;

		Возврат Список;

	КонецЕсли;

	Если ТипЗнч(Значение) <> Тип("Структура") Тогда
		Возврат Значение;
	КонецЕсли;

	Вид = "";
	Значение.Свойство("type", Вид);
	Вид = НРег(СокрЛП(Строка(Вид)));

	Знч = Неопределено;
	Значение.Свойство("value", Знч);

	Если Вид = "дата" ИЛИ Вид = "date" Тогда
		Возврат ДатаИзСтроки(Строка(Знч));
	КонецЕсли;

	Если Вид = "число" ИЛИ Вид = "number" Тогда
		Возврат Число(Знч);
	КонецЕсли;

	Если Вид = "булево" ИЛИ Вид = "bool" ИЛИ Вид = "boolean" Тогда
		Возврат Знч = Истина ИЛИ НРег(Строка(Знч)) = "true";
	КонецЕсли;

	Если Вид = "ссылка" ИЛИ Вид = "ref" Тогда

		Таблица = "";
		Значение.Свойство("table", Таблица);

		Идентификатор = "";
		Значение.Свойство("id", Идентификатор);

		Возврат СсылкаПоИмени(Строка(Таблица), Строка(Идентификатор), Строка(Знч));

	КонецЕсли;

	Если Вид = "тип" ИЛИ Вид = "type" Тогда
		Возврат Тип(Строка(Знч));
	КонецЕсли;

	Возврат Знч;

КонецФункции

// Ссылка по полному имени таблицы и идентификатору.
//
// Перечисление стоит особняком: у его значений нет уникального идентификатора,
// они адресуются именем - «Перечисление.СтатусыЗаказов» + value = "ВРаботе".
Функция СсылкаПоИмени(Знач Таблица, Знач Идентификатор, Знач ИмяЗначения)

	Точка = СтрНайти(Таблица, ".");

	Если Точка = 0 Тогда
		ВызватьИсключение "ожидалось полное имя таблицы вида ""Справочник.Номенклатура"", получено """ + Таблица + """";
	КонецЕсли;

	Вид = Лев(Таблица, Точка - 1);
	Имя = Сред(Таблица, Точка + 1);

	Если Вид = "Перечисление" Тогда
		Возврат Перечисления[Имя][ИмяЗначения];
	КонецЕсли;

	Если Вид = "Справочник" Тогда
		Менеджер = Справочники[Имя];
	ИначеЕсли Вид = "Документ" Тогда
		Менеджер = Документы[Имя];
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Менеджер = ПланыВидовХарактеристик[Имя];
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Менеджер = ПланыСчетов[Имя];
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Менеджер = ПланыОбмена[Имя];
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Менеджер = БизнесПроцессы[Имя];
	ИначеЕсли Вид = "Задача" Тогда
		Менеджер = Задачи[Имя];
	Иначе
		ВызватьИсключение "неизвестный вид таблицы """ + Вид + """";
	КонецЕсли;

	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;

	Возврат Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));

КонецФункции

// Дата из строки в любом из привычных видов: «2026-08-16», «2026-08-16 10:30:00»,
// «2026-08-16T10:30:00Z», «20260816103000». Разделители просто выбрасываем -
// разбирать их по-настоящему тут незачем.
Функция ДатаИзСтроки(Знач Текст)

	Цифры = СокрЛП(Текст);
	Цифры = СтрЗаменить(Цифры, "-", "");
	Цифры = СтрЗаменить(Цифры, ":", "");
	Цифры = СтрЗаменить(Цифры, " ", "");
	Цифры = СтрЗаменить(Цифры, "T", "");
	Цифры = СтрЗаменить(Цифры, "t", "");
	Цифры = СтрЗаменить(Цифры, "Z", "");
	Цифры = СтрЗаменить(Цифры, "z", "");

	Если СтрДлина(Цифры) = 8 Тогда
		Цифры = Цифры + "000000";
	КонецЕсли;

	Возврат Дата(Цифры);

КонецФункции

// Значение колонки в виде, который переживёт ЗаписатьJSON.
//
// Ссылки по умолчанию отдаём представлением: читать «Иванов И. И.» удобнее, чем
// идентификатор. Плата за это - обращение к объекту на каждое значение, то есть
// N+1; на пятистах строках это заметно, но приемлемо, а альтернатива (отдавать
// только идентификаторы) делает ответ нечитаемым.
Функция ЗначениеДляОтвета(Знач Значение, Знач СИдентификаторами)

	ТипЗначения = ТипЗнч(Значение);

	Если Значение = Неопределено ИЛИ ТипЗначения = Тип("Null") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ТипЗначения = Тип("Строка")
		ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Булево") Тогда

		Возврат Значение;

	КонецЕсли;

	Если ТипЗначения = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ='yyyy-MM-dd HH:mm:ss'");
	КонецЕсли;

	Если ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	КонецЕсли;

	// Картинки, макеты и присоединённые файлы в ответе не нужны, а JSON от них
	// раздувается до неразбираемого.
	Если ТипЗначения = Тип("ХранилищеЗначения") ИЛИ ТипЗначения = Тип("ДвоичныеДанные") Тогда
		Возврат "<двоичные данные>";
	КонецЕсли;

	Попытка
		Представление = Строка(Значение);
	Исключение
		Представление = "<значение не преобразуется в строку>";
	КонецПопытки;

	Если Не СИдентификаторами Тогда
		Возврат Представление;
	КонецЕсли;

	Попытка

		Ссылка = Новый Структура;
		Ссылка.Вставить("v",  Представление);
		Ссылка.Вставить("id", Строка(Значение.УникальныйИдентификатор()));
		Ссылка.Вставить("t",  Значение.Метаданные().ПолноеИмя());

		Возврат Ссылка;

	Исключение

		// Перечисления и прочее, у чего идентификатора нет, - остаются строкой.
		Возврат Представление;

	КонецПопытки;

КонецФункции

// Число из тела команды. JSON отдаёт число числом, но браузерная строка запроса
// - строкой, и «limit=200» приходит текстом.
Процедура ЗначениеЧисла(Знач Данные, Знач Ключ, Значение)

	Прочитанное = Неопределено;

	Если Не Данные.Свойство(Ключ, Прочитанное) Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Прочитанное) = Тип("Число") Тогда
		Значение = Прочитанное;
		Возврат;
	КонецЕсли;

	Попытка
		Значение = Число(СокрЛП(Строка(Прочитанное)));
	Исключение
		// Оставляем значение по умолчанию: спорить из-за limit не о чем.
	КонецПопытки;

КонецПроцедуры

// Коллекция метаданных, которой у этого вида объекта может не быть вовсе:
// у регистра нет ТабличныхЧастей, у справочника - Измерений. Проверять вид
// объекта перебором дороже и длиннее, чем спросить свойство.
Функция СвойствоМетаданных(Знач Объект, Знач Имя)

	Попытка
		Возврат Объект[Имя];
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ДобавитьОписания(Поля, Знач Коллекция, Знач Вид)

	Если Коллекция = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Реквизит Из Коллекция Цикл

		Описание = Новый Структура;
		Описание.Вставить("name",    Реквизит.Имя);
		Описание.Вставить("kind",    Вид);
		Описание.Вставить("type",    ПредставлениеТипа(Реквизит));
		Описание.Вставить("synonym", ТекстСинонима(Реквизит));

		Поля.Добавить(Описание);

	КонецЦикла;

КонецПроцедуры

Функция ПредставлениеТипа(Знач Реквизит)

	Попытка

		Результат = "";

		Для Каждого ТипЗначения Из Реквизит.Тип.Типы() Цикл
			Результат = Результат + ?(ПустаяСтрока(Результат), "", ", ") + Строка(ТипЗначения);
		КонецЦикла;

		Возврат Результат;

	Исключение

		Возврат "";

	КонецПопытки;

КонецФункции

// Синоним у объекта метаданных и у стандартного реквизита - разного типа
// (объект и строка), Строка() справляется с обоими, но не с отсутствующим.
Функция ТекстСинонима(Знач Объект)

	Попытка
		Возврат СокрЛП(Строка(Объект.Синоним));
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция СписокОбъектов(Знач Фильтр)

	Итог = Новый Структура;

	ДобавитьИмена(Итог, "Константа",              Метаданные.Константы,              Фильтр);
	ДобавитьИмена(Итог, "Справочник",             Метаданные.Справочники,            Фильтр);
	ДобавитьИмена(Итог, "Документ",               Метаданные.Документы,              Фильтр);
	ДобавитьИмена(Итог, "ЖурналДокументов",       Метаданные.ЖурналыДокументов,      Фильтр);
	ДобавитьИмена(Итог, "Перечисление",           Метаданные.Перечисления,           Фильтр);
	ДобавитьИмена(Итог, "ПланВидовХарактеристик", Метаданные.ПланыВидовХарактеристик, Фильтр);
	ДобавитьИмена(Итог, "ПланСчетов",             Метаданные.ПланыСчетов,            Фильтр);
	ДобавитьИмена(Итог, "ПланОбмена",             Метаданные.ПланыОбмена,            Фильтр);
	ДобавитьИмена(Итог, "РегистрСведений",        Метаданные.РегистрыСведений,       Фильтр);
	ДобавитьИмена(Итог, "РегистрНакопления",      Метаданные.РегистрыНакопления,     Фильтр);
	ДобавитьИмена(Итог, "РегистрБухгалтерии",     Метаданные.РегистрыБухгалтерии,    Фильтр);
	ДобавитьИмена(Итог, "БизнесПроцесс",          Метаданные.БизнесПроцессы,         Фильтр);
	ДобавитьИмена(Итог, "Задача",                 Метаданные.Задачи,                 Фильтр);

	Возврат Итог;

КонецФункции

Процедура ДобавитьИмена(Итог, Знач Ключ, Знач Коллекция, Знач Фильтр)

	Список = Новый Массив;

	Для Каждого Объект Из Коллекция Цикл

		Если Не ПустаяСтрока(Фильтр)
			И СтрНайти(НРег(Объект.Имя), Фильтр) = 0
			И СтрНайти(НРег(ТекстСинонима(Объект)), Фильтр) = 0 Тогда

			Продолжить;

		КонецЕсли;

		Список.Добавить(Объект.Имя);

	КонецЦикла;

	Если Список.Количество() > 0 Тогда
		Итог.Вставить(Ключ, Список);
	КонецЕсли;

КонецПроцедуры
