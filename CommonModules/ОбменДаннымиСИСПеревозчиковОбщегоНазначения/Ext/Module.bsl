Процедура ЗаписатьОтправленыеТТН(ТаблицаТТНДляЭкспорта, Перевозчик) Экспорт
	Перем ЭкспортированныеОбъекты;
	Если ТаблицаТТНДляЭкспорта.Колонки.Найти("is_carrier_id") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для каждого ТТН Из ТаблицаТТНДляЭкспорта Цикл
        ЭкспортированныеОбъекты = РегистрыСведений.ЭкспортированныеОбъектыВИСПеревозчиков.СоздатьНаборЗаписей();
		ЭкспортированныеОбъекты.Отбор.Объект.Установить(ТТН.ДокументСсылка);
		Запись = ЭкспортированныеОбъекты.Добавить();
		Запись.ДатаОтправки = ТекущаяДата();
		Запись.Объект = ТТН.ДокументСсылка;
		Запись.НомерДокумента = ТТН.is_carrier_id;
		Запись.Перевозчик = Перевозчик;

		РеквизитыТТН = ПолучитьПереченьРеквизитовТТНПоЗначениюРеквизита("ПунктОтправления", Истина, Перевозчик);
		ПунктОтправленияСтрокой = "";
		Для каждого ТекРеквизит Из РеквизитыТТН Цикл
			Попытка
				ТекЗначениеРеквизита = ТТН[ТекРеквизит.Код];
			Исключение
				Продолжить;
			КонецПопытки;
			СтроковоеПредставлениеЗначения = Строка(?(ТипЗнч(ТекЗначениеРеквизита) = Тип("Структура"), ТекЗначениеРеквизита.Представление, ТекЗначениеРеквизита));
			Если ПустаяСтрока(СтроковоеПредставлениеЗначения) Тогда
				Продолжить;
			КонецЕсли;
			ПунктОтправленияСтрокой = ПунктОтправленияСтрокой + ?(ПустаяСтрока(ПунктОтправленияСтрокой), "", ", ") + ?(ТекРеквизит.ДополнитьЗначениеТекстом, ТекРеквизит.ТекстДополнения, "") + СтроковоеПредставлениеЗначения;
		КонецЦикла;
		Запись.ПунктОтправления = ПунктОтправленияСтрокой;

		РеквизитыТТН = ПолучитьПереченьРеквизитовТТНПоЗначениюРеквизита("ПунктДоставки", Истина, Перевозчик);
		ПунктДоставкиСтрокой = "";
		Для каждого ТекРеквизит Из РеквизитыТТН Цикл
			Попытка
				ТекЗначениеРеквизита = ТТН[ТекРеквизит.Код];
			Исключение
				Продолжить;
			КонецПопытки;
			СтроковоеПредставлениеЗначения = Строка(?(ТипЗнч(ТекЗначениеРеквизита) = Тип("Структура"), ТекЗначениеРеквизита.Представление, ТекЗначениеРеквизита));
			Если ПустаяСтрока(СтроковоеПредставлениеЗначения) Тогда
				Продолжить;
			КонецЕсли;
			ПунктДоставкиСтрокой = ПунктДоставкиСтрокой + ?(ПустаяСтрока(ПунктДоставкиСтрокой), "", ", ") + ?(ТекРеквизит.ДополнитьЗначениеТекстом, ТекРеквизит.ТекстДополнения, "") + СтроковоеПредставлениеЗначения;
		КонецЦикла;
		Запись.ПунктДоставки = ПунктДоставкиСтрокой;

		Попытка
			ЭкспортированныеОбъекты.Записать(Истина);
		Исключение
			Сообщить("Не удалось записать данные объектов экспортированных в ИС перевозчика!" + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьВыборкуОбязательныхПолейТТН(Перевозчик) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Перевозчик", Перевозчик);
	Запрос.Текст = "ВЫБРАТЬ
	|	РеквизитыТТН.Код,
	|	РеквизитыТТН.Наименование
	|ИЗ
	|	Справочник.РеквизитыТТН КАК РеквизитыТТН
	|ГДЕ
	|	НЕ РеквизитыТТН.ПометкаУдаления
	|	И РеквизитыТТН.Владелец = &Перевозчик
	|	И РеквизитыТТН.Обязательный";

	РезультатЗапроса = Запрос.Выполнить();

	Возврат РезультатЗапроса.Выбрать();

КонецФункции

Функция ПроверитьЗаполнениеТТН(КолонкиТаблицыТТН, СтрокаТТН, ВыборкаОбязательныхПолейТТН) Экспорт
	Отказ = Ложь;

	ВыборкаОбязательныхПолейТТН.Сбросить();
	Пока ВыборкаОбязательныхПолейТТН.Следующий() Цикл

		Если КолонкиТаблицыТТН.Найти(ВыборкаОбязательныхПолейТТН.Код) = Неопределено Тогда
			ЗаголовокСообщения = СформироватьЗаголовокДокумента(СтрокаТТН.ДокументСсылка, "Ошибка заполнения документа:");
			Сообщить(ЗаголовокСообщения + " Поле: """ + ВыборкаОбязательныхПолейТТН.Наименование + """");
			Отказ = Истина;
		ИначеЕсли Не ЗначениеЗаполнено(СтрокаТТН[ВыборкаОбязательныхПолейТТН.Код].Значение) И Не ЗначениеЗаполнено(СтрокаТТН[ВыборкаОбязательныхПолейТТН.Код].Представление) Тогда
			ЗаголовокСообщения = СформироватьЗаголовокДокумента(СтрокаТТН.ДокументСсылка, "Ошибка заполнения документа:");
			Сообщить(ЗаголовокСообщения + " Поле: """ + ВыборкаОбязательныхПолейТТН.Наименование + """");
			Отказ = Истина;
		КонецЕсли;

	КонецЦикла;

	Для каждого КолонкаТаблицыТТН Из КолонкиТаблицыТТН Цикл

		ВыборкаОбязательныхПолейТТН.Сбросить();
		Если ВыборкаОбязательныхПолейТТН.НайтиСледующий(Новый Структура("Код", КолонкаТаблицыТТН.Имя)) Или КолонкаТаблицыТТН.Имя = "ДокументСсылка" Или СтрокаТТН[КолонкаТаблицыТТН.Имя] = Неопределено Тогда

			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(СтрокаТТН[КолонкаТаблицыТТН.Имя].Значение) И Не ЗначениеЗаполнено(СтрокаТТН[КолонкаТаблицыТТН.Имя].Представление) И СтрокаТТН[КолонкаТаблицыТТН.Имя].ПроверкаЗаполнения Тогда
			ЗаголовокСообщения = СформироватьЗаголовокДокумента(СтрокаТТН.ДокументСсылка, "Ошибка заполнения документа:");
			Сообщить(ЗаголовокСообщения + " Поле: """ + КолонкаТаблицыТТН.Заголовок + """");
			Отказ = Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Отказ;

КонецФункции

Функция ВыполнитьВыражение(Значение, ВходящиеДанные, Выражение)
	Если Не ПустаяСтрока(Выражение) Тогда
		Попытка
			Выполнить(Выражение);
		Исключение
			Сообщить(ОписаниеОшибки(), СтатусСообщения.Важное);
		КонецПопытки;
	КонецЕсли;

	Возврат Значение;

КонецФункции

Функция СформироватьСтруктуруТаблицыТТН(ТаблицаТТН, Перевозчик) Экспорт
	Если ТаблицаТТН = Неопределено Тогда
		ТаблицаТТН = Новый ТаблицаЗначений;
		ТаблицаТТН.Колонки.Добавить("ДокументСсылка", , "Документ");
	КонецЕсли;

	КолонкиТекТаблицы = Новый Массив;
	Для каждого Колонка Из ТаблицаТТН.Колонки Цикл

		Если Колонка.Имя = "ДокументСсылка" Тогда
			Продолжить;
		КонецЕсли;

		КолонкиТекТаблицы.Добавить(Колонка.Имя);

	КонецЦикла;

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	РеквизитыТТН.Ссылка КАК УдаляемоеПоле,
	|	РеквизитыТТН.Код КАК УдаляемаяКолонкаИмя
	|ПОМЕСТИТЬ ВТ_ОписаниеТекущейТаблицы
	|ИЗ
	|	Справочник.РеквизитыТТН КАК РеквизитыТТН
	|ГДЕ
	|	РеквизитыТТН.Код В(&КолонкиТекТаблицы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПравилаЭкспортаДокументовПравила.РеквизитТТН КАК ДобавляемоеПоле,
	|	ПравилаЭкспортаДокументовПравила.РеквизитТТН.Код КАК ДобавляемаяКолонкаИмя,
	|	ПравилаЭкспортаДокументовПравила.РеквизитТТН.Наименование КАК ДобавляемаяКолонаЗаголовок,
	|	МИНИМУМ(ПравилаЭкспортаДокументовПравила.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_НоваяТаблица
	|ИЗ
	|	Справочник.ПравилаЭкспортаДокументов.Правила КАК ПравилаЭкспортаДокументовПравила
	|ГДЕ
	|	ПравилаЭкспортаДокументовПравила.Ссылка В
	|			(ВЫБРАТЬ
	|				ИспользуемыеПравилаЭкспортаДокументов.Правило
	|			ИЗ
	|				РегистрСведений.ИспользуемыеПравилаЭкспортаДокументов КАК ИспользуемыеПравилаЭкспортаДокументов
	|			ГДЕ
	|				ИспользуемыеПравилаЭкспортаДокументов.Перевозчик = &Перевозчик)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПравилаЭкспортаДокументовПравила.РеквизитТТН,
	|	ПравилаЭкспортаДокументовПравила.РеквизитТТН.Код,
	|	ПравилаЭкспортаДокументовПравила.РеквизитТТН.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТекущаяТаблица.УдаляемаяКолонкаИмя
	|ИЗ
	|	ВТ_ОписаниеТекущейТаблицы КАК ВТ_ТекущаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НоваяТаблица КАК ВТ_НоваяТаблица
	|		ПО ВТ_ТекущаяТаблица.УдаляемоеПоле = ВТ_НоваяТаблица.ДобавляемоеПоле
	|ГДЕ
	|	ВТ_НоваяТаблица.ДобавляемоеПоле ЕСТЬ NULL 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_НоваяТаблица.ДобавляемаяКолонкаИмя,
	|	ВТ_НоваяТаблица.ДобавляемаяКолонаЗаголовок
	|ИЗ
	|	ВТ_НоваяТаблица КАК ВТ_НоваяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОписаниеТекущейТаблицы КАК ВТ_ТекущаяТаблица
	|		ПО ВТ_НоваяТаблица.ДобавляемоеПоле = ВТ_ТекущаяТаблица.УдаляемоеПоле
	|ГДЕ
	|	ВТ_ТекущаяТаблица.УдаляемоеПоле ЕСТЬ NULL 
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_НоваяТаблица.НомерСтроки");


	Запрос.УстановитьПараметр("Перевозчик", Перевозчик);
	Запрос.УстановитьПараметр("КолонкиТекТаблицы", КолонкиТекТаблицы);

	МассивРезультатовЗапроса = Запрос.ВыполнитьПакет();

	Результат = Новый Структура;
	Результат.Вставить("КолонкиУдалить", МассивРезультатовЗапроса[2].Выгрузить());
	Результат.Вставить("КолонкиДобавить", МассивРезультатовЗапроса[3].Выгрузить());

	Для каждого Колонка Из Результат.КолонкиУдалить Цикл
		ТаблицаТТН.Колонки.Удалить(Колонка.УдаляемаяКолонкаИмя);
	КонецЦикла;

	Для каждого Колонка Из Результат.КолонкиДобавить Цикл
		ТаблицаТТН.Колонки.Добавить(Колонка.ДобавляемаяКолонкаИмя, , Колонка.ДобавляемаяКолонаЗаголовок);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ЗаполнитьТаблицуТТН(ТаблицаТТН, СписокДокументов, Перевозчик) Экспорт
	
	Если ТаблицаТТН = Неопределено Тогда
		СформироватьСтруктуруТаблицыТТН(ТаблицаТТН, Перевозчик);
	КонецЕсли;

	ЗапросПравилаЭкспортаДокументов = Новый Запрос("ВЫБРАТЬ
	|	ПравилаЭкспортаДокументовПравила.Ссылка КАК Правило,
	|	ПравилаЭкспортаДокументовПравила.Ссылка.ДокументСсылка КАК ПравилоДокументСсылка,
	|	ПравилаЭкспортаДокументовПравила.РеквизитТТН КАК Поле,
	|	ПравилаЭкспортаДокументовПравила.РеквизитТТН.Код КАК ПолеИмя,
	|	ПравилаЭкспортаДокументовПравила.РеквизитДокумента,
	|	ПравилаЭкспортаДокументовПравила.Выражение,
	|	ПравилаЭкспортаДокументовПравила.ВыражениеПредставления,
	|	ПравилаЭкспортаДокументовПравила.ПроверятьЗаполнение
	|		ИЛИ ПравилаЭкспортаДокументовПравила.РеквизитТТН.Обязательный КАК ПроверятьЗаполнение
	|ИЗ
	|	Справочник.ПравилаЭкспортаДокументов.Правила КАК ПравилаЭкспортаДокументовПравила
	|ГДЕ
	|	ПравилаЭкспортаДокументовПравила.Ссылка В
	|			(ВЫБРАТЬ
	|				ИспользуемыеПравилаЭкспортаДокументов.Правило
	|			ИЗ
	|				РегистрСведений.ИспользуемыеПравилаЭкспортаДокументов КАК ИспользуемыеПравилаЭкспортаДокументов
	|			ГДЕ
	|				ИспользуемыеПравилаЭкспортаДокументов.Перевозчик = &Перевозчик)
	|ИТОГИ ПО
	|	Правило");

	ЗапросПравилаЭкспортаДокументов.УстановитьПараметр("Перевозчик", Перевозчик);


	ЗапросОбъектыПользовательскихНастроек = Новый Запрос("ВЫБРАТЬ
	|	ПравилаЭкспортаДокументовОбъектыПользовательскихНастроек.Объект		 КАК Объект,
	|	ПравилаЭкспортаДокументовОбъектыПользовательскихНастроек.ТипыОбъекта КАК ТипыОбъекта,
	|	ПравилаЭкспортаДокументовОбъектыПользовательскихНастроек.НомерСтроки КАК Приоритет
	|ИЗ
	|	Справочник.ПравилаЭкспортаДокументов.ОбъектыПользовательскихНастроек КАК ПравилаЭкспортаДокументовОбъектыПользовательскихНастроек
	|ГДЕ                                                                  
	|	ПравилаЭкспортаДокументовОбъектыПользовательскихНастроек.Ссылка = &ПравилоСсылка");


	ТаблицаПользовательскиНастроек = Новый ТаблицаЗначений;
	ТаблицаПользовательскиНастроек.Колонки.Добавить("ПолеПользовательскойНастройки");
	ТаблицаПользовательскиНастроек.Колонки.Добавить("ЗначениеПользовательскойНастройки");
	ТаблицаПользовательскиНастроек.Колонки.Добавить("ПредставлениеПользовательскойНастройки");
	ТаблицаПользовательскиНастроек.Колонки.Добавить("ПриоритетПользовательскойНастройки");



	ЗапросДанные = Новый Запрос;
	ЗапросДанные.УстановитьПараметр("СписокДокументов", СписокДокументов);

	ВыборкаНаборПравилЭкспорта = ЗапросПравилаЭкспортаДокументов.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	Пока ВыборкаНаборПравилЭкспорта.Следующий() Цикл

		ДокументСсылкаИмя = ВыборкаНаборПравилЭкспорта.ПравилоДокументСсылка.Метаданные().Имя;


		ЗапросОбъектыПользовательскихНастроек.УстановитьПараметр("ПравилоСсылка", ВыборкаНаборПравилЭкспорта.Правило);
		ВыборкаОбъектыПользовательскихНастроек = ЗапросОбъектыПользовательскихНастроек.Выполнить().Выбрать();


		ТекстЗапроса = "ВЫБРАТЬ
		|	Документ.Ссылка 															 КАК ДокументСсылка,
		|	ЕСТЬNULL(ПользовательскиеНастройкиЭкспортаДокументов.РеквизитТТН.Код , """") КАК ПолеПользовательскойНастройки,
		|	ЕСТЬNULL(ПользовательскиеНастройкиЭкспортаДокументов.Значение		 , """") КАК ЗначениеПользовательскойНастройки,
		|	ЕСТЬNULL(ПользовательскиеНастройкиЭкспортаДокументов.Представление	 , """") КАК ПредставлениеПользовательскойНастройки,
		|	ВЫБОР";

		Пока ВыборкаОбъектыПользовательскихНастроек.Следующий() Цикл
			МассивИспользуемыхТипов = ОбменДаннымиСИСПеревозчиковОбщегоНазначения.РазложитьСтрокуВМассивПодстрок(ВыборкаОбъектыПользовательскихНастроек.ТипыОбъекта, , Истина);
			Для каждого ИспользуемыйТип Из МассивИспользуемыхТипов Цикл
				ТекстЗапроса = ТекстЗапроса + "
				|		КОГДА ПользовательскиеНастройкиЭкспортаДокументов.Объект ССЫЛКА " + ИспользуемыйТип + "
				|	ТОГДА " + ВыборкаОбъектыПользовательскихНастроек.Приоритет;
			КонецЦикла;
		КонецЦикла;
		ТекстЗапроса = ТекстЗапроса + "
		|		КОГДА ПользовательскиеНастройкиЭкспортаДокументов.Объект ССЫЛКА Документ." + ДокументСсылкаИмя + " 
		|	ТОГДА 0
		|	КОНЕЦ КАК ПриоритетПользовательскойНастройки,";


		ВыборкаПравилаЭкспортаДокументов = ВыборкаНаборПравилЭкспорта.Выбрать();
		Пока ВыборкаПравилаЭкспортаДокументов.Следующий() Цикл

			Если ЗначениеЗаполнено(ВыборкаПравилаЭкспортаДокументов.РеквизитДокумента) Тогда
				ТекстЗапроса = ТекстЗапроса + "
				|	" + ВыборкаПравилаЭкспортаДокументов.РеквизитДокумента + " КАК " + ВыборкаПравилаЭкспортаДокументов.ПолеИмя + ",";
			КонецЕсли;

		КонецЦикла;

		ТекстЗапроса = Лев(ТекстЗапроса, СтрДлина(ТекстЗапроса) - 1) + " 
		|ИЗ 
		|	Документ." + ДокументСсылкаИмя + " КАК Документ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПользовательскиеНастройкиЭкспортаДокументов КАК ПользовательскиеНастройкиЭкспортаДокументов
		|		ПО Документ.Ссылка = ПользовательскиеНастройкиЭкспортаДокументов.Объект";


		ВыборкаОбъектыПользовательскихНастроек.Сбросить();
		Пока ВыборкаОбъектыПользовательскихНастроек.Следующий() Цикл
			ТекстЗапроса = ТекстЗапроса + "
			|		ИЛИ Документ." + ВыборкаОбъектыПользовательскихНастроек.Объект + " = ПользовательскиеНастройкиЭкспортаДокументов.Объект";
		КонецЦикла;


		ТекстЗапроса = ТекстЗапроса + "
		|ГДЕ 
		|	Документ.Ссылка В (&СписокДокументов)
		|ИТОГИ
		|	МИНИМУМ(ПриоритетПользовательскойНастройки)
		|ПО
		|	ДокументСсылка,
		|	ПолеПользовательскойНастройки";




		ЗапросДанные.Текст = ТекстЗапроса;
		РезультатЗапросаДанные = ЗапросДанные.Выполнить();
		ВыборкаДанные = РезультатЗапросаДанные.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		Пока ВыборкаДанные.Следующий() Цикл

			СтрокаТаблицыТТН = ТаблицаТТН.Найти(ВыборкаДанные.ДокументСсылка, "ДокументСсылка");
			Если СтрокаТаблицыТТН = Неопределено Тогда
				СтрокаТаблицыТТН = ТаблицаТТН.Добавить();
				СтрокаТаблицыТТН.ДокументСсылка = ВыборкаДанные.ДокументСсылка;
			КонецЕсли;

			ВыборкаПриоритетыПользовательскихНастроек = ВыборкаДанные.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			ТаблицаПользовательскиНастроек.Очистить();
			Пока ВыборкаПриоритетыПользовательскихНастроек.Следующий() Цикл
				ВыборкаЗначенияПользовательскихНастроек = ВыборкаПриоритетыПользовательскихНастроек.Выбрать();
				Если ВыборкаЗначенияПользовательскихНастроек.НайтиСледующий(Новый Структура("ПолеПользовательскойНастройки,ПриоритетПользовательскойНастройки", ВыборкаПриоритетыПользовательскихНастроек.ПолеПользовательскойНастройки, ВыборкаПриоритетыПользовательскихНастроек.ПриоритетПользовательскойНастройки)) Тогда
					
					Заказ = ВыборкаЗначенияПользовательскихНастроек.ДокументСсылка;

					Если Не ПустаяСтрока(ВыборкаЗначенияПользовательскихНастроек.ПолеПользовательскойНастройки) И Не ПустаяСтрока(ВыборкаЗначенияПользовательскихНастроек.ЗначениеПользовательскойНастройки) Тогда

						Строка = ТаблицаПользовательскиНастроек.Добавить();
						ЗаполнитьЗначенияСвойств(Строка, ВыборкаЗначенияПользовательскихНастроек);
						
					Если ВыборкаЗначенияПользовательскихНастроек.ПолеПользовательскойНастройки = "cost" И Не Заказ.Страховка200 Тогда
						  Строка.ЗначениеПользовательскойНастройки = Заказ.ОценочнаяСтоимость;
					КонецЕсли;

					КонецЕсли;
				КонецЕсли;
			КонецЦикла;


			Для каждого Колонка Из ТаблицаТТН.Колонки Цикл

				Если Колонка.Имя <> "ДокументСсылка" Тогда

					ВыборкаПравилаЭкспортаДокументов.Сбросить();
					Если ВыборкаПравилаЭкспортаДокументов.НайтиСледующий(Колонка.Имя, "ПолеИмя") Тогда

						ЯчейкаТТН = Новый Структура("Значение,Представление,ПроверкаЗаполнения");

						ЯчейкаТТН.ПроверкаЗаполнения = ВыборкаПравилаЭкспортаДокументов.ПроверятьЗаполнение;



						СтрокаТаблицыПользовательскихНастроек = ТаблицаПользовательскиНастроек.Найти(Колонка.Имя, "ПолеПользовательскойНастройки");
						Если СтрокаТаблицыПользовательскихНастроек <> Неопределено Тогда

							ЯчейкаТТН.Значение = СтрокаТаблицыПользовательскихНастроек.ЗначениеПользовательскойНастройки;
							ЯчейкаТТН.Представление = ?(ЗначениеЗаполнено(СтрокаТаблицыПользовательскихНастроек.ПредставлениеПользовательскойНастройки), СтрокаТаблицыПользовательскихНастроек.ПредставлениеПользовательскойНастройки, СтрокаТаблицыПользовательскихНастроек.ЗначениеПользовательскойНастройки);
							ЯчейкаТТН.Вставить("ПользовательскаяНастройка", СтрокаТаблицыПользовательскихНастроек.ПриоритетПользовательскойНастройки);
						Иначе


							Если РезультатЗапросаДанные.Колонки.Найти(Колонка.Имя) <> Неопределено Тогда
								Значение = ВыборкаДанные[Колонка.Имя];
							Иначе
								Значение = Неопределено;
							КонецЕсли;

							ЯчейкаТТН.Значение = ВыполнитьВыражение(Значение, ВыборкаДанные, ВыборкаПравилаЭкспортаДокументов.Выражение);



							ЯчейкаТТН.Представление = ЯчейкаТТН.Значение;
							ЯчейкаТТН.Представление = ВыполнитьВыражение(ЯчейкаТТН.Представление, ВыборкаДанные, ВыборкаПравилаЭкспортаДокументов.ВыражениеПредставления);




						КонецЕсли;

						СтрокаТаблицыТТН[Колонка.Имя] = ЯчейкаТТН;

					КонецЕсли;

				КонецЕсли;

			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Функция НоваяПочтаПолучитьСписокГородов(КлючAPI) Экспорт
	СписокГородов = Новый СписокЗначений;

	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
	ОбъектЗапись = Новый ЗаписьXML;
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("utf-8", Неопределено, Ложь);
	ОбъектЗапись.ОткрытьФайл(ИмяФайлаЗапроса, ПараметрыЗаписиXML);
	ОбъектЗапись.ЗаписатьОбъявлениеXML();
	ОбъектЗапись.ЗаписатьНачалоЭлемента("file");
	ОбъектЗапись.ЗаписатьНачалоЭлемента("auth");
	ОбъектЗапись.ЗаписатьТекст(КлючAPI);
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	ОбъектЗапись.ЗаписатьНачалоЭлемента("city");
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	ОбъектЗапись.Закрыть();
	ДеревоXML = ОбменДаннымиСИСПеревозчиковСервер.НоваяПочтаОтправитьЗапрос(ИмяФайлаЗапроса);

	Если Не (ДеревоXML.Строки[0].Строки[0].ЗначениеXMLЭлементаДанных = "200") Тогда
		Сообщить("Статус ответа сервера " + ДеревоXML.Строки[0].Строки[0].ЗначениеXMLЭлементаДанных);
		Возврат СписокГородов;
	КонецЕсли;

	Для каждого ТекГород Из ДеревоXML.Строки[0].Строки[1].Строки[0].Строки Цикл
		Для каждого ТекАтрибут Из ТекГород.Строки Цикл
			Если ТекАтрибут.ИмяXMLЭлементаДанных = "nameRu" Тогда
				СписокГородов.Добавить(ТекАтрибут.ЗначениеXMLЭлементаДанных);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат СписокГородов;
КонецФункции

Функция НоваяПочтаПолучитьТаблицуОтделений(КлючAPI) Экспорт
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("Город");
	ТаблицаРезультат.Колонки.Добавить("Адрес");
	ТаблицаРезультат.Колонки.Добавить("НомерОтделения");

	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
	ОбъектЗапись = Новый ЗаписьXML;
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("utf-8", Неопределено, Ложь);
	ОбъектЗапись.ОткрытьФайл(ИмяФайлаЗапроса, ПараметрыЗаписиXML);
	ОбъектЗапись.ЗаписатьОбъявлениеXML();
	ОбъектЗапись.ЗаписатьНачалоЭлемента("file");
	ОбъектЗапись.ЗаписатьНачалоЭлемента("auth");
	ОбъектЗапись.ЗаписатьТекст(КлючAPI);
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	ОбъектЗапись.ЗаписатьНачалоЭлемента("warenhouse");
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	ОбъектЗапись.Закрыть();
	ДеревоXML = ОбменДаннымиСИСПеревозчиковСервер.НоваяПочтаОтправитьЗапрос(ИмяФайлаЗапроса);

	Если Не (ДеревоXML.Строки[0].Строки[0].ЗначениеXMLЭлементаДанных = "200") Тогда
		Сообщить("Статус ответа сервера " + ДеревоXML.Строки[0].Строки[0].ЗначениеXMLЭлементаДанных);
		Возврат ТаблицаРезультат;
	КонецЕсли;

	Для каждого ТекОтделение Из ДеревоXML.Строки[0].Строки[1].Строки[0].Строки Цикл
		НоваяСтрока = ТаблицаРезультат.Добавить();
		Для каждого ТекАтрибут Из ТекОтделение.Строки Цикл
			Если ТекАтрибут.ИмяXMLЭлементаДанных = "cityRu" Тогда
				НоваяСтрока.Город = ТекАтрибут.ЗначениеXMLЭлементаДанных;
			ИначеЕсли ТекАтрибут.ИмяXMLЭлементаДанных = "addressRu" Тогда
				НоваяСтрока.Адрес = ТекАтрибут.ЗначениеXMLЭлементаДанных;
			ИначеЕсли ТекАтрибут.ИмяXMLЭлементаДанных = "number" Тогда
				НоваяСтрока.НомерОтделения = ТекАтрибут.ЗначениеXMLЭлементаДанных;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат ТаблицаРезультат;
КонецФункции

Процедура НоваяПочтаОтправитьТТН(КлючAPI, ТаблицаТТН, ПолеНомераДокумента, ПолеКоличестваМест, Отказ, РежимОтладки = Ложь, КаталогФайловТТНВРежимеОтладки = Неопределено) Экспорт
	//Номер = 1;

	//Для Стр = 1 ПО ТаблицаТТН.Количество() Цикл
	//
		Если Не РежимОтладки Тогда
			ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
		Иначе
			ИмяФайлаЗапроса = КаталогФайловТТНВРежимеОтладки + "Request_file_from_" + Формат(ТекущаяДата(), "ДФ='dd-MM-yyyy_hh-mm'") + ".tmp";
		КонецЕсли;
		ОбъектЗапись = Новый ЗаписьXML;
		ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("utf-8", Неопределено, Ложь);
		ОбъектЗапись.ОткрытьФайл(ИмяФайлаЗапроса, ПараметрыЗаписиXML);
		ОбъектЗапись.ЗаписатьОбъявлениеXML();
		ОбъектЗапись.ЗаписатьНачалоЭлемента("file");
		ОбъектЗапись.ЗаписатьНачалоЭлемента("auth");
		ОбъектЗапись.ЗаписатьТекст(КлючAPI);
		ОбъектЗапись.ЗаписатьКонецЭлемента();

				
		//НомерЗаказа = 1;
		Для каждого ТТН Из ТаблицаТТН Цикл
			//Если НомерЗаказа<>Номер Тогда
			//	
			//	НомерЗаказа = НомерЗаказа + 1;
			//	Продолжить;
			//	
			//КонецЕсли;	
			ОбъектЗапись.ЗаписатьНачалоЭлемента("order");
			Для каждого ТекЭлемент Из ТаблицаТТН.Колонки Цикл
				Если ТекЭлемент.Имя = ПолеКоличестваМест.Код Тогда
					Для каждого ТекМесто Из ТТН[ТекЭлемент.Имя] Цикл
						ОбъектЗапись.ЗаписатьНачалоЭлемента(ТекЭлемент.Имя);
						ОбъектЗапись.ЗаписатьАтрибут(ПолеКоличестваМест.ПолеОписанияМест.Код, ТекМесто);
						ОбъектЗапись.ЗаписатьКонецЭлемента();
					КонецЦикла;
				ИначеЕсли ТекЭлемент.Имя = "ДокументСсылка" Тогда
					Продолжить;
				ИначеЕсли ТТН[ТекЭлемент.Имя] = Неопределено Тогда
					Продолжить;
				ИначеЕсли ТекЭлемент.Имя = ПолеНомераДокумента.Код Тогда
					ОбъектЗапись.ЗаписатьАтрибут(ТекЭлемент.Имя, ТТН[ТекЭлемент.Имя]);
				ИначеЕсли ПустаяСтрока(Строка(ТТН[ТекЭлемент.Имя].Значение)) Тогда
					Продолжить;
				Иначе
					Если ТекЭлемент.Имя = "delivery_amount" Тогда
						Продолжить;
					КонецЕсли;
					Если ТекЭлемент.Имя = "redelivery_payment_payer" Тогда
						Продолжить;
					КонецЕсли;
					
					Если ТекЭлемент.Имя = "rcpt_contact" Тогда
						Если ЗначениеЗаполнено(Строка(ТТН["redelivery_type"].Значение))
							Тогда
							ОбъектЗапись.ЗаписатьАтрибут("delivery_in_out", Строка(ТТН["ДокументСсылка"].СуммаДокумента));
							Запрос = Новый Запрос;
							Запрос.УстановитьПараметр("Документ",ТТН["ДокументСсылка"]);
							Запрос.УстановитьПараметр("Код","redelivery_payment_payer");
							Запрос.Текст = "ВЫБРАТЬ
							               |	ПользовательскиеНастройкиЭкспортаДокументов.Значение
							               |ИЗ
							               |	РегистрСведений.ПользовательскиеНастройкиЭкспортаДокументов КАК ПользовательскиеНастройкиЭкспортаДокументов
							               |ГДЕ
							               |	ПользовательскиеНастройкиЭкспортаДокументов.Объект = &Документ
							               |	И ПользовательскиеНастройкиЭкспортаДокументов.РеквизитТТН.Код = &Код";
										   
							Если НЕ Запрос.Выполнить().Пустой() Тогда
								Результат = Запрос.Выполнить().Выгрузить()[0];
								ОбъектЗапись.ЗаписатьАтрибут("redelivery_payment_payer",Строка(Результат.Значение));
							Иначе
								ОбъектЗапись.ЗаписатьАтрибут("redelivery_payment_payer",Строка(ТТН["redelivery_payment_payer"].Значение));
                            КонецЕсли;
						Иначе
							ОбъектЗапись.ЗаписатьАтрибут("delivery_amount", Строка(ТТН["delivery_amount"].Значение));
						КонецЕсли;	
					КонецЕсли;
					 
					ОбъектЗапись.ЗаписатьАтрибут(ТекЭлемент.Имя, Строка(ТТН[ТекЭлемент.Имя].Значение));
	
				КонецЕсли;
				//ОбъектЗапись.ЗаписатьКонецЭлемента();
			КонецЦикла;
			ОбъектЗапись.ЗаписатьКонецЭлемента();
		КонецЦикла;


		ОбъектЗапись.ЗаписатьКонецЭлемента();
		ОбъектЗапись.Закрыть();

		Если Не РежимОтладки Тогда
			ДеревоXML = ОбменДаннымиСИСПеревозчиковСервер.НоваяПочтаОтправитьЗапрос(ИмяФайлаЗапроса);

			Если ДеревоXML = Неопределено Тогда
				Отказ = Истина;
			КонецЕсли;

			Если ДеревоXML.Строки[0].ИмяXMLЭлементаДанных = "errors" Тогда
				Сообщить("Ошибка выгрузки ТТН: " + ДеревоXML.Строки[0].Строки[0].ЗначениеXMLЭлементаДанных);
				Отказ = Истина;
			КонецЕсли;

			Если ДеревоXML.Строки[0].ИмяXMLЭлементаДанных = "file" Тогда
                Попытка
					ТаблицаТТН.Колонки.Добавить("is_carrier_id");

					Для каждого СтрокаXML Из ДеревоXML.Строки[0].Строки Цикл
						id = СтрокаXML.СписокАтрибутов.НайтиПоЗначению("id");
						np_id = СтрокаXML.СписокАтрибутов.НайтиПоЗначению("np_id");
						СтрокаПоid = ТаблицаТТН.Найти(id.Представление, ПолеНомераДокумента.Код);
						СтрокаПоid.is_carrier_id = np_id;
					КонецЦикла;
				Исключение
				КонецПопытки;	
			КонецЕсли;
		Иначе
			Сообщить("Включен режим отладки." + Символы.ПС + "Создан файл запроса: " + ИмяФайлаЗапроса + ".", СтатусСообщения.Информация);
		КонецЕсли;
		
	//	Номер = Номер + 1;

	//КонецЦикла;
КонецПроцедуры

Функция ПолучитьДатуДоставки(КлючAPI, ГородОтправитель, ГородПолучатель, ДатаОтправки) Экспорт
	
	//Если Не ЗначениеЗаполнено(КлючAPI) Тогда
	//	Сообщить("Не указан ключ АПИ");
	//	Возврат Дата(1,1,1);
	//КонецЕсли;	
		
	Если Не ЗначениеЗаполнено(ГородОтправитель) Тогда
		Сообщить("Не указан город отправитель");
		Возврат Дата(1,1,1);
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ГородПолучатель) Тогда
		Сообщить("Не указан город получатель");
		Возврат Дата(1,1,1);
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ДатаОтправки) Тогда
		Сообщить("Не указана дата отправки");
		Возврат Дата(1,1,1);
	КонецЕсли;	

	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("apiKey", Константы.ЛМ_КлючAPI.Получить());
	СтруктураЗапроса.Вставить("modelName", "InternetDocument");
	СтруктураЗапроса.Вставить("calledMethod", "getDocumentDeliveryDate");
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Cost", "500");
	СтруктураПараметров.Вставить("Weight", "1");
	СтруктураПараметров.Вставить("CitySender", ГородОтправитель.ГУИД);
	СтруктураПараметров.Вставить("CityRecipient", ГородПолучатель.ГУИД);
	СтруктураПараметров.Вставить("ServiceType", "WarehouseWarehouse");
	СтруктураПараметров.Вставить("DateTime", Формат(ДатаОтправки, "ДФ=dd.MM.yyyy"));
	
	СтруктураЗапроса.Вставить("methodProperties", СтруктураПараметров);
	
	ДеревоОтвета = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.ОтправитьЗапрос(СтруктураЗапроса);
	СтруктураОтвета = ПолучитьСтруктуруОтветаДатыДоставки(ДеревоОтвета,Истина);
	
	Если СтруктураОтвета.Свойство("ДатаДоставки") Тогда
		Возврат СтруктураОтвета.ДатаДоставки;
	КонецЕсли;	
	
	Если СтруктураОтвета.Свойство("Ошибки") Тогда
		СтруктураОшибок = СтруктураОтвета.Ошибки;
		Для Каждого КлючЗнач Из СтруктураОшибок Цикл
			Ключ = КлючЗнач.Ключ;
			ПоложениеИтератора = Найти(Ключ, "Итератор");
			Если ПоложениеИтератора > 0 Тогда
				Ключ = Лев(Ключ, ПоложениеИтератора - 1);
			КонецЕсли;
			Сообщить(Ключ + ": " + КлючЗнач.Значение, СтатусСообщения.Важное);
			
		КонецЦикла;	
	КонецЕсли;	
    Возврат Дата(1,1,1);
	
КонецФункции	

Функция ПолучитьСтруктуруОтветаДатыДоставки(ДеревоОтвета,ПолучатьОшибки = Ложь) Экспорт
	
	СтруктураОтвета = Новый Структура;
	Для Каждого ТекСтрока из ДеревоОтвета.Строки Цикл
		Если ТекСтрока.Тег = "root" тогда
			Для Каждого ТекСтрока1 Из ТекСтрока.Строки цикл
				Если ТекСтрока1.Тег = "success" Тогда
					Если ПолучатьОшибки = Ложь И НЕ ТекСтрока1.Тело = "true" Тогда
						Возврат СтруктураОтвета;
					КонецЕсли; 	
				ИначеЕсли ТекСтрока1.Тег = "data" Тогда
					Для Каждого ТекСтрока2 Из ТекСтрока1.Строки Цикл
						Если ТекСтрока2.Тег = "item" Тогда
							Для Каждого ТекСтрока3 Из ТекСтрока2.Строки Цикл
								Если ТекСтрока3.Тег = "DeliveryDate" Тогда
									Для Каждого ТекСтрока4 Из ТекСтрока3.Строки Цикл
										Если ТекСтрока4.Тег = "date" ТОгда
											ДатаСтрокой = ТекСтрока4.Тело;
											Попытка
												ДатаДоставки = Дата(Лев(ДатаСтрокой,4), сред(ДатаСтрокой,6,2),сред(ДатаСтрокой,9,2));
												СтруктураОтвета.Вставить("ДатаДоставки", ДатаДоставки);
											Исключение
												Сообщить("Ошибка получения даты: " + ДатаСтрокой);
											КонецПопытки;	
										КонецЕсли;
									КонецЦикла;	
								КонецЕсли;	
							КонецЦикла;
						КонецЕсли;	
					КонецЦикла;	
					
				ИначеЕсли ТекСтрока1.Тег = "errors" Тогда
					Ошибки = Новый Структура;
					итераторОшибок = 0;
					Для Каждого ТекСтрока2 Из ТекСтрока1.Строки Цикл
						Если ЗначениеЗаполнено(ТекСтрока2.Тег) и ЗначениеЗаполнено(ТекСтрока2.Тело) Тогда
							Если Ошибки.Свойство(ТекСтрока2.Тег) Тогда
								итераторОшибок = итераторОшибок + 1;
								Ошибки.Вставить(ТекСтрока2.Тег + "Итератор" + Формат(итераторОшибок,"ЧГ="),ТекСтрока2.Тело)
							Иначе	
								Ошибки.Вставить(ТекСтрока2.Тег,ТекСтрока2.Тело);
							КонецЕсли;	
						КонецЕсли;	
					КонецЦикла;	
					
					СтруктураОтвета.Вставить("Ошибки",Ошибки);
					
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;		
	КонецЦикла;	
	Возврат СтруктураОтвета;
	
КонецФункции	

Функция ПолучитьДатуДоставки_Ст(КлючAPI, ГородОтправитель, ГородПолучатель, ДатаОтправки) Экспорт
	
	Если Не ЗначениеЗаполнено(КлючAPI) Тогда
		Сообщить("Не указан ключ АПИ");
		Возврат Дата(1,1,1);
	КонецЕсли;	
		
	Если Не ЗначениеЗаполнено(ГородОтправитель) Тогда
		Сообщить("Не указан город отправитель");
		Возврат Дата(1,1,1);
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ГородПолучатель) Тогда
		Сообщить("Не указан город получатель");
		Возврат Дата(1,1,1);
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ДатаОтправки) Тогда
		Сообщить("Не указана дата отправки");
		Возврат Дата(1,1,1);
	КонецЕсли;	

	
	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
		
	ОбъектЗапись = Новый ЗаписьXML;
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("utf-8", Неопределено, Ложь);
	ОбъектЗапись.ОткрытьФайл(ИмяФайлаЗапроса, ПараметрыЗаписиXML);
	ОбъектЗапись.ЗаписатьОбъявлениеXML();
	ОбъектЗапись.ЗаписатьНачалоЭлемента("file");
	ОбъектЗапись.ЗаписатьНачалоЭлемента("auth");
	ОбъектЗапись.ЗаписатьТекст(КлючAPI);
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	ОбъектЗапись.ЗаписатьНачалоЭлемента("getEstimatedDeliveryDate");
	
	ОбъектЗапись.ЗаписатьНачалоЭлемента("senderCity");
	ОбъектЗапись.ЗаписатьТекст(СокрЛП(ГородОтправитель));
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	
	ОбъектЗапись.ЗаписатьНачалоЭлемента("recipientCity");
	ОбъектЗапись.ЗаписатьТекст(СокрЛП(ГородПолучатель));
	ОбъектЗапись.ЗаписатьКонецЭлемента();

	ОбъектЗапись.ЗаписатьНачалоЭлемента("date");
	ОбъектЗапись.ЗаписатьТекст(Формат(ДатаОтправки, "ДФ=dd.MM.yyyy"));
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	
	ОбъектЗапись.ЗаписатьНачалоЭлемента("deliveryTypeId");
	ОбъектЗапись.ЗаписатьТекст("4");
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	
	ОбъектЗапись.ЗаписатьНачалоЭлемента("satDelivery");
	ОбъектЗапись.ЗаписатьТекст("1");
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	ОбъектЗапись.ЗаписатьКонецЭлемента();
	ОбъектЗапись.Закрыть();


	ДеревоXML = ОбменДаннымиСИСПеревозчиковСервер.НоваяПочтаОтправитьЗапрос(ИмяФайлаЗапроса);
	Отказ = Ложь;
	Если ДеревоXML = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;

	Если ДеревоXML.Строки[0].ИмяXMLЭлементаДанных = "errors" Тогда
		Сообщить("Ошибка получения даты доставки: " + ДеревоXML.Строки[0].Строки[0].ЗначениеXMLЭлементаДанных);
		Отказ = Истина;
	КонецЕсли;
	если Не отказ тогда
		Попытка
			Если ДеревоXML.Строки[0].ИмяXMLЭлементаДанных = "file" Тогда
				Если ДеревоXML.Строки[0].Строки.Количество() > 0 Тогда
					Если ДеревоXML.Строки[0].Строки[0].ИмяXMLЭлементаДанных = "estimatedDeliveryDate" Тогда
					 	ДатаДоставкиСтрокой = ДеревоXML.Строки[0].Строки[0].ЗначениеXMLЭлементаДанных;
						ДатаДоставкиСтрокой = СокрЛП(ДатаДоставкиСтрокой);
						День = Число(Лев(ДатаДоставкиСтрокой, 2));
						Месяц = Число(Сред(ДатаДоставкиСтрокой,4,2));
						Год = Число(Прав(ДатаДоставкиСтрокой,4));
						ДатаДоставки = Дата(Год, Месяц, День);
						Возврат ДатаДоставки;
					КонецЕсли;	
				КонецЕсли;		
			КонецЕсли;
		Исключение
		КонецПопытки;	
			
    КонецЕсли;
	
	Возврат Дата(1,1,1);

	
КонецФункции	

