			АдресОтправителя = СтруктураНастройки.АдресОтправителя.ГУИД; 			
		КонецЕсли;
		
		Если СтруктураНастройки.Свойство("СкладОтправителя") Тогда
			СкладОтправителя = СтруктураНастройки.СкладОтправителя.ГУИД; 			
		КонецЕсли;
		
		Если СтруктураНастройки.Свойство("КонтактноеЛицоОтправителя") Тогда
			КонтактноеЛицоОтправителя = СтруктураНастройки.КонтактноеЛицоОтправителя.ГУИД; 			
		КонецЕсли;	
	КонецЕсли;	

	
	Если Не ЗначениеЗаполнено(ГородОтправитель) Тогда
		Сообщить("Не указан город отправитель");
		Возврат Дата(1,1,1);
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ГородПолучатель) Тогда
		Сообщить("Не указан город получатель");
		Возврат Дата(1,1,1);
	КонецЕсли;	
	
	Если Число(Вес)<=0 Тогда
		Сообщить("Не указан вес");
		Возврат Дата(1,1,1);
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ВидГруза) Тогда
		Сообщить("Не указан вид груза");
		Возврат Дата(1,1,1);
	КонецЕсли;	
	
	ТекВес=СтрЗаменить(Строка(вес)," ","");
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("apiKey", КлючAPI);
	СтруктураЗапроса.Вставить("modelName", "InternetDocument");
	СтруктураЗапроса.Вставить("calledMethod", "getDocumentPrice");
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("CitySender", ГородОтправитель.ГУИД);
	СтруктураПараметров.Вставить("CityRecipient", ГородПолучатель.ГУИД);
    СтруктураПараметров.Вставить("Weight", СтрЗаменить(ТекВес,",","."));
	СтруктураПараметров.Вставить("ServiceType", "WarehouseWarehouse"); 
	СтруктураПараметров.Вставить("Cost", Формат(ОбъявленнаяСтоимость,"ЧГ=0"));
	СтруктураПараметров.Вставить("CargoType", ВидГруза.ГУИД);
	СтруктураПараметров.Вставить("Sender", Отправитель);
	Если ТехнологияДоставки = "DoorsDoors" ИЛИ ТехнологияДоставки = "DoorsWarehouse" Тогда
		СтруктураПараметров.Вставить("SenderAddress", АдресОтправителя);
	Иначе
		СтруктураПараметров.Вставить("SenderAddress", СкладОтправителя);
	КонецЕсли;	
	СтруктураПараметров.Вставить("ContactSender", КонтактноеЛицоОтправителя);
	СтруктураПараметров.Вставить("SendersPhone", ТелефонОтправителя);

	//СтруктураПараметров.Вставить("SeatsAmount", СокрЛП(Мест));
	//СтруктураПараметров.Вставить("RedeliveryCalculate", "1");
	//СтруктураПараметров.Вставить("Amount", "1");  	
	
	СтруктураЗапроса.Вставить("methodProperties", СтруктураПараметров);
	
	ДеревоОтвета = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.ОтправитьЗапрос(СтруктураЗапроса);
	СтруктураОтвета = ПолучитьСтруктуруОтветаСтоимостиДоставки(ДеревоОтвета,Истина);
	
	Если СтруктураОтвета.Свойство("СтоимостьДоставки") Тогда
		Возврат СтруктураОтвета.СтоимостьДоставки;
	КонецЕсли;	
	
	Если СтруктураОтвета.Свойство("Ошибки") Тогда
		СтруктураОшибок = СтруктураОтвета.Ошибки;
		Для Каждого КлючЗнач Из СтруктураОшибок Цикл
			Ключ = КлючЗнач.Ключ;
			ПоложениеИтератора = Найти(Ключ, "Итератор");
			Если ПоложениеИтератора > 0 Тогда
				Ключ = Лев(Ключ, ПоложениеИтератора - 1);
			КонецЕсли;
			Сообщить(Ключ + ": " + КлючЗнач.Значение, СтатусСообщения.Важное);
			нул=0;
		КонецЦикла;	
	КонецЕсли;	
    Возврат нул;
	
КонецФункции	

Функция DPDСформироватьТаблицуДляЗаписиСтрокиТТН(КолонкиТТН, Перевозчик)
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Код");
	Таблица.Колонки.Добавить("Параметр");

	Для каждого ТекКолонкаТТН Из КолонкиТТН Цикл

		Если ТекКолонкаТТН.Имя = "ДокументСсылка" Тогда
			Продолжить;
		КонецЕсли;

		НовСтрока = Таблица.Добавить();
		ИмяДопПараметра = Справочники.РеквизитыТТН.НайтиПоКоду(ТекКолонкаТТН.Имя, , , Перевозчик).ДопТекстовыеДанные;
		Если Не ПустаяСтрока(ИмяДопПараметра) Тогда
			НовСтрока["Параметр"] = ИмяДопПараметра;
			ИмяДопПараметра = "_" + ИмяДопПараметра;
		КонецЕсли;

		МассивУровней = РазложитьСтрокуВМассивПодстрок(СтрЗаменить(ТекКолонкаТТН.Имя, ИмяДопПараметра, ""), "_");
		Для Ы = 0 По МассивУровней.ВГраница() Цикл

			Если Таблица.Колонки.Найти("Уровень" + Ы) = Неопределено Тогда
				Таблица.Колонки.Добавить("Уровень" + Ы, Новый ОписаниеТипов("Строка"));
			КонецЕсли;
			НовСтрока["Уровень" + Ы] = МассивУровней[Ы];

		КонецЦикла;

		НовСтрока["Код"] = ТекКолонкаТТН.Имя;

	КонецЦикла;

	Возврат Таблица;

КонецФункции

Процедура DPDЗаписатьУровень(Знач ТаблицаДляЗаписиСтрокиТТН, ОбъектЗапись, Знач НомерУровня, ВыведенныеРеквизиты)
	НомерУровня = НомерУровня + 1;
	Для каждого ТекСтрока Из ТаблицаДляЗаписиСтрокиТТН Цикл

		Если Не (ВыведенныеРеквизиты.НайтиПоЗначению(ТекСтрока["Код"]) = Неопределено) Тогда
			Продолжить;
		КонецЕсли;

		темпТаблицаДляЗаписиСтрокиТТН = ТаблицаДляЗаписиСтрокиТТН.Скопировать(Новый Структура("Уровень" + НомерУровня, ТекСтрока["Уровень" + НомерУровня]));

		Если ТекСтрока["Уровень" + НомерУровня] = "extraParam" Тогда
			Для каждого ТекПараметр Из темпТаблицаДляЗаписиСтрокиТТН Цикл
				ОбъектЗапись.ЗаписатьНачалоЭлемента(ТекПараметр["Уровень" + НомерУровня]);
				ОбъектЗапись.ЗаписатьНачалоЭлемента("name");
				ОбъектЗапись.ЗаписатьТекст(ТекПараметр["Уровень" + (НомерУровня + 1)]);
				ОбъектЗапись.ЗаписатьКонецЭлемента();
				ОбъектЗапись.ЗаписатьНачалоЭлемента("value");
				ОбъектЗапись.ЗаписатьТекст(ТекПараметр["Значение"]);
				ОбъектЗапись.ЗаписатьКонецЭлемента();
				ОбъектЗапись.ЗаписатьКонецЭлемента();
				ВыведенныеРеквизиты.Добавить(ТекПараметр["Код"]);
			КонецЦикла;

		ИначеЕсли ТекСтрока["Уровень" + НомерУровня] = "extraService" Тогда
			Для каждого ТекОпция Из темпТаблицаДляЗаписиСтрокиТТН Цикл
				ОбъектЗапись.ЗаписатьНачалоЭлемента(ТекОпция["Уровень" + НомерУровня]);
				ОбъектЗапись.ЗаписатьНачалоЭлемента("esCode");
				ОбъектЗапись.ЗаписатьТекст(ТекОпция["Уровень" + (НомерУровня + 1)]);
				ОбъектЗапись.ЗаписатьКонецЭлемента();
				Если Не ПустаяСтрока(ТекОпция["Параметр"]) Тогда
					ОбъектЗапись.ЗаписатьНачалоЭлемента("param");
					ОбъектЗапись.ЗаписатьНачалоЭлемента("name");
					ОбъектЗапись.ЗаписатьТекст(ТекОпция["Параметр"]);
					ОбъектЗапись.ЗаписатьКонецЭлемента();
					ОбъектЗапись.ЗаписатьНачалоЭлемента("value");
					ОбъектЗапись.ЗаписатьТекст(ТекОпция["Значение"]);
					ОбъектЗапись.ЗаписатьКонецЭлемента();
					ОбъектЗапись.ЗаписатьКонецЭлемента();
				КонецЕсли;
				ОбъектЗапись.ЗаписатьКонецЭлемента();
				ВыведенныеРеквизиты.Добавить(ТекОпция["Код"]);
			КонецЦикла;

		ИначеЕсли темпТаблицаДляЗаписиСтрокиТТН.Количество() = 1 Тогда
			ОбъектЗапись.ЗаписатьНачалоЭлемента(ТекСтрока["Уровень" + НомерУровня]);
			ОбъектЗапись.ЗаписатьТекст(ТекСтрока["Значение"]);
			ОбъектЗапись.ЗаписатьКонецЭлемента();
			ВыведенныеРеквизиты.Добавить(ТекСтрока["Код"]);
		Иначе

			ОбъектЗапись.ЗаписатьНачалоЭлемента(ТекСтрока["Уровень" + НомерУровня]);
			DPDЗаписатьУровень(темпТаблицаДляЗаписиСтрокиТТН, ОбъектЗапись, НомерУровня, ВыведенныеРеквизиты);
			ОбъектЗапись.ЗаписатьКонецЭлемента();

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура DPDЗаписатьСтрокуТТН(Знач СтрокаТТН, Знач ТаблицаДляЗаписиСтрокиТТНИсходная, ОбъектЗапись, Знач ИмяУровня)
	Перем ТаблицаДляЗаписиСтрокиТТН;
	ТаблицаДляЗаписиСтрокиТТН = ТаблицаДляЗаписиСтрокиТТНИсходная.Скопировать(Новый Структура("Уровень0", ИмяУровня));

	ТаблицаДляЗаписиСтрокиТТН.Колонки.Добавить("Значение");

	Для каждого ТекСтрока Из ТаблицаДляЗаписиСтрокиТТН Цикл
		Если СтрокаТТН[ТекСтрока.Код] = Неопределено Тогда
			Продолжить;
		Иначе
			ТекСтрока.Значение = Строка(СтрокаТТН[ТекСтрока.Код].Значение);
		КонецЕсли;
	КонецЦикла;

	ВыведенныеРеквизиты = Новый СписокЗначений;
	Количество = ТаблицаДляЗаписиСтрокиТТН.Количество();
	Для Ы = 0 По Количество - 1 Цикл
		Если ТаблицаДляЗаписиСтрокиТТН[Количество - 1 - Ы].Значение = Неопределено Тогда
			ТаблицаДляЗаписиСтрокиТТН.Удалить(Количество - 1 - Ы);
		ИначеЕсли ПустаяСтрока(ТаблицаДляЗаписиСтрокиТТН[Количество - 1 - Ы].Значение) Тогда
			ТаблицаДляЗаписиСтрокиТТН.Удалить(Количество - 1 - Ы);
		КонецЕсли;
	КонецЦикла;
	DPDЗаписатьУровень(ТаблицаДляЗаписиСтрокиТТН, ОбъектЗапись, 0, ВыведенныеРеквизиты);

КонецПроцедуры

Процедура DPDОтправитьТТН(КлиентскийКлюч, НастройкиОбмена, ТаблицаТТНИсходная, Отказ, РежимОтладки = Ложь, КаталогФайловТТНВРежимеОтладки = Неопределено) Экспорт
	Перем Каталог, ДополнительныеПараметры;
	Если РежимОтладки Тогда
		Каталог = КаталогФайловТТНВРежимеОтладки;
	Иначе
		Каталог = КаталогВременныхФайлов();
	КонецЕсли;

	ДополнительныеПараметры = НастройкиОбмена.ДополнительныеПараметры.Получить();
	Если ДополнительныеПараметры = Неопределено Тогда
		ИмяВложения = "TTN";
	Иначе
		НайденныеСтроки = ДополнительныеПараметры.НайтиСтроки(Новый Структура("Параметр", "Отправка ТТН: Имя файла"));
		Если НайденныеСтроки.Количество() И Не ПустаяСтрока(НайденныеСтроки[0].Значение) Тогда
			ИмяВложения = НайденныеСтроки[0].Значение;
		Иначе
			ИмяВложения = "TTN";
			Сообщить("Не заполнен параметр ""Отправка ТТН: Имя файла"".Файл сформирован с именем ""TTN""!", СтатусСообщения.Важное);
		КонецЕсли;
	КонецЕсли;
	ИмяФайла = Каталог + ИмяВложения + ".xml";

	ТаблицаДляЗаписиСтрокиТТН = DPDСформироватьТаблицуДляЗаписиСтрокиТТН(ТаблицаТТНИсходная.Колонки, НастройкиОбмена.Перевозчик);

	ОбъектЗапись = Новый ЗаписьXML;
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML("utf-8", Неопределено, Ложь);
	ОбъектЗапись.ОткрытьФайл(ИмяФайла, ПараметрыЗаписиXML);
	ОбъектЗапись.ЗаписатьОбъявлениеXML();
	ОбъектЗапись.ЗаписатьНачалоЭлемента("ns2:dpdOrdersData");
	ОбъектЗапись.ЗаписатьСоответствиеПространстваИмен("ns2", "http://dpd.ru/ws/order2/2012-04-04");

	ОбъектЗапись.ЗаписатьНачалоЭлемента("auth");
	DPDЗаписатьСтрокуТТН(ТаблицаТТНИсходная[0], ТаблицаДляЗаписиСтрокиТТН, ОбъектЗапись, "auth");
	Если Не ПустаяСтрока(КлиентскийКлюч) Тогда
		ОбъектЗапись.ЗаписатьНачалоЭлемента("clientKey");
		ОбъектЗапись.ЗаписатьТекст(КлиентскийКлюч);
		ОбъектЗапись.ЗаписатьКонецЭлемента();
	КонецЕсли;
	ОбъектЗапись.ЗаписатьКонецЭлемента();

	ОбъектЗапись.ЗаписатьНачалоЭлемента("header");
	DPDЗаписатьСтрокуТТН(ТаблицаТТНИсходная[0], ТаблицаДляЗаписиСтрокиТТН, ОбъектЗапись, "header");
	ОбъектЗапись.ЗаписатьКонецЭлемента();

	Для каждого ТекСтрокаТТН Из ТаблицаТТНИсходная Цикл
		ОбъектЗапись.ЗаписатьНачалоЭлемента("order");
		DPDЗаписатьСтрокуТТН(ТекСтрокаТТН, ТаблицаДляЗаписиСтрокиТТН, ОбъектЗапись, "order");
		ОбъектЗапись.ЗаписатьКонецЭлемента();
	КонецЦикла;

	ОбъектЗапись.ЗаписатьКонецЭлемента();
	ОбъектЗапись.Закрыть();

	Если Не РежимОтладки И Не Отказ Тогда
		ОтправкаФайлаПоЭлектроннойПочте(НастройкиОбмена, ИмяФайла, ИмяВложения, Отказ);
	КонецЕсли;

	Если Не РежимОтладки И Не Отказ Тогда
		ТаблицаТТНИсходная.Колонки.Добавить("is_carrier_id", Новый ОписаниеТипов("Строка", Неопределено, Новый КвалификаторыСтроки(128)));
	КонецЕсли;

КонецПроцедуры

Функция СоздатьРеестрНакладных(МассивНомеровТТН) Экспорт
	//Для Каждого ТТН Из МассивНомеровТТН Цикл 
	//	Если 
	//КонецЦикла;
	
	
	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
	СтруктураЗапроса = Новый Структура;
	КлючАПИ = Константы.ЛМ_КлючAPI.Получить();
	СтруктураЗапроса.Вставить("apiKey", КлючАПИ);
	СтруктураЗапроса.Вставить("modelName", "ScanSheet");
	СтруктураЗапроса.Вставить("calledMethod", "insertDocuments");
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("DocumentRefs", МассивНомеровТТН);
	СтруктураЗапроса.Вставить("methodProperties", СтруктураПараметров);
	
	ДеревоОтвета = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.ОтправитьЗапрос(СтруктураЗапроса);
	
	ИдентификаторРеестра = "";
	Для Каждого ТекСтрока Из ДеревоОтвета.Строки Цикл
		Если ТекСтрока.Тег = "root" Тогда
			Для Каждого ТекСтрока1 из ТекСтрока.Строки Цикл
				Если ТекСтрока1.Тег = "data" Тогда
					Для Каждого ТекСтрока2 Из ТекСтрока1.Строки Цикл
						Если ТекСтрока2.Тег = "item" Тогда
							Для Каждого ТекСтрока3 Из ТекСтрока2.Строки Цикл
								Если ТекСтрока3.Тег = "Ref" Тогда
									Если ЗначениеЗаполнено(ТекСтрока3.Тело) тогда
										ИдентификаторРеестра = ТекСтрока3.Тело;
									КонецЕсли;	
								КонецЕсли;
							КонецЦикла;	
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
	Если ЗначениеЗаполнено(ИдентификаторРеестра) тогда
		ЗапуститьПриложение("https://my.novaposhta.ua/scanSheet/printScanSheet/refs[]/" + ИдентификаторРеестра + "/type/pdf/apiKey/" + КлючАПИ);
	КонецЕсли;	
	
КонецФункции	

Процедура УдалитьИзРеестра(МассивНомеровТТН) Экспорт
	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
	
	СтруктураЗапроса = Новый Структура;
	КлючАПИ = Константы.ЛМ_КлючAPI.Получить();
	СтруктураЗапроса.Вставить("apiKey", КлючАПИ);
	СтруктураЗапроса.Вставить("modelName", "ScanSheet");
	СтруктураЗапроса.Вставить("calledMethod", "removeDocuments");
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("DocumentRefs", МассивНомеровТТН);
	СтруктураЗапроса.Вставить("methodProperties", СтруктураПараметров);
	
	ДеревоОтвета = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.ОтправитьЗапрос(СтруктураЗапроса);
	
	ИдентификаторРеестра = "";
	Для Каждого ТекСтрока Из ДеревоОтвета.Строки Цикл
		Если ТекСтрока.Тег = "root" Тогда
			Для Каждого ТекСтрока1 из ТекСтрока.Строки Цикл
				Если ТекСтрока1.Тег = "data" Тогда
					Для Каждого ТекСтрока2 Из ТекСтрока1.Строки Цикл
						Если ТекСтрока2.Тег = "item" Тогда
							Для Каждого ТекСтрока3 Из ТекСтрока2.Строки Цикл
								Если ТекСтрока3.Тег = "Ref" Тогда
									Если ЗначениеЗаполнено(ТекСтрока3.Тело) тогда
										ИдентификаторРеестра = ТекСтрока3.Тело;
									КонецЕсли;	
								КонецЕсли;
							КонецЦикла;	
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;	
	//Если ЗначениеЗаполнено(ИдентификаторРеестра) тогда
	//	ЗапуститьПриложение("https://my.novaposhta.ua/scanSheet/printScanSheet/refs[]/" + ИдентификаторРеестра + "/type/pdf/apiKey/" + КлючАПИ);
	//КонецЕсли;	
	//
КонецПроцедуры

Процедура ПечатьРеестров(МассивНомеровТТН, МассивДат) Экспорт
	
	
	Для Каждого ТекДата Из МассивДат цикл
	
		ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла();
		
		СтруктураЗапроса = Новый Структура;
		КлючАПИ = Константы.ЛМ_КлючAPI.Получить();
		СтруктураЗапроса.Вставить("apiKey", КлючАПИ);
		СтруктураЗапроса.Вставить("modelName", "InternetDocument");
		СтруктураЗапроса.Вставить("calledMethod", "getDocumentList");
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("DateTime", Формат(ТекДата, "ДФ=dd.MM.yyyy"));
		СтруктураЗапроса.Вставить("methodProperties", СтруктураПараметров);
		
		ДеревоОтвета = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.ОтправитьЗапрос(СтруктураЗапроса);
		
		ИдентификаторРеестра = "";
		НомераРеестров = Новый Массив;
		Для Каждого ТекСтрока Из ДеревоОтвета.Строки Цикл
			Если ТекСтрока.Тег = "root" Тогда
				Для Каждого ТекСтрока1 из ТекСтрока.Строки Цикл
					Если ТекСтрока1.Тег = "data" Тогда
						Для Каждого ТекСтрока2 Из ТекСтрока1.Строки Цикл
							Если ТекСтрока2.Тег = "item" Тогда
								НомерТТН = "";
								НомерРеестра = "";
								Для Каждого ТекСтрока3 Из ТекСтрока2.Строки Цикл
									Если ТекСтрока3.Тег = "IntDocNumber" Тогда
										Если ЗначениеЗаполнено(ТекСтрока3.Тело) тогда
											НомерТТН = ТекСтрока3.Тело;
										КонецЕсли;	
									ИначеЕсли ТекСтрока3.Тег = "ScanSheetNumber" Тогда
										Если ЗначениеЗаполнено(ТекСтрока3.Тело) тогда
											НомерРеестра = ТекСтрока3.Тело;
										КонецЕсли;		
									КонецЕсли;
								КонецЦикла;	
								Если НомерТТН <> "" И МассивНомеровТТН.Найти(НомерТТН) <> Неопределено Тогда
									НомераРеестров.Добавить(НомерРеестра);
								КонецЕсли;	
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
	Для Каждого ТекНомерРеестра Из НомераРеестров цикл
		Если ЗначениеЗаполнено(ТекНомерРеестра) тогда
			ЗапуститьПриложение("https://my.novaposhta.ua/scanSheet/printScanSheet/refs[]/" + ТекНомерРеестра + "/type/pdf/" + КлючАПИ + "/");
		КонецЕсли;
	КонецЦикла;
	//Если ЗначениеЗаполнено(ИдентификаторРеестра) тогда
	//	ЗапуститьПриложение("https://my.novaposhta.ua/scanSheet/printScanSheet/refs[]/" + ИдентификаторРеестра + "/type/pdf/apiKey/" + КлючАПИ);
	//КонецЕсли;	
	//
КонецПроцедуры

Процедура СформироватьЭкспрессНакладные(ТаблицаДокументов,МассивОставшихсяОбъектов,Склад) Экспорт
	Если ТаблицаДокументов.КОлонки.Найти("is_carrier_id") = Неопределено Тогда
		ТаблицаДокументов.КОлонки.Добавить("is_carrier_id");
	КонецЕсли;	
	Для Каждого ТекСтр Из ТаблицаДокументов Цикл
		СтруктураДляЭН = Новый Структура;
		СтруктураДляЭН.Вставить("КонтрагентДоставки", Справочники.ЛМ_Контрагенты.НайтиПоРеквизиту("ГУИД", ТекСтр.rcpt_name.Значение));
		СтруктураДляЭН.Вставить("НаименованиеКонтрагента", ТекСтр.rcpt_name.Представление);
		СтруктураДляЭН.Вставить("ДокументОснование", ТекСтр.ДокументСсылка);
//		СтруктураДляЭН.Вставить("НомерПакета", ТекСтр.PackingNumber.Значение);
		
		КЛ = Справочники.ЛМ_КонтактныеЛица.НайтиПоРеквизиту("ГУИД", ТекСтр.rcpt_contact.Значение);
		Если ЗначениеЗаполнено(КЛ) тогда
			СтруктураДляЭН.Вставить("КонтактноеЛицоПолучателя", КЛ);
			СтруктураДляЭН.Вставить("ФамилияПолучателя", КЛ.Фамилия);
			СтруктураДляЭН.Вставить("ИмяПолучателя", КЛ.Имя);
			СтруктураДляЭН.Вставить("ОтчествоПолучателя", КЛ.Отчество);
		КонецЕсли;
		
		СтруктураДляЭН.Вставить("ТелефонПолучателя", ТекСтр.rcpt_phone_num.Значение);
		СтруктураДляЭН.Вставить("ГородПолучателя", Справочники.ЛМ_Города.НайтиПоРеквизиту("ГУИД", ТекСтр.rcpt_city_name.Значение));
		ТехнологияДоставки = ТекСтр.ДокументСсылка.ТехнологияДоставки;
		Если Прав(ТехнологияДоставки.ГУИД, 5) = "Doors" Тогда
			СтруктураДляЭН.Вставить("АдресПолучателя", ТекСтр.ДокументСсылка.АдресДоставкиНП);
		Иначе	
			СтруктураДляЭН.Вставить("СкладПолучателя", Справочники.ЛМ_Отделения.НайтиПоРеквизиту("ГУИД", ТекСтр.rcpt_warehouse.Значение));
		КонецЕсли;	
		СтруктураДляЭН.Вставить("ТехнологияДоставки", ТехнологияДоставки);
		
		Если ЗначениеЗаполнено(ТекСтр.weight.Значение) тогда
			СтруктураДляЭН.Вставить("Вес", ТекСтр.weight.Значение);
		КонецЕсли;	
		
		СтруктураДляЭН.Вставить("ВидГруза", Справочники.ЛМ_ВидыГрузов.НайтиПоРеквизиту("ГУИД", ТекСтр.cargo_type.Значение));
		
		
		//
		//Отправитель
		//КонтактноеЛицоОтправителя
		
		СтруктураДляЭН.Вставить("Отправитель", Справочники.ЛМ_Контрагенты.НайтиПоРеквизиту("ГУИД", ТекСтр.sender_company.Значение));
		СтруктураДляЭН.Вставить("КонтактноеЛицоОтправителя", Справочники.ЛМ_КонтактныеЛица.НайтиПоРеквизиту("ГУИД", ТекСтр.sender_contact.Значение));
		
		Если Склад <> Неопределено Тогда
			СтруктураДляЭН.Вставить("СкладОтправителя", Склад.ОтделениеНоваяПочта);
		Иначе
			СтруктураДляЭН.Вставить("СкладОтправителя", Справочники.ЛМ_Отделения.НайтиПоРеквизиту("ГУИД", ТекСтр.sender_address.Значение));
		КонецЕсли;
		
		
		
		СтруктураДляЭН.Вставить("ФормаОплаты", Справочники.ЛМ_ФормыОплаты.НайтиПоРеквизиту("ГУИД", ТекСтр.pay_type.Значение));
		СтруктураДляЭН.Вставить("ПлательщикДоставки", Справочники.ЛМ_ВидыПлательщиков.НайтиПоРеквизиту("ГУИД", ТекСтр.payer.Значение));
		СтруктураДляЭН.Вставить("ОписаниеГруза", Справочники.ЛМ_ОписанияГрузов.НайтиПоРеквизиту("ГУИД", ТекСтр.description.Значение));
		
		СтруктураДляЭН.Вставить("Комментарий", ТекСтр.additional_info.Значение);
		
		Если ЗначениеЗаполнено(ТекСтр.AfterpaymentOnGoodsCost.Значение) тогда
			СтруктураДляЭН.Вставить("КонтрольОплаты", ТекСтр.AfterpaymentOnGoodsCost.Значение);
		Иначе
		    СтруктураДляЭН.Вставить("ВидОбратнойДоставки", Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоРеквизиту("ГУИД", ТекСтр.redelivery_type.Значение));
			СтруктураДляЭН.Вставить("ПлательщикОбратнойДоставки", Справочники.ЛМ_ВидыПлательщиковОбратнойДоставки.НайтиПоРеквизиту("ГУИД", ТекСтр.redelivery_payment_payer.Значение));
			Попытка
				СтруктураДляЭН.Вставить("СуммаОбратнойДоставки", Число(ТекСтр.delivery_amount.Значение));
			Исключение
				СтруктураДляЭН.Вставить("СуммаОбратнойДоставки", 0);
			КонецПопытки;	
		КонецЕсли;	
			
		СтруктураДляЭН.Вставить("КоличествоМест", ТекСтр.redelivery_payment_payer.Значение);
		Попытка
			ДатаСтрокой = СокрЛП(ТекСтр.date.Значение);
			ДатаОтправки = Дата(Прав(ДатаСтрокой,4), Сред(ДатаСтрокой, 4,2),Лев(ДатаСтрокой,2));
		Исключение
			ДатаОтправки = ТекущаяДата();
		КонецПопытки;	
		СтруктураДляЭН.Вставить("ДатаОтправки", ДатаОтправки);
		Попытка
			СтруктураДляЭН.Вставить("ОбъявленнаяСтоимость", Число(?(ТекСтр.cost.Значение <> 0,ТекСтр.cost.Значение, ТекСтр.AfterpaymentOnGoodsCost.Значение)));    		
		Исключение
			СтруктураДляЭН.Вставить("ОбъявленнаяСтоимость", ТекСтр.ДокументСсылка.СуммаДокумента);
		КонецПопытки;	
			
		Если ТекСтр.delivery_amount.Значение = "Да" Тогда
			СтруктураДляЭН.Вставить("СубботняяДоставка", Истина);
		Иначе
			СтруктураДляЭН.Вставить("СубботняяДоставка", Ложь);
		КонецЕсли;	
		 
		Запрос = новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛМ_ЭкспрессНакладная.Ссылка,
		|	ЛМ_ЭкспрессНакладная.Распечатан,
		|	ЛМ_ЭкспрессНакладная.ГУИД
		|ИЗ
		|	Документ.ЛМ_ЭкспрессНакладная КАК ЛМ_ЭкспрессНакладная
		|ГДЕ
		|	ЛМ_ЭкспрессНакладная.ДокументОснование = &ДокументОснование";
		Запрос.УстановитьПараметр("ДокументОснование", ТекСтр.ДокументСсылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если выборка.Следующий() Тогда
			Если ЗначениеЗаполнено(Выборка.ГУИД) Тогда
				Если Вопрос("Экспресс-накладная по документу " + ТекСтр.ДокументСсылка + " уже формировалась. Выгрузить новую экспресс-накладную", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да ТОгда
					Док = Документы.ЛМ_ЭкспрессНакладная.СоздатьДокумент();
				Иначе	
					МассивОставшихсяОбъектов.Добавить(ТекСтр.ДокументСсылка);
					Продолжить;
				КонецЕсли;	
			КонецЕсли;	
			СтараяТТН = Выборка.ссылка.Получитьобъект();
			СтараяТТН.удалить()		
		Иначе	
			Док = Документы.ЛМ_ЭкспрессНакладная.СоздатьДокумент();
		КонецЕсли;	
		Док.Заполнить(СтруктураДляЭН);
		
		Док.Дата = ТекущаяДата();
		Док.ВыгрузитьЭкспрессНакладную();
		
		Если Док.ГУИД = "ОтказОтСоздания!!!" ИЛИ Док.мЕстьОшибки = истина Тогда
			Сообщить("Экспресс-накладная по документу " + ТекСтр.ДокументСсылка + " не создана!");
			МассивОставшихсяОбъектов.Добавить(ТекСтр.ДокументСсылка);
			Продолжить;
		КонецЕсли;	
		Если Не ЗначениеЗаполнено(Док.Номер) Тогда
			Док.УстановитьНовыйНомер();
		КонецЕсли;
		Док.Записать();
		Если ЗначениеЗаполнено(Док.ДокументОснование) и ЗначениеЗаполнено(Док.НомерТТН) Тогда
			ТекСтр.is_carrier_id = Док.НомерТТН;
			ЗаказОбъект = Док.ДокументОснование.ПолучитьОбъект();
			ЗаказОбъект.НомерТТН = Док.НомерТТН;
			ЗаказОбъект.ОбменДанными.Загрузка = Истина;
			ЗаказОбъект.Записать();
		КонецЕсли;	
		
		
	КонецЦикла;	
	
КонецПроцедуры	

Функция ПолучитьТипЦенКонтрагента(пКонтрагент, ВалютаДолл = Неопределено) Экспорт 
	
	Если ВалютаДолл = Неопределено Тогда
		ВалютаДолл = Справочники.Валюты.НайтиПоКоду("840");
	КонецЕсли;

	Рез = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТипыЦенНоменклатурыКонтрагентов.Ссылка
	|ИЗ
	|	Справочник.ТипыЦенНоменклатурыКонтрагентов КАК ТипыЦенНоменклатурыКонтрагентов
	|ГДЕ
	|	ТипыЦенНоменклатурыКонтрагентов.Владелец = &Контрагент
	|	И ТипыЦенНоменклатурыКонтрагентов.ВалютаЦены = &ВалютаЦены
	|	И НЕ ТипыЦенНоменклатурыКонтрагентов.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Контрагент", пКонтрагент);
	Запрос.УстановитьПараметр("ВалютаЦены", ВалютаДолл);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Рез = Выборка.Ссылка;
	Иначе
		Об = Справочники.ТипыЦенНоменклатурыКонтрагентов.СоздатьЭлемент();
		Об.Владелец = пКонтрагент;
		Об.ВалютаЦены = ВалютаДолл;
		Об.Наименование = "Основной поставщика";
		Попытка
			Об.Записать();
		Исключение
			Сообщить("Не удалось создать тип цен для контрагента: " + пКонтрагент);
		КонецПопытки;
	КонецЕсли;
	
	Возврат Рез;
КонецФункции
