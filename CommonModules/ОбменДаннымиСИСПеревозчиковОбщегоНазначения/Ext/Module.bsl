
Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Неопределено) Экспорт
	Результат = Новый Массив;


	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Строка) Тогда
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;


	Позиция = Найти(Строка, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Строка, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			Результат.Добавить(Подстрока);
		КонецЕсли;
		Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Строка, Разделитель);
	КонецЦикла;

	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
		Результат.Добавить(Строка);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция УдалитьПовторяющиесяЭлементыМассива(Массив, НеИспользоватьНеопределено = Ложь) Экспорт
	Перем ОписаниеТиповСправочники, ОписаниеТиповДокументы, ОписаниеТиповПВХ;
	ОписаниеТиповСправочники = Справочники.ТипВсеСсылки();
	ОписаниеТиповДокументы = Документы.ТипВсеСсылки();
	ОписаниеТиповПВХ = ПланыВидовХарактеристик.ТипВсеСсылки();

	Если ТипЗнч(Массив) = Тип("Массив") Тогда

		УжеВМасссиве = Новый Соответствие;
		БылоНеопределено = Ложь;

		КолвоЭлементовВМассиве = Массив.Количество();

		Для ОбратныйИндекс = 1 По КолвоЭлементовВМассиве Цикл
			ЭлементМассива = Массив[КолвоЭлементовВМассиве - ОбратныйИндекс];
			ТипЭлемента = ТипЗнч(ЭлементМассива);
			Если ЭлементМассива = Неопределено Тогда
				Если БылоНеопределено Или НеИспользоватьНеопределено Тогда
					Массив.Удалить(КолвоЭлементовВМассиве - ОбратныйИндекс);
				Иначе
					БылоНеопределено = Истина;
				КонецЕсли;
				Продолжить;
			ИначеЕсли ОписаниеТиповСправочники.СодержитТип(ТипЭлемента) Или ОписаниеТиповДокументы.СодержитТип(ТипЭлемента) Или ОписаниеТиповПВХ.СодержитТип(ТипЭлемента) Тогда



				ИДЭлемента = Строка(ЭлементМассива.УникальныйИдентификатор());
			Иначе


				ИДЭлемента = ЭлементМассива;

			КонецЕсли;

			Если УжеВМасссиве[ИДЭлемента] = Истина Тогда
				Массив.Удалить(КолвоЭлементовВМассиве - ОбратныйИндекс);
			Иначе
				УжеВМасссиве[ИДЭлемента] = Истина;
			КонецЕсли;
		КонецЦикла;

	КонецЕсли;

	Возврат Массив;

КонецФункции

Процедура ЭкспортДокументовИзСписков(ДокументСписок) Экспорт
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ДокументСписок);

	ПостроительЗапроса.Выполнить();

	ТаблицаДокуметов = ПостроительЗапроса.Результат.Выгрузить();
	ТаблицаДокуметов = ТаблицаДокуметов.Скопировать(Новый Структура("ПометкаУдаления", Ложь));

	Если ТаблицаДокуметов.Количество() > 100 И Вопрос("Выбрано более ста документов, обработка результата может занять продолжительное время. Продолжить?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда


		Возврат;

	КонецЕсли;

	ФормаЭкспорта = Обработки.ОбменДаннымиСИСПеревозчиков.ПолучитьФорму("Форма");
	ФормаЭкспорта.ОбработкаПодбораДокументов(ТаблицаДокуметов.ВыгрузитьКолонку("Ссылка"));
	ФормаЭкспорта.ЭлементыФормы.ОсновнаяПанель.ТекущаяСтраница = ФормаЭкспорта.ЭлементыФормы.ОсновнаяПанель.Страницы.ЭкспортДокументов;
	ФормаЭкспорта.Открыть();

КонецПроцедуры

Процедура ОтправкаФайлаПоЭлектроннойПочте(НастройкиОбмена, ПолноеИмяФайлаВложения, ИмяВложения, Отказ) Экспорт
	Перем ДополнительныеПараметры;
	ДополнительныеПараметры = НастройкиОбмена.ДополнительныеПараметры.Получить();
	Если ДополнительныеПараметры = Неопределено Тогда
		Сообщить("Не заполнены дополнительные параметры обмена данными, отправка не возможна!", СтатусСообщения.Важное);
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Профиль = Новый ИнтернетПочтовыйПрофиль;

	НайденныеСтроки = ДополнительныеПараметры.НайтиСтроки(Новый Структура("Параметр", "Отправка ТТН: SMTP сервер (Адрес)"));
	Если НайденныеСтроки.Количество() И Не ПустаяСтрока(НайденныеСтроки[0].Значение) Тогда
		Профиль.АдресСервераSMTP = НайденныеСтроки[0].Значение;
	Иначе
		Отказ = Истина;
		Сообщить("Не заполнен параметр ""Отправка ТТН: SMTP сервер (Адрес)"".Отправка не возможна!", СтатусСообщения.Важное);
	КонецЕсли;

	НайденныеСтроки = ДополнительныеПараметры.НайтиСтроки(Новый Структура("Параметр", "Отправка ТТН: SMTP сервер (Порт)"));
	Если НайденныеСтроки.Количество() И Не ПустаяСтрока(НайденныеСтроки[0].Значение) Тогда
		Профиль.ПортSMTP = НайденныеСтроки[0].Значение;
	Иначе
		Отказ = Истина;
		Сообщить("Не заполнен параметр ""Отправка ТТН: SMTP сервер (Порт)"".Отправка не возможна!", СтатусСообщения.Важное);
	КонецЕсли;

	НайденныеСтроки = ДополнительныеПараметры.НайтиСтроки(Новый Структура("Параметр", "Отправка ТТН: SMTP сервер (Логин)"));
	Если НайденныеСтроки.Количество() И Не ПустаяСтрока(НайденныеСтроки[0].Значение) Тогда
		Профиль.ПользовательSMTP = НайденныеСтроки[0].Значение;
		Профиль.Пользователь = НайденныеСтроки[0].Значение;
	Иначе
		Отказ = Истина;
		Сообщить("Не заполнен параметр ""Отправка ТТН: SMTP сервер (Логин)"".Отправка не возможна!", СтатусСообщения.Важное);
	КонецЕсли;

	НайденныеСтроки = ДополнительныеПараметры.НайтиСтроки(Новый Структура("Параметр", "Отправка ТТН: SMTP сервер (Пароль)"));
	Если НайденныеСтроки.Количество() И Не ПустаяСтрока(НайденныеСтроки[0].Значение) Тогда
		Профиль.ПарольSMTP = НайденныеСтроки[0].Значение;
		Профиль.Пароль = НайденныеСтроки[0].Значение;
		Профиль.АутентификацияSMTP = СпособSMTPАутентификации.ПоУмолчанию;
	Иначе
		Профиль.АутентификацияSMTP = СпособSMTPАутентификации.БезАутентификации;
	КонецЕсли;

	НайденныеСтроки = ДополнительныеПараметры.НайтиСтроки(Новый Структура("Параметр", "Отправка ТТН: Адрес ЭП"));
	Если НайденныеСтроки.Количество() И Не ПустаяСтрока(НайденныеСтроки[0].Значение) Тогда
		Отправитель = НайденныеСтроки[0].Значение;
	Иначе
		Отказ = Истина;
		Сообщить("Не заполнен параметр ""Отправка ТТН: Адрес ЭП"".Отправка не возможна!", СтатусСообщения.Важное);
	КонецЕсли;

	НайденныеСтроки = ДополнительныеПараметры.НайтиСтроки(Новый Структура("Параметр", "Отправка ТТН: Тема"));
	Если НайденныеСтроки.Количество() И Не ПустаяСтрока(НайденныеСтроки[0].Значение) Тогда
		Тема = НайденныеСтроки[0].Значение;
	Иначе
		Отказ = Истина;
		Сообщить("Не заполнен параметр ""Отправка ТТН: Тема"".Отправка не возможна!", СтатусСообщения.Важное);
	КонецЕсли;

	НайденныеСтроки = ДополнительныеПараметры.НайтиСтроки(Новый Структура("Параметр", "Отправка ТТН: Адрес получателя копии"));
	Если НайденныеСтроки.Количество() И Не ПустаяСтрока(НайденныеСтроки[0].Значение) Тогда
		ПолучательКопии = НайденныеСтроки[0].Значение;
	Иначе
		ПолучательКопии = "";
	КонецЕсли;

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Сообщение = Новый ИнтернетПочтовоеСообщение;
	Сообщение.Тема = Тема;
	Сообщение.Отправитель = Отправитель;
	Сообщение.Получатели.Добавить(НастройкиОбмена.АдресЭлектроннойПочты);
	Если Не ПустаяСтрока(ПолучательКопии) Тогда
		Сообщение.Копии.Добавить(ПолучательКопии);
	КонецЕсли;
	Сообщение.Вложения.Добавить(ПолноеИмяФайлаВложения, ИмяВложения);
	Сообщение.ОбработатьТексты();
	Сообщение.Кодировка = КодировкаТекста.UTF8;

	Инфо = Новый СообщениеПользователю;

	Попытка
		СообщениеОбОшибке = "";
		Соединение = Новый ИнтернетПочта;
		Соединение.Подключиться(Профиль);
		Соединение.Послать(Сообщение);
	Исключение
		Инфо.Текст = " - Ошибка при отправке почты: ";
		Инфо.Сообщить();
		Инфо.Текст = ОписаниеОшибки();
		Инфо.Сообщить();
		Отказ = Истина;
	КонецПопытки;

	Если Не Отказ Тогда
		Инфо.Текст = " Сообщение отправлено. ";
		Инфо.Сообщить();
		Соединение.Отключиться();
	КонецЕсли;

КонецПроцедуры

Функция ОпределитьНеобходимостьВыбораПеревозчика(Перевозчик) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Перевозчики.Ссылка
	|ИЗ
	|	Справочник.Перевозчики КАК Перевозчики
	|ГДЕ
	|	НЕ Перевозчики.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Перевозчик = Выборка.Ссылка;
		Возврат Ложь;
	ИначеЕсли Выборка.Количество() = 0 Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

Функция ПолучитьТелефонИзКонтактнойИнформации(Объект, Окончание = "") Экспорт
	ОбъектКонтактнойИнформации = Объект;

	Если ТипЗнч(Объект) = Тип("СправочникСсылка.Организации") Тогда
		Если Объект.ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда

			ОбъектКонтактнойИнформации = Объект.ИндивидуальныйПредприниматель;

			Окончание = "ТелефонФизЛицаСлужебный";
		Иначе


			Окончание = "ТелефонОрганизации";

		КонецЕсли;
	ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.Контрагенты") Тогда
		Окончание = "ТелефонКонтрагента";
	КонецЕсли;

	ВидТелефона = Справочники.ВидыКонтактнойИнформации[Окончание].ПолучитьОбъект().Ссылка;

	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Объект", ОбъектКонтактнойИнформации);
	Запрос.УстановитьПараметр("Тип", Перечисления.ТипыКонтактнойИнформации.Телефон);
	Запрос.УстановитьПараметр("Вид", ВидТелефона);

	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И
	|	КонтактнаяИнформация.Тип = &Тип
	|	И
	|	КонтактнаяИнформация.Вид = &Вид
	|";

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() И Окончание = "МобильныйТелефонКонтактногоЛицаКонтрагента" Тогда
		Возврат ПолучитьТелефонИзКонтактнойИнформации(Объект, "РабочийТелефонКонтактногоЛицаКонтрагента");
	ИначеЕсли РезультатЗапроса.Пустой() Тогда
		Возврат "";
	Иначе
		Возврат РезультатЗапроса.Выгрузить()[0].Представление;
	КонецЕсли;

КонецФункции

Функция ПолучитьПереченьРеквизитовТТНПоЗначениюРеквизита(ИмяРеквизитаОтбора, ЗначениеРеквизита, Перевозчик) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЗначениеРеквизита", ЗначениеРеквизита);
	Запрос.УстановитьПараметр("Перевозчик", Перевозчик);
	Запрос.Текст = "ВЫБРАТЬ
	|	РеквизитыТТН.Ссылка
	|ИЗ
	|	Справочник.РеквизитыТТН КАК РеквизитыТТН
	|ГДЕ
	|	РеквизитыТТН." + ИмяРеквизитаОтбора + " = &ЗначениеРеквизита
	|	И РеквизитыТТН.Владелец = &Перевозчик
	|
	|УПОРЯДОЧИТЬ ПО
	|	РеквизитыТТН.Порядок УБЫВ";
	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат Новый Массив;
	Иначе
		Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;

КонецФункции

Функция ПолучитьЭкспортированныеРанееДокументы(ТаблицаТТН) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_ЭкспрессНакладная.ДокументОснование КАК Объект
	|ИЗ
	|	Документ.ЛМ_ЭкспрессНакладная КАК ЛМ_ЭкспрессНакладная
	|ГДЕ
	|	ЛМ_ЭкспрессНакладная.ДокументОснование В(&Объект)
	|	И ЛМ_ЭкспрессНакладная.ГУИД <> """"
	|	И ЛМ_ЭкспрессНакладная.Распечатан";

	Запрос.УстановитьПараметр("Объект", ТаблицаТТН.ВыгрузитьКолонку("ДокументСсылка"));

	Результат = Запрос.Выполнить();

	Возврат Результат.Выбрать();

