


Процедура ВыполнитьОбменДаннымиДляНастройкиОбмена(КодНастройки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодНастройки) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаОбмена = Справочники.НастройкиОбменаДанными.НайтиПоКоду(КодНастройки);
	
	Если НЕ ЗначениеЗаполнено(НастройкаОбмена)
		ИЛИ НастройкаОбмена.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	ПроцедурыОбменаДанными.ВыполнитьОбменДаннымиПоПроизвольнойНастройке(НастройкаОбмена, Ложь);
			
КонецПроцедуры

Процедура ВыполнитьОтложенныеДвиженияДляНастройкиОбмена(КодНастройки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодНастройки) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаОбмена = Справочники.НастройкиОбменаДанными.НайтиПоКоду(КодНастройки);
	
	Если НЕ ЗначениеЗаполнено(НастройкаОбмена)
		ИЛИ НастройкаОбмена.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;	
	
	ПроцедурыОбменаДанными.ВыполнитьОтложенныеДвиженияПоНастройкеОбмена(НастройкаОбмена);
			
КонецПроцедуры

Процедура ВыполнитьОбменДаннымиДляНастройкиАвтоматическогоОбменаДанными(КодНастройки) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодНастройки) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкаОбмена = Справочники.НастройкиВыполненияОбмена.НайтиПоКоду(КодНастройки);
	
	Если НЕ ЗначениеЗаполнено(НастройкаОбмена)
		ИЛИ НастройкаОбмена.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	ПроцедурыОбменаДанными.ВыполнитьОбменПоНастройкеАвтоматическогоВыполненияОбменаДанными(НастройкаОбмена, Ложь);
	
КонецПроцедуры


// Процедура выполняет пересчет регистров накопления, для удаления нулевых записей
Процедура ПересчетИтоговРегистровНакопления() Экспорт

	НаДату = НачалоМесяца(ТекущаяДата())-1;	
	ПересчетРегистров(РегистрыНакопления, НаДату, Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки);
	ПересчетРегистров(РегистрыБухгалтерии, НаДату);	
	
КонецПроцедуры

Процедура ПересчетРегистров(МенеджерРегистров, НаДату, ОграничениеПоВидуРегистра = Неопределено)
	
	Для Каждого МенеджерРегистра ИЗ МенеджерРегистров Цикл
		МетаданныеРегистра = Метаданные.НайтиПоТипу(ТипЗнч(МенеджерРегистра));
		
		Если ОграничениеПоВидуРегистра <> Неопределено И МетаданныеРегистра.ВидРегистра <> ОграничениеПоВидуРегистра Тогда
			Продолжить;
		КонецЕсли;
		ПересчитатьРегистрПоДате(МенеджерРегистра, НаДату);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПересчитатьРегистрПоДате(МенеджерРегистра, НаДату)
	
	Если МенеджерРегистра.ПолучитьПериодРассчитанныхИтогов()<НаДату Тогда
		МенеджерРегистра.УстановитьПериодРассчитанныхИтогов(НаДату);
	Иначе
		МенеджерРегистра.ПересчитатьИтоги();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновлениеИндексаПолнотекстовогоПоиска() Экспорт
	
	Если ПолнотекстовыйПоиск.ПолучитьРежимПолнотекстовогоПоиска() = РежимПолнотекстовогоПоиска.Разрешить Тогда
		
		Если НЕ ПолнотекстовыйПоиск.ИндексАктуален() Тогда
			Попытка	
				ЗаписьЖурналаРегистрации("Полнотекстовое индексирование", 
				УровеньЖурналаРегистрации.Информация, , ,
				"Начато регламентное индексирование порции");
				
				ПолнотекстовыйПоиск.ОбновитьИндекс(Ложь, Истина);
				
				ЗаписьЖурналаРегистрации("Полнотекстовое индексирование", 
				УровеньЖурналаРегистрации.Информация, , ,
				"Закончено регламентное  индексирование порции");
			Исключение
				ЗаписьЖурналаРегистрации("Полнотекстовое индексирование", 
				УровеньЖурналаРегистрации.Ошибка, , ,
				"Во время регламентного обновления индекса произошла неизвестная ошибка: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
Конецпроцедуры

Процедура ОбновитьСтатусыЗаказов() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Собран=Справочники.СтатусыЗаказов.НайтиПоНаименованию("Собран");
	ЦБНеПолучена=Справочники.СтатусыЗаказов.НайтиПоНаименованию("ЦБ не получена");
	НаВозврате=Справочники.СтатусыЗаказов.НайтиПоНаименованию("На возврате");
	Отказ=Справочники.СтатусыЗаказов.НайтиПоНаименованию("Отказ");
	Неудачные=Справочники.СтатусыЗаказов.НайтиПоНаименованию("Не удачные");
	Завершенные=Справочники.СтатусыЗаказов.НайтиПоНаименованию("Завершенные");
			
	
	СписСтатусовЗак = Новый СписокЗначений;
	СписСтатусовЗак.Добавить(ЦБНеПолучена);
	СписСтатусовЗак.Добавить(Завершенные);
	СписСтатусовЗак.Добавить(НаВозврате);
	//СписСтатусовЗак.Добавить(Собран);
	
	СписСтатусовОтпр = Новый СписокЗначений;
	//СписСтатусовОтпр.Добавить("Відправлення отримано");
	СписСтатусовОтпр.Добавить("Номер не знайдено");
	//СписСтатусовОтпр.Добавить("Змінено адресу");        
	//СписСтатусовОтпр.Добавить("Відмова від отримання");
	//СписСтатусовОтпр.Добавить("Видалено");
	//СписСтатусовОтпр.Добавить("Відправлення отримано. Грошовий переказ видано одержувачу.");
	//СписСтатусовОтпр.Добавить("");

	
	СписСтатусовОбратнойОтпр = СписСтатусовОтпр;
	
 
	//
	//
	// самостійно створив
	//
	//
	//
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЗаказПокупателя.Ссылка КАК Ссылка,
		               |	ЗаказПокупателя.ТелефонКонтрагента КАК ТелефонКонтрагента,
		               |	ЗаказПокупателя.НомерТТН КАК НомерТТН,
		               |	ЗаказПокупателя.СтатусОтправки КАК СтатусОтправки,
		               |	ЗаказПокупателя.СпособОтправки КАК СпособОтправки,
		               |	ЗаказПокупателя.СкладНовойПочтыЗначение КАК СкладНовойПочтыЗначение,
		               |	ЗаказПокупателя.ГородНовойПочтыЗначение КАК ГородНовойПочтыЗначение,
		               |	ЗаказПокупателя.ДатаОтгрузки КАК ДатаОтгрузки,
		               |	ЗаказПокупателя.Дата КАК Дата,
		               |	ЗаказПокупателя.Контрагент КАК Контрагент,
		               |	ЗаказПокупателя.ДатаДоставки КАК ДатаДоставки,
		               |	ЗаказПокупателя.НеУчитыватьВОтчете КАК НеУчитыватьВОтчете,
		               |	ЗаказПокупателя.ТехнологияДоставки КАК ТехнологияДоставки,
		               |	ЗаказПокупателя.НомерТТНОбратнойДоставки КАК НомерТТНОбратнойДоставки,
		               |	ЗаказПокупателя.СтатусОбратнойДоставки КАК СтатусОбратнойДоставки,
		               |	ЗаказПокупателя.СуммаНоваяПочта КАК СуммаНоваяПочта,
		               |	ЗаказПокупателя.СтатусЗаказа КАК СтатусЗаказа,
		               |	ЗаказПокупателя.Номер КАК Номер,
		               |	ЗаказПокупателя.АдресЭлектроннойПочтыКонтрагента КАК АдресЭлектроннойПочтыКонтрагента
		               |ИЗ
		               |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		               |ГДЕ
		               |	ЗаказПокупателя.СпособОтправки = &СпособОтправки
		               |	И (НЕ ЗаказПокупателя.СтатусОтправки В (&СтатусОтправки)
		               |			ИЛИ НЕ ЗаказПокупателя.СтатусОбратнойДоставки В (&СтатусОбратнойОтправки))
		               |	И НЕ ЗаказПокупателя.ПометкаУдаления
		               |	И ЗаказПокупателя.СтатусЗаказа В(&СтатусЗаказа)
		               |	И ЗаказПокупателя.Дата >= &Дата
		               |	И НЕ ЗаказПокупателя.НомерТТН = &НомерТТН";
		
		Запрос.УстановитьПараметр("СпособОтправки",Справочники.СпособыОтправки.НоваяПочта);
		Запрос.УстановитьПараметр("СтатусОтправки",СписСтатусовОтпр);
		Запрос.УстановитьПараметр("СтатусОбратнойОтправки",СписСтатусовОбратнойОтпр);
		
		Запрос.УстановитьПараметр("СтатусЗаказа",СписСтатусовЗак);
		Запрос.УстановитьПараметр("Дата",ДобавитьМесяц(ТекущаяДата(),-2));
		Запрос.УстановитьПараметр("НомерТТН","");
		
		Рез = Запрос.Выполнить().Выгрузить();
		Рез.Сортировать("Номер");
		
		Перевозчик = Справочники.Перевозчики.НайтиПоНаименованию("Новая почта");
		НастройкиОбмена = ОбменДаннымиСИСПеревозчиковСервер.ПолучитьНастройкиОбменаДанными(Перевозчик);
		КлючАПИ = Неопределено;
		Если НастройкиОбмена.Свойство("КлючAPI", КлючАПИ) Тогда

			Для Каждого ТекСтрока из Рез Цикл
				
				Объект = ТекСтрока.Ссылка;
				ТекОбъект = ТекСтрока.Ссылка.ПолучитьОбъект();
							
				ТекОбъект.ЗакрытиеЗаказа();
				
				Если НЕ ЗначениеЗаполнено(ТекСтрока.НомерТТН) Тогда
					Продолжить;
				КонецЕсли;
				
				Если СтрЧислоВхождений(ТекСтрока.СтатусОтправки,"Відправлення отримано") И Не Объект.СтатусЗаказа = ЦБНеПолучена Тогда
					 Продолжить;
				КонецЕсли; 

				
				ТЗ = Новый ТаблицаЗначений;
				ТЗ.Колонки.Добавить("НомерДок");
				ТЗ.Колонки.Добавить("Телефон");
				НС = ТЗ.Добавить();
				НС.НомерДок = ТекСтрока.НомерТТН; 
				НС.Телефон = "380982487868";
				
				Ответ = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.СтатусНакладнойНов(КлючАПИ,ТЗ);
				
				Если Ответ.Количество()>0 Тогда
					СтруктураОтвета = Ответ[0];
				Иначе
					Продолжить;
				КонецЕсли;
				
				СтатусОтправки = СтруктураОтвета.СтатусДокумента;
				СтатусОтправкиПоОснТТН = СтруктураОтвета.СтатусДокумента;
				ДатаДоставки = СтруктураОтвета.ДатаДоставки;
				ПричинаОтказа = СтруктураОтвета.ПричинаОтказа;
				ТТНОбратнойДоставки = СтруктураОтвета.ТТНОбратнойДоставки;
			    ЕстьТТНОбратнойДоставки = (ТТНОбратнойДоставки <> "");
				
				ЕстьПереадресация = СтруктураОтвета.ЕстьПереадресация;
				ПередатьНаСайт = Ложь;
				
				//Если Объект.СтатусЗаказа = Завершенные И
				//	(Не ЗначениеЗаполнено(Объект.СтатусОбратнойДоставки) Или Не ЗначениеЗаполнено(Объект.СтатусОтправки) ИЛИ
				//		  НЕ ЗначениеЗаполнено(Объект.НомерТТН))
				//	Тогда
				//	Продолжить;
				
				Если СтрНайти( СтатусОтправки,ТекОбъект.СтатусОтправки) = 0 Тогда
					ПередатьНаСайт = Истина;
					Сообщить(ТекОбъект.Номер + " выгружаем");
				Иначе
					Сообщить(ТекОбъект.Номер + " такой же статус не выгружаем");
				КонецЕсли;
								
				СтарыйСтатусОбратнойДоставки = Объект.СтатусОбратнойДоставки;
								
				СтарыйСтатусОтправки =  Объект.СтатусОтправки;
				
				ТекОбъект.СтатусОтправки = СтатусОтправки;
				
				Если ЕстьТТНОбратнойДоставки и Не ТекСтрока.СтатусЗаказа=ЦБНеПолучена Тогда
					
					ТЗ[0].НомерДок = ТТНОбратнойДоставки; 
					
					Ответ = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.СтатусНакладнойНов(КлючАПИ,ТЗ);
					Если Ответ.Количество()>0 Тогда
						СтруктураОтвета = Ответ[0];
					Иначе
						Продолжить;
					КонецЕсли;
					СтатусОтправки = СтруктураОтвета.СтатусДокумента; 			
					ДатаДоставки = СтруктураОтвета.ДатаДоставки;
					ПричинаОтказа = СтруктураОтвета.ПричинаОтказа;
					
					ТекОбъект.НомерТТНОбратнойДоставки = ТТНОбратнойДоставки;	
					ТекОбъект.СтатусОбратнойДоставки = СтатусОтправки;	
				
					Если  СтрНайти( СтатусОтправки,СтарыйСтатусОбратнойДоставки) = 0 Тогда 
						ПередатьНаСайт = Истина;
					КонецЕсли;


				Иначе 
						
					ТекОбъект.НомерТТНОбратнойДоставки = "";
					ТекОбъект.СтатусОбратнойДоставки = "";
				КонецЕсли;
				
				СрокХранения = Документы.ЗаказПокупателя.СрокХранения(ДатаДоставки);
				
			
				
				//Оповещение возврат 
				Если Объект.СтатусЗаказа=НаВозврате Тогда
					Если Объект.СрокХранения = СрокХранения Или
						 СтатусОтправки = ?(ЕстьТТНОбратнойДоставки,СтарыйСтатусОбратнойДоставки,СтарыйСтатусОтправки)
						 Тогда
						 
							 Если СтрЧислоВхождений(СтатусОтправки,"Прибув") Тогда
							     СоздатьЗадачу("Получить Возврат","Получить Возврат по адресу " + СтруктураОтвета.АдресДоставки + " " + ТТНОбратнойДоставки,Объект);
							 ИначеЕсли СтрЧислоВхождений(СтатусОтправки,"отримано") Тогда
								 СоздатьЗадачу("Возврат Получен","Возврат Получен нужно изменить статус заказа",Объект);
							 КонецЕсли;
						       
					КонецЕсли;
				КонецЕсли;
								
				Если ТекСтрока.СтатусОтправки="Видалено" Тогда
					
					 ИдентификаторСобытия = "Видалено";
					 Наименование = ИдентификаторСобытия; 
					 СоздатьЗадачу(ИдентификаторСобытия,Наименование,Объект);
				КонецЕсли;
				
				СамостійноСтворив="Відправник самостійно створив цю накладну, але ще не надав до відправки"; 
				
				Если НачалоДня(ТекСтрока.ДатаОтгрузки) <> НачалоДня(ТекущаяДата()) И
					 ТекСтрока.СтатусОтправки=СамостійноСтворив И (
					 ТекСтрока.СтатусЗаказа=ЦБНеПолучена Или
					 ТекСтрока.СтатусЗаказа=Завершенные)
					Тогда
					
					 ИдентификаторСобытия = "самостійно створив";	 
					 СоздатьЗадачу(ИдентификаторСобытия,СамостійноСтворив,Объект);
				КонецЕсли;
				
				Если ТекСтрока.СтатусЗаказа=ЦБНеПолучена Тогда
					
					Если ТекСтрока.СтатусОтправки="Змінено адресу" Тогда
						ИдентификаторСобытия = "Змінено адресу";		 
						СоздатьЗадачу(ИдентификаторСобытия,"Змінено адресу",Объект);
					КонецЕсли;
					 
					Если ТекСтрока ="Відправлення отримано" Тогда
					 
						ИдентификаторСобытия = "ОшибкаНаложкиСтатусПоТТН!!!"; 
						Наименование = "Ошибка Наложки Статус По ТТН";
					 
					 	СоздатьЗадачу(ИдентификаторСобытия,Наименование,Объект,Ложь);
					КонецЕсли;
					
				КонецЕсли;

				//отправим оповещение об отказе
				Если СтрЧислоВхождений(ВРег(СтатусОтправкиПоОснТТН),"ВІДМОВА") И
					 ТекСтрока.СтатусЗаказа<>НаВозврате 
					Тогда
					
					 //Тел = ОбщегоНазначения.ТелефонКонтрагента(ТекСтрока.Контрагент);
					 //Тел = ОбщегоНазначения.ПоправитьТелефон(Тел);
					 //ТекстСМС = Константы.ШаблонСМСОтказа.Получить().Текст;
					 //ОбщийМодульПодписокНаСобытия.ОтправкаСМСУведомленияОтдельно(ТекСтрока.Ссылка,ТекстСМС,Тел);
					 
					 ТекОбъект.ПричинаОтказа = ПричинаОтказа;	
					 ТекОбъект.СтатусЗаказа = НаВозврате;
					 ПередатьНаСайт = Истина;
				КонецЕсли;
				
				//меняем кассу при получении денег получателем
				Если Константы.ПерещатьВЗавершенные.Получить() И
					 СтрЧислоВхождений(СтатусОтправки,"Відправлення отримано. Протягом доби відправник отримає SMS-повідомлення")>0 И
					 ТекСтрока.СтатусЗаказа=ЦБНеПолучена 
					 Тогда
					 
					НайденПКО = ОбщийМодульПодписокНаСобытия.НайтиПКО(ТекСтрока.Ссылка);
						
					Если ЗначениеЗаполнено(НайденПКО) Тогда
						ПКО = НайденПКО.ПолучитьОбъект();
		                ПКО.Касса = Справочники.Кассы.НайтиПоКоду("000000020");
						ПКО.Записать(РежимЗаписиДокумента.ОтменаПроведения);
							
						Попытка
							ПКО.Записать(РежимЗаписиДокумента.Проведение);
						Исключение
							ПКО.Записать(РежимЗаписиДокумента.Запись);
						КонецПопытки;
					КонецЕсли; 		
				КонецЕсли;

				// получили наложку
				Если Константы.ПерещатьВЗавершенные.Получить() И
					 ТекСтрока.СтатусЗаказа=ЦБНеПолучена И 
					 ТекОбъект.ТипОбратнойДоставки = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000009") //09

					Тогда
					Если СтрЧислоВхождений(СтатусОтправки,"Грошовий переказ видано одержувачу")>0 Тогда
						 ТекОбъект.СтатусЗаказа = Завершенные;
					 	 ПередатьНаСайт = Истина;
					ИначеЕсли СтатусОтправки = "Відправлення отримано" Тогда
					      СоздатьЗадачу(ИдентификаторСобытия,"Нет наложки по факту!!!",Объект, Ложь);
					КонецЕсли;			 	
				КонецЕсли;	
		
				ТекОбъект.СрокХранения = СрокХранения;
				ТекОбъект.ДатаДоставки = ДатаДоставки;

				Попытка
					ТекОбъект.Записать();		
				Исключение
				КонецПопытки;
			
				Если ПередатьНаСайт Тогда
					ПередатьЗаказНаСайт(ТекСтрока.Ссылка);
					//ТекСтрока.Ссылка.ПолучитьОбъект().ОбработкаПроведенияМ(Ложь,РежимЗаписиДокумента.Проведение,Ложь);  //.Записать(РежимЗаписиДокумента.Проведение);
				КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
  
   	ЗаказыДнейХранения();
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ЗаказыДнейХранения() Экспорт
	
	//ДатаПроверки = Константы.ДнейХраненияПроверено.Получить();
	//
	//Если  ДатаПроверки = НачалоДня(ТекущаяДата()) Тогда // сегодня уже проверяли
	//	Возврат;
	//КонецЕсли;
	//
	//Константы.ДнейХраненияПроверено.Установить(ТекущаяДата());
	
	
	Запрос  = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказПокупателя.Ссылка КАК Ссылка,
	               |	ЗаказПокупателя.СрокХранения КАК СрокХранения,
	               |	ЗаказПокупателя.ДатаДоставки КАК ДатаДоставки
				   |ИЗ
	               |	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	               |ГДЕ
	               |	НЕ ЗаказПокупателя.ПометкаУдаления
	               |	И ЗаказПокупателя.Дата МЕЖДУ &НачДата И &КонДата
	               |	И (ЗаказПокупателя.СтатусОтправки ПОДОБНО &СтатусОтправки
	               |			ИЛИ ЗаказПокупателя.СтатусОбратнойДоставки ПОДОБНО &СтатусОбратнойДоставки)";
	
	
	Запрос.УстановитьПараметр("НачДата",ДобавитьМесяц(ТекущаяДата(),-3));
	Запрос.УстановитьПараметр("КонДата",ТекущаяДата());
	Запрос.УстановитьПараметр("СтатусОтправки","%Прибув у відділення%");
	Запрос.УстановитьПараметр("СтатусОбратнойДоставки","%Прибув у відділення%");
	
	Рез = Запрос.Выполнить().Выгрузить();
		
	Для Каждого Зак Из Рез Цикл
		Если Не ЗначениеЗаполнено(Зак.Ссылка.СтатусЗаказа) ИЛИ 
			 НЕ ЗначениеЗаполнено(Зак.Ссылка.СтатусЗаказа.ПользовательСрокХранения) ИЛИ 
			 Зак.СрокХранения = 0 ИЛИ
			 Зак.СрокХранения < Зак.Ссылка.СтатусЗаказа.СрокХранения
			Тогда
			Продолжить; 
		КонецЕсли;
		
		//оповещаем один раз
		Описание = "Заказ хранится на отделении "+СокрЛП(Зак.СрокХранения)+" дня" + " с " + Зак.ДатаДоставки;
		
		УжеОповещенСтатус = Документы.ЗаказПокупателя.ДнейВХраненияОповещен(Зак.Ссылка,Описание);	
		Если УжеОповещенСтатус Тогда Продолжить; КонецЕсли;
		
		СуществующаяЗадача = БИАС.ПолучитьЗадачуКонтрагентаПоИдентификатору(Зак.Ссылка.Контрагент, "СрокХранения_" + Зак.Ссылка.Номер, Справочники.Пользователи.НайтиПоКоду("000000023"));
		
		Если СуществующаяЗадача <> Неопределено Тогда 
			Задача = СуществующаяЗадача.Ссылка.ПолучитьОбъект();
			Задача.Выполнена = Истина;
			Попытка
				Задача.Записать();
			Исключение
				Сообщить(ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
		
		// Диагностика: флаг СтатусыЗаказов.ФормироватьЗадачуСрокХранения нигде не читается,
		// задача создаётся по заполненности ПользовательСрокХранения (условие выше).
		// Логику НЕ меняем: фиксируем, для каких статусов задача реально создаётся при
		// снятой галке. Если событие не появится — флаг можно включать в условие безопасно.
		Если НЕ Зак.Ссылка.СтатусЗаказа.ФормироватьЗадачуСрокХранения Тогда
			ОбщийМодульПодписокНаСобытия.ЛогСтатуса(Зак.Ссылка, "ЗадачаСрокХранения_ФлагСнят",
				"задача создаётся, хотя ФормироватьЗадачуСрокХранения = Ложь");
		КонецЕсли;
		
		Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();
		
		Задача.Наименование   = "Количество дней хранения " + СокрЛП(Зак.СрокХранения);
		Задача.Исполнитель    = Зак.Ссылка.СтатусЗаказа.ПользовательСрокХранения;
		Задача.Дата           = ТекущаяДата();
		Задача.Объект         = Зак.Ссылка;
		Задача.Оповещение     = Истина;
		Задача.ИдентификаторСобытия = "СрокХранения_" + Зак.Ссылка.Номер;
		Задача.СрокОповещения = Задача.Дата +       5 * 60;
		Задача.СрокИсполнения = Задача.Дата + 24 * 60 * 60;
		Задача.Описание       = Описание;
		
		Попытка
			Задача.Записать();
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;		
	КонецЦикла;
		
КонецПроцедуры


Процедура ПередатьЗаказНаСайт(ЗаказПокупателя) Экспорт
	
	Если Не Константы.ВыгружатьДокументыНаСайтПриПроведении.Получить() Тогда
		Возврат;
	КонецЕсли;
		
	// Заказ ставится в очередь выгрузки на сайт: сама передача выполняется после
	// фиксации записи документа (регламентное задание ВыгрузкаЗаказовНаСайт или
	// фоновое задание, запущенное из ЗаказПокупателя.ПриЗаписи).
	//
	// Раньше здесь собиралась плоская структура реквизитов заказа и передавалась
	// в БИАС.ПередатьЗаказНаСайт, которая ждёт ссылку на документ: выгрузка молча
	// падала на первой же строке, и статус на сайт не уходил вообще.
	БИАС.ЗарегистрироватьЗаказКВыгрузкеНаСайт(ЗаказПокупателя);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РеализацияТоваровУслуг.Ссылка КАК Реализация
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.Сделка = &Заказ
		|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления
		|	И НЕ РеализацияТоваровУслуг.Ссылка В
		|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|					ЗаказПокупателя.ОсновнойЗаказ
		|				ИЗ
		|					Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|				ГДЕ
		|					ЗаказПокупателя.ОсновнойЗаказ.Сделка = &Заказ)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказПокупателя.ОсновнойЗаказ
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.Ссылка = &Заказ
		|	И НЕ ЗаказПокупателя.ОсновнойЗаказ.ПометкаУдаления
		|	И ЗаказПокупателя.ОсновнойЗаказ ССЫЛКА Документ.РеализацияТоваровУслуг";
	
	
	Запрос.УстановитьПараметр("Заказ", ЗаказПокупателя);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Биас.ПередатьНакладнуюНаСайтВФоне(Выборка.Реализация);
	КонецЦикла;
	
КонецПроцедуры

Функция ПросроченоДней(ДатаДоставки)
	КолДней = (НачалоДня(ТекущаяДата())-НачалоДня(ДатаДоставки))/86400;
	Если КолДней<0 Тогда
		Возврат  0;
	КонецЕсли;
	Выходн = 0;
	Для Сч = 1 По КолДней Цикл
		Если ДеньНедели(НачалоДня(ДатаДоставки)+Сч*86400) = 7 Тогда
			Выходн = Выходн+1;
		КонецЕсли;
	КонецЦикла;
	Возврат КолДней-Выходн;
КонецФункции


