// Формируем коллекцию из текстовых элементов составляющих единое предложение
// приветствия для голосового меню. Содержание текста зависит от состава
// ответственных сотрудников. Определение ответственных выполняется по номеру
// телефона клиента.
Функция СформироватьКоллекциюЭлементовПриветствияПоУмолчнию() Экспорт
	
	// Загрузим шаблон предложения
	СписокПараметров = Новый Массив;
	СписокПараметров.Добавить(ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ИспользоватьСинтезРечиДляГолосовогоМеню);
	СписокПараметров.Добавить(ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ПоставщикУслуг);
	СписокПараметров.Добавить(ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.КлючAPI);
	СписокПараметров.Добавить(ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ПриветствиеГолосовогоМеню);
	СписокПараметров.Добавить(ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ПриветствиеГолосовогоМенюБезОтветственных);
	СписокПараметров.Добавить(ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ОкончаниеГолосовогоМеню);
	СписокПараметров.Добавить(ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ПадежСклоненияИменСотрудников);
	СписокПараметров.Добавить(ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.СоставИмениСотрудников);
	СписокПараметров.Добавить(ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ДикторГолосовогоМеню);
	СписокПараметров.Добавить(ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ДикторГолосовогоМенюБезОтветственных);
	СписокПараметров.Добавить(ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ОптимизацияРасходов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	МИКО_мвНастройкиМаршрутизации.Ссылка КАК Параметр,
		|	МИКО_мвНастройкиМаршрутизации.Значение
		|ИЗ
		|	ПланВидовХарактеристик.МИКО_мвНастройкиМаршрутизации КАК МИКО_мвНастройкиМаршрутизации
		|ГДЕ
		|	МИКО_мвНастройкиМаршрутизации.Ссылка В(&СписокПараметров)";
		
	Запрос.УстановитьПараметр("СписокПараметров", СписокПараметров);
	
	РезультатЗапроса = Запрос.Выполнить();
	ОбходЗапроса = РезультатЗапроса.Выбрать();
	
	// Заполняем настройки
	ПараметрыШаблона = Новый Соответствие;
	
	Пока ОбходЗапроса.Следующий() Цикл
		ПараметрыШаблона.Вставить(ОбходЗапроса.Параметр, ОбходЗапроса.Значение);
	КонецЦикла;
	
	// Сформируем текст предложения по шаблону
	Использовать   = ПараметрыШаблона[ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ИспользоватьСинтезРечиДляГолосовогоМеню];
	СтрПриветствие = ПараметрыШаблона[ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ПриветствиеГолосовогоМеню];
	СтрОкончание   = ПараметрыШаблона[ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ОкончаниеГолосовогоМеню];
	СтрСотрудники  = "";
	Падеж          = ПараметрыШаблона[ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ПадежСклоненияИменСотрудников];
	СоставИмени    = ПараметрыШаблона[ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.СоставИмениСотрудников];
	ПоставщикУслуг = ПараметрыШаблона[ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ПоставщикУслуг];
	КлючAPI	       = ПараметрыШаблона[ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.КлючAPI];
	Диктор	       = ПараметрыШаблона[ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ДикторГолосовогоМеню];
	Оптимизация    = ПараметрыШаблона[ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ОптимизацияРасходов];
	
	Если Использовать = Ложь Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрПриветствие = ПараметрыШаблона[ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ПриветствиеГолосовогоМенюБезОтветственных];
	Диктор	       = ПараметрыШаблона[ПланыВидовХарактеристик.МИКО_мвНастройкиМаршрутизации.ДикторГолосовогоМенюБезОтветственных];
	
	// Первый элемент коллекции - приветствие
	Результат = Новый Структура;
	Результат.Вставить("Приветствие", 	СтрПриветствие);
	Результат.Вставить("Сотрудники", 	Новый Массив);
	Результат.Вставить("Окончание", 	"");	
	
	// Добавим дополнительный параметры
	Результат.Вставить("Параметры", Новый Структура);
	Результат.Параметры.Вставить("Поставщик",   ПоставщикУслуг);
	Результат.Параметры.Вставить("КлючAPI",     КлючAPI);
	Результат.Параметры.Вставить("Диктор",      Диктор);
	Результат.Параметры.Вставить("Оптимизация", Оптимизация);
	
	Возврат Результат;
	
КонецФункции // СформироватьКоллекциюЭлементовПриветствия()

// Формирует данные, содержащие тект приветствия и другую информацию для синтеза
// голоса, в формате понятном АТС.
//
// Параметры:
//  ДанныеПриветствия - Структура - Структура данных возвращаемая функцией "СформироватьКоллекциюЭлементовПриветствия".
//
// Возвращаемое значение:
//  Строка - данные в формате АТС.
//
Функция СформироватьДанныеСтрокиПриветствияДляАТС(ДанныеПриветствия) Экспорт
	
	// Проверим есть ли в платформе объекты для работы с JSON.
	Если ЕстьОбъектJSON() Тогда
	
		СтрJSON = СтрокаJSONСредствамиПлатформы(ДанныеПриветствия);
	
	Иначе
		
		СтруктураДанных = ПреобразоватьДанныеПриветствия(ДанныеПриветствия);
		СтрJSON = JSON(СтруктураДанных);
		
	КонецЕсли; 
	
	Возврат СтрJSON;
	
КонецФункции // СформироватьДанныеСтрокиПриветствияДляАТС()

////////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ РАБОТЫ С JSON.

// Проверим есть ли в платформе необходимые объекты для работы с JSON.
//
Функция ЕстьОбъектJSON() Экспорт

	Попытка
		ОбъектЗаписьJSON = Вычислить("Новый ЗаписьJSON");
	
		Если ТипЗнч(ОбъектЗаписьJSON) = Тип(("ЗаписьJSON")) Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли; 
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции // ЕстьОбъектJSON()

Функция СтрокаJSONСредствамиПлатформы(ДанныеПриветствия)

	СтрПриветствие = "";
	СтрОкончание   = "";
	СтрСотрудники  = "";
		
	ДанныеПриветствия.Свойство("Приветствие", СтрПриветствие);
	ДанныеПриветствия.Свойство("Сотрудники",  СтрСотрудники);
	ДанныеПриветствия.Свойство("Окончание",   СтрОкончание);
	
	ЗаписьJSON = Вычислить("Новый ЗаписьJSON");
	Если ТипЗнч(ЗаписьJSON) <> Тип(("ЗаписьJSON")) Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ПроверятьСтруктуру = Ложь;
	
	ЗаписьJSON.ЗаписатьНачалоОбъекта(); // {
	
	// Укажем API ключ
	ЗаписьJSON.ЗаписатьИмяСвойства("api_key");
	ЗаписьJSON.ЗаписатьЗначение(ДанныеПриветствия.Параметры.КлючAPI);
		
	// Укажем сервис генерации речи (CRT / Yandex) TODO: Google, Nuance
	ЗаписьJSON.ЗаписатьИмяСвойства("tts_service");
	ЗаписьJSON.ЗаписатьЗначение(ДанныеПриветствия.Параметры.Поставщик);
	
	// Укажем диктора
	ЗаписьJSON.ЗаписатьИмяСвойства("dictor");
	ЗаписьJSON.ЗаписатьЗначение(МИКО_стСлужебный.URLEncode(ДанныеПриветствия.Параметры.Диктор));
	
	// Перечислим элементы текста приветствия голосового меню	
	ЗаписьJSON.ЗаписатьИмяСвойства("texttospeech");
	
	// Отимизация расходов включена - делим предложение на части
	ЗаписьJSON.ЗаписатьНачалоМассива();
	
	Если Не ПустаяСтрока(СтрПриветствие) Тогда
		ЗаписьJSON.ЗаписатьЗначение(МИКО_стСлужебный.URLEncode(СтрПриветствие));
	КонецЕсли;
	
	// Используем список сотрудников как есть
	Для Каждого элСтрока Из СтрСотрудники Цикл
		ЗаписьJSON.ЗаписатьЗначение(МИКО_стСлужебный.URLEncode(элСтрока)+". ");
	КонецЦикла;
	
	Если Не ПустаяСтрока(СтрОкончание) Тогда
		ЗаписьJSON.ЗаписатьЗначение(МИКО_стСлужебный.URLEncode(СтрОкончание));
	КонецЕсли;
	
	ЗаписьJSON.ЗаписатьКонецМассива();
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	Текст = ЗаписьJSON.Закрыть();

	Возврат Текст;
	
КонецФункции // ПолучитьСтрокуJSON()

Функция JSON(Значение) Экспорт

    Разделитель="";
   
    ТипЗн=ТипЗнч(Значение);

    Если ТипЗн=Тип("Строка") Тогда
        Стр=""""+Маскировать(Значение)+""""

    ИначеЕсли ТипЗн=Тип("Число") ИЛИ ТипЗнч(Значение)=Тип("Булево") Тогда
        Стр=XMLСтрока(Значение)

    ИначеЕсли ТипЗн=Тип("Дата") Тогда
        Стр=""""+?(ЗначениеЗаполнено(Значение),XMLСтрока(Значение),"")+""""

    ИначеЕсли ТипЗн=Тип("Структура") Тогда
        Стр="{";
        Для Каждого Параметр Из Значение Цикл
            Стр=Стр+Разделитель+Символы.ПС+""""+Параметр.Ключ+""":"+JSON(Параметр.Значение);
            Разделитель=","
        КонецЦикла;
        Стр=Стр+Символы.ПС+"}";

    ИначеЕсли ТипЗн=Тип("Массив") Тогда
        Стр="[";
        Для Каждого Элемент Из Значение Цикл
            Стр=Стр+Разделитель+Символы.ПС+JSON(Элемент);
            Разделитель=","
        КонецЦикла;
        Стр=Стр+Символы.ПС+"]";

    ИначеЕсли ТипЗн=Тип("ТаблицаЗначений") Тогда
        Колонки=Значение.Колонки;
        Массив=Новый Массив;
        Для Каждого СтрокаТЗ Из Значение Цикл
            Структура=Новый Структура;
            Для Каждого Колонка Из Колонки Цикл
                Структура.Вставить(Колонка.Имя,СтрокаТЗ[Колонка.Имя])
            КонецЦикла;
            Массив.Добавить(Структура);
        КонецЦикла;
        Стр=JSON(Массив)

    ИначеЕсли Значение=Неопределено Тогда
        Стр="null"

    Иначе
        Стр=""""+Маскировать(Значение)+""""
    КонецЕсли;

    Возврат Стр
КонецФункции

Функция ФорматированныйJSON(Значение,Отступ="") Экспорт
    Разделитель="";
   
    ТипЗн=ТипЗнч(Значение);

    Если ТипЗн=Тип("Строка") Тогда
        Стр=""""+Маскировать(Значение)+""""

    ИначеЕсли ТипЗн=Тип("Число") ИЛИ ТипЗнч(Значение)=Тип("Булево") Тогда
        Стр=XMLСтрока(Значение)

    ИначеЕсли ТипЗн=Тип("Дата") Тогда
        Стр=""""+?(ЗначениеЗаполнено(Значение),XMLСтрока(Значение),"")+""""

    ИначеЕсли ТипЗн=Тип("Структура") Тогда
        Стр="{";
        Для Каждого Параметр Из Значение Цикл
            Стр=Стр+Разделитель+Символы.ПС+Отступ+""""+Параметр.Ключ+""":"+ФорматированныйJSON(Параметр.Значение,Отступ+Символы.Таб);
            Разделитель=","
        КонецЦикла;
        Стр=Стр+Символы.ПС+Отступ+"}";

    ИначеЕсли ТипЗн=Тип("Массив") Тогда
        Стр="[";
        Для Каждого Элемент Из Значение Цикл
            Стр=Стр+Разделитель+Символы.ПС+Отступ+ФорматированныйJSON(Элемент,Отступ);
            Разделитель=","
        КонецЦикла;
        Стр=Стр+Символы.ПС+Отступ+"]";

    ИначеЕсли ТипЗн=Тип("ТаблицаЗначений") Тогда
        Колонки=Значение.Колонки;
        Массив=Новый Массив;
        Для Каждого СтрокаТЗ Из Значение Цикл
            Структура=Новый Структура;
            Для Каждого Колонка Из Колонки Цикл
                Структура.Вставить(Колонка.Имя,СтрокаТЗ[Колонка.Имя])
            КонецЦикла;
            Массив.Добавить(Структура);
        КонецЦикла;
        Стр=ФорматированныйJSON(Массив)

    ИначеЕсли Значение=Неопределено Тогда
        Стр="null"

    Иначе
        Стр=""""+Маскировать(Значение)+""""
    КонецЕсли;

    Возврат Стр
КонецФункции

Функция Маскировать(Знач Стр)
    Стр=СтрЗаменить(Стр,Символы.ПС,"\n");
    Стр=СтрЗаменить(Стр,Символы.ВК,"\r");
    Стр=СтрЗаменить(Стр,"""","\""");
    Стр=СтрЗаменить(Стр,"'","\'");
    Возврат Стр
КонецФункции

// Преобразует данные приветствия для формирования JSON строки.
// 
Функция ПреобразоватьДанныеПриветствия(Знач ДанныеПриветствия)

	СтруктураДанных = Новый Структура();
	
	СтрПриветствие = "";
	СтрОкончание   = "";
	СтрСотрудники  = "";
		
	ДанныеПриветствия.Свойство("Приветствие", СтрПриветствие);
	ДанныеПриветствия.Свойство("Сотрудники",  СтрСотрудники);
	ДанныеПриветствия.Свойство("Окончание",   СтрОкончание);
	
	СтруктураДанных.Вставить("api_key", 	ДанныеПриветствия.Параметры.КлючAPI);
	СтруктураДанных.Вставить("tts_service", ДанныеПриветствия.Параметры.Поставщик);
	СтруктураДанных.Вставить("dictor", 		МИКО_стСлужебный.URLEncode(ДанныеПриветствия.Параметры.Диктор));
	
	// Сформируем строку приветствия.
	ЭлементМеню = Новый Массив;
	
	Если ДанныеПриветствия.Параметры.Оптимизация = 0 Тогда
		// Отимизация расходов отключена - сложем все в одно предложение.
		ЭлементМеню.Добавить(МИКО_стСлужебный.URLEncode(СтрПриветствие + " " + МИКО_стОбщегоНазначения.СтрокаИзМассиваПодстрок(СтрСотрудники, ". ") + ". " + СтрОкончание));
	Иначе
		// Отимизация расходов включена - делим предложение на части.
		Если Не ПустаяСтрока(СтрПриветствие) Тогда
			ЭлементМеню.Добавить(МИКО_стСлужебный.URLEncode(СтрПриветствие));
		КонецЕсли;
		
		Если ДанныеПриветствия.Параметры.Оптимизация = 1 Тогда
			// Преобразуем список сотрудников в одно предложение.
			Если СтрСотрудники.Количество()>0 Тогда
				ЭлементМеню.Добавить(МИКО_стСлужебный.URLEncode(МИКО_стОбщегоНазначения.СтрокаИзМассиваПодстрок(СтрСотрудники, ". ")+". "));
			КонецЕсли;
		Иначе
			// Используем список сотрудников как есть.
			Для Каждого элСтрока Из СтрСотрудники Цикл
				ЭлементМеню.Добавить(МИКО_стСлужебный.URLEncode(элСтрока+". "));
			КонецЦикла;
		КонецЕсли;
		
		Если Не ПустаяСтрока(СтрОкончание) Тогда
			ЭлементМеню.Добавить(МИКО_стСлужебный.URLEncode(СтрОкончание));
		КонецЕсли;
	КонецЕсли;
	
	СтруктураДанных.Вставить("texttospeech", ЭлементМеню);
	
	Возврат СтруктураДанных;
	
КонецФункции // ПреобразоватьВСтруктуру()
// #КонецОбласти