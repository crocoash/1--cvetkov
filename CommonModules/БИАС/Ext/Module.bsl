КонецФункции

// Реквизиты счёта: структурный блок, если заполнены ФИО/IBAN/ЕГРПОУ
// (либо ФИО/номер для карты), иначе — текст из ПолучитьТекстДляОплаты().
Функция СформироватьРеквизитыHTML(Блоки, БанковскийСчет, ТекстОплаты,ПризначенняПлатежу)

	// У карты нет ЕГРПОУ, поэтому свой блок: номер карты выводим группами
	// по четыре, копируется он сплошными цифрами.
	Если БанковскийСчет.Карта
		И ЗначениеЗаполнено(БанковскийСчет.ФИО)
		И ЗначениеЗаполнено(БанковскийСчет.НомерСчета) Тогда

		НомерКарты = ТолькоЦифрыСтроки(БанковскийСчет.НомерСчета);

		Если Не ПустаяСтрока(НомерКарты) Тогда

			Параметры = Новый Соответствие;
			Параметры.Вставить(
			"Получатель",
			ЭкранироватьHTML(
			СокрЛП(БанковскийСчет.ФИО)
			)
			);
			Параметры.Вставить(
			"КартаКопия",
			ЭкранироватьHTML(НомерКарты)
			);
			Параметры.Вставить(
			"КартаПоказ",
			ЭкранироватьHTML(
			НомерКартыПоГруппам(НомерКарты)
			)
			);
			Параметры.Вставить(
			"Назначение",
			ЭкранироватьHTML(ПризначенняПлатежу)
			);
			Параметры.Вставить(
			"ДатаСчета",
			Формат(
			ТекущаяДата(),
			"ДФ=dd.MM.yyyy HH:mm"
			)
			);

			Возврат ЗаполнитьHTMLБлок(
			Блоки["РеквизитыКарта"],
			Параметры
			);

		КонецЕсли;

	КонецЕсли;

	Если ЗначениеЗаполнено(БанковскийСчет.ФИО)
		И ЗначениеЗаполнено(БанковскийСчет.НомерСчета)
		И ЗначениеЗаполнено(БанковскийСчет.ЕГРПОУ) Тогда
		
		Параметры = Новый Соответствие;
		Параметры.Вставить(
		"Получатель",
		ЭкранироватьHTML(
		"ФОП " + БанковскийСчет.ФИО
		)
		);
		Параметры.Вставить(
		"IBAN",
		ЭкранироватьHTML(
		СокрЛП(БанковскийСчет.НомерСчета)
		)
		);
		Параметры.Вставить(
		"ЕГРПОУ",
		ЭкранироватьHTML(
		СокрЛП(БанковскийСчет.ЕГРПОУ)
		)
		);
		Параметры.Вставить(	
		"Назначение",	
		ЭкранироватьHTML(	
		ПризначенняПлатежу)	
		);
		Параметры.Вставить(
		"ДатаСчета",
		Формат(
		ТекущаяДата(),
		"ДФ=dd.MM.yyyy HH:mm"
		)
		);
		
		Возврат ЗаполнитьHTMLБлок(
		Блоки["РеквизитыСтруктур"],
		Параметры
		);
		
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстОплаты) Тогда
		Возврат "";
	КонецЕсли;
	
	Параметры = Новый Соответствие;
	Параметры.Вставить(
	"Текст",
	ЭкранироватьHTML(ТекстОплаты)
	);
	
	Возврат ЗаполнитьHTMLБлок(
	Блоки["РеквизитыТекст"],
	Параметры
	);
	
КонецФункции

Функция ТолькоЦифрыСтроки(Значение)

	Исходная = СокрЛП(Строка(Значение));
	Результат = "";

	Для Индекс = 1 По СтрДлина(Исходная) Цикл

		Символ = Сред(Исходная, Индекс, 1);

		Если Найти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// 5523245803326881 -> "5523 2458 0332 6881"
Функция НомерКартыПоГруппам(НомерКарты)

	Результат = "";
	Индекс = 1;

	Пока Индекс <= СтрДлина(НомерКарты) Цикл

		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + " ";
		КонецЕсли;

		Результат = Результат + Сред(НомерКарты, Индекс, 4);
		Индекс = Индекс + 4;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// QR и кнопки оплаты для панели счёта.
// QR и ссылка bank.gov.ua работают только с IBAN, поэтому для карты
// ни того, ни другого нет — только кнопка копирования номера.
Функция БлокиОплатыHTML(
	Блоки,
	БанковскийСчет,
	Сумма,
	ПризначенняПлатежу)

	Результат = Новый Структура("QR, Кнопка", "", "");

	Если Не ЗначениеЗаполнено(БанковскийСчет)
		Или Не ЗначениеЗаполнено(БанковскийСчет.НомерСчета) Тогда

		Возврат Результат;

	КонецЕсли;

	Если БанковскийСчет.Карта Тогда

		НомерКарты = ТолькоЦифрыСтроки(
		БанковскийСчет.НомерСчета
		);

		Если ПустаяСтрока(НомерКарты) Тогда
			Возврат Результат;
		КонецЕсли;

		Параметры = Новый Соответствие;
		Параметры.Вставить(
		"КартаКопия",
		ЭкранироватьHTML(НомерКарты)
		);

		Результат.Кнопка = ЗаполнитьHTMLБлок(
		Блоки["КнопкаКопироватьКарту"],
		Параметры
		);

		Возврат Результат;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(БанковскийСчет.ФИО)
		Или Не ЗначениеЗаполнено(БанковскийСчет.ЕГРПОУ)
		Или Сумма <= 0 Тогда

		Возврат Результат;

	КонецЕсли;

	Получатель = "ФОП " + БанковскийСчет.ФИО;
	НомерДляОплаты = СтрЗаменить(
	СокрЛП(БанковскийСчет.НомерСчета),
	" ",
	""
	);

	ЕГРПОУ = СокрЛП(Строка(БанковскийСчет.ЕГРПОУ));

	РезультатQR =
	Справочники.БанковскиеСчета
	.NBU_QR_СформироватьQR(
	Получатель,
	НомерДляОплаты,
	ЕГРПОУ,
	Сумма,
	ПризначенняПлатежу,
	"300x300"
	);

	Если Не РезультатQR.Успех Тогда

		Сообщить(
		"Ошибка QR: "
		+ РезультатQR.Сообщение
		);

	ИначеЕсли РезультатQR.QRДвоичныеДанные <> Неопределено Тогда

		Результат.QR = QRБлокHTML(
		Блоки,
		РезультатQR.QRДвоичныеДанные
		);

	КонецЕсли;

	// Ссылку берём ту же, что зашита в QR, чтобы кнопка и скан
	// вели на один и тот же payload.
	Если РезультатQR.Успех
		И Не ПустаяСтрока(РезультатQR.СсылкаНБУ) Тогда

		СсылкаОплаты = РезультатQR.СсылкаНБУ;

	Иначе

		СсылкаОплаты = СсылкаОплатыНБУ(
		Получатель,
		НомерДляОплаты,
		ЕГРПОУ,
		Сумма,
		ПризначенняПлатежу
		);

	КонецЕсли;

	Параметры = Новый Соответствие;
	Параметры.Вставить(
	"URL",
	ЭкранироватьHTML(СсылкаОплаты)
	);

	Результат.Кнопка = ЗаполнитьHTMLБлок(
	Блоки["КнопкаБанк"],
	Параметры
	);

	Возврат Результат;

КонецФункции

Функция QRБлокHTML(Блоки, QRДвоичныеДанные)
	
	// Base64Строка вставляет переводы строк — убираем.
	Base64 = Base64Строка(QRДвоичныеДанные);
	Base64 = СтрЗаменить(Base64, Символы.ВК, "");
	Base64 = СтрЗаменить(Base64, Символы.ПС, "");
	
	Параметры = Новый Соответствие;
	Параметры.Вставить("QRBase64", Base64);
	
	Возврат ЗаполнитьHTMLБлок(
	Блоки["QRБлок"],
	Параметры
	);
	
КонецФункции

Функция ПанельСчетаHTML(
	Блоки,
	Ид,
	Активна,
	ЗаголовокПечати,
	Вариант,
	Расчет,
	СуммаКОплате,
	СуммаКомиссии,
	СуммаЗачисления,
	РеквизитыHTML,
	QRHTML,
	КнопкаHTML)
	
	РазбивкаHTML = "";
	Примечание = "до зарахування";
	
	Если СуммаКомиссии > 0 Тогда
		
		Примечание = "разом із комісією 1%";
		
		ПараметрыРазбивки = Новый Соответствие;
		ПараметрыРазбивки.Вставить(
		"Зачисление",
		ФорматГрн(СуммаЗачисления)
		);
		ПараметрыРазбивки.Вставить(
		"Комиссия",
		ФорматГрн(СуммаКомиссии)
		);
		
		РазбивкаHTML = ЗаполнитьHTMLБлок(
		Блоки["Разбивка"],
		ПараметрыРазбивки
		);
		
	КонецЕсли;
	
	Параметры = Новый Соответствие;
	Параметры.Вставить("Ид", Ид);
	Параметры.Вставить(
	"Актив",
	?(Активна, " is-active", "")
	);
	Параметры.Вставить(
	"ЗаголовокПечати",
	ЭкранироватьHTML(ЗаголовокПечати)
	);
	Параметры.Вставить(
	"Вариант",
	ЭкранироватьHTML(Вариант)
	);
	Параметры.Вставить(
	"Расчет",
	ЭкранироватьHTML(Расчет)
	);
	Параметры.Вставить(
	"Сумма",
	ФорматГрн(СуммаКОплате)
	);
	Параметры.Вставить("Примечание", Примечание);
	Параметры.Вставить("Разбивка", РазбивкаHTML);
	Параметры.Вставить("Реквизиты", РеквизитыHTML);
	Параметры.Вставить("QR", QRHTML);
	Параметры.Вставить("Кнопка", КнопкаHTML);
	
	Возврат ЗаполнитьHTMLБлок(
	Блоки["Панель"],
	Параметры
	);
	
КонецФункции

// Ссылка вида https://bank.gov.ua/qr/<base64url> — тот же payload
// стандарта НБУ, что зашивается в QR-код. Открывается банковским
// приложением с заполненными реквизитами.
Функция СсылкаОплатыНБУ(
	Получатель,
	IBAN,
	ЕГРПОУ,
	Сумма,
	ПризначенняПлатежу)
	
	ПС = Символы.ПС;
	
	Payload =
	"BCD" + ПС
	+ "002" + ПС
	+ "1" + ПС
	+ "UCT" + ПС
	+ ПС
	+ СокрЛП(Получатель) + ПС
	+ СокрЛП(IBAN) + ПС
	+ "UAH"
	+ Формат(
	Сумма,
	"ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0"
	) + ПС
	+ СокрЛП(ЕГРПОУ) + ПС
	+ ПС
	+ ПС
	+ ПризначенняПлатежу;
	
	Base64 = Base64Строка(
	ПолучитьДвоичныеДанныеИзСтроки(
	Payload,
	КодировкаТекста.UTF8,
	Ложь
	)
	);
	
	// Base64 -> base64url без переносов и паддинга.
	Base64 = СтрЗаменить(Base64, Символы.ВК, "");
	Base64 = СтрЗаменить(Base64, Символы.ПС, "");
	Base64 = СтрЗаменить(Base64, "+", "-");
	Base64 = СтрЗаменить(Base64, "/", "_");
	Base64 = СтрЗаменить(Base64, "=", "");
	
	Возврат "https://bank.gov.ua/qr/" + Base64;
	
КонецФункции

Функция ЗаписатьHTMLВоВременныйФайл(HTML)
	
	ПутьКФайлу = ПолучитьИмяВременногоФайла("html");
	
	ЗаписьТекста = Новый ЗаписьТекста(
	ПутьКФайлу,
	КодировкаТекста.UTF8
	);
	
	ЗаписьТекста.Записать(HTML);
	ЗаписьТекста.Закрыть();
	
	Возврат ПутьКФайлу;
	
КонецФункции

// Удаляет прежние файлы клиента (invoice_КОД*, включая старые PDF)
// и записывает свежие HTML и XML.
Процедура ВыгрузитьФайлыРезервовНаFTP(
	Контрагент,
	ПутьКФайлуHTML,
	ПутьКФайлуXML)
	
	ИмяФайлаВыгрузки =
	"invoice_"
	+ Контрагент.Код;
	
	FTPСервер = Константы.ФТПСервер.Получить();
	FTPЛогин = Константы.ФТПЛогин.Получить();
	FTPПароль = Константы.ФТППароль.Получить();
	
	FTPСоединение = Новый FTPСоединение(
	FTPСервер,
	,
	FTPЛогин,
	FTPПароль,
	,
	Истина,
	20
	);
	
	ИмяКаталога =
	"/cvetkovtm.com/www/assets/shop/sync/reserves";
	
	FTPСоединение.УстановитьТекущийКаталог(
	ИмяКаталога
	);
	
	НайденныеФайлы = FTPСоединение.НайтиФайлы(
	ИмяКаталога,
	ИмяФайлаВыгрузки + "*"
	);
	
	Для Каждого ФайлFTP Из НайденныеФайлы Цикл

		Попытка

			FTPСоединение.Удалить(
			ФайлFTP.ПолноеИмя
			);

		Исключение

			// Файл мог уже быть удалён параллельным запуском выгрузки резервов
			// или недоступен по правам на сервере — не прерываем выгрузку из-за этого.

		КонецПопытки;

	КонецЦикла;

	СтрокаДаты =
	"_"
	+ Формат(
	ТекущаяДата(),
	"ДФ=yyyy_MM_dd_HHmmss"
	);
	
	Если Не ПустаяСтрока(ПутьКФайлуHTML) Тогда
		
		FTPСоединение.Записать(
		ПутьКФайлуHTML,
		ИмяФайлаВыгрузки
		+ СтрокаДаты
		+ ".html"
		);
		
		Сообщить(
		"Записан HTML "
		+ ИмяФайлаВыгрузки
		);
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(ПутьКФайлуXML) Тогда
		
		FTPСоединение.Записать(
		ПутьКФайлуXML,
		ИмяФайлаВыгрузки
		+ СтрокаДаты
		+ ".xml"
		);
		
	КонецЕсли;
	
КонецПроцедуры
























Процедура ВывестиОбласть(Макет, ТабДокумент, ОбластьМакета)
	
	ОбластьПробел = Макет.ПолучитьОбласть("Пробел"); 
	
	
	ОбластьПроверкиДляТабличнойЧасти = Новый Массив;  	
	ОбластьПроверкиДляТабличнойЧасти.Добавить(ОбластьПробел);
	ОбластьПроверкиДляТабличнойЧасти.Добавить(ОбластьПробел);
	ОбластьПроверкиДляТабличнойЧасти.Добавить(ОбластьМакета);	
	
	Если НЕ ТабДокумент.ПроверитьВывод(ОбластьПроверкиДляТабличнойЧасти) Тогда 
		
		
		ТабДокумент.Вывести(ОбластьПробел);
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		
	КонецЕсли;
	
	
	ТабДокумент.Вывести(ОбластьМакета);	
