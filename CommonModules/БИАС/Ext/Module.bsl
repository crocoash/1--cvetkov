	Если Не ЗначениеЗаполнено(Характеристика) Тогда
		
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ГруппаЦветовФотографии.Наименование КАК НаименованиеФото
	|ИЗ
	|	Справочник.ГруппаЦветов.Фотографии КАК ГруппаЦветовФотографии
	|ГДЕ
	|	ГруппаЦветовФотографии.Ссылка В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ГруппаЦветовХарактеристики.Ссылка
	|			ИЗ
	|				Справочник.ГруппаЦветов.Характеристики КАК ГруппаЦветовХарактеристики
	|			ГДЕ
	|				ГруппаЦветовХарактеристики.Характеристика = &Характеристика)
	|	И ГруппаЦветовФотографии.Главная
	|	И НЕ ГруппаЦветовФотографии.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГруппаЦветовФотографии.Наименование";
	Запрос.УстановитьПараметр("Характеристика",Характеристика);
	
	
	
