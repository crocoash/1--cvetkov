Процедура ЗагрузитьЗаказы() Экспорт
	
	Если Константы.ДатаИсполнения1.Получить() = Дата(1,1,1) Тогда
		НаборЗаписей = РегистрыНакопления.ТоварыВРезервеНаСкладах.СоздатьНаборЗаписей();
		НаборЗаписей.мпериод = НачалоДня(ТекущаяДата() - 100 * 24 * 60 * 60);
		НаборЗаписей.Удалить();
		ЗагрузкаЗаказовССайта(100);
	КонецЕсли;
	
	FTPСервер = Константы.ФТПСервер.Получить();
	FTPПорт   = Константы.ФТППорт.Получить();
	FTPЛогин  = Константы.ФТПЛогин.Получить();
	FTPПароль = Константы.ФТППароль.Получить();
	
	FTPСоединение = Новый FTPСоединение(FTPСервер, , FTPЛогин, FTPПароль, , Истина, 20);
	
	Если FTPСоединение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеФайлы = FTPСоединение.НайтиФайлы("/cvetkovtm.com/www/", "order_test.xml");
	НайденныеФайлы1 = FTPСоединение.НайтиФайлы("/cvetkovtm.com/www/", "reserv_test.xml");
	
	КаталогВременныхФайлов = КаталогВременныхФайлов();	
	
	Для Каждого Файл Из НайденныеФайлы Цикл
		
		ПутьКФайлуНаСервере = Файл.ПолноеИмя;
		ПутьКФайлу          = КаталогВременныхФайлов + Файл.Имя;
		FTPСоединение.Получить(ПутьКФайлуНаСервере, ПутьКФайлу);
		
		Количест = ПолучитьКолВо(ПутьКФайлу);
		ЗагрузкаЗаказовССайта(Количест);
		Константы.ДатаИсполнения1.Установить(Неопределено);
		FTPСоединение.Удалить(Файл.ПолноеИмя);
		
	КонецЦикла;
	
	Для Каждого Файл Из НайденныеФайлы1 Цикл
		
		ПутьКФайлуНаСервере = Файл.ПолноеИмя;
		ПутьКФайлу          = КаталогВременныхФайлов + Файл.Имя;
		FTPСоединение.Получить(ПутьКФайлуНаСервере, ПутьКФайлу);
		
		Количест = ПолучитьКолВо(ПутьКФайлу);
		
		НаборЗаписей = РегистрыНакопления.ТоварыВРезервеНаСкладах.СоздатьНаборЗаписей();
		НаборЗаписей.мпериод = НачалоДня(ТекущаяДата() - Количест * 24 * 60 * 60);
		НаборЗаписей.Удалить();
		Константы.ДатаИсполнения1.Установить(Неопределено);			
		FTPСоединение.Удалить(Файл.ПолноеИмя);
		
	КонецЦикла;;
	
КонецПроцедуры

функция ПолучитьКолВо(пПутьКФайлу) 
	
	УстановитьПривилегированныйРежим(Истина);
	
	ЧтениеXML = Новый ЧтениеXML;
	
	ЧтениеXML.ОткрытьФайл(пПутьКФайлу);
	
	ПостроительDOM = Новый ПостроительDOM;
	
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	
	ЭлементDOM = ДокументDOM.ЭлементДокумента.ПервыйДочерний;
	
	
	СтруктураШапки = Новый Структура;
	
	МассивСтрок = Новый Массив;
	
	Для Каждого ДочернийУзел Из ЭлементDOM.ДочерниеУзлы Цикл
		
		Если ДочернийУзел.ИмяЭлемента = "items" Или
			ДочернийУзел.ИмяЭлемента = "sets" Тогда
			
			Для Каждого Строка Из ДочернийУзел.ДочерниеУзлы Цикл
				
				СтруктураСтроки = Новый Структура;
				
				Для Каждого Реквизит Из Строка.ДочерниеУзлы Цикл
					
					СтруктураСтроки.Вставить(Реквизит.ИмяЭлемента, Реквизит.ТекстовоеСодержимое);
					
				КонецЦикла;
				
				МассивСтрок.Добавить(СтруктураСтроки);
				
			КонецЦикла;
			
		Иначе
			
			СтруктураШапки.Вставить(ДочернийУзел.ИмяЭлемента, ДочернийУзел.ТекстовоеСодержимое);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если СтруктураШапки.Свойство("count") Тогда
		
		Если ПустаяСтрока(СтруктураШапки.user_id) Тогда
			
			Контрагент = Неопределено;
			
			Если СтруктураШапки.Свойство("count") И
				Не ПустаяСтрока(СтруктураШапки.count)
				Тогда
				
				Возврат СтруктураШапки.count;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат 0;		
	
КонецФункции

Процедура ЗагрузкаЗаказовССайта(Дней) Экспорт
	
	ТекущаяДата = ТекущаяДата();
	ДатаДляУдаления = НачалоДня(ТекущаяДата - Дней * 24 * 60 * 60); // Дней назад
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	| ГДЕ
	|    Дата >= &ДатаДляУдаления";
	
	Запрос.УстановитьПараметр("ДатаДляУдаления", ДатаДляУдаления);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	// Удаляем заказы
	Пока Выборка.Следующий() Цикл
		Попытка
			Выборка.Ссылка.ПолучитьОбъект().Удалить(); // Удаляем объект, связанный с записью
		Исключение
			
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузкаЗаказовРозетка() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Соединение = Новый HTTPСоединение("api-seller.rozetka.com.ua", , , , , , Новый ЗащищенноеСоединениеOpenSSL());
	
	Запрос = Новый HTTPЗапрос;
	
	СрокДействия = Константы.СрокДействияТокенаРозетка.Получить();
	
	Если СрокДействия >= (ТекущаяДата() + 300) Тогда
		
		Токен = Константы.ТокенРозетка.Получить();
		
	Иначе
		
		Запрос.АдресРесурса = "/sites";
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");
		Запрос.Заголовки = Заголовки;
		
		Запись = Новый ЗаписьJSON;
		Запись.УстановитьСтроку();
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("username");
		Запись.ЗаписатьЗначение(Константы.ЛогинРозетка.Получить());
		Запись.ЗаписатьИмяСвойства("password");
		Запись.ЗаписатьЗначение(ПолучитьBase64СтрокуИзДвоичныхДанных(ПолучитьДвоичныеДанныеИзСтроки(Константы.ПарольРозетка.Получить(), "UTF-8", Ложь)));
		Запись.ЗаписатьКонецОбъекта();
		ТелоЗапроса = Запись.Закрыть();
		
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
		
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		
		Если Ответ.КодСостояния <> 200 Тогда
			ЗаписьЖурналаРегистрации("Авторизация на api-seller.rozetka.com.ua не пройдена !", УровеньЖурналаРегистрации.Ошибка);
			Возврат;
		КонецЕсли;
		
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
		
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоОтвета);
		СоответствиеИзJSON = ПрочитатьJSON(Чтение, Истина);
		
		Токен = СоответствиеИзJSON["content"]["access_token"];
		
		Константы.СрокДействияТокенаРозетка.Установить(ТекущаяДата() + 86400);
		Константы.ТокенРозетка.Установить(Токен);
		
	КонецЕсли;
	
	Запрос.АдресРесурса = "/orders/export?type=1&created_from=" + Формат(НачалоДня(ТекущаяДата()) - 10 * 86400, "ДФ=yyyy-MM-dd");
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + Токен);
	Запрос.Заголовки = Заголовки;
	
	ПутьКФайлу = ПолучитьИмяВременногоФайла();
	
	Ответ = Соединение.Получить(Запрос, ПутьКФайлу);
	
	Если Ответ.КодСостояния <> 200 Тогда
		ЗаписьЖурналаРегистрации("Не удалось загрузить заказы с api-seller.rozetka.com.ua !", УровеньЖурналаРегистрации.Ошибка);
		УдалитьФайлы(ПутьКФайлу);
		Возврат;
	КонецЕсли;
	
	// ТабличныйДокумент.Прочитать() выбирает парсер по расширению,
	// поэтому определяем реальный формат выгрузки по сигнатуре и переименовываем файл.
	ПутьТаблицы = ПутьКФайлу + "." + ФорматТаблицыПоСигнатуре(ПутьКФайлу);
	ПереместитьФайл(ПутьКФайлу, ПутьТаблицы);
	
	ТабДок = Новый ТабличныйДокумент;
	
	Попытка
		ТабДок.Прочитать(ПутьТаблицы, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		ЗаписьЖурналаРегистрации(ОписаниеОшибки(), УровеньЖурналаРегистрации.Ошибка);
		УдалитьФайлы(ПутьТаблицы);
		Возврат;
	КонецПопытки;
	
	УдалитьФайлы(ПутьТаблицы);
	
	ТЗЗаказы = Новый ТаблицаЗначений;
	
	ТЗЗаказы.Колонки.Добавить("Номер");
	ТЗЗаказы.Колонки.Добавить("Дата");
	ТЗЗаказы.Колонки.Добавить("АдресДоставки");
	ТЗЗаказы.Колонки.Добавить("СпособОплаты");
	ТЗЗаказы.Колонки.Добавить("Комментарий");
	ТЗЗаказы.Колонки.Добавить("Получатель");
	ТЗЗаказы.Колонки.Добавить("Телефон");
	ТЗЗаказы.Колонки.Добавить("СтатусЗаказа");
	ТЗЗаказы.Колонки.Добавить("ШтрихКод");
	ТЗЗаказы.Колонки.Добавить("Количество");
	ТЗЗаказы.Колонки.Добавить("Счет");
	ТЗЗаказы.Колонки.Добавить("СпособДоставка");
	ТЗЗаказы.Колонки.Добавить("Цена");
	ТЗЗаказы.Колонки.Добавить("Сумма");
	ТЗЗаказы.Колонки.Добавить("Отделение");
	ТЗЗаказы.Колонки.Добавить("ГородДоставка");
	
	НоваПейКасса = Справочники.БанковскиеСчета.НайтиПоКоду("000000039");
	Расчетный = Справочники.БанковскиеСчета.НайтиПоКоду("000000026");
	
	КоличествоСтрок = ТабДок.ВысотаТаблицы;
	ТекущаяСтрока = 2;
	
	Номер = ТекстЯчейки(ТабДок, ТекущаяСтрока, 1);
	
	Пока Не ПустаяСтрока(Номер) Цикл
		
		НоваяСтрока = ТЗЗаказы.Добавить();
		
		Область   = ТекстЯчейки(ТабДок, ТекущаяСтрока, 18);
		Город     = ТекстЯчейки(ТабДок, ТекущаяСтрока, 17);
		Отделение = ТекстЯчейки(ТабДок, ТекущаяСтрока, 20);
		Доставка  = ТекстЯчейки(ТабДок, ТекущаяСтрока, 3);
		ВидОплаты = ТекстЯчейки(ТабДок, ТекущаяСтрока, 4);
		
		НоваяСтрока.Номер          = Номер;
		НоваяСтрока.Дата           = ТекстЯчейки(ТабДок, ТекущаяСтрока, 2);
		НоваяСтрока.АдресДоставки  = Город + " " + Отделение + Символы.ПС + Область + Символы.ПС + ВидОплаты + Символы.ПС + Символы.ПС + Доставка;
		НоваяСтрока.СпособОплаты   = ТекстЯчейки(ТабДок, ТекущаяСтрока, 4);
		НоваяСтрока.Комментарий    = ТекстЯчейки(ТабДок, ТекущаяСтрока, 5);
		НоваяСтрока.Получатель     = ТекстЯчейки(ТабДок, ТекущаяСтрока, 6);
		НоваяСтрока.СпособДоставка = ?(СтрНайти(Доставка, "ROZETKA"), Справочники.СпособыОтправки.НайтиПоКоду("000000006"), Справочники.СпособыОтправки.НоваяПочта);
		
		НоваяСтрока.Телефон      = ТекстЯчейки(ТабДок, ТекущаяСтрока, 7);
		НоваяСтрока.СтатусЗаказа = ТекстЯчейки(ТабДок, ТекущаяСтрока, 9);
		НоваяСтрока.ШтрихКод     = ТекстЯчейки(ТабДок, ТекущаяСтрока, 11);
		НоваяСтрока.Количество   = ТекстЯчейки(ТабДок, ТекущаяСтрока, 13);
		НоваяСтрока.Счет         = НоваПейКасса;
		НоваяСтрока.Цена         = ТекстЯчейки(ТабДок, ТекущаяСтрока, 14);
		НоваяСтрока.Сумма        = ТекстЯчейки(ТабДок, ТекущаяСтрока, 15);
		
		НоваяСтрока.ГородДоставка = Справочники.ЛМ_Города.ПолучитьГород(Город);
		НоваяСтрока.Отделение     = Отделение;
		
		ТекущаяСтрока = ТекущаяСтрока + 1;
		
		Если ТекущаяСтрока > КоличествоСтрок Тогда
			Прервать;
		КонецЕсли;
		
		Номер = ТекстЯчейки(ТабДок, ТекущаяСтрока, 1);
		
	КонецЦикла;
	
	Если ТЗЗаказы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТЗНомера = ТЗЗаказы.Скопировать(, "Номер");
	ТЗНомера.Свернуть("Номер");
	
	Для Каждого СтрокаТЗНомера Из ТЗНомера Цикл
		ОбработатьЗаказ(СтрокаТЗНомера, ТЗЗаказы, Ложь);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ТекстЯчейки(ТабДок, Строка, Колонка)
	Возврат СокрЛП(ТабДок.Область(Строка, Колонка, Строка, Колонка).Текст);
