// Формирует HTML (вместо PDF) + XML по резервам контрагента и выгружает на FTP.
// HTML собирается из текстового макета "РезервHTML" документа ЗаказПокупателя
// (блоки разделены комментариями "БЛОК:Имя", плейсхолдеры — {{Имя}}).
// Бизнес-логика (статусы, суммы, счета, QR) повторяет СформироватьФайлыPDFXMLРезервов.

Процедура СформироватьФайлыHTMLXMLРезервов(СтруктураПараметров) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ТипКомплект = Перечисления.ТипыНоменклатуры.Комплект;
	ТипЦенМелкийОпт = Справочники.ТипыЦенНоменклатуры.НайтиПоКоду("000000014");
	
	Запрос = Новый Запрос;
	
	Если СтруктураПараметров.Свойство("Реализация")
		И ЗначениеЗаполнено(СтруктураПараметров.Реализация) Тогда
		
		Контрагент = СтруктураПараметров.Реализация.Контрагент;
		
		// Контрагент далее нужен при формировании XML.
		СтруктураПараметров.Вставить("Контрагент", Контрагент);
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ЗаказПокупателя,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Дата КАК Дата,
		|	ВЫРАЗИТЬ(
		|		ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
		|		КАК Документ.ЗаказПокупателя
		|	).ДоговорКонтрагента КАК Договор,
		|	ВЫРАЗИТЬ(
		|		ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
		|		КАК Документ.ЗаказПокупателя
		|	).ТипЦен КАК ТипЦен,
		|	ВЫРАЗИТЬ(
		|		ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
		|		КАК Документ.ЗаказПокупателя
		|	).ВалютаДокумента КАК Валюта,
		|	ВЫРАЗИТЬ(
		|		ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
		|		КАК Документ.ЗаказПокупателя
		|	).КурсВзаиморасчетов КАК Курс,
		|	ВЫРАЗИТЬ(
		|		ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
		|		КАК Документ.ЗаказПокупателя
		|	).КратностьВзаиморасчетов КАК Кратность,
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
		|		КАК ХарактеристикаНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.НК КАК НК,
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура.ЕдиницаХраненияОстатков
		|		КАК Единица,
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток
		|		- ЕСТЬNULL(ВложенныйЗапрос.Количество, 0) КАК Количество,
		|	0 КАК Цена,
		|	0 КАК Сумма,
		|	ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
		|		,
		|		ДокументРезерва ССЫЛКА Документ.ЗаказПокупателя
		|		И ВЫРАЗИТЬ(
		|			ДокументРезерва
		|			КАК Документ.ЗаказПокупателя
		|		).Контрагент = &Контрагент
		|	) КАК ТоварыВРезервеНаСкладахОстатки
		|
		|	ЛЕВОЕ СОЕДИНЕНИЕ
		|	(
		|		ВЫБРАТЬ
		|			РеализацияТоваровУслугТовары.ЗаказПокупателя
		|				КАК ЗаказПокупателя,
		|			РеализацияТоваровУслугТовары.Номенклатура
		|				КАК Номенклатура,
		|			РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры
		|				КАК ХарактеристикаНоменклатуры,
		|			РеализацияТоваровУслугТовары.НК КАК НК,
		|			СУММА(
		|				РеализацияТоваровУслугТовары.Количество
		|			) КАК Количество
		|		ИЗ
		|			Документ.РеализацияТоваровУслуг.Товары
		|				КАК РеализацияТоваровУслугТовары
		|		ГДЕ
		|			РеализацияТоваровУслугТовары.Ссылка = &Реализация
		|		СГРУППИРОВАТЬ ПО
		|			РеализацияТоваровУслугТовары.ЗаказПокупателя,
		|			РеализацияТоваровУслугТовары.Номенклатура,
		|			РеализацияТоваровУслугТовары.ХарактеристикаНоменклатуры,
		|			РеализацияТоваровУслугТовары.НК
		|	) КАК ВложенныйЗапрос
		|	ПО
		|		ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
		|			= ВложенныйЗапрос.ЗаказПокупателя
		|		И ТоварыВРезервеНаСкладахОстатки.Номенклатура
		|			= ВложенныйЗапрос.Номенклатура
		|		И ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
		|			= ВложенныйЗапрос.ХарактеристикаНоменклатуры
		|		И ТоварыВРезервеНаСкладахОстатки.НК
		|			= ВложенныйЗапрос.НК
		|ГДЕ
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток
		|		- ЕСТЬNULL(ВложенныйЗапрос.Количество, 0) > 0
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
		
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр(
		"Реализация",
		СтруктураПараметров.Реализация
		);
		
	Иначе
		
		Если НЕ СтруктураПараметров.Свойство("Контрагент")
			ИЛИ НЕ ЗначениеЗаполнено(СтруктураПараметров.Контрагент) Тогда
			
			ЗаписьЖурналаРегистрации(
			"БИАС",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не заполнен Контрагент"
			);
			
			Возврат;
			
		КонецЕсли;
		
		Контрагент = СтруктураПараметров.Контрагент;
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва КАК ЗаказПокупателя,
		|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Дата КАК Дата,
		|	ВЫРАЗИТЬ(
		|		ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
		|		КАК Документ.ЗаказПокупателя
		|	).ДоговорКонтрагента КАК Договор,
		|	ВЫРАЗИТЬ(
		|		ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
		|		КАК Документ.ЗаказПокупателя
		|	).ТипЦен КАК ТипЦен,
		|	ВЫРАЗИТЬ(
		|		ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
		|		КАК Документ.ЗаказПокупателя
		|	).ВалютаДокумента КАК Валюта,
		|	ВЫРАЗИТЬ(
		|		ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
		|		КАК Документ.ЗаказПокупателя
		|	).КурсВзаиморасчетов КАК Курс,
		|	ВЫРАЗИТЬ(
		|		ТоварыВРезервеНаСкладахОстатки.ДокументРезерва
		|		КАК Документ.ЗаказПокупателя
		|	).КратностьВзаиморасчетов КАК Кратность,
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры
		|		КАК ХарактеристикаНоменклатуры,
		|	ТоварыВРезервеНаСкладахОстатки.НК КАК НК,
		|	ТоварыВРезервеНаСкладахОстатки.Номенклатура.ЕдиницаХраненияОстатков
		|		КАК Единица,
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК Количество,
		|	0 КАК Цена,
		|	0 КАК Сумма,
		|	ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад
		|ИЗ
		|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
		|		,
		|		ДокументРезерва ССЫЛКА Документ.ЗаказПокупателя
		|		И ВЫРАЗИТЬ(
		|			ДокументРезерва
		|			КАК Документ.ЗаказПокупателя
		|		).Контрагент = &Контрагент
		|	) КАК ТоварыВРезервеНаСкладахОстатки
		|ГДЕ
		|	ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток > 0
		|УПОРЯДОЧИТЬ ПО
		|	Дата";
		
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		
	КонецЕсли;
	
	ТЗРезервы = Запрос.Выполнить().Выгрузить();
	ПризначенняПлатежу = "Оплата за товар від " + Контрагент.Код;
	Блоки = БлокиМакетаРезервHTML();
	
	//////////////////////////////////////////////////////////////////////////
	// РЕЗЕРВА НЕТ — ПЕРЕЗАПИСЫВАЕМ HTML И XML
	
	Если ТЗРезервы.Количество() = 0 Тогда
		
		Параметры = Новый Соответствие;
		Параметры.Вставить(
		"ДатаОбновления",
		Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm")
		);
		
		HTML = ЗаполнитьHTMLБлок(
		Блоки["ПустойРезерв"],
		Параметры
		);
		
		ПутьКФайлуHTML = ЗаписатьHTMLВоВременныйФайл(HTML);
		ПутьКФайлуXML = ПолучитьИмяВременногоФайла("xml");
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьФайл(ПутьКФайлуXML);
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("invoices");
		ЗаписьXML.ЗаписатьНачалоЭлемента("invoice");
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("date");
		ЗаписьXML.ЗаписатьТекст(
		Формат(
		ТекущаяДата(),
		"ДФ=yyyy-MM-dd HH:mm:ss"
		)
		);
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("pack_status");
		ЗаписьXML.ЗаписатьТекст("Резерв відсутній");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("total");
		ЗаписьXML.ЗаписатьТекст("0");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("delivery_post_code");
		ЗаписьXML.ЗаписатьТекст("Товар відсутній у резерві");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("user_debt");
		ЗаписьXML.ЗаписатьТекст("0");
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // invoice
		ЗаписьXML.ЗаписатьКонецЭлемента(); // invoices
		
		ЗаписьXML.Закрыть();
		
		СтруктураПараметров.Вставить(
		"ПутьКФайлуHTML",
		ПутьКФайлуHTML
		);
		
		СтруктураПараметров.Вставить(
		"ПутьКФайлуXML",
		ПутьКФайлуXML
		);
		
		Попытка
			
			ВыгрузитьФайлыРезервовНаFTP(
			Контрагент,
			ПутьКФайлуHTML,
			ПутьКФайлуXML
			);
			
			Сообщить(
			"Резерв отсутствует. HTML и XML перезаписаны."
			);
			
		Исключение
			
			ЗаписьЖурналаРегистрации(
			"БИАС",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Ошибка выгрузки пустого резерва на FTP: "
			+ ОписаниеОшибки()
			);
			
		КонецПопытки;
		
		Если Не ПустаяСтрока(ПутьКФайлуHTML) Тогда
			УдалитьФайлы(ПутьКФайлуHTML);
		КонецЕсли;
		
		Если Не ПустаяСтрока(ПутьКФайлуXML) Тогда
			УдалитьФайлы(ПутьКФайлуXML);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////
	// РЕЗЕРВ ЕСТЬ
	
	ТЗЗаказы = ТЗРезервы.Скопировать(
	,
	"ЗаказПокупателя, Склад"
	);
	
	ТЗРезервы.Сортировать(
	"Номенклатура, ХарактеристикаНоменклатуры"
	);
	
	ТЗЗаказы.Свернуть("ЗаказПокупателя");
	
	// Шапка документа.
	Параметры = Новый Соответствие;
	Параметры.Вставить(
	"ДатаОбновления",
	Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy HH:mm")
	);
	Параметры.Вставить(
	"КодКлиента",
	ЭкранироватьHTML(НомерБезВедущихНулей(Контрагент.Код))
	);
	
	HTML = ЗаполнитьHTMLБлок(Блоки["Шапка"], Параметры);
	
	// Секции заказов копим отдельно: в готовом документе сначала
	// идут подсумок и счёт, заказы — после них.
	ЗаказыHTML = "";
	
	// TODO: накладные отгруженных заказов.
	// В PDF-версии здесь вызывался
	// Документы.РеализацияТоваровУслуг.ДобавитьНакладныеОтгруженныхЗаказов().
	// Для HTML нужен аналог, возвращающий строку — те же блоки
	// ЗаказНачало/Строка/ЗаказКонец из Блоки. Когда будет готов:
	// ЗаказыHTML = ЗаказыHTML + Документы.РеализацияТоваровУслуг
	//     .ДобавитьНакладныеОтгруженныхЗаказовHTML(Контрагент, Блоки);
	
	ИтогоРезерв = 0;
	Готово = 0;
	ОстатокРезерва = 0;
	
	Для Каждого СтрокаТЗ Из ТЗЗаказы Цикл
		
		НомерСтроки = 1;
		КоличествоИтог = 0;
		СуммаИтог = 0;
		РядкиHTML = "";
		
		ТоварыЗаказа = ТЗРезервы.НайтиСтроки(
		Новый Структура(
		"ЗаказПокупателя",
		СтрокаТЗ.ЗаказПокупателя
		)
		);
		
		Для Каждого СтрокаЗаказа Из ТоварыЗаказа Цикл
			
			СрокИзготовления = Дата(1, 1, 1);
			СрокИзготовленияКонец = Дата(1, 1, 1);
			
			Закреплен = Биас.РезервЗакреплен(
			СтрокаЗаказа.ЗаказПокупателя,
			СтрокаЗаказа.ХарактеристикаНоменклатуры,
			СтрокаЗаказа.ХарактеристикаНоменклатуры.Владелец
			);
			
			Если ЗначениеЗаполнено(СтрокаЗаказа.НК) Тогда
				
				НайденныеСтроки =
				СтрокаТЗ.ЗаказПокупателя.Товары.НайтиСтроки(
				Новый Структура(
				"ХарактеристикаНоменклатуры",
				СтрокаЗаказа.НК
				)
				);
				
			Иначе
				
				НайденныеСтроки =
				СтрокаТЗ.ЗаказПокупателя.Товары.НайтиСтроки(
				Новый Структура(
				"Номенклатура, ХарактеристикаНоменклатуры",
				СтрокаЗаказа.Номенклатура,
				СтрокаЗаказа.ХарактеристикаНоменклатуры
				)
				);
				
			КонецЕсли;
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ТипЦен = СтрокаЗаказа.ТипЦен;
			
			Если ТипЦен.Код = "000000001"
				И НайденныеСтроки[0].Номенклатура
				.ВидНоменклатуры
				.ТипНоменклатуры <> ТипКомплект Тогда
				
				ТипЦен = ТипЦенМелкийОпт;
				
			КонецЕсли;
			
			Скидка =
			НайденныеСтроки[0].ПроцентСкидкиНаценки
			+ НайденныеСтроки[0].ПроцентАвтоматическихСкидок;
			
			ЦенаБС =
			Ценообразование.ПолучитьЦенуНоменклатуры(
			СтрокаЗаказа.Номенклатура,
			СтрокаЗаказа.ХарактеристикаНоменклатуры,
			ТипЦен,
			СтрокаЗаказа.Дата,
			СтрокаЗаказа.Единица,
			СтрокаЗаказа.Валюта,
			СтрокаЗаказа.Курс,
			СтрокаЗаказа.Кратность,
			,
			СтрокаЗаказа.Договор
			);
			
			СтрокаЗаказа.Цена =
			Цел(
			ЦенаБС
			* (1 - Скидка / 100)
			);
			
			СтрокаЗаказа.Сумма =
			Цел(
			СтрокаЗаказа.Цена
			* СтрокаЗаказа.Количество
			);
			
			ХарактеристикаОбъект =
			СтрокаЗаказа.ХарактеристикаНоменклатуры
			.ПолучитьОбъект();
			
			Попытка
				
				Ростовка =
				ХарактеристикаОбъект.ПолучитьРостовку(
				Истина
				);
				
				Предзаказ = Ростовка.ИгнорироватьНоль;
				
			Исключение
				
				Предзаказ = Ложь;
				
			КонецПопытки;
			
			СтатусОпт =
			Справочники.Склады.ПолучитьСтатус(
			Истина,
			СтрокаЗаказа.Склад,
			Предзаказ
			);
			
			СтатусГотовности =
			СтрокаЗаказа.Склад.СтатусГотовности;
			
			Если СтатусОпт <> "1" Тогда
				
				Если СтатусОпт = "2"
					И (
					НайденныеСтроки[0].СрокИзготовления
					= Дата(1, 1, 1)
					ИЛИ НайденныеСтроки[0].СрокИзготовления
					< ТекущаяДата()
					) Тогда
					
					ДатуСНеПошит =
					ХарактеристикаОбъект
					.ПолучитьДатуСНеПошит();
					
					Если ЗначениеЗаполнено(ДатуСНеПошит) Тогда
						
						СрокИзготовления =
						ДатуСНеПошит.ДатаПОшиваНачало;
						
						СрокИзготовленияКонец =
						ДатуСНеПошит.ДатаПОшиваКонец;
						
					КонецЕсли;
					
				ИначеЕсли СтатусОпт = "3"
					И (
					НайденныеСтроки[0].СрокИзготовления
					= Дата(1, 1, 1)
					ИЛИ НайденныеСтроки[0].СрокИзготовления
					< ТекущаяДата()
					) Тогда
					
					ДатуИзготовления =
					ХарактеристикаОбъект
					.ПолучитьДатуИзготовления(Истина);
					
					Если ЗначениеЗаполнено(
						ДатуИзготовления
						) Тогда
						
						СрокИзготовления =
						ДатуИзготовления.ДатаПОшиваНачало;
						
						СрокИзготовленияКонец =
						ДатуИзготовления.ДатаПОшиваКонец;
						
					КонецЕсли;
					
				Иначе
					
					СрокИзготовления =
					НайденныеСтроки[0].СрокИзготовления;
					
					СрокИзготовленияКонец =
					НайденныеСтроки[0].СрокИзготовленияКонец;
					
				КонецЕсли;
				
				Если СтатусОпт = "0"
					И Не Предзаказ Тогда
					
					// Оставляем статус склада без изменения.
					
				ИначеЕсли СрокИзготовления <> Дата(1, 1, 1)
					И СрокИзготовленияКонец <> Дата(1, 1, 1)
					И СрокИзготовленияКонец
					<> СрокИзготовления Тогда
					
					СтатусГотовности =
					Формат(
					СрокИзготовления,
					"ДФ=dd.MM"
					)
					+ " – "
					+ Формат(
					СрокИзготовленияКонец,
					"ДФ=dd.MM"
					);
					
				ИначеЕсли СрокИзготовления
					<> Дата(1, 1, 1) Тогда
					
					СтатусГотовности =
					Формат(
					СрокИзготовления,
					"ДФ=dd.MM"
					);
					
				ИначеЕсли СрокИзготовленияКонец
					<> Дата(1, 1, 1) Тогда
					
					СтатусГотовности =
					Формат(
					СрокИзготовленияКонец,
					"ДФ=dd.MM"
					);
					
				Иначе
					
					СтатусГотовности = ?(
					СтатусГотовности = "Списан (Брак)"
					И Предзаказ,
					"Виготовляється",
					СтатусГотовности
					);
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Класс пилюли статуса.
			Если СтатусГотовности = "Списан (Брак)" Тогда
				КлассПилюли = "pill--brak";
			ИначеЕсли СтатусОпт = "1" Тогда
				КлассПилюли = "pill--done";
			Иначе
				КлассПилюли = "pill--wip";
			КонецЕсли;
			
			// Подсветка закреплённого резерва.
			КлассСтроки = "";
			
			Если Закреплен
				И СтатусОпт <> "1"
				И СтатусГотовности <> "Списан (Брак)" Тогда
				
				КлассСтроки = " class=""tr--pinned""";
				
			КонецЕсли;
			
			// Ссылка на карточку товара.
			СсылкаСайта = "";
			
			Попытка
				
				СсылкаСайта =
				ХарактеристикаОбъект.ПолучитьСсылкуСайта();
				
			Исключение
				
				СсылкаСайта = "";
				
			КонецПопытки;
			
			// Фото.
			ФотоURL = СсылкаНаФотоРезерва(СтрокаЗаказа);
			
			Если ПустаяСтрока(ФотоURL) Тогда
				
				ФотоHTML = Блоки["ФотоЗаглушка"];
				
			Иначе
				
				ПараметрыФото = Новый Соответствие;
				
				ПараметрыФото.Вставить(
				"URL",
				ЭкранироватьHTML(ФотоURL)
				);
				
				ПараметрыФото.Вставить(
				"СсылкаСайта",
				ЭкранироватьHTML(СсылкаСайта)
				);
				
				ПараметрыФото.Вставить(
				"Название",
				ЭкранироватьHTML(
				СтрокаЗаказа.Номенклатура
				)
				);
				
				ФотоHTML = ЗаполнитьHTMLБлок(
				Блоки["ФотоСсылка"],
				ПараметрыФото
				);
				
			КонецЕсли;
			
			// Параметры строки товара.
			Параметры = Новый Соответствие;
			
			Параметры.Вставить(
			"Номер",
			Строка(НомерСтроки)
			);
			
			Параметры.Вставить(
			"Фото",
			ФотоHTML
			);
			
			Параметры.Вставить(
			"СсылкаСайта",
			ЭкранироватьHTML(СсылкаСайта)
			);
			
			Параметры.Вставить(
			"КлассСтроки",
			КлассСтроки
			);
			
			Параметры.Вставить(
			"КлассПилюли",
			КлассПилюли
			);
			
			Параметры.Вставить(
			"Готовность",
			ЭкранироватьHTML(СтатусГотовности)
			);
			
			Параметры.Вставить(
			"ЦеноваяГруппа",
			ЭкранироватьHTML(
			СтрокаЗаказа.Номенклатура.ЦеноваяГруппа
			)
			);
			
			Параметры.Вставить(
			"Номенклатура",
			ЭкранироватьHTML(
			СтрокаЗаказа.Номенклатура
			)
			);
			
			Параметры.Вставить(
			"Характеристика",
			ЭкранироватьHTML(
			СтрокаЗаказа.ХарактеристикаНоменклатуры
			)
			);
			
			Параметры.Вставить(
			"Количество",
			Формат(
			СтрокаЗаказа.Количество,
			"ЧДЦ=0; ЧН=0"
			)
			);
			
			Параметры.Вставить(
			"Цена",
			ФорматГрн(СтрокаЗаказа.Цена)
			);
			
			Параметры.Вставить(
			"Сумма",
			ФорматГрн(СтрокаЗаказа.Сумма)
			);
			РядкиHTML =
			РядкиHTML
			+ ЗаполнитьHTMLБлок(
			Блоки["Строка"],
			Параметры
			);
			
			// В итоговые суммы брак не включаем.
			Если СтатусГотовности <> "Списан (Брак)" Тогда
				
				ИтогоРезерв =
				ИтогоРезерв
				+ СтрокаЗаказа.Сумма;
				
				КоличествоИтог =
				КоличествоИтог
				+ СтрокаЗаказа.Количество;
				
				СуммаИтог =
				СуммаИтог
				+ СтрокаЗаказа.Сумма;
				
				Если СтатусОпт = "1"
					ИЛИ Закреплен Тогда
					
					Готово =
					Готово
					+ СтрокаЗаказа.Сумма;
					
				Иначе
					
					ОстатокРезерва =
					ОстатокРезерва
					+ СтрокаЗаказа.Сумма;
					
				КонецЕсли;
				
			КонецЕсли;
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла;
		
		// Шапка заказа заполняется после строк — известны итоги.
		Параметры = Новый Соответствие;
		Параметры.Вставить(
		"Заголовок",
		"Замовлення №"
		+ ЭкранироватьHTML(
		НомерБезВедущихНулей(
		СтрокаТЗ.ЗаказПокупателя.Номер
		)
		)
		);
		Параметры.Вставить(
		"ДатаЗаказа",
		Формат(
		СтрокаТЗ.ЗаказПокупателя.Дата,
		"ДФ=dd.MM.yyyy"
		)
		);
		Параметры.Вставить(
		"СуммаЗаказа",
		ФорматГрн(СуммаИтог)
		);
		Параметры.Вставить(
		"Позиций",
		Формат(КоличествоИтог, "ЧДЦ=0; ЧН=0")
		);
		
		ЗаказыHTML =
		ЗаказыHTML
		+ ЗаполнитьHTMLБлок(
		Блоки["ЗаказНачало"],
		Параметры
		)
		+ РядкиHTML
		+ Блоки["ЗаказКонец"];
		
	КонецЦикла;
	
	//////////////////////////////////////////////////////////////////////////
	// ОБЩИЕ ИТОГИ
	
	БалансПокупателя =
	Окр(
	Документы.ЗаказПокупателя
	.ДолгКонтрагентаНаДату(
	Контрагент,
	ТекущаяДата()
	)
	);
	
	ПредоплатаРезерва =
	Цел(
	ОстатокРезерва
	* 30
	/ 100
	);
	
	Итого =
	Цел(
	ПредоплатаРезерва
	+ Готово
	+ БалансПокупателя
	);
	
	ИтогоБезОстаткаРезерва =
	Цел(
	ИтогоРезерв
	+ БалансПокупателя
	);
	
	Если Итого < 0 Тогда
		Итого = 0;
	КонецЕсли;
	
	Если ИтогоБезОстаткаРезерва < 0 Тогда
		ИтогоБезОстаткаРезерва = 0;
	КонецЕсли;
	
	ИтогиHTML = Блоки["ИтогиНачало"];
	
	ИтогиHTML =
	ИтогиHTML
	+ ИтогиРядHTML(
	Блоки,
	"sumrow--total",
	"Всього у резерві",
	ФорматГрн(ИтогоРезерв) + " грн"
	);
	
	Если Готово <> 0 Тогда
		
		ИтогиHTML =
		ИтогиHTML
		+ ИтогиРядHTML(
		Блоки,
		"",
		"<span class=""dot dot--done""></span>"
		+ "Виготовлено · готове до відправки",
		ФорматГрн(Готово) + " грн"
		);
		
	КонецЕсли;
	
	Если ОстатокРезерва <> 0 Тогда
		
		ИтогиHTML =
		ИтогиHTML
		+ ИтогиРядHTML(
		Блоки,
		"",
		"<span class=""dot dot--wip""></span>"
		+ "Виготовляється",
		ФорматГрн(ОстатокРезерва) + " грн"
		)
		+ ИтогиРядHTML(
		Блоки,
		"sumrow--sub",
		"у т.ч. передплата 30%",
		ФорматГрн(ПредоплатаРезерва) + " грн"
		);
		
	КонецЕсли;
	
	
	Если БалансПокупателя <> 0 Тогда
		
		МеткаБаланса =
		"Поточний баланс"
		+ ?(
		БалансПокупателя > 0,
		"<span class=""debttag"">борг</span>",
		"<span class=""debttag debttag--plus"">"
		+ "переплата</span>"
		);
		
		ИтогиHTML =
		ИтогиHTML
		+ ИтогиРядHTML(
		Блоки,
		"sumrow--balance",
		МеткаБаланса,
		ФорматГрн(БалансПокупателя) + " грн"
		); 
		
		
	КонецЕсли;  
	
	Если БалансПокупателя <> 0 Тогда
		
		КнопкаИсторииHTML = Блоки["КнопкаИстория"];
		
	Иначе
		
		КнопкаИсторииHTML = "";
		
	КонецЕсли;
	
	ПараметрыИтогов = Новый Соответствие;
	
	ПараметрыИтогов.Вставить(
	"Кнопка",
	КнопкаИсторииHTML
	);
	
	ИтогиHTML =
	ИтогиHTML
	+ ЗаполнитьHTMLБлок(
	Блоки["ИтогиКонец"],
	ПараметрыИтогов
	);
	
	
	Баланс = ?(
	Цел(БалансПокупателя) = 0,
	"",
	" + ("
	+ Строка(Цел(БалансПокупателя))
	+ ")"
	);
	
	ИтогоРезервСтрока = ?(
	ИтогоРезерв = 0,
	"",
	Строка(Цел(ИтогоРезерв))
	);
	
	ПредоплатаРезерваСтрока = ?(
	ПредоплатаРезерва = 0,
	"",
	Строка(ПредоплатаРезерва)
	);
	
	СтрокаГотово = ?(
	Готово = 0,
	"",
	" + "
	+ Строка(Цел(Готово))
	);
	
	//////////////////////////////////////////////////////////////////////////
	// СЧЕТ ДЛЯ ЧАСТИЧНОЙ ОПЛАТЫ
	
	ШаблонСМС = "";
	ВыставленныйСчет = Неопределено;
	СуммаПоСчету = Итого;
	СуммаКомиссии = 0;
	
	Если Итого > 30
		И Итого < 90000
		И Справочники.БанковскиеСчета.МожноВыставитьСчет(
		Контрагент
		) Тогда
		
		// Служебный учёт лимитов не должен ронять формирование файлов резервов:
		// при конфликте записи счёт просто не подставится в текст оплаты.
		Попытка

			ВыставленныйСчет =
			Справочники.БанковскиеСчета.ПолучитьВыставленныеСчета(
			Контрагент,
			Итого
			);

		Исключение

			ВыставленныйСчет = Неопределено;

			ЗаписьЖурналаРегистрации(
			"ВыставленныеСчета",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.ВыставленныеСчетаКонтрагентов,
			Контрагент,
			"Не удалось обновить выставленный счёт: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

		Если ЗначениеЗаполнено(ВыставленныйСчет)
			И ЗначениеЗаполнено(
			ВыставленныйСчет.БанковскийСчет
			) Тогда
			
			ШаблонСМС =
			ВыставленныйСчет.БанковскийСчет
			.ПолучитьОбъект()
			.ПолучитьТекстДляОплаты();
			
		КонецЕсли;
		
	Иначе
		
		Справочники.БанковскиеСчета
		.УдалитьВыставленныйСчет(
		Контрагент
		);
		
	КонецЕсли;
	
	НужноДобавитьПроцент = Ложь;
	
	ВсеСплачено =
	(
	ОстатокРезерва = 0
	И Итого < 30
	)
	ИЛИ ИтогоБезОстаткаРезерва <= 30;
	
	// Текст расчёта для первой панели счёта.
	ВариантОплаты = "";
	Расчет = "";
	СтатусОплаты = "";
	
	Если ВсеСплачено Тогда
		
		СтатусОплаты = "Все сплачено";
		
	ИначеЕсли Итого <= 30 Тогда
		
		СтатусОплаты = "Передплата сплачена";
		
	ИначеЕсли ОстатокРезерва = 0 Тогда
		
		НужноДобавитьПроцент = Истина;
		ВариантОплаты = "Готовий товар до сплати";
		
		Если ИтогоРезерв <> ИтогоБезОстаткаРезерва Тогда
			
			Расчет =
			ИтогоРезервСтрока
			+ Баланс
			+ " = "
			+ Строка(ИтогоБезОстаткаРезерва)
			+ " грн";
			
		КонецЕсли;
		
	Иначе
		
		НужноДобавитьПроцент = Истина;
		
		ВариантОплаты = ?(
		ОстатокРезерва <> 0,
		"Передплата 30% + готовий товар",
		"До сплати"
		);
		
		Если Итого <> ПредоплатаРезерва Тогда
			
			Расчет =
			ПредоплатаРезерваСтрока
			+ СтрокаГотово
			+ Баланс
			+ " = "
			+ Строка(Итого)
			+ " грн";
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Счёт для панели частичной оплаты: выставленный, а если его нет
	// (сумма вне лимита 90 000 либо счёт не выставился) — счёт без
	// лимита, как у полной оплаты. Иначе клиент остаётся без
	// реквизитов и QR.
	СчетЧастичнойОплаты = Неопределено;
	
	Если ЗначениеЗаполнено(ВыставленныйСчет)
		И ЗначениеЗаполнено(
		ВыставленныйСчет.БанковскийСчет
		) Тогда
		
		СчетЧастичнойОплаты =
		ВыставленныйСчет.БанковскийСчет;
		
	ИначеЕсли НужноДобавитьПроцент Тогда
		
		СчетЧастичнойОплаты =
		Справочники.БанковскиеСчета
		.ПолучитьБанковскийСчетБезЛимита(
		Контрагент
		);
		
		Если ЗначениеЗаполнено(СчетЧастичнойОплаты) Тогда
			
			ШаблонСМС =
			СчетЧастичнойОплаты
			.ПолучитьОбъект()
			.ПолучитьТекстДляОплаты();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетЧастичнойОплаты)
		И НужноДобавитьПроцент
		И Не СчетЧастичнойОплаты.Карта Тогда
		
		// Банк снимает 1% с пришедшей суммы, поэтому комиссия считается от 99,
		// а не от 100: Итого + Цел(Итого/99) после снятия 1% даёт ровно Итого.
		// Вариант Цел(Итого/100) занижал платёж примерно на 0,01% суммы
		// (на 46 000 - около 5 грн), и остаток копился у клиента как недобор.
		СуммаКомиссии = Цел(Итого / 99);
		СуммаПоСчету = Итого + СуммаКомиссии;
		
	КонецЕсли;
	
	// Первая панель.
	ЕстьПанель2 =
	Не ВсеСплачено
	И ОстатокРезерва <> 0;
	
	Если Не ПустаяСтрока(СтатусОплаты) Тогда
		
		Параметры = Новый Соответствие;
		Параметры.Вставить("Ид", "p1");
		Параметры.Вставить("Актив", " is-active");
		Параметры.Вставить(
		"ЗаголовокПечати",
		"Стан оплати"
		);
		Параметры.Вставить(
		"Текст",
		ЭкранироватьHTML(СтатусОплаты)
		);
		
		Панель1HTML = ЗаполнитьHTMLБлок(
		Блоки["ПанельСтатус"],
		Параметры
		);
		
	Иначе
		
		РеквизитыHTML = "";
		QRHTML = "";
		КнопкаHTML = "";
		
		Если ЗначениеЗаполнено(СчетЧастичнойОплаты) Тогда
			
			РеквизитыHTML = СформироватьРеквизитыHTML(
			Блоки,
			СчетЧастичнойОплаты,
			ШаблонСМС,ПризначенняПлатежу)
			;

			БлокиОплаты = БлокиОплатыHTML(
			Блоки,
			СчетЧастичнойОплаты,
			СуммаПоСчету,
			ПризначенняПлатежу
			);

			QRHTML = БлокиОплаты.QR;
			КнопкаHTML = БлокиОплаты.Кнопка;

		КонецЕсли;
		
		Панель1HTML = ПанельСчетаHTML(
		Блоки,
		"p1",
		Истина,
		"Рахунок 1 · Передплата 30%",
		ВариантОплаты,
		Расчет,
		СуммаПоСчету,
		СуммаКомиссии,
		Итого,
		РеквизитыHTML,
		QRHTML,
		КнопкаHTML
		);
		
	КонецЕсли;
	
	//////////////////////////////////////////////////////////////////////////
	// ПОЛНАЯ ОПЛАТА
	
	Панель2HTML = "";
	
	Если ЕстьПанель2 Тогда
		
		Если ЗначениеЗаполнено(ВыставленныйСчет)
			И ЗначениеЗаполнено(
			ВыставленныйСчет.БанковскийСчет
			)
			И Не ВыставленныйСчет.БанковскийСчет.Карта Тогда
			
			БанковскийСчет =
			ВыставленныйСчет.БанковскийСчет;
			
		Иначе
			
			БанковскийСчет =
			Справочники.БанковскиеСчета
			.ПолучитьБанковскийСчетБезЛимита(
			Контрагент
			);
			
		КонецЕсли;
		
		СуммаПолнойОплаты =
		ИтогоБезОстаткаРезерва;
		
		СуммаКомиссииПолнойОплаты = 0;
		
		Если ЗначениеЗаполнено(БанковскийСчет)
			И Не БанковскийСчет.Карта Тогда
			
			// Делитель 99, а не 100 - см. комментарий у СуммаКомиссии выше.
			СуммаКомиссииПолнойОплаты =
			Цел(
			ИтогоБезОстаткаРезерва
			/ 99
			);
			
			СуммаПолнойОплаты =
			ИтогоБезОстаткаРезерва
			+ СуммаКомиссииПолнойОплаты;
			
		КонецЕсли;
		
		РасчетПолнойОплаты =
		ИтогоРезервСтрока
		+ Баланс
		+ " = "
		+ Строка(ИтогоБезОстаткаРезерва)
		+ " грн";
		
		РеквизитыHTML = "";
		QRHTML = "";
		КнопкаHTML = "";
		
		Если ЗначениеЗаполнено(БанковскийСчет) Тогда
			
			РеквизитыHTML = СформироватьРеквизитыHTML(
			Блоки,
			БанковскийСчет,
			БанковскийСчет
			.ПолучитьОбъект()
			.ПолучитьТекстДляОплаты(),
			ПризначенняПлатежу
			);
			
			БлокиОплаты = БлокиОплатыHTML(
			Блоки,
			БанковскийСчет,
			СуммаПолнойОплаты,
			ПризначенняПлатежу
			);

			QRHTML = БлокиОплаты.QR;
			КнопкаHTML = БлокиОплаты.Кнопка;
			
		КонецЕсли;
		
		Панель2HTML = ПанельСчетаHTML(
		Блоки,
		"p2",
		Ложь,
		"Рахунок 2 · Повна оплата",
		"Повна оплата",
		РасчетПолнойОплаты,
		СуммаПолнойОплаты,
		СуммаКомиссииПолнойОплаты,
		ИтогоБезОстаткаРезерва,
		РеквизитыHTML,
		QRHTML,
		КнопкаHTML
		);
		
	КонецЕсли;
	
	// Собираем секцию счёта: табы только при двух панелях.
	ТабыHTML = "";
	
	Если ЕстьПанель2 Тогда
		
		Параметры = Новый Соответствие;
		Параметры.Вставить(
		"Таб1",
		?(
		ПустаяСтрока(СтатусОплаты),
		"Передплата 30%",
		"Стан оплати"
		)
		);
		Параметры.Вставить("Таб2", "Повна оплата");
		
		ТабыHTML = ЗаполнитьHTMLБлок(
		Блоки["Табы"],
		Параметры
		);
		
	КонецЕсли;
	
	Параметры = Новый Соответствие;
	Параметры.Вставить("Табы", ТабыHTML);
	
	СчетHTML =
	ЗаполнитьHTMLБлок(
	Блоки["СчетНачало"],
	Параметры
	)
	+ Панель1HTML
	+ Панель2HTML
	+ Блоки["СчетКонец"];
	
	// Порядок секций: шапка → подсумок → счёт → заказы → подвал.
	HTML =
	HTML
	+ ИтогиHTML
	+ СчетHTML
	+ ЗаказыHTML
	+ Блоки["Подвал"];
	
	//////////////////////////////////////////////////////////////////////////
	// СОХРАНЕНИЕ HTML
	
	ПутьКФайлуHTML = ЗаписатьHTMLВоВременныйФайл(HTML);
	
	СтруктураПараметров.Вставить(
	"ПутьКФайлуHTML",
	ПутьКФайлуHTML
	);
	
	//////////////////////////////////////////////////////////////////////////
	// СОХРАНЕНИЕ XML
	
	ПутьКФайлуXML =
	ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ПутьКФайлуXML);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("invoices");
	ЗаписьXML.ЗаписатьНачалоЭлемента("invoice");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("date");
	ЗаписьXML.ЗаписатьТекст(
	Формат(
	ТекущаяДата(),
	"ДФ=yyyy-MM-dd HH:mm:ss"
	)
	);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("pack_status");
	ЗаписьXML.ЗаписатьТекст(".");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("total");
	ЗаписьXML.ЗаписатьТекст(
	Формат(
	ТЗРезервы.Итог("Сумма"),
	"ЧДЦ=0; ЧГ=0"
	)
	);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента(
	"delivery_post_code"
	);
	
	ЗаписьXML.ЗаписатьТекст(
	"Товар в резерве"
	);
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("user_debt");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // invoice
	ЗаписьXML.ЗаписатьКонецЭлемента(); // invoices
	
	ЗаписьXML.Закрыть();
	
	СтруктураПараметров.Вставить(
	"ПутьКФайлуXML",
	ПутьКФайлуXML
	);
	
	//////////////////////////////////////////////////////////////////////////
	// ВЫГРУЗКА НА FTP
	
	Попытка
		
		ВыгрузитьФайлыРезервовНаFTP(
		Контрагент,
		СтруктураПараметров.ПутьКФайлуHTML,
		СтруктураПараметров.ПутьКФайлуXML
		);
		
	Исключение
		
		ЗаписьЖурналаРегистрации(
		"БИАС",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		"Ошибка выгрузки резервов на FTP: "
		+ ОписаниеОшибки()
		);
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	//////////////////////////////////////////////////////////////////////////
	// УДАЛЕНИЕ ВРЕМЕННЫХ ФАЙЛОВ
	
	Если Не ПустаяСтрока(
		СтруктураПараметров.ПутьКФайлуHTML
		) Тогда
		
		УдалитьФайлы(
		СтруктураПараметров.ПутьКФайлуHTML
		);
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(
		СтруктураПараметров.ПутьКФайлуXML
		) Тогда
		
		УдалитьФайлы(
		СтруктураПараметров.ПутьКФайлуXML
		);

	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

