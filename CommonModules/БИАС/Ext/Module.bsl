Процедура ВыгрузкаПокупателейНашСайт(Контрагент = Неопределено) Экспорт
	FTPСервер = Константы.ФТПСервер.Получить();
	FTPПорт   = Константы.ФТППорт.Получить();
	FTPЛогин  = Константы.ФТПЛогин.Получить();
	FTPПароль = Константы.ФТППароль.Получить();
	
	FTPСоединение = Новый FTPСоединение(FTPСервер, , FTPЛогин, FTPПароль, , Истина, 20);
	
	Если FTPСоединение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	FTPСоединение.УстановитьТекущийКаталог("/cvetkovtm.com/www/assets/shop/sync");
	
	// Определяем имя файла
	ИмяФайла = ?(Контрагент = Неопределено, "users_all.csv", "users.csv");
	
	// Выполняем выгрузку только один раз, передавая параметр при его наличии
	ОбменПокупателямиНашСайт = Обработки.ОбменПокупателямиНашСайт.Создать();
	Текст = ОбменПокупателямиНашСайт.ВыполнитьВыгрузку(Контрагент);
	
	Если Контрагент <> Неопределено Тогда
		// Проверяем существование файла users.csv для добавления данных
		НайденныеФайлы = FTPСоединение.НайтиФайлы("/cvetkovtm.com/www/assets/shop/sync", ИмяФайла);
		
		Если НайденныеФайлы.Количество() > 0 Тогда
			ПутьКФайлуНаСервере = НайденныеФайлы[0].ПолноеИмя;
			ПутьКФайлу = КаталогВременныхФайлов() + НайденныеФайлы[0].Имя;
			
			// Скачиваем существующий файл и читаем его строки
			FTPСоединение.Получить(ПутьКФайлуНаСервере, ПутьКФайлу);
			
			СуществующийТекстДокумент = Новый ТекстовыйДокумент;
			СуществующийТекстДокумент.Прочитать(ПутьКФайлу);
			
			// Добавляем все строки, кроме первой (заголовка), к новому тексту
			Для Стр = 2 По СуществующийТекстДокумент.КоличествоСтрок() Цикл
				Текст = Текст + СуществующийТекстДокумент.ПолучитьСтроку(Стр) + Символы.ПС;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// Записываем итоговый текст в файл
	ПутьКФайлу = ПолучитьИмяВременногоФайла("csv");
	Запись = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
	
	// Загружаем файл на сервер
	FTPСоединение.Записать(ПутьКФайлу, ИмяФайла);
	
	// Удаляем временный файл
	УдалитьФайлы(ПутьКФайлу);
КонецПроцедуры

// Вся статистика для сайта одним регламентным заданием (объединено из трёх отдельных - слишком
// много регламентных заданий не нужно, одно FTP-соединение на всё). Пишет четыре файла:
//   shipments_by_category.csv   - клиент/месяц/тип/пол/сезон, месяц = дата отгрузки
//   orders_by_category.csv      - то же самое, месяц = дата заказа
//   sales_by_region.csv         - контрагент/область/город, итог за период (дашборд руководителя)
//   sales_summary_by_month.csv  - месяц/область/город/укрупнённый тип, БЕЗ контрагента
// Все четыре кладём в отдельный подкаталог sync/stats, чтобы не мешались с обменными файлами
// в корне sync (по аналогии с уже существующим sync/orders для заказов с сайта).
//
Процедура ВыгрузкаСтатистикиНашСайт() Экспорт
	FTPСервер = Константы.ФТПСервер.Получить();
	FTPПорт   = Константы.ФТППорт.Получить();
	FTPЛогин  = Константы.ФТПЛогин.Получить();
	FTPПароль = Константы.ФТППароль.Получить();

	FTPСоединение = Новый FTPСоединение(FTPСервер, , FTPЛогин, FTPПароль, , Истина, 20);

	Если FTPСоединение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КаталогСтатистики = "/cvetkovtm.com/www/assets/shop/sync/stats";

	Попытка
		FTPСоединение.УстановитьТекущийКаталог(КаталогСтатистики);
	Исключение
		// Каталога ещё нет (первый запуск после переноса) - создаём и заходим повторно.
		FTPСоединение.СоздатьКаталог(КаталогСтатистики);
		FTPСоединение.УстановитьТекущийКаталог(КаталогСтатистики);
	КонецПопытки;

	// Единый период на все файлы - с начала позапрошлого календарного года по текущий момент,
	// то есть три года включая текущий незавершённый (в 2026-м это 01.01.2024 - сегодня).
	// Скользящее окно "-24 месяца" не подходило: при запуске в середине года самый ранний год
	// обрезался (июль 2024 - декабрь 2024), и на дашборде колонка за этот год показывала половину
	// продаж, из-за чего сравнение по годам врало.
	ДатаОкончания = ТекущаяДатаСеанса();
	ДатаНачала    = Дата(Год(ДатаОкончания) - 2, 1, 1);

	ОбменПокупателямиНашСайт = Обработки.ОбменПокупателямиНашСайт.Создать();

	ЗаписатьФайлНаFTP(FTPСоединение,
		ОбменПокупателямиНашСайт.ВыполнитьВыгрузкуСтатистикиОтгрузок(ДатаНачала, ДатаОкончания),
		"shipments_by_category.csv");

	ЗаписатьФайлНаFTP(FTPСоединение,
		ОбменПокупателямиНашСайт.ВыполнитьВыгрузкуСтатистикиЗаказов(ДатаНачала, ДатаОкончания),
		"orders_by_category.csv");

	ЗаписатьФайлНаFTP(FTPСоединение,
		ОбменПокупателямиНашСайт.ВыполнитьВыгрузкуСводнойПоРегионам(ДатаНачала, ДатаОкончания),
		"sales_by_region.csv");

	ЗаписатьФайлНаFTP(FTPСоединение,
		ОбменПокупателямиНашСайт.ВыполнитьВыгрузкуСводнойПоМесяцамИРегионам(ДатаНачала, ДатаОкончания),
		"sales_summary_by_month.csv");
КонецПроцедуры

// Вспомогательная - записать текст во временный файл и залить на уже открытое FTP-соединение,
// с удалением временного файла. Общая для всех файлов ВыгрузкаСтатистикиНашСайт.
//
Процедура ЗаписатьФайлНаFTP(FTPСоединение, Текст, ИмяФайла)

	ПутьКФайлу = ПолучитьИмяВременногоФайла("csv");
	Запись = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();

	FTPСоединение.Записать(ПутьКФайлу, ИмяФайла);

	УдалитьФайлы(ПутьКФайлу);

КонецПроцедуры

Процедура ЗагрузкаЗаказовНашСайт() Экспорт
	
	FTPСервер = Константы.ФТПСервер.Получить();
	FTPПорт   = Константы.ФТППорт.Получить();
	FTPЛогин  = Константы.ФТПЛогин.Получить();
	FTPПароль = Константы.ФТППароль.Получить();
	
	FTPСоединение = Новый FTPСоединение(FTPСервер, , FTPЛогин, FTPПароль, , Истина, 20);
	
	Если FTPСоединение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеФайлы = FTPСоединение.НайтиФайлы("/cvetkovtm.com/www/assets/shop/sync/orders", "order-*.xml");
	
	Если НайденныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КаталогВременныхФайлов = КаталогВременныхФайлов();

	Для Каждого Файл Из НайденныеФайлы Цикл

		ПутьКФайлуНаСервере = Файл.ПолноеИмя;
		ПутьКФайлу          = КаталогВременныхФайлов + Файл.Имя;

		// Каждый файл обрабатывается независимо: раньше исключение на одном заказе
		// (битый XML, не найденный контрагент) прерывало цикл и оставляло файл на
		// FTP - следующий заход спотыкался о него же, и загрузка заказов вставала
		// целиком. Теперь такой файл откладывается в orders_error.
		Попытка

			FTPСоединение.Получить(ПутьКФайлуНаСервере, ПутьКФайлу);

			ОбменПокупателямиНашСайт = Обработки.ОбменПокупателямиНашСайт.Создать();

			ОбменПокупателямиНашСайт.ЗагрузитьЗаказ(ПутьКФайлу);

			FTPСоединение.Удалить(ПутьКФайлуНаСервере);

		Исключение

			ЗаписьЖурналаРегистрации(
				"ЗагрузкаЗаказовССайта",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"Заказ из файла " + Файл.Имя + " не загружен: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			ОтложитьНезагруженныйФайлЗаказа(FTPСоединение, ПутьКФайлуНаСервере, Файл.Имя, ПутьКФайлу);

		КонецПопытки;

		Попытка
			УдалитьФайлы(ПутьКФайлу);
		Исключение
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Убирает файл, который не удалось загрузить, из рабочего каталога обмена в
// orders_error - чтобы он не блокировал очередь и при этом не потерялся.
// Не получилось убрать - файл остаётся на месте, следующий заход попробует снова.
//
Процедура ОтложитьНезагруженныйФайлЗаказа(FTPСоединение, ПутьКФайлуНаСервере, ИмяФайла, ЛокальныйПуть)

	КаталогОшибок = "/cvetkovtm.com/www/assets/shop/sync/orders_error";

	Попытка

		Файл = Новый Файл(ЛокальныйПуть);

		Если Не Файл.Существует() Тогда
			// Файл даже не скачался - трогать его на FTP нельзя, повторим позже.
			Возврат;
		КонецЕсли;

		Попытка
			FTPСоединение.СоздатьКаталог(КаталогОшибок);
		Исключение
			// Каталог уже есть.
		КонецПопытки;

		FTPСоединение.Записать(ЛокальныйПуть, КаталогОшибок + "/" + ИмяФайла);
		FTPСоединение.Удалить(ПутьКФайлуНаСервере);

	Исключение

		ЗаписьЖурналаРегистрации(
			"ЗагрузкаЗаказовССайта",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не удалось отложить файл " + ИмяФайла + " в orders_error: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

	КонецПопытки;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ВЫГРУЗКА ЗАКАЗОВ НА САЙТ
//
// Заказ не выгружается напрямую из ЗаказПокупателя.ПриЗаписи: обработчик
// работает внутри незафиксированной транзакции записи, и фоновое задание в
// отдельном сеансе прочитало бы документ ещё со старым статусом (режим
// блокировок управляемый - читающий сеанс не ждёт пишущий). Поэтому запись
// заказа регистрируется в очереди РегистрСведений.ЗаказыКВыгрузкеНаСайт в той
// же транзакции: запись очереди становится видна только после её фиксации,
// а значит вместе с новым статусом заказа.
//
// Очередь разгребают:
//   ВыгрузитьЗаказИзОчередиНаСайт  - фоновое задание сразу после записи заказа;
//   ВыгрузитьОчередьЗаказовНаСайт  - регламентное задание, повторяет то, что не
//                                    ушло (недоступен FTP, транзакция ещё не
//                                    была зафиксирована, ошибка формирования).

// Регистрирует заказ в очереди выгрузки на сайт.
// Вызывается из ЗаказПокупателя.ПриЗаписи, т.е. внутри транзакции записи.
//
// Параметры:
//  ЗаказПокупателя  - ДокументСсылка.ЗаказПокупателя
//  ТолькоОбновление - Булево - ставить заказ в очередь как перевыгрузку истории
//                     (файл уйдёт с mode="update", см. СформироватьФайлЗаказаДляСайта).
//
Процедура ЗарегистрироватьЗаказКВыгрузкеНаСайт(ЗаказПокупателя, ТолькоОбновление = Ложь) Экспорт

	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	// Права проверяем ДО записи: процедура вызывается из ПриЗаписи заказа, то есть
	// внутри его транзакции, а отказ по правам транзакцию убивает - Попытка ниже
	// перехватит текст, но заказ после этого не запишется ("В данной транзакции уже
	// происходили ошибки!"). Привилегированный режим не спасает: в обычном приложении
	// клиент-серверной базы этот код идёт на стороне клиента, права проверяются.
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ЗаказыКВыгрузкеНаСайт) Тогда
		ЗаписьЖурналаРегистрации(
			"ВыгрузкаЗаказовНаСайт",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЗаказПокупателя,
			ЗаказПокупателя,
			"Нет прав на запись регистра ЗаказыКВыгрузкеНаСайт: заказ не поставлен"
			+ " в очередь выгрузки. Добавьте права на регистр в роль пользователя.");
		Возврат;
	КонецЕсли;

	// Сбой регистрации не должен ронять запись самого заказа.
	Попытка
		МенеджерЗаписи = РегистрыСведений.ЗаказыКВыгрузкеНаСайт.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЗаказПокупателя = ЗаказПокупателя;
		МенеджерЗаписи.Прочитать();

		// Заказ уже ждёт обычной выгрузки - перевыгрузка истории не должна
		// понижать её до mode="update": иначе заказ, которого на сайте ещё нет,
		// не будет создан вообще.
		РежимОбновления = ТолькоОбновление И Не (МенеджерЗаписи.Выбран() И Не МенеджерЗаписи.ТолькоОбновление);

		МенеджерЗаписи.ЗаказПокупателя  = ЗаказПокупателя;
		МенеджерЗаписи.ДатаРегистрации  = ТекущаяДата();
		МенеджерЗаписи.Попыток          = 0;
		МенеджерЗаписи.ПоследняяОшибка  = "";
		МенеджерЗаписи.ТолькоОбновление = РежимОбновления;
		МенеджерЗаписи.Записать(Истина);
	Исключение
		ЗаписьЖурналаРегистрации(
			"ВыгрузкаЗаказовНаСайт",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЗаказПокупателя,
			ЗаказПокупателя,
			"Не удалось поставить заказ в очередь выгрузки на сайт: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Снимает заказ с очереди выгрузки на сайт.
//
// Параметры:
//  ЗаказПокупателя - ДокументСсылка.ЗаказПокупателя
//  ДатаРегистрации - Дата - если заказ перерегистрировали, пока шла выгрузка,
//                    запись остаётся в очереди на следующий заход.
//
Процедура УдалитьЗаказИзОчередиВыгрузкиНаСайт(ЗаказПокупателя, ДатаРегистрации = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	МенеджерЗаписи = РегистрыСведений.ЗаказыКВыгрузкеНаСайт.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЗаказПокупателя = ЗаказПокупателя;
	МенеджерЗаписи.Прочитать();

	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	Если ДатаРегистрации <> Неопределено И МенеджерЗаписи.ДатаРегистрации <> ДатаРегистрации Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи.Удалить();

КонецПроцедуры

// Выгружает один заказ из очереди. Метод фонового задания, запускаемого из
// ЗаказПокупателя.ПриЗаписи.
//
// Параметры:
//  Параметр - Структура - с полем ЗаказПокупателя (ДокументСсылка.ЗаказПокупателя).
//
Процедура ВыгрузитьЗаказИзОчередиНаСайт(Параметр) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ЗаказПокупателя = ЗаказПокупателяИзПараметраВыгрузки(Параметр);

	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ЗаказыКВыгрузкеНаСайт.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЗаказПокупателя = ЗаказПокупателя;
	МенеджерЗаписи.Прочитать();

	// Записи очереди ещё не видно - транзакция записи заказа не зафиксирована,
	// в базе лежит старая версия документа. Выгрузит регламентное задание.
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	ДатаРегистрации = МенеджерЗаписи.ДатаРегистрации;

	Попытка
		ВыгрузитьЗаказНаСайт(ЗаказПокупателя, , Истина, МенеджерЗаписи.ТолькоОбновление);
		УдалитьЗаказИзОчередиВыгрузкиНаСайт(ЗаказПокупателя, ДатаРегистрации);
	Исключение
		// Заказ остаётся в очереди, повторит регламентное задание.
		ЗаписьЖурналаРегистрации(
			"ВыгрузкаЗаказовНаСайт",
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.ЗаказПокупателя,
			ЗаказПокупателя,
			"Заказ не выгружен, оставлен в очереди: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Разгребает очередь выгрузки заказов на сайт.
// Метод регламентного задания ВыгрузкаЗаказовНаСайт.
//
Процедура ВыгрузитьОчередьЗаказовНаСайт() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	МаксимумПопыток = 5;

	// За один заход выгружаем не больше 200 заказов, остальное - следующим.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	ЗаказыКВыгрузкеНаСайт.ЗаказПокупателя КАК ЗаказПокупателя,
	|	ЗаказыКВыгрузкеНаСайт.ЗаказПокупателя.Контрагент КАК Контрагент,
	|	ЗаказыКВыгрузкеНаСайт.ДатаРегистрации КАК ДатаРегистрации,
	|	ЗаказыКВыгрузкеНаСайт.Попыток КАК Попыток,
	|	ЗаказыКВыгрузкеНаСайт.ТолькоОбновление КАК ТолькоОбновление
	|ИЗ
	|	РегистрСведений.ЗаказыКВыгрузкеНаСайт КАК ЗаказыКВыгрузкеНаСайт
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаРегистрации";

	Очередь = Запрос.Выполнить().Выгрузить();

	Если Очередь.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Недоступный FTP - это не вина конкретного заказа, счётчик попыток не растёт.
	Попытка
		FTPСоединение = ПодключитьсяКFTPЗаказовСайта();
	Исключение
		ЗаписьЖурналаРегистрации(
			"ВыгрузкаЗаказовНаСайт",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось подключиться к FTP сайта, в очереди заказов: "
			+ Формат(Очередь.Количество(), "ЧГ=0") + ". "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Контрагенты = Новый Соответствие;

	Для Каждого СтрокаОчереди Из Очередь Цикл

		Попытка
			ВыгрузитьЗаказНаСайт(СтрокаОчереди.ЗаказПокупателя, FTPСоединение, Ложь, СтрокаОчереди.ТолькоОбновление);
			УдалитьЗаказИзОчередиВыгрузкиНаСайт(СтрокаОчереди.ЗаказПокупателя, СтрокаОчереди.ДатаРегистрации);
			Контрагенты.Вставить(СтрокаОчереди.Контрагент, Истина);
		Исключение
			ОтметитьОшибкуВыгрузкиЗаказаНаСайт(
				СтрокаОчереди.ЗаказПокупателя,
				СтрокаОчереди.Попыток + 1,
				МаксимумПопыток,
				ИнформацияОбОшибке());
		КонецПопытки;

	КонецЦикла;

	// Файлы резервов зависят от контрагента, а не от заказа: формируем их один
	// раз на контрагента, а не на каждый заказ пачки.
	Для Каждого КлючИЗначение Из Контрагенты Цикл

		Если Не ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Контрагент"        , КлючИЗначение.Ключ);
			СтруктураПараметров.Вставить("СуммаКорректировки", 0);
			СформироватьФайлыHTMLXMLРезервов(СтруктураПараметров);
		Исключение
			ЗаписьЖурналаРегистрации(
				"ВыгрузкаЗаказовНаСайт",
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Справочники.Контрагенты,
				КлючИЗначение.Ключ,
				"Не сформированы файлы резервов: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Процедура ОтметитьОшибкуВыгрузкиЗаказаНаСайт(ЗаказПокупателя, Попыток, МаксимумПопыток, ИнфОбОшибке)

	ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфОбОшибке);

	Если Попыток >= МаксимумПопыток Тогда

		УдалитьЗаказИзОчередиВыгрузкиНаСайт(ЗаказПокупателя);

		ЗаписьЖурналаРегистрации(
			"ВыгрузкаЗаказовНаСайт",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЗаказПокупателя,
			ЗаказПокупателя,
			"Заказ снят с очереди выгрузки после " + Формат(Попыток, "ЧГ=0") + " попыток: " + ТекстОшибки);

		Возврат;

	КонецЕсли;

	Попытка
		МенеджерЗаписи = РегистрыСведений.ЗаказыКВыгрузкеНаСайт.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЗаказПокупателя = ЗаказПокупателя;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Попыток         = Попыток;
			МенеджерЗаписи.ПоследняяОшибка = Лев(ТекстОшибки, 500);
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;
	Исключение
	КонецПопытки;

	ЗаписьЖурналаРегистрации(
		"ВыгрузкаЗаказовНаСайт",
		УровеньЖурналаРегистрации.Предупреждение,
		Метаданные.Документы.ЗаказПокупателя,
		ЗаказПокупателя,
		"Попытка " + Формат(Попыток, "ЧГ=0") + " выгрузки заказа не удалась: " + ТекстОшибки);

КонецПроцедуры

// Оставлено для совместимости с существующими вызовами (в том числе из фоновых
// заданий, поставленных в очередь до обновления).
//
Процедура ПередатьЗаказНаСайт(Параметр) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ЗаказПокупателя = ЗаказПокупателяИзПараметраВыгрузки(Параметр);

	Если Не ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		ЗаписьЖурналаРегистрации(
			"ВыгрузкаЗаказовНаСайт",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЗаказПокупателя,
			,
			"ПередатьЗаказНаСайт вызвана без ссылки на заказ, тип параметра: " + Строка(ТипЗнч(Параметр)));
		Возврат;
	КонецЕсли;

	ВыгрузитьЗаказНаСайт(ЗаказПокупателя);

КонецПроцедуры

// Выгружает XML заказа на FTP сайта.
//
// Параметры:
//  ЗаказПокупателя          - ДокументСсылка.ЗаказПокупателя
//  FTPСоединение            - FTPСоединение - открытое соединение для пакетной
//                             выгрузки; Неопределено - открыть своё.
//  ФормироватьФайлыРезервов - Булево - формировать HTML/XML резервов контрагента.
//  ТолькоОбновление         - Булево - см. СформироватьФайлЗаказаДляСайта.
//
Процедура ВыгрузитьЗаказНаСайт(ЗаказПокупателя, FTPСоединение = Неопределено, ФормироватьФайлыРезервов = Истина,
	ТолькоОбновление = Ложь) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ЗаказПокупателяЭтоПодЗаказ(ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;

	ПутьКФайлу = СформироватьФайлЗаказаДляСайта(ЗаказПокупателя, ТолькоОбновление);

	Попытка

		Соединение = ?(FTPСоединение = Неопределено, ПодключитьсяКFTPЗаказовСайта(), FTPСоединение);
		Соединение.Записать(ПутьКФайлу, ИмяФайлаЗаказаДляСайта(ЗаказПокупателя));

	Исключение
		УдалитьФайлы(ПутьКФайлу);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(ПутьКФайлу);

	Если ФормироватьФайлыРезервов Тогда

		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Контрагент"        , ЗаказПокупателя.Контрагент);
		СтруктураПараметров.Вставить("СуммаКорректировки", 0);

		СформироватьФайлыHTMLXMLРезервов(СтруктураПараметров);

	КонецЕсли;

КонецПроцедуры

// Открывает соединение с FTP сайта и переходит в каталог заказов.
//
Функция ПодключитьсяКFTPЗаказовСайта() Экспорт

	FTPСервер = Константы.ФТПСервер.Получить();
	FTPЛогин  = Константы.ФТПЛогин.Получить();
	FTPПароль = Константы.ФТППароль.Получить();

	FTPСоединение = Новый FTPСоединение(FTPСервер, , FTPЛогин, FTPПароль, , Истина, 20);

	FTPСоединение.УстановитьТекущийКаталог("/cvetkovtm.com/www/assets/shop/sync/orders_1c");

	Возврат FTPСоединение;

КонецФункции

// Имя файла заказа в каталоге обмена сайта.
//
Функция ИмяФайлаЗаказаДляСайта(ЗаказПокупателя) Экспорт

	НомерСайта = СокрЛП(ЗаказПокупателя.НомерЗаказа2ССайта);

	Если ПустаяСтрока(НомерСайта) Тогда
		НомерСайта = Строка(ЗаказПокупателя.Ссылка.УникальныйИдентификатор());
	КонецЕсли;

	Возврат "order-" + РаботаСФайлами.УдалитьЗапрещенныеСимволыИмени(НомерСайта) + ".xml";

КонецФункции

Функция ЗаказПокупателяИзПараметраВыгрузки(Параметр)

	Если ТипЗнч(Параметр) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		Возврат Параметр;
	КонецЕсли;

	Если ТипЗнч(Параметр) = Тип("ДокументОбъект.ЗаказПокупателя") Тогда
		Возврат Параметр.Ссылка;
	КонецЕсли;

	Если ТипЗнч(Параметр) = Тип("Структура") Тогда

		Значение = Неопределено;

		Если Параметр.Свойство("ЗаказПокупателя", Значение) Тогда
			Возврат ЗаказПокупателяИзПараметраВыгрузки(Значение);
		КонецЕсли;

		// Старый формат параметров: плоская структура реквизитов заказа.
		Если Параметр.Свойство("УникальныйИдентификатор", Значение) Тогда
			Попытка
				Возврат Документы.ЗаказПокупателя.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка(Значение)));
			Исключение
				Возврат Неопределено;
			КонецПопытки;
		КонецЕсли;

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ЗаказПокупателяЭтоПодЗаказ(ЗаказПокупателя)

	Попытка

		Если Не ЗначениеЗаполнено(ЗаказПокупателя.ОсновнойЗаказ) Тогда
			Возврат Ложь;
		КонецЕсли;

		Если ТипЗнч(ЗаказПокупателя.ОсновнойЗаказ) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Возврат Ложь;
		КонецЕсли;

		Возврат СтрНайти(ЗаказПокупателя.Номер, "/") > 0;

	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Возвращает ключ карточки клиента на сайте (реквизит Контрагент.IDСайта) строкой
// для тегов site_id / user_site_id в выгрузке на сайт.
//
// Единственный законный источник значения - колонка SiteId файла web_users.csv,
// её пишет в карточку ЗагрузкаПокупателейНашСайт. Если ключа нет или он заведомо
// испорчен, возвращается ПУСТАЯ строка: пустое значение сайт обрабатывает
// корректно (клиент определяется по коду контрагента), а чужое число привязывает
// заказ к постороннему человеку - в личном кабинете чужого клиента видны состав,
// сумма, ФИО и телефон получателя.
//
// Признак испорченного значения - один и тот же IDСайта в нескольких карточках.
// Ключ сайта уникален, поэтому дубль означает, что число попало в карточку не из
// web_users.csv (раньше в IDСайта писалось непроверенное значение из XML заказа -
// плейсхолдер "{site_id}", счётчик сайта или ключ другого клиента).
//
// Разделитель групп подавляем явно: Строка(2336) даёт "2 336", и сайт такое
// значение не разбирает.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты
//
// Возвращаемое значение:
//  Строка - только цифры, без разделителей; пустая строка, если ключа нет.
//
Функция IDСайтаКонтрагентаСтрокой(Контрагент) Экспорт

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		IDСайта = Контрагент.IDСайта;
	Исключение
		Возврат "";
	КонецПопытки;

	Если Не ЗначениеЗаполнено(IDСайта) Тогда
		Возврат "";
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.IDСайта = &IDСайта";

	Запрос.УстановитьПараметр("IDСайта", IDСайта);

	Владельцы = Запрос.Выполнить().Выгрузить();

	УстановитьПривилегированныйРежим(Ложь);

	Если Владельцы.Количество() > 1 Тогда

		ЗаписьЖурналаРегистрации(
			"ВыгрузкаЗаказовНаСайт",
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Справочники.Контрагенты,
			Контрагент,
			"ID сайта " + Формат(IDСайта, "ЧГ=0") + " указан более чем в одной карточке "
			+ "контрагента - значение считаем ошибочным и на сайт не выгружаем "
			+ "(иначе заказ уйдёт постороннему клиенту). Требуется сверка с web_users.csv.");

		Возврат "";

	КонецЕсли;

	Возврат Формат(IDСайта, "ЧГ=0");

КонецФункции

// Формирует временный XML-файл заказа для сайта и возвращает путь к нему.
//
// Параметры:
//  ЗаказПокупателя - ДокументСсылка.ЗаказПокупателя
//  ТолькоОбновление - Булево - писать в корневой элемент атрибут mode="update".
//                     С ним сайт обновляет уже существующий заказ, но не создаёт
//                     новый: заказ, которого на сайте никогда не было (заведён в
//                     1С до интеграции или вручную), просто пропускается, и
//                     клиенту не уходит письмо о давно закрытом заказе.
//                     Нужен при массовой перевыгрузке истории.
//
Функция СформироватьФайлЗаказаДляСайта(ЗаказПокупателя, ТолькоОбновление = Ложь) Экспорт

	ПутьКФайлу = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	
	ЗаписьXML.ОткрытьФайл(ПутьКФайлу);
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("orders");
	
	Дата = Формат(ЗаказПокупателя.Дата, "ДФ='yyyy-MM-dd HH:mm'");
	
	ЗаписьXML.ЗаписатьАтрибут("date", Дата);

	Если ТолькоОбновление Тогда
		ЗаписьXML.ЗаписатьАтрибут("mode", "update");
	КонецЕсли;

	ЗаписьXML.ЗаписатьНачалоЭлемента("order");
	
	ЗаписьXML.ЗаписатьАтрибут("id"   , ЗаказПокупателя.НомерЗаказа2ССайта);  //
	ЗаписьXML.ЗаписатьАтрибут("state", "accepted");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("order_code");
	ЗаписьXML.ЗаписатьТекст(ОбщегоНазначения.УбратьНоликиСлева(ЗаказПокупателя.Номер));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("user_id");
	ЗаписьXML.ЗаписатьТекст(ЗаказПокупателя.Контрагент.Код);
	ЗаписьXML.ЗаписатьКонецЭлемента(); 
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("site_id");
	ЗаписьXML.ЗаписатьТекст(IDСайтаКонтрагентаСтрокой(ЗаказПокупателя.Контрагент));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("name");
	ЗаписьXML.ЗаписатьТекст(ЗаказПокупателя.Контрагент.Наименование);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("mail");
	Попытка 
		ЗаписьXML.ЗаписатьТекст(ЗаказПокупателя.АдресЭлектроннойПочтыКонтрагента);
	Исключение
	КонецПопытки;
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	// Не Родитель.Код: сайт знает только пять кодов групп верхнего уровня, а контрагенты лежат
	// во вложенных папках ("Вип" внутри "Наш клиент" внутри "ОптовикиГрупа") - код такой папки
	// сайту ничего не говорит, и тип клиента в письме откатывался на тип аккаунта сайта
	// (оптовый заказ 27810 подписался "Розничный клиент", 18.08.2026)
	ЗаписьXML.ЗаписатьНачалоЭлемента("user_type");
	ЗаписьXML.ЗаписатьТекст(КатегоризацияКлиентов.КодГруппыКлиентаДляСайта(ЗаказПокупателя.Контрагент));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("date");
	ЗаписьXML.ЗаписатьТекст(Дата);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("status");
	ЗаписьXML.ЗаписатьТекст(ЗаказПокупателя.СтатусЗаказа.Код);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("referrerSession");
	ЗаписьXML.ЗаписатьТекст(ЗаказПокупателя.referrerSession);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("referrer");
	ЗаписьXML.ЗаписатьТекст(ЗаказПокупателя.referrer);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Розы =  Справочники.Склады.НайтиПоКоду("000000014");
	СкладНеПокроен = Справочники.Склады.НайтиПоКоду("000000023");
	СкладНеПошит = Справочники.Склады.НайтиПоКоду("000000026");
	
	ТабРезерва = Документы.ЗаказПокупателя.РезервПоЗаказуОстаток(ЗаказПокупателя.Ссылка);
	Комплектуется = Ложь;
	Изготавливается = Ложь;
	
	Для Каждого Стр Из ТабРезерва Цикл
		Если Стр.Склад <> Розы  Тогда
			Комплектуется = Истина;
		КонецЕсли;	
		Если Стр.Склад = СкладНеПошит ИЛИ Стр.Склад = СкладНеПокроен ТОгда
			Изготавливается = истина;
		КонецЕсли;
	КонецЦикла;	
	
	ОстаткиРезервов = Документы.ЗаказПокупателя.РезервПоЗаказуОстаток(ЗаказПокупателя.Ссылка);
	Собрана = Документы.РеализацияТоваровУслуг.РеализацияСобрана(ЗаказПокупателя);
	
	СтатусРезерва = ?(ОстаткиРезервов.Количество() = 0,?(Собрана,"Упакован","В очереди на упаковку"),?(Комплектуется,"Комплектуется",?(Изготавливается,"Изготавливается","готов к отправке")));
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("pack_status");
	ЗаписьXML.ЗаписатьТекст(СтатусРезерва);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("status_delivery");
	ЗаписьXML.ЗаписатьТекст(ЗаказПокупателя.СтатусОтправки);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("paymentType");		  
	Если ЗаказПокупателя.ВидОплатыЗаказа = Перечисления.ВидОплатыЗаказ.Безналичный Тогда
		
		ЗаписьXML.ЗаписатьТекст("1");
		
	ИначеЕсли ЗаказПокупателя.ВидОплатыЗаказа = Перечисления.ВидОплатыЗаказ.НаложеныйПлатеж Тогда		  
		
		ЗаписьXML.ЗаписатьТекст("2");
	ИначеЕсли   ЗаказПокупателя.ВидОплатыЗаказа = Перечисления.ВидОплатыЗаказ.Оплачен Тогда
		ЗаписьXML.ЗаписатьТекст("3");
		
	ИначеЕсли   ЗаказПокупателя.ВидОплатыЗаказа = Перечисления.ВидОплатыЗаказ.Предоплата Тогда
		ЗаписьXML.ЗаписатьТекст("4");
		
	КонецЕсли;
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("deliveryType");
	ЗаписьXML.ЗаписатьТекст(ЗаказПокупателя.СпособОтправки.Код);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Если ЗаказПокупателя.СпособОтправки = Справочники.СпособыОтправки.НоваяПочта Тогда
		
		deliveryMethod = ЗаказПокупателя.ТехнологияДоставки.Код;
		
		Если ЗаказПокупателя.СтатусЗаказа.Код = "000000003" И
			ЗаказПокупателя.СтатусОтправки  = "Відправлення отримано. Протягом доби відправник отримає SMS-повідомлення про надходження грошового п" Тогда
			
			deliveryMethod = "000000004";
			
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("deliveryMethod");
		ЗаписьXML.ЗаписатьТекст(deliveryMethod);
		ЗаписьXML.ЗаписатьКонецЭлемента();
		
		Если ЗаказПокупателя.ТехнологияДоставки.Код = "000000003" Тогда
			
			//ЗаписьXML.ЗаписатьНачалоЭлемента("city");
			//ЗаписьXML.ЗаписатьТекст(ЗаказПокупателя.ГородНовойПочтыЗначениеГУИД);
			//ЗаписьXML.ЗаписатьКонецЭлемента();
