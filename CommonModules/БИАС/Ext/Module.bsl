Процедура ЗапуститьCronЗадачу()
	
	// URL вашей cron-задачи
	URL = "https://cvetkovtm.com/assets/shop/cron_order.php";
	Сервер = "cvetkovtm.com";
	Путь = "/assets/shop/cron_order.php";
	
	// Создание HTTP-соединения
	HTTPСоединение = Новый HTTPСоединение(Сервер,,,,,,,Ложь);
	
	// Создание HTTP-запроса
	HTTPЗапрос = Новый HTTPЗапрос;
	HTTPЗапрос.АдресРесурса(URL);
	
	Попытка
		// Выполнение HTTP-запроса
		HTTPОтвет = HTTPСоединение.Отправить(HTTPЗапрос);
		
		// Запись в журнал регистрации
		ЗаписьЖурналаРегистрации("Запрос отправлен. Код состояния: " + Строка(HTTPОтвет.КодСостояния));
		
		// Проверка статуса ответа
		Если HTTPОтвет.КодСостояния = 200 Тогда
			Сообщить("Cron задача успешно запущена");
			ЗаписьЖурналаРегистрации("Cron задача успешно запущена");
		Иначе
			Сообщить("Ошибка при запуске cron задачи: " + HTTPОтвет.КодСостояния);
			ЗаписьЖурналаРегистрации("Ошибка при запуске cron задачи: " + HTTPОтвет.КодСостояния);
		КонецЕсли;
		
	Исключение
		Ошибка = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Ошибка при выполнении HTTP-запроса: " + Ошибка);
		Сообщить("Ошибка при выполнении HTTP-запроса: " + Ошибка);
	КонецПопытки;
	
