Функция НайтиКассовыйОрдерПоБанковскойОперации(
	ИдентификаторОперации,
	ДатаОперации) Экспорт
	
	Если ПустаяСтрока(
		СокрЛП(Строка(ИдентификаторОперации))) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НачалоПериода =
		НачалоДня(
			ДатаОперации - 2 * 24 * 60 * 60);
	
	КонецПериода =
		КонецДня(
			ДатаОперации + 2 * 24 * 60 * 60);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПриходныйКассовыйОрдер.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер
	|		КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	НЕ ПриходныйКассовыйОрдер.ПометкаУдаления
	|	И ПриходныйКассовыйОрдер.НомерВходящегоДокумента
	|		= &ИдентификаторОперации
	|	И ПриходныйКассовыйОрдер.Дата
	|		МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриходныйКассовыйОрдер.Дата УБЫВ";
	
	Запрос.УстановитьПараметр(
		"ИдентификаторОперации",
		СокрЛП(Строка(ИдентификаторОперации)));
	
	Запрос.УстановитьПараметр(
		"НачалоПериода",
		НачалоПериода);
	
	Запрос.УстановитьПараметр(
		"КонецПериода",
		КонецПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
