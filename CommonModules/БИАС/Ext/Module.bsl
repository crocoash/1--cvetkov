// СЛУЖЕБНЫЕ ФУНКЦИИ HTML-РЕЗЕРВОВ

// Читает текстовый макет "РезервHTML" и режет его на блоки
// по маркерам-комментариям "БЛОК:Имя".
Функция БлокиМакетаРезервHTML() Экспорт
	
	Блоки = Новый Соответствие;
	
	Попытка
		Макет = Документы.ЗаказПокупателя.ПолучитьМакет("РезервHTML");
	Исключение
		Сообщить("Ошибка получения макета РезервHTML: " + ОписаниеОшибки());
		Возврат Блоки;
	КонецПопытки;
	
	Если Макет = Неопределено Тогда
		Сообщить("Макет РезервHTML не найден.");
		Возврат Блоки;
	КонецЕсли;
	
	Текст = Макет.ПолучитьТекст();
	
	Если ПустаяСтрока(Текст) Тогда
		Сообщить("Макет РезервHTML пустой.");
		Возврат Блоки;
	КонецЕсли;
	
	МаркерНачала = "<!--БЛОК:";
	МаркерКонца  = "-->";
	
	ПозицияМаркера = Найти(Текст, МаркерНачала);
	
	Если ПозицияМаркера = 0 Тогда
		
		Сообщить("Маркер " + МаркерНачала + " не найден.");
		Сообщить("Позиция слова БЛОК: " + Строка(Найти(Текст, "БЛОК:")));
		Сообщить("Позиция слова Шапка: " + Строка(Найти(Текст, "Шапка")));
		Сообщить("Первые 500 символов:");
		Сообщить(Лев(Текст, 500));
		
		Возврат Блоки;
		
	КонецЕсли;
	
	// Отбрасываем вводный комментарий до первого настоящего блока.
	ОстатокТекста = Сред(Текст, ПозицияМаркера);
	
	Пока Не ПустаяСтрока(ОстатокТекста) Цикл
		
		ПозицияНачала = Найти(ОстатокТекста, МаркерНачала);
		
		Если ПозицияНачала = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если ПозицияНачала > 1 Тогда
			ОстатокТекста = Сред(ОстатокТекста, ПозицияНачала);
		КонецЕсли;
		
		ПозицияКонцаЗаголовка = Найти(ОстатокТекста, МаркерКонца);
		
		Если ПозицияКонцаЗаголовка = 0 Тогда
			
			Сообщить(
			"Не найдено окончание --> у блока. Начало текста: "
			+ Лев(ОстатокТекста, 100)
			);
			
			Прервать;
			
		КонецЕсли;
		
		НачалоИмени = СтрДлина(МаркерНачала) + 1;
		
		ИмяБлока = Сред(
		ОстатокТекста,
		НачалоИмени,
		ПозицияКонцаЗаголовка - НачалоИмени
		);
		
		ИмяБлока = СокрЛП(ИмяБлока);
		
		НачалоСодержимого = ПозицияКонцаЗаголовка
		+ СтрДлина(МаркерКонца);
		
		ТекстПослеЗаголовка = Сред(
		ОстатокТекста,
		НачалоСодержимого
		);
		
		ПозицияСледующегоБлока = Найти(
		ТекстПослеЗаголовка,
		МаркерНачала
		);
		
		Если ПозицияСледующегоБлока = 0 Тогда
			
			СодержимоеБлока = ТекстПослеЗаголовка;
			ОстатокТекста = "";
			
		Иначе
			
			СодержимоеБлока = Лев(
			ТекстПослеЗаголовка,
			ПозицияСледующегоБлока - 1
			);
			
			ОстатокТекста = Сред(
			ТекстПослеЗаголовка,
			ПозицияСледующегоБлока
			);
			
		КонецЕсли;
		
		// Убираем только первые переводы строк после комментария блока.
		Пока Не ПустаяСтрока(СодержимоеБлока) Цикл
			
			ПервыйСимвол = Лев(СодержимоеБлока, 1);
			
			Если ПервыйСимвол = Символы.ПС
				Или ПервыйСимвол = Символы.ВК Тогда
				
				СодержимоеБлока = Сред(СодержимоеБлока, 2);
				
			Иначе
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ПустаяСтрока(ИмяБлока) Тогда
			
			Сообщить("Найден блок без имени.");
			
		Иначе
			
			Блоки.Вставить(
			ИмяБлока,
			СодержимоеБлока
			);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить(
	"Найдено блоков HTML: "
	+ Строка(Блоки.Количество())
	);
	
	Для Каждого ЭлементБлока Из Блоки Цикл
		
		Сообщить(
		"Блок [" + ЭлементБлока.Ключ
		+ "], длина: "
		+ Строка(СтрДлина(ЭлементБлока.Значение))
		);
		
	КонецЦикла;
	
	Возврат Блоки;
	
КонецФункции
// Подставляет параметры вида {{Имя}} в текст блока.
Функция ЗаполнитьHTMLБлок(Шаблон, Параметры)
	
	Результат = Шаблон;
	
	Для Каждого Параметр Из Параметры Цикл
		
		Результат = СтрЗаменить(
		Результат,
		"{{" + Параметр.Ключ + "}}",
		Параметр.Значение
		);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЭкранироватьHTML(Значение)
	
	Результат = Строка(Значение);
	Результат = СтрЗаменить(Результат, "&", "&amp;");
	Результат = СтрЗаменить(Результат, "<", "&lt;");
	Результат = СтрЗаменить(Результат, ">", "&gt;");
	Результат = СтрЗаменить(Результат, """", "&quot;");
	
	Возврат Результат;
	
КонецФункции

// Целые гривны с пробелом-разделителем групп: 13715 -> "13 715".
Функция ФорматГрн(Число)
	
	Возврат Формат(
	Цел(Число),
	"ЧДЦ=0; ЧРГ=' '; ЧН=0"
	);
	
КонецФункции

Функция НомерБезВедущихНулей(Номер)
	
	Результат = СокрЛП(Номер);
	
	Пока СтрДлина(Результат) > 1
		И Лев(Результат, 1) = "0" Цикл
		
		Результат = Сред(Результат, 2);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// URL фото товара на хостинге. Пока заглушка — вернуть "",
// тогда в таблице выводится плейсхолдер-миниатюра.
// TODO: подставить ссылку, например:
// Возврат "https://cvetkovtm.com/photo/"
//     + СокрЛП(СтрокаЗаказа.Номенклатура.Артикул) + ".jpg";
Функция СсылкаНаФотоРезерва(СтрокаЗаказа)
	
