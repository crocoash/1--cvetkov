Процедура ОбработатьЗаказ(СтрокаТЗНомера, ТЗЗаказы, ЭтоКаста)
	
	Номер = СтрЗаменить(СтрокаТЗНомера.Номер, Символы.НПП, "");
	
	ЗаказПокупателя = Документы.ЗаказПокупателя.НайтиПоРеквизиту("НомерЗаказа2ССайта", Номер);
	
	Если ЗначениеЗаполнено(ЗаказПокупателя) Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеСтроки = ТЗЗаказы.НайтиСтроки(Новый Структура("Номер", СтрокаТЗНомера.Номер));
	
	Если НайденныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТЗ = НайденныеСтроки[0];
	
	Дата = СтрокаТЗ.Дата;
	
	Дата = СтрЗаменить(Дата, "-", "");
	Дата = СтрЗаменить(Дата, " ", "");
	Дата = СтрЗаменить(Дата, ":", "");
	
	Попытка
		Дата = Дата(Дата);
	Исключение
		Дата = ТекущаяДата();
	КонецПопытки;
	
	ВидОплаты = Перечисления.ВидОплатыЗаказ.НаложеныйПлатеж;	
	
	НовыйЗаказ = Документы.ЗаказПокупателя.СоздатьДокумент();
	
	НовыйЗаказ.Дата                      = Дата;
	НовыйЗаказ.ВидОперации               = Перечисления.ВидыОперацийЗаказПокупателя.ПродажаКомиссия;
	НовыйЗаказ.Организация               = Справочники.Организации.НайтиПоКоду("000000001");
	НовыйЗаказ.СтруктурнаяЕдиница        = НовыйЗаказ.Организация.ОсновнойБанковскийСчет;
	
	ТелефонКонтрагента = ОбщегоНазначения.ПреобразоватьТелефон(СтрокаТЗ.телефон);
	
	Если ЭтоКаста Тогда 
		Контрагент = Справочники.Контрагенты.НайтиПоКоду("000004317");
		ТипЦен =  Константы.ТипЦенКаста.Получить();
	Иначе 
		Контрагент = Справочники.Контрагенты.НайтиПоКоду("000004143");
		ТипЦен =  Константы.ТипЦенРозетка.Получить();
	КонецЕсли;
	
	НовыйЗаказ.Контрагент                = Контрагент;
	НовыйЗаказ.КонтактноеЛицоКонтрагента = НовыйЗаказ.Контрагент.ОсновноеКонтактноеЛицо;
	НовыйЗаказ.ДоговорКонтрагента        = ЗаполнениеДокументов.ПолучитьДоговорПоОрганизацииИКонтрагенту(НовыйЗаказ.Организация, НовыйЗаказ.Контрагент, ЗаполнениеДокументов.ПолучитьСтруктуруПараметровДляПолученияДоговораПродажи());	
	НовыйЗаказ.ПриИзмененииДоговора();	
	НовыйЗаказ.ИсточникЗначение =  Справочники.ИсточникиИнформацииПриОбращенииПокупателей.НайтиПоКоду("000000017");	
	НовыйЗаказ.ТипЦен                     = ТипЦен;
	НовыйЗаказ.Регион                     = НовыйЗаказ.Контрагент.Регион;
	НовыйЗаказ.СкладГруппа                = ?(ЗначениеЗаполнено(НовыйЗаказ.Контрагент.СкладКонтрагента), НовыйЗаказ.Контрагент.СкладКонтрагента, НовыйЗаказ.Контрагент.Родитель.Склад);
	НовыйЗаказ.СхемаРезервирования        = НовыйЗаказ.Контрагент.Родитель.СхемаРезервирования;
	НовыйЗаказ.ИзРеализации               = Ложь;
	НовыйЗаказ.НомерЗаказа2ССайта         = Номер;
	НовыйЗаказ.СсылкаНаЗаказ              = Номер;
	НовыйЗаказ.АльфаИмя                   = ОбщийМодульПодписокНаСобытия.АльфаИмяПоУмолчанию();
	НовыйЗаказ.ТелефонКонтрагента1        = ТелефонКонтрагента;
	НовыйЗаказ.ВидОплатыЗаказа            = ВидОплаты;
	НовыйЗаказ.СтатусЗаказа               = Справочники.СтатусыЗаказов.НайтиПоКоду("000000011");
	НовыйЗаказ.ТипОбратнойДоставки        = Справочники.ЛМ_ВидыОбратнойДоставки.НайтиПоКоду("000000012");
	
	НоваПейКасса = Справочники.БанковскиеСчета.НайтиПоКоду("000000039");
	Расчетный = Справочники.БанковскиеСчета.НайтиПоКоду("000000026");
	НовыйЗаказ.БанковскийСчетКонтрольОплаты = ?(СтрокаТЗ.СпособДоставка.Код = "000000006",Расчетный,СтрокаТЗ.Счет);
	
	НовыйЗаказ.СпособОтправки             = СтрокаТЗ.СпособДоставка;
	НовыйЗаказ.ВидГруза                   = Справочники.ЛМ_ВидыГрузов.НайтиПоРеквизиту("ГУИД", "Cargo");
	НовыйЗаказ.ВидРасчетов                = Справочники.ЛМ_ФормыОплаты.НайтиПоРеквизиту("ГУИД", "Cash");
	НовыйЗаказ.Плательщик                 = Справочники.ЛМ_ВидыПлательщиков.НайтиПоРеквизиту("ГУИД", "Recipient");
	НовыйЗаказ.ПлательщикОбратнойДоставки = Справочники.ЛМ_ВидыПлательщиковОбратнойДоставки.НайтиПоРеквизиту("ГУИД", "Recipient");
	НовыйЗаказ.Мест                       = 1;
	НовыйЗаказ.АдресДоставки              = СтрокаТЗ.АдресДоставки;
	НовыйЗаказ.Получатель                 = СтрокаТЗ.Получатель;
	НовыйЗаказ.ТелефонКонтрагента         = ТелефонКонтрагента;
	НовыйЗаказ.Ответственный              = НовыйЗаказ.Контрагент.Родитель.ОтветственныйГруппы;
	НовыйЗаказ.Комментарий                = СтрокаТЗ.Комментарий;
	
	НовыйЗаказ.СкладНовойПочтыПредставление = СтрокаТЗ.Отделение;	
	НовыйЗаказ.ГородНовойПочтыПредставление = СтрокаТЗ.ГородДоставка;
	
	Для Каждого СтрокаТЗ Из НайденныеСтроки Цикл
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
		
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Штрихкоды.Владелец КАК Номенклатура,
		|	Штрихкоды.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
		|	Штрихкоды.СерияНоменклатуры КАК СерияНоменклатуры,
		|	Штрихкоды.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	Штрихкоды.ЕдиницаИзмерения.Коэффициент КАК Коэффициент,
		|	Штрихкоды.Владелец.СтавкаНДС КАК СтавкаНДС
		|ИЗ
		|	РегистрСведений.Штрихкоды КАК Штрихкоды
		|ГДЕ
		|	Штрихкоды.Штрихкод = &ШтрихКод";
		
		
		Запрос.УстановитьПараметр("ШтрихКод", СтрЗаменить(СтрокаТЗ.ШтрихКод, Символы.НПП, ""));
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			НоваяСтрока = НовыйЗаказ.Товары.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			Попытка
				Количество = Число(СтрокаТЗ.Количество);
			Исключение
				Количество = 0;
			КонецПопытки;
			
			НоваяСтрока.Сортировка = НоваяСтрока.Номенклатура.Наименование + " " + НоваяСтрока.ХарактеристикаНоменклатуры.Наименование;
			НоваяСтрока.Количество = Количество;
			
			Если НоваяСтрока.Номенклатура.ВидНоменклатуры.Код = "000000010" Тогда
				
				КоличествоКомплектующих = БИАС.ПолучитьКоличествоКомплектующихНК(НоваяСтрока.ХарактеристикаНоменклатуры);
				
				НоваяСтрока.КоличествоНК = КоличествоКомплектующих * НоваяСтрока.Количество;
				
				ЦенаНК = 0;
				
				КомплектующиеНК = Новый ТаблицаЗначений;
				
				КомплектующиеНК.Колонки.Добавить("Комплектующая");
				КомплектующиеНК.Колонки.Добавить("ХарактеристикаКомплектующей");
				
				БИАС.ПолучитьКомплектующиеНК(НоваяСтрока.ХарактеристикаНоменклатуры, КомплектующиеНК);
				
				Для Каждого СтрокаКомплектующая Из КомплектующиеНК Цикл
					
					ЦенаНК = ЦенаНК + Ценообразование.ПолучитьЦенуНоменклатуры(СтрокаКомплектующая.Комплектующая, СтрокаКомплектующая.ХарактеристикаКомплектующей, НовыйЗаказ.ТипЦен, НовыйЗаказ.Дата);
					
				КонецЦикла;
				
				НоваяСтрока.Цена = ?(КоличествоКомплектующих = 0, 0, ЦенаНК / КоличествоКомплектующих);
				
			Иначе
				
				НоваяСтрока.КоличествоНК = НоваяСтрока.Количество;
				
				НоваяСтрока.Цена = Ценообразование.ПолучитьЦенуНоменклатуры(
				НоваяСтрока.Номенклатура,
				НоваяСтрока.ХарактеристикаНоменклатуры,
				НовыйЗаказ.ТипЦен,
				НовыйЗаказ.Дата,
				НоваяСтрока.ЕдиницаИзмерения,
				НовыйЗаказ.ВалютаДокумента,
				НовыйЗаказ.КурсВзаиморасчетов,
				НовыйЗаказ.КратностьВзаиморасчетов,
				,
				НовыйЗаказ.ДоговорКонтрагента,
				НовыйЗаказ.УсловиеПродаж);
				
				
				
				
			КонецЕсли;
			
			
			
			ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(НоваяСтрока, НовыйЗаказ);
			ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(НоваяСтрока, НовыйЗаказ);
			
			НовыйЗаказ.ПересчитатьАвтоматическиеСкидки();
			
			НоваяСумма = Число(СтрЗаменить(СтрокаТЗ.Сумма, " ", ""));
			ПроцентАвтоматическихСкидок = НоваяСтрока.ПроцентАвтоматическихСкидок;
			Цена = НоваяСтрока.Цена; 
			СуммаПослеАвтоматическихСкидок = НоваяСтрока.Сумма;
			ИтоговаяСумма =  НоваяСтрока.Сумма;
			
			Если НоваяСумма <> ИтоговаяСумма Тогда
				
				ОбщаяСкидка = 100 - (НоваяСумма * 100 / Цена);
				
				// Рассчитываем ручную скидку
				НоваяСтрока.ПроцентСкидкиНаценки = ОбщаяСкидка - ПроцентАвтоматическихСкидок;
				НоваяСтрока.Сумма = НоваяСумма; 
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	НовыйЗаказ.Записать();
	НовыйЗаказ.СуммаНоваяПочта = НовыйЗаказ.СуммаДокумента;
	Попытка
		НовыйЗаказ.ПолучитьОбъект().ЗакрепитьРезервПоЗаказу();
	Исключение
	КонецПопытки;
	//НовыйЗаказ.ПолучитФорму().ЗакрепитьРезервПриИзменении(Неопределено);
	
	Попытка
		НовыйЗаказ.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		НовыйЗаказ.Записать();
	КонецПопытки;
	
КонецПроцедуры

