
Процедура ПолучитьКомплектующиеНК(Характеристика, ТаблицаКомплектующих) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КомплектующиеНоменклатуры.Комплектующая КАК Комплектующая,
	|	КомплектующиеНоменклатуры.ХарактеристикаКомплектующей КАК ХарактеристикаКомплектующей,
	|	КомплектующиеНоменклатуры.Комплектующая.ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Комплект) КАК ЭтоКомплект,
	|	КомплектующиеНоменклатуры.Количество КАК Количество
	|ИЗ
	|	РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
	|ГДЕ
	|	КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры";
	
	
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", Характеристика);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ЭтоКомплект Тогда
			
			ПолучитьКомплектующиеНК(Выборка.ХарактеристикаКомплектующей, ТаблицаКомплектующих);
			
		Иначе
			
			НоваяСтрока = ТаблицаКомплектующих.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьКомплектующиеНаборКомплекта(СтруктураДанных, ТаблицаКомплектующих) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КомплектующиеНоменклатуры.Комплектующая КАК Номенклатура,
	|	КомплектующиеНоменклатуры.ХарактеристикаКомплектующей КАК ХарактеристикаНоменклатуры,
	|	КомплектующиеНоменклатуры.Комплектующая.ВидНоменклатуры.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Комплект) КАК ЭтоКомплект,
	|	КомплектующиеНоменклатуры.Количество КАК Количество,
	|	КомплектующиеНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения
	|ИЗ
	|	РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
	|ГДЕ
	|	КомплектующиеНоменклатуры.Номенклатура = &Номенклатура
	|	И КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры";
	
	
	Запрос.УстановитьПараметр("Номенклатура"              , СтруктураДанных.Номенклатура);
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", СтруктураДанных.ХарактеристикаНоменклатуры);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ЭтоКомплект Тогда
			
			ПолучитьКомплектующиеНаборКомплекта(Выборка, ТаблицаКомплектующих);
			
		Иначе
			
			НоваяСтрока = ТаблицаКомплектующих.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьКоличествоКомплектующихНК(Характеристика) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СУММА(КомплектующиеНоменклатуры.Количество), 0) КАК Количество
	|ИЗ
	|	РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
	|ГДЕ
	|	КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры";
	
	
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", Характеристика);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьКомплектующиеРучногоНаборКомплекта(Характеристика) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КомплектующиеНоменклатуры.Комплектующая КАК Номенклатура,
	|	КомплектующиеНоменклатуры.ХарактеристикаКомплектующей КАК Характеристика,
	|	КомплектующиеНоменклатуры.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	СУММА(КомплектующиеНоменклатуры.Количество) КАК Количество
	|ИЗ
	|	РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
	|ГДЕ
	|	КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	КомплектующиеНоменклатуры.Комплектующая,
	|	КомплектующиеНоменклатуры.ХарактеристикаКомплектующей,
	|	КомплектующиеНоменклатуры.ЕдиницаИзмерения
	|
	|УПОРЯДОЧИТЬ ПО
	|	КомплектующиеНоменклатуры.Комплектующая.Наименование,
	|	КомплектующиеНоменклатуры.ХарактеристикаКомплектующей.Наименование";
	
	
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", Характеристика);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СобратьКомплекты(ТаблицаКомплектующих) Экспорт
	
	ПараметрыОтбора = Новый Структура("Номенклатура, Характеристика");
	
	ТаблицаКомплектов = Новый ТаблицаЗначений;
	
	ТаблицаКомплектов.Колонки.Добавить("Номенклатура");
	ТаблицаКомплектов.Колонки.Добавить("Характеристика");
	ТаблицаКомплектов.Колонки.Добавить("Количество");
	ТаблицаКомплектов.Колонки.Добавить("Комплектующая");
	
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаКомплектующих.Номенклатура КАК Номенклатура,
	|	ТаблицаКомплектующих.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВТКомплектующие
	|ИЗ
	|	&ТаблицаКомплектующих КАК ТаблицаКомплектующих
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры КАК ХарактеристикаНоменклатуры,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КомплектующиеНоменклатуры.ХарактеристикаКомплектующей) КАК КоличествоКомплектующих
	|ПОМЕСТИТЬ ВТКомплекты
	|ИЗ
	|	РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
	|ГДЕ
	|	(КомплектующиеНоменклатуры.Комплектующая, КомплектующиеНоменклатуры.ХарактеристикаКомплектующей) В
	|			(ВЫБРАТЬ
	|				ВТКомплектующие.Номенклатура,
	|				ВТКомплектующие.Характеристика
	|			ИЗ
	|				ВТКомплектующие КАК ВТКомплектующие)
	|	И КомплектующиеНоменклатуры.Номенклатура.ВидНоменклатуры.Код <> ""000000010""
	|
	|СГРУППИРОВАТЬ ПО
	|	КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ХарактеристикаНоменклатуры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТКомплекты.ХарактеристикаНоменклатуры КАК ХарактеристикаКомплекта,
	|	ВТКомплекты.КоличествоКомплектующих КАК КоличествоКомплектующих,
	|	КомплектующиеНоменклатуры.Комплектующая КАК Номенклатура,
	|	КомплектующиеНоменклатуры.ХарактеристикаКомплектующей КАК Характеристика,
	|	СУММА(КомплектующиеНоменклатуры.Количество) КАК Количество
	|ИЗ
	|	ВТКомплекты КАК ВТКомплекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КомплектующиеНоменклатуры КАК КомплектующиеНоменклатуры
	|		ПО ВТКомплекты.ХарактеристикаНоменклатуры = КомплектующиеНоменклатуры.ХарактеристикаНоменклатуры
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТКомплекты.ХарактеристикаНоменклатуры,
	|	КомплектующиеНоменклатуры.Комплектующая,
	|	КомплектующиеНоменклатуры.ХарактеристикаКомплектующей,
	|	ВТКомплекты.КоличествоКомплектующих
	|ИТОГИ
	|	СРЕДНЕЕ(КоличествоКомплектующих)
	|ПО
	|	ХарактеристикаКомплекта";
	
	
	Запрос.УстановитьПараметр("ТаблицаКомплектующих", ТаблицаКомплектующих);
	
	ВыборкаПоГруппировкам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоГруппировкам.Следующий() Цикл
		
		СоберемКомплект = Истина;
		
		Выборка = ВыборкаПоГруппировкам.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(ПараметрыОтбора, Выборка);
			
			НайденныеСтроки = ТаблицаКомплектующих.НайтиСтроки(ПараметрыОтбора);
			
			Если НайденныеСтроки.Количество() > 0 И
				НайденныеСтроки[0].Количество >= Выборка.Количество Тогда
				Продолжить;
			КонецЕсли;
			
			СоберемКомплект = Ложь;
			
			Прервать;
			
		КонецЦикла;
		
		Если Не СоберемКомплект Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоКомплектов = 0;
		
		Пока СоберемКомплект Цикл
			
			КоличествоКомплектующих = ВыборкаПоГруппировкам.КоличествоКомплектующих;
			
			Выборка.Сбросить();
			
			Пока Выборка.Следующий() Цикл
				
				ЗаполнитьЗначенияСвойств(ПараметрыОтбора, Выборка);
				
				НайденныеСтроки = ТаблицаКомплектующих.НайтиСтроки(ПараметрыОтбора);
				
				СтрокаТЗ = НайденныеСтроки[0];
				
				Количество = СтрокаТЗ.Количество - Выборка.Количество;
				
				Если Количество < 0 Тогда
					
					СоберемКомплект = Ложь;
					
					Прервать;
					
				КонецЕсли;
				
				СтрокаТЗ.Количество = Количество;
				
				КоличествоКомплектующих = КоличествоКомплектующих - 1;
				
				Если КоличествоКомплектующих = 0 Тогда
					
					КоличествоКомплектов = КоличествоКомплектов + 1;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если КоличествоКомплектов > 0 Тогда
			
			НоваяСтрока = ТаблицаКомплектов.Добавить();
			
			НоваяСтрока.Номенклатура   = ВыборкаПоГруппировкам.ХарактеристикаКомплекта.Владелец;
			НоваяСтрока.Характеристика = ВыборкаПоГруппировкам.ХарактеристикаКомплекта;
			НоваяСтрока.Количество     = КоличествоКомплектов;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаТЗ Из ТаблицаКомплектующих Цикл
		
		Если СтрокаТЗ.Количество > 0 Тогда
			
			НоваяСтрока = ТаблицаКомплектов.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаКомплектов;
	
КонецФункции

