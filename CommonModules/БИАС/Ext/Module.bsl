Процедура ПередатьНакладнуюНаСайт(Параметры) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Реализация         = Параметры.Реализация;

	// Маркетплейсы историю покупок на сайте не смотрят - накладные им не шлём.
	Если Не КонтрагентВыгружаетсяНаСайт(Реализация.Контрагент) Тогда
		Возврат;
	КонецЕсли;

	СтруктураПараметров = Новый Структура("ТабДок, НомерКолонки, Гиперссылки");
	
	ЗаполнитьЗначенияСвойств(СтруктураПараметров, Параметры);
	
	СформироватьФайлыPDFXLSНакладной(Реализация, СтруктураПараметров);
	
	УИД = Строка(Реализация.УникальныйИдентификатор());
	
	ПутьКФайлуXML = СформироватьФайлXMLНакладной(Реализация, УИД);
	
	FTPСервер = Константы.ФТПСервер.Получить();
	FTPПорт   = Константы.ФТППорт.Получить();
	FTPЛогин  = Константы.ФТПЛогин.Получить();
	FTPПароль = Константы.ФТППароль.Получить();
	
	FTPСоединение = Новый FTPСоединение(FTPСервер, , FTPЛогин, FTPПароль, , Истина, 120);
	
	Если FTPСоединение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КаталогНаFTP = "/cvetkovtm.com/www/assets/shop/sync/buy-history/" + Реализация.Контрагент.Код;
	
	Попытка
		// Пытаемся установить текущий каталог
		FTPСоединение.УстановитьТекущийКаталог(КаталогНаFTP);
	Исключение
		// Если ошибка произошла, значит каталог не существует, создаем его
		FTPСоединение.СоздатьКаталог(КаталогНаFTP);
		FTPСоединение.УстановитьТекущийКаталог(КаталогНаFTP);
	КонецПопытки;
	
	ИмяФайла = "invoice_" + Реализация.Контрагент.Код + "_" + УИД + "_" + Формат(Реализация.Дата, "ДФ=yyyyMMddHHmmss");
	
	Если Реализация.СуммаДокумента = 0 Тогда
		УдалитьФайл(FTPСоединение, КаталогНаFTP, ИмяФайла);
	Иначе 
		Если СтруктураПараметров.Свойство("ПутьКФайлуPDF") Тогда
			
			FTPСоединение.Записать(СтруктураПараметров.ПутьКФайлуPDF, ИмяФайла + ".pdf");			
			УдалитьФайлы(СтруктураПараметров.ПутьКФайлуPDF);
			
		КонецЕсли;
		
		Если СтруктураПараметров.Свойство("ПутьКФайлуXLS")  Тогда
			
			FTPСоединение.Записать(СтруктураПараметров.ПутьКФайлуXLS, ИмяФайла + ".xlsx");
			
			УдалитьФайлы(СтруктураПараметров.ПутьКФайлуXLS);
			
		КонецЕсли;
		
		FTPСоединение.Записать(ПутьКФайлуXML, ИмяФайла + ".xml");
	КонецЕсли;
	
	
	
	УдалитьФайлы(ПутьКФайлуXML);
	
	ВыгрузитьДокументыПоВзаиморасчетам(Реализация, FTPСоединение);
	
	
	СтруктураДанных = Новый Структура;
	
	СтруктураДанных.Вставить("Реализация"        , Реализация);
	СтруктураДанных.Вставить("Контрагент"        , Реализация.Контрагент);
	СтруктураДанных.Вставить("СуммаКорректировки", Реализация.СуммаДокумента);
	
	СформироватьФайлыHTMLXMLРезервов(СтруктураДанных);
	//СформироватьФайлыPDFXMLРезервов(СтруктураДанных);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры 

Процедура СформироватьФайлыPDFXMLРезервовВФоне(Контрагент) Экспорт

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;

	СтруктураПараметров = Новый Структура;

	СтруктураПараметров.Вставить("Контрагент"        , Контрагент);
	СтруктураПараметров.Вставить("СуммаКорректировки", 0);

	Массив = Новый Массив;
	Массив.Добавить(СтруктураПараметров);

	// Ключ = контрагент. Задания по одному контрагенту работают с одними и теми же
	// данными и конкурируют друг с другом, поэтому второй запуск не нужен: платформа
	// откажет по занятому ключу, и это штатная ситуация, а не ошибка.
	Ключ = Строка(Контрагент.УникальныйИдентификатор());

	Попытка

		ФоновыеЗадания.Выполнить("Биас.СформироватьФайлыHTMLXMLРезервов", Массив, Ключ, "СформироватьФайлыHTMLXMLРезервов " + Контрагент.Наименование);

	Исключение

		ЗаписьЖурналаРегистрации(
		"ВыставленныеСчета",
		УровеньЖурналаРегистрации.Информация,
		,
		Контрагент,
		"Формирование резервов уже запущено, повторный запуск пропущен: "
		+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

	КонецПопытки;

КонецПроцедуры


