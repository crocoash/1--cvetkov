Процедура УдалитьФайл(FTPСоединение, КаталогНаFTP, ИмяФайла) 
	НайденныеФайлы = FTPСоединение.НайтиФайлы(КаталогНаFTP, ИмяФайла  + ".pdf");
	НайденныеФайлы1 = FTPСоединение.НайтиФайлы(КаталогНаFTP, ИмяФайла  + ".xml");
	НайденныеФайлы2 = FTPСоединение.НайтиФайлы(КаталогНаFTP, ИмяФайла  + ".xlsx");
	
	Если НайденныеФайлы.Количество() <> 0 Тогда
		ПутьКФайлуНаСервере = НайденныеФайлы[0].ПолноеИмя;	
		FTPСоединение.Удалить(ПутьКФайлуНаСервере);
	КонецЕсли;
	
	Если НайденныеФайлы1.Количество() <> 0 Тогда
		ПутьКФайлуНаСервере = НайденныеФайлы1[0].ПолноеИмя;	
		FTPСоединение.Удалить(ПутьКФайлуНаСервере);
	КонецЕсли; 
	
	Если НайденныеФайлы2.Количество() <> 0 Тогда
		ПутьКФайлуНаСервере = НайденныеФайлы2[0].ПолноеИмя;	
		FTPСоединение.Удалить(ПутьКФайлуНаСервере);
	КонецЕсли; 	
	
КонецПроцедуры
Процедура СформироватьФайлыPDFXLSНакладной(Реализация, СтруктураПараметров)
	
	Если СтруктураПараметров.Количество() = 0 Тогда
		
		РеализацияОбъект = Реализация.ПолучитьОбъект();
		
		СтруктураПараметров = РеализацияОбъект.ПечатьДокумента(Истина);
		
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("ТабДок") И
		ТипЗнч(СтруктураПараметров.ТабДок) = Тип("ТабличныйДокумент") Тогда
		
		ПутьКФайлуPDF = ПолучитьИмяВременногоФайла("pdf");
		ПутьКФайлуXLS = ПолучитьИмяВременногоФайла("xlsx");
		
		СтруктураПараметров.ТабДок.Записать(ПутьКФайлуPDF, ТипФайлаТабличногоДокумента.PDF);
		СтруктураПараметров.ТабДок.Записать(ПутьКФайлуXLS, ТипФайлаТабличногоДокумента.XLSX);
		
		СтруктураПараметров.Вставить("ПутьКФайлуPDF", ПутьКФайлуPDF);
		СтруктураПараметров.Вставить("ПутьКФайлуXLS", ПутьКФайлуXLS);
		
		НомерКолонки = Неопределено;
		Гиперссылки  = Неопределено;
		
		СтруктураПараметров.Свойство("НомерКолонки", НомерКолонки);
		СтруктураПараметров.Свойство("Гиперссылки" , Гиперссылки);
		
		Если ЗначениеЗаполнено(НомерКолонки) И ЗначениеЗаполнено(Гиперссылки) Тогда
			
			Попытка
				
				Excel = Новый COMОбъект("Excel.Application");
				
				Excel.DisplayAlerts = 0;
				
				Книга = Excel.WorkBooks.Open(ПутьКФайлуXLS);
				
				Лист = Книга.Sheets(1);
				
				Для Каждого Гиперссылка Из Гиперссылки Цикл
					
					Если ПустаяСтрока(Гиперссылка.Значение) Тогда
						Продолжить;
					КонецЕсли;
					
					Лист.Hyperlinks.Add(Лист.Cells(Гиперссылка.Ключ, НомерКолонки), Гиперссылка.Значение);
					
				КонецЦикла;
				
				Книга.SaveAs(ПутьКФайлуXLS);
				
				Книга.Close();
				
				Excel.Quit();
				
			Исключение
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьФайлXMLНакладной(Реализация, УИД)
	
	ПутьКФайлуXML = ПолучитьИмяВременногоФайла("xml");
	
	ЗаписьXML = Новый ЗаписьXML;
	
	ЗаписьXML.ОткрытьФайл(ПутьКФайлуXML);
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("invoices");
	
	Дата = Формат(Реализация.Дата, "ДФ=yyyy-MM-dd hh-mm-ss");
	
	ЗаписьXML.ЗаписатьАтрибут("date", Дата);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("invoice");
	
	ЗаписьXML.ЗаписатьАтрибут("uid", УИД);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("id");
	ЗаписьXML.ЗаписатьТекст(Формат(Реализация.Номер, "ЧГ=0"));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("date");
	ЗаписьXML.ЗаписатьТекст(Дата);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("user_1c_id");
	ЗаписьXML.ЗаписатьТекст(Реализация.Контрагент.Код);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("user_site_id");
	ЗаписьXML.ЗаписатьТекст(IDСайтаКонтрагентаСтрокой(Реализация.Контрагент));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	СуммаВзаиморасчетов = 0;
	
	ТЗОстатки = РегистрыНакопления.ВзаиморасчетыСКонтрагентами.Остатки(Новый МоментВремени(Реализация.Дата, Реализация), Новый Структура("Контрагент", Реализация.Контрагент), "Контрагент", "СуммаВзаиморасчетов");
	
	Если ТЗОстатки.Количество() > 0 Тогда
		
		СуммаВзаиморасчетов = ТЗОстатки[0].СуммаВзаиморасчетов;
		
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("user_debt");
	ЗаписьXML.ЗаписатьТекст(Формат(-(СуммаВзаиморасчетов + Реализация.СуммаДокумента), "ЧДЦ=0; ЧГ=0") + "");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("total");
	ЗаписьXML.ЗаписатьТекст("- " + Формат(Реализация.СуммаДокумента, "ЧДЦ=0; ЧГ=0"));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("currency");
	ЗаписьXML.ЗаписатьТекст(Реализация.ВалютаДокумента.Наименование);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказПокупателя.НомерТТН КАК НомерТТН,
	|	ЗаказПокупателя.СтатусОтправки КАК СтатусОтправки
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	ЗаказПокупателя.ОсновнойЗаказ = &Реализация
	|	И НЕ ЗаказПокупателя.ПометкаУдаления";
	
	
	Запрос.УстановитьПараметр("Реализация", Реализация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		НомерТТН       = Выборка.НомерТТН;
		СтатусОтправки = Выборка.СтатусОтправки;
		
	ИначеЕсли ЗначениеЗаполнено(Реализация.Сделка) Тогда
		
		НомерТТН       = Реализация.Сделка.НомерТТН;
		СтатусОтправки = Реализация.Сделка.СтатусОтправки;
		
	Иначе
		
		НомерТТН       = "";
		СтатусОтправки = "";
		
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("delivery_post_code");
	ЗаписьXML.ЗаписатьТекст(СокрЛП(НомерТТН));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("pack_status");
	ЗаписьXML.ЗаписатьТекст(?(Реализация.Собран,"Упакован","В очереди на упаковку"));
	ЗаписьXML.ЗаписатьКонецЭлемента();	
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("delivery_status");
	ЗаписьXML.ЗаписатьТекст(СокрЛП(СтатусОтправки));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.Закрыть();
	
	Возврат ПутьКФайлуXML;
	
КонецФункции

Процедура ВыгрузитьДокументыПоВзаиморасчетам(Документ, FTPСоединение)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВзаиморасчетыСКонтрагентамиОбороты.Регистратор КАК Регистратор,
	|	ВзаиморасчетыСКонтрагентамиОбороты.Регистратор.Контрагент.Код КАК КодКонтрагента
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыСКонтрагентами.Обороты(&ДатаНач, , Авто, Контрагент = &Контрагент) КАК ВзаиморасчетыСКонтрагентамиОбороты
	|ГДЕ
	|	ВзаиморасчетыСКонтрагентамиОбороты.Регистратор <> &Документ
	|	И (ВзаиморасчетыСКонтрагентамиОбороты.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ИЛИ ВзаиморасчетыСКонтрагентамиОбороты.Регистратор ССЫЛКА Документ.ВозвратТоваровОтПокупателя
	|			ИЛИ ВзаиморасчетыСКонтрагентамиОбороты.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|				И ВзаиморасчетыСКонтрагентамиОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПКО.ОплатаПокупателя)
	|			ИЛИ ВзаиморасчетыСКонтрагентамиОбороты.Регистратор ССЫЛКА Документ.РасходныйКассовыйОрдер
	|				И ВзаиморасчетыСКонтрагентамиОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВозвратДенежныхСредствПокупателю)
	|			ИЛИ ВзаиморасчетыСКонтрагентамиОбороты.Регистратор ССЫЛКА Документ.ПлатежноеПоручениеВходящее
	|				И ВзаиморасчетыСКонтрагентамиОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ОплатаПокупателя)
	|			ИЛИ ВзаиморасчетыСКонтрагентамиОбороты.Регистратор ССЫЛКА Документ.ПлатежноеПоручениеИсходящее
	|				И ВзаиморасчетыСКонтрагентамиОбороты.Регистратор.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийППИсходящее.ВозвратДенежныхСредствПокупателю))";
	
	
	Запрос.УстановитьПараметр("ДатаНач"   , Документ.Дата);
	Запрос.УстановитьПараметр("Контрагент", Документ.Контрагент);
	Запрос.УстановитьПараметр("Документ"  , Документ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		УИД = Строка(Выборка.Регистратор.УникальныйИдентификатор());
		
		ИмяФайла = "invoice_" + Выборка.КодКонтрагента + "_" + УИД + "_" + Формат(Выборка.Регистратор.дата, "ДФ=yyyyMMddHHmmss"); 
		
		Если ТипЗнч(Выборка.Регистратор) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
			
			СтруктураДанных = Новый Структура;  
			
			СформироватьФайлыPDFXLSНакладной(Выборка.Регистратор, СтруктураДанных);
			
			Если СтруктураДанных.Свойство("ПутьКФайлуPDF") Тогда
				
				FTPСоединение.Записать(СтруктураДанных.ПутьКФайлуPDF, ИмяФайла + ".pdf");
				
				УдалитьФайлы(СтруктураДанных.ПутьКФайлуPDF);
				
			КонецЕсли;
			
			Если СтруктураДанных.Свойство("ПутьКФайлуXLS") Тогда
				
				FTPСоединение.Записать(СтруктураДанных.ПутьКФайлуXLS, ИмяФайла + ".xlsx");
				
				УдалитьФайлы(СтруктураДанных.ПутьКФайлуXLS);
				
			КонецЕсли;
			
			ПутьКФайлуXML = СформироватьФайлXMLНакладной(Выборка.Регистратор, УИД);
			
		Иначе
			
			ПутьКФайлуXML = СформироватьФайлXMLДокумента(Выборка.Регистратор, УИД);
			
		КонецЕсли;
		
		FTPСоединение.Записать(ПутьКФайлуXML, ИмяФайла + ".xml");
		
		УдалитьФайлы(ПутьКФайлуXML);
		
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ВЫГРУЗКА ОПЛАТ И ВОЗВРАТОВ НА САЙТ (история покупок клиента)
//
// Схема та же, что у заказов: подписка ПередатьДокументНаСайт регистрирует
// документ в очереди РегистрСведений.ДокументыКВыгрузкеНаСайт в транзакции его
// записи, а разгребают очередь фоновое задание (сразу) и регламентное.
//
// Раньше выгрузка стартовала фоновым заданием прямо из транзакции: для только
// что созданного документа задание не находило его в базе, читало пустые
// реквизиты и клало файл с нулевой суммой и датой 01.01.0001 в корень
// buy-history вместо папки клиента - оплата на сайт не попадала.

// Обработчик подписки на событие ПриЗаписи платёжных документов и возвратов.
//
Процедура ПередатьДокументНаСайт(Источник, Отказ) Экспорт

	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если Не Константы.ВыгружатьДокументыНаСайтПриПроведении.Получить() Тогда
		Возврат;
	КонецЕсли;

	// Проведение здесь не проверяем: отмену проведения и пометку удаления тоже
	// нужно донести до сайта - обнулённым документом (см. ВыгрузитьДокументНаСайт).
	Если Не ДокументПодлежитВыгрузкеНаСайт(Источник, Ложь) Тогда
		Возврат;
	КонецЕсли;

	ЗарегистрироватьДокументКВыгрузкеНаСайт(Источник.Ссылка);

	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(Источник.Ссылка);

	// Задание только ускоряет выгрузку: если запись очереди ему ещё не видна,
	// документ подберёт регламентное задание.
	Попытка

		ФоновыеЗадания.Выполнить(
			"БИАС.ВыгрузитьДокументИзОчередиНаСайт",
			МассивПараметров,
			Строка(Источник.Ссылка.УникальныйИдентификатор()),
			"Передаем на сайт " + Строка(ТипЗнч(Источник)));

	Исключение

		// Ключ занят заданием предыдущей записи этого же документа (форма загрузки
		// Приват24 пишет платёж дважды подряд: Запись, следом Проведение). Тому
		// заданию проведённая версия ещё не видна, поэтому запускаем второе - уже
		// без ключа. Лишним оно не будет: задание само проверит, не обработана ли
		// эта версия документа.
		Попытка
			ФоновыеЗадания.Выполнить(
				"БИАС.ВыгрузитьДокументИзОчередиНаСайт",
				МассивПараметров,
				,
				"Передаем на сайт " + Строка(ТипЗнч(Источник)));
		Исключение
			ЗаписьЖурналаРегистрации(
				"ВыгрузкаДокументовНаСайт",
				УровеньЖурналаРегистрации.Информация,
				,
				Источник.Ссылка,
				"Фоновая передача документа не запущена, документ ждёт регламентного задания: "
				+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецПопытки;

КонецПроцедуры

// Код группы контрагентов-маркетплейсов ("Розница платформа").
Функция ГруппаКонтрагентовБезВыгрузкиНаСайт()

	Возврат "000004272";

КонецФункции

// Возвращает Ложь для контрагентов, чьи документы не должны уезжать на сайт.
//
// Маркетплейсы (Розетка 000004143, Каста 000004317 и прочие из группы "Розница
// платформа") торгуют через свои кабинеты: личного кабинета на сайте у них нет,
// историю покупок по ним никто не открывает. При этом накладные по ним копились
// в assets/shop/sync/buy-history/<код> - на 02.09.2026 это 517 МБ по Розетке и
// 422 МБ по Касте.
//
// Проверка по группе, а не по перечню кодов: новый маркетплейс, заведённый в ту
// же группу, отсекается сам.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты
//
// Возвращаемое значение:
//   Булево
//
Функция КонтрагентВыгружаетсяНаСайт(Контрагент) Экспорт

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Контрагент.Родитель.Код <> ГруппаКонтрагентовБезВыгрузкиНаСайт();

КонецФункции

// Проверяет, что документ вообще должен попадать в историю покупок на сайте.
//
// Параметры:
//  Документ            - ДокументСсылка, ДокументОбъект - оплата, возврат оплаты
//                        или возврат товаров от покупателя.
//  УчитыватьПроведение - Булево - Ложь: проверять только тип и вид операции,
//                        не глядя на проведение и пометку удаления. Нужно, чтобы
//                        отличить "документ такого рода на сайт не ходит" от
//                        "ходит, но сейчас отменён" - последний надо обнулить.
//
// Возвращаемое значение:
//   Булево
//
Функция ДокументПодлежитВыгрузкеНаСайт(Документ, УчитыватьПроведение = Истина) Экспорт

	// Проверяем именно Ссылку: сюда приходит и ДокументОбъект (из подписки), а
	// ЗначениеЗаполнено на мутабельном значении вызывает ошибку.
	Если Документ = Неопределено Или Не ЗначениеЗаполнено(Документ.Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если УчитыватьПроведение И (Не Документ.Проведен Или Документ.ПометкаУдаления) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Если Не КонтрагентВыгружаетсяНаСайт(Документ.Контрагент) Тогда
			Возврат Ложь;
		КонецЕсли;
	Исключение
		// У документа может не быть реквизита Контрагент - такой на сайт не едет.
		Возврат Ложь;
	КонецПопытки;

	ИмяДокумента = Документ.Метаданные().Имя;

	Если ИмяДокумента = "ПриходныйКассовыйОрдер" Тогда

		Возврат Документ.ВидОперации = Перечисления.ВидыОперацийПКО.ОплатаПокупателя;

	ИначеЕсли ИмяДокумента = "РасходныйКассовыйОрдер" Тогда

		Возврат Документ.ВидОперации = Перечисления.ВидыОперацийРКО.ВозвратДенежныхСредствПокупателю;

	ИначеЕсли ИмяДокумента = "ПлатежноеПоручениеВходящее" Тогда

		Возврат Документ.ВидОперации = Перечисления.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ОплатаПокупателя;

	ИначеЕсли ИмяДокумента = "ПлатежноеПоручениеИсходящее" Тогда

		Возврат Документ.ВидОперации = Перечисления.ВидыОперацийППИсходящее.ВозвратДенежныхСредствПокупателю;

	ИначеЕсли ИмяДокумента = "ВозвратТоваровОтПокупателя" Тогда

		Возврат Истина;

	КонецЕсли;

	Возврат Ложь;

КонецФункции

// Регистрирует документ в очереди выгрузки на сайт.
// Вызывается в транзакции записи документа.
//
// Запись из очереди не удаляется после отправки, а получает ДатаВыгрузки - так
// регистр заодно служит журналом "что и когда уехало на сайт". Документ ждёт
// отправки, пока ДатаВыгрузки < ДатаРегистрации.
//
Процедура ЗарегистрироватьДокументКВыгрузкеНаСайт(Документ) Экспорт

	// Через .Ссылка: сюда может прийти и ДокументОбъект, а ЗначениеЗаполнено на
	// мутабельном значении вызывает ошибку.
	ДокументСсылка = ?(Документ = Неопределено, Неопределено, Документ.Ссылка);

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	// Сбой регистрации не должен ронять запись самого документа.
	Попытка
		МенеджерЗаписи = РегистрыСведений.ДокументыКВыгрузкеНаСайт.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Документ = ДокументСсылка;
		МенеджерЗаписи.Прочитать();

		ДатаРегистрации = ТекущаяДата();

		// Дата регистрации только растёт. Иначе повторная регистрация в ту же
		// секунду (форма загрузки Приват24 пишет документ дважды подряд: сначала
		// Запись, следом Проведение) сравнялась бы с уже обработанной версией,
		// и проведённый документ на сайт не уехал бы.
		Если МенеджерЗаписи.Выбран() Тогда

			Если ДатаРегистрации <= МенеджерЗаписи.ДатаРегистрации Тогда
				ДатаРегистрации = МенеджерЗаписи.ДатаРегистрации + 1;
			КонецЕсли;

			Если ДатаРегистрации <= МенеджерЗаписи.ДатаВыгрузки Тогда
				ДатаРегистрации = МенеджерЗаписи.ДатаВыгрузки + 1;
			КонецЕсли;

		Иначе
			МенеджерЗаписи.Документ = ДокументСсылка;
		КонецЕсли;

		МенеджерЗаписи.ДатаРегистрации = ДатаРегистрации;
		МенеджерЗаписи.Попыток         = 0;
		МенеджерЗаписи.ПоследняяОшибка = "";
		МенеджерЗаписи.Записать(Истина);
	Исключение
		ЗаписьЖурналаРегистрации(
			"ВыгрузкаДокументовНаСайт",
			УровеньЖурналаРегистрации.Ошибка,
			,
			ДокументСсылка,
			"Не удалось поставить документ в очередь выгрузки на сайт: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Отмечает версию документа обработанной: из очереди она больше не берётся.
//
// Параметры:
//  Документ        - ДокументСсылка
//  ДатаРегистрации - Дата - версия, которую обработали. Если документ
//                    перерегистрировали, пока шла выгрузка, запись остаётся в
//                    очереди на следующий заход.
//  ФайлОтправлен   - Булево - Ложь: документ признан не подлежащим выгрузке,
//                    файл на сайт не уходил (флаг Выгружался не взводится).
//
Процедура ОтметитьВыгрузкуДокументаНаСайт(Документ, ДатаРегистрации = Неопределено, ФайлОтправлен = Истина) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	МенеджерЗаписи = РегистрыСведений.ДокументыКВыгрузкеНаСайт.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ = Документ;
	МенеджерЗаписи.Прочитать();

	Если Не МенеджерЗаписи.Выбран() Тогда

		// Документ выгрузили мимо очереди (обработка перевыгрузки) - всё равно
		// фиксируем факт отправки: он нужен, чтобы потом донести до сайта отмену
		// проведения обнулённым документом.
		МенеджерЗаписи.Документ        = Документ;
		МенеджерЗаписи.ДатаРегистрации = ?(ДатаРегистрации = Неопределено, ТекущаяДата(), ДатаРегистрации);

	ИначеЕсли ДатаРегистрации <> Неопределено И МенеджерЗаписи.ДатаРегистрации > ДатаРегистрации Тогда

		Возврат;

	КонецЕсли;

	МенеджерЗаписи.ДатаВыгрузки    = МенеджерЗаписи.ДатаРегистрации;
	МенеджерЗаписи.Выгружался      = МенеджерЗаписи.Выгружался Или ФайлОтправлен;
	МенеджерЗаписи.Попыток         = 0;
	МенеджерЗаписи.ПоследняяОшибка = "";
	МенеджерЗаписи.Записать(Истина);

КонецПроцедуры

// Выгружает один документ из очереди. Метод фонового задания, запускаемого из
// подписки ПередатьДокументНаСайт.
//
Процедура ВыгрузитьДокументИзОчередиНаСайт(Параметр) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Документ = Параметр;

	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.ДокументыКВыгрузкеНаСайт.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ = Документ;
	МенеджерЗаписи.Прочитать();

	// Записи очереди ещё не видно - транзакция записи документа не зафиксирована,
	// в базе документа либо нет, либо он старой версии. Выгрузит регламентное задание.
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;

	// Эту версию документа уже обработали (например, соседним заданием).
	Если МенеджерЗаписи.ДатаВыгрузки >= МенеджерЗаписи.ДатаРегистрации Тогда
		Возврат;
	КонецЕсли;

	ДатаРегистрации = МенеджерЗаписи.ДатаРегистрации;

	// Документ записан, но ещё не проведён - на сайте его нет, обнулять нечего.
	// Именно так пишет платежи форма загрузки Приват24: сначала Запись, следом
	// Проведение. Раньше сюда успевало влезть фоновое задание и отправляло на
	// сайт обнулённый файл, после чего снимало документ с очереди - оплата в
	// историю покупок не попадала. Проведут - подписка зарегистрирует заново.
	Если Не ДокументПодлежитВыгрузкеНаСайт(Документ) И Не МенеджерЗаписи.Выгружался Тогда
		ОтметитьВыгрузкуДокументаНаСайт(Документ, ДатаРегистрации, Ложь);
		Возврат;
	КонецЕсли;

	Попытка
		ВыгрузитьДокументНаСайт(Документ);
		ОтметитьВыгрузкуДокументаНаСайт(Документ, ДатаРегистрации);
		СформироватьФайлыPDFXMLРезервовВФоне(Документ.Контрагент);
	Исключение
		// Документ остаётся в очереди, повторит регламентное задание.
		ЗаписьЖурналаРегистрации(
			"ВыгрузкаДокументовНаСайт",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Документ,
			"Документ не выгружен, оставлен в очереди: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Разгребает обе очереди выгрузки на сайт.
// Метод регламентного задания ВыгрузкаЗаказовНаСайт.
//
Процедура ВыгрузитьОчередиНаСайт() Экспорт

	ВыгрузитьОчередьЗаказовНаСайт();

	// Страховка: подписка могла не отработать (документ создан кодом обмена,
	// правки не были загружены в базу, регистрация упала на блокировке).
	Попытка
		ЗарегистрироватьПропущенныеДокументыКВыгрузкеНаСайт();
	Исключение
		ЗаписьЖурналаРегистрации(
			"ВыгрузкаДокументовНаСайт",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось добрать пропущенные документы в очередь выгрузки: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ВыгрузитьОчередьДокументовНаСайт();

КонецПроцедуры

// Добирает в очередь оплаты и возвраты, которых в регистре нет вообще: подписка
// ПередатьДокументНаСайт по какой-то причине мимо них прошла. Смотрим только
// свежие документы - перевыгрузка старых делается вручную обработкой
// ПеревыгрузкаОплатНаСайт.
//
Процедура ЗарегистрироватьПропущенныеДокументыКВыгрузкеНаСайт() Экспорт

	Если Не Константы.ВыгружатьДокументыНаСайтПриПроведении.Получить() Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	ГлубинаПоискаДней = 7;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	ПлатежноеПоручениеВходящее.Ссылка КАК Документ
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
	|ГДЕ
	|	ПлатежноеПоручениеВходящее.Проведен
	|	И НЕ ПлатежноеПоручениеВходящее.ПометкаУдаления
	|	И ПлатежноеПоручениеВходящее.Дата >= &ДатаНачала
	|	И ПлатежноеПоручениеВходящее.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоступлениеБезналичныхДенежныхСредств.ОплатаПокупателя)
	|	И ПлатежноеПоручениеВходящее.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	И ЕСТЬNULL(ПлатежноеПоручениеВходящее.Контрагент.Родитель.Код, """") <> &КодСлужебнойГруппы
	|	И НЕ ПлатежноеПоручениеВходящее.Ссылка В
	|			(ВЫБРАТЬ ДокументыКВыгрузкеНаСайт.Документ ИЗ РегистрСведений.ДокументыКВыгрузкеНаСайт КАК ДокументыКВыгрузкеНаСайт)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПриходныйКассовыйОрдер.Ссылка
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	ПриходныйКассовыйОрдер.Проведен
	|	И НЕ ПриходныйКассовыйОрдер.ПометкаУдаления
	|	И ПриходныйКассовыйОрдер.Дата >= &ДатаНачала
	|	И ПриходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПКО.ОплатаПокупателя)
	|	И ПриходныйКассовыйОрдер.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	И ЕСТЬNULL(ПриходныйКассовыйОрдер.Контрагент.Родитель.Код, """") <> &КодСлужебнойГруппы
	|	И НЕ ПриходныйКассовыйОрдер.Ссылка В
	|			(ВЫБРАТЬ ДокументыКВыгрузкеНаСайт.Документ ИЗ РегистрСведений.ДокументыКВыгрузкеНаСайт КАК ДокументыКВыгрузкеНаСайт)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПлатежноеПоручениеИсходящее.Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручениеИсходящее КАК ПлатежноеПоручениеИсходящее
	|ГДЕ
	|	ПлатежноеПоручениеИсходящее.Проведен
	|	И НЕ ПлатежноеПоручениеИсходящее.ПометкаУдаления
	|	И ПлатежноеПоручениеИсходящее.Дата >= &ДатаНачала
	|	И ПлатежноеПоручениеИсходящее.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийППИсходящее.ВозвратДенежныхСредствПокупателю)
	|	И ПлатежноеПоручениеИсходящее.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	И ЕСТЬNULL(ПлатежноеПоручениеИсходящее.Контрагент.Родитель.Код, """") <> &КодСлужебнойГруппы
	|	И НЕ ПлатежноеПоручениеИсходящее.Ссылка В
	|			(ВЫБРАТЬ ДокументыКВыгрузкеНаСайт.Документ ИЗ РегистрСведений.ДокументыКВыгрузкеНаСайт КАК ДокументыКВыгрузкеНаСайт)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РасходныйКассовыйОрдер.Ссылка
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|ГДЕ
	|	РасходныйКассовыйОрдер.Проведен
	|	И НЕ РасходныйКассовыйОрдер.ПометкаУдаления
	|	И РасходныйКассовыйОрдер.Дата >= &ДатаНачала
	|	И РасходныйКассовыйОрдер.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРКО.ВозвратДенежныхСредствПокупателю)
	|	И РасходныйКассовыйОрдер.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	И ЕСТЬNULL(РасходныйКассовыйОрдер.Контрагент.Родитель.Код, """") <> &КодСлужебнойГруппы
	|	И НЕ РасходныйКассовыйОрдер.Ссылка В
	|			(ВЫБРАТЬ ДокументыКВыгрузкеНаСайт.Документ ИЗ РегистрСведений.ДокументыКВыгрузкеНаСайт КАК ДокументыКВыгрузкеНаСайт)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВозвратТоваровОтПокупателя.Ссылка
	|ИЗ
	|	Документ.ВозвратТоваровОтПокупателя КАК ВозвратТоваровОтПокупателя
	|ГДЕ
	|	ВозвратТоваровОтПокупателя.Проведен
	|	И НЕ ВозвратТоваровОтПокупателя.ПометкаУдаления
	|	И ВозвратТоваровОтПокупателя.Дата >= &ДатаНачала
	|	И ВозвратТоваровОтПокупателя.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	И ЕСТЬNULL(ВозвратТоваровОтПокупателя.Контрагент.Родитель.Код, """") <> &КодСлужебнойГруппы
	|	И НЕ ВозвратТоваровОтПокупателя.Ссылка В
	|			(ВЫБРАТЬ ДокументыКВыгрузкеНаСайт.Документ ИЗ РегистрСведений.ДокументыКВыгрузкеНаСайт КАК ДокументыКВыгрузкеНаСайт)";

	Запрос.УстановитьПараметр("ДатаНачала"        , НачалоДня(ТекущаяДата() - ГлубинаПоискаДней * 86400));
	Запрос.УстановитьПараметр("КодСлужебнойГруппы", "000004272");

	Выборка = Запрос.Выполнить().Выбрать();

	Добрано = 0;

	Пока Выборка.Следующий() Цикл
		ЗарегистрироватьДокументКВыгрузкеНаСайт(Выборка.Документ);
		Добрано = Добрано + 1;
	КонецЦикла;

	Если Добрано > 0 Тогда
		ЗаписьЖурналаРегистрации(
			"ВыгрузкаДокументовНаСайт",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Добрано в очередь выгрузки документов, мимо которых прошла подписка: "
			+ Формат(Добрано, "ЧН=0; ЧГ=0"));
	КонецЕсли;

КонецПроцедуры

// Разгребает очередь выгрузки оплат и возвратов на сайт.
//
Процедура ВыгрузитьОчередьДокументовНаСайт() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	МаксимумПопыток = 5;

	// За один заход выгружаем не больше 50 документов: к каждому тянется
	// перевыгрузка связанных документов контрагента с печатью накладных.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	ДокументыКВыгрузкеНаСайт.Документ КАК Документ,
	|	ДокументыКВыгрузкеНаСайт.ДатаРегистрации КАК ДатаРегистрации,
	|	ДокументыКВыгрузкеНаСайт.Попыток КАК Попыток,
	|	ДокументыКВыгрузкеНаСайт.Выгружался КАК Выгружался
	|ИЗ
	|	РегистрСведений.ДокументыКВыгрузкеНаСайт КАК ДокументыКВыгрузкеНаСайт
	|ГДЕ
	|	ДокументыКВыгрузкеНаСайт.ДатаВыгрузки < ДокументыКВыгрузкеНаСайт.ДатаРегистрации
	|	И ДокументыКВыгрузкеНаСайт.Попыток < &МаксимумПопыток
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаРегистрации";

	Запрос.УстановитьПараметр("МаксимумПопыток", МаксимумПопыток);

	Очередь = Запрос.Выполнить().Выгрузить();

	// Полузаписанные документы (записан, но ещё не проведён) снимаем без похода на
	// FTP: на сайте их нет, обнулять нечего. Проведут - подписка зарегистрирует
	// заново. Иначе такие записи навсегда заняли бы начало очереди.
	Индекс = Очередь.Количество() - 1;

	Пока Индекс >= 0 Цикл

		СтрокаОчереди = Очередь[Индекс];

		Если Не ДокументПодлежитВыгрузкеНаСайт(СтрокаОчереди.Документ) И Не СтрокаОчереди.Выгружался Тогда
			ОтметитьВыгрузкуДокументаНаСайт(СтрокаОчереди.Документ, СтрокаОчереди.ДатаРегистрации, Ложь);
			Очередь.Удалить(Индекс);
		КонецЕсли;

		Индекс = Индекс - 1;

	КонецЦикла;

	Если Очередь.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Недоступный FTP - это не вина конкретного документа, счётчик попыток не растёт.
	Попытка
		FTPСоединение = ПодключитьсяКFTPСайта();
	Исключение
		ЗаписьЖурналаРегистрации(
			"ВыгрузкаДокументовНаСайт",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось подключиться к FTP сайта, в очереди документов: "
			+ Формат(Очередь.Количество(), "ЧН=0; ЧГ=0") + ". "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Контрагенты = Новый Соответствие;

	Для Каждого СтрокаОчереди Из Очередь Цикл

		Попытка
			ВыгрузитьДокументНаСайт(СтрокаОчереди.Документ, FTPСоединение);
			ОтметитьВыгрузкуДокументаНаСайт(СтрокаОчереди.Документ, СтрокаОчереди.ДатаРегистрации);
			Контрагенты.Вставить(СтрокаОчереди.Документ.Контрагент, Истина);
		Исключение
			ОтметитьОшибкуВыгрузкиДокументаНаСайт(
				СтрокаОчереди.Документ,
				СтрокаОчереди.Попыток + 1,
				МаксимумПопыток,
				ИнформацияОбОшибке());
		КонецПопытки;

	КонецЦикла;

	Для Каждого КлючИЗначение Из Контрагенты Цикл

		Если Не ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			СформироватьФайлыPDFXMLРезервовВФоне(КлючИЗначение.Ключ);
		Исключение
			ЗаписьЖурналаРегистрации(
				"ВыгрузкаДокументовНаСайт",
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Справочники.Контрагенты,
				КлючИЗначение.Ключ,
				"Не сформированы файлы резервов: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Процедура ОтметитьОшибкуВыгрузкиДокументаНаСайт(Документ, Попыток, МаксимумПопыток, ИнфОбОшибке)

	ТекстОшибки = ПодробноеПредставлениеОшибки(ИнфОбОшибке);

	// Запись остаётся в регистре и после исчерпания попыток: по ней видно, какой
	// документ не уехал и почему. Из очереди её выводит счётчик попыток, вернуть
	// в очередь можно перезаписью документа или обработкой ПеревыгрузкаОплатНаСайт.
	Попытка
		МенеджерЗаписи = РегистрыСведений.ДокументыКВыгрузкеНаСайт.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Документ = Документ;
		МенеджерЗаписи.Прочитать();

		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Попыток         = Попыток;
			МенеджерЗаписи.ПоследняяОшибка = Лев(ТекстОшибки, 500);
			МенеджерЗаписи.Записать(Истина);
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если Попыток >= МаксимумПопыток Тогда

		ЗаписьЖурналаРегистрации(
			"ВыгрузкаДокументовНаСайт",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Документ,
			"Документ снят с очереди выгрузки после " + Формат(Попыток, "ЧН=0; ЧГ=0")
			+ " попыток, нужна ручная перевыгрузка: " + ТекстОшибки);

		Возврат;

	КонецЕсли;

	ЗаписьЖурналаРегистрации(
		"ВыгрузкаДокументовНаСайт",
		УровеньЖурналаРегистрации.Предупреждение,
		,
		Документ,
		"Попытка " + Формат(Попыток, "ЧН=0; ЧГ=0") + " выгрузки документа не удалась: " + ТекстОшибки);

КонецПроцедуры

// Кладёт документ (XML, а для возврата товаров ещё PDF и XLSX) в историю
// покупок контрагента на FTP сайта.
//
// Параметры:
//  Документ           - ДокументСсылка
//  FTPСоединение      - FTPСоединение - открытое соединение для пакетной выгрузки;
//                       Неопределено - открыть своё.
//  ВыгружатьСвязанные - Булево - перевыгрузить последующие документы контрагента
//                       по взаиморасчётам и обновить данные покупателя на сайте.
//  Обнулить           - Булево, Неопределено - выгрузить документ с нулевой суммой
//                       (так сайт вычёркивает его из истории). Неопределено -
//                       определить самостоятельно: обнуляем отменённые и помеченные
//                       на удаление.
//
Процедура ВыгрузитьДокументНаСайт(Документ, FTPСоединение = Неопределено, ВыгружатьСвязанные = Истина, Обнулить = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	// Через .Ссылка: сюда может прийти и ДокументОбъект, а ЗначениеЗаполнено на
	// мутабельном значении вызывает ошибку.
	ДокументСсылка = ?(Документ = Неопределено, Неопределено, Документ.Ссылка);

	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат;
	КонецЕсли;

	Если Обнулить = Неопределено Тогда
		Обнулить = Не ДокументПодлежитВыгрузкеНаСайт(ДокументСсылка);
	КонецЕсли;

	Контрагент = ДокументСсылка.Контрагент;

	// Пустой код означает, что документа в базе ещё (или уже) нет: без кода файл
	// уедет в корень buy-history вместо папки клиента, и на сайте его не найдут.
	Если Не ЗначениеЗаполнено(Контрагент) Или ПустаяСтрока(СокрЛП(Контрагент.Код)) Тогда
		ВызватьИсключение "Не определён контрагент документа " + Строка(ДокументСсылка)
			+ " - выгрузка в историю покупок невозможна";
	КонецЕсли;

	Соединение = ?(FTPСоединение = Неопределено, ПодключитьсяКFTPСайта(), FTPСоединение);

	УстановитьКаталогИсторииПокупокНаСайте(Соединение, СокрЛП(Контрагент.Код));

	УИД      = Строка(ДокументСсылка.УникальныйИдентификатор());
	ИмяФайла = "invoice_" + СокрЛП(Контрагент.Код) + "_" + УИД + "_" + Формат(ДокументСсылка.Дата, "ДФ=yyyyMMddHHmmss");

	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") И Не Обнулить Тогда

		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();

		Если ДокументОбъект <> Неопределено Тогда

			ТабДок = ДокументОбъект.ПечатьВозвратаОтПокупателя();

			Если ТипЗнч(ТабДок) = Тип("ТабличныйДокумент") Тогда

				ПутьКФайлуPDF = ПолучитьИмяВременногоФайла("pdf");
				ПутьКФайлуXLS = ПолучитьИмяВременногоФайла("xlsx");

				ТабДок.Записать(ПутьКФайлуPDF, ТипФайлаТабличногоДокумента.PDF);
				ТабДок.Записать(ПутьКФайлуXLS, ТипФайлаТабличногоДокумента.XLSX);

				Попытка
					Соединение.Записать(ПутьКФайлуPDF, ИмяФайла + ".pdf");
					Соединение.Записать(ПутьКФайлуXLS, ИмяФайла + ".xlsx");
				Исключение
					УдалитьФайлы(ПутьКФайлуPDF);
					УдалитьФайлы(ПутьКФайлуXLS);
					ВызватьИсключение;
				КонецПопытки;

				УдалитьФайлы(ПутьКФайлуPDF);
				УдалитьФайлы(ПутьКФайлуXLS);

			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	ПутьКФайлуXML = СформироватьФайлXMLДокумента(ДокументСсылка, УИД, Обнулить);

	Попытка
		Соединение.Записать(ПутьКФайлуXML, ИмяФайла + ".xml");
	Исключение
		УдалитьФайлы(ПутьКФайлуXML);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьФайлы(ПутьКФайлуXML);

	Если ВыгружатьСвязанные Тогда

		ВыгрузитьДокументыПоВзаиморасчетам(ДокументСсылка, Соединение);

		ВыгрузкаПокупателейНашСайт(Контрагент);

	КонецЕсли;

КонецПроцедуры

// Открывает соединение с FTP сайта без перехода в конкретный каталог.
//
Функция ПодключитьсяКFTPСайта(Таймаут = 120) Экспорт

	FTPСервер = Константы.ФТПСервер.Получить();
	FTPЛогин  = Константы.ФТПЛогин.Получить();
	FTPПароль = Константы.ФТППароль.Получить();

	Возврат Новый FTPСоединение(FTPСервер, , FTPЛогин, FTPПароль, , Истина, Таймаут);

КонецФункции

// Переходит в каталог истории покупок контрагента, при необходимости создаёт его.
//
Процедура УстановитьКаталогИсторииПокупокНаСайте(FTPСоединение, КодКонтрагента) Экспорт

	Если ПустаяСтрока(КодКонтрагента) Тогда
		ВызватьИсключение "Не задан код контрагента для каталога истории покупок";
	КонецЕсли;

	КаталогНаFTP = "/cvetkovtm.com/www/assets/shop/sync/buy-history/" + КодКонтрагента;

	Попытка
		FTPСоединение.УстановитьТекущийКаталог(КаталогНаFTP);
	Исключение
		FTPСоединение.СоздатьКаталог(КаталогНаFTP);
		FTPСоединение.УстановитьТекущийКаталог(КаталогНаFTP);
	КонецПопытки;

КонецПроцедуры

// Ищет в корне каталога истории покупок файлы, оставшиеся от старого дефекта
// выгрузки: имя вида invoice__<uid>_00010101000000.xml - код клиента пустой,
// дата нулевая, внутри нулевые суммы. Такие файлы сайт никому не показывает.
//
// Возвращаемое значение:
//   Массив из Строка - имена найденных файлов.
//
Функция НайтиМусорныеФайлыИсторииПокупок(FTPСоединение = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Соединение = ?(FTPСоединение = Неопределено, ПодключитьсяКFTPСайта(), FTPСоединение);

	Результат = Новый Массив;

	Файлы = Соединение.НайтиФайлы("/cvetkovtm.com/www/assets/shop/sync/buy-history", "invoice_*.xml", Ложь);

	Для Каждого Файл Из Файлы Цикл

		Если ЭтоМусорныйФайлИсторииПокупок(Файл.Имя) Тогда
			Результат.Добавить(Файл.Имя);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЭтоМусорныйФайлИсторииПокупок(ИмяФайла) Экспорт

	// Штатное имя - invoice_<код клиента>_<uid>_<дата>.xml. У битых файлов код
	// пустой (двойное подчёркивание) и дата нулевая; требуем оба признака сразу.
	Возврат Лев(ИмяФайла, 9) = "invoice__" И СтрНайти(ИмяФайла, "_00010101000000") > 0;

КонецФункции

// Удаляет мусорные файлы из корня каталога истории покупок.
//
// Параметры:
//  МассивИмен - Массив из Строка, Неопределено - что удалять; Неопределено -
//               найти самостоятельно.
//
// Возвращаемое значение:
//   Число - сколько файлов удалено.
//
Функция УдалитьМусорныеФайлыИсторииПокупок(МассивИмен = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Соединение = ПодключитьсяКFTPСайта();
	Каталог    = "/cvetkovtm.com/www/assets/shop/sync/buy-history";

	Имена = ?(МассивИмен = Неопределено, НайтиМусорныеФайлыИсторииПокупок(Соединение), МассивИмен);

	Удалено = 0;

	Для Каждого Имя Из Имена Цикл

		// Страховка от удаления нормальных файлов, если сюда передали лишнее.
		Если Не ЭтоМусорныйФайлИсторииПокупок(Имя) Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			Соединение.Удалить(Каталог + "/" + Имя);
			Удалено = Удалено + 1;
		Исключение
			ЗаписьЖурналаРегистрации(
				"ВыгрузкаДокументовНаСайт",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				"Не удалён файл " + Имя + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЦикла;

	ЗаписьЖурналаРегистрации(
		"ВыгрузкаДокументовНаСайт",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Удалено мусорных файлов истории покупок: " + Формат(Удалено, "ЧН=0; ЧГ=0"));

	Возврат Удалено;

КонецФункции

// Оставлено для совместимости с фоновыми заданиями, поставленными в очередь до
// обновления.
//
Процедура ПередачаДокументаНаСайтФон(Параметры) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ТипЗнч(Параметры) = Тип("Массив") И Параметры.Количество() > 0 Тогда
		Документ = Параметры[0];
	Иначе
		Документ = Параметры;
	КонецЕсли;

	ВыгрузитьДокументНаСайт(Документ);

КонецПроцедуры

// Параметры:
//  Обнулить - Булево - записать нулевые суммы. Так на сайт передаётся отмена
//             проведения или пометка удаления документа: нулевые документы сайт
//             в истории покупок не показывает.
//
Функция СформироватьФайлXMLДокумента(ДокументСсылка, УИД, Обнулить = Ложь)

	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВозвратТоваровОтПокупателя") Тогда
		
		СуммаДокумента = -ДокументСсылка.СуммаДокумента;
		Знак           = "+ ";
		dpc            = "Возврат товара";
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		
		СуммаДокумента = -ДокументСсылка.СуммаДокумента;
		Знак           = "+ ";
		dpc            = "Оплата";
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		
		СуммаДокумента = ДокументСсылка.СуммаДокумента;
		Знак           = "- ";
		dpc            = "Возврат оплати";
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПлатежноеПоручениеВходящее") Тогда
		
		СуммаДокумента = -ДокументСсылка.СуммаДокумента;
		Знак           = "+ ";
		dpc            = "Оплата";
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПлатежноеПоручениеИсходящее") Тогда
		
		СуммаДокумента = ДокументСсылка.СуммаДокумента;
		Знак           = "- ";
		dpc            = "Возврат оплати";
		
	КонецЕсли;

	Если Обнулить Тогда
		СуммаДокумента = 0;
	КонецЕсли;

	ПутьКФайлуXML = ПолучитьИмяВременногоФайла("xml");

	ЗаписьXML = Новый ЗаписьXML;
	
	ЗаписьXML.ОткрытьФайл(ПутьКФайлуXML);
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("docs");
	
	Дата = Формат(ДокументСсылка.Дата, "ДФ=yyyy-MM-dd hh-mm-ss");
	
	ЗаписьXML.ЗаписатьАтрибут("date", Дата);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("invoice");
	
	ЗаписьXML.ЗаписатьАтрибут("uid", УИД);
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("id");
	ЗаписьXML.ЗаписатьТекст(ОбщегоНазначения.УбратьНоликиСлева(ДокументСсылка.Номер));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("date");
	ЗаписьXML.ЗаписатьТекст(Дата);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("user_1c_id");
	ЗаписьXML.ЗаписатьТекст(ДокументСсылка.Контрагент.Код);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("user_site_id");
	ЗаписьXML.ЗаписатьТекст(IDСайтаКонтрагентаСтрокой(ДокументСсылка.Контрагент));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	СуммаВзаиморасчетов = 0;
	
	ТЗОстатки = РегистрыНакопления.ВзаиморасчетыСКонтрагентами.Остатки(Новый МоментВремени(ДокументСсылка.Дата, ДокументСсылка), Новый Структура("Контрагент", ДокументСсылка.Контрагент), "Контрагент", "СуммаВзаиморасчетов");
	
	Если ТЗОстатки.Количество() > 0 Тогда
		
		СуммаВзаиморасчетов = ТЗОстатки[0].СуммаВзаиморасчетов;
		
	КонецЕсли;
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("user_debt");
	ЗаписьXML.ЗаписатьТекст(Формат(-(СуммаВзаиморасчетов + СуммаДокумента), "ЧДЦ=0; ЧГ=0") + "");
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("total");
	ЗаписьXML.ЗаписатьТекст(?(Обнулить, "0", Знак + Формат(ДокументСсылка.СуммаДокумента, "ЧДЦ=0; ЧГ=0")));
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("currency");
	ЗаписьXML.ЗаписатьТекст(ДокументСсылка.ВалютаДокумента.Наименование);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("delivery_post_code");
	ЗаписьXML.ЗаписатьТекст(dpc);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.Закрыть();
	
	Возврат ПутьКФайлуXML;
	
КонецФункции

// Монополия по ценовой группе и отслеживание конкуренции — правило оптовое.
// Розничного покупателя оно не касается: розница лежит в группах "Розница группа"
// и "Розница платформа" (маркетплейсы), опт — внутри группы "Клиенты".
// Проверкой по торговым точкам розница не отсекается: у розничного покупателя
// торговая точка заполняется регионом доставки.
Функция КонтрагентРозничный(Контрагент) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КодыРозничныхГрупп = Новый Массив;
	
	КодыРозничныхГрупп.Добавить("000000463"); // Розница группа
	КодыРозничныхГрупп.Добавить("000004272"); // Розница платформа
	
	РозничныеГруппы = Новый Массив;
	
	Для Каждого КодГруппы Из КодыРозничныхГрупп Цикл
		
		Группа = Справочники.Контрагенты.НайтиПоКоду(КодГруппы);
		
		Если ЗначениеЗаполнено(Группа) Тогда
			РозничныеГруппы.Добавить(Группа);
		КонецЕсли;
		
	КонецЦикла;
	
	Если РозничныеГруппы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	&Контрагент В ИЕРАРХИИ (&РозничныеГруппы) КАК ЭтоРозница";
	
	
	Запрос.УстановитьПараметр("Контрагент"     , Контрагент);
	Запрос.УстановитьПараметр("РозничныеГруппы", РозничныеГруппы);
	
	ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаЗапроса.Следующий() Тогда
		Возврат ВыборкаЗапроса.ЭтоРозница;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЦеноваяГруппаДоступнаДляПродажи(ЦеноваяГруппа, Контрагент) Экспорт
	
	Если Не ЗначениеЗаполнено(ЦеноваяГруппа) Или
		Контрагент.ТорговыеТочки.Количество() = 0 Или
		КонтрагентРозничный(Контрагент) Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Выборка = РегистрыСведений.КонтрольПродажиЦеновыхГруппПоРегионам.Выбрать(Новый Структура("ЦеноваяГруппа", ЦеноваяГруппа));
	
	Для Каждого СтрокаТЧ Из Контрагент.ТорговыеТочки Цикл
		
		Пока Выборка.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(Выборка.Монополия) Или
				Выборка.Монополия = Контрагент Тогда
				Продолжить;
			КонецЕсли;
			
			Запрос = Новый Запрос;
			
			Запрос.Текст = 
			
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&Регион В ИЕРАРХИИ (&Регионы) КАК РегионыСвязаны";
			
			
			Запрос.УстановитьПараметр("Регион" , СтрокаТЧ.Регион);
			Запрос.УстановитьПараметр("Регионы", Выборка.Монополия.ТорговыеТочки.ВыгрузитьКолонку("Регион"));
			
			ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
			
			Если ВыборкаЗапроса.Следующий() Тогда
				
				Если ВыборкаЗапроса.РегионыСвязаны Тогда
					
					Возврат "По ценовой группе """ + СокрЛП(ЦеноваяГруппа) + """ закреплена монополия за контрагентом """ + СокрЛП(Выборка.Монополия) + """.
					|Товар не доступен для продажи !";
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ХарактеристикаДоступнаДляПродажи(Характеристика, Контрагент) Экспорт
	
	Если Характеристика = "<без характеристики>" Тогда
		Возврат "";
	КонецЕсли;
	
	ЭтоКомплект = (Характеристика.Владелец.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Комплект);
	
	ЦеноваяГруппа = Характеристика.Владелец.ЦеноваяГруппа;
	
	Если ЭтоКомплект Тогда
		
		Выборка = РегистрыСведений.КомплектующиеНоменклатуры.Выбрать(Новый Структура("ХарактеристикаНоменклатуры", Характеристика));
		
		Если Выборка.Следующий() Тогда
			
			ЦеноваяГруппа = Выборка.Комплектующая.ЦеноваяГруппа;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЦеноваяГруппа) Или
		Контрагент.ТорговыеТочки.Количество() = 0 Или
		КонтрагентРозничный(Контрагент) Тогда
		
		Возврат "";
		
	КонецЕсли;
	
	Выборка = РегистрыСведений.КонтрольПродажиЦеновыхГруппПоРегионам.Выбрать(Новый Структура("ЦеноваяГруппа", ЦеноваяГруппа));
	
	Для Каждого СтрокаТЧ Из Контрагент.ТорговыеТочки Цикл
		
		Пока Выборка.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(Выборка.ОтслеживатьКонкуренцию) Тогда
				Продолжить;
			КонецЕсли;
			
			Запрос = Новый Запрос;
			
			Запрос.Текст = 
			
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	&Регион1 В ИЕРАРХИИ (&Регион2) КАК РегионыСвязаны";
			
			
			Запрос.УстановитьПараметр("Регион1", СтрокаТЧ.Регион);
			Запрос.УстановитьПараметр("Регион2", Выборка.ОтслеживатьКонкуренцию);
			
			ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
			
			Если ВыборкаЗапроса.Следующий() Тогда
				
				Если ВыборкаЗапроса.РегионыСвязаны Тогда
					
					Если ЭтоКомплект Тогда
						
						ТаблицаКомплектующих = Новый ТаблицаЗначений;
						
						ТаблицаКомплектующих.Колонки.Добавить("ХарактеристикаКомплектующей");
						
						ПолучитьКомплектующиеНК(Характеристика, ТаблицаКомплектующих);
						
						ТаблицаКомплектующих.Свернуть("ХарактеристикаКомплектующей");
						
						Характеристики = ТаблицаКомплектующих.ВыгрузитьКолонку("ХарактеристикаКомплектующей");
						
					Иначе
						
						Характеристики = Новый Массив;
						
						Характеристики.Добавить(Характеристика);
						
					КонецЕсли;
					
					Запрос = Новый Запрос;
					
					Запрос.Текст = 
					
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ПродажиОбороты.Контрагент КАК Контрагент,
					|	СУММА(ПродажиОбороты.КоличествоОборот) КАК Количество
					|ИЗ
					|	РегистрНакопления.Продажи.Обороты(
					|			,
					|			,
					|			,
					|			ХарактеристикаНоменклатуры В (&Характеристики)
					|				И Контрагент <> &Контрагент) КАК ПродажиОбороты
					|
					|СГРУППИРОВАТЬ ПО
					|	ПродажиОбороты.Контрагент
					|
					|ИМЕЮЩИЕ
					|	СУММА(ПродажиОбороты.КоличествоОборот) > 0
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Контрагент,
					|	СУММА(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток)
					|ИЗ
					|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
					|			,
					|			ХарактеристикаНоменклатуры В (&Характеристики)
					|				И ДокументРезерва.Контрагент <> &Контрагент) КАК ТоварыВРезервеНаСкладахОстатки
					|
					|СГРУППИРОВАТЬ ПО
					|	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Контрагент
					|
					|ИМЕЮЩИЕ
					|	СУММА(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток) > 0";
					
					
					Запрос.УстановитьПараметр("Характеристики", Характеристики);
					Запрос.УстановитьПараметр("Контрагент"    , Контрагент);
					
					ВыборкаЗапроса = Запрос.Выполнить().Выбрать();
					
					Пока ВыборкаЗапроса.Следующий() Цикл
						
						Если ВыборкаЗапроса.Контрагент.ТорговыеТочки.Количество() = 0 Или
							КонтрагентРозничный(ВыборкаЗапроса.Контрагент) Тогда
							Продолжить;
						КонецЕсли;
						
						Для Каждого ТорговаяТочка Из ВыборкаЗапроса.Контрагент.ТорговыеТочки Цикл
							
							Запрос = Новый Запрос;
							
							Запрос.Текст = 
							
							"ВЫБРАТЬ РАЗРЕШЕННЫЕ
							|	&Регион1 В ИЕРАРХИИ (&Регион2) КАК РегионыСвязаны";
							
							
							Запрос.УстановитьПараметр("Регион1", ТорговаяТочка.Регион);
							Запрос.УстановитьПараметр("Регион2", Выборка.ОтслеживатьКонкуренцию);
							
							ВыборкаРегионы = Запрос.Выполнить().Выбрать();
							
							Если ВыборкаРегионы.Следующий() Тогда
								
								Если ВыборкаРегионы.РегионыСвязаны Тогда
									
									Возврат "По ценовой группе """ + СокрЛП(ЦеноваяГруппа) + """ ведется отслеживание конкуренции по региону """ + СокрЛП(Выборка.ОтслеживатьКонкуренцию) + """.
									|Товар """ + СокрЛП(Характеристика.Владелец) + "(" + СокрЛП(Характеристика) + ")" + """ уже отгружен или находится в резерве для покупателя """ + СокрЛП(ВыборкаЗапроса.Контрагент) + """.
									|Товар не доступен для продажи !";
									
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Процедура ПолучитьУровеньВИерархии(УровеньЭлемента, Элемент) Экспорт
	
	УровеньЭлемента = УровеньЭлемента + 1;
	
	Родитель = Элемент.Родитель;
	
	Если Родитель.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ПолучитьУровеньВИерархии(УровеньЭлемента, Родитель);
	
КонецПроцедуры

Процедура ПолучитьВсехРодителейЭлемента(МассивРодителей, Элемент) Экспорт
	
	Родитель = Элемент.Родитель;
	
	Если Родитель.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	МассивРодителей.Добавить(Родитель);
	
	ПолучитьВсехРодителейЭлемента(МассивРодителей, Родитель);
	
КонецПроцедуры


Функция НайтиДокументПоБанковскойОперации(Операция, Дата = Неопределено) Экспорт
	
	// Универсальный поиск существующего платёжного документа,
	// чтобы не создавать платежи повторно.
	// Вариант 1 — передана структура банковской операции (модуль БанковскиеВыписки):
	//   поиск и по входящим, и по исходящим (по направлению операции).
	// Вариант 2 — переданы код (НомерВходящегоДокумента) и дата (вызовы из формы
	//   Приват24 для входящего платежа): возвращаем существующее
	//   ПлатежноеПоручениеВходящее либо пустую ссылку.
	
	Если ТипЗнч(Операция) = Тип("Структура")
		Или ТипЗнч(Операция) = Тип("Соответствие") Тогда
		
		Возврат НайтиДокументПоСтруктуреОперации(Операция);
		
	КонецЕсли;
	
	Ссылка = НайтиВходящийБанковскийПлатеж(
		СокрЛП(Строка(Операция)),
		Дата);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	// Поступление могло быть оформлено переводом между своими счетами
	// (выплата WayForPay) — ищем и среди исходящих платежей.
	Ссылка = НайтиПлатежноеПоручениеИсходящееПоОперации(
		СокрЛП(Строка(Операция)),
		Дата);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;

	Возврат Документы.ПлатежноеПоручениеВходящее.ПустаяСсылка();

КонецФункции


Функция НайтиДокументПоСтруктуреОперации(
	БанковскаяОперация) Экспорт
	
	Если БанковскаяОперация = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИдентификаторОперации = "";
	ДатаОперации          = Неопределено;
	ЭтоВходящийПлатеж     = Ложь;
	
	Если Не БанковскаяОперация.Свойство(
		"Идентификатор",
		ИдентификаторОперации) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если Не БанковскаяОперация.Свойство(
		"Дата",
		ДатаОперации) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если Не БанковскаяОперация.Свойство(
		"Входящий",
		ЭтоВходящийПлатеж) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ИдентификаторОперации =
		СокрЛП(Строка(ИдентификаторОперации));
	
	Если ПустаяСтрока(ИдентификаторОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЭтоВходящийПлатеж Тогда

		Ссылка = НайтиВходящийБанковскийПлатеж(
			ИдентификаторОперации,
			ДатаОперации);

		Если ЗначениеЗаполнено(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;

		// Выплата WayForPay оформляется исходящим платежом
		// (перевод между своими счетами) — ищем и его.
		Возврат НайтиПлатежноеПоручениеИсходящееПоОперации(
			ИдентификаторОперации,
			ДатаОперации);

	Иначе
		
		Возврат НайтиИсходящийБанковскийПлатеж(
			ИдентификаторОперации,
			ДатаОперации);
		
	КонецЕсли;
	
КонецФункции


Функция НайтиВходящийБанковскийПлатеж(
	ИдентификаторОперации,
	ДатаОперации) Экспорт
	
	Если ПустаяСтрока(
		СокрЛП(Строка(ИдентификаторОперации))) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаОперации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НачалоПериода =
		НачалоДня(
			ДатаОперации - 2 * 24 * 60 * 60);
	
	КонецПериода =
		КонецДня(
			ДатаОперации + 2 * 24 * 60 * 60);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлатежноеПоручениеВходящее.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ПлатежноеПоручениеВходящее
	|		КАК ПлатежноеПоручениеВходящее
	|ГДЕ
	|	НЕ ПлатежноеПоручениеВходящее.ПометкаУдаления
	|	И ПлатежноеПоручениеВходящее.НомерВходящегоДокумента
	|		= &ИдентификаторОперации
	|	И ПлатежноеПоручениеВходящее.Дата
	|		МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПлатежноеПоручениеВходящее.Дата УБЫВ";
	
	Запрос.УстановитьПараметр(
		"ИдентификаторОперации",
		СокрЛП(Строка(ИдентификаторОперации)));
	
	Запрос.УстановитьПараметр(
		"НачалоПериода",
		НачалоПериода);
	
	Запрос.УстановитьПараметр(
		"КонецПериода",
		КонецПериода);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции


Функция НайтиИсходящийБанковскийПлатеж(
	ИдентификаторОперации,
	ДатаОперации) Экспорт
	
	ДокументОплаты =
		НайтиПлатежноеПоручениеИсходящееПоОперации(
			ИдентификаторОперации,
			ДатаОперации);
	
	Если ЗначениеЗаполнено(ДокументОплаты) Тогда
		Возврат ДокументОплаты;
	КонецЕсли;
	
	ДокументОплаты =
		НайтиКассовыйОрдерПоБанковскойОперации(
			ИдентификаторОперации,
			ДатаОперации);
	
	Возврат ДокументОплаты;
	
КонецФункции


