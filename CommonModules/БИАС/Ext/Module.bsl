Процедура ЗаполнитьРезерв(Документ, ЗаказПокупателя, СтрНоменклатуры, СхемаРезервирования, МасИсклЗак = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Склад КАК Склад,
	|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
	|	СУММА(ВложенныйЗапрос.КоличествоОстаток) КАК Количество
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТоварыВРезервеНаСкладахОстатки.Склад КАК Склад,
	|		ТоварыВРезервеНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|		-ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	|	ИЗ
	|		РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|				,
	|				НЕ Склад В (&Склады)
	|					И НЕ ДокументРезерва В (&ДокументРезерва)
	|					И ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ТоварыВРезервеНаСкладахОстатки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТоварыНаСкладахОстатки.Склад,
	|		ТоварыНаСкладахОстатки.Номенклатура,
	|		ТоварыНаСкладахОстатки.КоличествоОстаток
	|	ИЗ
	|		РегистрНакопления.ТоварыНаСкладах.Остатки(, НЕ Склад В (&Склады)) КАК ТоварыНаСкладахОстатки
	|	ГДЕ
	|		ТоварыНаСкладахОстатки.ХарактеристикаНоменклатуры = &ХарактеристикаНоменклатуры) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.Склад
	|
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ";
	
	
	Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры", СтрНоменклатуры.ХарактеристикаНоменклатуры);
	Запрос.УстановитьПараметр("Склады"                    , СхемаРезервирования.Склады.ВыгрузитьКолонку("Склад"));
	Запрос.УстановитьПараметр("ДокументРезерва"           , МасИсклЗак);
	
	РезОстатков = Запрос.Выполнить().Выгрузить();
	
	Скл             = Неопределено;
	Зарезервировано = 0;
	
	Если ЗначениеЗаполнено(СхемаРезервирования) И СхемаРезервирования.Склады.Количество() > 0 Тогда
		
		Для Каждого Стр Из СхемаРезервирования.Склады Цикл
			
			Если Зарезервировано >= СтрНоменклатуры.Количество Тогда
				Продолжить;
			КонецЕсли;
			
			МасСкл = Новый Массив;
			
			МасСкл.Добавить(Стр.Склад);
			
			Ост = ОбщегоНазначения.ОстатокНоменклатуры(СтрНоменклатуры.Номенклатура, МасСкл, СтрНоменклатуры.ХарактеристикаНоменклатуры, ТекущаяДата());
			Рез = ОбщегоНазначения.РезервНоменклатуры (СтрНоменклатуры.Номенклатура, МасСкл, СтрНоменклатуры.ХарактеристикаНоменклатуры, ТекущаяДата(), ЗаказПокупателя, МасИсклЗак);
			
			Наличие = Ост - Рез;
			
			Если Наличие > 0 Тогда
				
				Если Наличие < СтрНоменклатуры.Количество - Зарезервировано Тогда
					
					НС = Документ.Товары.Добавить();
					
					ЗаполнитьЗначенияСвойств(НС, СтрНоменклатуры);
					
					НС.СкладРезерва = Стр.Склад;
					НС.Количество   = Наличие;
					
					Зарезервировано = Зарезервировано + НС.Количество;
					
				Иначе
					
					НС = Документ.Товары.Добавить();
					
					ЗаполнитьЗначенияСвойств(НС, СтрНоменклатуры);
					
					НС.СкладРезерва = Стр.Склад;
					НС.Количество   = СтрНоменклатуры.Количество - Зарезервировано;
					
					Зарезервировано = Зарезервировано + НС.Количество;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Зарезервировано < СтрНоменклатуры.Количество Тогда
			
			НС = Документ.Товары.Добавить();
			
			ЗаполнитьЗначенияСвойств(НС, СтрНоменклатуры);
			
			НС.СкладРезерва = СхемаРезервирования.Склады[СхемаРезервирования.Склады.Количество() - 1].Склад;
			НС.Количество   = СтрНоменклатуры.Количество - Зарезервировано;
			
			Зарезервировано = Зарезервировано + НС.Количество;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Зарезервировано < СтрНоменклатуры.Количество Тогда
		
		Для Каждого Стр Из РезОстатков Цикл
			
			Если Зарезервировано >= СтрНоменклатуры.Количество Тогда
				Продолжить;
			КонецЕсли;
			
			Если Стр.Количество > 0 Тогда
				
				Если Стр.Количество < СтрНоменклатуры.Количество - Зарезервировано Тогда
					
					НС = Документ.Товары.Добавить();
					
					ЗаполнитьЗначенияСвойств(НС, СтрНоменклатуры);
					
					НС.СкладРезерва = Стр.Склад;
					НС.Количество   = Стр.Количество;
					
					Зарезервировано = Зарезервировано + НС.Количество;
					
				Иначе
					
					НС = Документ.Товары.Добавить();
					
					ЗаполнитьЗначенияСвойств(НС, СтрНоменклатуры);
					
					НС.СкладРезерва = Стр.Склад;
					НС.Количество   = СтрНоменклатуры.Количество - Зарезервировано;
					
					Зарезервировано = Зарезервировано + НС.Количество;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Зарезервировано < СтрНоменклатуры.Количество И РезОстатков.Количество() > 0 Тогда
			
			НС = Документ.Товары.Добавить();
			
			ЗаполнитьЗначенияСвойств(НС, СтрНоменклатуры);
			
			НС.СкладРезерва = РезОстатков[0].Склад;
			НС.Количество   = СтрНоменклатуры.Количество - Зарезервировано;
			
			Зарезервировано = Зарезервировано + НС.Количество;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЗакрепленныйРезерв(ЗаказПокупателя, Характеристика, Номенклатура) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры КАК Характеристика,
	|	СУММА(ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(
	|			&Дата,
	|			(ДокументРезерва, Номенклатура, ХарактеристикаНоменклатуры, НК) В
	|				(ВЫБРАТЬ
	|					ЗакрепленныеРезервы.ЗаказПокупателя,
	|					ЗакрепленныеРезервы.Номенклатура,
	|					ЗакрепленныеРезервы.ХарактеристикаНоменклатуры,
	|					ЗакрепленныеРезервы.НК
	|				ИЗ
	|					РегистрСведений.ЗакрепленныеРезервы КАК ЗакрепленныеРезервы
	|				ГДЕ
	|					ЗакрепленныеРезервы.ЗаказПокупателя <> &ЗаказПокупателя И
	|                   ЗакрепленныеРезервы.Номенклатура = &Номенклатура И 
	|					ЗакрепленныеРезервы.ХарактеристикаНоменклатуры = &Характеристика)) КАК ТоварыВРезервеНаСкладахОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыВРезервеНаСкладахОстатки.ХарактеристикаНоменклатуры";
	
	Запрос.УстановитьПараметр("Дата"           , ТекущаяДата());
	Запрос.УстановитьПараметр("ЗаказПокупателя"   , ЗаказПокупателя);
	Запрос.УстановитьПараметр("Номенклатура"   , Номенклатура);
	Запрос.УстановитьПараметр("Характеристика" , Характеристика);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Остаток;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли;
	
КонецФункции

