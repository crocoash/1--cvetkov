Процедура ЗагрузкаБанковскихВыписок() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		
		Организация =
			Справочники.Организации.НайтиПоКоду("000000001");
		
		Если Не ЗначениеЗаполнено(Организация) Тогда
			
			Сообщить(
				"Загрузка банковских выписок: "
				+ "не найдена организация с кодом 000000001.");
			
			Возврат;
			
		КонецЕсли;
		
		ПараметрыЗагрузки =
			СформироватьПараметрыЗагрузкиБанковскихВыписок(
				Организация);
		
		Если ПараметрыЗагрузки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		БанковскиеВыписки.ЗагрузитьБанковскиеВыписки(
			ПараметрыЗагрузки);
		
	Исключение
		
		Сообщить(
			"Ошибка регламентной загрузки банковских выписок: "
			+ ОписаниеОшибки());
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция СформироватьПараметрыЗагрузкиБанковскихВыписок(
	Организация) Экспорт
	
	НачалоПериода =
		Константы.Приват24НачалПериод.Получить();
	
	НачалоПериодаРучное =
		Константы.Приват24НачалПериодРучной.Получить();
	
	Если ЗначениеЗаполнено(НачалоПериодаРучное) Тогда
		
		ДатаНачала = НачалоДня(НачалоПериодаРучное);
		
	ИначеЕсли ЗначениеЗаполнено(НачалоПериода) Тогда
		
		ДатаНачала = НачалоДня(НачалоПериода);
		
	Иначе
		
		ДатаНачала =
			НачалоДня(
				ТекущаяДата() - 2 * 24 * 60 * 60);
		
	КонецЕсли;
	
	ДатаКонца = КонецДня(ТекущаяДата());
	
	Если ДатаНачала > ДатаКонца Тогда
		
		Сообщить(
			"Загрузка банковских выписок: "
			+ "дата начала периода больше даты окончания.");
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Параметры = Новый Структура;
	
	Параметры.Вставить(
		"Организация",
		Организация);
	
	Параметры.Вставить(
		"ДатаНачала",
		ДатаНачала);
	
	Параметры.Вставить(
		"ДатаКонца",
		ДатаКонца);
	
	Параметры.Вставить(
		"ТочностьСуммы",
		0);
	
	Параметры.Вставить(
		"ТочностьПроцент",
		0);
	
	Возврат Параметры;
	
КонецФункции
////////////////////////////////////////////////////////////////////////////////
// ПРИЁМ ОПЛАТЫ ПО СИГНАЛУ САЙТА
//
// Регламент «Загрузка Приват24» ходит за выпиской по расписанию, и оплата
// лежит непринятой до следующего захода. Сайт же узнаёт об успешном платеже
// сразу — в серверном callback WayForPay (assets/shop/wayforpay_service.php,
// статус Approved). Оттуда он и дёргает эту работу через HTTP-сервис
// ТелеграмВебхук, действие "pay".
//
// Делается ровно то же, что по расписанию, и в том же порядке:
//   1. заказы с сайта — платёж легко обгоняет свой заказ, а без заказа
//      поступление не с чем сопоставить;
//   2. выписка — а в ней автопроведение подобранных платежей и задача
//      менеджерам (см. общий модуль БанковскиеВыписки).
//
// Расписание регламента остаётся страховкой: сигнал не дошёл, база была
// недоступна, платёж ещё не появился в выписке банка — очередной заход
// подберёт всё то же самое.
//

// Запускает приём оплаты фоновым заданием и сразу возвращает управление:
// сайту нельзя ждать, пока 1С сходит в банк, — WayForPay ретраит callback.
//
// Возвращает строку состояния для ответа сайту:
//   "started"         - задание запущено;
//   "already_running" - приём уже идёт, ему передан сигнал повторить прогон;
//   "error"           - запустить не удалось, подробности в журнале.
//
Функция ЗапуститьПриемОплатыПоСигналуСайта(Знач Реф = "") Экспорт

	ИмяМетода   = "БИАС.ПринятьОплатуПоСигналуСайта";
	КлючЗадания = "ПриемОплатыПоСигналуСайта";

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		Отбор = Новый Структура;
		Отбор.Вставить("Ключ"     , КлючЗадания);
		Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);

		Активные = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);

	Исключение

		// Отбор не отработал — считаем, что активных нет, и пробуем запустить:
		// занятый ключ всё равно отобьётся исключением ниже.
		Активные = Новый Массив;

	КонецПопытки;

	Если Активные.Количество() > 0 Тогда

		// Приём уже идёт. Второе задание с тем же ключом платформа не пустит,
		// да оно и не нужно: помечаем, что после текущего прогона нужен ещё
		// один, — иначе платёж, пришедший в банк уже после того, как активное
		// задание забрало выписку, ждал бы расписания.
		УстановитьПризнакПовторногоСигнала(Истина);

		Возврат "already_running";

	КонецЕсли;

	Попытка

		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(Реф);

		ФоновыеЗадания.Выполнить(
			ИмяМетода,
			ПараметрыЗадания,
			КлючЗадания,
			"Приём оплаты по сигналу сайта"
				+ ?(ПустаяСтрока(Реф), "", ": " + Лев(Реф, 50)));

		Возврат "started";

	Исключение

		ЗаписьЖурналаРегистрации(
			"Сайт.Оплата",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось запустить приём оплаты по сигналу сайта: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		Возврат "error";

	КонецПопытки;

КонецФункции


// Тело фонового задания. Вызывается только из
// ЗапуститьПриемОплатыПоСигналуСайта.
//
Процедура ПринятьОплатуПоСигналуСайта(Знач Реф = "") Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ЗаписьЖурналаРегистрации(
		"Сайт.Оплата",
		УровеньЖурналаРегистрации.Информация,
		,
		,
		"Сигнал сайта об оплате" + ?(ПустаяСтрока(Реф), "", ": " + Лев(Реф, 100))
		+ ". Загружаем заказы и выписку, не дожидаясь расписания.");

	// Признак снимаем в начале: всё, что просигналили ДО этого момента,
	// закрывает текущий прогон.
	УстановитьПризнакПовторногоСигнала(Ложь);

	МаксимумПрогонов = 3;
	Прогон           = 0;

	Пока Прогон < МаксимумПрогонов Цикл

		Прогон = Прогон + 1;

		Попытка

			ЗагрузкаЗаказовНашСайт();

		Исключение

			ЗаписьЖурналаРегистрации(
				"Сайт.Оплата",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"Заказы с сайта по сигналу об оплате не загружены: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

		Попытка

			ЗагрузкаБанковскихВыписок();

		Исключение

			ЗаписьЖурналаРегистрации(
				"Сайт.Оплата",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"Выписка по сигналу об оплате не загружена: "
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		КонецПопытки;

		// Пока ходили в банк, пришёл ещё один сигнал — его платёж мог не успеть
		// в только что забранную выписку. Повторяем, но не бесконечно.
		Если Не ПолучитьПризнакПовторногоСигнала() Тогда
			Прервать;
		КонецЕсли;

		УстановитьПризнакПовторногоСигнала(Ложь);

	КонецЦикла;

КонецПроцедуры


// Признак «пока шёл приём, пришёл ещё сигнал». Лежит там же, где очередь
// платежей, — в хранилище общих настроек, чтобы его видели и веб-сеанс
// HTTP-сервиса, и сеанс фонового задания.
//
Процедура УстановитьПризнакПовторногоСигнала(Знач Значение)

	Попытка

		ХранилищеОбщихНастроек.Сохранить(
			"ОбменПриват24",
			"ПовторныйСигналОплаты",
			Значение,
			,
			"Пользователь");

	Исключение
	КонецПопытки;

КонецПроцедуры


Функция ПолучитьПризнакПовторногоСигнала()

	Попытка

		Значение =
			ХранилищеОбщихНастроек.Загрузить(
				"ОбменПриват24",
				"ПовторныйСигналОплаты",
				,
				"Пользователь");

	Исключение

		Возврат Ложь;

	КонецПопытки;

	Возврат Значение = Истина;

КонецФункции


// Заметка с сайта в комментарий заказа. Пишет её экран выбора оплаты: клиент
// вместо оплаты попросил связаться с менеджером (shop/plugin.ajax.php, case
// "order_ask"). Карточка менеджеру уходит в Telegram сразу, но в самом заказе
// следа не оставалось: в 1С такой заказ ничем не отличался от брошенного молча,
// а смотрят именно туда.
//
// Работа уходит в фон по той же причине, что и приём оплаты: заказ создан
// секунды назад и в 1С мог ещё не приехать, а ждёт ответа клиент в открытом
// окне браузера.
//
// Параметры:
//  НомерСайта - Строка - номер заказа на сайте;
//  Текст      - Строка - строка, которую дописываем в комментарий.
//
// Возвращаемое значение:
//  Строка - "started" либо "error".
//
Функция ЗапуститьЗаписьЗаметкиВЗаказ(Знач НомерСайта, Знач Текст) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Попытка

		ПараметрыЗадания = Новый Массив;
		ПараметрыЗадания.Добавить(СокрЛП(Строка(НомерСайта)));
		ПараметрыЗадания.Добавить(СокрЛП(Строка(Текст)));

		// Ключ задания намеренно пустой. С ключом второе задание по тому же
		// заказу платформа отбросила бы МОЛЧА, а клиент вполне может сначала
		// уйти в Telegram, а следом попросить звонок - это две разные заметки.
		ФоновыеЗадания.Выполнить(
			"БИАС.ЗаписатьЗаметкуВЗаказПоСигналуСайта",
			ПараметрыЗадания,
			,
			"Заметка с сайта в заказ № " + Лев(СокрЛП(Строка(НомерСайта)), 20));

		Возврат "started";

	Исключение

		ЗаписьЖурналаРегистрации(
			"Сайт.Заметка",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось запустить запись заметки в заказ № "
			+ Лев(СокрЛП(Строка(НомерСайта)), 20) + ": "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		Возврат "error";

	КонецПопытки;

КонецФункции


// Тело фонового задания. Вызывается только из ЗапуститьЗаписьЗаметкиВЗаказ.
//
Процедура ЗаписатьЗаметкуВЗаказПоСигналуСайта(Знач НомерСайта, Знач Текст) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ПустаяСтрока(НомерСайта) Или ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	МаксимумПрогонов = 3;
	Прогон           = 0;

	Пока Прогон < МаксимумПрогонов Цикл

		Прогон = Прогон + 1;

		// ВключаяПомеченные = Истина: помеченный на удаление заказ - тоже заказ,
		// и заметка о звонке в нём нужна не меньше.
		Заказ = ОбщегоНазначения.ЗаказПоНомеруЗаказаССайта(НомерСайта, Истина);

		Если ЗначениеЗаполнено(Заказ) Тогда
			ДописатьЗаметкуВКомментарийЗаказа(Заказ, Текст);
			Возврат;
		КонецЕсли;

		// Заказа ещё нет: файл ушёл на FTP минуту назад и ждёт расписания.
		// Забираем заказы сами - ровно как приём оплаты по сигналу сайта.
		Если Прогон < МаксимумПрогонов Тогда

			Попытка

				ЗагрузкаЗаказовНашСайт();

			Исключение

				ЗаписьЖурналаРегистрации(
					"Сайт.Заметка",
					УровеньЖурналаРегистрации.Ошибка,
					,
					,
					"Заказы с сайта под заметку не загружены: "
					+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

				Прервать;

			КонецПопытки;

		КонецЕсли;

	КонецЦикла;

	ЗаписьЖурналаРегистрации(
		"Сайт.Заметка",
		УровеньЖурналаРегистрации.Предупреждение,
		,
		,
		"Заказ № " + Лев(НомерСайта, 20) + " в базе не найден, заметка не записана: "
		+ Лев(Текст, 200));

КонецПроцедуры


// Дописать строку в комментарий заказа отдельным абзацем, не трогая то, что там
// уже есть: комментарий пишет покупатель, и затирать его нельзя.
//
Процедура ДописатьЗаметкуВКомментарийЗаказа(Знач Заказ, Знач Текст)

	Попытка

		Объект = Заказ.ПолучитьОбъект();

		Если Объект = Неопределено Тогда

			ЗаписьЖурналаРегистрации(
				"Сайт.Заметка",
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Документы.ЗаказПокупателя,
				Заказ,
				"Заказ удалён из базы, заметка не записана: " + Лев(Текст, 200));

			Возврат;

		КонецЕсли;

		Было = СокрЛП(Объект.Комментарий);

		// Повторный клик по той же кнопке - не повод дублировать строку. Текст
		// заметки поэтому постоянный, без времени: со временем каждый повтор
		// выглядел бы новым.
		Если Найти(Было, Текст) > 0 Тогда
			Возврат;
		КонецЕсли;

		Объект.Комментарий = ?(ПустаяСтрока(Было), Текст, Было + Символы.ПС + Текст);

		// Режим записи - обычная запись: проведённый заказ остаётся проведённым,
		// движения не пересчитываются. Так же пишется номер накладной с сайта.
		Объект.Записать();

	Исключение

		ЗаписьЖурналаРегистрации(
			"Сайт.Заметка",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Документы.ЗаказПокупателя,
			Заказ,
			"Заметка не записана: " + Лев(Текст, 200) + ". "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		Возврат;

	КонецПопытки;

	ЗаписьЖурналаРегистрации(
		"Сайт.Заметка",
		УровеньЖурналаРегистрации.Информация,
		Метаданные.Документы.ЗаказПокупателя,
		Заказ,
		"В комментарий дописано с сайта: " + Лев(Текст, 200));

КонецПроцедуры


Процедура Реализация_ПерепровестиЗаказы(Параметр) Экспорт
	
	МассивЗаказов = Параметр.МассивЗаказов;
	
	Для Каждого Заказ Из МассивЗаказов Цикл
		
		ЗаказОбъект = Заказ.ПолучитьОбъект();
		
		ЗаказОбъект.Резервировано = Ложь;
		
		ЗаказОбъект.ДополнительныеСвойства.Вставить("НеВыгружатьЗаказНаСайт");
		
		РежимЗаписи = ?(ЗаказОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
		
		Попытка
			ЗаказОбъект.Записать(РежимЗаписи);
		Исключение
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция КодироватьПараметрPOST(Значение) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
	
КонецФункции


Функция УведомитьСайтОРезерве(Контрагент, ТекстУведомления = "") Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	КодКонтрагента = СокрЛП(Контрагент.Код);
	
	Если ПустаяСтрока(КодКонтрагента) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	URL = "https://cvetkovtm.com/assets/shop/cron_reserve_notify.php";
	Токен = "e4cfdff6ad370ca2f0e26d8eb82bcda9";
	
	ТелоЗапроса = "token=" + КодироватьПараметрPOST(Токен)
	+ "&code=" + КодироватьПараметрPOST(КодКонтрагента);
	
	Если Не ПустаяСтрока(ТекстУведомления) Тогда
		ТелоЗапроса = ТелоЗапроса + "&text=" + КодироватьПараметрPOST(ТекстУведомления);
	КонецЕсли;
	
	Попытка
		
		HTTP = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");
		HTTP.Open("POST", URL, Ложь);
		HTTP.SetRequestHeader("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
		HTTP.SetRequestHeader("Accept", "application/json, text/plain, */*");
		HTTP.SetTimeouts(15000, 15000, 30000, 30000);
		HTTP.Send(ТелоЗапроса);
		
		КодСостояния = Число(HTTP.Status);
		ОтветСервера = Строка(HTTP.ResponseText);
		
		Если КодСостояния < 200 Или КодСостояния >= 300 Тогда
			
			ЗаписьЖурналаРегистрации(
			"БИАС.УведомлениеСайта",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Контрагент,
			"HTTP " + Строка(КодСостояния)
			+ ", код контрагента: " + КодКонтрагента
			+ ", ответ: " + ОтветСервера
			);
			
			Возврат Ложь;
			
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(
		"БИАС.УведомлениеСайта",
		УровеньЖурналаРегистрации.Информация,
		,
		Контрагент,
		"Уведомление отправлено. Код: " + КодКонтрагента
		+ ", текст: " + ТекстУведомления
		+ ", ответ: " + ОтветСервера
		);
		
		Возврат Истина;
		
	Исключение
		
		ЗаписьЖурналаРегистрации(
		"БИАС.УведомлениеСайта",
		УровеньЖурналаРегистрации.Ошибка,
		,
		Контрагент,
		"Ошибка POST-запроса. Код: " + КодКонтрагента
		+ ", ошибка: " + ОписаниеОшибки()
		);
		
		Возврат Ложь;
		
	КонецПопытки;
	
КонецФункции


Процедура УведомитьСайтОдинРаз(ОтправленныеУведомления, Контрагент, ИдентификаторСобытия, ТекстУведомления) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;
	
	КлючУведомления = СокрЛП(Контрагент.Код) + "_" + ИдентификаторСобытия;
	
	Если ОтправленныеУведомления.Получить(КлючУведомления) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если УведомитьСайтОРезерве(Контрагент, ТекстУведомления) Тогда
		ОтправленныеУведомления.Вставить(КлючУведомления, Истина);
	КонецЕсли;
	
КонецПроцедуры


Процедура ПроверкаЗадачь() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Рез = ПолучитьЗаказы();
	ТабСтатусы = ОбщегоНазначения.СтатусыДнейВСтатусе();
	
	// Признак розницы считаем один раз на заказ, а не в каждом витке по статусам:
	// правила задач и уведомлений у розницы и остальных заказов разные
	// (карточка статуса, закладки "Розница" / "Остальные").
	Рез.Колонки.Добавить("ЭтоРозница", Новый ОписаниеТипов("Булево"));

	Для Каждого Стр Из Рез Цикл
		Стр.ДнейВСтатусе = Документы.ЗаказПокупателя.ДнейВСтатусе(Стр.Ссылка);
		Стр.ЭтоРозница   = ТелеграмБот.ЭтоРозничныйЗаказ(Стр.Ссылка);
	КонецЦикла;
	
	УжеБылКонтрагент = Новый СписокЗначений;
	ОтправленныеУведомленияСайту = Новый Соответствие;
	
	Для Каждого Стат Из ТабСтатусы Цикл
		
		Для Каждого Зак Из Рез Цикл
			
			Контрагент = Зак.Ссылка.Контрагент;
			Исполнитель = Неопределено;
			СтатусПредоплаты = "";
			ИдентификаторСобытия = "ПросрочкаСтатуса_" + Стат.Статус.Код;
			ЭтоРозница = Зак.ЭтоРозница;

			// Считаем, что клиент подписан на Telegram,
			// если у контрагента заполнено поле РассылкаТГ.
			КлиентПодписанНаТелеграм = ЗначениеЗаполнено(Контрагент.РассылкаТГ);

			// Порог просрочки: по рознице он может быть свой. 0 в розничном
			// реквизите - работает общий (см. карточку статуса, закладка "Розница").
			ПорогДней = Стат.ДнейВСтатусе;

			Если ЭтоРозница И Стат.ДнейВСтатусеРозница <> 0 Тогда
				ПорогДней = Стат.ДнейВСтатусеРозница;
			КонецЕсли;

			// Статус попал в выборку из-за порога для другого класса заказов -
			// по этому заказу срока просрочки нет вовсе.
			Если ПорогДней = 0 Тогда
				Продолжить;
			КонецЕсли;

			Если ЭтоРозница
				И ЗначениеЗаполнено(Стат.Статус.ПользовательПросрочкиРозница) Тогда

				Исполнитель = Стат.Статус.ПользовательПросрочкиРозница;

			ИначеЕсли ЗначениеЗаполнено(Стат.Статус.Пользователь1) Тогда
				
				Исполнитель = Стат.Статус.Пользователь1;
				
			ИначеЕсли ЗначениеЗаполнено(Стат.Статус.ЗадачаГруппеПользователей) Тогда
				
				Исполнитель = Стат.Статус.ЗадачаГруппеПользователей;
				
			ИначеЕсли Стат.Статус.ФормироватьЗадачуНаОтветственного
				И ЗначениеЗаполнено(Зак.Ссылка.Ответственный) Тогда
				
				Исполнитель = Зак.Ссылка.Ответственный;
				
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(Зак.Ссылка.СтатусЗаказа)
				Или (
					Зак.Ссылка.СтатусЗаказа =
					Справочники.СтатусыЗаказов.НайтиПоНаименованию("ЦБ не получена")
					И (
						СтрЧислоВхождений(
							Зак.Ссылка.СтатусОтправки,
							"Відправлення"
						) > 0
						Или СтрЧислоВхождений(
							Зак.Ссылка.СтатусОтправки,
							"Прибув"
						) > 0
					)
				) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Если Зак.ДнейВСтатусе <> Неопределено
				И Зак.ДнейВСтатусе >= ПорогДней
				И Зак.Ссылка.СтатусЗаказа = Стат.Статус Тогда
				
				СуществующаяЗадача = Неопределено;
				
				СтатусПредоплаты =
					Документы.ЗаказПокупателя.СтатусПредоплаты(Контрагент);
				
				СоздаватьНовуюЗадачуПоЗаказу =
					Контрагент.Родитель.СоздаватьНовуюЗадачуПоЗаказу;
				
				Если СоздаватьНовуюЗадачуПоЗаказу Тогда
					
					СуществующаяЗадача =
						ПолучитьЗадачуЗаказаПоИдентификатору(
							Зак.Ссылка,
							ИдентификаторСобытия,
							Исполнитель
						);
					
				Иначе
					
					СуществующаяЗадача =
						ПолучитьЗадачуКонтрагентаПоИдентификатору(
							Контрагент,
							ИдентификаторСобытия,
							Исполнитель
						);
					
				КонецЕсли;
				
				СтатусПредоплаты = ?(
					СоздаватьНовуюЗадачуПоЗаказу,
					Зак.Ссылка.ТипЦен.Наименование,
					СтатусПредоплаты
				);
				
				Если ЗначениеЗаполнено(Исполнитель) Тогда
					
					Резерв =
						Документы.ЗаказПокупателя.РезервПоЗаказуОстаток(
							?(
								СоздаватьНовуюЗадачуПоЗаказу,
								Зак.Ссылка,
								Контрагент
							)
						);
					
					Оформление = ОфрмлениеСтроки(Резерв);
					
					ТекущееКолВоТоваровНаСкладеРозы =
						КолВоТоваровНаСкладеРозы(Резерв);
					
					НужноУведомитьСайт = Ложь;
					ТекстУведомленияСайта = "";

					// Telegram-уведомление привязано к задаче: одна задача - одно
					// сообщение, иначе менеджер получал бы его каждый прогон регламента.
					// Повтор отсекается не только этим признаком, но и историей
					// отправок - см. условие отправки ниже.
					ЭтоНоваяЗадача = Не ЗначениеЗаполнено(СуществующаяЗадача);

					Если Не ЗначениеЗаполнено(СуществующаяЗадача) Тогда
						
						Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();
						
						Задача.ИдентификаторСобытия = ИдентификаторСобытия;

						// "Телеграм" в задаче - показывать ли заказ карточкой в чате.
						// У статусов, где карточка идёт по галке (настройка
						// ТелеграмТолькоПоГалкеЗадачи), новая задача заводится БЕЗ
						// неё: менеджер сам решает, кого показать. У остальных
						// статусов галка стоит сразу - всё как раньше.
						Задача.Телеграм = Не Стат.Статус.ТелеграмТолькоПоГалкеЗадачи;

						Задача.Наименование = Строка(Контрагент);
						Задача.СтатусЗаказа =
							Зак.Ссылка.СтатусЗаказа.Наименование;
						Задача.Исполнитель = Исполнитель;
						Задача.СтатусПоФакту = СтатусПредоплаты;
						Задача.Дата = НачалоДня(ТекущаяДата()) + 32400;
						Задача.Объект = Зак.Ссылка;
						Задача.Оповещение = Истина;
						Задача.СрокОповещения = Задача.Дата;
						Задача.СрокИсполнения = Задача.Дата;
						
						Задача.КолВоТоваровНаСкладеРозы =
							ТекущееКолВоТоваровНаСкладеРозы;
						
						Задача.Оформление = Оформление;
						
						Если КлиентПодписанНаТелеграм Тогда
							
							Задача.ДопИнформация =
								"✅ Клієнт підписаний на Telegram-бота."
								+ Символы.ПС
								+ "Повідомлення клієнту вручну надсилати не потрібно."
								+ Символы.ПС
								+ "Telegram: "
								+ Строка(Контрагент.РассылкаТГ);
							
						Иначе
							
							Задача.ДопИнформация =
								"⚠️ Клієнт не підписаний на Telegram-бота."
								+ Символы.ПС
								+ "При необхідності повідомлення потрібно надіслати у Viber.";
							
						КонецЕсли;
						
						Если ИдентификаторСобытия =
							"ПросрочкаСтатуса_000000002" Тогда

							Задача.Описание = "Задержка Отправки";

							ТекстУведомленияСайта =
								"Ми затримуємо відправлення. "
								+ "Перепрошуємо, працюємо над цим.";

							НужноУведомитьСайт = Истина;

						КонецЕсли;
						
					Иначе
						
						Задача = СуществующаяЗадача.ПолучитьОбъект();
						
						Если Не СоздаватьНовуюЗадачуПоЗаказу Тогда
							Задача.Объект = Зак.Ссылка;
						КонецЕсли;
						
						Если УжеБылКонтрагент.НайтиПоЗначению(Контрагент)
							= Неопределено Тогда
							
							ПредыдущееКоличествоГотового =
								Задача.КолВоТоваровНаСкладеРозы;
							
							Если ПредыдущееКоличествоГотового
								< ТекущееКолВоТоваровНаСкладеРозы Тогда
								
								ВсегоРезерв = Резерв.Итог("Количество");
								
								ДобавленоГотового =
									ТекущееКолВоТоваровНаСкладеРозы
									- ПредыдущееКоличествоГотового;
								
								ТекстИзмененияГотовности =
									"Виготовилось +"
									+ Строка(ДобавленоГотового)
									+ " шт з "
									+ Строка(ВсегоРезерв);

								ПосиланняНаРахунок =
									"https://cvetkovtm.com/assets/shop/sync/reserves/invoice_"
									+ Контрагент.Код
									+ ".html";
								
								Если КлиентПодписанНаТелеграм Тогда
									
									// Менеджеру не создаём отдельное оповещение.
									// В задаче только показываем информацию.
									Задача.Оповещение = Истина ;  // изменить когда оттестим 
									
									Задача.Описание =
										" КЛІЄНТ ОТРИМУЄ СПОВІЩЕННЯ У TELEGRAM"
										+ Символы.ПС
										+ "Повідомлення у Viber надсилати не потрібно."
										+ Символы.ПС
										+ "Готово: "
										+ Строка(ТекущееКолВоТоваровНаСкладеРозы)
										+ " із "
										+ Строка(ВсегоРезерв)
										+ " товарів."
										+ Символы.ПС
										+ Символы.ПС
										+ ТекстИзмененияГотовности
										+ Символы.ПС
										+ Задача.Описание;
									
									Задача.ДопИнформация =
										"✅ Telegram підключений: "
										+ Строка(Контрагент.РассылкаТГ);
									
								Иначе
									
									// Клиент не подписан на Telegram.
									// Напоминаем менеджеру и даём готовый текст для Viber.
									Задача.Оповещение = Истина;
									
									Задача.СрокОповещения =
										НачалоДня(ТекущаяДата())
										+ 9 * 60 * 60;
									
									Если ТекущееКолВоТоваровНаСкладеРозы
										>= ВсегоРезерв Тогда
										
										ТекстДляВайбер =
											"✅ Добрий день!"
											+ Символы.ПС
											+ Символы.ПС
											+ "Ваше замовлення повністю готове "
											+ "до відправлення."
											+ Символы.ПС
											+ Символы.ПС
											+ "Щоб автоматично отримувати повідомлення "
											+ "про відправлення, доставку та статус "
											+ "Ваших наступних замовлень, підпишіться "
											+ "на наш Telegram-бот:"
											+ Символы.ПС
											+ Символы.ПС
											+ " t.me/Cvetkovbot";
										
									Иначе
										
										ТекстДляВайбер =
											" Добрий день!"
											+ Символы.ПС
											+ Символы.ПС
											+ "До відправлення вже готово "
											+ Строка(
												ТекущееКолВоТоваровНаСкладеРозы
											)
											+ " із "
											+ Строка(ВсегоРезерв)
											+ " товарів Вашого замовлення."
											+ Символы.ПС
											+ Символы.ПС
											+ "Щоб надалі автоматично отримувати "
											+ "повідомлення про готовність замовлення, "
											+ "відправлення та доставку без очікування "
											+ "дзвінка чи повідомлення менеджера, "
											+ "підпишіться на наш Telegram-бот:"
											+ Символы.ПС
											+ Символы.ПС
											+ " t.me/Cvetkovbot";
										
									КонецЕсли;
									
									Задача.Описание =
										ОбщегоНазначения.ТелефонКонтрагента(Контрагент)
										+ Символы.ПС
										+ Символы.ПС
										+ ТекстДляВайбер
										+ Символы.ПС
										+ Символы.ПС
										+ "--------------------"
										+ Символы.ПС
										+ ТекстИзмененияГотовности
										+ Символы.ПС
										+ "Рахунок: "
										+ ПосиланняНаРахунок
										+ Символы.ПС
										+ Задача.Описание;
									
									Задача.ДопИнформация =
										"⚠️ Telegram не підключений. "
										+ "Скопіюйте текст із опису та надішліть у Viber.";
									
								КонецЕсли;
								
								Если ТекущееКолВоТоваровНаСкладеРозы
									>= ВсегоРезерв Тогда
									
									ТекстУведомленияСайта =
										"Ваше замовлення повністю готове "
										+ "до відправлення.";
									
								Иначе
									
									ТекстУведомленияСайта =
										"До відправлення вже готово "
										+ Строка(
											ТекущееКолВоТоваровНаСкладеРозы
										)
										+ " із "
										+ Строка(ВсегоРезерв)
										+ " товарів.";
									
								КонецЕсли;
								
								НужноУведомитьСайт = Истина;
								
							КонецЕсли;
							
							Задача.КолВоТоваровНаСкладеРозы =
								ТекущееКолВоТоваровНаСкладеРозы;
							
							Задача.СтатусПоФакту = СтатусПредоплаты;
							Задача.Оформление = Оформление;
							
							Если КлиентПодписанНаТелеграм Тогда
								
								Задача.ДопИнформация =
									"✅ Клієнт підписаний на Telegram-бота."
									+ Символы.ПС
									+ "Повідомлення у Viber надсилати не потрібно."
									+ Символы.ПС
									+ "Telegram: "
									+ Строка(Контрагент.РассылкаТГ);
								
							ИначеЕсли ПустаяСтрока(Задача.ДопИнформация) Тогда
								
								Задача.ДопИнформация =
									"⚠️ Telegram не підключений."
									+ Символы.ПС
									+ "Повідомлення клієнту потрібно надіслати у Viber.";
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
					Если УжеБылКонтрагент.НайтиПоЗначению(Контрагент)
						= Неопределено Тогда
						
						УжеБылКонтрагент.Добавить(Контрагент);
						
					КонецЕсли;
					
					ЗадачаЗаписана = ЗаписатьЗадачу(Задача);

					// Уведомление менеджеру в Telegram: номер заказа, товар, оплата,
					// получатель и телефон для звонка. Настраивается в статусе заказа,
					// закладка "Телеграм", группа 1 "Заказ завис в этом статусе":
					// достаточно заполнить "Чаты напоминаний" (можно несколько через
					// запятую), галка "Напоминать менеджеру в Telegram" - равноценный
					// признак. Группа 2 (карточка при смене статуса) сюда не относится. Задача передаётся, чтобы кнопка "Обработан" под
					// сообщением проставила дату обработки именно в неё.
					//
					// Ночью в Telegram не пишем: ДнейВСтатусе считается целыми сутками
					// и перещёлкивает ровно в полночь, поэтому вся пачка просроченных
					// падала бы менеджеру в 00:0x. Задачу при этом создаём как обычно,
					// а сообщение уходит первым прогоном после 9:00 - такую задачу
					// узнаём по признаку "свежая, а записи в истории отправок по ней
					// нет" (ТелеграмБот.ЗадачаУведомлена).
					//
					// Окно "свежести" - со вчерашнего начала дня: у задачи Дата всегда
					// НачалоДня + 9 часов, так что вечерняя задача (создана после 21:00)
					// на следующее утро в границы попадает, а прошлые - нет, и лавины
					// старых уведомлений не будет.
					//
					// По "Ожидает оплаты" сообщение уходит ТОЛЬКО с галкой "Телеграм"
					// в самой задаче - см. ЗадачаРазрешаетТелеграм.
					Если ЗадачаЗаписана
						И ТелеграмБот.РабочееВремя()
						И ТелеграмБот.СтатусУведомляет(Стат.Статус, ЭтоРозница)
						И ЗадачаРазрешаетТелеграм(Задача, Стат.Статус)
						И (ЭтоНоваяЗадача
							Или (Задача.Дата >= НачалоДня(ТекущаяДата() - 86400)
								И Не ТелеграмБот.ЗадачаУведомлена(Задача.Ссылка))) Тогда

						Попытка
							ТелеграмБот.УведомитьОЗаказе(Зак.Ссылка, Стат.Статус, "", Задача.Ссылка);
						Исключение
							// Telegram не должен ронять проверку задач.
							ЗаписьЖурналаРегистрации("Телеграм.Ошибка",
								УровеньЖурналаРегистрации.Ошибка,
								Метаданные.Документы.ЗаказПокупателя,
								Зак.Ссылка,
								ОписаниеОшибки());
						КонецПопытки;

					КонецЕсли;

					// Клиента уведомляем, только если задача реально создалась
					// или в неё добавился текст. Иначе менеджер не увидит,
					// о чём клиенту уже сообщили.
					Если НужноУведомитьСайт И ЗадачаЗаписана Тогда

						УведомитьСайтОдинРаз(
							ОтправленныеУведомленияСайту,
							Контрагент,
							ИдентификаторСобытия,
							ТекстУведомленияСайта
						);

					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ЕстьЗадачаСнятРезерв =
				БИАС.ПолучитьЗадачуКонтрагентаПоИдентификатору(
					Контрагент,
					"Снят Резерв",
					Исполнитель
				);
			
			Если Не ЗначениеЗаполнено(Зак.Ссылка.СхемаРезервирования)
				И Не ЗначениеЗаполнено(ЕстьЗадачаСнятРезерв) Тогда
				
				Если ПустаяСтрока(СтатусПредоплаты) Тогда
					
					СтатусПредоплаты =
						Документы.ЗаказПокупателя.СтатусПредоплаты(
							Контрагент
						);
					
				КонецЕсли;
				
				Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();
				
				Задача.ИдентификаторСобытия = "Снят Резерв";
				Задача.Дата = НачалоДня(ТекущаяДата()) + 32400;
				Задача.Наименование = Строка(Контрагент);
				Задача.СтатусПоФакту = СтатусПредоплаты;
				Задача.Объект = Зак.Ссылка;
				Задача.Описание = "Снят Резерв";
				Задача.Исполнитель = Исполнитель;
				Задача.Оповещение = Истина;
				Задача.СрокОповещения = Задача.Дата;
				Задача.СрокИсполнения =
					Задача.Дата + 24 * 60 * 60;
				
				Если КлиентПодписанНаТелеграм Тогда
					
					Задача.ДопИнформация =
						"✅ Клієнт підписаний на Telegram-бота."
						+ Символы.ПС
						+ "Telegram: "
						+ Строка(Контрагент.РассылкаТГ);
					
				Иначе
					
					Задача.ДопИнформация =
						"⚠️ Telegram не підключений.";
					
				КонецЕсли;
				
				// Уведомляем клиента только если задача менеджеру создалась.
				Если ЗаписатьЗадачу(Задача) Тогда

					УведомитьСайтОдинРаз(
						ОтправленныеУведомленияСайту,
						Контрагент,
						"СнятРезерв",
						"⚠️ Резерв більше не активний. "
						+ "Якщо замовлення ще актуальне — зв'яжіться з нами."
					);

				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Пускать ли напоминание по этой задаче в Telegram.
//
// У статуса есть галка "Телеграм только с галкой в задаче" (закладка "Телеграм").
// Стоит она - решает НЕ расписание, а человек: галка "Телеграм" в форме самой
// задачи. Нет галки в задаче - задача создаётся и напоминает как обычно, но
// в чат ничего не уходит. Снята настройка у статуса - работает как раньше,
// безусловно.
//
// Заведено под "Ожидает оплаты" (18.08.2026): в нём одновременно висят десятки
// заказов, и чат от них заплывал. Ту же настройку читает жизнь карточки в чате -
// ТелеграмБот.ЕстьАктуальнаяЗадача.
//
// Параметры:
//  Задача - ЗадачаОбъект.ЗадачиПользователя - уже записанная задача.
//  Статус - СправочникСсылка.СтатусыЗаказов - статус, по просрочке которого задача.
//
// Возвращаемое значение:
//  Булево - отправка разрешена.
//
Функция ЗадачаРазрешаетТелеграм(Знач Задача, Знач Статус)

	Если Не ЗначениеЗаполнено(Статус)
		Или Не Статус.ТелеграмТолькоПоГалкеЗадачи Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Задача.Телеграм = Истина;

КонецФункции


функция ОфрмлениеСтроки(ВсеРезервы)
	
	Розы 		      = Справочники.Склады.НайтиПоКоду("000000014");
	Державинская = Справочники.Склады.НайтиПоКоду("000000038");
	
	ЕстьРозы          = Ложь;
	ЕстьДругиеСклады  = Ложь;
	
	Если ВсеРезервы = Неопределено Тогда
		Возврат 3
	КонецЕсли;
	
	Для Каждого Стр Из ВсеРезервы Цикл
		
		Если Стр.Склад = Розы ИЛИ
			Стр.Склад = Державинская
			Тогда
			ЕстьРозы = Истина;
		Иначе
			ЕстьДругиеСклады = Истина;
		КонецЕсли;		
		
	КонецЦикла;		
	
	Если ЕстьДругиеСклады Тогда 
		Если ЕстьРозы Тогда
			Возврат 1
		Иначе 
			Возврат 0
		КонецЕсли;
	Иначе 
		Возврат 2
	КонецЕсли;
	
КонецФункции

функция КолВоТоваровНаСкладеРозы(ВсеРезервы)
	
	Розы = Справочники.Склады.НайтиПоКоду("000000014");
	Державинская = Справочники.Склады.НайтиПоКоду("000000038");
	//ДержавинскаяАлена = Справочники.Склады.НайтиПоКоду("000000063");
	
	КолВоТоваровНаСкладеРозы = 0;
	
	Если ВсеРезервы.Количество() = 0 Тогда
		Возврат 0
	КонецЕсли;
	
	Для Каждого Стр Из ВсеРезервы Цикл
		
		Если Стр.ДокументРезерва.Ссылка.Дата > НачалоДня(ТекущаяДата()) Тогда
			Продолжить;	
		КонецЕсли;
		
		Если Стр.Склад = Розы ИЛИ 
			Стр.Склад = Державинская  
			// ИЛИ Стр.Склад = ДержавинскаяАлена
			Тогда
			КолВоТоваровНаСкладеРозы = КолВоТоваровНаСкладеРозы + Стр.Количество;
		КонецЕсли;		
		
	КонецЦикла;		
	
	Возврат КолВоТоваровНаСкладеРозы	
КонецФункции

функция ПолучитьЗаказы()

	ТабСтатусы = ОбщегоНазначения.СтатусыДнейВСтатусе();

	Запрос = Новый Запрос;

	// Подзаказы из задач исключены: это технические строки-довески к реализации
	// или возврату (номер вида "27159/1"), резерв и статус ведутся по основному
	// заказу, поэтому задача менеджеру по подзаказу - мусор.
	// Критерий тот же, что в ЗаказПокупателяЭтоПодЗаказ и ЗаказПокупателя.ЭтоПодЗаказ:
	// ОсновнойЗаказ заполнен НЕ заказом покупателя И в номере есть "/".
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка КАК Ссылка,
	|	0 КАК ДнейВСтатусе
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	НЕ ЗаказПокупателя.ПометкаУдаления
	|	И ЗаказПокупателя.Дата МЕЖДУ &НачДата И &КонДата
	|	И НЕ (ЗаказПокупателя.Номер ПОДОБНО ""%/%""
	|			И (ЗаказПокупателя.ОсновнойЗаказ ССЫЛКА Документ.РеализацияТоваровУслуг
	|				ИЛИ ЗаказПокупателя.ОсновнойЗаказ ССЫЛКА Документ.ВозвратТоваровОтПокупателя))
	|	И НЕ ЗаказПокупателя.ИзРеализации
	|	И ЗаказПокупателя.СтатусЗаказа В(&СтатусЗаказа)
	|УПОРЯДОЧИТЬ ПО
	| 	Номер ВОЗР";
	
	
	Запрос.УстановитьПараметр("НачДата",ДобавитьМесяц(ТекущаяДата(),-12));
	Запрос.УстановитьПараметр("КонДата",ТекущаяДата());
	Запрос.УстановитьПараметр("СтатусЗаказа",ТабСтатусы.ВыгрузитьКолонку("Статус"));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ОтменитьЗадачи() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос  = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗадачиПользователя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
	|ГДЕ
	|	НЕ ЗадачиПользователя.Выполнена";
	
	ВсеЗадачи = Запрос.Выполнить().Выгрузить();
	
	Для Каждого ЗадачаСсылка Из ВсеЗадачи Цикл
		
		Задача = ЗадачаСсылка.Ссылка.ПолучитьОбъект();
		
		Если НЕ ТипЗнч(Задача.Объект) = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
			Продолжить;
		КонецЕсли;

		// Задачи по подзаказам больше не создаются (см. ПолучитьЗаказы),
		// но заведённые ранее закрываем: по подзаказу менеджеру делать нечего.
		Если ЗаказПокупателяЭтоПодЗаказ(Задача.Объект) Тогда
			Задача.Описание = "автозакрытие подзаказ" + Символы.ПС + Задача.Описание;
			Задача.Выполнена = Истина;
			ЗаписатьЗадачу(Задача);
			Продолжить;
		КонецЕсли;

		ОснованиеЗадачи = Задача.Объект;
		ОснованиеЗадачиЗаказСатусЗаказа = ОснованиеЗадачи.СтатусЗаказа.Наименование;
		
		Контрагент = ОснованиеЗадачи.Контрагент;
		ВсеЗаказыКонтрагента = ПолучитьЗаказы1(Контрагент); 
		
		//Задачи из задач
		
		Заказ = ОснованиеЗадачи.Ссылка;
		
		Если ЗначениеЗаполнено(ОснованиеЗадачи) И
			ОбщегоНазначения.ЕстьРеквизитДокумента("Контрагент", ОснованиеЗадачи.Метаданные())
			Тогда 
			
			Если Задача.ИдентификаторСобытия = "самостійно створив" ИЛИ 
				Задача.ИдентификаторСобытия = "ОшибкаНаложкиСтатусПоТТН!!!" ИЛИ
				Задача.ИдентификаторСобытия = "Видалено" Или
				Задача.ИдентификаторСобытия = "Змінено адресу"
				Тогда
				Если (Задача.ИдентификаторСобытия = "самостійно створив" И
					Заказ.СтатусОтправки = "Відправник самостійно створив цю накладну, але ще не надав до відправки") ИЛИ
					(Заказ.СтатусОтправки = "Видалено" И Задача.ИдентификаторСобытия = "Видалено")
					Тогда
					Продолжить;
				Иначе
					Задача.Описание = "автозакрытие" + Символы.ПС + Задача.Описание;
					Задача.Выполнена = Истина;
					ЗаписатьЗадачу(Задача);
				КонецЕсли;
			КонецЕсли;
			
			Если Задача.ИдентификаторСобытия = "Снят Резерв" Тогда
				Если Заказ.СхемаРезервирования.Наименование <> "" Тогда
					Задача.Описание = "автозакрытие Снят Резерв";
					Задача.Выполнена = Истина;
					ЗаписатьЗадачу(Задача);	
				Иначе 
					Продолжить;
				КонецЕсли;	
				Продолжить;
			КонецЕсли;
			
			Если ОснованиеЗадачиЗаказСатусЗаказа = "Не удачные" И
				Задача.ИдентификаторСобытия = "ИзменениеСтатуса" И
				Задача.Наименование = "Не удачные"
				Тогда
				Продолжить;
			ИначеЕсли ОснованиеЗадачиЗаказСатусЗаказа = "На возврате" И
				Задача.ИдентификаторСобытия = "ИзменениеСтатуса" И
				Задача.Наименование = "На возврате"
				Тогда
				Продолжить;
			ИначеЕсли Лев(Задача.Наименование,24) = "Количество дней хранения" Тогда 
				
				Если СтрЧислоВхождений(ОснованиеЗадачи.СтатусОтправки,"Відправлення отримано") > 0 Тогда
					Задача.Описание = "автозакрытие Количество дней хранения" + Символы.ПС + Задача.Описание;	
					Задача.Выполнена = Истина;
					ЗаписатьЗадачу(Задача);
				КонецЕсли;
				
			ИначеЕсли Задача.ИдентификаторСобытия = "ПросрочкаСтатуса_000000003" И
				(ОснованиеЗадачиЗаказСатусЗаказа <> "ЦБ не получена" Или
				СтрЧислоВхождений(ОснованиеЗадачи.СтатусОтправки,"Відправлення отримано")>0)
				Тогда
				Задача.Описание = "автозакрытие Цб не получена" + Символы.ПС + Задача.Описание;
				Задача.Выполнена = Истина;    // ===
				ЗаписатьЗадачу(Задача);
				
			ИначеЕсли Контрагент.Родитель.СоздаватьНовуюЗадачуПоЗаказу Тогда	 
				
				// Если заказ уже не в продано
				Если ОснованиеЗадачиЗаказСатусЗаказа <> "Продано"  И
					Задача.Наименование = "Продано" 
					Тогда
					Задача.Выполнена = Истина;    // ===
					Задача.Описание = "автозакрытие Продано" + Символы.ПС + Задача.Описание;
					ЗаписатьЗадачу(Задача);
				КонецЕсли;
				
				Если ОснованиеЗадачиЗаказСатусЗаказа <> "Резерв"  И
					Задача.ИдентификаторСобытия = "ПросрочкаСтатуса_000000001" 
					Тогда
					Задача.Выполнена = Истина;    // ===
					Задача.Описание = "автозакрытие Резерв" + Символы.ПС + Задача.Описание;
					ЗаписатьЗадачу(Задача);
				КонецЕсли;
				
				Если ОснованиеЗадачиЗаказСатусЗаказа <> "Ожидает оплаты" И
					Задача.ИдентификаторСобытия = "ПросрочкаСтатуса_000000005"
					Тогда
					Задача.Выполнена = Истина;    // ===
					Задача.Описание = "автозакрытие Ожидает оплаты" + Символы.ПС + Задача.Описание;
					ЗаписатьЗадачу(Задача);
					
				КонецЕсли;
				
				Если ОснованиеЗадачиЗаказСатусЗаказа <> "Ожидает отправки" И
					Задача.ИдентификаторСобытия = "ПросрочкаСтатуса_000000002"
					Тогда
					Задача.Выполнена = Истина;    // ===
					Задача.Описание = "автозакрытие Ожидает отправки" + Символы.ПС + Задача.Описание;
					ЗаписатьЗадачу(Задача);
				КонецЕсли;
				
				//Если Задача.ИдентификаторСобытия = "ПросрочкаСтатуса_000000003" И
				//	 (ОснованиеЗадачиЗаказСатусЗаказа <> "Цб не получена" Или
				//	 СтрЧислоВхождений(ОснованиеЗадачи.СтатусОтправки,"Відправлення отримано")>0)
				//	Тогда
				//	 Задача.Описание = "автозакрытие Цб не получена" + Символы.ПС + Задача.Описание;
				//КонецЕсли;	
				
				ЗаписатьЗадачу(Задача);
				
			Иначе 
				
				Если Не ЗначениеЗаполнено(Задача.ИдентификаторСобытия) Тогда
					Продолжить;
				КонецЕсли;
				
				
				//Проверять существующие заказы на этот статус 
				
				КолВоЗаказовВЭтомСтатусе = 0;
				
				//Проверяем наличие заказов по статусу этой задачи
				Для Каждого ЗаказСсылка Из ВсеЗаказыКонтрагента Цикл
					Заказ = ЗаказСсылка.Ссылка;
					
					Если ЗначениеЗаполнено(Задача.СтатусЗаказа) Тогда 
						Если Задача.СтатусЗаказа = Заказ.СтатусЗаказа.Наименование Тогда
							КолВоЗаказовВЭтомСтатусе = КолВоЗаказовВЭтомСтатусе + 1;
						КонецЕсли;
					Иначе
						Если Задача.Наименование = Заказ.СтатусЗаказа.Наименование Тогда
							КолВоЗаказовВЭтомСтатусе = КолВоЗаказовВЭтомСтатусе + 1;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				
				Если КолВоЗаказовВЭтомСтатусе = 0 Тогда
					Задача.Выполнена = Истина;    // ===
					Задача.Описание = "автозакрытие!" + Символы.ПС + Задача.Описание;
					ЗаписатьЗадачу(Задача);
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// Вслед за закрытием задач приводим в порядок и Telegram: у заказов,
	// вышедших из работы, карточки убираются из всех чатов, у активных без
	// единой живой карточки - восстанавливаются. То же самое регламентно
	// делает ТелеграмОбмен, но после массового автозакрытия чат должен
	// очиститься сразу, а не через его следующий прогон.
	Попытка
		ТелеграмБот.СинхронизироватьКарточки();
	Исключение
		ЗаписьЖурналаРегистрации("Телеграм.Ошибка",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Синхронизация карточек после закрытия задач не выполнена: "
			+ ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Регламентное задание "ОбновитьНовоуПочту": города и отделения Новой Почты.
//
// ЗАЧЕМ ключ из константы. Реквизит КлючAPI обработки заполняется только в её форме
// (процедура ВосстановитьКлюч модуля формы). Обработке, созданной из кода, заполнить его
// некому, и регламент уходил в Новую Почту с пустым apiKey - то есть не работал вовсе.
//
// ЗАЧЕМ города перед отделениями. Отделение подчинено городу: пока нового города нет
// в справочнике, его отделения складывать некуда, и они просто пропадают из загрузки.
// Раньше регламент дёргал только отделения, так что новые города не появлялись никогда.
Процедура ОбновитьНовоуПочту() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	КлючAPI = СокрЛП(Константы.ЛМ_КлючAPI.Получить());
	Если ПустаяСтрока(КлючAPI) Тогда
		ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Не заполнена константа ЛМ_КлючAPI - обновление городов и отделений пропущено");
		Возврат;
	КонецЕсли;

	ОбработкаВыгрузки = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.Создать();
	ОбработкаВыгрузки.КлючAPI = КлючAPI;

	Попытка
		ОбработкаВыгрузки.ПолучитьТаблицуОбластей();
		ОбработкаВыгрузки.СохранитьОбласти();
	Исключение
		ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Области не обновлены: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		ОбработкаВыгрузки.ПолучитьТаблицуГородов();
		Если ОбработкаВыгрузки.СохранитьГорода() Тогда
			ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
				УровеньЖурналаРегистрации.Информация, , ,
				"Города обновлены, получено от Новой Почты: " + ОбработкаВыгрузки.Города.Количество());
		Иначе
			ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				"Новая Почта не вернула города - справочник оставлен как есть");
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Города не обновлены: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		ОбработкаВыгрузки.ПолучитьТаблицуОтделений();
		Если ОбработкаВыгрузки.СохранитьОтделения() Тогда
			ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
				УровеньЖурналаРегистрации.Информация, , ,
				"Отделения обновлены, получено от Новой Почты: " + ОбработкаВыгрузки.Отделения.Количество());
		Иначе
			ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				"Новая Почта не вернула отделения - справочник оставлен как есть");
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации("НоваяПочта.Обновление",
			УровеньЖурналаРегистрации.Ошибка, , ,
			"Отделения не обновлены: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Записывает задачу.
// Возвращает Истина, если задача действительно записалась.
// Уведомление клиенту отправляем только по Истина:
// не должно быть ситуации "клиент получил сообщение, а задачи у менеджера нет".
// Запись задачи. Если в объекте ничего не поменялось - не пишем вовсе.
//
// ЗАЧЕМ проверка. У открытой формы задачи платформа помнит версию записи, и
// любая запись со стороны эту версию поднимает: менеджер, который держал задачу
// открытой (звонил клиенту, писал в вайбер), на "Записать" получает
// "Операция не может быть выполнена из-за несоответствия версии или отсутствия
// записи базы данных" и теряет правку. А вхолостую мы писали задачи постоянно:
// регламент ОтменитьЗадачи проходит по ВСЕМ незакрытым задачам и в конце ветки
// записывает каждую, даже когда не тронул в ней ни одного поля, а ПроверкаЗадачь
// каждый прогон заново присваивает ДопИнформацию, статус и оформление теми же
// значениями. Сколько задача проживёт открытой, столько же она и была уязвима.
функция ЗаписатьЗадачу(Задача)

	Если Не ЗадачаИзменилась(Задача) Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Задача.Записать();
		Возврат Истина;
	Исключение

		Сообщить(ОписаниеОшибки());

		ЗаписьЖурналаРегистрации(
		"БИАС.ЗаписьЗадачи",
		УровеньЖурналаРегистрации.Ошибка,
		,
		Задача.Объект,
		"Не удалось записать задачу """ + Строка(Задача.ИдентификаторСобытия)
		+ """ по " + Строка(Задача.Наименование)
		+ ". Ошибка: " + ОписаниеОшибки()
		);

		Возврат Ложь;

	КонецПопытки;
КонецФункции

// Отличается ли задача в памяти от того, что лежит в базе.
//
// Сравниваем все реквизиты, реквизит адресации (Исполнитель) и те стандартные
// поля, которые правит наш код. Читаем объект заново, а не через реквизиты
// ссылки: кэш ссылки в сеансе может быть старше базы, и тогда мы пропустили бы
// нужную запись.
//
// Прочитать не удалось или задачи уже нет - считаем изменённой: решение оставляем
// за Записать(), поведение остаётся прежним (ошибка попадёт в журнал регистрации).
функция ЗадачаИзменилась(Задача)

	Если Задача.ЭтоНовый() Тогда
		Возврат Истина;
	КонецЕсли;

	ВБазе = Неопределено;

	Попытка
		ВБазе = Задача.Ссылка.ПолучитьОбъект();
	Исключение
		Возврат Истина;
	КонецПопытки;

	Если ВБазе = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;

	ОписаниеЗадачи = Метаданные.Задачи.ЗадачиПользователя;

	Для Каждого Реквизит Из ОписаниеЗадачи.Реквизиты Цикл
		Если Задача[Реквизит.Имя] <> ВБазе[Реквизит.Имя] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Реквизит Из ОписаниеЗадачи.РеквизитыАдресации Цикл
		Если Задача[Реквизит.Имя] <> ВБазе[Реквизит.Имя] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Задача.Наименование    <> ВБазе.Наименование
		Или Задача.Дата            <> ВБазе.Дата
		Или Задача.Выполнена       <> ВБазе.Выполнена
		Или Задача.ПометкаУдаления <> ВБазе.ПометкаУдаления;

КонецФункции

функция ПолучитьЗаказы1(Контр)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаказПокупателя.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
	|ГДЕ
	|	НЕ ЗаказПокупателя.ПометкаУдаления
	|	И ЗаказПокупателя.Дата МЕЖДУ &НачДата И &КонДата
	// |	И ЗаказПокупателя.ОсновнойЗаказ = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|    И ЗаказПокупателя.Контрагент = &Контрагент
	|УПОРЯДОЧИТЬ ПО
	| 	Номер ВОЗР";
	
	
	Запрос.УстановитьПараметр("НачДата",ДобавитьМесяц(ТекущаяДата(),-12));
	Запрос.УстановитьПараметр("КонДата",ТекущаяДата());
	Запрос.УстановитьПараметр("Контрагент",Контр);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции


