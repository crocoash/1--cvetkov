Функция ФорматТаблицыПоСигнатуре(Путь)
	Попытка
		ДвоичныеДанные = Новый ДвоичныеДанные(Путь);
		Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения();
		Буфер = Новый БуферДвоичныхДанных(2);
		Прочитано = Поток.Прочитать(Буфер, 0, 2);
		Поток.Закрыть();
		// "PK" (0x50 0x4B) — ZIP-контейнер, т.е. xlsx
		Если Прочитано >= 2 И Буфер[0] = 80 И Буфер[1] = 75 Тогда
			Возврат "xlsx";
		Иначе
			Возврат "xls";
		КонецЕсли;
	Исключение
		Возврат "xlsx";
	КонецПопытки;
КонецФункции	

Процедура ЗагрузкаЗаказовKasta() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Установим соединение
	Соединение = Новый HTTPСоединение("hub.kasta.ua", , , , , , Новый ЗащищенноеСоединениеOpenSSL());
	
	// Создадим новый HTTP-запрос
	Запрос = Новый HTTPЗапрос;
	
	// Токен для авторизации
	Токен = "yoos3dvexefeibew2yas2h9ctovyxj7r6auk87wl";
	
	// Определим дату начала и окончания периода (последние два дня)
	НачалоПериода = Формат(НачалоДня(ТекущаяДата() - 2 * 86400), "ДФ=yyyy-MM-ddTHH:mm:ss");
	КонецПериода = Формат(КонецДня(ТекущаяДата()), "ДФ=yyyy-MM-ddTHH:mm:ss");
	
	// Установим параметры запроса
	Запрос.АдресРесурса = "/api/orders/list?from=" + НачалоПериода + "&to=" + КонецПериода;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", Токен);
	Запрос.Заголовки = Заголовки;
	
	// Отправим запрос и получим ответ
	Ответ = Соединение.Получить(Запрос);
	
	Если Ответ.КодСостояния <> 200 Тогда
		ЗаписьЖурналаРегистрации("Не удалось загрузить заказы с hub.kasta.ua! Код состояния: " + Ответ.КодСостояния, УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецЕсли;
	
	// Обработка ответа
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку();
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТелоОтвета);
	Заказы = ПрочитатьJSON(Чтение, Истина);
	
	Если НЕ ЗначениеЗаполнено(Заказы) Тогда
		ЗаписьЖурналаРегистрации("Получен пустой ответ от hub.kasta.ua", УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецЕсли;
	
	ТЗЗаказы = Новый ТаблицаЗначений;
	ТЗЗаказы.Колонки.Добавить("Номер");
	ТЗЗаказы.Колонки.Добавить("Дата");
	ТЗЗаказы.Колонки.Добавить("АдресДоставки");
	ТЗЗаказы.Колонки.Добавить("СпособОплаты");
	ТЗЗаказы.Колонки.Добавить("Комментарий");
	ТЗЗаказы.Колонки.Добавить("Получатель");
	ТЗЗаказы.Колонки.Добавить("Телефон");
	ТЗЗаказы.Колонки.Добавить("СтатусЗаказа");
	ТЗЗаказы.Колонки.Добавить("ШтрихКод");
	ТЗЗаказы.Колонки.Добавить("Количество");
	ТЗЗаказы.Колонки.Добавить("Счет");
	ТЗЗаказы.Колонки.Добавить("СпособДоставка");
	ТЗЗаказы.Колонки.Добавить("Сумма");	
	ТЗЗаказы.Колонки.Добавить("ГородДоставка");	
	ТЗЗаказы.Колонки.Добавить("Отделение");	
	
	НоваПейКасса = Справочники.БанковскиеСчета.НайтиПоКоду("000000039");
	Расчетный = Справочники.БанковскиеСчета.НайтиПоКоду("000000026");
	
	Для Каждого Заказ Из Заказы["items"] Цикл
		//Если Заказ["statuses"].Количество() > 1 Тогда
		//	 Продолжить;
		// КонецЕсли;
		
		Для Каждого Штрихкод из Заказ["ordered_items"] Цикл 
			
			Отделение = Заказ["shipping_address"]["warehouse"];
			Город     = Заказ["shipping_address"]["city"]["name"];
			СпособОплаты = Заказ["requested_payment_method"];
			Себестоимость =  Штрихкод["supplier_price"];
			
			НоваяСтрока = ТЗЗаказы.Добавить();
			НоваяСтрока.Номер = Заказ["id"];
			НоваяСтрока.Дата = Заказ["created_at"];
			
			НоваяСтрока.СпособОплаты = Заказ["requested_payment_method"];
			НоваяСтрока.Комментарий = СтрСоединить(Заказ["comments"], "; ");
			НоваяСтрока.Получатель = Заказ["shipping_address"]["first_name"] + " " + Заказ["shipping_address"]["last_name"];
			НоваяСтрока.Телефон = Заказ["shipping_address"]["phone"];
			НоваяСтрока.СтатусЗаказа = Заказ["statuses"][0]["type"];
			НоваяСтрока.ШтрихКод = Штрихкод["barcode"][0];
			НоваяСтрока.Количество = Штрихкод["original_quantity"];			
			НоваяСтрока.СпособДоставка = Справочники.СпособыОтправки.НоваяПочта;
			НоваяСтрока.ГородДоставка = Город;
			НоваяСтрока.Отделение = Отделение;
			
			НоваяСтрока.Счет = Расчетный;
			
			Количество = Штрихкод["original_quantity"]; // Количество товаров
			Цена = Штрихкод["new_price"]; // Оплаченная цена за единицу			
			
			Роялти = Цена - Себестоимость; 
			Сумма = Количество * Цена;
			
			НоваяСтрока.Сумма = Сумма;			
			РоялтиПроценты = Роялти * 100 / Сумма; 
			НоваяСтрока.АдресДоставки = ?(СпособОплаты = "card","Проверить оплату","") + Символы.ПС + Символы.ПС + "Себес "+ Себестоимость + Символы.ПС + "Роялти " + Роялти + " " + РоялтиПроценты + " %" ;
			
		КонецЦикла;
	КонецЦикла;
	
	// Обработка заказов в 1С
	Если ТЗЗаказы.Количество() = 0 Тогда
		ЗаписьЖурналаРегистрации("Нет новых заказов за последние два дня.", УровеньЖурналаРегистрации.Информация);
		Возврат;
	КонецЕсли;
	
	
	ТЗНомера = ТЗЗаказы.Скопировать(, "Номер");
	
	ТЗНомера.Свернуть("Номер");
	
	Для Каждого СтрокаТЗНомера Из ТЗНомера Цикл
		ОбработатьЗаказ(СтрокаТЗНомера, ТЗЗаказы, Истина);						
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПолучитьЗадачуКонтрагентаПоИдентификатору(Контрагент, Идентификатор, Исполнитель) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗадачиПользователя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ЗадачиПользователя.Объект ССЫЛКА Справочник.ДоговорыКонтрагентов
	|				ТОГДА ЗадачиПользователя.Объект.Владелец = &Контрагент
	|			КОГДА ЗадачиПользователя.Объект ССЫЛКА Справочник.Контрагенты
	|				ТОГДА ЗадачиПользователя.Объект = &Контрагент
	|			ИНАЧЕ ЗадачиПользователя.Объект.Контрагент = &Контрагент
	|		КОНЕЦ
	|	И НЕ ЗадачиПользователя.Выполнена
	|	И ЗадачиПользователя.ИдентификаторСобытия = &Идентификатор
	|	И ЗадачиПользователя.Исполнитель = &Исполнитель";
	
	
	Запрос.УстановитьПараметр("Контрагент"   , Контрагент);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Запрос.УстановитьПараметр("Исполнитель"  , Исполнитель);
	Запрос.УстановитьПараметр("Выполнена"  , Ложь);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Ссылка;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

