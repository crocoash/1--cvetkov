// Рабочее окно менеджера - 9:00-21:00 по времени сервера. Вне его уведомления
// не отправляются вовсе, а ждут утра (см. шапку модуля). Расписание самих
// регламентов от этого не зависит - оно задаётся в базе; чтобы отложенное ушло,
// ТелеграмОбмен и ПроверкаЗадачь должны крутиться и днём, а не только ночью.
//
// Экспортная: ту же проверку делает БИАС.ПроверкаЗадачь перед отправкой
// уведомления о просрочке статуса.
//
// Возвращаемое значение:
//  Булево - сейчас можно писать менеджеру.
//
Функция РабочееВремя() Экспорт

	ТекущийЧас = Час(ТекущаяДата());

	Возврат ТекущийЧас >= НачалоРабочегоДня() И ТекущийЧас < КонецРабочегоДня();

КонецФункции

// Границы окна отправки, часы. Меняются здесь и сразу действуют на все три повода.
Функция НачалоРабочегоДня()

	Возврат 9;

КонецФункции

Функция КонецРабочегоДня()

	Возврат 21;

КонецФункции

// Уходило ли уже уведомление по этой задаче менеджера.
//
// Источник истины - регистр ТелеграмУведомления: в нём ресурсом лежит ссылка
// на задачу. Нужна, чтобы ночную задачу догнать утром ровно один раз: сразу
// после полуночи ПроверкаЗадачь задачу создаёт, но молчит, а утром видит
// "задача есть, записи в истории нет" и отправляет.
//
// Параметры:
//  Задача - ЗадачаСсылка.ЗадачиПользователя - задача менеджера.
//
// Возвращаемое значение:
//  Булево - по задаче уже писали в Telegram.
//
Функция ЗадачаУведомлена(Знач Задача) Экспорт

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТелеграмУведомления.Заказ КАК Заказ
		|ИЗ
		|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
		|ГДЕ
		|	ТелеграмУведомления.Задача = &Задача";
	Запрос.УстановитьПараметр("Задача", Задача);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Рассылает уведомления о смене статуса, накопившиеся в очереди.
// Отправили - запись удалили. Не смогли (сайт лежит, Telegram недоступен) -
// считаем попытки и после третьей выбрасываем: иначе очередь будет вечно
// крутиться на одном заказе и глушить остальные.
//
// Ночью очередь не разбираем совсем: записи просто лежат до утра. Выходим ДО цикла,
// поэтому счётчик попыток за ночь не растёт и ничего не "сгорает" от простоя.
Процедура РазобратьОчередь()

	Если Не РабочееВремя() Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	ТелеграмОчередь.Заказ КАК Заказ,
		|	ТелеграмОчередь.Статус КАК Статус,
		|	ТелеграмОчередь.Попыток КАК Попыток
		|ИЗ
		|	РегистрСведений.ТелеграмОчередь КАК ТелеграмОчередь
		|УПОРЯДОЧИТЬ ПО
		|	ТелеграмОчередь.ДатаРегистрации";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		// Слать о смене некому (чаты у статуса не заполнены), но карточку
		// убрать надо: заказ уже не в том состоянии, в каком его показали
		// менеджеру. Чат - очередь работы, а не журнал.
		Если ПустаяСтрока(СокрЛП(Строка(Выборка.Статус.ТелеграмЧатСмены))) Тогда

			Попытка
				УбратьКарточкиЗаказа(ТокенБота(), Выборка.Заказ);
			Исключение
				ЗаписатьОшибку(Выборка.Заказ, "Не удалось убрать карточки заказа"
					+ " после смены статуса: " + ОписаниеОшибки());
			КонецПопытки;

			УдалитьИзОчереди(Выборка.Заказ, Выборка.Статус);
			Продолжить;

		КонецЕсли;

		Отправлено = Ложь;

		Попытка
			Отправлено = УведомитьОСменеСтатуса(Выборка.Заказ, Выборка.Статус);
		Исключение
			ЗаписатьОшибку(Выборка.Заказ, "Уведомление о смене статуса не отправлено: "
				+ ОписаниеОшибки());
		КонецПопытки;

		Если Отправлено Тогда

			УдалитьИзОчереди(Выборка.Заказ, Выборка.Статус);

		ИначеЕсли Выборка.Попыток >= 2 Тогда

			ЗаписатьОшибку(Выборка.Заказ, "Уведомление о смене статуса ""сгорело"""
				+ " после трёх попыток - запись убрана из очереди.");

			УдалитьИзОчереди(Выборка.Заказ, Выборка.Статус);

		Иначе

			ОтметитьПопытку(Выборка.Заказ, Выборка.Статус, Выборка.Попыток + 1);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Досылает уведомления о новых заказах с сайта, которые пришли ночью и потому
// не были отправлены сразу (УведомитьОНовомЗаказе вне рабочих часов молчит).
//
// Отдельной очереди для них нет и не нужно: заказ с сайта опознаётся по
// НомерЗаказа2ССайта, а факт отправки - по регистру ТелеграмУведомления.
// Отсюда и окно поиска: 12 часов назад от текущего момента. В 9:00 это ровно
// прошедшая тихая ночь (с 21:00), и старые заказы, по которым уведомление
// когда-то не ушло по другой причине, лавиной не поднимаются.
//
// Не розничные заказы из выборки не отсеиваем запросом - это делает
// УведомитьОНовомЗаказе; они просто молча выпадут из окна через 12 часов.
Процедура ДогнатьНовыеЗаказы()

	Если Не РабочееВремя() Тогда
		Возврат;
	КонецЕсли;

	// Получателя нет вообще ни у кого - выходим молча. Иначе каждый прогон
	// регламента писал бы в журнал "некому отправить" по одним и тем же заказам:
	// они из окна не уходят, пока уведомление не отправлено.
	Если ПустаяСтрока(ЧатНовыхЗаказов())
		И ПустаяСтрока(ПервыйНастроенныйЧат())
		И ПустаяСтрока(ЧатПоУмолчанию()) Тогда

		Возврат;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	ЗаказПокупателя.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	НЕ ЗаказПокупателя.ПометкаУдаления
		|	И ЗаказПокупателя.Дата >= &СДаты
		|	И ЗаказПокупателя.НомерЗаказа2ССайта <> """"
		|	И НЕ ЗаказПокупателя.Ссылка В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ТелеграмУведомления.Заказ КАК Заказ
		|			ИЗ
		|				РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
		|			ГДЕ
		|				ТелеграмУведомления.ВидУведомления = &ВидУведомления)
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказПокупателя.Дата";

	Запрос.УстановитьПараметр("СДаты", ТекущаяДата() - 12 * 3600);
	Запрос.УстановитьПараметр("ВидУведомления", "НовыйЗаказ");

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Попытка
			УведомитьОНовомЗаказе(Выборка.Ссылка);
		Исключение
			ЗаписатьОшибку(Выборка.Ссылка, "Отложенное уведомление о новом заказе"
				+ " не отправлено: " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

Процедура УдалитьИзОчереди(Знач Заказ, Знач Статус)

	Попытка

		Запись = РегистрыСведений.ТелеграмОчередь.СоздатьМенеджерЗаписи();
		Запись.Заказ  = Заказ;
		Запись.Статус = Статус;
		Запись.Удалить();

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось убрать запись из очереди уведомлений: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

Процедура ОтметитьПопытку(Знач Заказ, Знач Статус, Знач Попыток)

	Попытка

		Запись = РегистрыСведений.ТелеграмОчередь.СоздатьМенеджерЗаписи();
		Запись.Заказ  = Заказ;
		Запись.Статус = Статус;
		Запись.Прочитать();

		Если Не Запись.Выбран() Тогда
			Запись.Заказ           = Заказ;
			Запись.Статус          = Статус;
			Запись.ДатаРегистрации = ТекущаяДата();
		КонецЕсли;

		Запись.Попыток = Попыток;
		Запись.Записать(Истина);

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось отметить попытку в очереди уведомлений: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Разбирает реквизит "Телеграм: чаты" в массив chat_id. Разделители - запятая,
// точка с запятой, пробел и перенос строки: менеджер пишет как удобно.
// Дубли убираем - иначе одно и то же сообщение придёт в чат дважды.
Функция ЧатыСписком(Знач Чаты)

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;

	Текст = СокрЛП(Строка(Чаты));

	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Текст = СтрЗаменить(Текст, ";", ",");
	Текст = СтрЗаменить(Текст, Символы.ПС, ",");
	Текст = СтрЗаменить(Текст, Символы.ВК, ",");
	Текст = СтрЗаменить(Текст, Символы.Таб, ",");
	Текст = СтрЗаменить(Текст, " ", ",");

	Для Каждого Часть Из СтрРазделить(Текст, ",", Ложь) Цикл

		Чат = СокрЛП(Часть);

		Если ПустаяСтрока(Чат) Или Добавленные.Получить(Чат) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Добавленные.Вставить(Чат, Истина);
		Результат.Добавить(Чат);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Чаты, настроенные хоть у одного статуса заказов - чтобы уведомление было кому
// отправить, пока для конкретного статуса чаты не заполнены. Может вернуть
// список через запятую - его разбирает ЧатыСписком.
Функция ПервыйНастроенныйЧат()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СтатусыЗаказов.ТелеграмЧат КАК ТелеграмЧат
		|ИЗ
		|	Справочник.СтатусыЗаказов КАК СтатусыЗаказов
		|ГДЕ
		|	СтатусыЗаказов.ОтправлятьВТелеграм
		|	И СтатусыЗаказов.ТелеграмЧат <> """"
		|	И НЕ СтатусыЗаказов.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	СтатусыЗаказов.Код";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.ТелеграмЧат));
	КонецЕсли;

	Возврат "";

КонецФункции

// Разметка кнопок под сообщением: "Статус" и "Обработан".
// В callback_data уезжает уникальный идентификатор заказа - по нему
// ПолучитьОтветы() находит заказ. Лимит Telegram на callback_data - 64 байта,
// префикс + UUID укладываются в 39.
//
// Параметры:
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ.
//  Обработан - Булево - кнопка обработки уже нажата: вместо действия показываем
//              отметку. Кнопка "Статус" при этом остаётся рабочей.
//  Отметка   - Строка - что писать на кнопке вместо "Обработан".
//
Функция КлавиатураЗаказа(Знач Заказ, Знач Обработан = Ложь, Знач Отметка = "")

	Идентификатор = Строка(Заказ.УникальныйИдентификатор());

	// На кнопке пишем сам статус, а не слово "Статус": так его видно сразу,
	// не нажимая, а нажатие просто обновляет надпись. Эмодзи 🔄 оставляем -
	// по нему понятно, что кнопка рабочая, а не подпись.
	//
	// Надпись - статус НА МОМЕНТ отправки сообщения, ровно как и его текст;
	// свежий подтянется нажатием. Лимит Telegram на подпись - 64 символа.
	ТекущийСтатус = СокрЛП(Строка(Заказ.СтатусЗаказа));

	КнопкаСтатуса = Новый Структура;
	КнопкаСтатуса.Вставить("text",
		"🔄 " + ?(ПустаяСтрока(ТекущийСтатус), "Статус", Лев(ТекущийСтатус, 40)));
	КнопкаСтатуса.Вставить("callback_data", "st:" + Идентификатор);

	КнопкаОбработки = Новый Структура;

	Если Обработан Тогда
		КнопкаОбработки.Вставить("text", Лев(?(ПустаяСтрока(Отметка), "✅ Обработан", Отметка), 60));
		КнопкаОбработки.Вставить("callback_data", "done");
	Иначе
		КнопкаОбработки.Вставить("text", "✅ Обработан");
		КнопкаОбработки.Вставить("callback_data", "ok:" + Идентификатор);
	КонецЕсли;

	Ряд = Новый Массив;
	Ряд.Добавить(КнопкаСтатуса);
	Ряд.Добавить(КнопкаОбработки);

	Клавиатура = Новый Массив;
	Клавиатура.Добавить(Ряд);

	// Текст задачи менеджера в сообщение не льём - он длинный и забивает чат.
	// Кнопка вторым рядом показывает его окном и разворачивает меню правки.
	//
	// Показываем её ВСЕГДА, а не только при существующей задаче: та же кнопка
	// задачу и заводит. Иначе по заказу с сайта, где задачи ещё нет, создать
	// её из чата было бы нечем - а это как раз тот момент, когда менеджер
	// смотрит на заказ и понимает, что с ним надо что-то сделать завтра.
	КнопкаЗадачи = Новый Структура;
	КнопкаЗадачи.Вставить("text",
		?(ЗначениеЗаполнено(ЗадачаПоЗаказу(Заказ)), "📋 Задача", "➕ Задача"));
	КнопкаЗадачи.Вставить("callback_data", "ts:" + Идентификатор);

	РядЗадачи = Новый Массив;
	РядЗадачи.Добавить(КнопкаЗадачи);

	Клавиатура.Добавить(РядЗадачи);

	Разметка = Новый Структура;
	Разметка.Вставить("inline_keyboard", Клавиатура);

	Возврат Разметка;

КонецФункции

// Меню задачи - вторая клавиатура ТОГО ЖЕ сообщения, открывается кнопкой
// "Задача". Новых сообщений в чат не шлём принципиально (иначе чат превратится
// в ленту дублей одного заказа), поэтому правка живёт в подменю.
//
// Срок - кнопками: дату в Telegram иначе не ввести, callback_data это заранее
// заданная строка, а не поле ввода. Текст - ответом на сообщение заказа,
// его разбирает ПринятьОбновление.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  Структура - reply_markup для Bot API.
//
Функция КлавиатураЗадачи(Знач Заказ)

	Идентификатор = Строка(Заказ.УникальныйИдентификатор());

	КнопкаСегодня = Новый Структура;
	КнопкаСегодня.Вставить("text", "📅 Сегодня");
	КнопкаСегодня.Вставить("callback_data", "t0:" + Идентификатор);

	КнопкаЗавтра = Новый Структура;
	КнопкаЗавтра.Вставить("text", "📅 Завтра");
	КнопкаЗавтра.Вставить("callback_data", "t1:" + Идентификатор);

	КнопкаТриДня = Новый Структура;
	КнопкаТриДня.Вставить("text", "📅 +3 дня");
	КнопкаТриДня.Вставить("callback_data", "t3:" + Идентификатор);

	РядСрока = Новый Массив;
	РядСрока.Добавить(КнопкаСегодня);
	РядСрока.Добавить(КнопкаЗавтра);
	РядСрока.Добавить(КнопкаТриДня);

	КнопкаТекста = Новый Структура;
	КнопкаТекста.Вставить("text", "✏️ Текст");
	КнопкаТекста.Вставить("callback_data", "tx:" + Идентификатор);

	КнопкаНазад = Новый Структура;
	КнопкаНазад.Вставить("text", "⬅️ Назад");
	КнопкаНазад.Вставить("callback_data", "tb:" + Идентификатор);

	РядДействий = Новый Массив;
	РядДействий.Добавить(КнопкаТекста);
	РядДействий.Добавить(КнопкаНазад);

	Клавиатура = Новый Массив;
	Клавиатура.Добавить(РядСрока);
	Клавиатура.Добавить(РядДействий);

	Разметка = Новый Структура;
	Разметка.Вставить("inline_keyboard", Клавиатура);

	Возврат Разметка;

КонецФункции

// Номер отправленного сообщения (message_id) из ответа sendMessage.
Функция НомерСообщенияИзОтвета(Знач Ответ)

	Результат = Неопределено;

	Если Не Ответ.Свойство("result", Результат) Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ЧислоJSON(Результат, "message_id");

КонецФункции

// Пишет отправленное сообщение в историю (регистр ТелеграмУведомления).
// История не должна ронять отправку: сообщение менеджеру уже ушло.
Процедура ЗаписатьВИсторию(Знач ЧатИД, Знач НомерСообщения, Знач Заказ,
	Знач ВидУведомления, Знач Текст, Знач Задача)

	Если НомерСообщения = 0 Или ПустаяСтрока(СокрЛП(Строка(ЧатИД))) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Запись = РегистрыСведений.ТелеграмУведомления.СоздатьМенеджерЗаписи();

		Запись.Заказ = ?(ЗначениеЗаполнено(Заказ),
			Заказ, Документы.ЗаказПокупателя.ПустаяСсылка());

		Запись.Чат            = Лев(СокрЛП(Строка(ЧатИД)), 32);
		Запись.НомерСообщения = НомерСообщения;
		Запись.ДатаОтправки   = ТекущаяДата();
		Запись.ВидУведомления = Лев(ВидУведомления, 30);
		Запись.Текст          = Текст;
		Запись.Обработан      = Ложь;

		Если ЗначениеЗаполнено(Задача) Тогда
			Запись.Задача = Задача;
		КонецЕсли;

		Запись.Записать(Истина);

	Исключение

		ЗаписьЖурналаРегистрации("Телеграм.Ошибка",
			УровеньЖурналаРегистрации.Предупреждение,
			?(ЗначениеЗаполнено(Заказ), Метаданные.Документы.ЗаказПокупателя, Неопределено),
			Заказ,
			"Сообщение отправлено, но в историю не записалось: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Дублирует запись об отправке на сайт - во вкладку админки "Уведомления 1С".
// Источник истины остаётся в регистре ТелеграмУведомления; сайту отдаём копию,
// чтобы историю можно было смотреть из браузера, не заходя в 1С.
//
// Сайт в отправке менеджеру не участвует вообще (1С шлёт своим ботом напрямую),
// поэтому строку в его журнал кладём отсюда, вызовом cron_manager_notify.php.
Процедура ЗеркалитьНаСайт(Знач Заказ, Знач ВидУведомления, Знач Текст)

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;

	Вид = ВидДляСайта(ВидУведомления);

	Если ПустаяСтрока(Вид) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Контрагент = Заказ.Контрагент;

		ТелоЗапроса = "token=" + БИАС.КодироватьПараметрPOST(ТокенСайта())
			+ "&event=sent"
			+ "&kind="  + БИАС.КодироватьПараметрPOST(Вид)
			+ "&order=" + БИАС.КодироватьПараметрPOST(СокрЛП(Заказ.Номер))
			+ "&code="  + БИАС.КодироватьПараметрPOST(СокрЛП(Строка(Контрагент.Код)))
			+ "&name="  + БИАС.КодироватьПараметрPOST(СокрЛП(Строка(Контрагент)))
			+ "&text="  + БИАС.КодироватьПараметрPOST(Текст);

		ЗапросКСайту(ТелоЗапроса, Заказ);

	Исключение

		// Зеркало не должно влиять на отправку: сообщение менеджеру уже ушло,
		// а история есть в регистре.
		ЗаписатьОшибку(Заказ, "Не удалось продублировать уведомление на сайт: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Сообщает сайту, что менеджер нажал "Обработан" - чтобы во вкладке
// "Уведомления 1С" строка перестала висеть в "ждёт обработки".
Процедура ЗеркалитьОбработкуНаСайт(Знач Заказ, Знач Кто)

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		ТелоЗапроса = "token=" + БИАС.КодироватьПараметрPOST(ТокенСайта())
			+ "&event=handled"
			+ "&order=" + БИАС.КодироватьПараметрPOST(СокрЛП(Заказ.Номер))
			+ "&who="   + БИАС.КодироватьПараметрPOST(Кто);

		ЗапросКСайту(ТелоЗапроса, Заказ);

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось передать отметку обработки на сайт: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Вид уведомления 1С -> параметр kind приёмника сайта.
Функция ВидДляСайта(Знач ВидУведомления)

	Если ВидУведомления = "НовыйЗаказ" Тогда
		Возврат "new";
	ИначеЕсли ВидУведомления = "ПросрочкаСтатуса" Тогда
		Возврат "late";
	ИначеЕсли ВидУведомления = "СменаСтатуса" Тогда
		Возврат "move";
	КонецЕсли;

	Возврат "";

КонецФункции

// Приёмник на сайте и его секрет. Секрет тот же, что у уведомлений о резерве
// (БИАС.УведомитьСайтОРезерве) - граница доверия одна и та же.
// Хост и путь держим порознь: HTTPСоединению нужен хост, WinHttp - полный URL,
// а разбирать URL нечем (СтруктураURI в этой конфигурации нет).
Функция ХостСайта()

	Возврат "cvetkovtm.com";

КонецФункции

Функция ПутьПриемникаСайта()

	Возврат "/assets/shop/cron_manager_notify.php";

КонецФункции

// Ссылка на карточку товара на сайте.
//
// Прямой адрес карточки 1С не знает: slug (modx_a_products.product_url) сайт
// строит сам из названия и цвета, обратно он не приезжает. Зато сайт хранит
// НАШ ключ - modx_a_products.product_goodid, это тот самый id, под которым товар
// уходит в выгрузке (ХарактеристикиНоменклатуры.ИдДляВыгрузки: код номенклатуры
// плюс код характеристики, у обоих убраны ведущие нули).
//
// Поэтому ссылка ведёт на маленький редиректор shop/go_product.php, который
// по этому ключу находит товар и перебрасывает на его карточку. Строить slug
// в 1С было бы гаданием: он меняется вместе с названием, и рассинхрон никак
// не проявится - менеджер просто получит 404.
//
// Параметры:
//  КодНоменклатуры   - Строка - код номенклатуры.
//  КодХарактеристики - Строка - код характеристики (цвет и размер).
//
// Возвращаемое значение:
//  Строка - адрес карточки; пусто, если ключ не собрать (нет характеристики -
//           значит и оффера на сайте нет).
//
Функция СсылкаНаТовар(Знач КодНоменклатуры, Знач КодХарактеристики)

	КодТовара = ОбщегоНазначения.УбратьНоликиСлева(СокрЛП(Строка(КодНоменклатуры)));
	КодЦвета  = ОбщегоНазначения.УбратьНоликиСлева(СокрЛП(Строка(КодХарактеристики)));

	Если ПустаяСтрока(КодТовара) Или ПустаяСтрока(КодЦвета) Тогда
		Возврат "";
	КонецЕсли;

	// Путь тот же, что у приёмника уведомлений: в репозитории сайта папка shop,
	// на проде она лежит как assets/shop.
	Возврат "https://" + ХостСайта() + "/assets/shop/go_product.php?good="
		+ КодТовара + КодЦвета;

КонецФункции

Функция ТокенСайта()

	Возврат "e4cfdff6ad370ca2f0e26d8eb82bcda9";

КонецФункции

// POST на сайт: сначала штатным HTTPСоединением, при отказе - через WinHttp,
// ровно как в ВыполнитьЗапрос (какой способ доступен на сервере - выяснится
// только на живой базе).
Процедура ЗапросКСайту(Знач ТелоЗапроса, Знач Заказ)

	Адрес = "https://" + ХостСайта() + ПутьПриемникаСайта();

	Попытка

		Соединение = Новый HTTPСоединение(ХостСайта(), 443, , , , 30,
			Новый ЗащищенноеСоединениеOpenSSL);

		Запрос = Новый HTTPЗапрос(ПутьПриемникаСайта());
		Запрос.Заголовки.Вставить("Content-Type",
			"application/x-www-form-urlencoded; charset=UTF-8");
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8",
			ИспользованиеByteOrderMark.НеИспользовать);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

		Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
			ЗаписатьОшибку(Заказ, "Сайт ответил HTTP " + Строка(Ответ.КодСостояния)
				+ ": " + Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 500));
		КонецЕсли;

		Возврат;

	Исключение

		ОшибкаHTTPСоединения = ОписаниеОшибки();

	КонецПопытки;

	Попытка

		HTTP = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");
		HTTP.Open("POST", Адрес, Ложь);
		HTTP.SetRequestHeader("Content-Type",
			"application/x-www-form-urlencoded; charset=UTF-8");
		HTTP.SetTimeouts(15000, 15000, 30000, 30000);
		HTTP.Send(ТелоЗапроса);

		КодСостояния = Число(HTTP.Status);

		Если КодСостояния < 200 Или КодСостояния >= 300 Тогда
			ЗаписатьОшибку(Заказ, "Сайт ответил HTTP " + Строка(КодСостояния)
				+ ": " + Лев(Строка(HTTP.ResponseText), 500));
		КонецЕсли;

	Исключение

		ЗаписатьОшибку(Заказ, "Сайт недоступен."
			+ Символы.ПС + "HTTPСоединение: " + ОшибкаHTTPСоединения
			+ Символы.ПС + "WinHttp: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Разбирает одно нажатие кнопки: отметка в истории, отметка в задаче,
// ответ Telegram и новая подпись кнопки под сообщением.
Процедура ОбработатьНажатие(Знач Токен, Знач Нажатие)

	ИДНажатия = СтрокаJSON(Нажатие, "id");
	Данные    = СтрокаJSON(Нажатие, "data");

	ЧатИД          = "";
	НомерСообщения = 0;

	Сообщение = Неопределено;
	Если Нажатие.Свойство("message", Сообщение) И ТипЗнч(Сообщение) = Тип("Структура") Тогда

		НомерСообщения = ЧислоJSON(Сообщение, "message_id");

		Чат = Неопределено;
		Если Сообщение.Свойство("chat", Чат) И ТипЗнч(Чат) = Тип("Структура") Тогда
			ЧатИД = СтрокаJSON(Чат, "id");
		КонецЕсли;

	КонецЕсли;

	// След нажатия в журнале - первое, на что смотреть, когда кнопка "не работает".
	// Нет этой записи после нажатия - значит до 1С оно вообще не доехало: не крутится
	// регламент ТелеграмОбмен, у бота стоит вебхук (тогда getUpdates отвечает 409
	// Conflict) или обновления вычитал кто-то другой. Есть запись, но кнопка не
	// обновилась - смотреть следом "Телеграм.Ошибка" с отказом editMessageText.
	ЗаписьЖурналаРегистрации("Телеграм.Кнопка",
		УровеньЖурналаРегистрации.Информация, , ,
		"Нажатие: " + Данные
		+ Символы.ПС + "Чат: " + СокрЛП(Строка(ЧатИД))
		+ ", сообщение: " + Формат(НомерСообщения, "ЧН=0; ЧГ=0")
		+ Символы.ПС + "Кто: " + КтоНажал(Нажатие));

	Префикс = Лев(Данные, 3);

	// Кнопка уже отмеченного сообщения ("done") - просто закрываем "часики"
	// у менеджера, повторно ничего не пишем. Список проверяем строкой, а не
	// цепочкой сравнений: префиксов стало восемь.
	Если СтрНайти("|ok:|st:|ts:|t0:|t1:|t3:|tx:|tb:|", "|" + Префикс + "|") = 0 Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия, "Уже отмечено");
		Возврат;
	КонецЕсли;

	// "Печатает..." в шапке чата сразу после нажатия: дальше идёт чтение заказа
	// и правка сообщения, и до ответа проходит заметная пауза - без этого
	// менеджер не понимает, нажалось ли вообще.
	ПоказатьНабор(Токен, ЧатИД);

	Заказ = ЗаказПоДаннымКнопки(Данные);

	Если Не ЗначениеЗаполнено(Заказ) Тогда

		ЗаписатьОшибку(Неопределено, "Нажата кнопка по заказу, которого нет в 1С."
			+ Символы.ПС + "Данные кнопки: " + Данные);

		ОтветитьНаНажатие(Токен, ИДНажатия, "Заказ не найден в 1С");
		Возврат;

	КонецЕсли;

	// "Статус" ничего не меняет в 1С: перечитывает заказ, переписывает ЭТО ЖЕ
	// сообщение свежими данными и показывает короткую сводку всплывашкой.
	// Новых сообщений в чат не шлём принципиально - иначе чат превратится
	// в ленту дублей одного заказа.
	Если Префикс = "st:" Тогда
		ПоказатьСтатус(Токен, ИДНажатия, ЧатИД, НомерСообщения, Заказ);
		Возврат;
	КонецЕсли;

	// "Задача" - показать текст окном и открыть меню правки под сообщением.
	// Сама задача в этот момент не меняется и не создаётся: создание -
	// побочный эффект первого же действия в меню.
	Если Префикс = "ts:" Тогда
		ПоказатьЗадачу(Токен, ИДНажатия, Заказ);
		ПереключитьКлавиатуру(Токен, ЧатИД, НомерСообщения, КлавиатураЗадачи(Заказ));
		Возврат;
	КонецЕсли;

	// "Назад" - вернуть обычную клавиатуру заказа, с сохранением отметки
	// обработки: иначе выход из меню терял бы "✅ Обработан <дата>".
	Если Префикс = "tb:" Тогда
		Состояние = СостояниеОбработки(ЧатИД, НомерСообщения, Заказ);
		ПереключитьКлавиатуру(Токен, ЧатИД, НомерСообщения,
			КлавиатураЗаказа(Заказ, Состояние.Обработан,
				ОтметкаНаКнопке(Состояние.Дата, Состояние.Кто)));
		ОтветитьНаНажатие(Токен, ИДНажатия, "");
		Возврат;
	КонецЕсли;

	// Срок: сегодня / завтра / +3 дня. Задачи может ещё не быть - тогда
	// она здесь и заводится.
	Если Префикс = "t0:" Или Префикс = "t1:" Или Префикс = "t3:" Тогда
		УстановитьСрокЗадачи(Токен, ИДНажатия, ЧатИД, НомерСообщения, Заказ,
			?(Префикс = "t0:", 0, ?(Префикс = "t1:", 1, 3)));
		Возврат;
	КонецЕсли;

	// Текст задачи вводится ответом на сообщение заказа: полей ввода
	// у inline-кнопок нет, а отдельное сообщение-приглашение засоряло бы чат.
	Если Префикс = "tx:" Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Ответьте на это сообщение обычным текстом - он допишется в задачу."
			+ " Если задачи ещё нет, она создастся.", Истина);
		Возврат;
	КонецЕсли;

	Кто           = КтоНажал(Нажатие);
	ДатаОбработки = ТекущаяДата();

	Задача = ОтметитьВИстории(ЧатИД, НомерСообщения, Заказ, ДатаОбработки, Кто);

	ОтметитьВЗадаче(Задача, Заказ, ДатаОбработки, Кто);

	ЗеркалитьОбработкуНаСайт(Заказ, Кто);

	ОтветитьНаНажатие(Токен, ИДНажатия,
		"Отмечено: " + Формат(ДатаОбработки, "ДФ='dd.MM.yyyy HH:mm'"));

	// Работа сделана - карточка уходит из ВСЕХ чатов, где показывалась.
	// Это не только чистота: пока карточка висит, второй менеджер видит
	// "новый заказ, нужно позвонить" и звонит клиенту следом за первым.
	УбратьКарточкиЗаказа(Токен, Заказ);

КонецПроцедуры

// "Печатает..." в чате. Живёт около 5 секунд и гаснет само - ровно на время,
// пока 1С читает заказ и правит сообщение. Продлевать циклом не будем:
// это была бы минута занятого фонового задания ради анимации.
//
// Параметры:
//  Токен - Строка - токен бота.
//  ЧатИД - Строка - чат, в котором нажали кнопку.
//
Процедура ПоказатьНабор(Знач Токен, Знач ЧатИД)

	Если ПустаяСтрока(СокрЛП(Строка(ЧатИД))) Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("action", "typing");

	ВыполнитьЗапрос(Токен, "sendChatAction", ВJSON(Параметры), Неопределено);

КонецПроцедуры

// Кнопка "Статус": перечитывает заказ в 1С и переписывает ТО ЖЕ САМОЕ сообщение
// свежими данными, плюс показывает короткую сводку всплывашкой. В 1С ничего
// не меняет и в историю не пишет - это не уведомление, а просмотр.
//
// Новых сообщений не отправляем сознательно: иначе чат по одному заказу
// превращается в ленту почти одинаковых дублей.
Процедура ПоказатьСтатус(Знач Токен, Знач ИДНажатия, Знач ЧатИД,
	Знач НомерСообщения, Знач Заказ)

	Состояние = СостояниеОбработки(ЧатИД, НомерСообщения, Заказ);

	// Всплывашка, а НЕ окно: гаснет сама, нажимать "ОК" не нужно. Окно здесь было
	// лишним - те же данные тут же появляются в самом сообщении и на кнопке,
	// а модальное окно на каждое нажатие менеджера только тормозит.
	// Поэтому и сводка однострочная: у всплывашки одна строка и лимит 200 символов.
	Сводка = "№ " + СокрЛП(Заказ.Номер)
		+ " · " + СокрЛП(Строка(Заказ.СтатусЗаказа))
		+ " · " + Формат(Заказ.СуммаДокумента, "ЧДЦ=2; ЧН=0; ЧГ=0") + " грн";

	СтатусОтправки = СокрЛП(Строка(Заказ.СтатусОтправки));
	Если Не ПустаяСтрока(СтатусОтправки) Тогда
		Сводка = Сводка + " · " + СтатусОтправки;
	КонецЕсли;

	Если Состояние.Обработан Тогда
		Сводка = Сводка + " · ✅ "
			+ Формат(Состояние.Дата, "ДФ='dd.MM HH:mm'");
	КонецЕсли;

	ОтветитьНаНажатие(Токен, ИДНажатия, Лев(Сводка, 200));

	// Время с секундами - чтобы текст всегда отличался от прежнего: на
	// одинаковый текст Telegram отвечает ошибкой "message is not modified".
	Текст = ТекстПоЗаказу(Заказ, Заказ.СтатусЗаказа, ЗаголовокПоВиду(Состояние.Вид))
		+ Символы.ПС + Символы.ПС
		+ "<i>Обновлено " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + "</i>";

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("message_id", НомерСообщения);
	Параметры.Вставить("text", ?(СтрДлина(Текст) > 4000, Лев(Текст, 3990) + "...", Текст));
	Параметры.Вставить("parse_mode", "HTML");
	Параметры.Вставить("disable_web_page_preview", Истина);

	Параметры.Вставить("reply_markup",
		КлавиатураЗаказа(Заказ, Состояние.Обработан,
			ОтметкаНаКнопке(Состояние.Дата, Состояние.Кто)));

	ВыполнитьЗапрос(Токен, "editMessageText", ВJSON(Параметры), Заказ);

КонецПроцедуры

// Кнопка "Задача": показывает окном текст задачи менеджера по этому заказу.
// В 1С ничего не меняет и само сообщение не трогает - только читает.
//
// Окном (show_alert), а не всплывашкой: это как раз тот случай, когда текст надо
// прочитать, а не заметить краем глаза. Из-за этого же и ограничение: у Telegram
// на текст ответа жёсткий лимит 200 символов, поэтому длинную задачу обрезаем.
// Если задачи начнут регулярно не влезать - текст придётся не показывать окном,
// а разворачивать в самом сообщении по кнопке-переключателю.
Процедура ПоказатьЗадачу(Знач Токен, Знач ИДНажатия, Знач Заказ)

	Задача = ЗадачаПоЗаказу(Заказ);

	Если Не ЗначениеЗаполнено(Задача) Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Открытой задачи по этому заказу нет."
			+ " Выберите срок кнопкой или ответьте на сообщение текстом -"
			+ " задача создастся.", Истина);
		Возврат;
	КонецЕсли;

	Текст = "";

	// Порядок - от самого нужного к справочному: если не влезет, обрежется хвост.
	Описание = СокрЛП(Строка(Задача.Описание));
	Если Не ПустаяСтрока(Описание) Тогда
		Текст = Описание;
	КонецЕсли;

	ДопИнформация = СокрЛП(Строка(Задача.ДопИнформация));
	Если Не ПустаяСтрока(ДопИнформация) Тогда
		Текст = ?(ПустаяСтрока(Текст), "", Текст + Символы.ПС) + ДопИнформация;
	КонецЕсли;

	СтатусПоФакту = СокрЛП(Строка(Задача.СтатусПоФакту));
	Если Не ПустаяСтрока(СтатусПоФакту) Тогда
		Текст = ?(ПустаяСтрока(Текст), "", Текст + Символы.ПС) + "По факту: " + СтатусПоФакту;
	КонецЕсли;

	Если ЗначениеЗаполнено(Задача.СрокИсполнения) Тогда
		Текст = ?(ПустаяСтрока(Текст), "", Текст + Символы.ПС)
			+ "Срок: " + Формат(Задача.СрокИсполнения, "ДФ='dd.MM.yyyy'");
	КонецЕсли;

	Если ПустаяСтрока(Текст) Тогда
		Текст = "Задача есть, но текста в ней нет - смотрите её в 1С.";
	КонецЕсли;

	// Лимит Telegram - 200 символов; обрезаем с многоточием, чтобы было видно,
	// что текст неполный, и менеджер пошёл в 1С за остатком.
	Если СтрДлина(Текст) > 200 Тогда
		Текст = Лев(Текст, 197) + "...";
	КонецЕсли;

	ОтветитьНаНажатие(Токен, ИДНажатия, Текст, Истина);

КонецПроцедуры

// Меняет только клавиатуру под уже отправленным сообщением, текст не трогает.
// Одна процедура на все переключения меню задачи: editMessageReplyMarkup
// сроком не ограничен, в отличие от ответа на само нажатие.
Процедура ПереключитьКлавиатуру(Знач Токен, Знач ЧатИД, Знач НомерСообщения, Знач Разметка)

	Если ПустаяСтрока(СокрЛП(Строка(ЧатИД))) Или НомерСообщения = 0 Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("message_id", НомерСообщения);
	Параметры.Вставить("reply_markup", Разметка);

	ВыполнитьЗапрос(Токен, "editMessageReplyMarkup", ВJSON(Параметры), Неопределено);

КонецПроцедуры

// Кнопки "Сегодня / Завтра / +3 дня": ставят срок исполнения задачи, а если
// открытой задачи по заказу нет - сначала её создают.
//
// Время ставим 9:00 целевого дня - так же, как это делает ночная
// БИАС.ПроверкаЗадачь, чтобы задачи из чата не выбивались из общего списка.
//
// Параметры:
//  Дней - Число - 0 сегодня, 1 завтра, 3 через три дня.
//
Процедура УстановитьСрокЗадачи(Знач Токен, Знач ИДНажатия, Знач ЧатИД,
	Знач НомерСообщения, Знач Заказ, Знач Дней)

	Задача = ЗадачаДляЗаказа(Заказ);

	Если Задача = Неопределено Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Задачи нет, и создавать её не на кого: у статуса заказа не задан"
			+ " пользователь, ответственный в заказе тоже пуст.", Истина);
		Возврат;
	КонецЕсли;

	// Ссылка у только что созданной задачи пустая до записи - по ней и отличаем
	// "создали" от "поправили", чтобы честно сказать это менеджеру.
	Новая = Задача.Ссылка.Пустая();

	Срок = НачалоДня(ТекущаяДата() + Дней * 86400) + 32400;

	Задача.СрокИсполнения = Срок;
	Если Задача.Оповещение Тогда
		Задача.СрокОповещения = Срок;
	КонецЕсли;

	Если Не ЗаписатьЗадачуТихо(Задача, Заказ) Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Не удалось записать задачу - смотрите журнал регистрации,"
			+ " событие Телеграм.Задача.", Истина);
		Возврат;
	КонецЕсли;

	ОтветитьНаНажатие(Токен, ИДНажатия,
		?(Новая, "Задача создана, срок: ", "Срок: ")
		+ Формат(Срок, "ДФ='dd.MM.yyyy'"));

	// Перерисовываем меню: у только что созданной задачи кнопка заказа меняет
	// подпись с "➕" на "📋", а меню остаётся открытым для следующей правки.
	ПереключитьКлавиатуру(Токен, ЧатИД, НомерСообщения, КлавиатураЗадачи(Заказ));

КонецПроцедуры

// Задача по заказу для правки из чата: находит открытую, а нет - заводит новую.
//
// Исполнителя выбираем ровно той же логикой, что и ночная БИАС.ПроверкаЗадачь
// (Пользователь1 статуса → группа из статуса → ответственный по заказу).
// Иначе задачи по одному заказу расходились бы по разным людям в зависимости
// от того, кто их создал - человек из чата или ночная проверка.
//
// Возвращаемое значение:
//  ЗадачаОбъект.ЗадачиПользователя - НЕзаписанная задача (записывает вызывающий),
//  либо Неопределено, если исполнителя определить не из чего.
//
Функция ЗадачаДляЗаказа(Знач Заказ)

	Ссылка = ЗадачаПоЗаказу(Заказ);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Статус      = Заказ.СтатусЗаказа;
	Исполнитель = Неопределено;

	Если ЗначениеЗаполнено(Статус) И ЗначениеЗаполнено(Статус.Пользователь1) Тогда
		Исполнитель = Статус.Пользователь1;
	ИначеЕсли ЗначениеЗаполнено(Статус)
		И ЗначениеЗаполнено(Статус.ЗадачаГруппеПользователей) Тогда
		Исполнитель = Статус.ЗадачаГруппеПользователей;
	ИначеЕсли ЗначениеЗаполнено(Заказ.Ответственный) Тогда
		Исполнитель = Заказ.Ответственный;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();

	Задача.ИдентификаторСобытия = "Telegram";
	Задача.Дата                 = ТекущаяДата();
	Задача.Наименование         = Лев(СокрЛП(Строка(Заказ.Контрагент)), 100);
	Задача.Объект               = Заказ;
	Задача.Описание             = "Задача из Telegram";
	Задача.Исполнитель          = Исполнитель;
	Задача.Оповещение           = Истина;
	Задача.СрокИсполнения       = НачалоДня(ТекущаяДата()) + 32400;
	Задача.СрокОповещения       = Задача.СрокИсполнения;

	Возврат Задача;

КонецФункции

// Запись задачи без выброса исключения наружу: нажатие кнопки не должно
// падать с ошибкой у менеджера в чате, ему нужен внятный ответ.
Функция ЗаписатьЗадачуТихо(Знач Задача, Знач Заказ)

	Попытка

		Задача.Записать();
		Возврат Истина;

	Исключение

		ЗаписьЖурналаРегистрации("Телеграм.Задача",
			УровеньЖурналаРегистрации.Ошибка, , Заказ,
			"Не удалось записать задачу: " + ОписаниеОшибки());

		Возврат Ложь;

	КонецПопытки;

КонецФункции

// Ответ менеджера текстом на сообщение заказа: дописывает текст в задачу.
//
// Заказ определяем по сообщению, НА КОТОРОЕ ответили: пара "чат + номер
// сообщения" лежит в регистре ТелеграмУведомления с момента отправки, и это
// избавляет от приглашений с невидимыми метками в тексте.
//
// Текст пишем в Описание, а НЕ в ДопИнформацию: ДопИнформация - строка ровно
// на 30 символов, заметка менеджера в неё молча не влезет (у Описания длина
// не ограничена).
Процедура ОбработатьОтветТекстом(Знач Токен, Знач Сообщение, Знач Исходное)

	Текст = СокрЛП(СтрокаJSON(Сообщение, "text"));

	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	ЧатИД = "";
	Чат   = Неопределено;
	Если Сообщение.Свойство("chat", Чат) И ТипЗнч(Чат) = Тип("Структура") Тогда
		ЧатИД = СтрокаJSON(Чат, "id");
	КонецЕсли;

	Заказ = ЗаказПоСообщению(ЧатИД, ЧислоJSON(Исходное, "message_id"));

	// Ответили на постороннее сообщение - молчим. Чат общий, и лезть с ответами
	// в чужую переписку бот не должен.
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;

	НомерОтвета = ЧислоJSON(Сообщение, "message_id");

	Задача = ЗадачаДляЗаказа(Заказ);

	Если Задача = Неопределено Тогда
		ОтветитьВЧат(Токен, ЧатИД, НомерОтвета,
			"⚠️ Задачу создать не на кого: у статуса заказа не задан пользователь,"
			+ " ответственный в заказе тоже пуст.");
		Возврат;
	КонецЕсли;

	Новая = Задача.Ссылка.Пустая();

	Заметка = Формат(ТекущаяДата(), "ДФ='dd.MM HH:mm'")
		+ " " + КтоНажал(Сообщение) + ": " + Текст;

	// У новой задачи Описание - это наша же заглушка "Задача из Telegram",
	// её заменяем, а не копим.
	Если Новая Тогда
		Задача.Описание = Заметка;
	Иначе
		Задача.Описание = ?(ПустаяСтрока(СокрЛП(Строка(Задача.Описание))), "",
			Строка(Задача.Описание) + Символы.ПС) + Заметка;
	КонецЕсли;

	Если Не ЗаписатьЗадачуТихо(Задача, Заказ) Тогда
		ОтветитьВЧат(Токен, ЧатИД, НомерОтвета,
			"⚠️ Не удалось записать задачу - смотрите журнал регистрации.");
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Телеграм.Задача",
		УровеньЖурналаРегистрации.Информация, , Заказ,
		?(Новая, "Задача создана из чата: ", "Дописано в задачу: ") + Текст);

	ОтветитьВЧат(Токен, ЧатИД, НомерОтвета,
		?(Новая, "✅ Задача создана", "✅ Записано в задачу"));

КонецПроцедуры

// Заказ по сообщению в чате - обратный поиск по регистру ТелеграмУведомления.
// Нужен для ответов текстом: в самом ответе Telegram не передаёт ничего, кроме
// сообщения, на которое ответили.
Функция ЗаказПоСообщению(Знач ЧатИД, Знач НомерСообщения)

	Если ПустаяСтрока(СокрЛП(Строка(ЧатИД))) Или НомерСообщения = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТелеграмУведомления.Заказ КАК Заказ
		|ИЗ
		|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
		|ГДЕ
		|	ТелеграмУведомления.Чат = &Чат
		|	И ТелеграмУведомления.НомерСообщения = &НомерСообщения";

	Запрос.УстановитьПараметр("Чат", Лев(СокрЛП(Строка(ЧатИД)), 32));
	Запрос.УстановитьПараметр("НомерСообщения", НомерСообщения);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Заказ;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Короткий ответ в чат репликой на сообщение менеджера. Единственное место,
// где бот сам пишет в чат помимо уведомлений: без подтверждения человек
// не знает, дошёл его текст до задачи или нет.
Процедура ОтветитьВЧат(Знач Токен, Знач ЧатИД, Знач НомерСообщения, Знач Текст)

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("text", Текст);

	Если НомерСообщения > 0 Тогда
		Параметры.Вставить("reply_to_message_id", НомерСообщения);
	КонецЕсли;

	ВыполнитьЗапрос(Токен, "sendMessage", ВJSON(Параметры), Неопределено);

КонецПроцедуры

// Что мы знаем про это сообщение из истории: нажимали ли "Обработан", когда
// и кто, и каким уведомлением оно было. Записи может не быть - тогда считаем,
// что не обработано, а заголовок не восстанавливаем.
Функция СостояниеОбработки(Знач ЧатИД, Знач НомерСообщения, Знач Заказ)

	Состояние = Новый Структура("Обработан, Дата, Кто, Вид", Ложь, '00010101', "", "");

	Если ПустаяСтрока(СокрЛП(Строка(ЧатИД))) Или НомерСообщения = 0 Тогда
		Возврат Состояние;
	КонецЕсли;

	Попытка

		Запись = РегистрыСведений.ТелеграмУведомления.СоздатьМенеджерЗаписи();
		Запись.Заказ          = Заказ;
		Запись.Чат            = Лев(СокрЛП(Строка(ЧатИД)), 32);
		Запись.НомерСообщения = НомерСообщения;
		Запись.Прочитать();

		Если Запись.Выбран() Тогда
			Состояние.Обработан = Запись.Обработан;
			Состояние.Дата      = Запись.ДатаОбработки;
			Состояние.Кто       = Запись.КтоОбработал;
			Состояние.Вид       = Запись.ВидУведомления;
		КонецЕсли;

	Исключение
		// История не критична: без неё просто перерисуем сообщение без заголовка.
	КонецПопытки;

	Возврат Состояние;

КонецФункции

// Заголовок сообщения по виду уведомления - чтобы при обновлении по кнопке
// "Статус" сообщение осталось тем же по смыслу, а не превратилось в безликое.
Функция ЗаголовокПоВиду(Знач Вид)

	Если Вид = "НовыйЗаказ" Тогда
		Возврат "🆕 <b>НОВЫЙ ЗАКАЗ С САЙТА</b> - нужно позвонить";
	ИначеЕсли Вид = "СменаСтатуса" Тогда
		Возврат "➡️ <b>СМЕНА СТАТУСА</b>";
	КонецЕсли;

	Возврат "";

КонецФункции

// Подпись кнопки после отметки: одна и та же и при нажатии "Обработан",
// и при последующих обновлениях по кнопке "Статус".
Функция ОтметкаНаКнопке(Знач ДатаОбработки, Знач Кто)

	Если Не ЗначениеЗаполнено(ДатаОбработки) Тогда
		Возврат "";
	КонецЕсли;

	Надпись = "✅ Обработан " + Формат(ДатаОбработки, "ДФ='dd.MM HH:mm'");

	Если Не ПустаяСтрока(Кто) Тогда
		Надпись = Надпись + " - " + Кто;
	КонецЕсли;

	Возврат Надпись;

КонецФункции

// Заказ по callback_data вида "ok:<UUID заказа>".
Функция ЗаказПоДаннымКнопки(Знач Данные)

	Идентификатор = СокрЛП(Сред(СокрЛП(Данные), 4));

	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Ссылка = Документы.ЗаказПокупателя.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Идентификатор));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	// Ссылка на несуществующий документ читается без ошибки, но пустыми
	// значениями реквизитов - по номеру и отличаем.
	Если ПустаяСтрока(СокрЛП(Ссылка.Номер)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

// Ставит отметку обработки в истории и возвращает задачу, к которой сообщение
// было привязано при отправке (Неопределено - привязки не было).
Функция ОтметитьВИстории(Знач ЧатИД, Знач НомерСообщения, Знач Заказ,
	Знач ДатаОбработки, Знач Кто)

	Если НомерСообщения = 0 Или ПустаяСтрока(ЧатИД) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка

		Запись = РегистрыСведений.ТелеграмУведомления.СоздатьМенеджерЗаписи();

		Запись.Заказ          = Заказ;
		Запись.Чат            = Лев(СокрЛП(Строка(ЧатИД)), 32);
		Запись.НомерСообщения = НомерСообщения;

		Запись.Прочитать();

		Если Не Запись.Выбран() Тогда

			// Записи нет - сообщение ушло до появления регистра. Заводим её
			// сейчас, чтобы отметка обработки не потерялась.
			Запись.Заказ          = Заказ;
			Запись.Чат            = Лев(СокрЛП(Строка(ЧатИД)), 32);
			Запись.НомерСообщения = НомерСообщения;
			Запись.ДатаОтправки   = ДатаОбработки;

		КонецЕсли;

		Запись.Обработан     = Истина;
		Запись.ДатаОбработки = ДатаОбработки;
		Запись.КтоОбработал  = Лев(Кто, 100);

		Запись.Записать(Истина);

		Возврат Запись.Задача;

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось отметить обработку в истории: " + ОписаниеОшибки());
		Возврат Неопределено;

	КонецПопытки;

КонецФункции

// Дописывает в задачу менеджера строку с датой обработки. Задачу не закрывает:
// закрытие - решение менеджера в 1С.
Процедура ОтметитьВЗадаче(Знач Задача, Знач Заказ, Знач ДатаОбработки, Знач Кто)

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Задача = ЗадачаПоЗаказу(Заказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат;
	КонецЕсли;

	ОбъектЗадачи = Задача.ПолучитьОбъект();

	Если ОбъектЗадачи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Отметка = "✅ Обработан в Telegram "
		+ Формат(ДатаОбработки, "ДФ='dd.MM.yyyy HH:mm'");

	Если Не ПустаяСтрока(Кто) Тогда
		Отметка = Отметка + " - " + Кто;
	КонецЕсли;

	// Пишем в "Описание": это строка неограниченной длины. В "ДопИнформации"
	// всего 30 символов - отметка молча обрезалась бы.
	Если СтрНайти(ОбъектЗадачи.Описание, "✅ Обработан в Telegram") = 0 Тогда

		ОбъектЗадачи.Описание = ?(ПустаяСтрока(ОбъектЗадачи.Описание),
			"", ОбъектЗадачи.Описание + Символы.ПС) + Отметка;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ОбъектЗадачи.ДатаИсполнения) Тогда
		ОбъектЗадачи.ДатаИсполнения = ДатаОбработки;
	КонецЕсли;

	Попытка
		ОбъектЗадачи.Записать();
	Исключение
		ЗаписатьОшибку(Заказ, "Не удалось записать отметку обработки в задачу: "
			+ ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Последняя незакрытая задача по заказу - на случай, когда сообщение отправили
// без привязки к задаче (уведомление о новом заказе).
Функция ЗадачаПоЗаказу(Знач Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗадачиПользователя.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
		|ГДЕ
		|	ЗадачиПользователя.Объект = &Заказ
		|	И НЕ ЗадачиПользователя.Выполнена
		|УПОРЯДОЧИТЬ ПО
		|	ЗадачиПользователя.Дата УБЫВ";

	Запрос.УстановитьПараметр("Заказ", Заказ);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Кто нажал кнопку: имя и @username из callback_query.from.
Функция КтоНажал(Знач Нажатие)

	Отправитель = Неопределено;

	Если Не Нажатие.Свойство("from", Отправитель)
		Или ТипЗнч(Отправитель) <> Тип("Структура") Тогда

		Возврат "";

	КонецЕсли;

	Представление = СокрЛП(СтрокаJSON(Отправитель, "first_name")
		+ " " + СтрокаJSON(Отправитель, "last_name"));

	ИмяПользователя = СтрокаJSON(Отправитель, "username");

	Если Не ПустаяСтрока(ИмяПользователя) Тогда
		Представление = СокрЛП(Представление + " @" + ИмяПользователя);
	КонецЕсли;

	Возврат Представление;

КонецФункции

// Ответ на нажатие: без него у менеджера крутятся "часики" на кнопке.
//
// По умолчанию - всплывашка: одна строка, гаснет сама, ничего закрывать не надо.
// Окном (show_alert) сейчас не пользуемся нигде: параметр оставлен на случай,
// когда сообщение действительно нельзя пропустить и его надо подтвердить.
Процедура ОтветитьНаНажатие(Знач Токен, Знач ИДНажатия, Знач Текст,
	Знач Окном = Ложь)

	Если ПустаяСтрока(ИДНажатия) Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("callback_query_id", ИДНажатия);
	Параметры.Вставить("text", Текст);

	Если Окном Тогда
		Параметры.Вставить("show_alert", Истина);
	КонецЕсли;

	ВыполнитьЗапрос(Токен, "answerCallbackQuery", ВJSON(Параметры), Неопределено);

КонецПроцедуры

// Меняет подпись кнопки под уже отправленным сообщением на "✅ Обработан <дата>",
// чтобы в чате было видно, что заказ разобрали, и повторно не звонили.
// Кнопка "Статус" при этом остаётся рабочей - смотреть заказ можно и после.
Процедура ОтметитьСообщение(Знач Токен, Знач ЧатИД, Знач НомерСообщения,
	Знач Заказ, Знач ДатаОбработки, Знач Кто)

	Если ПустаяСтрока(ЧатИД) Или НомерСообщения = 0 Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("message_id", НомерСообщения);
	Параметры.Вставить("reply_markup",
		КлавиатураЗаказа(Заказ, Истина, ОтметкаНаКнопке(ДатаОбработки, Кто)));

	ВыполнитьЗапрос(Токен, "editMessageReplyMarkup", ВJSON(Параметры), Неопределено);

КонецПроцедуры

// Вызывает метод Bot API. Сначала штатным HTTPСоединением, при отказе - через WinHttp:
// в этой базе исходящий HTTPS уже ходит обоими способами (см. ОплатаПоСсылке и БИАС),
// а какой из них доступен на сервере - выяснится только на живой базе.
Функция ВыполнитьЗапрос(Знач Токен, Знач Метод, Знач ТелоЗапроса, Знач Заказ)

	Адрес = "/bot" + Токен + "/" + Метод;
	ТелоОтвета = "";

	Попытка

		Соединение = Новый HTTPСоединение("api.telegram.org", 443, , , , 30,
			Новый ЗащищенноеСоединениеOpenSSL);

		Запрос = Новый HTTPЗапрос(Адрес);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		// Без BOM: с ним Telegram не разбирает JSON.
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");

	Исключение

		ОшибкаHTTPСоединения = ОписаниеОшибки();
		ТелоОтвета = "";

		Попытка

			HTTP = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");
			HTTP.Open("POST", "https://api.telegram.org" + Адрес, Ложь);
			HTTP.SetRequestHeader("Content-Type", "application/json; charset=utf-8");
			HTTP.SetTimeouts(15000, 15000, 30000, 30000);
			HTTP.Send(ТелоЗапроса);

			ТелоОтвета = Строка(HTTP.ResponseText);

		Исключение

			ЗаписатьОшибку(Заказ, "Telegram недоступен (" + Метод + ")."
				+ Символы.ПС + "HTTPСоединение: " + ОшибкаHTTPСоединения
				+ Символы.ПС + "WinHttp: " + ОписаниеОшибки());

			Возврат Неопределено;

		КонецПопытки;

	КонецПопытки;

	Если ПустаяСтрока(СокрЛП(ТелоОтвета)) Тогда
		ЗаписатьОшибку(Заказ, "Telegram вернул пустой ответ (" + Метод + ").");
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		ЗаписатьОшибку(Заказ, "Не удалось разобрать ответ Telegram (" + Метод + "): "
			+ ОписаниеОшибки() + Символы.ПС + Лев(ТелоОтвета, 1000));
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ЗаписатьОшибку(Заказ, "Telegram вернул неожиданный ответ (" + Метод + "): "
			+ Лев(ТелоОтвета, 1000));
		Возврат Неопределено;
	КонецЕсли;

	// Отказ Bot API (ok:false) логируем ЗДЕСЬ, за все методы сразу. Раньше это делал
	// только ОтправитьСообщение, а editMessageText, answerCallbackQuery,
	// editMessageReplyMarkup и getUpdates отказ проглатывали: кнопка "Статус"
	// у менеджера не срабатывала, а в журнале не было ни строчки.
	//
	// Начало тела запроса кладём в текст намеренно - там chat_id и message_id,
	// без них по сообщению "Bad Request: message can't be edited" не понять, о каком
	// сообщении речь. Ответ при этом всё равно возвращаем: разбираться с ним
	// (или молча пропустить) - дело вызывающей стороны.
	Если Не БулевоJSON(Данные, "ok") Тогда

		Описание = СтрокаJSON(Данные, "description");

		ТекстОтказа = "Telegram отклонил " + Метод + ": " + Описание
			+ " (error_code " + Формат(ЧислоJSON(Данные, "error_code"), "ЧН=0; ЧГ=0") + ")"
			+ Символы.ПС + "Запрос: " + Лев(ТелоЗапроса, 300);

		// "query is too old" на answerCallbackQuery - не поломка, а следствие
		// расписания: Telegram держит нажатие живым считанные секунды, а забираем
		// мы его прогоном регламента. Менеджер это видит как "полоска загрузки
		// сверху появилась и пропала, всплывашки не было". Само сообщение при этом
		// перерисовывается нормально - editMessageText сроком не ограничен.
		// Пишем предупреждением, чтобы не путать с настоящими отказами.
		Если Метод = "answerCallbackQuery" И СтрНайти(Описание, "too old") > 0 Тогда

			ЗаписьЖурналаРегистрации("Телеграм.Кнопка",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				ТекстОтказа + Символы.ПС
				+ "Всплывашка не показана - нажатие разобрано позже, чем его ждал"
				+ " Telegram. Лечится более частым расписанием ТелеграмОбмен.");

		Иначе

			ЗаписатьОшибку(Заказ, ТекстОтказа);

		КонецЕсли;

	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция ВJSON(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Телефон клиента в формате +380..., пригодном для звонка из Telegram.
Функция ТелефонДляЗвонка(Заказ)

	Телефон = СокрЛП(Строка(Заказ.ТелефонКонтрагента));

	// В заказах с сайта телефон кладётся в ТелефонКонтрагента1 (ОбменПокупателямиНашСайт).
	Если ПустаяСтрока(Телефон) Тогда
		Телефон = СокрЛП(Строка(Заказ.ТелефонКонтрагента1));
	КонецЕсли;

	Если ПустаяСтрока(Телефон) Тогда
		Телефон = СокрЛП(ОбщегоНазначения.ТелефонКонтрагента(Заказ.Контрагент));
	КонецЕсли;

	Цифры = "";
	Для Позиция = 1 По СтрДлина(Телефон) Цикл
		Символ = Сред(Телефон, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		ИначеЕсли Символ = ";" Или Символ = "," Тогда
			// В реквизите может лежать несколько номеров - берём первый.
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(Цифры) = 12 И Лев(Цифры, 3) = "380" Тогда
		Возврат "+" + Цифры;
	ИначеЕсли СтрДлина(Цифры) = 10 И Лев(Цифры, 1) = "0" Тогда
		Возврат "+38" + Цифры;
	ИначеЕсли СтрДлина(Цифры) = 9 Тогда
		Возврат "+380" + Цифры;
	КонецЕсли;

	// Формат не распознали - отдаём как есть, менеджер разберётся.
	Возврат ?(ПустаяСтрока(Цифры), "", Телефон);

КонецФункции

Функция АдресДоставки(Заказ)

	Адрес = СокрЛП(Строка(Заказ.АдресДоставки));

	Если ПустаяСтрока(Адрес) И ЗначениеЗаполнено(Заказ.АдресДоставкиНП) Тогда
		Адрес = СокрЛП(Строка(Заказ.АдресДоставкиНП));
	КонецЕсли;

	Возврат Адрес;

КонецФункции

// Экранирует символы, которые Telegram считает разметкой HTML.
Функция HTML(Знач Текст)

	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");

	Возврат Текст;

КонецФункции

Функция СтрокаJSON(Данные, Имя)

	Значение = Неопределено;
	Если Не Данные.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧЦ=20; ЧДЦ=0; ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ЧислоJSON(Данные, Имя)

	Значение = Неопределено;
	Если Не Данные.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Число(СокрЛП(Строка(Значение)));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция БулевоJSON(Данные, Имя)

	Значение = Неопределено;
	Если Не Данные.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	ТекстЗначения = НРег(СокрЛП(Строка(Значение)));
	Возврат ТекстЗначения = "true" Или ТекстЗначения = "1" Или ТекстЗначения = "да";

КонецФункции

Процедура ЗаписатьОшибку(Заказ, Текст)

	ЗаписьЖурналаРегистрации("Телеграм.Ошибка",
		УровеньЖурналаРегистрации.Ошибка,
		?(ЗначениеЗаполнено(Заказ), Метаданные.Документы.ЗаказПокупателя, Неопределено),
		Заказ,
		Текст);

КонецПроцедуры

#КонецОбласти
