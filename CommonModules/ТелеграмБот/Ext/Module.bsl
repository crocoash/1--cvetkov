////////////////////////////////////////////////////////////////////////////////
// Уведомления менеджеру в Telegram.
//
// Работает через ОТДЕЛЬНОГО бота 1С (не через бота сайта Cvetkovbot):
// у getUpdates может быть только один потребитель, и вебхук сайта мы трогать не можем.
// Токен зашит в функции ТокенБота() - как ключ обмена в ОплатаПоСсылке.
//
// Кому слать - задаётся в справочнике "Статусы заказов" (реквизиты
// "Отправлять в Telegram" и "Телеграм: чат"). Отправка происходит в момент,
// когда БИАС.ПроверкаЗадачь создаёт задачу просрочки статуса, то есть по тем же
// правилам ("Дней в статусе"), что и задача менеджеру.
//
// Кнопок в сообщении нет: менеджеру нужно только позвонить, поэтому телефон
// клиента выводится отдельной строкой в формате +380... - Telegram сам делает
// его кликабельным (tap = звонок). Кнопкой это сделать нельзя: inline-кнопки
// Telegram принимают только http(s)/tg-ссылки, схему tel: API отклоняет.
//
// Разовая привязка получателя: получатель нажимает Start у бота,
// затем ПоказатьНовыеЧаты() выводит его chat_id в журнал регистрации.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Отправляет в Telegram уведомление о заказе.
//
// Параметры:
//  Заказ  - ДокументСсылка.ЗаказПокупателя - заказ, о котором уведомляем.
//  Статус - СправочникСсылка.СтатусыЗаказов - статус, чьи настройки берём (чат получателя).
//         - Неопределено - берём статус самого заказа.
//  ЧатИД  - Строка - явный получатель; если не задан, берётся из настроек статуса.
//
// Возвращаемое значение:
//  Булево - сообщение принято Telegram.
//
Функция УведомитьОЗаказе(Заказ, Знач Статус = Неопределено, Знач ЧатИД = "") Экспорт

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Если Статус = Неопределено Тогда
		Статус = Заказ.СтатусЗаказа;
	КонецЕсли;

	Если ПустаяСтрока(ЧатИД) И ЗначениеЗаполнено(Статус) Тогда
		ЧатИД = СокрЛП(Строка(Статус.ТелеграмЧат));
	КонецЕсли;

	// Пока реквизит не выведен на форму статуса, получателя можно задать в коде.
	Если ПустаяСтрока(ЧатИД) Тогда
		ЧатИД = ЧатПоУмолчанию();
	КонецЕсли;

	Если ПустаяСтрока(ЧатИД) Тогда
		ЗаписатьОшибку(Заказ, "Не заполнен ""Телеграм: чат"" у статуса " + Строка(Статус)
			+ " - уведомление не отправлено.");
		Возврат Ложь;
	КонецЕсли;

	Возврат ОтправитьСообщение(ЧатИД, ТекстПоЗаказу(Заказ, Статус), Заказ);

КонецФункции

// Отправляет произвольное сообщение в Telegram.
//
// Параметры:
//  ЧатИД - Строка - chat_id получателя.
//  Текст - Строка - текст сообщения в разметке HTML (Telegram), не длиннее 4096 символов.
//  Заказ - ДокументСсылка.ЗаказПокупателя - для журнала регистрации.
//        - Неопределено
//
// Возвращаемое значение:
//  Булево - сообщение принято Telegram.
//
Функция ОтправитьСообщение(Знач ЧатИД, Знач Текст, Знач Заказ = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Токен = ТокенБота();
	Если ПустаяСтрока(Токен) Тогда
		ЗаписатьОшибку(Заказ, "Не заполнен токен бота (функция ТокенБота).");
		Возврат Ложь;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Лимит Telegram на длину сообщения - 4096 символов.
	Если СтрДлина(Текст) > 4000 Тогда
		Текст = Лев(Текст, 3990) + "...";
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("text", Текст);
	Параметры.Вставить("parse_mode", "HTML");
	Параметры.Вставить("disable_web_page_preview", Истина);

	Ответ = ВыполнитьЗапрос(Токен, "sendMessage", ВJSON(Параметры), Заказ);

	Если Ответ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не БулевоJSON(Ответ, "ok") Тогда
		ЗаписатьОшибку(Заказ, "Telegram отклонил сообщение: "
			+ СтрокаJSON(Ответ, "description")
			+ " (чат " + СокрЛП(Строка(ЧатИД)) + ")");
		Возврат Ложь;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Телеграм.Отправлено",
		УровеньЖурналаРегистрации.Информация,
		?(ЗначениеЗаполнено(Заказ), Метаданные.Документы.ЗаказПокупателя, Неопределено),
		Заказ,
		"Чат " + СокрЛП(Строка(ЧатИД)) + Символы.ПС + Текст);

	Возврат Истина;

КонецФункции

// Собирает текст уведомления по заказу: номер, товары, тип оплаты, получатель, телефон.
//
// Параметры:
//  Заказ  - ДокументСсылка.ЗаказПокупателя - заказ.
//  Статус - СправочникСсылка.СтатусыЗаказов - статус для заголовка.
//         - Неопределено
//
// Возвращаемое значение:
//  Строка - текст в разметке HTML (Telegram).
//
Функция ТекстПоЗаказу(Заказ, Знач Статус = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если Статус = Неопределено Тогда
		Статус = Заказ.СтатусЗаказа;
	КонецЕсли;

	Текст = "<b>Заказ № " + HTML(СокрЛП(Заказ.Номер)) + "</b>"
		+ " от " + Формат(Заказ.Дата, "ДФ=dd.MM.yyyy");

	Если ЗначениеЗаполнено(Статус) Тогда
		Текст = Текст + Символы.ПС + "Статус: " + HTML(Строка(Статус));
	КонецЕсли;

	НомерСайта = СокрЛП(Строка(Заказ.НомерЗаказа2ССайта));
	Если Не ПустаяСтрока(НомерСайта) Тогда
		Текст = Текст + Символы.ПС + "Номер на сайте: " + HTML(НомерСайта);
	КонецЕсли;

	Текст = Текст + Символы.ПС + Символы.ПС + "<b>Товар:</b>";

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказТовары.Номенклатура.Наименование КАК Номенклатура,
		|	ЗаказТовары.ХарактеристикаНоменклатуры КАК Характеристика,
		|	ЗаказТовары.Количество КАК Количество,
		|	ЗаказТовары.Цена КАК Цена,
		|	ЗаказТовары.Сумма КАК Сумма
		|ИЗ
		|	Документ.ЗаказПокупателя.Товары КАК ЗаказТовары
		|ГДЕ
		|	ЗаказТовары.Ссылка = &Заказ
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказТовары.НомерСтроки";
	Запрос.УстановитьПараметр("Заказ", Заказ);

	Выборка = Запрос.Выполнить().Выбрать();

	Позиций = 0;
	Пока Выборка.Следующий() Цикл

		Позиций = Позиций + 1;

		// Больше 20 позиций в сообщение не влезет - остальное менеджер смотрит в 1С.
		Если Позиций > 20 Тогда
			Текст = Текст + Символы.ПС + "... и ещё позиции - смотрите заказ в 1С.";
			Прервать;
		КонецЕсли;

		СтрокаТовара = "• " + HTML(СокрЛП(Строка(Выборка.Номенклатура)));

		Если ЗначениеЗаполнено(Выборка.Характеристика) Тогда
			СтрокаТовара = СтрокаТовара + " (" + HTML(СокрЛП(Строка(Выборка.Характеристика))) + ")";
		КонецЕсли;

		СтрокаТовара = СтрокаТовара
			+ " - " + Формат(Выборка.Количество, "ЧДЦ=3; ЧН=0; ЧГ=0") + " шт"
			+ " x " + Формат(Выборка.Цена, "ЧДЦ=2; ЧН=0; ЧГ=0")
			+ " = " + Формат(Выборка.Сумма, "ЧДЦ=2; ЧН=0; ЧГ=0");

		Текст = Текст + Символы.ПС + СтрокаТовара;

	КонецЦикла;

	Если Позиций = 0 Тогда
		Текст = Текст + Символы.ПС + "• (в заказе нет товаров)";
	КонецЕсли;

	Текст = Текст + Символы.ПС + Символы.ПС
		+ "<b>Сумма:</b> " + Формат(Заказ.СуммаДокумента, "ЧДЦ=2; ЧН=0; ЧГ=0") + " грн";

	Если ЗначениеЗаполнено(Заказ.ВидОплатыЗаказа) Тогда
		Текст = Текст + Символы.ПС + "<b>Тип оплаты:</b> " + HTML(Строка(Заказ.ВидОплатыЗаказа));
	КонецЕсли;

	Текст = Текст + Символы.ПС + Символы.ПС + "<b>Получатель:</b>";

	Получатель = СокрЛП(Строка(Заказ.Получатель));
	Если ПустаяСтрока(Получатель) Тогда
		Получатель = СокрЛП(Строка(Заказ.Контрагент));
	КонецЕсли;
	Текст = Текст + Символы.ПС + HTML(Получатель);

	Доставка = АдресДоставки(Заказ);
	Если Не ПустаяСтрока(Доставка) Тогда
		Текст = Текст + Символы.ПС + HTML(Доставка);
	КонецЕсли;

	// Телефон отдельной строкой в международном формате: Telegram сам делает его
	// кликабельным, тап по номеру = звонок.
	Телефон = ТелефонДляЗвонка(Заказ);
	Если Не ПустаяСтрока(Телефон) Тогда
		Текст = Текст + Символы.ПС + Символы.ПС + "Позвонить: " + HTML(Телефон);
	Иначе
		Текст = Текст + Символы.ПС + Символы.ПС + "Телефон не заполнен - смотрите карточку клиента.";
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Выводит в журнал регистрации чаты, которые написали боту (кнопка Start).
// Нужна один раз, чтобы узнать chat_id получателя и вписать его в статус заказа.
// Запускается из консоли кода: ТелеграмБот.ПоказатьНовыеЧаты();
//
// Возвращаемое значение:
//  Строка - тот же список, что и в журнале регистрации.
//
Функция ПоказатьНовыеЧаты() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Токен = ТокенБота();
	Если ПустаяСтрока(Токен) Тогда
		Возврат "Не заполнен токен бота (функция ТокенБота).";
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Токен, "getUpdates", "{""limit"":100}", Неопределено);

	Если Ответ = Неопределено Тогда
		Возврат "Telegram не ответил - смотрите событие журнала ""Телеграм.Ошибка"".";
	КонецЕсли;

	СписокОбновлений = Неопределено;
	Если Не Ответ.Свойство("result", СписокОбновлений) Или ТипЗнч(СписокОбновлений) <> Тип("Массив") Тогда
		Возврат "Telegram вернул неожиданный ответ.";
	КонецЕсли;

	Результат = "";

	Для Каждого Обновление Из СписокОбновлений Цикл

		Сообщение = Неопределено;
		Если Не Обновление.Свойство("message", Сообщение) Или ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Чат = Неопределено;
		Если Не Сообщение.Свойство("chat", Чат) Или ТипЗнч(Чат) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Результат = Результат
			+ "chat_id: " + СтрокаJSON(Чат, "id")
			+ "; " + СтрокаJSON(Чат, "first_name")
			+ " " + СтрокаJSON(Чат, "last_name")
			+ " @" + СтрокаJSON(Чат, "username")
			+ Символы.ПС;

	КонецЦикла;

	Если ПустаяСтрока(Результат) Тогда
		Результат = "Боту никто не писал (или обновления уже вычитаны). "
			+ "Попросите получателя нажать Start и повторите.";
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Телеграм.Чаты",
		УровеньЖурналаРегистрации.Информация, , , Результат);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Токен бота 1С (@BotFather). Зашит в коде, как ключ обмена в ОплатаПоСсылке.
// Если токен придётся перевыпустить - меняется только эта строка.
Функция ТокенБота()

	Возврат "7991351655:AAEvdG50cjIH4WadLmbtcxJ1pqHdgHv8gss";

КонецФункции

// Получатель уведомлений, когда у статуса не заполнен реквизит "Телеграм: чат получателя"
// (например, поле ещё не выведено на форму). Пусто - шлём только по настройке статуса.
Функция ЧатПоУмолчанию()

	Возврат "";

КонецФункции

// Вызывает метод Bot API. Сначала штатным HTTPСоединением, при отказе - через WinHttp:
// в этой базе исходящий HTTPS уже ходит обоими способами (см. ОплатаПоСсылке и БИАС),
// а какой из них доступен на сервере - выяснится только на живой базе.
Функция ВыполнитьЗапрос(Знач Токен, Знач Метод, Знач ТелоЗапроса, Знач Заказ)

	Адрес = "/bot" + Токен + "/" + Метод;
	ТелоОтвета = "";

	Попытка

		Соединение = Новый HTTPСоединение("api.telegram.org", 443, , , , 30,
			Новый ЗащищенноеСоединениеOpenSSL);

		Запрос = Новый HTTPЗапрос(Адрес);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		// Без BOM: с ним Telegram не разбирает JSON.
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");

	Исключение

		ОшибкаHTTPСоединения = ОписаниеОшибки();
		ТелоОтвета = "";

		Попытка

			HTTP = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");
			HTTP.Open("POST", "https://api.telegram.org" + Адрес, Ложь);
			HTTP.SetRequestHeader("Content-Type", "application/json; charset=utf-8");
			HTTP.SetTimeouts(15000, 15000, 30000, 30000);
			HTTP.Send(ТелоЗапроса);

			ТелоОтвета = Строка(HTTP.ResponseText);

		Исключение

			ЗаписатьОшибку(Заказ, "Telegram недоступен (" + Метод + ")."
				+ Символы.ПС + "HTTPСоединение: " + ОшибкаHTTPСоединения
				+ Символы.ПС + "WinHttp: " + ОписаниеОшибки());

			Возврат Неопределено;

		КонецПопытки;

	КонецПопытки;

	Если ПустаяСтрока(СокрЛП(ТелоОтвета)) Тогда
		ЗаписатьОшибку(Заказ, "Telegram вернул пустой ответ (" + Метод + ").");
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		ЗаписатьОшибку(Заказ, "Не удалось разобрать ответ Telegram (" + Метод + "): "
			+ ОписаниеОшибки() + Символы.ПС + Лев(ТелоОтвета, 1000));
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ЗаписатьОшибку(Заказ, "Telegram вернул неожиданный ответ (" + Метод + "): "
			+ Лев(ТелоОтвета, 1000));
		Возврат Неопределено;
	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция ВJSON(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Телефон клиента в формате +380..., пригодном для звонка из Telegram.
Функция ТелефонДляЗвонка(Заказ)

	Телефон = СокрЛП(Строка(Заказ.ТелефонКонтрагента));

	Если ПустаяСтрока(Телефон) Тогда
		Телефон = СокрЛП(ОбщегоНазначения.ТелефонКонтрагента(Заказ.Контрагент));
	КонецЕсли;

	Цифры = "";
	Для Позиция = 1 По СтрДлина(Телефон) Цикл
		Символ = Сред(Телефон, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		ИначеЕсли Символ = ";" Или Символ = "," Тогда
			// В реквизите может лежать несколько номеров - берём первый.
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(Цифры) = 12 И Лев(Цифры, 3) = "380" Тогда
		Возврат "+" + Цифры;
	ИначеЕсли СтрДлина(Цифры) = 10 И Лев(Цифры, 1) = "0" Тогда
		Возврат "+38" + Цифры;
	ИначеЕсли СтрДлина(Цифры) = 9 Тогда
		Возврат "+380" + Цифры;
	КонецЕсли;

	// Формат не распознали - отдаём как есть, менеджер разберётся.
	Возврат ?(ПустаяСтрока(Цифры), "", Телефон);

КонецФункции

Функция АдресДоставки(Заказ)

	Адрес = СокрЛП(Строка(Заказ.АдресДоставки));

	Если ПустаяСтрока(Адрес) И ЗначениеЗаполнено(Заказ.АдресДоставкиНП) Тогда
		Адрес = СокрЛП(Строка(Заказ.АдресДоставкиНП));
	КонецЕсли;

	Возврат Адрес;

КонецФункции

// Экранирует символы, которые Telegram считает разметкой HTML.
Функция HTML(Знач Текст)

	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");

	Возврат Текст;

КонецФункции

Функция СтрокаJSON(Данные, Имя)

	Значение = Неопределено;
	Если Не Данные.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧЦ=20; ЧДЦ=0; ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция БулевоJSON(Данные, Имя)

	Значение = Неопределено;
	Если Не Данные.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	ТекстЗначения = НРег(СокрЛП(Строка(Значение)));
	Возврат ТекстЗначения = "true" Или ТекстЗначения = "1" Или ТекстЗначения = "да";

КонецФункции

Процедура ЗаписатьОшибку(Заказ, Текст)

	ЗаписьЖурналаРегистрации("Телеграм.Ошибка",
		УровеньЖурналаРегистрации.Ошибка,
		?(ЗначениеЗаполнено(Заказ), Метаданные.Документы.ЗаказПокупателя, Неопределено),
		Заказ,
		Текст);

КонецПроцедуры

#КонецОбласти
