// Уведомления менеджеру в Telegram.
//
// Работает через ОТДЕЛЬНОГО бота 1С (не через бота сайта Cvetkovbot):
// у getUpdates может быть только один потребитель, и вебхук сайта мы трогать не можем.
// Токен зашит в функции ТокенБота() - как ключ обмена в ОплатаПоСсылке.
//
// Поводов написать менеджеру три, и настраиваются они порознь:
//
//  1. НОВЫЙ ЗАКАЗ с сайта - УведомитьОНовомЗаказе из ОбменПокупателямиНашСайт
//     сразу после записи документа. Настройки не требует вообще.
//  2. СМЕНА СТАТУСА - УведомитьОСменеСтатуса, сразу после перехода заказа
//     в статус. Получатели: реквизит статуса "Телеграм: чаты при смене статуса".
//     Идёт через очередь ТелеграмОчередь: сам переход происходит в транзакции
//     записи заказа, слать оттуда нельзя.
//  3. ПРОСРОЧКА статуса - УведомитьОЗаказе, когда заказ висит в статусе дольше
//     "Дней в статусе" и БИАС.ПроверкаЗадачь создаёт задачу менеджеру.
//     Получатели: реквизит статуса "Чаты напоминаний" (группа 1 на закладке
//     "Телеграм"); заполнен - шлём всем перечисленным (галка "Напоминать
//     менеджеру в Telegram" тогда не обязательна, она равноценный признак).
//
// Оба реквизита-получателя принимают несколько chat_id через запятую. У каждого
// есть парный реквизит для НЕ розничных заказов - "...кроме розницы" (закладка
// "Остальные"); выбирает набор НастройкиУведомлений().
//
// Второй повод для сообщения - НОВЫЙ заказ с сайта: УведомитьОНовомЗаказе()
// вызывается из ОбменПокупателямиНашСайт.ЗагрузитьЗаказ сразу после записи
// документа, один раз на заказ (повторный файл order-<id>.xml из админки до
// этого места не доходит - заказ уже найден по НомерЗаказа2ССайта).
//
// Розница и остальные заказы (опт, совместные покупки, дропшиппинг, представники)
// настраиваются РАЗДЕЛЬНО: у статуса две закладки, "Розница" и "Остальные", каждая
// со своей галкой и своими чатами. Класс заказа определяет тип цен -
// КодыТиповЦенРозницы(), см. ЭтоРозничныйЗаказ.
//
// По остальным заказам откатов на чужой чат нет: не заполнили им чаты - молчим
// (так было и до разделения, когда они отбрасывались по признаку розницы).
// Розница откаты сохраняет - см. УведомитьОЗаказе.
//
// Карточки уходят КРУГЛОСУТОЧНО (решение пользователя 10.08.2026). Рабочие часы
// (см. РабочееВремя, 9:00-21:00) решают теперь только два вопроса - звук и просрочку:
//
//  - новый заказ и смена статуса - уходят СРАЗУ, в любой час. Ночью Telegram
//    доставляет их беззвучно (disable_notification в ОтправитьСообщение): карточка
//    ложится в чат, но менеджера не будит. До 10.08.2026 они ждали 9:00, и заказ,
//    оформленный в 21:00, менеджер видел только утром - из-за этого правку и делали;
//  - просрочка статуса - по-прежнему только с 9:00: ПроверкаЗадачь ночью задачу
//    менеджеру создаёт, но в Telegram не пишет; первый утренний прогон видит
//    сегодняшнюю задачу без записи в истории и отправляет (см. ЗадачаУведомлена).
//
// Почему просрочку не пустили круглосуточно вместе с остальным: "дней в статусе"
// считается целыми сутками (ЗаказПокупателя.ДнейВСтатусе, НачалоДня), счётчик
// перещёлкивает ровно в полночь - и вся ночная пачка просроченных падала бы
// менеджеру в 00:0x, разом и каждую ночь.
//
// История отправок: регистр сведений ТелеграмУведомления - там же отметка
// "Обработан" (менеджер жмёт кнопку под сообщением, нажатия забирает регламент
// ТелеграмОбмен). Это источник истины. Копия уезжает на сайт, во вкладку
// админки "Уведомления 1С" (ЗеркалитьНаСайт -> shop/cron_manager_notify.php),
// чтобы историю можно было смотреть из браузера; недоступный сайт на отправку
// и на отметку в 1С не влияет.
//
// Телефон клиента выводится отдельной строкой в формате +380... - Telegram сам
// делает его кликабельным (tap = звонок). Кнопкой это сделать нельзя: inline-кнопки
// Telegram принимают только http(s)/tg-ссылки, схему tel: API отклоняет.
//
// ЖИЗНЬ КАРТОЧКИ: чат - зеркало заказов в работе. Карточка висит, пока заказ
// в активном статусе (см. СтатусВРаботе); "Обработан" её НЕ удаляет, а только
// отмечает галкой с датой и именем во всех чатах - второй менеджер видит, что
// звонить не нужно, но заказ остаётся перед глазами. Убирает карточку выход
// заказа из работы: смена статуса (РазобратьОчередь), закрытие задач
// (БИАС.ОтменитьЗадачи) и регламентная СинхронизироватьКарточки; она же
// ВОЗВРАЩАЕТ карточку, если заказ в работе, по нему есть открытая задача,
// а живых сообщений в чатах нет.
//
// Карточка, отправленная ПО ЗАДАЧЕ (просрочка статуса), живёт ровно столько,
// сколько живёт задача: перенесли срок - убираем до дня срока (ЗадачаОтложена),
// закрыли задачу - убираем совсем (ЗадачаКарточкиЗакрыта в СинхронизироватьКарточки).
// Правило пользователя 16.08.2026. Первой карточки нового заказа оно не касается:
// она уходит без задачи вообще и висит по статусу заказа - до отработки или
// до того, как просрочка заведёт задачу (у "Ожидает оплаты" это ДнейВСтатусеРозница,
// сейчас двое суток).
//
// ОДНА КАРТОЧКА НА ЗАКАЗ (12.08.2026, после дублей в чате). Пока по заказу
// висит живая карточка, второго сообщения о нём не будет: просрочка
// (УведомитьОЗаказе) переписывает висящую вместо отправки новой, а регламент
// сверяется с ЕстьЖиваяКарточка свежим запросом. Смена статуса и возврат
// карточки шлют новое сообщение, но перед этим сами снимают старые.
// И наоборот: нет открытой задачи - регламент карточку не воскрешает
// (просьба пользователя: "нет задачи - нет сообщения"). Первой карточки нового
// заказа это не касается, она уходит раньше любой задачи.
//
// Под сообщением кнопки, и все они работают ВНУТРИ этого же сообщения, не плодя
// новых. На первой написан сам статус заказа ("🔄 Ожидает оплаты") - её нажатие
// перечитывает заказ, переписывает сообщение свежими данными и меняет надпись
// на кнопке; "✅ Обработан" ставит отметку. После отметки вторая кнопка
// превращается в подпись с датой, первая продолжает работать.
// Третья, "📋 Задача", появляется только когда по заказу есть открытая задача
// менеджера, и показывает её текст окном - в сообщение он не выводится, чтобы
// не забивать чат.
//
// Название каждого товара - ссылка на его карточку на сайте (см. СсылкаНаТовар):
// менеджер открывает товар и смотрит его перед звонком.
//
// Отдельной строкой в карточке - ЕСТЬ ЛИ ДЕНЬГИ (см. ДанныеОбОплате). "Тип оплаты"
// говорит только о том, как договорились платить, а посылку не отправляют без
// предоплаты, и менеджеру нужно видеть факт до звонка. Оплату карточка ТОЛЬКО
// показывает: платёж в 1С отсюда не создаётся, приём денег в базу остаётся ручным.
// Пришедшую позже оплату карточка подхватывает сама - ОбновитьОплаченныеКарточки()
// в регламенте переписывает висящие в чатах сообщения.
//
// Модального окна с "ОК" на нажатие нет намеренно: сводка показывается всплывашкой,
// которая гаснет сама. Окно менеджеру приходилось закрывать руками на каждый заказ,
// а те же данные и так появляются в сообщении и на кнопке.
//
// Разовая привязка получателя: получатель нажимает Start у бота,
// затем ПоказатьНовыеЧаты() выводит его chat_id в журнал регистрации.
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Отправляет в Telegram уведомление о заказе.
//
// Параметры:
//  Заказ  - ДокументСсылка.ЗаказПокупателя - заказ, о котором уведомляем.
//  Статус - СправочникСсылка.СтатусыЗаказов - статус, чьи настройки берём (чаты получателей).
//         - Неопределено - берём статус самого заказа.
//  ЧатИД  - Строка - явные получатели (один chat_id или несколько через запятую);
//           не задан - берём у статуса чаты того класса заказов, к которому
//           относится этот заказ (розница или остальные).
//  Задача - ЗадачаСсылка.ЗадачиПользователя - задача, в которую кнопка "Обработан"
//           запишет дату обработки. Не задана - кнопка просто отмечает сообщение.
//
// Возвращаемое значение:
//  Булево - сообщение принято Telegram хотя бы одним получателем. Истина также
//           когда карточка по заказу уже висит в чате: второй не шлём, обновляем
//           существующую (см. первое условие в теле).
//
Функция УведомитьОЗаказе(Заказ, Знач Статус = Неопределено, Знач ЧатИД = "",
	Знач Задача = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	// По заказу уже висит живая карточка - второй такой же в чате быть не должно
	// (12.08.2026: менеджер получал два одинаковых сообщения подряд).
	//
	// Это единственный отправитель, который слал вслепую: остальные либо сперва
	// снимают старые карточки (смена статуса, возврат), либо спрашивают
	// ЕстьЖиваяКарточка (регламент, перезаливка). Своя защита здесь привязана
	// к задаче (БИАС.ПроверкаЗадачь) и рвётся, как только по заказу заводится
	// вторая задача - прежнюю закрыли, сменился исполнитель - или запись
	// в историю отправки не легла, и ЗадачаУведомлена не видит первого сообщения.
	//
	// Вместо второй карточки обновляем ту, что уже висит, и привязываем к ней
	// задачу: кнопки под сообщением начнут писать в неё, а ЗадачаУведомлена
	// со следующего прогона вернёт Истина - сюда больше не зайдём.
	Если ЕстьЖиваяКарточка(Заказ) Тогда

		Токен = ТокенБота();

		Если Не ПустаяСтрока(Токен) Тогда
			ПерерисоватьКарточкиЗаказа(Токен, Заказ);
		КонецЕсли;

		ПривязатьЗадачуККарточкам(Заказ, Задача);

		ЗаписьЖурналаРегистрации("Телеграм.Отправлено",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.ЗаказПокупателя, Заказ,
			"Карточка по заказу уже висит в чате - вместо второй обновлена существующая.");

		Возврат Истина;

	КонецЕсли;

	Если Статус = Неопределено Тогда
		Статус = Заказ.СтатусЗаказа;
	КонецЕсли;

	ЭтоРозница = ЭтоРозничныйЗаказ(Заказ);

	Если ПустаяСтрока(ЧатИД) Тогда
		ЧатИД = НастройкиУведомлений(Статус, ЭтоРозница).Чаты;
	КонецЕсли;

	Если Не ЭтоРозница Тогда

		// Опт, СП, дропшиппинг и представники: получатели только свои, откатов нет.
		// Иначе оптовый заказ уехал бы в розничный чат, где ждут звонков покупателям.
		// Пусто - молчим, ровно как до появления закладки "Остальные".
		Если ПустаяСтрока(ЧатИД) Тогда
			Возврат Ложь;
		КонецЕсли;

	Иначе

		// У статуса стоит галка, а чаты не заполнены - берём их оттуда, где заполнены.
		// Без этого отката новый статус молчал бы, пока ему не впишут chat_id руками.
		Если ПустаяСтрока(ЧатИД) Тогда
			ЧатИД = ПервыйНастроенныйЧат();
		КонецЕсли;

		// Последний рубеж: получателя можно задать прямо в коде.
		Если ПустаяСтрока(ЧатИД) Тогда
			ЧатИД = ЧатПоУмолчанию();
		КонецЕсли;

		Если ПустаяСтрока(ЧатИД) Тогда
			ЗаписатьОшибку(Заказ, "Не заполнены ""Телеграм: чаты"" ни у одного статуса"
				+ " (проверялся и статус " + Строка(Статус) + ")"
				+ " - уведомление не отправлено.");
			Возврат Ложь;
		КонецЕсли;

	КонецЕсли;

	Возврат ОтправитьВЧаты(ЧатИД, ТекстПоЗаказу(Заказ, Статус), Заказ,
		"ПросрочкаСтатуса", Задача);

КонецФункции

// Отправляет в Telegram уведомление о новом заказе с сайта - чтобы менеджер позвонил.
// Вызывается из ОбменПокупателямиНашСайт.ЗагрузитьЗаказ сразу после записи документа.
//
// По розничному заказу получатель ищется по цепочке: явный параметр ->
// ЧатНовыхЗаказов() -> чат статуса заказа -> первый чат, настроенный в справочнике
// "Статусы заказов" -> ЧатПоУмолчанию(). По остальным заказам берём только чаты
// закладки "Остальные" у статуса; пусто - не шлём.
//
// Время суток отправку не откладывает: ночной заказ уходит сразу, Telegram доставит
// его беззвучно (см. шапку модуля). Возвращаемое значение вызывающая сторона
// (ОбменПокупателямиНашСайт) не проверяет - для неё это не ошибка.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - только что загруженный заказ.
//  ЧатИД - Строка - явный получатель.
//
// Возвращаемое значение:
//  Булево - сообщение принято Telegram.
//
Функция УведомитьОНовомЗаказе(Заказ, Знач ЧатИД = "") Экспорт

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	// Нет задачи с наступившим напоминанием - нет и карточки: правило одно
	// на все поводы отправки (16.08.2026, см. шапку модуля). Заказ с сайта сюда
	// попадает сразу после записи документа, а задачу по статусу к этому моменту
	// уже завела ЗаказПокупателя.ПроверитьСтатус - в норме проверка проходит.
	// Не прошла - значит по заказу менеджеру ничего не поручено, и карточку
	// вернёт регламент в тот момент, когда задача появится.
	Если Не ЕстьАктуальнаяЗадача(Заказ) Тогда

		ЗаписьЖурналаРегистрации("Телеграм.Отправлено",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.ЗаказПокупателя, Заказ,
			"Карточка нового заказа не отправлена: по заказу нет задачи"
			+ " с наступившим напоминанием.");

		Возврат Ложь;

	КонецЕсли;

	ЭтоРозница = ЭтоРозничныйЗаказ(Заказ);

	Если ПустаяСтрока(ЧатИД) И ЭтоРозница Тогда
		ЧатИД = ЧатНовыхЗаказов();
	КонецЕсли;

	Если ПустаяСтрока(ЧатИД) Тогда
		ЧатИД = НастройкиУведомлений(Заказ.СтатусЗаказа, ЭтоРозница).Чаты;
	КонецЕсли;

	Если Не ЭтоРозница Тогда

		// Оптовый НОВЫЙ заказ приходит в "Ожидает оплаты", а чаты опта обычно
		// настроены у "Продано" - без этого шага такой заказ молчал бы вовсе.
		// Поэтому пустые настройки своего статуса добираем из "Продано"
		// (закладка Телеграм - Остальные): новый опт живёт по его правилам.
		Если ПустаяСтрока(ЧатИД) Тогда
			ЧатИД = ЧатыОптаКакПродано(Заказ.СтатусЗаказа);
		КонецЕсли;

		// По не розничным заказам иных откатов нет (см. УведомитьОЗаказе).
		Если ПустаяСтрока(ЧатИД) Тогда
			Возврат Ложь;
		КонецЕсли;

	Иначе

		Если ПустаяСтрока(ЧатИД) Тогда
			ЧатИД = ПервыйНастроенныйЧат();
		КонецЕсли;

		Если ПустаяСтрока(ЧатИД) Тогда
			ЧатИД = ЧатПоУмолчанию();
		КонецЕсли;

		Если ПустаяСтрока(ЧатИД) Тогда
			ЗаписатьОшибку(Заказ, "Некому отправить уведомление о новом заказе: ни у одного"
				+ " статуса не заполнены ""Телеграм: чаты"".");
			Возврат Ложь;
		КонецЕсли;

	КонецЕсли;

	Текст = ТекстПоЗаказу(Заказ, Заказ.СтатусЗаказа, ЗаголовокПоВиду("НовыйЗаказ", Заказ));

	Возврат ОтправитьВЧаты(ЧатИД, Текст, Заказ, "НовыйЗаказ");

КонецФункции

// Отправляет в Telegram уведомление о переходе заказа в статус.
//
// Второй сценарий, в отличие от УведомитьОЗаказе: та шлёт по ПРОСРОЧКЕ статуса
// ("висит дольше нормы"), эта - СРАЗУ после перехода. Получатели берутся из
// отдельного реквизита статуса "Телеграм: чаты при смене статуса"; пусто -
// при смене молчим. Общего отката на чужой чат здесь намеренно нет: иначе
// смена статуса начала бы сыпаться туда, где ждут только просрочки.
//
// Вызывается регламентом ТелеграмОбмен из очереди, а не из записи документа.
//
// Параметры:
//  Заказ  - ДокументСсылка.ЗаказПокупателя - заказ.
//  Статус - СправочникСсылка.СтатусыЗаказов - статус, В который перешли.
//
// Возвращаемое значение:
//  Булево - сообщение принято хотя бы одним чатом.
//
Функция УведомитьОСменеСтатуса(Заказ, Знач Статус) Экспорт

	Если Не ЗначениеЗаполнено(Заказ) Или Не ЗначениеЗаполнено(Статус) Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Чаты = НастройкиУведомлений(Статус, ЭтоРозничныйЗаказ(Заказ)).ЧатыСмены;

	Если ПустаяСтрока(Чаты) Тогда
		Возврат Ложь;
	КонецЕсли;

	// То же правило, что и везде: карточка идёт в чат только под задачу
	// с наступившим напоминанием. Возвращаем Истина, чтобы запись ушла
	// из очереди: повод разобран, слать по нему нечего.
	Если Не ЕстьАктуальнаяЗадача(Заказ) Тогда

		ЗаписьЖурналаРегистрации("Телеграм.Отправлено",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.ЗаказПокупателя, Заказ,
			"Карточка о смене статуса не отправлена: по заказу нет задачи"
			+ " с наступившим напоминанием." + Символы.ПС
			+ "Статус: " + СокрЛП(Строка(Статус)));

		Возврат Истина;

	КонецЕсли;

	Текст = ТекстПоЗаказу(Заказ, Статус, ЗаголовокПоВиду("СменаСтатуса"));

	// Прежние карточки этого заказа убираем ДО отправки новой: чат для
	// менеджера - очередь работы, а не журнал. История никуда не девается,
	// она лежит в регистре ТелеграмУведомления и во вкладке админки сайта.
	УбратьКарточкиЗаказа(ТокенБота(), Заказ);

	Возврат ОтправитьВЧаты(Чаты, Текст, Заказ, "СменаСтатуса");

КонецФункции

// Возвращает карточку заказа в чат после того, как её оттуда убрали.
//
// Убирают карточку выход заказа из работы (смена статуса, закрытие задач,
// регламент СинхронизироватьКарточки) и кнопки в чате по неактуальному заказу.
// Если заказ всё же нужно вернуть менеджеру - карточку восстанавливает эта
// функция: руками из админки сайта, вкладка "Уведомления 1С"
// (HTTPСервис.ТелеграмВебхук, шаблон /cmd), и автоматически - регламентом,
// когда у заказа в работе не осталось ни одной живой карточки.
//
// Получателей берём ТЕ ЖЕ, где карточка висела раньше - из регистра
// ТелеграмУведомления, но только те из них, которым положен класс этого заказа
// (см. ТолькоЧатыКласса): история могла накопить чужие чаты, и без фильтра
// возврат разносил бы розницу по оптовым чатам. Ничего не осталось или истории
// нет вовсе - разбираем чаты обычным порядком, как для нового заказа.
//
// Отказ "не розница - не шлём" здесь намеренно НЕ применяется: карточку вернули
// руками и осознанно, спорить с человеком незачем. Оптовая карточка уйдёт
// в оптовые чаты, розничная - в розничные.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), Чаты (Строка), Ошибка (Строка).
//
Функция ВернутьКарточку(Заказ) Экспорт

	Результат = Новый Структура("Успех, Чаты, Ошибка", Ложь, "", "");

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Результат.Ошибка = "Заказ не указан.";
		Возврат Результат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	ЭтоРозница = ЭтоРозничныйЗаказ(Заказ);

	Чаты = ТолькоЧатыКласса(ЧатыИзИстории(Заказ), ЭтоРозница);

	Если ПустаяСтрока(Чаты) Тогда
		Чаты = ЧатыКлассаЗаказа(ЭтоРозница);
	КонецЕсли;

	// Дальше только розничные запасные ходы: по не розничным заказам получатели
	// всегда свои, откатов на чужой чат нет (см. УведомитьОЗаказе).
	Если ПустаяСтрока(Чаты) И ЭтоРозница Тогда
		Чаты = ЧатНовыхЗаказов();
	КонецЕсли;

	Если ПустаяСтрока(Чаты) И ЭтоРозница Тогда
		Чаты = ЧатПоУмолчанию();
	КонецЕсли;

	Если ПустаяСтрока(Чаты) Тогда
		Результат.Ошибка = "Некому отправить: у статусов не заполнены ""Телеграм: чаты"""
			+ " на закладке " + ?(ЭтоРозница, """Розница""", """Остальные""") + ".";
		Возврат Результат;
	КонецЕсли;

	Результат.Чаты = Чаты;

	// Если какая-то карточка всё-таки ещё висит (убрали не везде, удаление
	// не прошло) - снимаем её, иначе в чате окажется две одинаковых.
	УбратьКарточкиЗаказа(ТокенБота(), Заказ);

	Текст = ТекстПоЗаказу(Заказ, Заказ.СтатусЗаказа, ЗаголовокПоВиду("Возврат"));

	Результат.Успех = ОтправитьВЧаты(Чаты, Текст, Заказ, "Возврат");

	Если Не Результат.Успех Тогда
		Результат.Ошибка = "Telegram не принял сообщение - смотрите событие"
			+ " журнала ""Телеграм.Ошибка"".";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Получатели перезаливки: чаты, настроенные для РОЗНИЦЫ хоть у одного статуса.
// Перезаливка шлёт только розничные заказы (фильтр в самом цикле), поэтому и
// получатели у неё розничные.
//
// До 10.08.2026 здесь брались "все чаты, куда бот когда-либо слал карточки",
// то есть регистр ТелеграмУведомления целиком. Это ломало разделение опт/розница:
// чат, получивший одну оптовую карточку, попадал в список навсегда и на каждом
// /reload получал ВСЮ розницу. Так розничные заказы и оказались в оптовом чате.
//
// Пусто (чаты нигде не заполнены) - откатываемся теми же ступенями, что и
// УведомитьОНовомЗаказе: иначе перезаливка на чистой базе не нашла бы никого.
Функция ЧатыПерезаливки()

	Результат = ЧатыКлассаЗаказа(Истина);

	Если ПустаяСтрока(Результат) Тогда
		Результат = ЧатНовыхЗаказов();
	КонецЕсли;

	Если ПустаяСтрока(Результат) Тогда
		Результат = ЧатПоУмолчанию();
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Все чаты, настроенные для этого класса заказов, - объединение по ВСЕМ статусам,
// списком через запятую. Розница берёт свои реквизиты (ТелеграмЧат,
// ТелеграмЧатСмены), опт и прочие - свои ("...Остальные"); наборы не смешиваются,
// в этом весь смысл разделения на закладки.
//
// Нужна там, где получателей ищут не под конкретный статус, а под класс заказа:
// перезаливка чатов и возврат карточки. Историю отправок для этого использовать
// нельзя - см. ЧатыПерезаливки.
//
// Параметры:
//  ЭтоРозница - Булево - какой набор реквизитов читать.
//
// Возвращаемое значение:
//  Строка - chat_id через запятую, без дублей; пусто - ни у одного статуса не задан.
//
Функция ЧатыКлассаЗаказа(Знач ЭтоРозница)

	Запрос = Новый Запрос;

	Если ЭтоРозница Тогда

		Запрос.Текст =
			"ВЫБРАТЬ
			|	СтатусыЗаказов.ТелеграмЧат      КАК Чаты,
			|	СтатусыЗаказов.ТелеграмЧатСмены КАК ЧатыСмены
			|ИЗ
			|	Справочник.СтатусыЗаказов КАК СтатусыЗаказов
			|ГДЕ
			|	НЕ СтатусыЗаказов.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	СтатусыЗаказов.Код";

	Иначе

		Запрос.Текст =
			"ВЫБРАТЬ
			|	СтатусыЗаказов.ТелеграмЧатОстальные      КАК Чаты,
			|	СтатусыЗаказов.ТелеграмЧатСменыОстальные КАК ЧатыСмены
			|ИЗ
			|	Справочник.СтатусыЗаказов КАК СтатусыЗаказов
			|ГДЕ
			|	НЕ СтатусыЗаказов.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	СтатусыЗаказов.Код";

	КонецЕсли;

	Результат    = "";
	Добавленные  = Новый Соответствие;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Для Каждого Чат Из ЧатыСписком(Строка(Выборка.Чаты) + "," + Строка(Выборка.ЧатыСмены)) Цикл

			Если Добавленные.Получить(Чат) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Добавленные.Вставить(Чат, Истина);

			Результат = Результат + ?(ПустаяСтрока(Результат), "", ",") + Чат;

		КонецЦикла;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Оставляет из списка чатов только те, которым положен этот класс заказов.
// Чужие отбрасываем молча: список приходит из истории отправок, а она могла
// накопить получателей другого класса (см. ЧатыПерезаливки).
//
// Параметры:
//  Чаты       - Строка - chat_id через запятую.
//  ЭтоРозница - Булево - класс заказа.
//
// Возвращаемое значение:
//  Строка - что осталось; пусто - подходящих получателей в списке не было.
//
Функция ТолькоЧатыКласса(Знач Чаты, Знач ЭтоРозница)

	Если ПустаяСтрока(СокрЛП(Строка(Чаты))) Тогда
		Возврат "";
	КонецЕсли;

	Разрешенные = Новый Соответствие;

	Для Каждого Чат Из ЧатыСписком(ЧатыКлассаЗаказа(ЭтоРозница)) Цикл
		Разрешенные.Вставить(Чат, Истина);
	КонецЦикла;

	Результат = "";

	Для Каждого Чат Из ЧатыСписком(Чаты) Цикл

		Если Разрешенные.Получить(Чат) = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Результат = Результат + ?(ПустаяСтрока(Результат), "", ",") + Чат;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Чаты, в которых карточка этого заказа уже показывалась, списком через запятую.
// Пусто - по заказу в Telegram ещё не писали.
Функция ЧатыИзИстории(Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТелеграмУведомления.Чат КАК Чат
		|ИЗ
		|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
		|ГДЕ
		|	ТелеграмУведомления.Заказ = &Заказ
		|	И ТелеграмУведомления.Чат <> """"";
	Запрос.УстановитьПараметр("Заказ", Заказ);

	Результат = "";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если Не ПустаяСтрока(Результат) Тогда
			Результат = Результат + ",";
		КонецЕсли;

		Результат = Результат + СокрЛП(Строка(Выборка.Чат));

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заказ по номеру документа. Номер приходит с сайта как есть - и с ведущими
// нулями ("00000027660"), и без них: сайт хранит его в order_id_1c обрезанным.
// Поэтому ищем по обоим написаниям.
//
// Параметры:
//  Номер - Строка - номер заказа покупателя.
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказПокупателя - найденный заказ;
//  Неопределено                   - не найден.
//
Функция ЗаказПоНомеру(Знач Номер) Экспорт

	Номер = СокрЛП(Строка(Номер));

	Если ПустаяСтрока(Номер) Тогда
		Возврат Неопределено;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	// Длина номера в метаданных фиксирована, поэтому дополняем нулями слева
	// до неё же, а не до магического числа.
	Длина = Метаданные.Документы.ЗаказПокупателя.ДлинаНомера;
	СНулями = Номер;

	Пока СтрДлина(СНулями) < Длина Цикл
		СНулями = "0" + СНулями;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказПокупателя.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.Номер В (&Номер, &СНулями)
		|	И НЕ ЗаказПокупателя.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказПокупателя.Дата УБЫВ";
	Запрос.УстановитьПараметр("Номер",   Номер);
	Запрос.УстановитьПараметр("СНулями", СНулями);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Удаляет из всех чатов сообщения по заказу: карточку заказа больше не видно
// ни у кого. Записи регистра остаются и помечаются убранными - это наша
// история отправок, а "следов не нужно" относится к чату, не к базе.
//
// Право на удаление у бота должно быть админским ("Удаление сообщений"):
// без него Telegram позволяет удалять только свои сообщения моложе 48 часов,
// и старые карточки останутся висеть. Отказ на одном сообщении не мешает
// остальным - его могли удалить в чате руками.
//
// Параметры:
//  Токен - Строка - токен бота.
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ.
//
Процедура УбратьКарточкиЗаказа(Знач Токен, Знач Заказ) Экспорт

	Если Не ЗначениеЗаполнено(Заказ) Или ПустаяСтрока(Токен) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ТелеграмУведомления.Чат            КАК Чат,
			|	ТелеграмУведомления.НомерСообщения КАК НомерСообщения
			|ИЗ
			|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
			|ГДЕ
			|	ТелеграмУведомления.Заказ = &Заказ
			|	И НЕ ТелеграмУведомления.Убрано";
		Запрос.УстановитьПараметр("Заказ", Заказ);

		Выборка = Запрос.Выполнить().Выбрать();

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось получить список сообщений заказа: " + ОписаниеОшибки());
		Возврат;

	КонецПопытки;

	Пока Выборка.Следующий() Цикл

		ЧатСтрокой = СокрЛП(Строка(Выборка.Чат));

		Если ПустаяСтрока(ЧатСтрокой) Или Выборка.НомерСообщения = 0 Тогда
			Продолжить;
		КонецЕсли;

		Параметры = Новый Структура;
		Параметры.Вставить("chat_id", ЧатСтрокой);
		Параметры.Вставить("message_id", Выборка.НомерСообщения);

		ВыполнитьЗапрос(Токен, "deleteMessage", ВJSON(Параметры), Неопределено);

		// Помечаем в истории: по признаку "Убрано" регламент отличает живую
		// карточку от удалённой и не пытается править то, чего в чате нет.
		ПометитьУбранным(Заказ, ЧатСтрокой, Выборка.НомерСообщения);

	КонецЦикла;

КонецПроцедуры

// Ставит записи регистра признак "убрано": сообщения уже нет в чате,
// править его больше незачем, а восстановлению (СинхронизироватьКарточки)
// такая запись живой карточкой не считается. Отметку "Обработан" не трогаем -
// это отдельный факт про менеджера, а не про сообщение.
Процедура ПометитьУбранным(Знач Заказ, Знач ЧатИД, Знач НомерСообщения)

	Попытка

		Запись = РегистрыСведений.ТелеграмУведомления.СоздатьМенеджерЗаписи();
		Запись.Заказ          = Заказ;
		Запись.Чат            = Лев(СокрЛП(Строка(ЧатИД)), 32);
		Запись.НомерСообщения = НомерСообщения;
		Запись.Прочитать();

		Если Не Запись.Выбран() Тогда
			Возврат;
		КонецЕсли;

		Запись.Убрано = Истина;
		Запись.Записать(Истина);

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось пометить убранное сообщение: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Убирает из чатов ВСЕ живые сообщения бота разом - команда "clearchat"
// из админки сайта (вкладка "Уведомления 1С", кнопка "Удалить все из Telegram").
//
// Удаляется только то, что бот сам отправлял и записал в регистр
// ТелеграмУведомления: перечислить чужие сообщения чата Bot API не умеет.
// Запись помечается убранной независимо от ответа Telegram - отказ обычно
// значит, что сообщение уже удалили руками, и держать его "живым" в истории
// означало бы вечно пытаться его править.
//
// Карточки заказов, которые ещё в работе, регламент (СинхронизироватьКарточки)
// после чистки отправит заново свежими - это его работа, а не сбой чистки:
// чат сжимается до актуального, а не глохнет насовсем.
//
// Возвращаемое значение:
//  Структура:
//   * Успех   - Булево - список сообщений прочитан и обработан;
//   * Всего   - Число  - живых записей в истории;
//   * Удалено - Число  - удалений, подтверждённых Telegram;
//   * Ошибка  - Строка - текст, когда Успех = Ложь.
//
Функция УбратьВсеСообщения() Экспорт

	Результат = Новый Структура("Успех, Всего, Удалено, Ошибка", Ложь, 0, 0, "");

	УстановитьПривилегированныйРежим(Истина);

	Токен = ТокенБота();

	Если ПустаяСтрока(Токен) Тогда
		Результат.Ошибка = "Не заполнен токен бота.";
		Возврат Результат;
	КонецЕсли;

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ТелеграмУведомления.Заказ          КАК Заказ,
			|	ТелеграмУведомления.Чат            КАК Чат,
			|	ТелеграмУведомления.НомерСообщения КАК НомерСообщения
			|ИЗ
			|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
			|ГДЕ
			|	НЕ ТелеграмУведомления.Убрано
			|	И ТелеграмУведомления.НомерСообщения <> 0
			|	И ТелеграмУведомления.Чат <> """"";

		Выборка = Запрос.Выполнить().Выбрать();

	Исключение
		Результат.Ошибка = "Не удалось получить список сообщений: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Пока Выборка.Следующий() Цикл

		Результат.Всего = Результат.Всего + 1;

		ЧатСтрокой = СокрЛП(Строка(Выборка.Чат));

		Параметры = Новый Структура;
		Параметры.Вставить("chat_id",    ЧатСтрокой);
		Параметры.Вставить("message_id", Выборка.НомерСообщения);

		Ответ = ВыполнитьЗапрос(Токен, "deleteMessage", ВJSON(Параметры), Выборка.Заказ);

		Если Ответ <> Неопределено И БулевоJSON(Ответ, "ok") Тогда
			Результат.Удалено = Результат.Удалено + 1;
		КонецЕсли;

		ПометитьУбранным(Выборка.Заказ, ЧатСтрокой, Выборка.НомерСообщения);

	КонецЦикла;

	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Перезаливает чаты: убирает все живые сообщения бота и следом отправляет
// свежие карточки по ВСЕМ актуальным заказам во ВСЕ чаты подписчиков -
// команда "resendall" из админки сайта и /reload из чата.
//
// Это ручной аналог работы регламента (СинхронизироватьКарточки), но разом
// и без его лимитов на прогон: чаты сразу приходят к виду "только актуальные
// заказы, карточки свежие, все внизу чата".
//
// Что изменилось 10.08.2026 (просьба пользователя "полностью перезаливает
// актуальным все чаты подписчиков"):
//
//  - ИСТОЧНИК - не история отправок, а сами заказы. Раньше брались только те,
//    по которым карточка уже была за 30 дней, - заказ, заведённый менеджером
//    в 1С, в перезаливку не попадал никогда, потому что в чат не отправлялся.
//  - ПОЛУЧАТЕЛИ - все РОЗНИЧНЫЕ чаты статусов, а не только те, где висела
//    карточка ИМЕННО этого заказа: второй менеджер видел у себя не весь набор
//    заказов, а свой исторический кусок. Список даёт ЧатыПерезаливки; брать его
//    из истории отправок, как делали до вечера 10.08.2026, нельзя - розница
//    расползалась по оптовым чатам.
//
// Окно - 180 дней по дате заказа, за прогон не больше 50 карточек: чат
// принимает столько без риска попасть под ограничение Telegram на частые
// сообщения. Что не влезло - уедет следующим запуском, о чём пишем в журнал.
//
// Возвращаемое значение:
//  Структура:
//   * Успех      - Булево - чистка и перезаливка отработали;
//   * Убрано     - Число  - удалений, подтверждённых Telegram;
//   * Отправлено - Число  - заказов, чьи карточки отправлены заново;
//   * Ошибка     - Строка - текст, когда Успех = Ложь.
//
Функция ПерезалитьВсеКарточки() Экспорт

	Результат = Новый Структура("Успех, Убрано, Отправлено, Ошибка", Ложь, 0, 0, "");

	УстановитьПривилегированныйРежим(Истина);

	Чистка = УбратьВсеСообщения();

	Если Не Чистка.Успех Тогда
		Результат.Ошибка = Чистка.Ошибка;
		Возврат Результат;
	КонецЕсли;

	Результат.Убрано = Чистка.Удалено;

	Чаты = ЧатыПерезаливки();

	Если ПустаяСтрока(Чаты) Тогда
		Результат.Ошибка = "Некому отправить: ни у одного статуса не заполнены"
			+ " ""Телеграм: чаты"" на закладке ""Розница"".";
		Возврат Результат;
	КонецЕсли;

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ЗаказПокупателя.Ссылка       КАК Заказ,
			|	ЗаказПокупателя.СтатусЗаказа КАК Статус
			|ИЗ
			|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
			|ГДЕ
			|	НЕ ЗаказПокупателя.ПометкаУдаления
			|	И ЗаказПокупателя.Проведен
			|	И ЗаказПокупателя.Дата >= &СДаты
			|УПОРЯДОЧИТЬ ПО
			|	ЗаказПокупателя.Дата";

		Запрос.УстановитьПараметр("СДаты", НачалоДня(ТекущаяДата()) - 180 * 86400);

		Выборка = Запрос.Выполнить().Выбрать();

	Исключение
		Результат.Ошибка = "Не удалось получить список заказов: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Пропущено = 0;

	Пока Выборка.Следующий() Цикл

		Если Не СтатусВРаботе(Выборка.Статус) Тогда
			Продолжить;
		КонецЕсли;

		// В чат шлём только розницу - как и при обычной отправке
		// (НастройкиУведомлений). ВернутьКарточку этот фильтр намеренно
		// не применяет (ручной возврат из админки - осознанный), поэтому
		// без проверки здесь перезаливка воскрешала бы карточки оптовых
		// заказов, которые когда-то попали в чат.
		Если Не ЭтоРозничныйЗаказ(Выборка.Заказ) Тогда
			Продолжить;
		КонецЕсли;

		// Нет задачи с наступившим напоминанием - карточку не воскрешаем:
		// перезаливка возвращает в чат то, что там должно быть сейчас, а не
		// всё, что там когда-то было. Появится задача - карточку вернёт
		// регламент (СинхронизироватьКарточки).
		Если Не ЕстьАктуальнаяЗадача(Выборка.Заказ) Тогда
			Продолжить;
		КонецЕсли;

		// Перепроверка свежим запросом: пока прогон шёл, регламент
		// (СинхронизироватьКарточки) мог успеть прислать карточку этого же
		// заказа - без проверки в чате оказывались две одинаковых.
		Если ЕстьЖиваяКарточка(Выборка.Заказ) Тогда
			Продолжить;
		КонецЕсли;

		// Лимит на прогон: остальное подхватит следующий запуск. Молча резать
		// нельзя - "перезалито" без оговорки читается как "перезалито всё".
		Если Результат.Отправлено >= 50 Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;

		Попытка

			Текст = ТекстПоЗаказу(Выборка.Заказ, Выборка.Статус,
				ЗаголовокПоВиду("Возврат"));

			Отправлено = ОтправитьВЧаты(Чаты, Текст, Выборка.Заказ, "Возврат");

		Исключение
			ЗаписатьОшибку(Выборка.Заказ,
				"Карточка при перезаливке не отправлена: " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;

		Если Отправлено Тогда
			Результат.Отправлено = Результат.Отправлено + 1;
		КонецЕсли;

	КонецЦикла;

	Если Пропущено > 0 Тогда

		ЗаписьЖурналаРегистрации("Телеграм.Перезаливка",
			УровеньЖурналаРегистрации.Предупреждение, , ,
			"Перезаливка упёрлась в лимит 50 карточек за прогон: не отправлено "
			+ Пропущено + " заказов. Запустите /reload ещё раз.");

	КонецЕсли;

	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

// Есть ли у заказа живая (не убранная) карточка в чатах - свежим запросом,
// а не по снимку, с которым идёт вызывающий цикл: перезаливка из админки и
// регламент работают одновременно, и решение "слать или нет" должно
// приниматься по текущему состоянию регистра.
Функция ЕстьЖиваяКарточка(Знач Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТелеграмУведомления.НомерСообщения КАК НомерСообщения
		|ИЗ
		|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
		|ГДЕ
		|	ТелеграмУведомления.Заказ = &Заказ
		|	И НЕ ТелеграмУведомления.Убрано
		|	И ТелеграмУведомления.НомерСообщения <> 0";
	Запрос.УстановитьПараметр("Заказ", Заказ);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Отправляет одно и то же сообщение всем получателям из списка и один раз
// дублирует событие на сайт.
//
// Параметры:
//  Чаты           - Строка - один chat_id или несколько через запятую
//                   (принимаются также ";", пробел и перенос строки).
//  Текст          - Строка - текст в разметке HTML (Telegram).
//  Заказ          - ДокументСсылка.ЗаказПокупателя - заказ.
//  ВидУведомления - Строка - "НовыйЗаказ" / "ПросрочкаСтатуса".
//  Задача         - ЗадачаСсылка.ЗадачиПользователя - куда кнопка запишет дату.
//                 - Неопределено
//
// Возвращаемое значение:
//  Булево - сообщение принято хотя бы одним чатом.
//
Функция ОтправитьВЧаты(Знач Чаты, Знач Текст, Знач Заказ,
	Знач ВидУведомления = "", Знач Задача = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	СписокЧатов = ЧатыСписком(Чаты);

	Если СписокЧатов.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Отправлено = Ложь;

	Для Каждого Чат Из СписокЧатов Цикл

		// Один недоступный чат (бот заблокирован, опечатка в chat_id) не должен
		// лишать сообщения остальных получателей.
		Если ОтправитьСообщение(Чат, Текст, Заказ, ВидУведомления, Задача) Тогда
			Отправлено = Истина;
		КонецЕсли;

	КонецЦикла;

	// На сайт кладём ОДНУ строку на уведомление, а не на каждого получателя:
	// в журнале админки это одно событие. В регистре ТелеграмУведомления,
	// наоборот, строка на каждое сообщение - там ключом идёт чат + message_id,
	// и кнопка "Обработан" должна находить именно своё сообщение.
	Если Отправлено Тогда
		ЗеркалитьНаСайт(Заказ, ВидУведомления, Текст);
	КонецЕсли;

	Возврат Отправлено;

КонецФункции

// Отправляет произвольное сообщение в Telegram ОДНОМУ получателю и пишет его
// в историю (регистр ТелеграмУведомления). Нескольким получателям сразу -
// ОтправитьВЧаты: она же дублирует событие на сайт.
//
// Параметры:
//  ЧатИД          - Строка - chat_id получателя (ровно один).
//  Текст          - Строка - текст сообщения в разметке HTML (Telegram), не длиннее 4096 символов.
//  Заказ          - ДокументСсылка.ЗаказПокупателя - для журнала регистрации и кнопки "Обработан".
//                 - Неопределено
//  ВидУведомления - Строка - "НовыйЗаказ" / "ПросрочкаСтатуса" / "" - для истории отправок.
//                   Пустой вид - сообщение без кнопки и без записи в историю.
//  Задача         - ЗадачаСсылка.ЗадачиПользователя - куда кнопка запишет дату обработки.
//                 - Неопределено
//
// Возвращаемое значение:
//  Булево - сообщение принято Telegram.
//
Функция ОтправитьСообщение(Знач ЧатИД, Знач Текст, Знач Заказ = Неопределено,
	Знач ВидУведомления = "", Знач Задача = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Токен = ТокенБота();
	Если ПустаяСтрока(Токен) Тогда
		ЗаписатьОшибку(Заказ, "Не заполнен токен бота (функция ТокенБота).");
		Возврат Ложь;
	КонецЕсли;

	Если ПустаяСтрока(СокрЛП(Текст)) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Лимит Telegram на длину сообщения - 4096 символов.
	Если СтрДлина(Текст) > 4000 Тогда
		Текст = Лев(Текст, 3990) + "...";
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("text", Текст);
	Параметры.Вставить("parse_mode", "HTML");
	Параметры.Вставить("disable_web_page_preview", Истина);

	// Штатно вне рабочих часов отправки не происходит вовсе (уведомления ждут утра),
	// так что здесь почти всегда Ложь. Флаг оставлен страховкой: если сообщение всё же
	// уйдёт ночью - ручным запуском регламента или из другого места - оно придёт
	// беззвучно и менеджера не разбудит.
	Параметры.Вставить("disable_notification", Не РабочееВремя());

	// Кнопка "Обработан" имеет смысл только по конкретному заказу: в callback_data
	// уезжает его уникальный идентификатор, по нему ПолучитьОтветы() находит заказ
	// и задачу. Лимит Telegram на callback_data - 64 байта, UUID в него влезает.
	Если ЗначениеЗаполнено(Заказ) И Не ПустаяСтрока(ВидУведомления) Тогда
		Параметры.Вставить("reply_markup", КлавиатураЗаказа(Заказ));
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Токен, "sendMessage", ВJSON(Параметры), Заказ);

	Если Ответ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	// Причину отказа уже записал ВыполнитьЗапрос - здесь только выходим.
	Если Не БулевоJSON(Ответ, "ok") Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Телеграм.Отправлено",
		УровеньЖурналаРегистрации.Информация,
		?(ЗначениеЗаполнено(Заказ), Метаданные.Документы.ЗаказПокупателя, Неопределено),
		Заказ,
		"Чат " + СокрЛП(Строка(ЧатИД)) + Символы.ПС + Текст);

	Если Не ПустаяСтрока(ВидУведомления) Тогда

		ЗаписатьВИсторию(
			ЧатИД,
			НомерСообщенияИзОтвета(Ответ),
			Заказ,
			ВидУведомления,
			Текст,
			Задача);

	КонецЕсли;

	Возврат Истина;

КонецФункции

// Собирает текст уведомления по заказу: номер, товары, тип и факт оплаты,
// получатель, телефон.
//
// Параметры:
//  Заказ        - ДокументСсылка.ЗаказПокупателя - заказ.
//  Статус       - СправочникСсылка.СтатусыЗаказов - статус для заголовка.
//               - Неопределено
//  Заголовок    - Строка - строка в разметке HTML перед номером заказа
//                 (например "🆕 <b>НОВЫЙ ЗАКАЗ С САЙТА</b>"). Уже готовая разметка,
//                 экранированию не подлежит.
//  ДанныеОплаты - Структура - готовый результат ДанныеОбОплате(), когда оплату уже
//                 выяснили: так ОбновитьОплаченныеКарточки() не спрашивает WayForPay
//                 второй раз по тому же заказу.
//               - Неопределено - выясняем здесь.
//
// Возвращаемое значение:
//  Строка - текст в разметке HTML (Telegram).
//
Функция ТекстПоЗаказу(Заказ, Знач Статус = Неопределено, Знач Заголовок = "",
	Знач ДанныеОплаты = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если Статус = Неопределено Тогда
		Статус = Заказ.СтатусЗаказа;
	КонецЕсли;

	Текст = "";

	Если Не ПустаяСтрока(Заголовок) Тогда
		Текст = Заголовок + Символы.ПС + Символы.ПС;
	КонецЕсли;

	// Цветной маркер статуса перед номером: фон сообщения Bot API менять
	// не умеет, поэтому "цвет карточки" - это кружок первой строкой. По нему
	// новый заказ (красный - не продан, звонка ещё не было) отличается от
	// подтверждённого "Продано" (зелёный) с одного взгляда, без чтения строки
	// "Статус".
	Текст = Текст + ЦветСтатуса(Статус) + " <b>Заказ № " + HTML(СокрЛП(Заказ.Номер)) + "</b>"
		+ " от " + Формат(Заказ.Дата, "ДФ=dd.MM.yyyy");

	Если ЗначениеЗаполнено(Статус) Тогда
		Текст = Текст + Символы.ПС + "Статус: " + HTML(Строка(Статус));
	КонецЕсли;

	// Опт или розница - строкой в карточке. Разводка по чатам у статусов есть
	// (реквизиты "Телеграм: чаты" и "...кроме розницы"), но пока опт и розница
	// приходят в один чат, отличить их можно было только по составу заказа.
	// Розница - только тип цен из КодыТиповЦенРозницы, всё прочее (опт, мелкий
	// опт, дроп, СП, представники) идёт как "ОПТ", поэтому рядом в скобках -
	// сам тип цен: он и разделяет дроп от СП внутри общей кучи.
	Если ЗначениеЗаполнено(Заказ.ТипЦен) Тогда

		Текст = Текст + Символы.ПС
			+ ?(ЭтоРозничныйТипЦен(Заказ.ТипЦен), "РОЗНИЦА", "ОПТ")
			+ " (" + HTML(СокрЛП(Строка(Заказ.ТипЦен))) + ")";

	КонецЕсли;

	НомерСайта = СокрЛП(Строка(Заказ.НомерЗаказа2ССайта));
	Если Не ПустаяСтрока(НомерСайта) Тогда
		Текст = Текст + Символы.ПС + "Номер на сайте: " + HTML(НомерСайта);
	КонецЕсли;

	Текст = Текст + Символы.ПС + Символы.ПС + "<b>Товар:</b>";

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказТовары.Номенклатура.Наименование КАК Номенклатура,
		|	ЗаказТовары.Номенклатура.Код КАК КодНоменклатуры,
		|	ЗаказТовары.ХарактеристикаНоменклатуры КАК Характеристика,
		|	ЗаказТовары.ХарактеристикаНоменклатуры.Код КАК КодХарактеристики,
		|	ЗаказТовары.Количество КАК Количество,
		|	ЗаказТовары.Цена КАК Цена,
		|	ЗаказТовары.Сумма КАК Сумма
		|ИЗ
		|	Документ.ЗаказПокупателя.Товары КАК ЗаказТовары
		|ГДЕ
		|	ЗаказТовары.Ссылка = &Заказ
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказТовары.НомерСтроки";
	Запрос.УстановитьПараметр("Заказ", Заказ);

	Выборка = Запрос.Выполнить().Выбрать();

	Позиций = 0;
	Пока Выборка.Следующий() Цикл

		Позиций = Позиций + 1;

		// Больше 20 позиций в сообщение не влезет - остальное менеджер смотрит в 1С.
		Если Позиций > 20 Тогда
			Текст = Текст + Символы.ПС + "... и ещё позиции - смотрите заказ в 1С.";
			Прервать;
		КонецЕсли;

		// Название товара - ссылкой на карточку на сайте, чтобы менеджер мог
		// открыть товар и посмотреть его перед звонком. Ссылки нет - остаётся
		// обычный текст (см. СсылкаНаТовар).
		Наименование = HTML(СокрЛП(Строка(Выборка.Номенклатура)));
		АдресТовара  = СсылкаНаТовар(Выборка.КодНоменклатуры, Выборка.КодХарактеристики);

		Если ПустаяСтрока(АдресТовара) Тогда
			СтрокаТовара = "• " + Наименование;
		Иначе
			СтрокаТовара = "• <a href=""" + АдресТовара + """>" + Наименование + "</a>";
		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.Характеристика) Тогда
			СтрокаТовара = СтрокаТовара + " (" + HTML(СокрЛП(Строка(Выборка.Характеристика))) + ")";
		КонецЕсли;

		СтрокаТовара = СтрокаТовара
			+ " - " + Формат(Выборка.Количество, "ЧДЦ=3; ЧН=0; ЧГ=0") + " шт"
			+ " x " + Формат(Выборка.Цена, "ЧДЦ=2; ЧН=0; ЧГ=0")
			+ " = " + Формат(Выборка.Сумма, "ЧДЦ=2; ЧН=0; ЧГ=0");

		Текст = Текст + Символы.ПС + СтрокаТовара;

	КонецЦикла;

	Если Позиций = 0 Тогда
		Текст = Текст + Символы.ПС + "• (в заказе нет товаров)";
	КонецЕсли;

	Текст = Текст + Символы.ПС + Символы.ПС
		+ "<b>Сумма:</b> " + Формат(Заказ.СуммаДокумента, "ЧДЦ=2; ЧН=0; ЧГ=0") + " грн";

	// В оптовой карточке нет оплаты и "Позвонить" (просьба пользователя,
	// 10.08.2026): по опту не звонят и предоплату не добивают, эти строки
	// только шумят. Розница - как раньше, ей это и нужно.
	ЭтоРозница = ЭтоРозничныйЗаказ(Заказ);

	Если ЭтоРозница И ЗначениеЗаполнено(Заказ.ВидОплатыЗаказа) Тогда
		Текст = Текст + Символы.ПС + "<b>Тип оплаты:</b> " + HTML(Строка(Заказ.ВидОплатыЗаказа));
	КонецЕсли;

	// "Тип оплаты" - это про договорённость, а не про деньги. Отдельной строкой
	// пишем, поступила ли оплата на самом деле: без предоплаты посылку не отправляют,
	// и менеджеру это нужно знать до звонка.
	Если ЭтоРозница Тогда

		Если ДанныеОплаты = Неопределено Тогда
			ДанныеОплаты = ДанныеОбОплате(Заказ);
		КонецЕсли;

		Если Не ПустаяСтрока(ДанныеОплаты.Описание) Тогда
			Текст = Текст + Символы.ПС + ДанныеОплаты.Описание;
		КонецЕсли;

	КонецЕсли;

	Текст = Текст + Символы.ПС + Символы.ПС + "<b>Получатель:</b>";

	Получатель = СокрЛП(Строка(Заказ.Получатель));
	Если ПустаяСтрока(Получатель) Тогда
		Получатель = СокрЛП(Строка(Заказ.Контрагент));
	КонецЕсли;
	Текст = Текст + Символы.ПС + HTML(Получатель);

	Доставка = АдресДоставки(Заказ);
	Если Не ПустаяСтрока(Доставка) Тогда
		Текст = Текст + Символы.ПС + HTML(Доставка);
	КонецЕсли;

	// Телефон отдельной строкой в международном формате: Telegram сам делает его
	// кликабельным, тап по номеру = звонок.
	Если ЭтоРозница Тогда

		Телефон = ТелефонДляЗвонка(Заказ);
		Если Не ПустаяСтрока(Телефон) Тогда
			Текст = Текст + Символы.ПС + Символы.ПС + "Позвонить: " + HTML(Телефон);
		Иначе
			Текст = Текст + Символы.ПС + Символы.ПС + "Телефон не заполнен - смотрите карточку клиента.";
		КонецЕсли;

	КонецЕсли;

	// Содержание задачи менеджера - прямо в карточке: заметки "не берёт трубку",
	// "обещала оплатить" и ответы текстом видны сразу, без нажатий. Заглушку
	// "Задача из Telegram" не показываем - это не содержание, а наша пустышка.
	// Длинную переписку режем С НАЧАЛА: свежие записи в конце, они ценнее,
	// а общий лимит сообщения Telegram - 4096 символов на всё.
	ТекстЗадачи = "";
	Задача = ЗадачаПоЗаказу(Заказ);

	Если ЗначениеЗаполнено(Задача) Тогда
		ТекстЗадачи = СокрЛП(Строка(Задача.Описание));
	КонецЕсли;

	Если Не ПустаяСтрока(ТекстЗадачи) И ТекстЗадачи <> "Задача из Telegram" Тогда

		Если СтрДлина(ТекстЗадачи) > 700 Тогда
			ТекстЗадачи = "..." + Прав(ТекстЗадачи, 700);
		КонецЕсли;

		Текст = Текст + Символы.ПС + Символы.ПС + "<b>📋 Задача:</b>"
			+ Символы.ПС + "<i>" + HTML(ТекстЗадачи) + "</i>";

	КонецЕсли;

	Возврат Текст;

КонецФункции

// Поступила ли по заказу оплата - для строки в карточке.
//
// Показываем, НЕ отмечаем: платёж в 1С отсюда не создаётся и заказ не переписывается.
// Приём денег в базу остаётся ручным (обработка "Обмен Приват24" -> очередь платежей),
// карточка только сообщает менеджеру, что деньги есть.
//
// Источники, по убыванию твёрдости:
//
//  1. Проведённые платежи в 1С - Документы.ЗаказПокупателя.ОплатаПоЗаказу: сумма
//     по ПКО и платёжным поручениям входящим, где заказ стоит Сделкой или
//     документом-основанием. Запросов наружу не требует, поэтому спрашивается первым;
//     если по нему заказ уже закрыт полностью, WayForPay не тревожим вовсе.
//  2. WayForPay - деньги у эквайрера, документа в 1С может ещё не быть. Спрашиваем
//     CHECK_STATUS по ЗаказПокупателя.WayForPayOrderReference (реф приезжает с сайта
//     тегом payment_ref). ВАЖНО: сам заполненный реф признаком оплаты НЕ является -
//     сайт пишет его уже в момент, когда клиент открыл экран оплаты, и точно такой же
//     реф остаётся, если клиент этот экран закрыл, ничего не заплатив. Отсюда и
//     обращение к WayForPay: только он знает, прошёл платёж или нет.
//  3. ЗаказПокупателя.СуммаОплаты - "уже оплачено" по данным сайта (тег paid_amount).
//     Сайт присылает его только для наложенного платежа с предоплатой, поэтому это
//     подпорка на случай, когда первые два молчат.
//
// Берём наибольшую из трёх сумм, а не сумму: одна и та же оплата легко есть сразу
// в двух источниках (платёж WayForPay уже принят в 1С), и сложение показало бы двойную.
//
// Параметры:
//  Заказ      - ДокументСсылка.ЗаказПокупателя - заказ.
//  Транзакция - Структура - уже полученная транзакция WayForPay (orderReference,
//               amount, createdDate, transactionStatus). Передана - отдельного
//               запроса к WayForPay не делаем; так работает
//               ОбновитьОплаченныеКарточки(), забирающая весь список разом.
//             - Неопределено - спрашиваем WayForPay сами.
//
// Возвращаемое значение:
//  Структура:
//   * Оплачен  - Булево - деньги подтверждены хоть одним источником.
//   * Сумма    - Число  - подтверждённая сумма.
//   * Дата     - Дата   - когда прошёл платёж; пустая, если источник её не даёт.
//   * Источник - Строка - "1С" / "WayForPay" / "сайт" / "".
//   * Статус   - Строка - сырой transactionStatus WayForPay ("Approved", "Declined"...).
//   * Описание - Строка - готовая строка карточки в разметке HTML.
//
Функция ДанныеОбОплате(Заказ, Знач Транзакция = Неопределено) Экспорт

	Данные = Новый Структура("Оплачен, Сумма, Дата, Источник, Статус, Описание",
		Ложь, 0, '00010101', "", "", "");

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Данные;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	СуммаЗаказа = Заказ.СуммаДокумента;

	// 1. Проведено в 1С.
	Оплачено1С = 0;

	Попытка
		Оплачено1С = Документы.ЗаказПокупателя.ОплатаПоЗаказу(Заказ);
	Исключение
		Оплачено1С = 0;
		ЗаписатьОшибку(Заказ, "Не удалось посчитать оплату по заказу в 1С: " + ОписаниеОшибки());
	КонецПопытки;

	Если Оплачено1С > 0 Тогда
		Данные.Оплачен  = Истина;
		Данные.Сумма    = Оплачено1С;
		Данные.Источник = "1С";
	КонецЕсли;

	// 2. WayForPay. Не спрашиваем, когда заказ и так закрыт проведёнными платежами
	// или когда транзакцию нам уже передали.
	ОтветWFP = Неопределено;
	Реф      = СокрЛП(Строка(Заказ.WayForPayOrderReference));

	Если ТипЗнч(Транзакция) = Тип("Структура") Тогда

		СтатусТранзакции = "";
		Транзакция.Свойство("transactionStatus", СтатусТранзакции);
		Данные.Статус = СокрЛП(Строка(СтатусТранзакции));

		Если Данные.Статус = "Approved" Тогда

			СуммаТранзакции = 0;
			Транзакция.Свойство("amount", СуммаТранзакции);

			СозданаТранзакция = 0;
			Транзакция.Свойство("createdDate", СозданаТранзакция);

			Если ЧислоИлиНоль(СуммаТранзакции) > Данные.Сумма Тогда
				Данные.Сумма    = ЧислоИлиНоль(СуммаТранзакции);
				Данные.Источник = "WayForPay";
				Данные.Дата     = ДатаИзUnix(СозданаТранзакция);
			КонецЕсли;

			Данные.Оплачен = Истина;

		КонецЕсли;

	ИначеЕсли Не ПустаяСтрока(Реф) И Данные.Сумма + 0.01 < СуммаЗаказа Тогда

		Попытка
			ОтветWFP = WayForPay.ПолучитьСтатусПлатежа(Реф);
		Исключение
			ОтветWFP = Неопределено;
			ЗаписатьОшибку(Заказ, "Не удалось спросить WayForPay об оплате: " + ОписаниеОшибки());
		КонецПопытки;

		Если ОтветWFP <> Неопределено Тогда

			Данные.Статус = СокрЛП(Строка(ОтветWFP.СтатусОплаты));

			Если ОтветWFP.Успешно И Данные.Статус = "Approved" Тогда

				Если ЧислоИлиНоль(ОтветWFP.Сумма) > Данные.Сумма Тогда
					Данные.Сумма    = ЧислоИлиНоль(ОтветWFP.Сумма);
					Данные.Источник = "WayForPay";
					Данные.Дата     = ДатаИзUnix(ОтветWFP.ДатаОплаты);
				КонецЕсли;

				Данные.Оплачен = Истина;

			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	// 3. По данным сайта.
	Если ЗначениеЗаполнено(Заказ.СуммаОплаты) И Заказ.СуммаОплаты > Данные.Сумма Тогда
		Данные.Оплачен  = Истина;
		Данные.Сумма    = Заказ.СуммаОплаты;
		Данные.Источник = "сайт";
		Данные.Дата     = '00010101';
	КонецЕсли;

	Данные.Описание = СтрокаОбОплате(Данные, СуммаЗаказа, ОтветWFP);

	Возврат Данные;

КонецФункции

// Розничный ли заказ. Розница и остальные заказы (опт, совместные покупки,
// дропшиппинг, представники) настраиваются в карточке статуса раздельно:
// закладки "Розница" и "Остальные" на странице "Телеграм".
//
// Признак - тип цен заказа (см. КодыТиповЦенРозницы). Тип цен приходит из группы
// контрагента (ОбменПокупателямиНашСайт: ТипЦен = Контрагент.Родитель.ТипЦеныГруппы),
// поэтому он же отделяет розничного клиента от оптового и в заказах, заведённых
// менеджером руками.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  Булево - заказ розничный.
//
Функция ЭтоРозничныйЗаказ(Заказ) Экспорт

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Возврат ЭтоРозничныйТипЦен(Заказ.ТипЦен);

КонецФункции

// То же, что ЭтоРозничныйЗаказ, но по типу цен, а не по ссылке на заказ.
//
// Нужна там, где заказ ещё не записан или записывается прямо сейчас:
// в ЗаказПокупателя.ПриЗаписи чтение Ссылка.ТипЦен вернуло бы состояние ДО
// правки, а сам объект знает свой тип цен точно.
//
// Параметры:
//  ТипЦен - СправочникСсылка.ТипыЦенНоменклатуры - тип цен заказа.
//
// Возвращаемое значение:
//  Булево - тип цен считается розничным.
//
Функция ЭтоРозничныйТипЦен(ТипЦен) Экспорт

	Если Не ЗначениеЗаполнено(ТипЦен) Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	КодТипаЦен = СокрЛП(Строка(ТипЦен.Код));

	Если ПустаяСтрока(КодТипаЦен) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(КодыТиповЦенРозницы(), "," + КодТипаЦен + ",") > 0;

КонецФункции

// Настройки уведомлений статуса для нужного класса заказов - чтобы читающий код
// не выбирал реквизиты руками в семи местах.
//
// Параметры:
//  Статус     - СправочникСсылка.СтатусыЗаказов - статус заказа.
//  ЭтоРозница - Булево - какой набор нужен: закладка "Розница" или "Остальные".
//
// Возвращаемое значение:
//  Структура - Уведомлять (Булево), Чаты (Строка), ЧатыСмены (Строка).
//
Функция НастройкиУведомлений(Знач Статус, Знач ЭтоРозница) Экспорт

	Настройки = Новый Структура("Уведомлять, Чаты, ЧатыСмены", Ложь, "", "");

	Если Не ЗначениеЗаполнено(Статус) Тогда
		Возврат Настройки;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Если ЭтоРозница Тогда

		Настройки.Уведомлять = Статус.ОтправлятьВТелеграм;
		Настройки.Чаты       = СокрЛП(Строка(Статус.ТелеграмЧат));
		Настройки.ЧатыСмены  = СокрЛП(Строка(Статус.ТелеграмЧатСмены));

	Иначе

		// Галки на закладке "Остальные" на форме больше нет: по не розничным
		// заказам её никто не читает (см. СтатусУведомляет), решают только чаты.
		Настройки.Уведомлять = Статус.ОтправлятьВТелеграмОстальные;
		Настройки.Чаты       = СокрЛП(Строка(Статус.ТелеграмЧатОстальные));
		Настройки.ЧатыСмены  = СокрЛП(Строка(Статус.ТелеграмЧатСменыОстальные));

	КонецЕсли;

	Возврат Настройки;

КонецФункции

// Чаты для оптового нового заказа в "Ожидает оплаты" - из настроек опта
// статуса "Продано" (просьба пользователя, 10.08.2026: новый опт приравнять
// к "Продано", свои настройки у "Ожидает оплаты" для опта пустые).
// Берём "чаты карточки" (при переводе в статус), пусто - "чаты напоминаний".
// Статусы ищем по наименованию: предопределённых элементов у справочника нет.
//
// Возвращаемое значение:
//  Строка - чаты через запятую; пусто - приравнивать не к чему.
//
Функция ЧатыОптаКакПродано(Знач Статус)

	Если Лев(НРег(СокрЛП(Строка(Статус))), 13) <> "ожидает оплат" Тогда
		Возврат "";
	КонецЕсли;

	Продано = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Продано");

	Если Не ЗначениеЗаполнено(Продано) Тогда

		// Точного "Продано" нет - ищем по началу; "Не продан..." не подойдёт,
		// шаблон закреплён за началом строки.
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	СтатусыЗаказов.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СтатусыЗаказов КАК СтатусыЗаказов
			|ГДЕ
			|	СтатусыЗаказов.Наименование ПОДОБНО ""Продан%""
			|	И НЕ СтатусыЗаказов.ПометкаУдаления";

		Выборка = Запрос.Выполнить().Выбрать();

		Если Не Выборка.Следующий() Тогда
			Возврат "";
		КонецЕсли;

		Продано = Выборка.Ссылка;

	КонецЕсли;

	Настройки = НастройкиУведомлений(Продано, Ложь);

	Чаты = Настройки.ЧатыСмены;

	Если ПустаяСтрока(Чаты) Тогда
		Чаты = Настройки.Чаты;
	КонецЕсли;

	Возврат Чаты;

КонецФункции

// Нужно ли слать уведомление по просрочке этого статуса.
//
// Достаточно заполнить у статуса "Чаты напоминаний" - галка "Напоминать менеджеру в Telegram"
// тогда не обязательна. Галка без чатов работает только по рознице: получатели
// берутся от статуса, у которого они заполнены (см. УведомитьОЗаказе). По
// остальным заказам такого отката нет - иначе опт посыпался бы в розничный чат.
//
// Параметры:
//  Статус     - СправочникСсылка.СтатусыЗаказов - статус заказа.
//  ЭтоРозница - Булево - какой набор настроек смотреть.
//
// Возвращаемое значение:
//  Булево - по этому статусу уведомляем.
//
Функция СтатусУведомляет(Статус, Знач ЭтоРозница = Истина) Экспорт

	Если Не ЗначениеЗаполнено(Статус) Тогда
		Возврат Ложь;
	КонецЕсли;

	Настройки = НастройкиУведомлений(Статус, ЭтоРозница);

	Если Не ЭтоРозница Тогда
		Возврат Не ПустаяСтрока(Настройки.Чаты);
	КонецЕсли;

	Возврат Настройки.Уведомлять Или Не ПустаяСтрока(Настройки.Чаты);

КонецФункции

// Ставит заказ в очередь на уведомление о смене статуса.
// Вызывается из ЗаказПокупателя.ПроверитьСтатус, то есть ВНУТРИ транзакции
// записи документа: здесь можно только писать в базу, слать HTTP - нельзя.
//
// В очередь ставим ЛЮБУЮ смену статуса розничного заказа, даже если слать
// о ней некому. Раньше запись с незаполненным ТелеграмЧатСмены отбрасывалась
// сразу - и получалось, что после перевода заказа, например, в "Ожидает
// отправки" старая карточка "нужно позвонить" висела в чате вечно, пока
// кто-нибудь не нажмёт "Обработан". Теперь у записи есть вторая работа:
// убрать устаревшую карточку из чатов (см. РазобратьОчередь).
//
// Не розничный заказ попадает в очередь только если по нему вообще настроены
// уведомления (закладка "Остальные" у статуса): карточек по нему в чатах нет,
// убирать нечего, и гонять через очередь весь опт незачем.
//
// Параметры:
//  Заказ  - ДокументСсылка.ЗаказПокупателя - заказ, у которого сменился статус.
//  Статус - СправочникСсылка.СтатусыЗаказов - статус, В который перешли.
//
Процедура ЗарегистрироватьСменуСтатуса(Заказ, Статус) Экспорт

	Если Не ЗначениеЗаполнено(Заказ) Или Не ЗначениеЗаполнено(Статус) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Если Не ЭтоРозничныйЗаказ(Заказ) Тогда

		Настройки = НастройкиУведомлений(Статус, Ложь);

		Если ПустаяСтрока(Настройки.Чаты) И ПустаяСтрока(Настройки.ЧатыСмены) Тогда
			Возврат;
		КонецЕсли;

	КонецЕсли;

	// Проверка прав ДО записи, а не Попытка вокруг неё. Обработчик работает внутри
	// транзакции записи заказа, и отказ по правам эту транзакцию убивает: перехват
	// исключения спасает только текст ошибки, а следующее же обращение к базе падает
	// с "В данной транзакции уже происходили ошибки!" - и заказ не записывается вообще.
	// Так и было 10-12.08.2026: у роли МенеджерПоПродажам не было прав на ТелеграмОчередь,
	// и у менеджера перестала работать рассылка ТТН. Права добавлены, а эта проверка -
	// страховка на случай следующего нового регистра, забытого в ролях.
	// УстановитьПривилегированныйРежим тут не выручает: в клиент-серверной базе обычное
	// приложение выполняет этот код на стороне клиента, и права всё равно проверяются.
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ТелеграмОчередь) Тогда

		ЗаписатьОшибку(Заказ, "Нет прав на запись регистра ТелеграмОчередь,"
			+ " уведомление о смене статуса не поставлено в очередь."
			+ " Добавьте права на регистр в роль пользователя.");

		Возврат;

	КонецЕсли;

	Попытка

		Запись = РегистрыСведений.ТелеграмОчередь.СоздатьМенеджерЗаписи();

		Запись.Заказ           = Заказ;
		Запись.Статус          = Статус;
		Запись.ДатаРегистрации = ТекущаяДата();
		Запись.Попыток         = 0;

		Запись.Записать(Истина);

	Исключение

		// Очередь не должна ронять запись заказа.
		ЗаписатьОшибку(Заказ, "Не удалось поставить заказ в очередь уведомлений"
			+ " о смене статуса: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Точка входа регламентного задания ТелеграмОбмен: разослать то, что накопилось
// в очереди, досдать отложенное с ночи и забрать ответы менеджера.
//
// Вебхук это задание НЕ отменяет. Он закрывает только третий пункт - входящие
// нажатия. Первые два инициирует сама 1С, Telegram про них ничего не знает
// и прислать их не может:
//
//  - РазобратьОчередь - уведомления о смене статуса. Из транзакции записи заказа
//    слать нельзя, поэтому они копятся в регистре и уезжают отсюда;
//  - ДогнатьНовыеЗаказы - заказы, по которым карточка в своё время не ушла;
//  - ОбновитьОплаченныеКарточки - пришедшая после отправки оплата.
//
// Так что расписание раз в 1-2 минуты нужно при любом раскладе.
Процедура ОбменСБотом() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Попытка
		РазобратьОчередь();
	Исключение
		ЗаписатьОшибку(Неопределено, "Ошибка при разборе очереди уведомлений: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		ОбновитьОплаченныеКарточки();
	Исключение
		ЗаписатьОшибку(Неопределено, "Ошибка при обновлении карточек по оплате: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Попытка
		ДогнатьНовыеЗаказы();
	Исключение
		ЗаписатьОшибку(Неопределено, "Ошибка при отправке отложенных уведомлений"
			+ " о новых заказах: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Чат - зеркало активных заказов: пропавшие карточки заказов в работе
	// возвращаем, карточки вышедших из работы убираем. После РазобратьОчередь,
	// чтобы не восстанавливать то, что смена статуса сейчас заменит новым.
	Попытка
		СинхронизироватьКарточки();
	Исключение
		ЗаписатьОшибку(Неопределено, "Ошибка при синхронизации карточек с чатами: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	// Нажатия кнопок забираем круглосуточно: менеджер может отметить заказ
	// обработанным когда угодно, и отметка должна доехать в 1С сразу.
	//
	// Но только пока не включён вебхук. getUpdates и вебхук взаимоисключающи:
	// при установленном вебхуке Telegram отвечает на опрос 409 Conflict, и каждый
	// прогон регламента писал бы в журнал ошибку на ровном месте. Заполненный
	// СекретВебхука() и есть переключатель: секрет задан - нажатия приносит
	// HTTPСервис.ТелеграмВебхук, опрашивать больше некого.
	Если ПустаяСтрока(СекретВебхука()) Тогда
		ПолучитьОтветы();
	КонецЕсли;

	// Ошибки журнала регистрации - на сайт. К телеграму отношения не имеет,
	// живёт здесь по расчёту: это единственное задание с расписанием раз
	// в 1-2 минуты, а заводить новое значит заводить и расписание в базе
	// руками - забытое расписание не даёт ошибки, просто ничего не приезжает.
	Попытка
		ЖурналНаСайт.ОтправитьОшибки();
	Исключение
		ЗаписатьОшибку(Неопределено, "Ошибка при отправке журнала на сайт: "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Забирает из Telegram нажатия кнопок и обрабатывает их.
//
// Отдельного задания под ответы НЕТ: вызывается из ОбменСБотом, то есть регламентом
// ТелеграмОбмен - он единственный по этой подсистеме. Расписание задаётся в базе,
// в метаданных не хранится; имеет смысл раз в 1-2 минуты, иначе кнопки у менеджера
// отзываются с задержкой в целый интервал.
//
// Что делает одно нажатие:
//  - в регистре ТелеграмУведомления ставит "Обработан", дату и того, кто нажал;
//  - в задаче менеджера дописывает строкой "✅ Обработан в Telegram <дата>"
//    и заполняет "Дату исполнения", если она была пуста (задачу НЕ закрывает);
//  - меняет подпись кнопки под сообщением на "✅ Обработан <дата>".
//
// Смещение обновлений (offset) в базе не храним: Telegram отдаёт обновления до
// тех пор, пока не запросишь getUpdates с offset больше последнего update_id.
// Этим повторным запросом в конце процедуры пачка и подтверждается. Обратная
// сторона: обновления вычитывает уже этот регламент, и ПоказатьНовыеЧаты() их
// не увидит - поэтому новые чаты пишет в журнал сама эта процедура.
//
Процедура ПолучитьОтветы() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Токен = ТокенБота();
	Если ПустаяСтрока(Токен) Тогда
		Возврат;
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Токен, "getUpdates", "{""limit"":100,""timeout"":0}", Неопределено);

	Если Ответ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СписокОбновлений = Неопределено;

	Если Не Ответ.Свойство("result", СписокОбновлений)
		Или ТипЗнч(СписокОбновлений) <> Тип("Массив") Тогда

		// Сюда попадаем, когда getUpdates отказал: чаще всего это 409 Conflict -
		// у бота установлен вебхук либо обновления параллельно вычитывает кто-то
		// ещё. Нажатия кнопок тогда до 1С не доходят вообще. Сам отказ с текстом
		// от Telegram уже записал ВыполнитьЗапрос.
		ЗаписатьОшибку(Неопределено, "getUpdates не вернул список обновлений -"
			+ " нажатия кнопок не разбираются.");

		Возврат;

	КонецЕсли;

	// Пусто - это норма: никто ничего не нажимал.
	Если СписокОбновлений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	МаксимальныйИД = 0;
	НовыеЧаты      = "";

	Для Каждого Обновление Из СписокОбновлений Цикл

		Если ТипЗнч(Обновление) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		ИДОбновления = ЧислоJSON(Обновление, "update_id");
		Если ИДОбновления > МаксимальныйИД Тогда
			МаксимальныйИД = ИДОбновления;
		КонецЕсли;

		Нажатие = Неопределено;
		Если Обновление.Свойство("callback_query", Нажатие)
			И ТипЗнч(Нажатие) = Тип("Структура") Тогда

			Попытка
				ОбработатьНажатие(Токен, Нажатие);
			Исключение
				// Одно кривое нажатие не должно останавливать разбор пачки.
				ЗаписатьОшибку(Неопределено, "Не удалось обработать нажатие кнопки: "
					+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;

			Продолжить;

		КонецЕсли;

		Сообщение = Неопределено;
		Если Обновление.Свойство("message", Сообщение)
			И ТипЗнч(Сообщение) = Тип("Структура") Тогда

			// Ответ текстом на сообщение заказа - в задачу. Дублирует ветку
			// в ПринятьОбновление: пока стоит вебхук, сюда не заходят вовсе,
			// но при откате на опрос правка задач должна продолжать работать.
			Исходное = Неопределено;
			Если Сообщение.Свойство("reply_to_message", Исходное)
				И ТипЗнч(Исходное) = Тип("Структура") Тогда

				Попытка
					ОбработатьОтветТекстом(Токен, Сообщение, Исходное);
				Исключение
					ЗаписатьОшибку(Неопределено, "Не удалось обработать ответ текстом: "
						+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				КонецПопытки;

				Продолжить;

			КонецЕсли;

			Чат = Неопределено;
			Если Сообщение.Свойство("chat", Чат) И ТипЗнч(Чат) = Тип("Структура") Тогда

				НовыеЧаты = НовыеЧаты
					+ "chat_id: " + СтрокаJSON(Чат, "id")
					+ "; " + СтрокаJSON(Чат, "first_name")
					+ " " + СтрокаJSON(Чат, "last_name")
					+ " @" + СтрокаJSON(Чат, "username")
					+ Символы.ПС;

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Если Не ПустаяСтрока(НовыеЧаты) Тогда
		ЗаписьЖурналаРегистрации("Телеграм.Чаты",
			УровеньЖурналаРегистрации.Информация, , , НовыеЧаты);
	КонецЕсли;

	Если МаксимальныйИД > 0 Тогда

		ВыполнитьЗапрос(Токен, "getUpdates",
			"{""offset"":" + Формат(МаксимальныйИД + 1, "ЧЦ=15; ЧДЦ=0; ЧГ=0")
			+ ",""limit"":1,""timeout"":0}",
			Неопределено);

	КонецЕсли;

КонецПроцедуры

// Выводит в журнал регистрации чаты, которые написали боту (кнопка Start).
// Нужна один раз, чтобы узнать chat_id получателя и вписать его в статус заказа.
// Запускается из консоли кода: ТелеграмБот.ПоказатьНовыеЧаты();
//
// Если регламент ТелеграмОбмен уже включён, обновления вычитывает он - тогда
// смотрите чаты в журнале регистрации по событию "Телеграм.Чаты".
//
// При включённом вебхуке getUpdates не работает вовсе (409 Conflict), и раньше
// эта функция отвечала невнятным "Telegram вернул неожиданный ответ". Теперь
// в этом случае она читает те же чаты из журнала регистрации - туда их пишет
// ПринятьОбновление на каждое сообщение боту.
//
// Возвращаемое значение:
//  Строка - тот же список, что и в журнале регистрации.
//
Функция ПоказатьНовыеЧаты() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	// Секрет заполнен - работаем через вебхук, спрашивать Telegram бесполезно.
	Если Не ПустаяСтрока(СекретВебхука()) Тогда
		Возврат ЧатыИзЖурнала();
	КонецЕсли;

	Токен = ТокенБота();
	Если ПустаяСтрока(Токен) Тогда
		Возврат "Не заполнен токен бота (функция ТокенБота).";
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Токен, "getUpdates", "{""limit"":100}", Неопределено);

	Если Ответ = Неопределено Тогда
		Возврат "Telegram не ответил - смотрите событие журнала ""Телеграм.Ошибка"".";
	КонецЕсли;

	СписокОбновлений = Неопределено;
	Если Не Ответ.Свойство("result", СписокОбновлений) Или ТипЗнч(СписокОбновлений) <> Тип("Массив") Тогда
		Возврат "Telegram вернул неожиданный ответ - смотрите событие журнала"
			+ " ""Телеграм.Ошибка"". Частая причина: у бота установлен вебхук,"
			+ " и getUpdates отвечает 409 Conflict.";
	КонецЕсли;

	Результат = "";

	Для Каждого Обновление Из СписокОбновлений Цикл

		Сообщение = Неопределено;
		Если Не Обновление.Свойство("message", Сообщение) Или ТипЗнч(Сообщение) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Чат = Неопределено;
		Если Не Сообщение.Свойство("chat", Чат) Или ТипЗнч(Чат) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		Результат = Результат
			+ "chat_id: " + СтрокаJSON(Чат, "id")
			+ "; " + СтрокаJSON(Чат, "first_name")
			+ " " + СтрокаJSON(Чат, "last_name")
			+ " @" + СтрокаJSON(Чат, "username")
			+ Символы.ПС;

	КонецЦикла;

	Если ПустаяСтрока(Результат) Тогда
		Результат = "Боту никто не писал (или обновления уже вычитаны). "
			+ "Попросите получателя нажать Start и повторите.";
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Телеграм.Чаты",
		УровеньЖурналаРегистрации.Информация, , , Результат);

	Возврат Результат;

КонецФункции

// Чаты из журнала регистрации - единственный источник chat_id при включённом
// вебхуке: getUpdates при нём отвечает 409 Conflict, а нажатие Start приносит
// HTTPСервис.ТелеграмВебхук, и ПринятьОбновление кладёт chat_id сюда.
//
// Пусто - это ответ сам по себе: значит Start до 1С не доехал, и разбираться
// надо не с чатами, а с доступностью вебхука снаружи (Диагностика()).
//
// Возвращаемое значение:
//  Строка - список записей события "Телеграм.Чаты" за последнюю неделю.
//
Функция ЧатыИзЖурнала()

	Отбор = Новый Структура;
	Отбор.Вставить("Событие", "Телеграм.Чаты");
	Отбор.Вставить("ДатаНачала", НачалоДня(ТекущаяДата()) - 7 * 24 * 3600);

	Таблица = Новый ТаблицаЗначений;

	// Журнал может быть недоступен (формат, права, размер) - это не повод
	// падать в консоли кода: отвечаем текстом, куда смотреть руками.
	Попытка
		ВыгрузитьЖурналРегистрации(Таблица, Отбор, , 100);
	Исключение
		Возврат "Вебхук включён, поэтому getUpdates не спрашиваем."
			+ " Прочитать журнал не удалось: " + ОписаниеОшибки()
			+ Символы.ПС
			+ "Смотрите вручную: Журнал регистрации, событие ""Телеграм.Чаты"".";
	КонецПопытки;

	Результат = "";

	Для Каждого ЗаписьЖурнала Из Таблица Цикл

		Результат = Результат
			+ Формат(ЗаписьЖурнала.Дата, "ДФ='dd.MM HH:mm'") + "  "
			+ СокрЛП(Строка(ЗаписьЖурнала.Комментарий))
			+ Символы.ПС;

	КонецЦикла;

	Если ПустаяСтрока(Результат) Тогда

		Возврат "Вебхук включён (getUpdates при нём отвечает 409 Conflict),"
			+ " поэтому чаты берём из журнала регистрации - а там за неделю"
			+ " ни одной записи ""Телеграм.Чаты""."
			+ Символы.ПС
			+ "Значит нажатие Start до 1С не доехало. Проверьте"
			+ " ТелеграмБот.Диагностика(): строку ""Вебхук"" и последнюю ошибку"
			+ " Telegram - вебхук либо не установлен, либо недоступен снаружи.";

	КонецЕсли;

	Возврат "Чаты из журнала регистрации (вебхук включён, getUpdates не"
		+ " используется):" + Символы.ПС + Результат;

КонецФункции

// Разбирает ОДНО обновление Telegram, пришедшее вебхуком (HTTPСервис.ТелеграмВебхук).
//
// Отличие от ПолучитьОтветы: там мы сами спрашиваем пачку через getUpdates,
// здесь Telegram приносит по одному и сразу. Разбор нажатия общий - ОбработатьНажатие,
// так что поведение кнопок от способа доставки не зависит.
//
// Подтверждать обновление не нужно: для вебхука подтверждение - это код 200,
// его возвращает сам сервис.
//
// Параметры:
//  ТелоЗапроса - Строка - JSON одного объекта Update.
//
Процедура ПринятьОбновление(Знач ТелоЗапроса) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Если ПустаяСтрока(СокрЛП(ТелоЗапроса)) Тогда
		Возврат;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоЗапроса);
	Обновление = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	Если ТипЗнч(Обновление) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Нажатие = Неопределено;
	Если Обновление.Свойство("callback_query", Нажатие)
		И ТипЗнч(Нажатие) = Тип("Структура") Тогда

		ОбработатьНажатие(ТокенБота(), Нажатие);
		Возврат;

	КонецЕсли;

	Сообщение = Неопределено;
	Если Обновление.Свойство("message", Сообщение)
		И ТипЗнч(Сообщение) = Тип("Структура") Тогда

		// Ответ на сообщение заказа - текст уходит в задачу менеджера.
		// Это единственный способ ввести произвольный текст: у inline-кнопок
		// callback_data задаётся заранее, поля ввода у них нет.
		Исходное = Неопределено;
		Если Сообщение.Свойство("reply_to_message", Исходное)
			И ТипЗнч(Исходное) = Тип("Структура") Тогда

			ОбработатьОтветТекстом(ТокенБота(), Сообщение, Исходное);
			Возврат;

		КонецЕсли;

		Чат = Неопределено;
		Если Сообщение.Свойство("chat", Чат) И ТипЗнч(Чат) = Тип("Структура") Тогда

			ЧатИД = СтрокаJSON(Чат, "id");

			// Команда /reload (или слово "перезалить") - удалить из чатов все
			// карточки и прислать актуальные заново, то же, что кнопка
			// "Перезалить все" в админке сайта. Работа долгая, а Telegram ждёт
			// ответа вебхука недолго и на молчание повторяет обновление - тогда
			// перезаливка запустилась бы второй раз. Поэтому здесь только
			// запуск фонового задания; в чат оно отвечает лишь при неудаче.
			ТекстКоманды = НРег(СокрЛП(СтрокаJSON(Сообщение, "text")));

			Если (ТекстКоманды = "/reload" Или СтрНачинаетсяС(ТекстКоманды, "/reload@")
				Или ТекстКоманды = "перезалить")
				И ЭтоЧатМенеджера(ЧатИД) Тогда

				ЗапуститьПерезаливкуИзЧата(ТокенБота(), ЧатИД,
					ЧислоJSON(Сообщение, "message_id"));
				Возврат;

			КонецЕсли;

			// Сообщение из одного номера телефона - справка по клиенту:
			// менеджер кидает номер в чат и получает последние заказы.
			// Только для чатов, куда бот сам шлёт карточки: бот публичный,
			// и отдавать заказы по номеру любому написавшему нельзя.
			Цифры = ЦифрыИзСтроки(СтрокаJSON(Сообщение, "text"));

			Если СтрДлина(Цифры) >= 10 И СтрДлина(Цифры) <= 13
				И СтрДлина(СокрЛП(СтрокаJSON(Сообщение, "text"))) <= 20
				И ЭтоЧатМенеджера(ЧатИД) Тогда

				ОтветитьИнфоПоТелефону(ТокенБота(), ЧатИД,
					ЧислоJSON(Сообщение, "message_id"), Цифры);
				Возврат;

			КонецЕсли;

			// Обычное сообщение боту - тот же случай, что и в ПолучитьОтветы:
			// пишем chat_id в журнал, чтобы новый получатель узнал свой номер.
			ЗаписьЖурналаРегистрации("Телеграм.Чаты",
				УровеньЖурналаРегистрации.Информация, , ,
				"chat_id: " + ЧатИД
				+ "; " + СтрокаJSON(Чат, "first_name")
				+ " " + СтрокаJSON(Чат, "last_name")
				+ " @" + СтрокаJSON(Чат, "username"));

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

// Запуск перезаливки из чата: фоновое задание с фиксированным ключом -
// повторная команда, пока идёт первая, не даст второй параллельной чистки
// (занятый ключ - исключение, о нём честно пишем в чат).
Процедура ЗапуститьПерезаливкуИзЧата(Знач Токен, Знач ЧатИД, Знач НомерСообщения)

	Параметры = Новый Массив;
	Параметры.Добавить(СокрЛП(Строка(ЧатИД)));
	Параметры.Добавить(НомерСообщения);

	Попытка

		ФоновыеЗадания.Выполнить("ТелеграмБот.ПерезалитьВсеКарточкиФоном",
			Параметры, "ТелеграмПерезаливка",
			"Телеграм: перезаливка карточек из чата");

	Исключение

		ОтветитьВЧат(Токен, ЧатИД, НомерСообщения,
			"Перезаливка не запустилась (возможно, уже идёт): " + ОписаниеОшибки());
		Возврат;

	КонецПопытки;

	// Сообщения "начал" и "закончил" в чат намеренно не шлём: они мешаются
	// среди карточек, а результат виден сам - карточки исчезают и приходят
	// заново. В чат уходит только то, что менеджеру нужно знать: перезаливка
	// НЕ запустилась (выше) или НЕ прошла (ПерезалитьВсеКарточкиФоном).
	// Успешный итог с цифрами пишется в журнал регистрации.

КонецПроцедуры

// Тело фонового задания перезаливки. При успехе в чат не пишет ничего -
// итог уходит в журнал регистрации; в чат отвечает только неудачей.
Процедура ПерезалитьВсеКарточкиФоном(Знач ЧатИД, Знач НомерСообщения) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Итог = ПерезалитьВсеКарточки();

	Если Итог.Успех Тогда

		ЗаписьЖурналаРегистрации("Телеграм.Перезаливка",
			УровеньЖурналаРегистрации.Информация, , ,
			"Перезаливка из чата " + СокрЛП(Строка(ЧатИД)) + " закончена: удалено "
			+ Итог.Убрано + ", отправлено заново " + Итог.Отправлено + ".");

		Возврат;

	КонецЕсли;

	ОтветитьВЧат(ТокенБота(), ЧатИД, НомерСообщения,
		"Перезаливка не прошла: " + Итог.Ошибка);

КонецПроцедуры

// Цифры из строки: всё прочее (плюс, скобки, дефисы, пробелы) отбрасывается.
Функция ЦифрыИзСтроки(Знач Текст)

	Результат = "";

	Для Ном = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Ном, 1);

		Если Символ >= "0" И Символ <= "9" Тогда
			Результат = Результат + Символ;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Свой ли это чат: бот когда-либо слал сюда карточки (регистр отправок).
// Этим отсекаются посторонние: бот публичный, написать ему может кто угодно,
// а справка по заказам - только для чатов менеджеров.
Функция ЭтоЧатМенеджера(Знач ЧатИД)

	Если ПустаяСтрока(СокрЛП(Строка(ЧатИД))) Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТелеграмУведомления.НомерСообщения КАК НомерСообщения
		|ИЗ
		|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
		|ГДЕ
		|	ТелеграмУведомления.Чат = &Чат";
	Запрос.УстановитьПараметр("Чат", Лев(СокрЛП(Строка(ЧатИД)), 32));

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Номер телефона в чат - вернуть в чат карточки АКТИВНЫХ заказов клиента.
// Сценарий: клиент перезвонил, а карточки его заказа в чате уже нет (убрал
// регламент, перенос задачи или "не берёт трубку") - менеджеру нужно вернуть
// её на глаза, не открывая 1С. Ищем по хвосту в 9 цифр - он одинаков во всех
// написаниях украинского номера ("+380 66...", "066...", "38066...").
//
// Задача по возвращённому заказу возвращается на сегодня: иначе регламент
// увидел бы её отложенной и через минуту убрал бы карточку обратно.
Процедура ОтветитьИнфоПоТелефону(Знач Токен, Знач ЧатИД, Знач НомерСообщения, Знач Цифры)

	Хвост = Прав(Цифры, 9);

	// Заказы берём сразу по рабочим статусам, а телефон сверяем в памяти -
	// тем же путём, каким карточка строит "Позвонить" (ТелефонДляЗвонка):
	// номер живёт то в ТелефонКонтрагента, то в ТелефонКонтрагента1 (заказы
	// с сайта), то только в контактной информации контрагента, и в реквизите
	// бывает с пробелами - ПОДОБНО по одному полю его не находит (ловили
	// 10.08.2026 на заказе 27676).
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 300
		|	ЗаказПокупателя.Ссылка КАК Ссылка,
		|	ЗаказПокупателя.Номер  КАК Номер
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.СтатусЗаказа В (&Статусы)
		|	И НЕ ЗаказПокупателя.ПометкаУдаления
		|	И ЗаказПокупателя.Дата >= &СДаты
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказПокупателя.Дата УБЫВ";
	Запрос.УстановитьПараметр("Статусы", СтатусыВРаботеСписком());
	Запрос.УстановитьПараметр("СДаты", НачалоДня(ТекущаяДата()) - 180 * 86400);

	Выборка = Запрос.Выполнить().Выбрать();

	Возвращено = "";
	УжеВЧате   = "";
	Ошибки     = "";

	Пока Выборка.Следующий() Цикл

		Если Прав(ЦифрыИзСтроки(ТелефонДляЗвонка(Выборка.Ссылка)), 9) <> Хвост Тогда
			Продолжить;
		КонецЕсли;

		НомерКоротко = "№ " + ОбщегоНазначения.УбратьНоликиСлева(Выборка.Номер);

		Если ЕстьЖиваяКарточка(Выборка.Ссылка) Тогда
			УжеВЧате = УжеВЧате + ?(ПустаяСтрока(УжеВЧате), "", ", ") + НомерКоротко;
			Продолжить;
		КонецЕсли;

		ВернутьЗадачуНаСегодня(Выборка.Ссылка);

		Попытка
			Результат = ВернутьКарточку(Выборка.Ссылка);
		Исключение
			ЗаписатьОшибку(Выборка.Ссылка,
				"Карточка по звонку не восстановлена: " + ОписаниеОшибки());
			Ошибки = Ошибки + ?(ПустаяСтрока(Ошибки), "", ", ") + НомерКоротко;
			Продолжить;
		КонецПопытки;

		Если Результат.Успех Тогда
			Возвращено = Возвращено + ?(ПустаяСтрока(Возвращено), "", ", ") + НомерКоротко;
		Иначе
			Ошибки = Ошибки + ?(ПустаяСтрока(Ошибки), "", ", ") + НомерКоротко;
		КонецЕсли;

	КонецЦикла;

	Если ПустаяСтрока(Возвращено) И ПустаяСтрока(УжеВЧате) И ПустаяСтрока(Ошибки) Тогда
		ОтветитьВЧат(Токен, ЧатИД, НомерСообщения,
			"Активных заказов по номеру " + Цифры + " не нашлось.");
		Возврат;
	КонецЕсли;

	Текст = "";

	Если Не ПустаяСтрока(Возвращено) Тогда
		Текст = "Вернул в чат: " + Возвращено + ".";
	КонецЕсли;

	Если Не ПустаяСтрока(УжеВЧате) Тогда
		Текст = Текст + ?(ПустаяСтрока(Текст), "", Символы.ПС)
			+ "Уже в чате: " + УжеВЧате + ".";
	КонецЕсли;

	Если Не ПустаяСтрока(Ошибки) Тогда
		Текст = Текст + ?(ПустаяСтрока(Текст), "", Символы.ПС)
			+ "Не получилось: " + Ошибки + " - смотрите журнал ""Телеграм.Ошибка"".";
	КонецЕсли;

	ОтветитьВЧат(Токен, ЧатИД, НомерСообщения, Текст);

КонецПроцедуры

// Ссылки рабочих статусов списком - для отборов в запросах: СтатусВРаботе
// сверяет наименования по началу и в запрос не встаёт, а тянуть ВСЕ заказы
// и фильтровать в памяти - дорого. Наименования те же, что в СтатусВРаботе.
Функция СтатусыВРаботеСписком()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СтатусыЗаказов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтатусыЗаказов КАК СтатусыЗаказов
		|ГДЕ
		|	НЕ СтатусыЗаказов.ПометкаУдаления
		|	И (СтатусыЗаказов.Наименование ПОДОБНО ""Не прода%""
		|		ИЛИ СтатусыЗаказов.Наименование ПОДОБНО ""Продан%""
		|		ИЛИ СтатусыЗаказов.Наименование ПОДОБНО ""Ожидает оплат%""
		|		ИЛИ СтатусыЗаказов.Наименование ПОДОБНО ""Резерв%"")";

	Результат = Новый Массив;

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает отложенную задачу заказа на сегодня (9:00): клиент перезвонил -
// работа по заказу снова сегодняшняя, и регламент не должен убрать только
// что возвращённую карточку как отложенную.
Процедура ВернутьЗадачуНаСегодня(Знач Заказ)

	Если Не ЗадачаОтложена(Заказ) Тогда
		Возврат;
	КонецЕсли;

	Задача = ЗадачаПоЗаказу(Заказ);

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Объект = Задача.ПолучитьОбъект();

		Срок = НачалоДня(ТекущаяДата()) + 32400;
		Объект.СрокИсполнения = Срок;
		Если Объект.Оповещение Тогда
			Объект.СрокОповещения = Срок;
		КонецЕсли;

		Объект.Записать();

		ЗаписьЖурналаРегистрации("Телеграм.Задача",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.ЗаказПокупателя, Заказ,
			"Задача возвращена на сегодня: клиент перезвонил,"
			+ " карточка восстановлена по номеру телефона.");

	Исключение

		ЗаписатьОшибку(Заказ, "Задача не возвращена на сегодня: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Секрет вебхука - то же значение, что задаётся у бота в setWebhook параметром
// secret_token. Telegram присылает его заголовком X-Telegram-Bot-Api-Secret-Token,
// и сервис пускает только запрос с совпадающим значением.
//
// Пусто - вебхуком не пользуемся, сервис отвечает 403 на всё. Так и должно быть,
// пока база не опубликована: адрес есть, но он ничего не принимает.
//
// Возвращаемое значение:
//  Строка - секрет; допустимы A-Z, a-z, 0-9, "_" и "-", 1-256 символов.
//
Функция СекретВебхука() Экспорт

	Возврат "DnyUUe1i4SQf9z5CocQ9XDkDEy381dve8OKsFjxY";

КонецФункции

// Проверка связи с ботом - одним запуском отвечает на вопрос "почему кнопка
// или уведомление не работает". Ничего не меняет и не отправляет, только читает.
//
// Запускается из консоли кода на СЕРВЕРЕ (важно: исходящий HTTPS есть только там):
//
//  Сообщить(ТелеграмБот.Диагностика());
//
// На что смотреть в ответе:
//  - "Вебхук: <адрес>" - главная причина, по которой кнопки молчат: пока у бота
//    стоит вебхук, getUpdates отвечает 409 Conflict и нажатия до 1С не доходят
//    вообще. Снимается вызовом deleteWebhook у этого бота;
//  - "Ждёт обновлений: N" при N > 0 и неработающих кнопках - нажатия до Telegram
//    доехали, но их никто не забирает: не включён или не запланирован регламент
//    ТелеграмОбмен;
//  - "Бот: -" - Telegram не ответил вовсе: смотрите событие журнала "Телеграм.Ошибка",
//    там будет отказ и HTTPСоединения, и WinHttp.
//
// Возвращаемое значение:
//  Строка - отчёт; он же пишется в журнал регистрации, событие "Телеграм.Диагностика".
//
Функция Диагностика() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Токен = ТокенБота();

	Если ПустаяСтрока(Токен) Тогда
		Возврат "Не заполнен токен бота (функция ТокенБота).";
	КонецЕсли;

	Отчет = "Время сервера: " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'")
		+ Символы.ПС
		+ "Карточки уходят круглосуточно. Окно звука: "
		+ Формат(НачалоРабочегоДня(), "ЧГ=0") + ":00-"
		+ Формат(КонецРабочегоДня(), "ЧГ=0") + ":00, сейчас "
		+ ?(РабочееВремя(), "внутри окна - уведомления со звуком",
			"вне окна - уведомления беззвучные, просрочка ждёт утра");

	// Кто мы для Telegram.
	ИмяБота = "-";
	Ответ = ВыполнитьЗапрос(Токен, "getMe", "{}", Неопределено);

	Если Ответ <> Неопределено И БулевоJSON(Ответ, "ok") Тогда

		ДанныеБота = Неопределено;
		Если Ответ.Свойство("result", ДанныеБота) И ТипЗнч(ДанныеБота) = Тип("Структура") Тогда
			ИмяБота = "@" + СтрокаJSON(ДанныеБота, "username");
		КонецЕсли;

	КонецЕсли;

	Отчет = Отчет + Символы.ПС + "Бот: " + ИмяБота;

	// Вебхук и очередь обновлений на стороне Telegram.
	Ответ = ВыполнитьЗапрос(Токен, "getWebhookInfo", "{}", Неопределено);

	Если Ответ <> Неопределено И БулевоJSON(Ответ, "ok") Тогда

		ДанныеВебхука = Неопределено;
		Если Ответ.Свойство("result", ДанныеВебхука)
			И ТипЗнч(ДанныеВебхука) = Тип("Структура") Тогда

			АдресВебхука = СтрокаJSON(ДанныеВебхука, "url");

			// Верный ответ зависит от того, каким способом мы РЕШИЛИ работать,
			// а это решает заполненный СекретВебхука(): он же переключает
			// ОбменСБотом с опроса на приём. Раньше здесь любой вебхук
			// объявлялся причиной поломки - после перехода на вебхук
			// диагностика ругалась на штатную настройку и гнала искать
			// несуществующую проблему.
			ВебхукНаш = Не ПустаяСтрока(СекретВебхука());

			Если ПустаяСтрока(АдресВебхука) Тогда

				Отчет = Отчет + Символы.ПС + "Вебхук: "
					+ ?(ВебхукНаш,
						"НЕ УСТАНОВЛЕН, хотя СекретВебхука() заполнен - ПРИЧИНА:"
							+ " заполненный секрет выключает опрос getUpdates"
							+ " в ОбменСБотом, а приносить нажатия некому."
							+ " Либо вызовите setWebhook, либо очистите секрет",
						"не установлен - это правильно, нажатия забирает 1С опросом");

			Иначе

				Отчет = Отчет + Символы.ПС + "Вебхук: " + АдресВебхука
					+ ?(ВебхукНаш,
						" - это правильно, нажатия приносит HTTPСервис.ТелеграмВебхук",
						" - ПРИЧИНА: getUpdates отвечает 409 Conflict,"
							+ " нажатия до 1С не доходят");

			КонецЕсли;

			Отчет = Отчет + Символы.ПС + "Ждёт обновлений: "
				+ Формат(ЧислоJSON(ДанныеВебхука, "pending_update_count"), "ЧН=0; ЧГ=0")
				+ ?(ПустаяСтрока(АдресВебхука),
					" - если больше нуля, а кнопки не отзываются, значит нажатия"
						+ " никто не забирает: смотрите расписание ТелеграмОбмен",
					" - при вебхуке больше нуля значит, что Telegram не может"
						+ " достучаться до адреса: смотрите последнюю ошибку ниже");

			ПоследняяОшибка = СтрокаJSON(ДанныеВебхука, "last_error_message");
			Если Не ПустаяСтрока(ПоследняяОшибка) Тогда
				Отчет = Отчет + Символы.ПС + "Последняя ошибка Telegram: " + ПоследняяОшибка;
			КонецЕсли;

		КонецЕсли;

	КонецЕсли;

	// Что лежит в нашей очереди уведомлений о смене статуса.
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Всего
		|ИЗ
		|	РегистрСведений.ТелеграмОчередь КАК ТелеграмОчередь";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Отчет = Отчет + Символы.ПС + "В очереди смен статуса: "
			+ Формат(Выборка.Всего, "ЧН=0; ЧГ=0");
	КонецЕсли;

	Отчет = Отчет + Символы.ПС + "Нажатия кнопок: "
		+ ?(ПустаяСтрока(СекретВебхука()),
			"забирает регламент ТелеграмОбмен опросом - проверьте, что он включён"
				+ " и его расписание задано в базе",
			"приносит вебхук (HTTPСервис.ТелеграмВебхук), опрос отключён")
		+ Символы.ПС
		+ "Очередь смен статуса и отложенные ночные уведомления развозит регламент"
		+ " ТелеграмОбмен в любом случае - вебхук его не заменяет.";

	ЗаписьЖурналаРегистрации("Телеграм.Диагностика",
		УровеньЖурналаРегистрации.Информация, , , Отчет);

	Возврат Отчет;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Токен бота 1С (@BotFather). Зашит в коде, как ключ обмена в ОплатаПоСсылке.
// Если токен придётся перевыпустить - меняется только эта строка.
Функция ТокенБота()

	Возврат "7991351655:AAEvdG50cjIH4WadLmbtcxJ1pqHdgHv8gss";

КонецФункции

// Получатель уведомлений, когда у статуса не заполнен реквизит "Телеграм: чат получателя"
// (например, поле ещё не выведено на форму). Пусто - шлём только по настройке статуса.
Функция ЧатПоУмолчанию()

	Возврат "";

КонецФункции

// Отдельный чат для уведомлений о новых заказах с сайта. Пусто - берём тот же
// чат, что и у уведомлений по статусам (см. УведомитьОНовомЗаказе).
Функция ЧатНовыхЗаказов()

	Возврат "";

КонецФункции

// Коды типов цен номенклатуры, которые считаем розницей. Список через запятую,
// с запятыми по краям - так поиск подстроки не цепляет соседний код.
// Розница - 000000020, мерчант - 000000018 (просьба пользователя, 12.08.2026:
// заказы по мерчант-цене ведём как розничные). Если розничных типов цен станет
// больше, дописываются сюда.
Функция КодыТиповЦенРозницы()

	Возврат ",000000020,000000018,";

КонецФункции

// Рабочее окно менеджера - 9:00-21:00 по времени сервера. С 10.08.2026 оно НЕ
// откладывает отправку: карточки уходят круглосуточно. Осталось за ним две работы:
//
//  - звук. Вне окна ОтправитьСообщение ставит disable_notification: сообщение
//    приходит, но телефон молчит;
//  - просрочка статуса. БИАС.ПроверкаЗадачь спрашивает эту же функцию и ночью
//    в Telegram не пишет - почему именно она, см. шапку модуля.
//
// Расписание самих регламентов от этого не зависит - оно задаётся в базе;
// ТелеграмОбмен и ПроверкаЗадачь должны крутиться круглосуточно.
//
// Возвращаемое значение:
//  Булево - сейчас можно шуметь: писать менеджеру со звуком и слать просрочку.
//
Функция РабочееВремя() Экспорт

	ТекущийЧас = Час(ТекущаяДата());

	Возврат ТекущийЧас >= НачалоРабочегоДня() И ТекущийЧас < КонецРабочегоДня();

КонецФункции

// Границы окна отправки, часы. Меняются здесь и сразу действуют на все три повода.
Функция НачалоРабочегоДня()

	Возврат 9;

КонецФункции

Функция КонецРабочегоДня()

	Возврат 21;

КонецФункции

// Уходило ли уже уведомление по этой задаче менеджера.
//
// Источник истины - регистр ТелеграмУведомления: в нём ресурсом лежит ссылка
// на задачу. Нужна, чтобы ночную задачу догнать утром ровно один раз: сразу
// после полуночи ПроверкаЗадачь задачу создаёт, но молчит, а утром видит
// "задача есть, записи в истории нет" и отправляет.
//
// Параметры:
//  Задача - ЗадачаСсылка.ЗадачиПользователя - задача менеджера.
//
// Возвращаемое значение:
//  Булево - по задаче уже писали в Telegram.
//
Функция ЗадачаУведомлена(Знач Задача) Экспорт

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТелеграмУведомления.Заказ КАК Заказ
		|ИЗ
		|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
		|ГДЕ
		|	ТелеграмУведомления.Задача = &Задача";
	Запрос.УстановитьПараметр("Задача", Задача);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Рассылает уведомления о смене статуса, накопившиеся в очереди.
// Отправили - запись удалили. Не смогли (сайт лежит, Telegram недоступен) -
// считаем попытки и после третьей выбрасываем: иначе очередь будет вечно
// крутиться на одном заказе и глушить остальные.
//
// Разбираем в любое время суток: ночная смена статуса уходит сразу, беззвучно
// (см. шапку модуля). До 10.08.2026 очередь до 9:00 не трогали вовсе.
Процедура РазобратьОчередь()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	ТелеграмОчередь.Заказ КАК Заказ,
		|	ТелеграмОчередь.Статус КАК Статус,
		|	ТелеграмОчередь.Попыток КАК Попыток
		|ИЗ
		|	РегистрСведений.ТелеграмОчередь КАК ТелеграмОчередь
		|УПОРЯДОЧИТЬ ПО
		|	ТелеграмОчередь.ДатаРегистрации";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		// Слать о смене некому (чаты у статуса не заполнены для этого класса
		// заказов). Тогда решает новый статус: вышел заказ из работы - карточку
		// убираем, заказ уже не в том состоянии, в каком его показали менеджеру,
		// и чат - очередь работы, а не журнал.
		//
		// Заказ ОСТАЛСЯ в работе ("Продано", "Ожидает оплаты", "Резерв",
		// "Не продан") - карточку не убираем: по нему ещё есть что делать,
		// а нового сообщения взамен убранного здесь никто не пошлёт - слать
		// некому. Раньше карточка в этом месте пропадала молча, и это выглядело
		// как "нажал статус - заказ исчез из чата".
		//
		// Зато её ПЕРЕРИСОВЫВАЕМ свежим текстом (с 10.08.2026): до этого текст
		// оставался со старым статусом, пока кто-нибудь не нажмёт кнопку
		// "Статус" вручную, - то есть карточка в чате врала.
		ЧатыСмены = НастройкиУведомлений(Выборка.Статус,
			ЭтоРозничныйЗаказ(Выборка.Заказ)).ЧатыСмены;

		Если ПустаяСтрока(ЧатыСмены) Тогда

			Попытка

				Если СтатусВРаботе(Выборка.Статус) Тогда
					ПерерисоватьКарточкиЗаказа(ТокенБота(), Выборка.Заказ);
				Иначе
					УбратьКарточкиЗаказа(ТокенБота(), Выборка.Заказ);
				КонецЕсли;

			Исключение
				ЗаписатьОшибку(Выборка.Заказ, "Карточки заказа не обновлены"
					+ " после смены статуса: " + ОписаниеОшибки());
			КонецПопытки;

			УдалитьИзОчереди(Выборка.Заказ, Выборка.Статус);
			Продолжить;

		КонецЕсли;

		Отправлено = Ложь;

		Попытка
			Отправлено = УведомитьОСменеСтатуса(Выборка.Заказ, Выборка.Статус);
		Исключение
			ЗаписатьОшибку(Выборка.Заказ, "Уведомление о смене статуса не отправлено: "
				+ ОписаниеОшибки());
		КонецПопытки;

		Если Отправлено Тогда

			УдалитьИзОчереди(Выборка.Заказ, Выборка.Статус);

		ИначеЕсли Выборка.Попыток >= 2 Тогда

			ЗаписатьОшибку(Выборка.Заказ, "Уведомление о смене статуса ""сгорело"""
				+ " после трёх попыток - запись убрана из очереди.");

			УдалитьИзОчереди(Выборка.Заказ, Выборка.Статус);

		Иначе

			ОтметитьПопытку(Выборка.Заказ, Выборка.Статус, Выборка.Попыток + 1);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Досылает уведомления о новых заказах, по которым карточка ещё не уходила:
//
//  - заказы С САЙТА, по которым отправка в момент загрузки не состоялась
//    (Telegram не ответил, у статуса тогда не было чатов). Ночная пачка сюда
//    больше не относится: с 10.08.2026 УведомитьОНовомЗаказе шлёт круглосуточно;
//  - заказы, заведённые МЕНЕДЖЕРОМ В 1С сразу в статусе "Ожидает оплаты"
//    (код 000000005). По ним карточки не было вообще: УведомитьОНовомЗаказе
//    зовёт только обмен с сайтом, а ЗаказПокупателя.ПроверитьСтатус первую
//    установку статуса за смену не считает (СтатусДо пуст) и в очередь ничего
//    не ставит. То есть менеджер такой заказ в чате не видел - при том что
//    работа по нему та же, что по "Продано" (решение пользователя 10.08.2026).
//    Берём только проведённые: непроведённый заказ ещё дописывают.
//
// Отдельной очереди не нужно: заказ с сайта опознаётся по НомерЗаказа2ССайта,
// а факт отправки - по регистру ТелеграмУведомления. Отсюда и окно поиска:
// 12 часов назад от текущего момента - заказ, по которому уведомление не ушло
// когда-то давно, лавиной уже не поднимется.
//
// Не розничные заказы из выборки не отсеиваем запросом - это делает
// УведомитьОНовомЗаказе; они просто молча выпадут из окна через 12 часов.
Процедура ДогнатьНовыеЗаказы()

	// Получателя нет вообще ни у кого - выходим молча. Иначе каждый прогон
	// регламента писал бы в журнал "некому отправить" по одним и тем же заказам:
	// они из окна не уходят, пока уведомление не отправлено.
	Если ПустаяСтрока(ЧатНовыхЗаказов())
		И ПустаяСтрока(ПервыйНастроенныйЧат())
		И ПустаяСтрока(ЧатПоУмолчанию()) Тогда

		Возврат;

	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	ЗаказПокупателя.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	НЕ ЗаказПокупателя.ПометкаУдаления
		|	И ЗаказПокупателя.Дата >= &СДаты
		|	И (ЗаказПокупателя.НомерЗаказа2ССайта <> """"
		|			ИЛИ (ЗаказПокупателя.Проведен
		|				И ЗаказПокупателя.СтатусЗаказа.Код = &КодОжидаетОплаты))
		|	И НЕ ЗаказПокупателя.Ссылка В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|				ТелеграмУведомления.Заказ КАК Заказ
		|			ИЗ
		|				РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
		|			ГДЕ
		|				ТелеграмУведомления.ВидУведомления = &ВидУведомления)
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказПокупателя.Дата";

	Запрос.УстановитьПараметр("СДаты", ТекущаяДата() - 12 * 3600);
	Запрос.УстановитьПараметр("ВидУведомления", "НовыйЗаказ");
	Запрос.УстановитьПараметр("КодОжидаетОплаты", "000000005");

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Попытка
			УведомитьОНовомЗаказе(Выборка.Ссылка);
		Исключение
			ЗаписатьОшибку(Выборка.Ссылка, "Отложенное уведомление о новом заказе"
				+ " не отправлено: " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Держит чаты зеркалом активных заказов: у заказа в работе в чате должна
// висеть карточка, у вышедшего из работы - не должно остаться ни одной.
//
//  - Заказ в активном статусе, по нему есть ОТКРЫТАЯ ЗАДАЧА, а живых карточек
//    в истории нет (убрали сменой статуса без отправки, снесли старым кодом,
//    удалили в чате через 1С) - карточка ВОССТАНАВЛИВАЕТСЯ той же
//    ВернутьКарточку, что работает из админки: в те же чаты, с заголовком
//    "Вернули в чат". Задачи нет - не воскрешаем: см. условие в цикле.
//  - Заказ вышел из работы ("Завершенные", "Отказ"...), а карточки ещё висят -
//    убираем из всех чатов. Это же делает закрытие задач (БИАС.ОтменитьЗадачи)
//    и кнопки в чате, но регламент - страховка на случай, когда статус сменили
//    в обход них.
//  - Заказ ещё в работе, но задача, ПО КОТОРОЙ карточка отправлена, закрыта,
//    и другой открытой задачи по заказу нет - убираем. Закрыть задачу могли
//    руками в 1С, кнопкой в чате или автозакрытием БИАС.ОтменитьЗадачи; бот
//    об этом не узнаёт, разгребает регламент.
//
// Про удалённые РУКАМИ В ЧАТЕ сообщения Telegram боту не сообщает - такие
// карточки в истории числятся живыми, и восстановление их не увидит. Реальный
// охват: всё, что убирала сама 1С, - она всегда помечает запись убранной.
//
// Активность статуса - СтатусВРаботе, тот же список, по которому кнопка
// "Статус" решает убрать карточку. Окно - месяц по дате отправки: старее
// в чатах уже никто не смотрит, и лавины по древней истории быть не должно.
// Лимиты на прогон стоят от шторма после загрузки этой правки: регламент
// крутится раз в 1-2 минуты и спокойно разгребёт хвост за несколько заходов.
Процедура СинхронизироватьКарточки() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	// Время суток не проверяем: чат зеркалит заказы круглосуточно, восстановленная
	// ночью карточка приходит беззвучно (см. шапку модуля).
	Токен = ТокенБота();

	Если ПустаяСтрока(Токен) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ТелеграмУведомления.Заказ                   КАК Заказ,
		|	ТелеграмУведомления.Заказ.СтатусЗаказа      КАК Статус,
		|	ТелеграмУведомления.Заказ.ПометкаУдаления   КАК ПометкаУдаления,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА НЕ ТелеграмУведомления.Убрано
		|					И ТелеграмУведомления.НомерСообщения <> 0
		|				ТОГДА 1
		|			ИНАЧЕ 0
		|		КОНЕЦ)                                  КАК ЕстьЖиваяКарточка
		|ИЗ
		|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
		|ГДЕ
		|	ТелеграмУведомления.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
		|	И ТелеграмУведомления.ДатаОтправки >= &СДаты
		|СГРУППИРОВАТЬ ПО
		|	ТелеграмУведомления.Заказ,
		|	ТелеграмУведомления.Заказ.СтатусЗаказа,
		|	ТелеграмУведомления.Заказ.ПометкаУдаления";

	Запрос.УстановитьПараметр("СДаты", НачалоДня(ТекущаяДата()) - 30 * 86400);

	Выборка = Запрос.Выполнить().Выбрать();

	Восстановлено = 0;
	УбраноЗаказов = 0;

	Пока Выборка.Следующий() Цикл

		ВРаботе = Не Выборка.ПометкаУдаления И СтатусВРаботе(Выборка.Статус);

		// Карточке в чате место только пока по заказу есть задача с НАСТУПИВШИМ
		// напоминанием - см. ЕстьАктуальнаяЗадача и шапку модуля. Запрос делаем
		// только для заказов в работе: у вышедшего из работы карточку снимаем
		// в любом случае, спрашивать задачу незачем.
		ЗадачаАктуальна = ВРаботе И ЕстьАктуальнаяЗадача(Выборка.Заказ);

		Если Выборка.ЕстьЖиваяКарточка = 1 И Не ЗадачаАктуальна Тогда

			Если УбраноЗаказов >= 20 Тогда
				Продолжить;
			КонецЕсли;

			УбраноЗаказов = УбраноЗаказов + 1;

			Попытка
				УбратьКарточкиЗаказа(Токен, Выборка.Заказ);
			Исключение
				ЗаписатьОшибку(Выборка.Заказ, "Карточки неактуального заказа"
					+ " не убраны: " + ОписаниеОшибки());
				Продолжить;
			КонецПопытки;

			Если Не ВРаботе Тогда
				Причина = "заказ вышел из работы.";
			Иначе
				Причина = "по заказу нет задачи с наступившим напоминанием"
					+ " (закрыта или перенесена на будущее).";
			КонецЕсли;

			ЗаписьЖурналаРегистрации("Телеграм.Кнопка",
				УровеньЖурналаРегистрации.Информация,
				Метаданные.Документы.ЗаказПокупателя, Выборка.Заказ,
				"Карточки убраны регламентом: " + Причина
				+ Символы.ПС + "Статус: " + СокрЛП(Строка(Выборка.Статус)));

		ИначеЕсли Выборка.ЕстьЖиваяКарточка = 0 И ЗадачаАктуальна Тогда

			Если Восстановлено >= 10 Тогда
				Продолжить;
			КонецЕсли;

			// Восстанавливаем только розницу - тем же фильтром, что и обычная
			// отправка. Опт в чат не шлём, даже если его карточка когда-то там
			// была (её могли вернуть руками из админки - это осознанный разовый
			// возврат, а не подписка на восстановление).
			Если Не ЭтоРозничныйЗаказ(Выборка.Заказ) Тогда
				Продолжить;
			КонецЕсли;

			// Перепроверка свежим запросом, а не по снимку, с которого начали:
			// перезаливка из админки (ПерезалитьВсеКарточки) сперва помечает
			// ВСЁ убранным и лишь потом шлёт заново. Прогон регламента в этот
			// промежуток видел "живых карточек нет" по каждому заказу и слал
			// свою копию - в чате оказывались две одинаковых по ВСЕМ заказам.
			Если ЕстьЖиваяКарточка(Выборка.Заказ) Тогда
				Продолжить;
			КонецЕсли;

			Восстановлено = Восстановлено + 1;

			Попытка
				Результат = ВернутьКарточку(Выборка.Заказ);
			Исключение
				ЗаписатьОшибку(Выборка.Заказ, "Карточка активного заказа"
					+ " не восстановлена: " + ОписаниеОшибки());
				Продолжить;
			КонецПопытки;

			Если Результат.Успех Тогда

				ЗаписьЖурналаРегистрации("Телеграм.Кнопка",
					УровеньЖурналаРегистрации.Информация,
					Метаданные.Документы.ЗаказПокупателя, Выборка.Заказ,
					"Карточка восстановлена регламентом: заказ в работе,"
					+ " а живых сообщений в чатах не было."
					+ Символы.ПС + "Чаты: " + Результат.Чаты);

			Иначе

				ЗаписатьОшибку(Выборка.Заказ, "Карточка активного заказа"
					+ " не восстановлена: " + Результат.Ошибка);

			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

// Переписывает висящие в чатах карточки заказов, по которым пришли деньги.
//
// Зачем: карточка уходит менеджеру в момент появления заказа, а платит клиент
// позже - сам на сайте или после того, как менеджер добьёт оплату в Viber. Без
// этого строка "Оплата" навсегда осталась бы такой, какой была при отправке.
//
// Один запрос к WayForPay на прогон, а не по запросу на карточку: TRANSACTION_LIST
// отдаёт все транзакции за период разом (его же дёргает загрузка выписок), и
// сопоставить их с карточками можно уже локально. Запроса не будет вовсе, если
// подходящих карточек нет. Время суток не проверяем: карточки теперь висят в чате
// и ночью, и оплата на них должна проступать тогда же, когда пришла.
//
// Подходящая карточка - живая (не убранная из чата) и не отмеченная обработанной,
// по заказу с заполненным WayForPayOrderReference. Убранную править не в чем,
// а у отмеченной перерисовка стёрла бы галку с датой на кнопке.
//
// Правим только когда текст реально изменился: на повторную правку тем же текстом
// Telegram отвечает ошибкой "message is not modified". Сравниваем со строкой Текст
// из регистра - там лежит то, что в чате сейчас и написано.
Процедура ОбновитьОплаченныеКарточки()

	Токен = ТокенБота();

	Если ПустаяСтрока(Токен) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	ТелеграмУведомления.Заказ          КАК Заказ,
		|	ТелеграмУведомления.Чат            КАК Чат,
		|	ТелеграмУведомления.НомерСообщения КАК НомерСообщения,
		|	ТелеграмУведомления.ВидУведомления КАК ВидУведомления,
		|	ТелеграмУведомления.Текст          КАК Текст,
		|	ТелеграмУведомления.Заказ.WayForPayOrderReference КАК OrderReference
		|ИЗ
		|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
		|ГДЕ
		|	НЕ ТелеграмУведомления.Обработан
		|	И НЕ ТелеграмУведомления.Убрано
		|	И ТелеграмУведомления.НомерСообщения <> 0
		|	И ТелеграмУведомления.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
		|	И ТелеграмУведомления.Заказ.WayForPayOrderReference <> """"
		|	И ТелеграмУведомления.ДатаОтправки >= &СДаты";

	// Две недели: столько живёт самая долгая переписка по оплате. Карточку старше
	// менеджер всё равно уже не смотрит, а без границы выборка тянула бы за собой
	// всё, что когда-то отправлялось и осталось неотмеченным.
	Запрос.УстановитьПараметр("СДаты", НачалоДня(ТекущаяДата()) - 14 * 86400);

	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;

	// Вчера + сегодня: ПолучитьСписокТранзакций округляет период до целых суток,
	// и без вчерашнего дня платёж, прошедший под полночь, выпал бы из окна.
	Транзакции = WayForPay.ПолучитьСписокТранзакций(ТекущаяДата() - 86400, ТекущаяДата());

	Оплаты = Новый Соответствие;

	Для Каждого Транзакция Из Транзакции Цикл

		Если ТипЗнч(Транзакция) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;

		СтатусТранзакции = "";
		Транзакция.Свойство("transactionStatus", СтатусТранзакции);

		Если СокрЛП(Строка(СтатусТранзакции)) <> "Approved" Тогда
			Продолжить;
		КонецЕсли;

		Реф = "";
		Транзакция.Свойство("orderReference", Реф);
		Реф = СокрЛП(Строка(Реф));

		Если Не ПустаяСтрока(Реф) Тогда
			Оплаты.Вставить(Реф, Транзакция);
		КонецЕсли;

	КонецЦикла;

	Если Оплаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл

		Транзакция = Оплаты.Получить(СокрЛП(Строка(Выборка.OrderReference)));

		Если Транзакция = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			ОбновитьКарточкуПоОплате(Токен, Выборка, Транзакция);
		Исключение
			ЗаписатьОшибку(Выборка.Заказ, "Карточка не обновлена после оплаты: "
				+ ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Перерисовывает одно сообщение с учётом пришедшей оплаты.
//
// Клавиатуру собираем заново без отметки: сюда попадают только необработанные
// карточки (см. отбор в ОбновитьОплаченныеКарточки), у них кнопка "Обработан"
// ещё живая. Не передать reply_markup нельзя - editMessageText без неё убирает
// кнопки из сообщения совсем.
//
// Параметры:
//  Токен      - Строка    - токен бота.
//  Карточка   - ВыборкаИзРезультатаЗапроса - строка по карточке: Заказ, Чат,
//               НомерСообщения, ВидУведомления, Текст.
//  Транзакция - Структура - подтверждённая транзакция WayForPay по этому заказу.
//
Процедура ОбновитьКарточкуПоОплате(Знач Токен, Знач Карточка, Знач Транзакция)

	Заказ = Карточка.Заказ;

	Текст = ТекстПоЗаказу(Заказ, Заказ.СтатусЗаказа,
		ЗаголовокПоВиду(Карточка.ВидУведомления),
		ДанныеОбОплате(Заказ, Транзакция));

	Если Текст = Карточка.Текст Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(Карточка.Чат)));
	Параметры.Вставить("message_id", Карточка.НомерСообщения);
	Параметры.Вставить("text", ?(СтрДлина(Текст) > 4000, Лев(Текст, 3990) + "...", Текст));
	Параметры.Вставить("parse_mode", "HTML");
	Параметры.Вставить("disable_web_page_preview", Истина);
	Параметры.Вставить("reply_markup", КлавиатураЗаказа(Заказ));

	Ответ = ВыполнитьЗапрос(Токен, "editMessageText", ВJSON(Параметры), Заказ);

	Если Ответ = Неопределено Или Не БулевоJSON(Ответ, "ok") Тогда
		Возврат;
	КонецЕсли;

	ОбновитьТекстВИстории(Заказ, Карточка.Чат, Карточка.НомерСообщения, Текст);

	ЗаписьЖурналаРегистрации("Телеграм.Оплата",
		УровеньЖурналаРегистрации.Информация,
		Метаданные.Документы.ЗаказПокупателя,
		Заказ,
		"Карточка обновлена: по заказу поступила оплата WayForPay.");

КонецПроцедуры

// Переписывает сохранённый текст карточки в истории отправок. Без этого
// следующий прогон сравнил бы свежий текст со старым и правил бы то же
// сообщение снова и снова.
Процедура ОбновитьТекстВИстории(Знач Заказ, Знач ЧатИД, Знач НомерСообщения, Знач Текст)

	Попытка

		Запись = РегистрыСведений.ТелеграмУведомления.СоздатьМенеджерЗаписи();
		Запись.Заказ          = Заказ;
		Запись.Чат            = Лев(СокрЛП(Строка(ЧатИД)), 32);
		Запись.НомерСообщения = НомерСообщения;
		Запись.Прочитать();

		Если Не Запись.Выбран() Тогда
			Возврат;
		КонецЕсли;

		Запись.Текст = Текст;
		Запись.Записать(Истина);

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось обновить текст карточки в истории: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Проставляет задачу живым карточкам заказа, у которых она пуста.
//
// Карточку мог прислать путь, который о задачах не знает: уведомление о новом
// заказе, возврат карточки регламентом или из админки. Тогда кнопка "Обработан"
// под ней пишет в никуда, а ЗадачаУведомлена не видит, что по заказу сообщение
// уже висит, - и просрочка каждый прогон норовит прислать вторую карточку.
//
// Молчит, если задача не задана: карточка так и останется без задачи, это
// нормальное состояние для уведомления о новом заказе.
Процедура ПривязатьЗадачуККарточкам(Знач Заказ, Знач Задача)

	Если Не ЗначениеЗаполнено(Заказ) Или Не ЗначениеЗаполнено(Задача) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ТелеграмУведомления.Чат            КАК Чат,
			|	ТелеграмУведомления.НомерСообщения КАК НомерСообщения
			|ИЗ
			|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
			|ГДЕ
			|	ТелеграмУведомления.Заказ = &Заказ
			|	И НЕ ТелеграмУведомления.Убрано
			|	И ТелеграмУведомления.НомерСообщения <> 0
			|	И ТелеграмУведомления.Задача = ЗНАЧЕНИЕ(Задача.ЗадачиПользователя.ПустаяСсылка)";
		Запрос.УстановитьПараметр("Заказ", Заказ);

		Выборка = Запрос.Выполнить().Выбрать();

		Пока Выборка.Следующий() Цикл

			Запись = РегистрыСведений.ТелеграмУведомления.СоздатьМенеджерЗаписи();
			Запись.Заказ          = Заказ;
			Запись.Чат            = Лев(СокрЛП(Строка(Выборка.Чат)), 32);
			Запись.НомерСообщения = Выборка.НомерСообщения;
			Запись.Прочитать();

			Если Не Запись.Выбран() Тогда
				Продолжить;
			КонецЕсли;

			Запись.Задача = Задача;
			Запись.Записать(Истина);

		КонецЦикла;

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось привязать задачу к карточкам заказа: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

Процедура УдалитьИзОчереди(Знач Заказ, Знач Статус)

	Попытка

		Запись = РегистрыСведений.ТелеграмОчередь.СоздатьМенеджерЗаписи();
		Запись.Заказ  = Заказ;
		Запись.Статус = Статус;
		Запись.Удалить();

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось убрать запись из очереди уведомлений: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

Процедура ОтметитьПопытку(Знач Заказ, Знач Статус, Знач Попыток)

	Попытка

		Запись = РегистрыСведений.ТелеграмОчередь.СоздатьМенеджерЗаписи();
		Запись.Заказ  = Заказ;
		Запись.Статус = Статус;
		Запись.Прочитать();

		Если Не Запись.Выбран() Тогда
			Запись.Заказ           = Заказ;
			Запись.Статус          = Статус;
			Запись.ДатаРегистрации = ТекущаяДата();
		КонецЕсли;

		Запись.Попыток = Попыток;
		Запись.Записать(Истина);

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось отметить попытку в очереди уведомлений: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Разбирает реквизит "Телеграм: чаты" в массив chat_id. Разделители - запятая,
// точка с запятой, пробел и перенос строки: менеджер пишет как удобно.
// Дубли убираем - иначе одно и то же сообщение придёт в чат дважды.
Функция ЧатыСписком(Знач Чаты)

	Результат = Новый Массив;
	Добавленные = Новый Соответствие;

	Текст = СокрЛП(Строка(Чаты));

	Если ПустаяСтрока(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Текст = СтрЗаменить(Текст, ";", ",");
	Текст = СтрЗаменить(Текст, Символы.ПС, ",");
	Текст = СтрЗаменить(Текст, Символы.ВК, ",");
	Текст = СтрЗаменить(Текст, Символы.Таб, ",");
	Текст = СтрЗаменить(Текст, " ", ",");

	Для Каждого Часть Из СтрРазделить(Текст, ",", Ложь) Цикл

		Чат = СокрЛП(Часть);

		Если ПустаяСтрока(Чат) Или Добавленные.Получить(Чат) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Добавленные.Вставить(Чат, Истина);
		Результат.Добавить(Чат);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Чаты, настроенные хоть у одного статуса заказов - чтобы уведомление было кому
// отправить, пока для конкретного статуса чаты не заполнены. Может вернуть
// список через запятую - его разбирает ЧатыСписком.
Функция ПервыйНастроенныйЧат()

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СтатусыЗаказов.ТелеграмЧат КАК ТелеграмЧат
		|ИЗ
		|	Справочник.СтатусыЗаказов КАК СтатусыЗаказов
		|ГДЕ
		|	СтатусыЗаказов.ОтправлятьВТелеграм
		|	И СтатусыЗаказов.ТелеграмЧат <> """"
		|	И НЕ СтатусыЗаказов.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	СтатусыЗаказов.Код";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Строка(Выборка.ТелеграмЧат));
	КонецЕсли;

	Возврат "";

КонецФункции

// Разметка кнопок под сообщением: "Статус" и "Обработан".
// В callback_data уезжает уникальный идентификатор заказа - по нему
// ПолучитьОтветы() находит заказ. Лимит Telegram на callback_data - 64 байта,
// префикс + UUID укладываются в 39.
//
// Параметры:
//  Заказ     - ДокументСсылка.ЗаказПокупателя - заказ.
//  Обработан - Булево - кнопка обработки уже нажата: вместо действия показываем
//              отметку. Кнопка "Статус" при этом остаётся рабочей.
//  Отметка   - Строка - что писать на кнопке вместо "Обработан".
//
Функция КлавиатураЗаказа(Знач Заказ, Знач Обработан = Ложь, Знач Отметка = "")

	Идентификатор = Строка(Заказ.УникальныйИдентификатор());

	// На кнопке пишем сам статус, а не слово "Статус": так его видно сразу,
	// не нажимая, а нажатие просто обновляет надпись. Эмодзи 🔄 оставляем -
	// по нему понятно, что кнопка рабочая, а не подпись.
	//
	// Надпись - статус НА МОМЕНТ отправки сообщения, ровно как и его текст;
	// свежий подтянется нажатием. Лимит Telegram на подпись - 64 символа.
	ТекущийСтатус = СокрЛП(Строка(Заказ.СтатусЗаказа));

	КнопкаСтатуса = Новый Структура;
	КнопкаСтатуса.Вставить("text",
		"🔄 " + ?(ПустаяСтрока(ТекущийСтатус), "Статус", Лев(ТекущийСтатус, 40)));
	КнопкаСтатуса.Вставить("callback_data", "st:" + Идентификатор);

	// Кнопки "Обработан" больше нет (решение пользователя, 09.08.2026): смысла
	// в отдельной отметке не осталось - итог звонка фиксируют быстрые заметки
	// и "Не актуален", а карточку из чата убирает смена статуса. Обработчики
	// её нажатий (ok:/done) не тронуты: в чатах ещё висят сообщения со старой
	// клавиатурой, и их кнопки должны отвечать, а не падать. Параметры
	// Обработан/Отметка у функции оставлены по той же причине - их передают
	// все места перерисовки.
	// "Текст оплаты" - бот присылает в ЭТОТ чат готовый текст для клиента
	// (тот же, что собирает кнопка "Оплата" в форме заказа) ответом на
	// карточку. Менеджер пересылает его клиенту в личный Telegram/Viber
	// с телефона. Клиенту напрямую бот не пишет, подтверждение не нужно.
	КнопкаОплаты = Новый Структура;
	КнопкаОплаты.Вставить("text", "💳 Текст оплаты");
	КнопкаОплаты.Вставить("callback_data", "tp:" + Идентификатор);

	Ряд = Новый Массив;
	Ряд.Добавить(КнопкаСтатуса);
	Ряд.Добавить(КнопкаОплаты);

	Клавиатура = Новый Массив;
	Клавиатура.Добавить(Ряд);

	// Кнопки "Задача" больше нет (решение пользователя, 10.08.2026): она
	// дублировала то, что и так на виду. Содержание задачи вклеено прямо
	// в карточку (см. ТекстПоЗаказу), текст дописывается ответом на сообщение
	// без всяких кнопок, а срок "завтра" ставят обе быстрые заметки.
	// Обработчики её меню (ts:/t0:/t1:/t3:/tx:/tb:) намеренно оставлены
	// живыми: в чатах висят сообщения со старой клавиатурой, и их нажатия
	// должны отвечать, а не падать.

	// Быстрые заметки - итог звонка одним нажатием: в задачу дописывается
	// дата, кто нажал и штамп ("не берёт трубку" / "обещала оплатить"),
	// задачи нет - создаётся. Содержание задачи тут же появляется в тексте
	// карточки (см. ТекстПоЗаказу), отдельно открывать её не нужно.
	КнопкаНеБерет = Новый Структура;
	КнопкаНеБерет.Вставить("text", "📵 Не берёт трубку");
	КнопкаНеБерет.Вставить("callback_data", "nt:" + Идентификатор);

	КнопкаОбещала = Новый Структура;
	КнопкаОбещала.Вставить("text", "💰 Обещала оплатить");
	КнопкаОбещала.Вставить("callback_data", "op:" + Идентификатор);

	РядЗаметок = Новый Массив;
	РядЗаметок.Добавить(КнопкаНеБерет);
	РядЗаметок.Добавить(КнопкаОбещала);

	Клавиатура.Добавить(РядЗаметок);

	// "Не актуален" - перевод заказа в "Не удачные" прямо из чата. Сама по себе
	// кнопка ничего не меняет: она лишь подменяет клавиатуру вопросом
	// (КлавиатураПодтвержденияНеАктуален), статус меняет только явное "Да".
	КнопкаНеАктуален = Новый Структура;
	КнопкаНеАктуален.Вставить("text", "🚫 Не актуален");
	КнопкаНеАктуален.Вставить("callback_data", "na:" + Идентификатор);

	РядЗадачи = Новый Массив;
	РядЗадачи.Добавить(КнопкаНеАктуален);

	Клавиатура.Добавить(РядЗадачи);

	Разметка = Новый Структура;
	Разметка.Вставить("inline_keyboard", Клавиатура);

	Возврат Разметка;

КонецФункции

// Клавиатура-вопрос для "Не актуален". Модальных окон с кнопками у Bot API
// нет (show_alert показывает только текст с "ОК"), поэтому окно подтверждения -
// это вторая клавиатура того же сообщения: случайное нажатие ничего не меняет,
// а "Отмена" возвращает обычные кнопки (тот же обработчик, что у "Назад").
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  Структура - reply_markup для Bot API.
//
Функция КлавиатураПодтвержденияНеАктуален(Знач Заказ)

	Идентификатор = Строка(Заказ.УникальныйИдентификатор());

	КнопкаДа = Новый Структура;
	КнопкаДа.Вставить("text", "❗ Да, в «Не удачные»");
	КнопкаДа.Вставить("callback_data", "ny:" + Идентификатор);

	КнопкаОтмена = Новый Структура;
	КнопкаОтмена.Вставить("text", "↩ Отмена");
	КнопкаОтмена.Вставить("callback_data", "tb:" + Идентификатор);

	Ряд = Новый Массив;
	Ряд.Добавить(КнопкаДа);
	Ряд.Добавить(КнопкаОтмена);

	Клавиатура = Новый Массив;
	Клавиатура.Добавить(Ряд);

	Разметка = Новый Структура;
	Разметка.Вставить("inline_keyboard", Клавиатура);

	Возврат Разметка;

КонецФункции

// Меню задачи - вторая клавиатура ТОГО ЖЕ сообщения, открывается кнопкой
// "Задача". Новых сообщений в чат не шлём принципиально (иначе чат превратится
// в ленту дублей одного заказа), поэтому правка живёт в подменю.
//
// Срок - кнопками: дату в Telegram иначе не ввести, callback_data это заранее
// заданная строка, а не поле ввода. Текст - ответом на сообщение заказа,
// его разбирает ПринятьОбновление.
//
// Параметры:
//  Заказ - ДокументСсылка.ЗаказПокупателя - заказ.
//
// Возвращаемое значение:
//  Структура - reply_markup для Bot API.
//
Функция КлавиатураЗадачи(Знач Заказ)

	Идентификатор = Строка(Заказ.УникальныйИдентификатор());

	КнопкаСегодня = Новый Структура;
	КнопкаСегодня.Вставить("text", "📅 Сегодня");
	КнопкаСегодня.Вставить("callback_data", "t0:" + Идентификатор);

	КнопкаЗавтра = Новый Структура;
	КнопкаЗавтра.Вставить("text", "📅 Завтра");
	КнопкаЗавтра.Вставить("callback_data", "t1:" + Идентификатор);

	КнопкаТриДня = Новый Структура;
	КнопкаТриДня.Вставить("text", "📅 +3 дня");
	КнопкаТриДня.Вставить("callback_data", "t3:" + Идентификатор);

	РядСрока = Новый Массив;
	РядСрока.Добавить(КнопкаСегодня);
	РядСрока.Добавить(КнопкаЗавтра);
	РядСрока.Добавить(КнопкаТриДня);

	КнопкаТекста = Новый Структура;
	КнопкаТекста.Вставить("text", "✏️ Текст");
	КнопкаТекста.Вставить("callback_data", "tx:" + Идентификатор);

	КнопкаНазад = Новый Структура;
	КнопкаНазад.Вставить("text", "⬅️ Назад");
	КнопкаНазад.Вставить("callback_data", "tb:" + Идентификатор);

	РядДействий = Новый Массив;
	РядДействий.Добавить(КнопкаТекста);
	РядДействий.Добавить(КнопкаНазад);

	Клавиатура = Новый Массив;
	Клавиатура.Добавить(РядСрока);
	Клавиатура.Добавить(РядДействий);

	Разметка = Новый Структура;
	Разметка.Вставить("inline_keyboard", Клавиатура);

	Возврат Разметка;

КонецФункции

// Номер отправленного сообщения (message_id) из ответа sendMessage.
Функция НомерСообщенияИзОтвета(Знач Ответ)

	Результат = Неопределено;

	Если Не Ответ.Свойство("result", Результат) Или ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ЧислоJSON(Результат, "message_id");

КонецФункции

// Пишет отправленное сообщение в историю (регистр ТелеграмУведомления).
// История не должна ронять отправку: сообщение менеджеру уже ушло.
Процедура ЗаписатьВИсторию(Знач ЧатИД, Знач НомерСообщения, Знач Заказ,
	Знач ВидУведомления, Знач Текст, Знач Задача)

	Если НомерСообщения = 0 Или ПустаяСтрока(СокрЛП(Строка(ЧатИД))) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Запись = РегистрыСведений.ТелеграмУведомления.СоздатьМенеджерЗаписи();

		Запись.Заказ = ?(ЗначениеЗаполнено(Заказ),
			Заказ, Документы.ЗаказПокупателя.ПустаяСсылка());

		Запись.Чат            = Лев(СокрЛП(Строка(ЧатИД)), 32);
		Запись.НомерСообщения = НомерСообщения;
		Запись.ДатаОтправки   = ТекущаяДата();
		Запись.ВидУведомления = Лев(ВидУведомления, 30);
		Запись.Текст          = Текст;
		Запись.Обработан      = Ложь;

		Если ЗначениеЗаполнено(Задача) Тогда
			Запись.Задача = Задача;
		КонецЕсли;

		Запись.Записать(Истина);

	Исключение

		ЗаписьЖурналаРегистрации("Телеграм.Ошибка",
			УровеньЖурналаРегистрации.Предупреждение,
			?(ЗначениеЗаполнено(Заказ), Метаданные.Документы.ЗаказПокупателя, Неопределено),
			Заказ,
			"Сообщение отправлено, но в историю не записалось: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Дублирует запись об отправке на сайт - во вкладку админки "Уведомления 1С".
// Источник истины остаётся в регистре ТелеграмУведомления; сайту отдаём копию,
// чтобы историю можно было смотреть из браузера, не заходя в 1С.
//
// Сайт в отправке менеджеру не участвует вообще (1С шлёт своим ботом напрямую),
// поэтому строку в его журнал кладём отсюда, вызовом cron_manager_notify.php.
Процедура ЗеркалитьНаСайт(Знач Заказ, Знач ВидУведомления, Знач Текст)

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;

	Вид = ВидДляСайта(ВидУведомления);

	Если ПустаяСтрока(Вид) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Контрагент = Заказ.Контрагент;

		ТелоЗапроса = "token=" + БИАС.КодироватьПараметрPOST(ТокенСайта())
			+ "&event=sent"
			+ "&kind="  + БИАС.КодироватьПараметрPOST(Вид)
			+ "&order=" + БИАС.КодироватьПараметрPOST(СокрЛП(Заказ.Номер))
			+ "&code="  + БИАС.КодироватьПараметрPOST(СокрЛП(Строка(Контрагент.Код)))
			+ "&name="  + БИАС.КодироватьПараметрPOST(СокрЛП(Строка(Контрагент)))
			+ "&text="  + БИАС.КодироватьПараметрPOST(Текст);

		ЗапросКСайту(ТелоЗапроса, Заказ);

	Исключение

		// Зеркало не должно влиять на отправку: сообщение менеджеру уже ушло,
		// а история есть в регистре.
		ЗаписатьОшибку(Заказ, "Не удалось продублировать уведомление на сайт: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Сообщает сайту, что менеджер нажал "Обработан" - чтобы во вкладке
// "Уведомления 1С" строка перестала висеть в "ждёт обработки".
Процедура ЗеркалитьОбработкуНаСайт(Знач Заказ, Знач Кто)

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;

	Попытка

		ТелоЗапроса = "token=" + БИАС.КодироватьПараметрPOST(ТокенСайта())
			+ "&event=handled"
			+ "&order=" + БИАС.КодироватьПараметрPOST(СокрЛП(Заказ.Номер))
			+ "&who="   + БИАС.КодироватьПараметрPOST(Кто);

		ЗапросКСайту(ТелоЗапроса, Заказ);

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось передать отметку обработки на сайт: "
			+ ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Вид уведомления 1С -> параметр kind приёмника сайта.
Функция ВидДляСайта(Знач ВидУведомления)

	Если ВидУведомления = "НовыйЗаказ" Тогда
		Возврат "new";
	ИначеЕсли ВидУведомления = "ПросрочкаСтатуса" Тогда
		Возврат "late";
	ИначеЕсли ВидУведомления = "СменаСтатуса" Тогда
		Возврат "move";
	ИначеЕсли ВидУведомления = "Возврат" Тогда
		// Возврат карточки в чат - для менеджера это снова "новый заказ,
		// нужно позвонить", поэтому и в журнале сайта он ложится тем же типом.
		Возврат "new";
	КонецЕсли;

	Возврат "";

КонецФункции

// Приёмник на сайте и его секрет. Секрет тот же, что у уведомлений о резерве
// (БИАС.УведомитьСайтОРезерве) - граница доверия одна и та же.
// Хост и путь держим порознь: HTTPСоединению нужен хост, WinHttp - полный URL,
// а разбирать URL нечем (СтруктураURI в этой конфигурации нет).
Функция ХостСайта()

	Возврат "cvetkovtm.com";

КонецФункции

Функция ПутьПриемникаСайта()

	Возврат "/assets/shop/cron_manager_notify.php";

КонецФункции

// Ссылка на карточку товара на сайте.
//
// Прямой адрес карточки 1С не знает: slug (modx_a_products.product_url) сайт
// строит сам из названия и цвета, обратно он не приезжает. Зато сайт хранит
// НАШ ключ - modx_a_products.product_goodid, это тот самый id, под которым товар
// уходит в выгрузке (ХарактеристикиНоменклатуры.ИдДляВыгрузки: код номенклатуры
// плюс код характеристики, у обоих убраны ведущие нули).
//
// Поэтому ссылка ведёт на маленький редиректор shop/go_product.php, который
// по этому ключу находит товар и перебрасывает на его карточку. Строить slug
// в 1С было бы гаданием: он меняется вместе с названием, и рассинхрон никак
// не проявится - менеджер просто получит 404.
//
// Параметры:
//  КодНоменклатуры   - Строка - код номенклатуры.
//  КодХарактеристики - Строка - код характеристики (цвет и размер).
//
// Возвращаемое значение:
//  Строка - адрес карточки; пусто, если ключ не собрать (нет характеристики -
//           значит и оффера на сайте нет).
//
Функция СсылкаНаТовар(Знач КодНоменклатуры, Знач КодХарактеристики)

	КодТовара = ОбщегоНазначения.УбратьНоликиСлева(СокрЛП(Строка(КодНоменклатуры)));
	КодЦвета  = ОбщегоНазначения.УбратьНоликиСлева(СокрЛП(Строка(КодХарактеристики)));

	Если ПустаяСтрока(КодТовара) Или ПустаяСтрока(КодЦвета) Тогда
		Возврат "";
	КонецЕсли;

	// Путь тот же, что у приёмника уведомлений: в репозитории сайта папка shop,
	// на проде она лежит как assets/shop.
	Возврат "https://" + ХостСайта() + "/assets/shop/go_product.php?good="
		+ КодТовара + КодЦвета;

КонецФункции

// Общий секрет обмена с сайтом. Экспортная и единственная на всю конфигурацию:
// им же проверяется команда, пришедшая С сайта (HTTPСервис.ТелеграмВебхук,
// шаблон /cmd), и подписываются наши запросы НА сайт (ЖурналНаСайт). Держать
// три копии одной строки - гарантия, что при смене поменяют две из трёх.
Функция ТокенСайта() Экспорт

	Возврат "e4cfdff6ad370ca2f0e26d8eb82bcda9";

КонецФункции

// POST на сайт: сначала штатным HTTPСоединением, при отказе - через WinHttp,
// ровно как в ВыполнитьЗапрос (какой способ доступен на сервере - выяснится
// только на живой базе).
Процедура ЗапросКСайту(Знач ТелоЗапроса, Знач Заказ)

	Адрес = "https://" + ХостСайта() + ПутьПриемникаСайта();

	Попытка

		Соединение = Новый HTTPСоединение(ХостСайта(), 443, , , , 30,
			Новый ЗащищенноеСоединениеOpenSSL);

		Запрос = Новый HTTPЗапрос(ПутьПриемникаСайта());
		Запрос.Заголовки.Вставить("Content-Type",
			"application/x-www-form-urlencoded; charset=UTF-8");
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8",
			ИспользованиеByteOrderMark.НеИспользовать);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);

		Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
			ЗаписатьОшибку(Заказ, "Сайт ответил HTTP " + Строка(Ответ.КодСостояния)
				+ ": " + Лев(Ответ.ПолучитьТелоКакСтроку("UTF-8"), 500));
		КонецЕсли;

		Возврат;

	Исключение

		ОшибкаHTTPСоединения = ОписаниеОшибки();

	КонецПопытки;

	Попытка

		HTTP = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");
		HTTP.Open("POST", Адрес, Ложь);
		HTTP.SetRequestHeader("Content-Type",
			"application/x-www-form-urlencoded; charset=UTF-8");
		HTTP.SetTimeouts(15000, 15000, 30000, 30000);
		HTTP.Send(ТелоЗапроса);

		КодСостояния = Число(HTTP.Status);

		Если КодСостояния < 200 Или КодСостояния >= 300 Тогда
			ЗаписатьОшибку(Заказ, "Сайт ответил HTTP " + Строка(КодСостояния)
				+ ": " + Лев(Строка(HTTP.ResponseText), 500));
		КонецЕсли;

	Исключение

		ЗаписатьОшибку(Заказ, "Сайт недоступен."
			+ Символы.ПС + "HTTPСоединение: " + ОшибкаHTTPСоединения
			+ Символы.ПС + "WinHttp: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Разбирает одно нажатие кнопки: отметка в истории, отметка в задаче,
// ответ Telegram и новая подпись кнопки под сообщением.
Процедура ОбработатьНажатие(Знач Токен, Знач Нажатие)

	ИДНажатия = СтрокаJSON(Нажатие, "id");
	Данные    = СтрокаJSON(Нажатие, "data");

	ЧатИД          = "";
	НомерСообщения = 0;

	Сообщение = Неопределено;
	Если Нажатие.Свойство("message", Сообщение) И ТипЗнч(Сообщение) = Тип("Структура") Тогда

		НомерСообщения = ЧислоJSON(Сообщение, "message_id");

		Чат = Неопределено;
		Если Сообщение.Свойство("chat", Чат) И ТипЗнч(Чат) = Тип("Структура") Тогда
			ЧатИД = СтрокаJSON(Чат, "id");
		КонецЕсли;

	КонецЕсли;

	// След нажатия в журнале - первое, на что смотреть, когда кнопка "не работает".
	// Нет этой записи после нажатия - значит до 1С оно вообще не доехало: не крутится
	// регламент ТелеграмОбмен, у бота стоит вебхук (тогда getUpdates отвечает 409
	// Conflict) или обновления вычитал кто-то другой. Есть запись, но кнопка не
	// обновилась - смотреть следом "Телеграм.Ошибка" с отказом editMessageText.
	ЗаписьЖурналаРегистрации("Телеграм.Кнопка",
		УровеньЖурналаРегистрации.Информация, , ,
		"Нажатие: " + Данные
		+ Символы.ПС + "Чат: " + СокрЛП(Строка(ЧатИД))
		+ ", сообщение: " + Формат(НомерСообщения, "ЧН=0; ЧГ=0")
		+ Символы.ПС + "Кто: " + КтоНажал(Нажатие));

	Префикс = Лев(Данные, 3);

	// Кнопка уже отмеченного сообщения ("done"). Карточка живёт в чате, пока
	// заказ в работе: даже нажатую по делу уборку регламент восстановил бы
	// (СинхронизироватьКарточки), поэтому по активному заказу отвечаем отказом,
	// а не убираем и возвращаем. Вышедший из работы заказ убрать можно -
	// это то же самое, что через минуту сделает регламент. id заказа в этой
	// кнопке нет, находим его по паре чат + номер сообщения в истории отправок.
	// "Убрать" под текстом оплаты: сообщение с текстом нужно ровно на одно
	// копирование, дальше оно только мешает читать чат. Заказ по этой кнопке
	// не ищем - удаляем именно то сообщение, под которым нажали.
	Если Данные = "del" Тогда

		Параметры = Новый Структура;
		Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
		Параметры.Вставить("message_id", НомерСообщения);
		ВыполнитьЗапрос(Токен, "deleteMessage", ВJSON(Параметры), Неопределено);

		ОтветитьНаНажатие(Токен, ИДНажатия, "Убрано из чата");
		Возврат;

	КонецЕсли;

	Если Данные = "done" Тогда

		ПоказатьНабор(Токен, ЧатИД);

		ЗаказКарточки = ЗаказПоСообщению(ЧатИД, НомерСообщения);

		Если ЗначениеЗаполнено(ЗаказКарточки) Тогда

			Если СтатусВРаботе(ЗаказКарточки.СтатусЗаказа) Тогда

				ОтветитьНаНажатие(Токен, ИДНажатия,
					"Заказ ещё в работе - карточка останется в чате, пока он"
					+ " не выйдет из активных статусов.", Истина);

			Иначе

				УбратьКарточкиЗаказа(Токен, ЗаказКарточки);
				ОтветитьНаНажатие(Токен, ИДНажатия, "Убрано из чата");

			КонецЕсли;

		Иначе

			// Сообщения нет в истории (ушло до появления регистра) - убираем
			// хотя бы его само, по чату и номеру.
			Параметры = Новый Структура;
			Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
			Параметры.Вставить("message_id", НомерСообщения);
			ВыполнитьЗапрос(Токен, "deleteMessage", ВJSON(Параметры), Неопределено);

			ОтветитьНаНажатие(Токен, ИДНажатия, "Убрано из чата");

		КонецЕсли;

		Возврат;

	КонецЕсли;

	// Прочие незнакомые кнопки - просто закрываем "часики" у менеджера.
	// Список проверяем строкой, а не цепочкой сравнений: префиксов стало четырнадцать.
	Если СтрНайти("|ok:|st:|ts:|t0:|t1:|t3:|tx:|tb:|na:|ny:|nt:|op:|tp:|ty:|", "|" + Префикс + "|") = 0 Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия, "Уже отмечено");
		Возврат;
	КонецЕсли;

	// "Печатает..." в шапке чата сразу после нажатия: дальше идёт чтение заказа
	// и правка сообщения, и до ответа проходит заметная пауза - без этого
	// менеджер не понимает, нажалось ли вообще.
	ПоказатьНабор(Токен, ЧатИД);

	Заказ = ЗаказПоДаннымКнопки(Данные);

	Если Не ЗначениеЗаполнено(Заказ) Тогда

		ЗаписатьОшибку(Неопределено, "Нажата кнопка по заказу, которого нет в 1С."
			+ Символы.ПС + "Данные кнопки: " + Данные);

		ОтветитьНаНажатие(Токен, ИДНажатия, "Заказ не найден в 1С");
		Возврат;

	КонецЕсли;

	// "Статус" ничего не меняет в 1С: перечитывает заказ, переписывает ЭТО ЖЕ
	// сообщение свежими данными и показывает короткую сводку всплывашкой.
	// Новых сообщений в чат не шлём принципиально - иначе чат превратится
	// в ленту дублей одного заказа.
	Если Префикс = "st:" Тогда
		ПоказатьСтатус(Токен, ИДНажатия, ЧатИД, НомерСообщения, Заказ);
		Возврат;
	КонецЕсли;

	// "Задача" - показать текст окном и открыть меню правки под сообщением.
	// Сама задача в этот момент не меняется и не создаётся: создание -
	// побочный эффект первого же действия в меню.
	Если Префикс = "ts:" Тогда
		ПоказатьЗадачу(Токен, ИДНажатия, Заказ);
		ПереключитьКлавиатуру(Токен, ЧатИД, НомерСообщения, КлавиатураЗадачи(Заказ));
		Возврат;
	КонецЕсли;

	// "Назад" - вернуть обычную клавиатуру заказа, с сохранением отметки
	// обработки: иначе выход из меню терял бы "✅ Обработан <дата>".
	Если Префикс = "tb:" Тогда
		Состояние = СостояниеОбработки(ЧатИД, НомерСообщения, Заказ);
		ПереключитьКлавиатуру(Токен, ЧатИД, НомерСообщения,
			КлавиатураЗаказа(Заказ, Состояние.Обработан,
				ОтметкаНаКнопке(Состояние.Дата, Состояние.Кто)));
		ОтветитьНаНажатие(Токен, ИДНажатия, "");
		Возврат;
	КонецЕсли;

	// "Текст оплаты" - без подтверждения: текст приходит СЮДА ЖЕ, в чат
	// менеджера, клиенту бот ничего не шлёт, так что случайное нажатие
	// безобидно. ty: - "Да" снятого подтверждения: обрабатываем так же,
	// чтобы зависшие старые клавиатуры-вопросы не остались без ответа.
	Если Префикс = "tp:" Или Префикс = "ty:" Тогда
		ОтправитьТекстОплаты(Токен, ИДНажатия, ЧатИД, НомерСообщения, Заказ);
		Возврат;
	КонецЕсли;

	// Быстрые заметки - итог звонка одним нажатием: дата, кто и штамп уходят
	// в задачу, содержание задачи появляется в тексте карточки.
	Если Префикс = "nt:" Или Префикс = "op:" Тогда

		// "Обещала оплатить" - это ещё и движение по заказу: задача-напоминание
		// "Продано" закрывается (звонок состоялся, ждём деньги, а не звонок),
		// а заказ переводится в статус с кодом 000000005. Порядок важен:
		// сначала закрыть старую задачу - тогда заметка ниже заведёт свежую,
		// и исполнитель ей выберется уже по новому статусу.
		//
		// На сколько отложить, решает статус ДО нажатия (решение пользователя
		// 10.08.2026):
		//  - был не "Ожидает оплаты" (обычно "Продано") - обещание свежее,
		//    напоминаем завтра;
		//  - уже был "Ожидает оплаты" - обещают повторно, дёргать клиента
		//    каждый день незачем, следующий заход через 2 дня.
		ПеренестиНаДней = 1;

		Если Префикс = "op:" Тогда

			Если ЗначениеЗаполнено(Заказ.СтатусЗаказа)
				И СокрЛП(Заказ.СтатусЗаказа.Код) = "000000005" Тогда
				ПеренестиНаДней = 2;
			КонецЕсли;

			ЗакрытьЗадачуПродано(Заказ);
			ПеревестиВОжиданиеОплаты(Заказ);

		КонецЕсли;

		// Обе кнопки переносят напоминание вперёд (9:00) и убирают карточку
		// из чатов до того дня: разговор состоялся, сегодня по заказу больше
		// делать нечего. Регламент вернёт карточку утром в срок.
		ДобавитьЗаметкуВЗадачу(Токен, ИДНажатия, ЧатИД, НомерСообщения, Заказ,
			КтоНажал(Нажатие),
			?(Префикс = "nt:", "не берёт трубку", "обещала оплатить"),
			ПеренестиНаДней);
		Возврат;
	КонецЕсли;

	// "Не актуален" - сначала вопрос: подменяем клавиатуру подтверждением,
	// в 1С пока ничего не меняется. Случайное нажатие безопасно - "Отмена"
	// возвращает обычные кнопки.
	Если Префикс = "na:" Тогда
		ПереключитьКлавиатуру(Токен, ЧатИД, НомерСообщения,
			КлавиатураПодтвержденияНеАктуален(Заказ));
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Заказ № " + СокрЛП(Заказ.Номер) + " будет переведён в ""Не удачные""."
			+ " Подтвердите кнопкой под сообщением.", Истина);
		Возврат;
	КонецЕсли;

	// "Да" из подтверждения: заказ переводится в "Не удачные".
	Если Префикс = "ny:" Тогда
		ПеревестиВНеудачные(Токен, ИДНажатия, ЧатИД, НомерСообщения, Заказ,
			КтоНажал(Нажатие));
		Возврат;
	КонецЕсли;

	// Срок: сегодня / завтра / +3 дня. Задачи может ещё не быть - тогда
	// она здесь и заводится.
	Если Префикс = "t0:" Или Префикс = "t1:" Или Префикс = "t3:" Тогда
		УстановитьСрокЗадачи(Токен, ИДНажатия, ЧатИД, НомерСообщения, Заказ,
			?(Префикс = "t0:", 0, ?(Префикс = "t1:", 1, 3)));
		Возврат;
	КонецЕсли;

	// Текст задачи вводится ответом на сообщение заказа: полей ввода
	// у inline-кнопок нет, а отдельное сообщение-приглашение засоряло бы чат.
	Если Префикс = "tx:" Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Ответьте на это сообщение обычным текстом - он допишется в задачу."
			+ " Если задачи ещё нет, она создастся.", Истина);
		Возврат;
	КонецЕсли;

	Кто           = КтоНажал(Нажатие);
	ДатаОбработки = ТекущаяДата();

	Задача = ОтметитьВИстории(ЧатИД, НомерСообщения, Заказ, ДатаОбработки, Кто);

	ОтметитьВЗадаче(Задача, Заказ, ДатаОбработки, Кто);

	ЗеркалитьОбработкуНаСайт(Заказ, Кто);

	ОтветитьНаНажатие(Токен, ИДНажатия,
		"Отмечено: " + Формат(ДатаОбработки, "ДФ='dd.MM.yyyy HH:mm'"));

	// Сообщение из чата НЕ удаляем: карточка живёт, пока заказ в работе,
	// а уборкой занимается СинхронизироватьКарточки, когда заказ выйдет
	// из активных статусов. Вместо удаления отмечаем карточки заказа во ВСЕХ
	// чатах галкой с датой и именем - второй менеджер видит, что звонить
	// уже не нужно, но заказ по-прежнему перед глазами.
	ОтметитьКарточкиЗаказа(Токен, Заказ, ДатаОбработки, Кто);

КонецПроцедуры

// "Текст оплаты": присылает готовый текст для клиента СЮДА ЖЕ - в чат
// менеджера, ответом на карточку. С телефона его пересылают клиенту в личный
// Telegram или Viber. Клиенту напрямую бот НЕ пишет (решение пользователя,
// 10.08.2026: текст нужен менеджеру в личке, а не клиентскому боту сайта).
//
// Отдельным сообщением и без разметки: текст уйдёт клиенту как есть,
// HTML-спецсимволы в нём - обычные символы, а не теги.
Процедура ОтправитьТекстОплаты(Знач Токен, Знач ИДНажатия, Знач ЧатИД,
	Знач НомерСообщения, Знач Заказ)

	Попытка
		Результат = ОплатаПоСсылке.ТекстЗаказаДляКлиента(Заказ);
	Исключение
		ЗаписатьОшибку(Заказ, "Текст оплаты не собран: " + ОписаниеОшибки());
		Результат = Новый Структура("Успех, Сообщение", Ложь,
			"ошибка в 1С, смотрите журнал ""Телеграм.Ошибка""");
	КонецПопытки;

	Если Не Результат.Успех Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			Лев("Текст не собран: " + Результат.Сообщение, 190), Истина);
		Возврат;
	КонецЕсли;

	// Текст уходит блоком <pre>: Telegram рисует у такого блока кнопку копирования,
	// одно нажатие - и весь текст в буфере телефона, пересылать сообщение
	// целиком (со своими подписями и цитатой карточки) больше не нужно.
	// Скопировать в буфер как-то иначе бот не может: доступа к устройству
	// у Bot API нет, а готовая кнопка copy_text держит только 256 символов -
	// текст заказа в неё не влезает.
	//
	// Внутри <pre> обязательно экранирование: в тексте бывают "&" в ссылках
	// оплаты, и без него Telegram отвечает "can't parse entities".
	ТекстБлоком = "<pre>" + HTML(Лев(Результат.Текст, 4000)) + "</pre>";

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	// Кнопка "Убрать": скопировали текст - одно нажатие, и сообщение уходит
	// из чата, карточка заказа остаётся. Заказ в callback_data не нужен,
	// удаляется само сообщение (обработка "del" в ОбработатьНажатие).
	КнопкаУбрать = Новый Структура;
	КнопкаУбрать.Вставить("text", "🗑 Убрать");
	КнопкаУбрать.Вставить("callback_data", "del");

	СтрокаКнопок = Новый Массив;
	СтрокаКнопок.Добавить(КнопкаУбрать);

	Кнопки = Новый Массив;
	Кнопки.Добавить(СтрокаКнопок);

	Разметка = Новый Структура;
	Разметка.Вставить("inline_keyboard", Кнопки);

	Параметры.Вставить("text", ТекстБлоком);
	Параметры.Вставить("parse_mode", "HTML");
	Параметры.Вставить("disable_web_page_preview", Истина);
	Параметры.Вставить("reply_markup", Разметка);

	Если НомерСообщения > 0 Тогда
		Параметры.Вставить("reply_to_message_id", НомерСообщения);
	КонецЕсли;

	Ответ = ВыполнитьЗапрос(Токен, "sendMessage", ВJSON(Параметры), Заказ);

	Если Ответ <> Неопределено И БулевоJSON(Ответ, "ok") Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Текст оплаты в чате - нажмите на блок, он скопируется целиком."
			+ " Потом ""Убрать"" - и сообщение исчезнет.");
	Иначе
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Telegram не принял сообщение - смотрите журнал ""Телеграм.Ошибка"".",
			Истина);
	КонецЕсли;

КонецПроцедуры

// "Обещала оплатить": переводит заказ в статус "Ожидает оплаты" независимо
// от того, в каком статусе он был (решение пользователя 10.08.2026; раньше
// переводились только заказы из "Продано", на остальных кнопка молча ничего
// не делала со статусом).
//
// Статус ищем ПО КОДУ 000000005, а не по наименованию: наименование меняют
// в справочнике, код - нет. Предопределённых элементов в СтатусыЗаказов нет.
//
// Записываем без перепроведения (как ОбновитьСтатусыЗаказов): статус -
// реквизит шапки, движения от него не зависят.
Процедура ПеревестиВОжиданиеОплаты(Знач Заказ)

	КодСтатуса = "000000005";

	Попытка

		Статус = Справочники.СтатусыЗаказов.НайтиПоКоду(КодСтатуса);

		Если Не ЗначениеЗаполнено(Статус) Тогда
			ЗаписатьОшибку(Заказ, "Статус с кодом " + КодСтатуса + " в справочнике"
				+ " не найден - статус заказа не изменён.");
			Возврат;
		КонецЕсли;

		// Заказ уже в нужном статусе - лишняя запись документа ни к чему.
		Если Заказ.СтатусЗаказа = Статус Тогда
			Возврат;
		КонецЕсли;

		СтатусБыл = Строка(Заказ.СтатусЗаказа);

		Объект = Заказ.ПолучитьОбъект();
		Объект.СтатусЗаказа = Статус;
		Объект.Записать();

		ЗаписьЖурналаРегистрации("Телеграм.Кнопка",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.ЗаказПокупателя, Заказ,
			"Заказ переведён из """ + СтатусБыл + """ в """ + Строка(Статус)
			+ """ (код " + КодСтатуса + ") кнопкой ""Обещала оплатить"".");

	Исключение

		ЗаписатьОшибку(Заказ, "Заказ не переведён в статус с кодом " + КодСтатуса
			+ ": " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Закрывает открытую задачу-напоминание "Продано" по заказу: клиент обещал
// оплатить, напоминание о зависшем "Продано" отработало. Задачи с другим
// заголовком (свой текст менеджера) не трогаем.
Процедура ЗакрытьЗадачуПродано(Знач Заказ)

	Задача = ЗадачаПоЗаказу(Заказ);

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат;
	КонецЕсли;

	Если Лев(НРег(СокрЛП(Строка(Задача.Наименование))), 6) <> "продан" Тогда
		Возврат;
	КонецЕсли;

	Попытка

		Объект = Задача.ПолучитьОбъект();
		Объект.Выполнена = Истина;
		Объект.Записать();

		ЗаписьЖурналаРегистрации("Телеграм.Кнопка",
			УровеньЖурналаРегистрации.Информация,
			Метаданные.Документы.ЗаказПокупателя, Заказ,
			"Задача ""Продано"" закрыта кнопкой ""Обещала оплатить"".");

	Исключение

		ЗаписатьОшибку(Заказ, "Задача ""Продано"" не закрыта: " + ОписаниеОшибки());

	КонецПопытки;

КонецПроцедуры

// Быстрая заметка из кнопки ("не берёт трубку" / "обещала оплатить"):
// дописывает в задачу строку "дд.ММ чч:мм кто: штамп" - ровно тем же форматом,
// что и ответ текстом (ОбработатьОтветТекстом). Задачи нет - создаётся
// с тем же выбором исполнителя, что и везде (ЗадачаДляЗаказа).
//
// ПеренестиНаДней > 0 - заодно перенос напоминания: срок задачи сдвигается
// на столько дней вперёд (9:00), и карточка убирается из чатов до этого дня -
// регламент вернёт её утром в срок. Без переноса карточка остаётся и просто
// перерисовывается: содержание задачи показывается в самом сообщении.
Процедура ДобавитьЗаметкуВЗадачу(Знач Токен, Знач ИДНажатия, Знач ЧатИД,
	Знач НомерСообщения, Знач Заказ, Знач Кто, Знач ТекстЗаметки,
	Знач ПеренестиНаДней = 0)

	Задача = ЗадачаДляЗаказа(Заказ);

	Если Задача = Неопределено Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Задачи нет, и создавать её не на кого: у статуса заказа не задан"
			+ " пользователь, ответственный в заказе тоже пуст.", Истина);
		Возврат;
	КонецЕсли;

	Новая = Задача.Ссылка.Пустая();

	Заметка = Формат(ТекущаяДата(), "ДФ='dd.MM HH:mm'")
		+ " " + Кто + ": " + ТекстЗаметки;

	// У новой задачи Описание - наша же заглушка "Задача из Telegram",
	// её заменяем, а не копим.
	Если Новая Тогда
		Задача.Описание = Заметка;
	Иначе
		Задача.Описание = ?(ПустаяСтрока(СокрЛП(Строка(Задача.Описание))), "",
			Строка(Задача.Описание) + Символы.ПС) + Заметка;
	КонецЕсли;

	Если ПеренестиНаДней > 0 Тогда

		Срок = НачалоДня(ТекущаяДата() + ПеренестиНаДней * 86400) + 32400;

		Задача.СрокИсполнения = Срок;
		Если Задача.Оповещение Тогда
			Задача.СрокОповещения = Срок;
		КонецЕсли;

	КонецЕсли;

	Если Не ЗаписатьЗадачуТихо(Задача, Заказ) Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Не удалось записать задачу - смотрите журнал регистрации,"
			+ " событие Телеграм.Задача.", Истина);
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Телеграм.Задача",
		УровеньЖурналаРегистрации.Информация, , Заказ,
		?(Новая, "Задача создана кнопкой: ", "Дописано в задачу кнопкой: ") + Заметка
		+ ?(ПеренестиНаДней > 0,
			Символы.ПС + "Напоминание перенесено на "
			+ Формат(НачалоДня(ТекущаяДата() + ПеренестиНаДней * 86400) + 32400,
				"ДФ='dd.MM.yyyy HH:mm'"), ""));

	Если ПеренестиНаДней > 0 Тогда

		// Карточке в чате до дня напоминания делать нечего - как и при
		// переносе срока кнопками "Завтра"/"+3 дня". Дату называем прямо:
		// перенос бывает и на завтра, и на 2 дня вперёд (см. ОбработатьНажатие).
		ОтветитьНаНажатие(Токен, ИДНажатия,
			?(Новая, "Задача создана: ", "Записано: ") + ТекстЗаметки
			+ ". Напоминание " + Формат(Срок, "ДФ='dd.MM'")
			+ ", карточка убрана до этого дня.");

		УбратьКарточкиЗаказа(Токен, Заказ);

		Возврат;

	КонецЕсли;

	ОтветитьНаНажатие(Токен, ИДНажатия,
		?(Новая, "Задача создана: ", "Записано в задачу: ") + ТекстЗаметки);

	ПерерисоватьКарточку(Токен, ЧатИД, НомерСообщения, Заказ);

КонецПроцедуры

// Перерисовывает ЭТО сообщение свежим текстом заказа (в него входит и
// содержание задачи) с обычной клавиатурой и отметкой обработки. Новых
// сообщений не шлёт и ничего не удаляет.
//
// Время с секундами в подписи - чтобы текст всегда отличался от прежнего:
// на одинаковый текст Telegram отвечает ошибкой "message is not modified".
Процедура ПерерисоватьКарточку(Знач Токен, Знач ЧатИД, Знач НомерСообщения, Знач Заказ)

	Состояние = СостояниеОбработки(ЧатИД, НомерСообщения, Заказ);

	Текст = ТекстПоЗаказу(Заказ, Заказ.СтатусЗаказа, ЗаголовокПоВиду(Состояние.Вид, Заказ))
		+ Символы.ПС + Символы.ПС
		+ "<i>Обновлено " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + "</i>";

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("message_id", НомерСообщения);
	Параметры.Вставить("text", ?(СтрДлина(Текст) > 4000, Лев(Текст, 3990) + "...", Текст));
	Параметры.Вставить("parse_mode", "HTML");
	Параметры.Вставить("disable_web_page_preview", Истина);

	Параметры.Вставить("reply_markup",
		КлавиатураЗаказа(Заказ, Состояние.Обработан,
			ОтметкаНаКнопке(Состояние.Дата, Состояние.Кто)));

	ВыполнитьЗапрос(Токен, "editMessageText", ВJSON(Параметры), Заказ);

	// В регистре держим то, что сейчас написано в чате: по этой строке
	// ОбновитьОплаченныеКарточки понимает, менялся ли текст.
	ОбновитьТекстВИстории(Заказ, СокрЛП(Строка(ЧатИД)), НомерСообщения, Текст);

КонецПроцедуры

// Перерисовывает ВСЕ живые карточки заказа - во всех чатах, куда он уходил.
//
// Нужно для смены статуса, о которой слать некому: у статуса не заполнены
// "Телеграм: чаты при смене статуса", заказ остался в работе, новой карточки
// взамен не будет. Раньше в этом месте не делалось ничего, и в чате висел
// старый статус, пока кто-нибудь не нажмёт кнопку "Статус" - то есть карточка
// молча врала. Теперь её просто переписывают свежим текстом.
Процедура ПерерисоватьКарточкиЗаказа(Знач Токен, Знач Заказ)

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ТелеграмУведомления.Чат            КАК Чат,
			|	ТелеграмУведомления.НомерСообщения КАК НомерСообщения
			|ИЗ
			|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
			|ГДЕ
			|	ТелеграмУведомления.Заказ = &Заказ
			|	И НЕ ТелеграмУведомления.Убрано
			|	И ТелеграмУведомления.НомерСообщения <> 0";
		Запрос.УстановитьПараметр("Заказ", Заказ);

		Выборка = Запрос.Выполнить().Выбрать();

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось получить карточки заказа для обновления: "
			+ ОписаниеОшибки());
		Возврат;

	КонецПопытки;

	Пока Выборка.Следующий() Цикл

		ЧатСтрокой = СокрЛП(Строка(Выборка.Чат));

		Если ПустаяСтрока(ЧатСтрокой) Тогда
			Продолжить;
		КонецЕсли;

		// Одна упавшая карточка не должна останавливать остальные чаты.
		Попытка
			ПерерисоватьКарточку(Токен, ЧатСтрокой, Выборка.НомерСообщения, Заказ);
		Исключение
			ЗаписатьОшибку(Заказ, "Карточка в чате " + ЧатСтрокой
				+ " не обновлена после смены статуса: " + ОписаниеОшибки());
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// "Да" из подтверждения "Не актуален": переводит заказ в статус "Не удачные"
// и убирает его карточки из всех чатов - статус закрывающий (СтатусВРаботе
// его не знает), работы по заказу больше нет, и регламент карточку не вернёт.
//
// Статус ищем по точному наименованию "Не удачные" - ровно так его ищет
// и МодульРегламентныхЗаданий.ОбновитьСтатусыЗаказов: статусы - данные
// справочника СтатусыЗаказов, предопределённых элементов у него нет.
//
// Записываем без перепроведения (как ОбновитьСтатусыЗаказов): статус -
// реквизит шапки, движения от него не зависят.
Процедура ПеревестиВНеудачные(Знач Токен, Знач ИДНажатия, Знач ЧатИД,
	Знач НомерСообщения, Знач Заказ, Знач Кто)

	Статус = Справочники.СтатусыЗаказов.НайтиПоНаименованию("Не удачные");

	Если Не ЗначениеЗаполнено(Статус) Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"В справочнике статусов не найден ""Не удачные"" - статус не изменён.",
			Истина);
		Возврат;
	КонецЕсли;

	Если Заказ.СтатусЗаказа = Статус Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Заказ уже в ""Не удачные"" - убираю карточку из чатов.");
		УбратьКарточкиЗаказа(Токен, Заказ);
		Возврат;
	КонецЕсли;

	Попытка

		Объект = Заказ.ПолучитьОбъект();
		Объект.СтатусЗаказа = Статус;
		Объект.Записать();

	Исключение

		ЗаписатьОшибку(Заказ,
			"Не удалось перевести заказ в ""Не удачные"": " + ОписаниеОшибки());

		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Статус не изменён - ошибка записи, смотрите журнал,"
			+ " событие ""Телеграм.Ошибка"".", Истина);

		// Вопрос под сообщением снимаем, иначе клавиатура зависнет
		// в подтверждении, которое уже не сработало.
		Состояние = СостояниеОбработки(ЧатИД, НомерСообщения, Заказ);
		ПереключитьКлавиатуру(Токен, ЧатИД, НомерСообщения,
			КлавиатураЗаказа(Заказ, Состояние.Обработан,
				ОтметкаНаКнопке(Состояние.Дата, Состояние.Кто)));

		Возврат;

	КонецПопытки;

	ЗаписьЖурналаРегистрации("Телеграм.Кнопка",
		УровеньЖурналаРегистрации.Информация,
		Метаданные.Документы.ЗаказПокупателя, Заказ,
		"Заказ переведён в ""Не удачные"" кнопкой из Telegram."
		+ Символы.ПС + "Кто: " + Кто);

	// Отвечаем до уборки: всплывашка привязана к нажатию, а не к сообщению,
	// и покажется уже поверх чата без карточки.
	ОтветитьНаНажатие(Токен, ИДНажатия,
		"Заказ № " + СокрЛП(Заказ.Номер)
		+ " переведён в ""Не удачные"", карточка убрана из чатов.", Истина);

	УбратьКарточкиЗаказа(Токен, Заказ);

КонецПроцедуры

// Ставит на карточках заказа во всех чатах отметку "✅ Обработан <дата> - кто":
// правит клавиатуру каждого живого сообщения и пишет отметку в его запись
// регистра. Само сообщение при этом остаётся в чате - см. ОбработатьНажатие.
Процедура ОтметитьКарточкиЗаказа(Знач Токен, Знач Заказ, Знач ДатаОбработки, Знач Кто)

	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ТелеграмУведомления.Чат            КАК Чат,
			|	ТелеграмУведомления.НомерСообщения КАК НомерСообщения,
			|	ТелеграмУведомления.Обработан      КАК Обработан
			|ИЗ
			|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
			|ГДЕ
			|	ТелеграмУведомления.Заказ = &Заказ
			|	И НЕ ТелеграмУведомления.Убрано
			|	И ТелеграмУведомления.НомерСообщения <> 0";
		Запрос.УстановитьПараметр("Заказ", Заказ);

		Выборка = Запрос.Выполнить().Выбрать();

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось получить карточки заказа для отметки: "
			+ ОписаниеОшибки());
		Возврат;

	КонецПопытки;

	Пока Выборка.Следующий() Цикл

		ЧатСтрокой = СокрЛП(Строка(Выборка.Чат));

		Если ПустаяСтрока(ЧатСтрокой) Тогда
			Продолжить;
		КонецЕсли;

		// Запись нажатого сообщения уже отмечена (ОтметитьВИстории) - её не
		// перезаписываем, остальным ставим ту же дату и того же человека.
		Если Не Выборка.Обработан Тогда
			ОтметитьВИстории(ЧатСтрокой, Выборка.НомерСообщения, Заказ,
				ДатаОбработки, Кто);
		КонецЕсли;

		ОтметитьСообщение(Токен, ЧатСтрокой, Выборка.НомерСообщения, Заказ,
			ДатаОбработки, Кто);

	КонецЦикла;

КонецПроцедуры

// "Печатает..." в чате. Живёт около 5 секунд и гаснет само - ровно на время,
// пока 1С читает заказ и правит сообщение. Продлевать циклом не будем:
// это была бы минута занятого фонового задания ради анимации.
//
// Параметры:
//  Токен - Строка - токен бота.
//  ЧатИД - Строка - чат, в котором нажали кнопку.
//
Процедура ПоказатьНабор(Знач Токен, Знач ЧатИД)

	Если ПустаяСтрока(СокрЛП(Строка(ЧатИД))) Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("action", "typing");

	ВыполнитьЗапрос(Токен, "sendChatAction", ВJSON(Параметры), Неопределено);

КонецПроцедуры

// Кнопка "Статус": перечитывает заказ в 1С и переписывает ТО ЖЕ САМОЕ сообщение
// свежими данными, плюс показывает короткую сводку всплывашкой. В 1С ничего
// не меняет и в историю не пишет - это не уведомление, а просмотр.
//
// Единственное исключение - заказ, вышедший из работы: такую карточку не
// обновляем, а убираем из чата (см. СтатусВРаботе).
//
// Новых сообщений не отправляем сознательно: иначе чат по одному заказу
// превращается в ленту почти одинаковых дублей.
Процедура ПоказатьСтатус(Знач Токен, Знач ИДНажатия, Знач ЧатИД,
	Знач НомерСообщения, Знач Заказ)

	Состояние = СостояниеОбработки(ЧатИД, НомерСообщения, Заказ);

	// Всплывашка, а НЕ окно: гаснет сама, нажимать "ОК" не нужно. Окно здесь было
	// лишним - те же данные тут же появляются в самом сообщении и на кнопке,
	// а модальное окно на каждое нажатие менеджера только тормозит.
	// Поэтому и сводка однострочная: у всплывашки одна строка и лимит 200 символов.
	Сводка = "№ " + СокрЛП(Заказ.Номер)
		+ " · " + СокрЛП(Строка(Заказ.СтатусЗаказа))
		+ " · " + Формат(Заказ.СуммаДокумента, "ЧДЦ=2; ЧН=0; ЧГ=0") + " грн";

	СтатусОтправки = СокрЛП(Строка(Заказ.СтатусОтправки));
	Если Не ПустаяСтрока(СтатусОтправки) Тогда
		Сводка = Сводка + " · " + СтатусОтправки;
	КонецЕсли;

	Если Состояние.Обработан Тогда
		Сводка = Сводка + " · ✅ "
			+ Формат(Состояние.Дата, "ДФ='dd.MM HH:mm'");
	КонецЕсли;

	// Заказ уже не в работе - обновлять карточку нечем и незачем, её надо
	// убрать. До этой проверки кнопка честно перерисовывала сообщение любым
	// статусом, и карточка "Завершенные" висела в чате до ручного "Обработан".
	//
	// Убираем ВСЕ карточки заказа, а не только эту: тот же заказ мог уйти
	// в несколько чатов, и во втором он так и остался бы "нужно позвонить".
	Если Не СтатусВРаботе(Заказ.СтатусЗаказа) Тогда

		// Сообщения нет в истории отправок (ушло до появления регистра) -
		// УбратьКарточкиЗаказа его не найдёт, убираем хотя бы то, на кнопку
		// которого нажали. Проверяем ДО уборки: она правит записи регистра.
		ЕстьВИстории = ЗначениеЗаполнено(ЗаказПоСообщению(ЧатИД, НомерСообщения));

		// Отвечаем до удаления: всплывашка привязана к нажатию, а не
		// к сообщению, и покажется уже поверх чата без карточки.
		ОтветитьНаНажатие(Токен, ИДНажатия, Лев("🗑 Убрано из чата · " + Сводка, 200));

		УбратьКарточкиЗаказа(Токен, Заказ);

		Если Не ЕстьВИстории Тогда

			Параметры = Новый Структура;
			Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
			Параметры.Вставить("message_id", НомерСообщения);

			ВыполнитьЗапрос(Токен, "deleteMessage", ВJSON(Параметры), Неопределено);

		КонецЕсли;

		// В журнале видно, какое именно наименование статуса сочли нерабочим:
		// список в СтатусВРаботе сверяется с данными справочника, а их
		// в выгрузке конфигурации нет.
		ЗаписьЖурналаРегистрации("Телеграм.Кнопка",
			УровеньЖурналаРегистрации.Информация, , Заказ,
			"Карточка убрана по кнопке ""Статус"": заказ вышел из работы."
			+ Символы.ПС + "Статус: " + СокрЛП(Строка(Заказ.СтатусЗаказа)));

		Возврат;

	КонецЕсли;

	ОтветитьНаНажатие(Токен, ИДНажатия, Лев(Сводка, 200));

	// Время с секундами - чтобы текст всегда отличался от прежнего: на
	// одинаковый текст Telegram отвечает ошибкой "message is not modified".
	Текст = ТекстПоЗаказу(Заказ, Заказ.СтатусЗаказа, ЗаголовокПоВиду(Состояние.Вид, Заказ))
		+ Символы.ПС + Символы.ПС
		+ "<i>Обновлено " + Формат(ТекущаяДата(), "ДФ='dd.MM.yyyy HH:mm:ss'") + "</i>";

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("message_id", НомерСообщения);
	Параметры.Вставить("text", ?(СтрДлина(Текст) > 4000, Лев(Текст, 3990) + "...", Текст));
	Параметры.Вставить("parse_mode", "HTML");
	Параметры.Вставить("disable_web_page_preview", Истина);

	Параметры.Вставить("reply_markup",
		КлавиатураЗаказа(Заказ, Состояние.Обработан,
			ОтметкаНаКнопке(Состояние.Дата, Состояние.Кто)));

	ВыполнитьЗапрос(Токен, "editMessageText", ВJSON(Параметры), Заказ);

КонецПроцедуры

// Заказ ещё в работе - карточке место в чате.
//
// В работе считаем четыре статуса: "Не продан", "Продано", "Ожидает оплаты",
// "Резерв" - по ним менеджеру есть что делать. Всё остальное ("Ожидает
// отправки", "ЦБ не получена", "Завершенные", "Отказ", "На возврате" и
// прочие) работу по заказу закрывает, и карточка в чате только мешает:
// второй менеджер видит её как "нужно позвонить".
//
// "Продано" сначала считалось закрывающим статусом, и кнопка "Статус" такую
// карточку убирала. Это оказалось неверно: заказ продан, но не собран и не
// отправлен - работа по нему продолжается, и карточка нужна в чате.
//
// Сверяем по НАЧАЛУ наименования и без учёта регистра. Причина: статусы -
// это данные справочника СтатусыЗаказов, а не метаданные; предопределённых
// элементов у него нет, ссылку в коде взять не на что, а наименование
// пользователь правит в базе ("Не продан" / "Не продано" / "Не проданные").
// По этой же причине список живёт здесь, а не в реквизите статуса: иначе
// его пришлось бы заводить структурной правкой и проставлять руками.
//
// Параметры:
//  Статус - СправочникСсылка.СтатусыЗаказов - статус заказа.
//
// Возвращаемое значение:
//  Булево - заказ в работе, карточку оставляем.
//
Функция СтатусВРаботе(Знач Статус)

	// Статус не заполнен - убирать карточку не за что: скорее всего заказ
	// только что приехал с сайта и своего статуса ещё не получил.
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Возврат Истина;
	КонецЕсли;

	Наименование = НРег(СокрЛП(Строка(Статус)));

	// Порядок важен только для чтения; сверяем по началу наименования, поэтому
	// "не прода" и "продан" не пересекаются: "Не продано" начинается с "не".
	РабочиеСтатусы = Новый Массив;
	РабочиеСтатусы.Добавить("не прода");
	РабочиеСтатусы.Добавить("продан");
	РабочиеСтатусы.Добавить("ожидает оплат");
	РабочиеСтатусы.Добавить("резерв");

	Для Каждого Начало Из РабочиеСтатусы Цикл

		Если Лев(Наименование, СтрДлина(Начало)) = Начало Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Кнопка "Задача": показывает окном текст задачи менеджера по этому заказу.
// В 1С ничего не меняет и само сообщение не трогает - только читает.
//
// Окном (show_alert), а не всплывашкой: это как раз тот случай, когда текст надо
// прочитать, а не заметить краем глаза. Из-за этого же и ограничение: у Telegram
// на текст ответа жёсткий лимит 200 символов, поэтому длинную задачу обрезаем.
// Если задачи начнут регулярно не влезать - текст придётся не показывать окном,
// а разворачивать в самом сообщении по кнопке-переключателю.
Процедура ПоказатьЗадачу(Знач Токен, Знач ИДНажатия, Знач Заказ)

	Задача = ЗадачаПоЗаказу(Заказ);

	Если Не ЗначениеЗаполнено(Задача) Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Открытой задачи по этому заказу нет."
			+ " Выберите срок кнопкой или ответьте на сообщение текстом -"
			+ " задача создастся.", Истина);
		Возврат;
	КонецЕсли;

	Текст = "";

	// Порядок - от самого нужного к справочному: если не влезет, обрежется хвост.
	Описание = СокрЛП(Строка(Задача.Описание));
	Если Не ПустаяСтрока(Описание) Тогда
		Текст = Описание;
	КонецЕсли;

	ДопИнформация = СокрЛП(Строка(Задача.ДопИнформация));
	Если Не ПустаяСтрока(ДопИнформация) Тогда
		Текст = ?(ПустаяСтрока(Текст), "", Текст + Символы.ПС) + ДопИнформация;
	КонецЕсли;

	СтатусПоФакту = СокрЛП(Строка(Задача.СтатусПоФакту));
	Если Не ПустаяСтрока(СтатусПоФакту) Тогда
		Текст = ?(ПустаяСтрока(Текст), "", Текст + Символы.ПС) + "По факту: " + СтатусПоФакту;
	КонецЕсли;

	Если ЗначениеЗаполнено(Задача.СрокИсполнения) Тогда
		Текст = ?(ПустаяСтрока(Текст), "", Текст + Символы.ПС)
			+ "Срок: " + Формат(Задача.СрокИсполнения, "ДФ='dd.MM.yyyy'");
	КонецЕсли;

	Если ПустаяСтрока(Текст) Тогда
		Текст = "Задача есть, но текста в ней нет - смотрите её в 1С.";
	КонецЕсли;

	// Лимит Telegram - 200 символов; обрезаем с многоточием, чтобы было видно,
	// что текст неполный, и менеджер пошёл в 1С за остатком.
	Если СтрДлина(Текст) > 200 Тогда
		Текст = Лев(Текст, 197) + "...";
	КонецЕсли;

	ОтветитьНаНажатие(Токен, ИДНажатия, Текст, Истина);

КонецПроцедуры

// Меняет только клавиатуру под уже отправленным сообщением, текст не трогает.
// Одна процедура на все переключения меню задачи: editMessageReplyMarkup
// сроком не ограничен, в отличие от ответа на само нажатие.
Процедура ПереключитьКлавиатуру(Знач Токен, Знач ЧатИД, Знач НомерСообщения, Знач Разметка)

	Если ПустаяСтрока(СокрЛП(Строка(ЧатИД))) Или НомерСообщения = 0 Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("message_id", НомерСообщения);
	Параметры.Вставить("reply_markup", Разметка);

	ВыполнитьЗапрос(Токен, "editMessageReplyMarkup", ВJSON(Параметры), Неопределено);

КонецПроцедуры

// Кнопки "Сегодня / Завтра / +3 дня": ставят срок исполнения задачи, а если
// открытой задачи по заказу нет - сначала её создают.
//
// Время ставим 9:00 целевого дня - так же, как это делает ночная
// БИАС.ПроверкаЗадачь, чтобы задачи из чата не выбивались из общего списка.
//
// Параметры:
//  Дней - Число - 0 сегодня, 1 завтра, 3 через три дня.
//
Процедура УстановитьСрокЗадачи(Знач Токен, Знач ИДНажатия, Знач ЧатИД,
	Знач НомерСообщения, Знач Заказ, Знач Дней)

	Задача = ЗадачаДляЗаказа(Заказ);

	Если Задача = Неопределено Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Задачи нет, и создавать её не на кого: у статуса заказа не задан"
			+ " пользователь, ответственный в заказе тоже пуст.", Истина);
		Возврат;
	КонецЕсли;

	// Ссылка у только что созданной задачи пустая до записи - по ней и отличаем
	// "создали" от "поправили", чтобы честно сказать это менеджеру.
	Новая = Задача.Ссылка.Пустая();

	Срок = НачалоДня(ТекущаяДата() + Дней * 86400) + 32400;

	Задача.СрокИсполнения = Срок;
	Если Задача.Оповещение Тогда
		Задача.СрокОповещения = Срок;
	КонецЕсли;

	Если Не ЗаписатьЗадачуТихо(Задача, Заказ) Тогда
		ОтветитьНаНажатие(Токен, ИДНажатия,
			"Не удалось записать задачу - смотрите журнал регистрации,"
			+ " событие Телеграм.Задача.", Истина);
		Возврат;
	КонецЕсли;

	// Срок перенесён на будущее - карточке в чате делать нечего до этого дня
	// (просьба пользователя, 10.08.2026: перенесённая задача не должна висеть).
	// Убираем карточки заказа из всех чатов; утром дня срока регламент
	// (СинхронизироватьКарточки) вернёт карточку сам - задача перестанет
	// считаться отложенной. Клавиатуру не трогаем: сообщения больше нет.
	Если Дней > 0 Тогда

		ОтветитьНаНажатие(Токен, ИДНажатия,
			?(Новая, "Задача создана, срок: ", "Срок: ")
			+ Формат(Срок, "ДФ='dd.MM.yyyy'")
			+ ". Карточка убрана из чата - вернётся утром в день срока.");

		УбратьКарточкиЗаказа(Токен, Заказ);

		Возврат;

	КонецЕсли;

	ОтветитьНаНажатие(Токен, ИДНажатия,
		?(Новая, "Задача создана, срок: ", "Срок: ")
		+ Формат(Срок, "ДФ='dd.MM.yyyy'"));

	// Перерисовываем меню: у только что созданной задачи кнопка заказа меняет
	// подпись с "➕" на "📋", а меню остаётся открытым для следующей правки.
	ПереключитьКлавиатуру(Токен, ЧатИД, НомерСообщения, КлавиатураЗадачи(Заказ));

КонецПроцедуры

// Есть ли по заказу задача, о которой пора напоминать ПРЯМО СЕЙЧАС: открытая
// (не выполненная) и с наступившим напоминанием. Это единственный признак,
// по которому решается, быть карточке в чате или не быть (правило пользователя
// 16.08.2026, см. шапку модуля):
//
//   нет задачи                            -> нет карточки
//   есть задача, напоминание позже сейчас -> нет карточки
//   есть задача, напоминание наступило    -> есть карточка
//
// Порог - именно ТЕКУЩИЙ МОМЕНТ, а не начало завтрашнего дня, как в ЗадачаОтложена:
// задача, отложенная на сегодня на 16:00, до 16:00 в чате висеть не должна.
//
// Ориентир - "Напомнить" (СрокОповещения), а не больший из двух сроков: у заказа
// сплошь и рядом "Исполнить до" стоит на завтра, а напомнить нужно сегодня.
// Напоминание выключено или не заполнено - других ориентиров нет, тогда решает
// "Исполнить до".
Функция ЕстьАктуальнаяЗадача(Знач Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗадачиПользователя.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
		|ГДЕ
		|	ЗадачиПользователя.Объект = &Заказ
		|	И НЕ ЗадачиПользователя.Выполнена
		|	И ВЫБОР
		|			КОГДА ЗадачиПользователя.Оповещение
		|					И ЗадачиПользователя.СрокОповещения <> ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ЗадачиПользователя.СрокОповещения
		|			ИНАЧЕ ЗадачиПользователя.СрокИсполнения
		|		КОНЕЦ <= &Сейчас";

	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДата());

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Отложена ли работа по заказу: есть открытая задача, НАПОМИНАНИЕ по которой
// стоит на завтра и позже. Отсюда решает только ВернутьЗадачуНаСегодня -
// "клиент перезвонил, вернём задачу на сегодня"; жизнью карточки в чате
// с 16.08.2026 заведует ЕстьАктуальнаяЗадача выше, и порог у неё другой.
// Такой заказ не должен висеть карточкой в чате:
// менеджер осознанно перенёс его на потом, и карточку вернёт регламент утром
// нужного дня.
//
// Смотрим именно "Напомнить" (СрокОповещения), а не больший из двух сроков
// (так было до 10.08.2026). Причина: у заказа сплошь и рядом "Исполнить до"
// стоит на завтра, а напомнить нужно сегодня - по прежнему правилу такой
// заказ считался отложенным, и карточка исчезала из чата сразу после
// появления. Менеджер видел, как новый заказ приходит и тут же удаляется.
//
// Напоминание выключено или не заполнено - других ориентиров нет, тогда
// решает "Исполнить до".
Функция ЗадачаОтложена(Знач Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗадачиПользователя.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
		|ГДЕ
		|	ЗадачиПользователя.Объект = &Заказ
		|	И НЕ ЗадачиПользователя.Выполнена
		|	И ВЫБОР
		|			КОГДА ЗадачиПользователя.Оповещение
		|					И ЗадачиПользователя.СрокОповещения <> ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ЗадачиПользователя.СрокОповещения
		|			ИНАЧЕ ЗадачиПользователя.СрокИсполнения
		|		КОНЕЦ >= &Завтра";

	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("Завтра", НачалоДня(ТекущаяДата()) + 86400);

	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Задача по заказу для правки из чата: находит открытую, а нет - заводит новую.
//
// Исполнителя выбираем ровно той же логикой, что и ночная БИАС.ПроверкаЗадачь
// (розничное переопределение статуса → Пользователь1 статуса → группа из статуса
// → ответственный по заказу).
// Иначе задачи по одному заказу расходились бы по разным людям в зависимости
// от того, кто их создал - человек из чата или ночная проверка.
//
// Возвращаемое значение:
//  ЗадачаОбъект.ЗадачиПользователя - НЕзаписанная задача (записывает вызывающий),
//  либо Неопределено, если исполнителя определить не из чего.
//
Функция ЗадачаДляЗаказа(Знач Заказ)

	Ссылка = ЗадачаПоЗаказу(Заказ);

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка.ПолучитьОбъект();
	КонецЕсли;

	Статус      = Заказ.СтатусЗаказа;
	Исполнитель = Неопределено;

	Если ЗначениеЗаполнено(Статус)
		И ЗначениеЗаполнено(Статус.ПользовательПросрочкиРозница)
		И ЭтоРозничныйЗаказ(Заказ) Тогда
		Исполнитель = Статус.ПользовательПросрочкиРозница;
	ИначеЕсли ЗначениеЗаполнено(Статус) И ЗначениеЗаполнено(Статус.Пользователь1) Тогда
		Исполнитель = Статус.Пользователь1;
	ИначеЕсли ЗначениеЗаполнено(Статус)
		И ЗначениеЗаполнено(Статус.ЗадачаГруппеПользователей) Тогда
		Исполнитель = Статус.ЗадачаГруппеПользователей;
	ИначеЕсли ЗначениеЗаполнено(Заказ.Ответственный) Тогда
		Исполнитель = Заказ.Ответственный;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();

	// Идентификатор - такой же, как у ночной БИАС.ПроверкаЗадачь: "ПросрочкаСтатуса_"
	// + код статуса. Отдельного "Telegram" быть не должно (просьба пользователя,
	// 12.08.2026): ночная проверка ищет задачу строго по своему идентификатору
	// (ПолучитьЗадачуЗаказаПоИдентификатору), чужой не видит и заводит по тому же
	// заказу вторую задачу - у менеджера в списке две карточки на один заказ.
	//
	// Статус пуст - идентификатор строить не из чего; ночная проверка такие заказы
	// всё равно пропускает, дублей не будет.
	Если ЗначениеЗаполнено(Статус) Тогда
		Задача.ИдентификаторСобытия = "ПросрочкаСтатуса_" + Статус.Код;
		Задача.СтатусЗаказа         = Лев(Статус.Наименование, 30);
	Иначе
		Задача.ИдентификаторСобытия = "Telegram";
	КонецЕсли;

	// Дата - НачалоДня + 9:00, как её ставит ночная проверка: по ней же считается
	// "свежесть" задачи при отправке уведомления менеджеру.
	Задача.Дата                 = НачалоДня(ТекущаяДата()) + 32400;
	Задача.Наименование         = Лев(СокрЛП(Строка(Заказ.Контрагент)), 100);
	Задача.Объект               = Заказ;
	Задача.Описание             = "Задача из Telegram";
	Задача.Исполнитель          = Исполнитель;
	Задача.Оповещение           = Истина;
	Задача.СрокИсполнения       = Задача.Дата;
	Задача.СрокОповещения       = Задача.СрокИсполнения;

	Возврат Задача;

КонецФункции

// Запись задачи без выброса исключения наружу: нажатие кнопки не должно
// падать с ошибкой у менеджера в чате, ему нужен внятный ответ.
Функция ЗаписатьЗадачуТихо(Знач Задача, Знач Заказ)

	Попытка

		Задача.Записать();
		Возврат Истина;

	Исключение

		ЗаписьЖурналаРегистрации("Телеграм.Задача",
			УровеньЖурналаРегистрации.Ошибка, , Заказ,
			"Не удалось записать задачу: " + ОписаниеОшибки());

		Возврат Ложь;

	КонецПопытки;

КонецФункции

// Ответ менеджера текстом на сообщение заказа: дописывает текст в задачу.
//
// Заказ определяем по сообщению, НА КОТОРОЕ ответили: пара "чат + номер
// сообщения" лежит в регистре ТелеграмУведомления с момента отправки, и это
// избавляет от приглашений с невидимыми метками в тексте.
//
// Текст пишем в Описание, а НЕ в ДопИнформацию: ДопИнформация - строка ровно
// на 30 символов, заметка менеджера в неё молча не влезет (у Описания длина
// не ограничена).
Процедура ОбработатьОтветТекстом(Знач Токен, Знач Сообщение, Знач Исходное)

	Текст = СокрЛП(СтрокаJSON(Сообщение, "text"));

	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	ЧатИД = "";
	Чат   = Неопределено;
	Если Сообщение.Свойство("chat", Чат) И ТипЗнч(Чат) = Тип("Структура") Тогда
		ЧатИД = СтрокаJSON(Чат, "id");
	КонецЕсли;

	Заказ = ЗаказПоСообщению(ЧатИД, ЧислоJSON(Исходное, "message_id"));

	// Ответили на постороннее сообщение - молчим. Чат общий, и лезть с ответами
	// в чужую переписку бот не должен.
	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;

	НомерОтвета = ЧислоJSON(Сообщение, "message_id");

	Задача = ЗадачаДляЗаказа(Заказ);

	Если Задача = Неопределено Тогда
		ОтветитьВЧат(Токен, ЧатИД, НомерОтвета,
			"⚠️ Задачу создать не на кого: у статуса заказа не задан пользователь,"
			+ " ответственный в заказе тоже пуст.");
		Возврат;
	КонецЕсли;

	Новая = Задача.Ссылка.Пустая();

	Заметка = Формат(ТекущаяДата(), "ДФ='dd.MM HH:mm'")
		+ " " + КтоНажал(Сообщение) + ": " + Текст;

	// У новой задачи Описание - это наша же заглушка "Задача из Telegram",
	// её заменяем, а не копим.
	Если Новая Тогда
		Задача.Описание = Заметка;
	Иначе
		Задача.Описание = ?(ПустаяСтрока(СокрЛП(Строка(Задача.Описание))), "",
			Строка(Задача.Описание) + Символы.ПС) + Заметка;
	КонецЕсли;

	Если Не ЗаписатьЗадачуТихо(Задача, Заказ) Тогда
		ОтветитьВЧат(Токен, ЧатИД, НомерОтвета,
			"⚠️ Не удалось записать задачу - смотрите журнал регистрации.");
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("Телеграм.Задача",
		УровеньЖурналаРегистрации.Информация, , Заказ,
		?(Новая, "Задача создана из чата: ", "Дописано в задачу: ") + Текст);

	ОтветитьВЧат(Токен, ЧатИД, НомерОтвета,
		?(Новая, "✅ Задача создана", "✅ Записано в задачу"));

КонецПроцедуры

// Заказ по сообщению в чате - обратный поиск по регистру ТелеграмУведомления.
// Нужен для ответов текстом: в самом ответе Telegram не передаёт ничего, кроме
// сообщения, на которое ответили.
Функция ЗаказПоСообщению(Знач ЧатИД, Знач НомерСообщения)

	Если ПустаяСтрока(СокрЛП(Строка(ЧатИД))) Или НомерСообщения = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТелеграмУведомления.Заказ КАК Заказ
		|ИЗ
		|	РегистрСведений.ТелеграмУведомления КАК ТелеграмУведомления
		|ГДЕ
		|	ТелеграмУведомления.Чат = &Чат
		|	И ТелеграмУведомления.НомерСообщения = &НомерСообщения";

	Запрос.УстановитьПараметр("Чат", Лев(СокрЛП(Строка(ЧатИД)), 32));
	Запрос.УстановитьПараметр("НомерСообщения", НомерСообщения);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Заказ;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Короткий ответ в чат репликой на сообщение менеджера. Единственное место,
// где бот сам пишет в чат помимо уведомлений: без подтверждения человек
// не знает, дошёл его текст до задачи или нет.
Процедура ОтветитьВЧат(Знач Токен, Знач ЧатИД, Знач НомерСообщения, Знач Текст)

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("text", Текст);

	Если НомерСообщения > 0 Тогда
		Параметры.Вставить("reply_to_message_id", НомерСообщения);
	КонецЕсли;

	ВыполнитьЗапрос(Токен, "sendMessage", ВJSON(Параметры), Неопределено);

КонецПроцедуры

// Что мы знаем про это сообщение из истории: нажимали ли "Обработан", когда
// и кто, и каким уведомлением оно было. Записи может не быть - тогда считаем,
// что не обработано, а заголовок не восстанавливаем.
Функция СостояниеОбработки(Знач ЧатИД, Знач НомерСообщения, Знач Заказ)

	Состояние = Новый Структура("Обработан, Дата, Кто, Вид", Ложь, '00010101', "", "");

	Если ПустаяСтрока(СокрЛП(Строка(ЧатИД))) Или НомерСообщения = 0 Тогда
		Возврат Состояние;
	КонецЕсли;

	Попытка

		Запись = РегистрыСведений.ТелеграмУведомления.СоздатьМенеджерЗаписи();
		Запись.Заказ          = Заказ;
		Запись.Чат            = Лев(СокрЛП(Строка(ЧатИД)), 32);
		Запись.НомерСообщения = НомерСообщения;
		Запись.Прочитать();

		Если Запись.Выбран() Тогда
			Состояние.Обработан = Запись.Обработан;
			Состояние.Дата      = Запись.ДатаОбработки;
			Состояние.Кто       = Запись.КтоОбработал;
			Состояние.Вид       = Запись.ВидУведомления;
		КонецЕсли;

	Исключение
		// История не критична: без неё просто перерисуем сообщение без заголовка.
	КонецПопытки;

	Возврат Состояние;

КонецФункции

// Заголовок сообщения по виду уведомления - чтобы при обновлении по кнопке
// "Статус" сообщение осталось тем же по смыслу, а не превратилось в безликое.
// Цветной кружок по статусу заказа - "цвет фона" карточки, доступный боту.
// Сверка по началу наименования, как в СтатусВРаботе: статусы - данные
// справочника, точное написание может отличаться. Порядок важен: "не прода"
// раньше "продан", иначе "Не продано" попало бы в зелёные.
//
//  🔴 не продан      - новый, звонка ещё не было
//  🟢 продано        - подтверждён
//  🟡 ожидает оплаты - ждём деньги
//  🔵 резерв         - резерв
//  ⚪ остальное      - закрывающие статусы (в чате почти не встречаются)
Функция ЦветСтатуса(Знач Статус)

	Имя = НРег(СокрЛП(Строка(Статус)));

	Если Лев(Имя, 8) = "не прода" Тогда
		Возврат "🔴";
	ИначеЕсли Лев(Имя, 6) = "продан" Тогда
		Возврат "🟢";
	ИначеЕсли Лев(Имя, 13) = "ожидает оплат" Тогда
		Возврат "🟡";
	ИначеЕсли Лев(Имя, 6) = "резерв" Тогда
		Возврат "🔵";
	КонецЕсли;

	Возврат "⚪";

КонецФункции

Функция ЗаголовокПоВиду(Знач Вид, Знач Заказ = Неопределено)

	Если Вид = "НовыйЗаказ" Тогда

		// Оптовая карточка - без "С САЙТА" и "нужно позвонить" (просьба
		// пользователя, 10.08.2026): оптовые заказы менеджер заводит сам,
		// звонить по ним не нужно. Заказ не передали - остаётся розничный
		// заголовок, как раньше.
		Если ЗначениеЗаполнено(Заказ) И Не ЭтоРозничныйЗаказ(Заказ) Тогда
			Возврат "🆕 <b>НОВЫЙ ЗАКАЗ</b>";
		КонецЕсли;

		Возврат "🆕 <b>НОВЫЙ ЗАКАЗ С САЙТА</b> - нужно позвонить";
	ИначеЕсли Вид = "СменаСтатуса" Тогда
		Возврат "➡️ <b>СМЕНА СТАТУСА</b>";
	ИначеЕсли Вид = "Возврат" Тогда
		// Без заголовка (просьба пользователя, 10.08.2026): надпись "ВЕРНУЛИ
		// В ЧАТ - заказом нужно заняться снова" вводила в заблуждение - после
		// перезаливок и восстановлений регламентом ею открывалась почти каждая
		// карточка, хотя заниматься заказом "снова" никто не просил.
		Возврат "";
	КонецЕсли;

	Возврат "";

КонецФункции

// Подпись кнопки после отметки: одна и та же и при нажатии "Обработан",
// и при последующих обновлениях по кнопке "Статус".
Функция ОтметкаНаКнопке(Знач ДатаОбработки, Знач Кто)

	Если Не ЗначениеЗаполнено(ДатаОбработки) Тогда
		Возврат "";
	КонецЕсли;

	Надпись = "✅ Обработан " + Формат(ДатаОбработки, "ДФ='dd.MM HH:mm'");

	Если Не ПустаяСтрока(Кто) Тогда
		Надпись = Надпись + " - " + Кто;
	КонецЕсли;

	Возврат Надпись;

КонецФункции

// Заказ по callback_data вида "ok:<UUID заказа>".
Функция ЗаказПоДаннымКнопки(Знач Данные)

	Идентификатор = СокрЛП(Сред(СокрЛП(Данные), 4));

	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Ссылка = Документы.ЗаказПокупателя.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Идентификатор));
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	// Ссылка на несуществующий документ читается без ошибки, но пустыми
	// значениями реквизитов - по номеру и отличаем.
	Если ПустаяСтрока(СокрЛП(Ссылка.Номер)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Ссылка;

КонецФункции

// Ставит отметку обработки в истории и возвращает задачу, к которой сообщение
// было привязано при отправке (Неопределено - привязки не было).
Функция ОтметитьВИстории(Знач ЧатИД, Знач НомерСообщения, Знач Заказ,
	Знач ДатаОбработки, Знач Кто)

	Если НомерСообщения = 0 Или ПустаяСтрока(ЧатИД) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка

		Запись = РегистрыСведений.ТелеграмУведомления.СоздатьМенеджерЗаписи();

		Запись.Заказ          = Заказ;
		Запись.Чат            = Лев(СокрЛП(Строка(ЧатИД)), 32);
		Запись.НомерСообщения = НомерСообщения;

		Запись.Прочитать();

		Если Не Запись.Выбран() Тогда

			// Записи нет - сообщение ушло до появления регистра. Заводим её
			// сейчас, чтобы отметка обработки не потерялась.
			Запись.Заказ          = Заказ;
			Запись.Чат            = Лев(СокрЛП(Строка(ЧатИД)), 32);
			Запись.НомерСообщения = НомерСообщения;
			Запись.ДатаОтправки   = ДатаОбработки;

		КонецЕсли;

		Запись.Обработан     = Истина;
		Запись.ДатаОбработки = ДатаОбработки;
		Запись.КтоОбработал  = Лев(Кто, 100);

		Запись.Записать(Истина);

		Возврат Запись.Задача;

	Исключение

		ЗаписатьОшибку(Заказ, "Не удалось отметить обработку в истории: " + ОписаниеОшибки());
		Возврат Неопределено;

	КонецПопытки;

КонецФункции

// Дописывает в задачу менеджера строку с датой обработки. Задачу не закрывает:
// закрытие - решение менеджера в 1С.
Процедура ОтметитьВЗадаче(Знач Задача, Знач Заказ, Знач ДатаОбработки, Знач Кто)

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Задача = ЗадачаПоЗаказу(Заказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат;
	КонецЕсли;

	ОбъектЗадачи = Задача.ПолучитьОбъект();

	Если ОбъектЗадачи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Отметка = "✅ Обработан в Telegram "
		+ Формат(ДатаОбработки, "ДФ='dd.MM.yyyy HH:mm'");

	Если Не ПустаяСтрока(Кто) Тогда
		Отметка = Отметка + " - " + Кто;
	КонецЕсли;

	// Пишем в "Описание": это строка неограниченной длины. В "ДопИнформации"
	// всего 30 символов - отметка молча обрезалась бы.
	Если СтрНайти(ОбъектЗадачи.Описание, "✅ Обработан в Telegram") = 0 Тогда

		ОбъектЗадачи.Описание = ?(ПустаяСтрока(ОбъектЗадачи.Описание),
			"", ОбъектЗадачи.Описание + Символы.ПС) + Отметка;

	КонецЕсли;

	Если Не ЗначениеЗаполнено(ОбъектЗадачи.ДатаИсполнения) Тогда
		ОбъектЗадачи.ДатаИсполнения = ДатаОбработки;
	КонецЕсли;

	Попытка
		ОбъектЗадачи.Записать();
	Исключение
		ЗаписатьОшибку(Заказ, "Не удалось записать отметку обработки в задачу: "
			+ ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Последняя незакрытая задача по заказу - на случай, когда сообщение отправили
// без привязки к задаче (уведомление о новом заказе).
Функция ЗадачаПоЗаказу(Знач Заказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗадачиПользователя.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
		|ГДЕ
		|	ЗадачиПользователя.Объект = &Заказ
		|	И НЕ ЗадачиПользователя.Выполнена
		|УПОРЯДОЧИТЬ ПО
		|	ЗадачиПользователя.Дата УБЫВ";

	Запрос.УстановитьПараметр("Заказ", Заказ);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Кто нажал кнопку: имя и @username из callback_query.from.
Функция КтоНажал(Знач Нажатие)

	Отправитель = Неопределено;

	Если Не Нажатие.Свойство("from", Отправитель)
		Или ТипЗнч(Отправитель) <> Тип("Структура") Тогда

		Возврат "";

	КонецЕсли;

	Представление = СокрЛП(СтрокаJSON(Отправитель, "first_name")
		+ " " + СтрокаJSON(Отправитель, "last_name"));

	ИмяПользователя = СтрокаJSON(Отправитель, "username");

	Если Не ПустаяСтрока(ИмяПользователя) Тогда
		Представление = СокрЛП(Представление + " @" + ИмяПользователя);
	КонецЕсли;

	Возврат Представление;

КонецФункции

// Ответ на нажатие: без него у менеджера крутятся "часики" на кнопке.
//
// По умолчанию - всплывашка: одна строка, гаснет сама, ничего закрывать не надо.
// Окном (show_alert) сейчас не пользуемся нигде: параметр оставлен на случай,
// когда сообщение действительно нельзя пропустить и его надо подтвердить.
Процедура ОтветитьНаНажатие(Знач Токен, Знач ИДНажатия, Знач Текст,
	Знач Окном = Ложь)

	Если ПустаяСтрока(ИДНажатия) Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("callback_query_id", ИДНажатия);
	Параметры.Вставить("text", Текст);

	Если Окном Тогда
		Параметры.Вставить("show_alert", Истина);
	КонецЕсли;

	ВыполнитьЗапрос(Токен, "answerCallbackQuery", ВJSON(Параметры), Неопределено);

КонецПроцедуры

// Меняет подпись кнопки под уже отправленным сообщением на "✅ Обработан <дата>",
// чтобы в чате было видно, что заказ разобрали, и повторно не звонили.
// Кнопка "Статус" при этом остаётся рабочей - смотреть заказ можно и после.
Процедура ОтметитьСообщение(Знач Токен, Знач ЧатИД, Знач НомерСообщения,
	Знач Заказ, Знач ДатаОбработки, Знач Кто)

	Если ПустаяСтрока(ЧатИД) Или НомерСообщения = 0 Тогда
		Возврат;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("chat_id", СокрЛП(Строка(ЧатИД)));
	Параметры.Вставить("message_id", НомерСообщения);
	Параметры.Вставить("reply_markup",
		КлавиатураЗаказа(Заказ, Истина, ОтметкаНаКнопке(ДатаОбработки, Кто)));

	ВыполнитьЗапрос(Токен, "editMessageReplyMarkup", ВJSON(Параметры), Неопределено);

КонецПроцедуры

// Вызывает метод Bot API. Сначала штатным HTTPСоединением, при отказе - через WinHttp:
// в этой базе исходящий HTTPS уже ходит обоими способами (см. ОплатаПоСсылке и БИАС),
// а какой из них доступен на сервере - выяснится только на живой базе.
Функция ВыполнитьЗапрос(Знач Токен, Знач Метод, Знач ТелоЗапроса, Знач Заказ)

	Адрес = "/bot" + Токен + "/" + Метод;
	ТелоОтвета = "";

	Попытка

		Соединение = Новый HTTPСоединение("api.telegram.org", 443, , , , 30,
			Новый ЗащищенноеСоединениеOpenSSL);

		Запрос = Новый HTTPЗапрос(Адрес);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		// Без BOM: с ним Telegram не разбирает JSON.
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		ТелоОтвета = Ответ.ПолучитьТелоКакСтроку("UTF-8");

	Исключение

		ОшибкаHTTPСоединения = ОписаниеОшибки();
		ТелоОтвета = "";

		Попытка

			HTTP = Новый COMОбъект("WinHttp.WinHttpRequest.5.1");
			HTTP.Open("POST", "https://api.telegram.org" + Адрес, Ложь);
			HTTP.SetRequestHeader("Content-Type", "application/json; charset=utf-8");
			HTTP.SetTimeouts(15000, 15000, 30000, 30000);
			HTTP.Send(ТелоЗапроса);

			ТелоОтвета = Строка(HTTP.ResponseText);

		Исключение

			ЗаписатьОшибку(Заказ, "Telegram недоступен (" + Метод + ")."
				+ Символы.ПС + "HTTPСоединение: " + ОшибкаHTTPСоединения
				+ Символы.ПС + "WinHttp: " + ОписаниеОшибки());

			Возврат Неопределено;

		КонецПопытки;

	КонецПопытки;

	Если ПустаяСтрока(СокрЛП(ТелоОтвета)) Тогда
		ЗаписатьОшибку(Заказ, "Telegram вернул пустой ответ (" + Метод + ").");
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		ЗаписатьОшибку(Заказ, "Не удалось разобрать ответ Telegram (" + Метод + "): "
			+ ОписаниеОшибки() + Символы.ПС + Лев(ТелоОтвета, 1000));
		Возврат Неопределено;
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ЗаписатьОшибку(Заказ, "Telegram вернул неожиданный ответ (" + Метод + "): "
			+ Лев(ТелоОтвета, 1000));
		Возврат Неопределено;
	КонецЕсли;

	// Отказ Bot API (ok:false) логируем ЗДЕСЬ, за все методы сразу. Раньше это делал
	// только ОтправитьСообщение, а editMessageText, answerCallbackQuery,
	// editMessageReplyMarkup и getUpdates отказ проглатывали: кнопка "Статус"
	// у менеджера не срабатывала, а в журнале не было ни строчки.
	//
	// Начало тела запроса кладём в текст намеренно - там chat_id и message_id,
	// без них по сообщению "Bad Request: message can't be edited" не понять, о каком
	// сообщении речь. Ответ при этом всё равно возвращаем: разбираться с ним
	// (или молча пропустить) - дело вызывающей стороны.
	Если Не БулевоJSON(Данные, "ok") Тогда

		Описание = СтрокаJSON(Данные, "description");

		ТекстОтказа = "Telegram отклонил " + Метод + ": " + Описание
			+ " (error_code " + Формат(ЧислоJSON(Данные, "error_code"), "ЧН=0; ЧГ=0") + ")"
			+ Символы.ПС + "Запрос: " + Лев(ТелоЗапроса, 300);

		// "query is too old" на answerCallbackQuery - не поломка, а следствие
		// расписания: Telegram держит нажатие живым считанные секунды, а забираем
		// мы его прогоном регламента. Менеджер это видит как "полоска загрузки
		// сверху появилась и пропала, всплывашки не было". Само сообщение при этом
		// перерисовывается нормально - editMessageText сроком не ограничен.
		// Пишем предупреждением, чтобы не путать с настоящими отказами.
		Если Метод = "answerCallbackQuery" И СтрНайти(Описание, "too old") > 0 Тогда

			ЗаписьЖурналаРегистрации("Телеграм.Кнопка",
				УровеньЖурналаРегистрации.Предупреждение, , ,
				ТекстОтказа + Символы.ПС
				+ "Всплывашка не показана - нажатие разобрано позже, чем его ждал"
				+ " Telegram. Лечится более частым расписанием ТелеграмОбмен.");

		Иначе

			ЗаписатьОшибку(Заказ, ТекстОтказа);

		КонецЕсли;

	КонецЕсли;

	Возврат Данные;

КонецФункции

Функция ВJSON(Значение)

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);

	Возврат ЗаписьJSON.Закрыть();

КонецФункции

// Строка "Оплата" для карточки по уже собранным данным (см. ДанныеОбОплате).
//
// Отдельно разведены "оплаты нет" и "не удалось проверить": молча написать
// "не поступала", когда до WayForPay просто не достучались, - худшее, что тут можно
// сделать. Признак несостоявшегося запроса - пустой КодОтвета: любой ответ самого
// WayForPay его заполняет, а обрыв связи и незаполненные константы мерчанта - нет.
//
// Параметры:
//  Данные      - Структура - результат ДанныеОбОплате (кроме поля Описание).
//  СуммаЗаказа - Число     - сумма документа, с ней сравниваем оплаченное.
//  ОтветWFP    - Структура - ответ WayForPay.ПолучитьСтатусПлатежа, если он был.
//              - Неопределено - к WayForPay не обращались.
//
// Возвращаемое значение:
//  Строка - одна строка в разметке HTML (Telegram).
//
Функция СтрокаОбОплате(Данные, Знач СуммаЗаказа, Знач ОтветWFP)

	Если Данные.Оплачен Тогда

		Результат = "💰 <b>Оплата:</b> "
			+ Формат(Данные.Сумма, "ЧДЦ=2; ЧН=0; ЧГ=0") + " грн";

		// Копейка допуска: суммы приходят из разных источников и округляются порознь.
		Если Данные.Сумма + 0.01 >= СуммаЗаказа Тогда
			Результат = Результат + " - оплачен полностью";
		Иначе
			Результат = Результат + " из " + Формат(СуммаЗаказа, "ЧДЦ=2; ЧН=0; ЧГ=0")
				+ " - предоплата";
		КонецЕсли;

		Уточнение = "";

		Если ЗначениеЗаполнено(Данные.Дата) Тогда
			Уточнение = Формат(Данные.Дата, "ДФ='dd.MM HH:mm'");
		КонецЕсли;

		// Откуда знаем - важно: деньги у эквайрера и деньги, принятые в базу, -
		// разные состояния, и второе менеджер должен ещё сделать руками.
		Если Данные.Источник = "WayForPay" Тогда
			Уточнение = ?(ПустаяСтрока(Уточнение), "", Уточнение + ", ")
				+ "WayForPay, в 1С не проведена";
		ИначеЕсли Данные.Источник = "сайт" Тогда
			Уточнение = ?(ПустаяСтрока(Уточнение), "", Уточнение + ", ") + "по данным сайта";
		КонецЕсли;

		Если Не ПустаяСтрока(Уточнение) Тогда
			Результат = Результат + " (" + Уточнение + ")";
		КонецЕсли;

		Возврат Результат;

	КонецЕсли;

	Если Данные.Статус = "Refunded" Или Данные.Статус = "Voided" Тогда
		Возврат "↩️ <b>Оплата:</b> платёж возвращён клиенту";
	КонецЕсли;

	Если Данные.Статус = "InProcessing" Или Данные.Статус = "Pending" Тогда
		Возврат "⏳ <b>Оплата:</b> платёж в обработке у WayForPay";
	КонецЕсли;

	Если ОтветWFP <> Неопределено И ПустаяСтрока(СокрЛП(Строка(ОтветWFP.КодОтвета))) Тогда
		Возврат "❔ <b>Оплата:</b> проверить не удалось - "
			+ HTML(Лев(СокрЛП(Строка(ОтветWFP.Сообщение)), 80));
	КонецЕсли;

	Результат = "❌ <b>Оплата:</b> не поступала";

	// Declined и прочие отказы стоит показать: клиент платить пытался, и это повод
	// перезвонить с другим способом оплаты, а не просто ждать.
	Если Не ПустаяСтрока(Данные.Статус) И Данные.Статус <> "Approved" Тогда
		Результат = Результат + " (" + HTML(Данные.Статус) + ")";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Дата из Unix-времени WayForPay. Ноль, Неопределено и Null дают пустую дату:
// поля createdDate/processingDate приходят из JSON и заполнены не всегда.
Функция ДатаИзUnix(Знач Значение)

	Секунды = ЧислоИлиНоль(Значение);

	Если Секунды <= 0 Тогда
		Возврат '00010101';
	КонецЕсли;

	Возврат Дата(1970, 1, 1) + Секунды;

КонецФункции

// Число из значения JSON: Неопределено, Null и строки дают 0 вместо исключения.
Функция ЧислоИлиНоль(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Число(СокрЛП(Строка(Значение)));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Телефон клиента в формате +380..., пригодном для звонка из Telegram.
Функция ТелефонДляЗвонка(Заказ)

	Телефон = СокрЛП(Строка(Заказ.ТелефонКонтрагента));

	// В заказах с сайта телефон кладётся в ТелефонКонтрагента1 (ОбменПокупателямиНашСайт).
	Если ПустаяСтрока(Телефон) Тогда
		Телефон = СокрЛП(Строка(Заказ.ТелефонКонтрагента1));
	КонецЕсли;

	Если ПустаяСтрока(Телефон) Тогда
		Телефон = СокрЛП(ОбщегоНазначения.ТелефонКонтрагента(Заказ.Контрагент));
	КонецЕсли;

	Цифры = "";
	Для Позиция = 1 По СтрДлина(Телефон) Цикл
		Символ = Сред(Телефон, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифры = Цифры + Символ;
		ИначеЕсли Символ = ";" Или Символ = "," Тогда
			// В реквизите может лежать несколько номеров - берём первый.
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если СтрДлина(Цифры) = 12 И Лев(Цифры, 3) = "380" Тогда
		Возврат "+" + Цифры;
	ИначеЕсли СтрДлина(Цифры) = 10 И Лев(Цифры, 1) = "0" Тогда
		Возврат "+38" + Цифры;
	ИначеЕсли СтрДлина(Цифры) = 9 Тогда
		Возврат "+380" + Цифры;
	КонецЕсли;

	// Формат не распознали - отдаём как есть, менеджер разберётся.
	Возврат ?(ПустаяСтрока(Цифры), "", Телефон);

КонецФункции

Функция АдресДоставки(Заказ)

	Адрес = СокрЛП(Строка(Заказ.АдресДоставки));

	Если ПустаяСтрока(Адрес) И ЗначениеЗаполнено(Заказ.АдресДоставкиНП) Тогда
		Адрес = СокрЛП(Строка(Заказ.АдресДоставкиНП));
	КонецЕсли;

	Возврат Адрес;

КонецФункции

// Экранирует символы, которые Telegram считает разметкой HTML.
Функция HTML(Знач Текст)

	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");

	Возврат Текст;

КонецФункции

Функция СтрокаJSON(Данные, Имя)

	Значение = Неопределено;
	Если Не Данные.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧЦ=20; ЧДЦ=0; ЧГ=0");
	КонецЕсли;

	Возврат СокрЛП(Строка(Значение));

КонецФункции

Функция ЧислоJSON(Данные, Имя)

	Значение = Неопределено;
	Если Не Данные.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;

	Попытка
		Возврат Число(СокрЛП(Строка(Значение)));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция БулевоJSON(Данные, Имя)

	Значение = Неопределено;
	Если Не Данные.Свойство(Имя, Значение) Или Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;

	ТекстЗначения = НРег(СокрЛП(Строка(Значение)));
	Возврат ТекстЗначения = "true" Или ТекстЗначения = "1" Или ТекстЗначения = "да";

КонецФункции

Процедура ЗаписатьОшибку(Заказ, Текст)

	ЗаписьЖурналаРегистрации("Телеграм.Ошибка",
		УровеньЖурналаРегистрации.Ошибка,
		?(ЗначениеЗаполнено(Заказ), Метаданные.Документы.ЗаказПокупателя, Неопределено),
		Заказ,
		Текст);

КонецПроцедуры

#КонецОбласти
