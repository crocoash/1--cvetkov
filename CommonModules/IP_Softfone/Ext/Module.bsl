Процедура ПодключитьсяНажатие(Элемент="")
	Если _Телефония=Неопределено Тогда
		Возврат;
	КонецЕсли; 
	Если ЗначениеЗаполнено(Константы.IP_Адрес.Получить())=Ложь Тогда
		_Телефония=Неопределено;
		Возврат;
	КонецЕсли; 
	Если ЗначениеЗаполнено(Константы.IP_Порт.Получить())=Ложь Тогда
		_Телефония=Неопределено;
		Возврат;
	КонецЕсли; 
	Если ЗначениеЗаполнено(Константы.IP_Логин.Получить())=Ложь Тогда
		_Телефония=Неопределено;
		Возврат;
	КонецЕсли; 
	Если ЗначениеЗаполнено(Константы.IP_Пароль.Получить())=Ложь Тогда
		_Телефония=Неопределено;
		Возврат;
	КонецЕсли;
	
	// подключение и авторизация
	Подключиться(Константы.IP_Адрес.Получить(),Константы.IP_Порт.Получить(),
	Константы.IP_Логин.Получить(),Константы.IP_Пароль.Получить());

	// подписка на получение событий
	ПодписатьсяНаВнешниеСобытия(1);
	
	// указываем класс событий Asterisk, который необходимо получать
