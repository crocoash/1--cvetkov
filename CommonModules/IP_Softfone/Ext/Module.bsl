   Возврат ПервыйСеанс;
	
КонецФункции

Процедура Автоподключение() Экспорт
	        ОчиститьСправочник_Телефония_Активность();

	        ПодключитьсяНажатие();
			Если _Телефония.Подключено=1 Тогда
			//Запишем в справочник код и наименование пользователя у которого активна телефония	
			Справочник=справочники._Телефония_Активность.СоздатьЭлемент();
			Справочник.Код=НомерСеансаИнформационнойБазы();
			МассивСоединений = ПолучитьСоединенияИнформационнойБазы() ;
			Для Каждого Соединение Из МассивСоединений Цикл
				Если 	Соединение.НомерСеанса= НомерСеансаИнформационнойБазы() тогда
					Справочник.Наименование= Соединение.Пользователь.ПолноеИмя;
					прервать;
				КонецЕсли;
			КонецЦикла;	
			Справочник.Записать();	
			Сообщить("Соединение с сервером телефонии восстановлено");
	КонецЕсли; 
КонецПроцедуры

Процедура   ПодключитьОбработчик() Экспорт
	 ПодключитьОбработчикОжидания("Автоподключение",30,Ложь);

	КонецПроцедуры

	Процедура ВнешнееСобытие(Источник, Событие, Данные)Экспорт;
		//Сообщить("__________________________________________________");
		//Сообщить(          Событие);
		//Сообщить(          Данные);
		CallerID1="";
		CallerID2="";
		НомерЗаказаНаСайте="";
		СсылкаНаЗаказ="";
		Ответственный="";
		Сообщение="";
		КонтактноеЛицо="";
		
		// классификация входящих событий и перенаправление в обработчики
		ДанныеСобытия=ДанныеВСоответствие(Данные);
		Event=ВРег(СокрЛП(ДанныеСобытия.Получить("Event")));
		State=ВРег(СокрЛП(ДанныеСобытия.Получить("State")));
		UniqueID =ЛЕВ(ВРег(СокрЛП(ДанныеСобытия.Получить("Uniqueid"))),10);
		Если UniqueID="" тогда
		UniqueID=ЛЕВ(ВРег(СокрЛП(ДанныеСобытия.Получить("UniqueID"))),10);
		КонецЕсли;

		//CALLBACK начинает звонить менеджерам ,начинает играть музыка 
		//Ввыводим информацию о покупателе в служебные сообщения
		Если Event ="MUSICONHOLD"  и State="START" тогда
			
		//Проверим права пользователя(константу разрешающюю выводить информацию о зонке) 	
		СписокПрав = УправлениеПользователями.ПолучитьЗначениеПраваДляТекущегоПользователя(
		ПланыВидовХарактеристик.ПраваПользователей.IP_Tel_massage , Ложь);
		Если СписокПрав.Количество() = 0 Тогда
			ВыводитьСообщение = Ложь;
		ИначеЕсли СписокПрав.Количество() > 1 Тогда
			ВыводитьСообщение = Истина;
		Иначе
			ВыводитьСообщение = СписокПрав[0].Значение;
		КонецЕсли;

		Попытка
			Если    ВыводитьСообщение= Истина тогда	
				Справочник=Справочники.IP_Softfone.НайтиПоРеквизиту("Uniqueid",UniqueID).ПолучитьОбъект();
				Сообщение="{"+ прав(Справочник.ВремяЗвонка,8)+"}"+Справочник.Наименование+"["+ Справочник.Телефон+"]";
				Если   ЗначениеЗаполнено(Справочник.КонтактноеЛицо) тогда
					Сообщение=Сообщение+Справочник.КонтактноеЛицо;
				КонецЕсли;
				Если   ЗначениеЗаполнено(Справочник.НомерСайт) тогда
					Сообщение=Сообщение+"[Заказ:"+Справочник.НомерСайт+"]";
				КонецЕсли;
				Если   ЗначениеЗаполнено(Справочник.НомерСайт) тогда
					Сообщение=Сообщение+"Менеджер:"+Справочник.Ответственный;
				КонецЕсли;
				Сообщить(Сообщение);
			КонецЕсли;	
		Исключение ; КонецПопытки;
		КонецЕСли;
	
		//Если это не первый сеанс то в справочник ни чего не пишем 
		ПервыйСеанс=ОбновитьСписокАктивныхСоединений();
		
		Если ПервыйСеанс <> Строка(НомерСеансаИнформационнойБазы()) тогда Возврат КонецЕсли;
		
		//CALLBACK начинает звонить менеджерам ,начинает играть музыка 
		//Обновим сделаем звонок "Активным"
        Если Event ="MUSICONHOLD"  и State="START" тогда
			Попытка
			            Справочник=Справочники.IP_Softfone.НайтиПоРеквизиту("Uniqueid",UniqueID).ПолучитьОбъект();
						Справочник.Активность="А";
						Справочник.Записать();
			
			Исключение ; КонецПопытки;
			Справочники.IP_Softfone.ПолучитьФормуСписка().Обновить();
		КонецЕсли;
		
		// классификация входящих событий и перенаправление в обработчики
		//ДанныеСобытия=ДанныеВСоответствие(Данные);
		//	Event=ВРег(СокрЛП(ДанныеСобытия.Получить("Event")));
		Exten=ВРег(СокрЛП(ДанныеСобытия.Получить("Exten")));
		
		CallerIDNum=ВРег(СокрЛП(ДанныеСобытия.Получить("CallerIDNum")));
		Если   		СтрДлина( CallerIDNum)=10 тогда  CallerIDNum="+38"+CallerIDNum ;
		ИначеЕсли   СтрДлина( CallerIDNum)=12 тогда  CallerIDNum="+"+CallerIDNum ;
		КонецЕсли;	
		
		Channel=ЛЕВ(ВРег(СокрЛП(ДанныеСобытия.Получить("Channel"))),6);
		
		Channel_2_Tel=ВРег(СокрЛП(ДанныеСобытия.Получить("Channel")));
		нач=find(Channel_2_Tel,"LOCAL");
		кон=find(Channel_2_Tel,"@");
		Channel_2_Tel=mid(Channel_2_Tel,нач+6,кон-нач-6);
		Если СтрДлина(Channel_2_Tel)=10 тогда  Channel_2_Tel="+38"+Channel_2_Tel ;
		КонецЕсли;
		
		ChannelStateDesc= ВРег(СокрЛП(ДанныеСобытия.Получить("ChannelStateDesc")));
		SubEvent=ВРег(СокрЛП(ДанныеСобытия.Получить("SubEvent")));
		ConnectedLineName= ВРег(СокрЛП(ДанныеСобытия.Получить("ConnectedLineName")));
		DialStatus=ВРег(СокрЛП(ДанныеСобытия.Получить("DialStatus")));
		//	State=ВРег(СокрЛП(ДанныеСобытия.Получить("State")));
		Context  =ВРег(СокрЛП(ДанныеСобытия.Получить("Context")));
		Bridgestate=ВРег(СокрЛП(ДанныеСобытия.Получить("Bridgestate")));
		Uniqueid1 =ЛЕВ(ВРег(СокрЛП(ДанныеСобытия.Получить("Uniqueid1"))),10);
		CallerID1="+380"+Прав(ВРег(СокрЛП(ДанныеСобытия.Получить("CallerID1"))),9);
		CallerID2="+380"+Прав(ВРег(СокрЛП(ДанныеСобытия.Получить("CallerID2"))),9);
		Channel1=ВРег(СокрЛП(ДанныеСобытия.Получить("Channel1")));
		
		//Зафиксирован входящий звонок на Колбек  Интертелекома или на Колбек GOIP32

		Если Event ="NEWCHANNEL" и Context="FROM-TRUNK" и Лев(Exten,2)="44" или Лев(Exten,3)="DID" Тогда
			МояДоработка(CallerIDNum,НомерЗаказаНаСайте,СсылкаНаЗаказ,Ответственный,КонтактноеЛицо);
			Записать_Новый_UniqueID_В_IP_Softfon("Входящий (Абонент->CallBack)",CallerIDNum,ТекущаяДата(),
			КонтактноеЛицо,UniqueID,Ответственный,НомерЗаказаНаСайте,СсылкаНаЗаказ,
			CallerIDNum,Exten);
		КонецЕСли;
		
		//CALLBACK перезванивает на входящий звонок		
		Если (Event = "DIAL") и (SubEvent="BEGIN")
		и Лев(Channel,6)="LOCAL/" и ConnectedLineName="CALLBACK" Тогда
			МояДоработка(Channel_2_Tel,НомерЗаказаНаСайте,СсылкаНаЗаказ,Ответственный,КонтактноеЛицо);
			Записать_Новый_UniqueID_В_IP_Softfon("Входящий (CallBack->Абонент)",Channel_2_Tel,ТекущаяДата(),КонтактноеЛицо,UniqueID,
			Ответственный,НомерЗаказаНаСайте,СсылкаНаЗаказ,CallerIDNum,Channel_2_Tel);
		КонецЕСли  ;
		

		//Зафиксирован входящий звонок на прямой номер
		Если Event = "NEWCHANNEL" и Context="FROM-TRUNK" и Лев(Exten,2)="GO" Тогда
			МояДоработка(CallerIDNum,НомерЗаказаНаСайте,СсылкаНаЗаказ,Ответственный,КонтактноеЛицо);
			Записать_Новый_UniqueID_В_IP_Softfon("Входящий (Абонент->Шлюз)",CallerIDNum,ТекущаяДата(),КонтактноеЛицо,UniqueID,
			Ответственный,НомерЗаказаНаСайте,СсылкаНаЗаказ,CallerIDNum,Exten);
		КонецЕсли;
	
			//Мы набираем абонента
		Если Event ="NEWCHANNEL" и Context="FROM-INTERNAL" и ЗначениеЗаполнено(Exten)
			и ЗначениеЗаполнено(CallerIDNum)   Тогда
	     	МояДоработка("+38"+Прав(Exten,10),НомерЗаказаНаСайте,СсылкаНаЗаказ,Ответственный,КонтактноеЛицо);
			Записать_Новый_UniqueID_В_IP_Softfon("Исходящий","+38"+Прав(Exten,10),ТекущаяДата(),
			КонтактноеЛицо,UniqueID,Ответственный,НомерЗаказаНаСайте,СсылкаНаЗаказ,
			CallerIDNum,Exten);
		КонецЕСли;
		
	
		//Соединились с Абонентом
		Если Event ="BRIDGE" и Bridgestate="LINK" 	и Лев(Channel1,6)<>"LOCAL/"  тогда
		Попытка	
		Tel=Справочники.IP_Softfone.НайтиПоРеквизиту("Uniqueid",Uniqueid1).ПолучитьОбъект().Телефон ;
		Исключение
		Tel=CallerID2;
		КонецПопытки;
	//			Если    CallerID1="+380" или CallerID1="+380443382554" тогда
	//				Tel=CallerID2;
	//			Иначе 
					//Tel=CallerID1;
					
	//			КонецЕсли;
				
				Попытка
					Запрос = Новый Запрос;
					ТекстЗапроса="ВЫБРАТЬ
   		    	    |	IP_Softfone.Код,
   	   		        |	IP_Softfone.Телефон,
   	   		        |	IP_Softfone.Статус
  				    |ИЗ
   	         		|	Справочник.IP_Softfone КАК IP_Softfone
   	            	|ГДЕ
   	    	        |	IP_Softfone.Телефон = &Телефон
   		            |	И IP_Softfone.Статус <> &Статус
					|";
					Запрос.Текст = ТекстЗапроса;
				 	Запрос.УстановитьПараметр("Телефон", Tel);
					Запрос.УстановитьПараметр("Статус", "+");
						                                        
					Результат = Запрос.Выполнить().Выбрать();
					Пока Результат.Следующий() Цикл
						Спр=Справочники.IP_Softfone.НайтиПоКоду(Результат.Код).ПолучитьОбъект() ;
						Спр.Статус ="+" ;
						Спр.Записать();
