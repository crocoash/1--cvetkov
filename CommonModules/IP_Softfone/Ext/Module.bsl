Функция Login(Логин,Пароль);

	Если ПустаяСтрока(Логин) Тогда
		Сообщить("Login(). Не указан параметр <Логин>");
		Возврат 0;
	КонецЕсли; 
	
	Если ПустаяСтрока(Пароль) Тогда
		Сообщить("Login(). Не указан параметр <Пароль>");
		Возврат 0;
	КонецЕсли; 
	
	Если _Телефония.Подключено=1 Тогда
		CRLF = Chars.CR + Chars.LF;
		СтрокаКоманды= "Action: Login"+CRLF+
		"Username: "+Логин+CRLF+
		"Secret: "+Пароль+CRLF+CRLF;
		Возврат ВыполнитьКоманду(СтрокаКоманды);
	КонецЕсли; 

КонецФункции // Login

Функция Подключиться(Адрес,Порт,Логин,Пароль) ;
	Попытка
	_Телефония.Подключиться(Адрес,Порт);
	Login(Логин,Пароль);
	Исключение
	Сообщить("Не удалось запустить IP Телефонию, возможно доступ к серверу  недоступен")
	КонецПопытки
КонецФункции

Функция ВыполнитьКоманду(СтрокаКоманды);
	// кроме веб-клиента
	#Если ВебКлиент Тогда
		Возврат 0;
	#КонецЕсли
	CRLF = Chars.CR + Chars.LF;
	// проверка завершения пакета
	Если Найти(СтрокаКоманды,CRLF+CRLF)=0 Тогда
		Сообщить("ВыполнитьКоманду: Неверный формат команды: "+CRLF+СтрокаКоманды);
		Возврат 0;
	КонецЕсли;
	Попытка
		Результат=_Телефония.ВыполнитьКоманду(СтрокаКоманды);
	Исключение
	КонецПопытки;
	Если Результат=1 Тогда
		Возврат Истина;
	КонецЕсли; 
	Возврат Ложь;

КонецФункции // ВыполнитьКоманду()

