КонецПроцедуры

Функция ПодписатьсяНаВнешниеСобытия(Режим) Экспорт;
	ТекущийРежим=_Телефония.РежимПрослушивания;
	// корректируем принимаемый параметр
	Режим = ?(Режим<0,0,Режим);
	Режим = ?(Режим>1,1,Режим);
	Если Режим - ТекущийРежим > 0 Тогда
		Попытка
		_Телефония.РежимПрослушивания(Режим);
		Исключение 
		Сообщить("Сервер телефонии недоступен !!!");
		КонецПопытки;
	
	КонецЕсли;
	Возврат _Телефония.РежимПрослушивания;
КонецФункции // ПодписатьсяНаВнешниеСобытия( 

Процедура ОтключитьТелефонию() Экспорт;
	Если _Телефония=Неопределено Тогда
		Возврат;
	КонецЕсли; 
	Если _Телефония.Подключено=1 Тогда
		Logoff();
		_Телефония.Отключиться();
		Попытка
