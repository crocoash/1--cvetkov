// Задача "Новые платежи Приват24" закрывается в момент открытия: менеджер,
// открыв её, сразу идёт принимать платёж, и повторно она уже не всплывает
// (см. БанковскиеВыписки.ВыполнитьЗадачуНовыхПлатежейПриОткрытии).
//
// Этот обработчик - страховка на случай, если платформа вызывает
// ОбработкаПолученияФормы и для обычных форм. Основной, гарантированный путь -
// вызов из ПриОткрытии() формы Задача.ЗадачиПользователя.ФормаЗадачи
// (форма двоичная, строка ставится в Конфигураторе).
//
Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)

	Попытка

		Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
			Возврат;
		КонецЕсли;

		КлючЗадачи = Неопределено;

		Если Не Параметры.Свойство("Ключ", КлючЗадачи) Тогда
			Возврат;
		КонецЕсли;

		Если ТипЗнч(КлючЗадачи) <> Тип("ЗадачаСсылка.ЗадачиПользователя")
			Или Не ЗначениеЗаполнено(КлючЗадачи) Тогда

			Возврат;

		КонецЕсли;

		Если Не БанковскиеВыписки.ЭтоЗадачаНовыхПлатежей(КлючЗадачи) Тогда
			Возврат;
		КонецЕсли;

		БанковскиеВыписки.ВыполнитьЗадачуНовыхПлатежейПриОткрытии(
			КлючЗадачи.ПолучитьОбъект());

	Исключение

		// Открытие формы не срываем ни при каких условиях.

	КонецПопытки;

КонецПроцедуры

Функция Создать(ИдентификаторСобытия, Наименование, Основание = неопределено) Экспорт

    ИсполнительГруппа = Справочники.Пользователи.НайтиПоНаименованию("Малюта Виталик").Родитель;

    Запрос = Новый Запрос;

    Запрос.Текст = "ВЫБРАТЬ
                    | ЗадачиПользователя.Ссылка КАК Ссылка
                    |ИЗ
                    | Задача.ЗадачиПользователя КАК ЗадачиПользователя
                    |ГДЕ
                    | ЗадачиПользователя.ИдентификаторСобытия = &ИдентификаторСобытия
                    | И ЗадачиПользователя.Выполнена = ЛОЖЬ";

    Запрос.УстановитьПараметр("ИдентификаторСобытия", ИдентификаторСобытия);

    Выборка = Запрос.Выполнить().Выбрать();

    // Проверка на наличие более одной записи
    КоличествоЗаписей = 0;
    Пока Выборка.Следующий() Цикл
        КоличествоЗаписей = КоличествоЗаписей + 1;
        Если КоличествоЗаписей > 1 Тогда
            Возврат неопределено;
        КонецЕсли;
        СуществующаяЗадача = Выборка.Ссылка;
    КонецЦикла;

    Если КоличествоЗаписей = 1 Тогда
        Задача = СуществующаяЗадача.ПолучитьОбъект();
    Иначе
        Задача = Задачи.ЗадачиПользователя.СоздатьЗадачу();
    КонецЕсли;

    Задача.ИдентификаторСобытия = ИдентификаторСобытия;
    Задача.Наименование = Наименование;
    Задача.Исполнитель = ИсполнительГруппа;
    Задача.Дата = НачалоДня(ТекущаяДата()) + 32400;
    Задача.Оповещение = Истина;
    Задача.Описание = "https://cvetkovtm.com/assets/shop/sync/Etsy.xlsx";
    Задача.СрокОповещения = Задача.Дата;
    Задача.СрокИсполнения = НачалоДня(ТекущаяДата()) + 32400;
    Задача.Объект = Основание; 

    Попытка
        Задача.Записать();
    Исключение
        // Обработка исключения, если необходимо
    КонецПопытки;

    Возврат Задача;
КонецФункции