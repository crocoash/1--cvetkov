функция ИспользоватьКарту(Контрагент, сумма = Неопределено) Экспорт 
	ПоследнийПлатежБылКарта = Ложь;
	Счет = Документы.ЗаказПокупателя.ПолучительПоследнийСчет(Контрагент);
	РучнойВыбор =  Документы.ЗаказПокупателя.ПолучитьРучнойВыборОплаты(Контрагент);
	
			
	Если ЗначениеЗаполнено(РучнойВыбор) Тогда
		Если РучнойВыбор Тогда 
			ПоследнийПлатежБылКарта = Истина;	
		КонецЕсли; 
	Иначе
		Если ЗначениеЗаполнено(Сумма) И Сумма < Константы.НаКартуСуумыДо.Получить()  Тогда
			Возврат Истина;
		КонецЕсли;  
		
		Если Сумма = Неопределено или Сумма > 10000 Тогда 
			Возврат Ложь;
		КонецЕсли;
				
		Если ЗначениеЗАполнено(Счет) Тогда
			ПоследнийПлатежБылКарта = Счет.Карта;
		КонецЕсли;
	КонецЕсли;

	Возврат ПоследнийПлатежБылКарта;
	
КонецФункции 

