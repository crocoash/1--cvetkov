функция ПолучитьВыпискуДляВыставленияСчета(БанковскийСчет = Неопределено) Экспорт     
	
	Запрос = Новый Запрос;        	
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	БанковскиеСчета.Ссылка КАК БанковскийСчет,
		|	ПолучимВыставленныйСчет.Сумма КАК ВыставленнаяСумма,
		|	ПолучимСуммуЗаМесяц.СуммаУпрОборот КАК ЗаМесяц,
		|	ВЫБОР
		|		КОГДА БанковскиеСчета.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|			ТОГДА 0
		|		ИНАЧЕ ПолучимЗаГод.СуммаУпрОборот
		|	КОНЕЦ КАК СуммаЗаГод,
		|	БанковскиеСчета.Пользователь КАК Пользователь,
		|	ПолучимЗаГод.СуммаУпрОборот + ПолучимВыставленныйСчет.Сумма КАК Итого,
		|	БанковскиеСчета.Пользователь КАК ПользовательКод
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВыставленныеСчета.БанковскийСчет КАК БанковскийСчет,
		|			СУММА(ВыставленныеСчета.Сумма) КАК Сумма
		|		ИЗ
		|			РегистрСведений.ВыставленныеСчетаКонтрагентов КАК ВыставленныеСчета
		|
		|		СГРУППИРОВАТЬ ПО
		|			ВыставленныеСчета.БанковскийСчет) КАК ПолучимВыставленныйСчет
		|		ПО БанковскиеСчета.Ссылка = ПолучимВыставленныйСчет.БанковскийСчет
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(ДвиженияДенежныхСредствОбороты.СуммаУпрОборот) КАК СуммаУпрОборот,
		|			ДвиженияДенежныхСредствОбороты.БанковскийСчетКасса КАК БанковскийСчет
		|		ИЗ
		|			РегистрНакопления.ДвиженияДенежныхСредств.Обороты(
		|					&ДатаНачМесяца,
		|					&ДатаКон,
		|					,
		|					ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДенежныхСредств.Безналичные)
		|						И ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)) КАК ДвиженияДенежныхСредствОбороты
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ДвиженияДенежныхСредствОбороты.БанковскийСчетКасса) КАК ПолучимСуммуЗаМесяц
		|		ПО БанковскиеСчета.Ссылка = ПолучимСуммуЗаМесяц.БанковскийСчет
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			СУММА(ДвиженияДенежныхСредствОбороты.СуммаУпрОборот) КАК СуммаУпрОборот,
		|			ДвиженияДенежныхСредствОбороты.БанковскийСчетКасса.Пользователь КАК БанковскийСчетКассаПользователь
		|		ИЗ
		|			РегистрНакопления.ДвиженияДенежныхСредств.Обороты(
		|					&ДатаНачалоГода,
		|					&ДатаКон,
		|					,
		|					ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДенежныхСредств.Безналичные)
		|						И ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)) КАК ДвиженияДенежныхСредствОбороты
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ДвиженияДенежныхСредствОбороты.БанковскийСчетКасса.Пользователь) КАК ПолучимЗаГод
		|		ПО БанковскиеСчета.Пользователь = ПолучимЗаГод.БанковскийСчетКассаПользователь
		|ГДЕ
		|	НЕ БанковскиеСчета.НеПоказывать
		|	И (БанковскиеСчета.Пользователь <> &Антон
		|			ИЛИ &ЭтоПользовательантон)
		|
		|УПОРЯДОЧИТЬ ПО
		|	БанковскиеСчета.Активный";
		
		
	Запрос.УстановитьПараметр("ДатаНачалоГода", НачалоГода(ТекущаяДата()));

	Запрос.УстановитьПараметр("Антон", Справочники.Пользователи.НайтиПоНаименованию("Антон"));
	Запрос.УстановитьПараметр("ЭтоПользовательантон", Истина);     //ПараметрыСеанса.ТекущийПользователь.Наименование = "Антон"
	 
	 
	Запрос.УстановитьПараметр("ДатаНачМесяца", НачалоМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("ДатаКон", КонецМесяца(ТекущаяДата()));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Обновляет выставленный счёт контрагента: подбирает банковский счёт под сумму
// и сохраняет запись регистра ВыставленныеСчетаКонтрагентов.
//
// Вызывается параллельно из нескольких фоновых заданий (запись заказа, запись
// реализации, перераспределение резервов). Запись выполняется набором с отбором
// по контрагенту - это одна атомарная операция: платформа сама удаляет прежние
// записи контрагента и вставляет новую. Ни чтения-изменения-записи объекта, ни
// версий, ни дублей, ни ручных блокировок здесь больше нет.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент, которому выставляется счёт.
//  Сумма      - Число                       - сумма к оплате.
//
// Возвращаемое значение:
//  Структура    - поля БанковскийСчет, Сумма, Дата - то, что записано контрагенту;
//  Неопределено - если контрагент не заполнен.
//
Функция ПолучитьВыставленныеСчета(Контрагент, Сумма) Экспорт

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Своя прежняя сумма исключается из контроля лимита: она будет заменена,
	// а не добавлена к уже выставленному по этому банковскому счёту.
	БанковскийСчет = ПолучитьСчетВыставления(Сумма, Контрагент, Контрагент);

	НаборЗаписей = РегистрыСведений.ВыставленныеСчетаКонтрагентов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Контрагент.Установить(Контрагент);

	Запись = НаборЗаписей.Добавить();
	Запись.Контрагент     = Контрагент;
	Запись.БанковскийСчет = БанковскийСчет;
	Запись.Сумма          = Сумма;
	Запись.Дата           = ТекущаяДата();

	НаборЗаписей.Записать();

	Результат = Новый Структура("БанковскийСчет, Сумма, Дата");
	ЗаполнитьЗначенияСвойств(Результат, Запись);

	Возврат Результат;

КонецФункции

// Возвращает текущий выставленный счёт контрагента.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент.
//
// Возвращаемое значение:
//  Структура - поля БанковскийСчет, Сумма, Дата;
//  Неопределено - если счёт контрагенту не выставлен.
//
Функция ПолучитьВыставленныйСчет(Контрагент) Экспорт

	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	             |	ВыставленныеСчета.БанковскийСчет КАК БанковскийСчет,
	             |	ВыставленныеСчета.Сумма КАК Сумма,
	             |	ВыставленныеСчета.Дата КАК Дата
	             |ИЗ
	             |	РегистрСведений.ВыставленныеСчетаКонтрагентов КАК ВыставленныеСчета
	             |ГДЕ
	             |	ВыставленныеСчета.Контрагент = &Контрагент";

	Запрос.УстановитьПараметр("Контрагент",Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда

		Результат = Новый Структура("БанковскийСчет, Сумма, Дата");
		ЗаполнитьЗначенияСвойств(Результат, Выборка);

		Возврат Результат;

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

функция МожноВыставитьСчет(Контрагент) Экспорт 
	  Возврат //не молдова не маруся и только оптовикам
	  
	    Контрагент.Регион.код <> "000000116"   
	  И Контрагент.Регион.Родитель.код <> "000000116"
	  И Контрагент.Регион.Родитель.Родитель.код <> "000000116"
	  И Контрагент.Регион.Родитель.Родитель.Родитель.код <> "000000116" 
	  И Контрагент.Код <> "000000364"
	  И Контрагент.ПолучитьОбъект().ЭтоОптовик();
КонецФункции

// Подбирает банковский счёт, на который можно выставить сумму с учётом лимитов.
//
// Параметры:
//  Сумма                 - Число                       - сумма к выставлению.
//  Контрагент            - СправочникСсылка.Контрагенты - контрагент.
//  ИсключаемыйКонтрагент - СправочникСсылка.Контрагенты - контрагент, чью текущую
//                            запись не нужно учитывать в контроле лимита: его прежняя
//                            сумма будет заменена, а не добавлена. Неопределено -
//                            учитывать все записи.
//
// Возвращаемое значение:
//  СправочникСсылка.БанковскиеСчета - подходящий счёт;
//  Неопределено                     - если счёт не найден.
//
Функция ПолучитьСчетВыставления(Сумма, Контрагент, ИсключаемыйКонтрагент = Неопределено) Экспорт

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ПолучитьВыставленныеСчета.Сумма, 0) КАК ВыставленнаяСумма,
		|	БанковскиеСчета.ЛимитСумма КАК ЛимитСумма,
		|	ПолучитьИнформациюЗаГод.СуммаЗаГодПоПользователю КАК СуммаЗаГодПоПользователю,
		|	БанковскиеСчета.Ссылка КАК БанковскийСчетКассаСсылка,
		|	ВЫБОР
		|		КОГДА БанковскиеСчета.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|			ТОГДА 1
		|		ИНАЧЕ 10
		|	КОНЕЦ КАК Порядок
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВложенныйЗапрос.СуммаУпрОборот КАК СуммаЗаГодПоПользователю,
		|		ДвиженияДенежныхСредствОбороты.СуммаУпрОборот КАК СуммаЗаГодПоСчету,
		|		ДвиженияДенежныхСредствОбороты.БанковскийСчетКасса.Ссылка КАК БанковскийСчетКассаСсылка,
		|		ДвиженияДенежныхСредствОбороты.БанковскийСчетКасса.Пользователь КАК БанковскийСчетКассаПользователь
		|	ИЗ
		|		РегистрНакопления.ДвиженияДенежныхСредств.Обороты(
		|				&ДатаНачалоГода,
		|				&ДатаКон,
		|				,
		|				ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДенежныхСредств.Безналичные)
		|					И ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)) КАК ДвиженияДенежныхСредствОбороты
		|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				СУММА(ДвиженияДенежныхСредствОбороты.СуммаУпрОборот) КАК СуммаУпрОборот,
		|				ДвиженияДенежныхСредствОбороты.БанковскийСчетКасса.Пользователь КАК БанковскийСчетКассаПользователь1
		|			ИЗ
		|				РегистрНакопления.ДвиженияДенежныхСредств.Обороты(
		|						&ДатаНачалоГода,
		|						&ДатаКон,
		|						,
		|						ВидДенежныхСредств = ЗНАЧЕНИЕ(Перечисление.ВидыДенежныхСредств.Безналичные)
		|							И ПриходРасход = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийПриходРасход.Приход)) КАК ДвиженияДенежныхСредствОбороты
		|			
		|			СГРУППИРОВАТЬ ПО
		|				ДвиженияДенежныхСредствОбороты.БанковскийСчетКасса.Пользователь) КАК ВложенныйЗапрос
		|			ПО ДвиженияДенежныхСредствОбороты.БанковскийСчетКасса.Пользователь = ВложенныйЗапрос.БанковскийСчетКассаПользователь1) КАК ПолучитьИнформациюЗаГод
		|		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		|			ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|				СУММА(ВыставленныеСчета.Сумма) КАК Сумма,
		|				ВыставленныеСчета.БанковскийСчет КАК БанковскийСчет
		|			ИЗ
		|				РегистрСведений.ВыставленныеСчетаКонтрагентов КАК ВыставленныеСчета
		|			ГДЕ
		|				ВыставленныеСчета.Контрагент <> &ИсключаемыйКонтрагент
		|
		|			СГРУППИРОВАТЬ ПО
		|				ВыставленныеСчета.БанковскийСчет) КАК ПолучитьВыставленныеСчета
		|			ПО БанковскиеСчета.Ссылка = ПолучитьВыставленныеСчета.БанковскийСчет
		|		ПО ПолучитьИнформациюЗаГод.БанковскийСчетКассаСсылка = БанковскиеСчета.Ссылка
		|ГДЕ
		|	БанковскиеСчета.Активный
		|	И (ЕСТЬNULL(БанковскиеСчета.ПлатежиОтЭтойСуммы, 0) < &Сумма
		|				И БанковскиеСчета.ИспользоватьДляБольшихСумм
		|			ИЛИ НЕ БанковскиеСчета.ИспользоватьДляБольшихСумм)
		|	И (ЕСТЬNULL(ПолучитьВыставленныеСчета.Сумма, 0) + &Сумма < БанковскиеСчета.ЛимитСумма
		|			ИЛИ НЕ БанковскиеСчета.ИспользоватьЛимит)
		|	И НЕ БанковскиеСчета.НеПоказывать
		|	И БанковскиеСчета.Карта = &Карта
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	ЛимитСумма УБЫВ,
		|	ВыставленнаяСумма"; 
		
		ИспользоватьКарту = ИспользоватьКарту(Контрагент, Сумма);


		Запрос.УстановитьПараметр("ДатаНачалоГода", НачалоГода(ТекущаяДата()));
		Запрос.УстановитьПараметр("ДатаКон", НачалоДня(ТекущаяДата()));
		Запрос.УстановитьПараметр("Карта", ИспользоватьКарту);
		Запрос.УстановитьПараметр("Сумма",Сумма);
		Запрос.УстановитьПараметр("ИсключаемыйКонтрагент",
			?(ИсключаемыйКонтрагент = Неопределено, Справочники.Контрагенты.ПустаяСсылка(), ИсключаемыйКонтрагент));

		Выборка = Запрос.Выполнить().Выбрать();

		// Отключённый отбор счёта "Моно" по остатку лимита - запрос оставлен как
		// комментарий вместе с использующим его блоком ниже.
		//ЗапросМоно = Новый Запрос;
		//ЗапросМоно.Текст = "ВЫБРАТЬ
		//               |	ЕСТЬNULL(СУММА(ВыставленныеСчета.Сумма), 0) КАК ВыставленнаяСумма,
		//               |	БанковскиеСчета.Ссылка КАК Ссылка
		//               |ИЗ
		//               |	Справочник.ВыставленныеСчета КАК ВыставленныеСчета
		//               |		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
		//               |		ПО ВыставленныеСчета.БанковскийСчет = БанковскиеСчета.Ссылка
		//               |ГДЕ
		//               |	БанковскиеСчета.Код = ""000000021""
		//               |
		//               |СГРУППИРОВАТЬ ПО
		//               |	ВыставленныеСчета.БанковскийСчет,
		//               |	ВыставленныеСчета.Ссылка,
		//               |	БанковскиеСчета.Ссылка";



		Если Выборка.Следующий() Тогда
			//Если Выборка.БанковскийСчетКассаСсылка.Карта Тогда
			//	Моно = ЗапросМоно.Выполнить().Выгрузить()[0];
			//	Если Моно.ВыставленнаяСумма < 10000 Тогда
			//		Возврат Моно.Ссылка;
			//	КонецЕсли;
			//КонецЕсли;

			Возврат Выборка.БанковскийСчетКассаСсылка;
		КонецЕсли;       
		
		
		                                                                    
		Возврат Неопределено;
КонецФункции
	
// Снимает выставленный счёт контрагента.
//
// Пустой набор с отбором по контрагенту удаляет его записи одной операцией.
// Ошибка не пробрасывается: вызывающий код формирует файлы резервов и не должен
// падать целиком из-за служебной записи лимитов.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - владелец записей.
//
Процедура УдалитьВыставленныйСчет(Контрагент)Экспорт

	Если Контрагент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка

		НаборЗаписей = РегистрыСведений.ВыставленныеСчетаКонтрагентов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Контрагент.Установить(Контрагент);
		НаборЗаписей.Записать();

	Исключение

		ЗаписьЖурналаРегистрации(
