Функция СоздатьБанковскийСчетОрганизации(Получатель, КодПолучателя, IBAN, НазначениеПлатежа) Экспорт
	
	IBAN = СтрЗаменить(IBAN, " ", "");
	
	Если Не ЗначениеЗаполнено(IBAN) Тогда
		ВызватьИсключение "Не указан IBAN";
	КонецЕсли;
	
	Организация = Справочники.Организации.НайтиПоКоду("000000001");
	
	Если Организация.Пустая() Тогда
		ВызватьИсключение "Не найдена организация с кодом 000000001";
	КонецЕсли;
	
	// Проверяем, есть ли уже такой счет у организации
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	БанковскиеСчета.Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Владелец
	|	И БанковскиеСчета.НомерСчета = &IBAN";
	
	Запрос.УстановитьПараметр("Владелец", Организация);
	Запрос.УстановитьПараметр("IBAN", IBAN);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	// Создаем новый банковский счет
	Счет = Справочники.БанковскиеСчета.СоздатьЭлемент();
	
	Счет.Банк = Справочники.Банки.НайтиПоНаименованию("Приват");
	Счет.Владелец = Организация;
	Счет.ФИО = Получатель;
	Счет.НомерСчета = IBAN;
	Счет.ЕГРПОУ = КодПолучателя;
    Счет.ТекстНазначения = НазначениеПлатежа;
    Счет.Карта = Ложь; 
	Счет.Активный = Истина;
	
	Счет.ПолучитьФорму().Открыть();
	//Счет.Записать();
	
	Возврат Счет.Ссылка;
	
КонецФункции  

Функция РазобратьБанковскиеРеквизиты(Текст) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("КодПолучателя", "");
	Результат.Вставить("Получатель", "");
	Результат.Вставить("IBAN", "");
	Результат.Вставить("НазначениеПлатежа", "");
	
	Результат.IBAN = ПолучитьIBANИзТекста(Текст);
	Результат.Получатель = ПолучитьПолучателяИзТекста(Текст);
	Результат.КодПолучателя = ПолучитьКодПолучателяИзТекста(Текст);
	Результат.НазначениеПлатежа = ПолучитьНазначениеИзТекста(Текст);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьIBANИзТекста(Текст)
	
	ТекстВерх = ВРег(Текст);
	Позиция = Найти(ТекстВерх, "UA");
	
	Пока Позиция > 0 Цикл
		
		IBAN = "";
		Индекс = Позиция;
		
		Пока Индекс <= СтрДлина(Текст) И СтрДлина(IBAN) < 29 Цикл
			
			Символ = Сред(Текст, Индекс, 1);
			СимволВерх = ВРег(Символ);
			
			Если Символ = " " Тогда
				// пропускаем пробелы
			ИначеЕсли Найти("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789", СимволВерх) > 0 Тогда
				IBAN = IBAN + СимволВерх;
			Иначе
				Если СтрДлина(IBAN) > 2 Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
			Индекс = Индекс + 1;
			
		КонецЦикла;
		
		Если Лев(IBAN, 2) = "UA" И СтрДлина(IBAN) = 29 Тогда
			Возврат IBAN;
		КонецЕсли;
		
		СледующаяПозиция = Найти(Сред(ТекстВерх, Позиция + 2), "UA");
		Если СледующаяПозиция = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Позиция = Позиция + 2 + СледующаяПозиция - 1;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьПолучателяИзТекста(Текст)
	
	Для НомерСтроки = 1 По СтрЧислоСтрок(Текст) Цикл
		
		СтрокаТекста = СокрЛП(СтрПолучитьСтроку(Текст, НомерСтроки));
		ПозицияФОП = Найти(ВРег(СтрокаТекста), "ФОП ");
		
		Если ПозицияФОП > 0 Тогда
			Возврат СокрЛП(Сред(СтрокаТекста, ПозицияФОП));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьКодПолучателяИзТекста(Текст)
	
	Метки = Новый Массив;
	Метки.Добавить("Код отримувача");
	Метки.Добавить("ІПН/ЄДРПОУ");
	Метки.Добавить("ИПН/ЕДРПОУ");
	Метки.Добавить("ЄДРПОУ");
	Метки.Добавить("ЕДРПОУ");
	
	Для НомерСтроки = 1 По СтрЧислоСтрок(Текст) Цикл
		
		СтрокаТекста = СокрЛП(СтрПолучитьСтроку(Текст, НомерСтроки));
		СтрокаВерх = ВРег(СтрокаТекста);
		
		Для Каждого Метка Из Метки Цикл
			
			Если Найти(СтрокаВерх, ВРег(Метка)) > 0 Тогда
				
				Код = ТолькоЦифры(СтрокаТекста);
				
				Если ПустаяСтрока(Код) И НомерСтроки < СтрЧислоСтрок(Текст) Тогда
					Код = ТолькоЦифры(СтрПолучитьСтроку(Текст, НомерСтроки + 1));
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Код) Тогда
					Возврат Код;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьНазначениеИзТекста(Текст)
	
	Для НомерСтроки = 1 По СтрЧислоСтрок(Текст) Цикл
		
		СтрокаТекста = СокрЛП(СтрПолучитьСтроку(Текст, НомерСтроки));
		Позиция = Найти(ВРег(СтрокаТекста), "ЗА ");
		
		Если Позиция > 0 Тогда
			Возврат СокрЛП(Сред(СтрокаТекста, Позиция));
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ТолькоЦифры(СтрокаТекста)
	
	Результат = "";
	
	Для Индекс = 1 По СтрДлина(СтрокаТекста) Цикл
		
		Символ = Сред(СтрокаТекста, Индекс, 1);
		
		Если Найти("0123456789", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции






