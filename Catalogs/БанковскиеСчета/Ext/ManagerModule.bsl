Функция NBU_QR_ПолучитьPNGПоСтроке(СтрокаДляQR, Размер = "300x300") Экспорт
	
	Попытка
		
		ЗакодированнаяСтрока = NBU_QR_URLКодировать(СтрокаДляQR);
		URL = "/v1/create-qr-code/?size=" + Размер + "&data=" + ЗакодированнаяСтрока;
		
		Соединение = Новый HTTPСоединение("api.qrserver.com", 443, , , , , Истина);
		Запрос = Новый HTTPЗапрос(URL);
		
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		
		Если Ответ.КодСостояния <> 200 Тогда
			ВызватьИсключение "QR API вернул код " + Строка(Ответ.КодСостояния);
		КонецЕсли;
		
		Возврат Ответ.ПолучитьТелоКакДвоичныеДанные();
		
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция NBU_QR_URLКодировать(ИсходнаяСтрока) Экспорт
	
	Результат = "";
	ДлинаСтроки = СтрДлина(ИсходнаяСтрока);
	
	Для Номер = 1 По ДлинаСтроки Цикл
		
		Символ = Сред(ИсходнаяСтрока, Номер, 1);
		Код = КодСимвола(Символ);
		
		// A-Z
		Если (Код >= 65 И Код <= 90)
			// a-z
			Или (Код >= 97 И Код <= 122)
			// 0-9
			Или (Код >= 48 И Код <= 57)
			// безопасные символы
			Или Символ = "-"
			Или Символ = "_"
			Или Символ = "."
			Или Символ = "~" Тогда
			
			Результат = Результат + Символ;
			
		ИначеЕсли Код = 10 Тогда // LF
			Результат = Результат + "%0A";
			
		ИначеЕсли Код = 13 Тогда // CR
			Результат = Результат + "%0D";
			
		ИначеЕсли Код <= 127 Тогда
			Результат = Результат + "%" + NBU_QR_ВHex2(Код);
			
		Иначе
			// Для кириллицы и других не-ASCII символов
			// кодируем как UTF-8
			Результат = Результат + NBU_QR_СимволВURL_UTF8(Символ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции   

Функция NBU_QR_ВHex2(ЧислоЗначение) Экспорт
	
	Хекс = "";
	Остаток = ЧислоЗначение;
	
	Пока Остаток > 0 Цикл
		Цифра = Остаток % 16;
		
		Если Цифра < 10 Тогда
			Хекс = Строка(Цифра) + Хекс;
		Иначе
			Если Цифра = 10 Тогда Хекс = "A" + Хекс; КонецЕсли;
			Если Цифра = 11 Тогда Хекс = "B" + Хекс; КонецЕсли;
			Если Цифра = 12 Тогда Хекс = "C" + Хекс; КонецЕсли;
			Если Цифра = 13 Тогда Хекс = "D" + Хекс; КонецЕсли;
			Если Цифра = 14 Тогда Хекс = "E" + Хекс; КонецЕсли;
			Если Цифра = 15 Тогда Хекс = "F" + Хекс; КонецЕсли;
		КонецЕсли;
		
		Остаток = Цел(Остаток / 16);
	КонецЦикла;
	
	Пока СтрДлина(Хекс) < 2 Цикл
		Хекс = "0" + Хекс;
	КонецЦикла;
	
	Возврат Хекс;
	
КонецФункции

Функция NBU_QR_СимволВURL_UTF8(Символ) Экспорт
	
	Код = КодСимвола(Символ);
	Результат = "";
	
	Если Код <= 127 Тогда
		Возврат "%" + NBU_QR_ВHex2(Код);
	КонецЕсли;
	
	Если Код <= 2047 Тогда
		
		Байт1 = 192 + Цел(Код / 64);
		Байт2 = 128 + (Код % 64);
		
		Результат = "%" + NBU_QR_ВHex2(Байт1);
		Результат = Результат + "%" + NBU_QR_ВHex2(Байт2);
		
		Возврат Результат;
		
	КонецЕсли;
	
	// 3-байтовый UTF-8
	Байт1 = 224 + Цел(Код / 4096);
	Байт2 = 128 + (Цел(Код / 64) % 64);
	Байт3 = 128 + (Код % 64);
	
	Результат = "%" + NBU_QR_ВHex2(Байт1);
	Результат = Результат + "%" + NBU_QR_ВHex2(Байт2);
	Результат = Результат + "%" + NBU_QR_ВHex2(Байт3);
	
	Возврат Результат;
	
КонецФункции

Функция NBU_QR_СохранитьВоВременныйФайл(QRДвоичныеДанные, Расширение = "png") Экспорт
	
	Если QRДвоичныеДанные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла(Расширение);
	QRДвоичныеДанные.Записать(ИмяФайла);
	
	Возврат ИмяФайла;
	
КонецФункции

Функция NBU_QR_ПолучитьКартинку(QRДвоичныеДанные) Экспорт
	
	ИмяФайла = NBU_QR_СохранитьВоВременныйФайл(QRДвоичныеДанные, "png");
	
	Если ПустаяСтрока(ИмяФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Картинка(ИмяФайла);
	
КонецФункции  

Функция NBU_QR_Base64UrlИзСтроки(ИсходнаяСтрока) Экспорт
	
	ИмяФайла = ПолучитьИмяВременногоФайла("txt");
	
	Попытка
		
		// 1. Пишем текст в UTF-8
		ТекстовыйПоток = Новый COMОбъект("ADODB.Stream");
		ТекстовыйПоток.Type = 2; // текст
		ТекстовыйПоток.Charset = "utf-8";
		ТекстовыйПоток.Open();
		ТекстовыйПоток.WriteText(ИсходнаяСтрока);
		
		// 2. Переключаем в бинарный режим
		ТекстовыйПоток.Position = 0;
		ТекстовыйПоток.Type = 1; // binary
		
		// 3. Пропускаем BOM UTF-8
		Если ТекстовыйПоток.Size >= 3 Тогда
			ТекстовыйПоток.Position = 3;
		Иначе
			ТекстовыйПоток.Position = 0;
		КонецЕсли;
		
		// 4. Читаем данные БЕЗ BOM
		БинарныеДанныеБезBOM = ТекстовыйПоток.Read();
		ТекстовыйПоток.Close();
		
		// 5. Сохраняем эти данные в новый бинарный поток
		БинарныйПоток = Новый COMОбъект("ADODB.Stream");
		БинарныйПоток.Type = 1; // binary
		БинарныйПоток.Open();
		БинарныйПоток.Write(БинарныеДанныеБезBOM);
		БинарныйПоток.Position = 0;
		БинарныйПоток.SaveToFile(ИмяФайла, 2);
		БинарныйПоток.Close();
		
		// 6. Читаем как ДвоичныеДанные
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяФайла);
		
		// 7. Base64
		СтрокаBase64 = Base64Строка(ДвоичныеДанные);
		
		СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ПС, "");
		СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ВК, "");   
		
		// 8. Base64URL
		СтрокаBase64 = СтрЗаменить(СтрокаBase64, "+", "-");
		СтрокаBase64 = СтрЗаменить(СтрокаBase64, "/", "_");
		СтрокаBase64 = СтрЗаменить(СтрокаBase64, "=", "");
		
		Возврат СтрокаBase64;
		
	Исключение
		ВызватьИсключение "Ошибка преобразования строки в Base64URL: " + ОписаниеОшибки();
	КонецПопытки;
	
КонецФункции
