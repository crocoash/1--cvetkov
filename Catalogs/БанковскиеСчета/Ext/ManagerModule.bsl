Функция NBU_QR_СформироватьСтруктуруДанных(Получатель, IBAN, КодПолучателя, Сумма, Назначение) Экспорт
	
	Получатель1 = СокрЛП(Строка(Получатель));
	IBAN1 = СтрЗаменить(СокрЛП(Строка(IBAN)), " ", "");
	КодПолучателя1 = СокрЛП(Строка(КодПолучателя));
	Назначение1 = СокрЛП(Строка(Назначение));
	
	СтрокаСуммы = "UAH" + NBU_QR_ФорматСуммы(Сумма);
	
	Возврат
		"BCD" + Символы.ПС
		+ "002" + Символы.ПС
		+ "1" + Символы.ПС
		+ "UCT" + Символы.ПС
		+ Символы.ПС
		+ Получатель1 + Символы.ПС
		+ IBAN1 + Символы.ПС
		+ СтрокаСуммы + Символы.ПС
		+ КодПолучателя1 + Символы.ПС
		+ Символы.ПС
		+ Символы.ПС
		+ Назначение1;
	
