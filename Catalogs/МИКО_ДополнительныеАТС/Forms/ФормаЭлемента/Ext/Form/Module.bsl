
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если Объект.Ссылка.Пустая() Тогда

		мод_стЗагрузкаИсторииЗвонков_v7 = Вычислить("МИКО_стЗагрузкаИсторииЗвонков_v7");
		МассивАТС = мод_стЗагрузкаИсторииЗвонков_v7.ОпределитьПараметрыАТС();
	    Индекс = 0;
		Пока Индекс < МассивАТС.Количество() Цикл
			АдресАТС = МассивАТС[Индекс].Получить("АдресСервера");
			ПортАТС  = МассивАТС[Индекс].Получить("ПортСервера");
			
			Если Объект.АдресСервера = АдресАТС И Объект.ПортСервера = ПортАТС Тогда
				Сообщить("АТС с таким адресом и номером порта уже созадана.");
				Отказ = Истина;
				Возврат;
			КонецЕсли; 
			
			Индекс = Индекс + 1;	
		КонецЦикла;
	
		Объект.id_pbx = Вернуть_id_pbx();
	КонецЕсли;
КонецПроцедуры


&НаСервере
Функция Вернуть_id_pbx()
	id_pbx = ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.id_pbx();
	ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.id_pbx(id_pbx+1);
	Возврат ПланыВидовХарактеристик.МИКО_стНастройкиТелефонии.id_pbx();
КонецФункции // ()
 
