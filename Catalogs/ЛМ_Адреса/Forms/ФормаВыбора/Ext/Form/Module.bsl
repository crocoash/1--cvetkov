&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Конь = ГлКонтрагентАдресаДоставки;
	Если  ЗначениеЗаполнено(Конь) Тогда
		Эл = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Эл.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
		Эл.ПравоеЗначение = Конь;
		Эл.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Эл.Использование = Истина;
	КонецЕсли;	
КонецПроцедуры


