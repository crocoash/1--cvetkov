Перем НеОбновлятьВИССлужбыДоставки Экспорт;

Процедура ОбновитьКонтактноеЛицоВИССлужбыДоставки() Экспорт
	Если НеОбновлятьВИССлужбыДоставки = Истина Тогда
		Возврат;
	КонецЕсли;	
	
	Отказ = Ложь;
	Если НЕ ЗначениеЗаполнено(Владелец) Тогда
		Сообщить("Не указан контрагент");
		Отказ = Истина;
	ИначеЕсли Не ЗначениеЗаполнено(Владелец.ГУИД) тогда
		Сообщить("В указанном контрагенте не заполнен идентификатор");
		Отказ = Истина;
	КонецЕсли;	
	
	Если Владелец.ЮрФизЛицо<>Владелец.ЮрФизЛицо.ГУИД="Organization" Тогда
		Если НЕ ЗначениеЗаполнено(СокрЛП(Имя)) тогда
			Сообщить("Не указано имя");
			Отказ = Истина;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(СокрЛП(Фамилия)) тогда
			Сообщить("Не указана фамилия");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;	
	Если Не ЗначениеЗаполнено(Телефон) тогда
		Сообщить("Не указан номер телефона");
		Отказ = Истина;
	КонецЕсли;	
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
		
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("apiKey", Константы.ЛМ_КлючAPI.Получить());
	СтруктураЗапроса.Вставить("modelName", "ContactPerson");
	Если ЗначениеЗаполнено(ГУИД) Тогда
		СтруктураЗапроса.Вставить("calledMethod", "update");
	Иначе	
		СтруктураЗапроса.Вставить("calledMethod", "save");
	КонецЕсли;
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("CounterpartyRef", Владелец.ГУИД);
	Если ЗначениеЗаполнено(ГУИД) Тогда
		СтруктураПараметров.Вставить("Ref", ГУИД);
	КонецЕсли;
	СтруктураПараметров.Вставить("Phone", Телефон);
	
	ДоступныхСимволов = 50;
	
//	Если Владелец.ЮрФизЛицо<>Владелец.ЮрФизЛицо.ГУИД="Organization" Тогда
		СтруктураПараметров.Вставить("FirstName", Лев(СокрЛП(Имя),ДоступныхСимволов));
		ДоступныхСимволов = ДоступныхСимволов - 1 - СтрДлина(СтруктураПараметров.FirstName);
		Если ДоступныхСимволов < 0 Тогда
			ДоступныхСимволов = 0;
		КонецЕсли;	
		СтруктураПараметров.Вставить("LastName", Лев(СокрЛП(Фамилия),ДоступныхСимволов));
		ДоступныхСимволов = ДоступныхСимволов - 1 - СтрДлина(СтруктураПараметров.LastName);
		Если ДоступныхСимволов < 0 Тогда
			ДоступныхСимволов = 0;
		КонецЕсли;	
		СтруктураПараметров.Вставить("MiddleName", ЛЕВ(СокрЛП(Отчество),ДоступныхСимволов));
//	КонецЕсли;	
	
	СтруктураЗапроса.Вставить("methodProperties", СтруктураПараметров);
	Если Константы.ЛМ_ЯзыкИнтерфейсаОбмена.Получить() = Перечисления.ЛМ_ЯзыкиИнтерфейсаОбмена.Украинский Тогда
		СтруктураЗапроса.Вставить("language", "ua");
	Иначе
		СтруктураЗапроса.Вставить("language", "ru");
	КонецЕсли;
	ДеревоОтвета = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.ОтправитьЗапрос(СтруктураЗапроса);
	СтруктураОтвета = Обработки.ЛМ_ОбменСИнформационнойСистемойСлужбыДоставки.ПолучитьСтруктуруОтвета(ДеревоОтвета, Истина);
	
	Если СтруктураОтвета.Свойство("Ref") И СтруктураОтвета.Ref <> ГУИД Тогда
		ГУИД = СтруктураОтвета.Ref;
	КонецЕсли;
	
	Если СтруктураОтвета.Свойство("Ошибки") Тогда
		Ошибки = СтруктураОтвета.Ошибки;
		Для Каждого КлючЗнач Из Ошибки Цикл
			Сообщить(КлючЗнач.Ключ + ": " + КлючЗнач.Значение, СтатусСообщения.Важное);
		КонецЦикла;	
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Наименование) И СтруктураОтвета.Свойство("Description") тогда
		Наименование = СтруктураОтвета.Description;
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ПередЗаписью(Отказ)
	ОбновитьКонтактноеЛицоВИССлужбыДоставки();
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ГУИД = "";
КонецПроцедуры
