				Иначе
					Результат = "[#462#] [#464#]"; //"Демисезонную подростковую";
				КонецЕсли;
			ИначеЕсли ЭтоМножественный Тогда
			    Результат = "[#468#] [#471#]"; //демисезонные подростковые			
            Иначе
                Результат = "[#460#] [#383#]"; // "Демисезонное подростковое";
            КонецЕсли;
		КонецЕсли;
	ИначеЕсли ЭтоЛето Тогда
		Если ЭтоМужскойРод Тогда
			Если ЭтоПлатье Тогда
				 Результат = "[#482#]"; //"Летний подростковый";
			Иначе
				 Результат = "[#472#] [#461#]"; //"Летний подростковый";
			КонецЕсли;
        ИначеЕсли ЭтоЖенскийРод Тогда		
			Если ЭтоАльт Тогда	
            	 Результат = "[#473#] [#382#]"; // "Летняя подростковая";
			Иначе
				Результат = "[#474#] [#464#]"; //"Летнюю подростковую";
			КонецЕсли;
		ИначеЕсли ЭтоМножественный Тогда
		    Результат = "[#475#] [#471#]"; //Летние подростковые			
        Иначе
            Результат = "[#460#] [#383#]"; // "Летнее подростковое";
        КонецЕсли;
		
	Иначе
		
		
		
		Если ЭтоДетская Тогда
            Если ЭтоМужскойРод Тогда
                Результат = "[#380#]"; // " детский";
			ИначеЕсли ЭтоЖенскийРод Тогда				
				Если ЭтоАльт Тогда	
                	 Результат = "[#377#]"; // " детская";
				Иначе
					Результат = "[#465#]"; //" детскую";
				КонецЕсли;	
			ИначеЕсли ЭтоМножественный Тогда			
				Результат = "[#470#]"; // детские				
            Иначе
                Результат = "[#376#]"; //" детское";
            КонецЕсли;
        ИначеЕсли ЭтоПодростковая Тогда
            Если ЭтоМужскойРод Тогда
                Результат = "[#461#]"; //" подростковый";
			ИначеЕсли ЭтоЖенскийРод Тогда		
				Если ЭтоАльт Тогда	
                	 Результат = "[#382#]"; // " подростковая";
				Иначе
					Результат = "[#464#]"; //" подростковую";
				КонецЕсли;
			ИначеЕсли ЭтоМножественный Тогда
			    Результат = "[#471#]"; // подростковые			
            Иначе
                Результат = "[#383#]"; // " подростковое";
            КонецЕсли;
		КонецЕсли;
    КонецЕсли;
    
    Возврат ПолучитьФразу(Результат, ЭтоМаркетПлейс, Соответствия);
    
КонецФункции

