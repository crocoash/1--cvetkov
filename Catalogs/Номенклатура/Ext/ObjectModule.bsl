Функция ПолучитьНК() экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ГруппыХарактеристик.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппыХарактеристик КАК ГруппыХарактеристик
		|ГДЕ
		|	ГруппыХарактеристик.Владелец = &Владелец";

	Запрос.УстановитьПараметр("Владелец", Ссылка);	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Группа = Выборка.Ссылка;
		Возврат Группа.ПолучитьОбъект().НКГруппы();
	Иначе
		Возврат Неопределено; // Если данных нет, возвращаем Неопределено
	КонецЕсли;
	
КонецФункции

