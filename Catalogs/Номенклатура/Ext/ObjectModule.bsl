Функция ПолучитьКлючИлиЗначение(Код, ЭтоМаркетПлейс, Соответствия) Экспорт
	
	Если ЭтоМаркетПлейс Тогда
		Если Соответствия[Код] <> неопределено Тогда
			Возврат Соответствия[Код];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции


Функция ПолучитьФразу(КодыСтрокой, ЭтоМаркетПлейс, Соответствия) Экспорт
	
	Если НЕ ЭтоМаркетПлейс Тогда
		Возврат КодыСтрокой;
	КонецЕсли;
	
	Результат = КодыСтрокой;
	
	Для каждого Элемент Из Соответствия Цикл
		Результат = СтрЗаменить(Результат, Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	Пока Найти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	
	Возврат СокрЛП(Результат);
	
КонецФункции

Функция ПолучитьНаименованиеДляВыгрузки(ЭтоАльт, ЭтоЕденичка = Ложь,ЭтоМаркетПлейс = Ложь) Экспорт
    
	Соответствия = ПолучитьСоответствиеНаименований();
	
    ТипИзделия = ПолучитьНаименованиеЗначенияСвойства("000000037");
    ВозрастнаяГруппа = ПолучитьНаименованиеЗначенияСвойства("000000114"); // Код возрастной группы
    Сезон = ПолучитьНаименованиеЗначенияСвойства("000000056"); // Код сезона
     
    // Сезон
    ЗимаСезон = "106090"; // Зимний
	ЛетоСезон = "861792"; // Лето (не используется в вариантах)
    
    ДемисезонМассив = Новый Массив;
	//ДемисезонМассив.Добавить("106080"); // Всесезонная модель	
    ДемисезонМассив.Добавить("106085"); // Осенне-Весенний
	
    
    // Возрастная Группа
    ВозрастнаяГруппаДетская = Новый Массив;
    ВозрастнаяГруппаДетская.Добавить("861700"); // Для Дошкольника
    ВозрастнаяГруппаДетская.Добавить("861701"); // Ясли 

    ВозрастнаяГруппаПодростковая = "861699"; // Подростковая
    
   // Мужской род
	МассивКодовМужскойРод = Новый Массив;
	МассивКодовМужскойРод.Добавить("00000038");  // Комбинезон-трансформер
	МассивКодовМужскойРод.Добавить("000000260"); // Полукомбинезон
	МассивКодовМужскойРод.Добавить("103130");    // Сарафан
	МассивКодовМужскойРод.Добавить("212646");    // Жакет
	МассивКодовМужскойРод.Добавить("861814");    // Костюм трійка
	МассивКодовМужскойРод.Добавить("102685");    // Платье 
	МассивКодовМужскойРод.Добавить("861832");    // корсет


	
	МассивКодовМужскойРод.Добавить("861703");    // Свитер
	МассивКодовМужскойРод.Добавить("861707");    // Топ
	МассивКодовМужскойРод.Добавить("000000203"); // Комплект    
	МассивКодовМужскойРод.Добавить("861817");    // Бомбер

	МассивКодовМужскойРод.Добавить("861684");    // Комбинезон
	МассивКодовМужскойРод.Добавить("103125");    // жилет	
	МассивКодовМужскойРод.Добавить("861684");    // Комбинезон (перемещён из женского рода)
	МассивКодовМужскойРод.Добавить("861740");    // Дождевик (перемещён из женского рода)
	МассивКодовМужскойРод.Добавить("861791");    // Костюм (перемещён из женского рода)
	МассивКодовМужскойРод.Добавить("000000258"); // Плащ

	// Женский род
	МассивКодовЖенскийРод = Новый Массив;
	МассивКодовЖенскийРод.Добавить("000000107"); // Двойка
	МассивКодовЖенскийРод.Добавить("000000108"); // Тройка
	МассивКодовЖенскийРод.Добавить("000000112"); // Куртка
	МассивКодовЖенскийРод.Добавить("000000257"); // Ветровка
	МассивКодовЖенскийРод.Добавить("003400046"); // Шуба
	МассивКодовЖенскийРод.Добавить("102675");    // Юбка
	МассивКодовЖенскийРод.Добавить("861704");    // Блузка
	МассивКодовЖенскийРод.Добавить("861705");    // Майка
	МассивКодовЖенскийРод.Добавить("861754");    // Парка
	МассивКодовЖенскийРод.Добавить("861801");    // Шапка
	МассивКодовЖенскийРод.Добавить("861712");    // Маска 
	МассивКодовЖенскийРод.Добавить("861752");    // Светлая куртка
	МассивКодовЖенскийРод.Добавить("861801");    // Шляпа
	МассивКодовЖенскийРод.Добавить("861811");    // Рубашка
	МассивКодовЖенскийРод.Добавить("861750");    // Двусторонняя куртка



	МассивКодовМножественных = Новый Массив;
	МассивКодовМножественных.Добавить("102655"); // Брюки (мн. число)
	МассивКодовМножественных.Добавить("131527"); // Шорты (мн. число)
	МассивКодовМножественных.Добавить("861706"); // Лосины (мн. число)
	МассивКодовМножественных.Добавить("861709"); // Юбка-шорты (мн. число)
	МассивКодовМножественных.Добавить("861793"); // Штаны (мн. число)
	МассивКодовМножественных.Добавить("000000259"); // Зуб (сомнительно)
	МассивКодовМножественных.Добавить("861810"); // Джинсы	
	МассивКодовМножественных.Добавить("861708");    // Кюлоты

	МассивКодовМножественных.Добавить("861812"); // с (ошибка?)
	МассивКодовМножественных.Добавить("861813"); // 1с (ошибка?)
    
    // Логика определения результата
    Результат = "";
    
    // Определяем сезон
    ЭтоЗима = (Сезон = ЗимаСезон);
	ЭтоЛето = (Сезон = ЛетоСезон);

    ЭтоДемисезон = (ДемисезонМассив.Найти(Сезон) <> Неопределено);
    
    // Определяем возрастную группу
    ЭтоДетская = (ВозрастнаяГруппаДетская.Найти(ВозрастнаяГруппа) <> Неопределено);
    ЭтоПодростковая = (ВозрастнаяГруппа = ВозрастнаяГруппаПодростковая);
    
    // Определяем род
    ЭтоМужскойРод = (МассивКодовМужскойРод.Найти(ТипИзделия) <> Неопределено);
    ЭтоЖенскийРод = (МассивКодовЖенскийРод.Найти(ТипИзделия) <> Неопределено);
	ЭтоМножественный = (МассивКодовМножественных.Найти(ТипИзделия) <> Неопределено);
	
	ЭтоПлатье = (ТипИзделия = "102685");

	Если ЭтоЕденичка Тогда
		Если ЭтоПлатье Тогда
			Возврат ПолучитьКлючИлиЗначение("[#483#]", ЭтоМаркетПлейс, Соответствия);
		КонецЕсли;
		
		Если ЭтоМужскойРод Тогда
			Возврат ПолучитьКлючИлиЗначение("[#380#]", ЭтоМаркетПлейс, Соответствия);
		ИначеЕсли ЭтоЖенскийРод Тогда
			Возврат ПолучитьКлючИлиЗначение("[#377#]", ЭтоМаркетПлейс, Соответствия);
		ИначеЕсли ЭтоМножественный Тогда
			Возврат ПолучитьКлючИлиЗначение("[#470#]", ЭтоМаркетПлейс, Соответствия);		
		КонецЕсли;
	КонецЕсли;
    
    // Формируем результат
    Если ЭтоЗима Тогда
        Если ЭтоДетская Тогда
			Если ЭтоМужскойРод Тогда
                	Результат = "[#381#] [#380#]"; //"Зимний детский";
			ИначеЕсли ЭтоЖенскийРод Тогда
				Если ЭтоАльт Тогда	
                	Результат = "[#374#] [#377#]"; // "Зимняя детская";
				Иначе
					Результат = "[#463#] [#465#]"; //"Зимнюю детскую";
				КонецЕсли;
			ИначеЕсли ЭтоМножественный Тогда				                               
				Результат = "[#469#] [#470#]";  //зимние детские			
            Иначе
                Результат = "[#375#] [#376#]"; // "Зимнее детское";
            КонецЕсли;
        ИначеЕсли ЭтоПодростковая Тогда
            Если ЭтоМужскойРод Тогда
                Результат = "[#381#] [#461#]"; // "Зимний подростковый";
			ИначеЕсли ЭтоЖенскийРод Тогда        				
				Если ЭтоАльт Тогда	
                	Результат = "[#374#] [#382#]"; // "Зимняя подростковая";
				Иначе
					Результат = "[#463#] [#464#]"; //"Зимнюю подростковую";
				КонецЕсли;
			ИначеЕсли ЭтоМножественный Тогда
				Результат = "[#469#] [#471#]"; //зимние подростковые
	        Иначе
                Результат = "[#375#] [#383#]"; // "Зимнее подростковое";
            КонецЕсли;
        КонецЕсли;
    ИначеЕсли ЭтоДемисезон Тогда
        Если ЭтоДетская Тогда
            Если ЭтоМужскойРод Тогда
                Результат = "[#458#] [#380#]"; // "Демисезонный детский";
			ИначеЕсли ЭтоЖенскийРод Тогда				
				Если ЭтоАльт Тогда	
                	 Результат = "[#459#] [#377#]"; // "Демисезонная детская";
				Иначе
					Результат = "[#462#] [#465#]"; //"Демисезонную детскую";
				КонецЕсли;	
			ИначеЕсли ЭтоМножественный Тогда			
				Результат = "[#468#] [#470#]"; //Демисезонные детские				
            Иначе
                Результат = "[#460#] [#376#]"; //"Демисезонное детское";
            КонецЕсли;
        ИначеЕсли ЭтоПодростковая Тогда
            Если ЭтоМужскойРод Тогда
                Результат = "[#458#] [#461#]"; //"Демисезонный подростковый";
			ИначеЕсли ЭтоЖенскийРод Тогда		
