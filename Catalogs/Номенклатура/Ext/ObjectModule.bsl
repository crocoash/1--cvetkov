Функция Наименование(РусЯзык= Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(РусЯзык) Тогда
		Если ЗначениеЗаполнено(Транслитирация) Тогда
			Возврат Транслитирация;
		Иначе
			Транслитирация = ОбщегоНазначения.Транслитерация(НаименованиеПолноеРус);	
			Записать();
		КонецЕсли;
		Возврат Транслитирация; 
	КонецЕсли;
	
	Если РусЯзык Тогда 
		НаименованиеРус = НаименованиеПолноеРус;
		Если Не ЗначениеЗаполнено(НаименованиеРус) Тогда
			НаименованиеРус = НаименованиеПолное;
			ОбщегоНазначения.ПеревестиНаРусский(НаименованиеРус);
			Возврат НаименованиеРус;
		Иначе 
			Возврат НаименованиеРус;
		КонецЕсли;
	Иначе 
		НаименованиеУкр = НаименованиеПолное;
		Если Не ЗначениеЗаполнено(НаименованиеУкр) Тогда
			НаименованиеУкр = НаименованиеПолноеРус;
			ОбщегоНазначения.ПеревестиНаУкраинский(НаименованиеУкр);
			Возврат НаименованиеУкр;
		Иначе
			ОбщегоНазначения.ПеревестиНаУкраинский(НаименованиеУкр);
		
			Возврат НаименованиеУкр;
		КонецЕсли;
	КонецЕсли;
	
КонецФункции

функция ПолучитьТипИзделия(РусЯзык = Истина) Экспорт

	ТипИзделия = ОбщегоНазначения.СвойстваОбъекта(Ссылка,"000000037");
	
	Если РусЯзык Тогда
		Возврат ТипИзделия.НаименованиеРус;
	Иначе
		Возврат ТипИзделия.Наименование;		 
	КонецЕсли;
	
КонецФункции

