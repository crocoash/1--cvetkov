////////////////////////////////////////////////////////////////////////////////
// Замеры номенклатуры в одном окне: строки - размеры, колонки - поля типа изделия.
//
// Колонки создаются на лету под набор полей, заданный типу изделия
// (регистр ПоляЗамеровПоТипамИзделия). Логика в общем модуле ЗамерыНоменклатуры.
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("Номенклатура") Тогда
		Номенклатура = Параметры.Номенклатура;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		СообщитьНаСервере("Форма замеров открывается для конкретной номенклатуры.");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Заголовок = "Замеры: " + Строка(Номенклатура);

	ЗаполнитьМатрицуНаСервере();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Заполнение и запись

&НаСервере
Процедура ЗаполнитьМатрицуНаСервере()

	Данные = ЗамерыНоменклатуры.МатрицаЗамеров(Номенклатура);
	ТипИзделия = Данные.ТипИзделия;

	// колонки прошлого набора полей убираем вместе с их элементами
	УдаляемыеРеквизиты = Новый Массив;
	Для Каждого Реквизит Из ПолучитьРеквизиты("ТабЗамеры") Цикл

		Если Реквизит.Имя = "Размер" ИЛИ Реквизит.Имя = "Полнота" Тогда
			Продолжить;
		КонецЕсли;

		УдаляемыеРеквизиты.Добавить("ТабЗамеры." + Реквизит.Имя);

		Элемент = Элементы.Найти(ИмяЭлементаКолонки(Реквизит.Имя));
		Если Элемент <> Неопределено Тогда
			Элементы.Удалить(Элемент);
		КонецЕсли;

	КонецЦикла;

	ДобавляемыеРеквизиты = Новый Массив;
	ОписаниеЗамера = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой));
	Для Каждого СтрПоле Из Данные.Поля Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(СтрПоле.ИмяКолонки, ОписаниеЗамера, "ТабЗамеры",
			ЗамерыНоменклатуры.ЗаголовокПоля(СтрПоле)));
	КонецЦикла;

	ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);

	Для Каждого СтрПоле Из Данные.Поля Цикл
		Элемент = Элементы.Добавить(ИмяЭлементаКолонки(СтрПоле.ИмяКолонки), Тип("ПолеФормы"), Элементы.ТабЗамеры);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = "ТабЗамеры." + СтрПоле.ИмяКолонки;
		Элемент.Заголовок = ЗамерыНоменклатуры.ЗаголовокПоля(СтрПоле);
		Элемент.Ширина = 8;
	КонецЦикла;

	ЗначениеВРеквизитФормы(Данные.Таблица, "ТабЗамеры");

	Элементы.ТабЗамерыПолнота.Видимость = ЕстьЗаполненнаяПолнота(Данные.Таблица);

	Если Данные.Поля.Количество() = 0 Тогда
		СообщитьНаСервере("Для типа изделия """ + Строка(ТипИзделия) + """ не задано ни одного поля замеров."
			+ " Добавьте их кнопкой ""Добавить поле"".");
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СообщитьНаСервере(Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяЭлементаКолонки(ИмяКолонки)

	Возврат "Кол" + ИмяКолонки;

КонецФункции

&НаСервереБезКонтекста
Функция ЕстьЗаполненнаяПолнота(Таблица)

	Для Каждого Стр Из Таблица Цикл
		Если НЕ ПустаяСтрока(Стр.Полнота) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

&НаСервере
Процедура ЗаписатьМатрицуНаСервере()

	Поля = ЗамерыНоменклатуры.ПоляМатрицы(ТипИзделия);
	Если Поля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗамерыНоменклатуры.ЗаписатьМатрицуЗамеров(Номенклатура, РеквизитФормыВЗначение("ТабЗамеры"), Поля);

	Модифицированность = Ложь;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Команды

&НаКлиенте
Процедура КомандаЗаписатьИЗакрыть(Команда)

	ЗаписатьМатрицуНаСервере();
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписать(Команда)

	ЗаписатьМатрицуНаСервере();
	ПоказатьОповещениеПользователя("Замеры записаны");

КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновить(Команда)

	ЗаполнитьМатрицуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура КомандаСклеитьДубли(Команда)

	ОткрытьФорму("Справочник.ПоляЗамеров.Форма.ФормаСклейки", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура КомандаПоляЗамеров(Команда)

	ОткрытьФорму("Справочник.ПоляЗамеров.ФормаСписка", , ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьИзМодели(Команда)

	Если НЕ ЗначениеЗаполнено(НоменклатураЗаполнения) Тогда
		ПоказатьПредупреждение(, "Укажите модель, из которой брать замеры.");
		Возврат;
	КонецЕсли;

	ЗаполнитьИзМоделиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзМоделиНаСервере()

	Поля = ЗамерыНоменклатуры.ПоляМатрицы(ТипИзделия);
	Значения = ЗамерыНоменклатуры.ЗамерыДляЗаполнения(НоменклатураЗаполнения);

	Подставлено = 0;
	Для Каждого СтрокаМатрицы Из ТабЗамеры Цикл
		Для Каждого СтрПоле Из Поля Цикл

			Значение = Значения.Получить(ЗамерыНоменклатуры.КлючЗаполнения(СтрокаМатрицы.Размер, СтрПоле.Поле));
			Если Значение = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			СтрокаМатрицы[СтрПоле.ИмяКолонки] = Значение;
			Подставлено = Подставлено + 1;

		КонецЦикла;
	КонецЦикла;

	Если Подставлено = 0 Тогда
		СообщитьНаСервере("У модели """ + Строка(НоменклатураЗаполнения) + """ нет замеров по этим размерам и полям.");
	Иначе
		СообщитьНаСервере("Подставлено значений: " + Подставлено + ". Проверьте и нажмите ""Записать"".");
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Набор полей типа изделия

// Поля добавляются и убираются через выбор в полях ввода шапки:
// команды панели зависели бы от текущей колонки, а она теряется при уходе фокуса.
&НаКлиенте
Процедура НовоеПолеПриИзменении(Элемент)

	Если НЕ ЗначениеЗаполнено(НовоеПоле) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ТипИзделия) Тогда
		НовоеПоле = ПредопределенноеЗначение("Справочник.ПоляЗамеров.ПустаяСсылка");
		ПоказатьПредупреждение(, "У номенклатуры не заполнено свойство ""Тип изделия"" - к чему привязывать поле, неизвестно.");
		Возврат;
	КонецЕсли;

	ДобавитьПолеНаСервере(НовоеПоле);
	НовоеПоле = ПредопределенноеЗначение("Справочник.ПоляЗамеров.ПустаяСсылка");

КонецПроцедуры

&НаСервере
Процедура ДобавитьПолеНаСервере(Знач Поле)

	ЗаписатьМатрицуНаСервере(); // введённое до появления новой колонки не теряем

	Поля = ЗамерыНоменклатуры.ПоляМатрицы(ТипИзделия);
	МаксПорядок = 0;
	Для Каждого СтрПоле Из Поля Цикл
		Если СтрПоле.Порядок > МаксПорядок Тогда
			МаксПорядок = СтрПоле.Порядок;
		КонецЕсли;
	КонецЦикла;

	Если НЕ Поля.Найти(Поле, "Поле") = Неопределено Тогда
		СообщитьНаСервере("Поле """ + Строка(Поле) + """ уже задано типу изделия """ + Строка(ТипИзделия) + """.");
		Возврат;
	КонецЕсли;

	ЗамерыНоменклатуры.ПривязатьПоле(ТипИзделия, Поле, Ложь, МаксПорядок + 10);

	ЗаполнитьМатрицуНаСервере();

	СообщитьНаСервере("Поле """ + Строка(Поле) + """ добавлено типу изделия """ + Строка(ТипИзделия)
		+ """ - колонка появится у всей номенклатуры этого типа.");

КонецПроцедуры

&НаКлиенте
Процедура УбираемоеПолеПриИзменении(Элемент)

	Если НЕ ЗначениеЗаполнено(УбираемоеПоле) Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВопросаУбратьПоле", ЭтотОбъект, УбираемоеПоле);
	ПоказатьВопрос(Оповещение,
		"Убрать поле """ + Строка(УбираемоеПоле) + """ из типа изделия """ + Строка(ТипИзделия) + """?
		|Колонка пропадёт у всей номенклатуры этого типа.
		|Само поле останется в справочнике, введённые замеры по нему - тоже.",
		РежимДиалогаВопрос.ДаНет);

	УбираемоеПоле = ПредопределенноеЗначение("Справочник.ПоляЗамеров.ПустаяСсылка");

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаУбратьПоле(Ответ, Поле) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	УбратьПолеНаСервере(Поле);

КонецПроцедуры

&НаСервере
Процедура УбратьПолеНаСервере(Знач Поле)

	Поля = ЗамерыНоменклатуры.ПоляМатрицы(ТипИзделия);
	Если Поля.Найти(Поле, "Поле") = Неопределено Тогда
		СообщитьНаСервере("Поле """ + Строка(Поле) + """ и так не задано типу изделия """ + Строка(ТипИзделия) + """.");
		Возврат;
	КонецЕсли;

	ЗаписатьМатрицуНаСервере();
	ЗамерыНоменклатуры.ОтвязатьПоле(ТипИзделия, Поле);
	ЗаполнитьМатрицуНаСервере();

	СообщитьНаСервере("Поле """ + Строка(Поле) + """ убрано из типа изделия """ + Строка(ТипИзделия) + """.");

КонецПроцедуры

&НаСервере
Функция ПолеТекущейКолонки(Знач ИмяЭлемента)

	Для Каждого СтрПоле Из ЗамерыНоменклатуры.ПоляМатрицы(ТипИзделия) Цикл
		Если ИмяЭлементаКолонки(СтрПоле.ИмяКолонки) = ИмяЭлемента Тогда
			Возврат СтрПоле;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Правка самого поля: названия, признак "в прайс", порядок колонок

&НаКлиенте
Процедура КомандаИзменитьПоле(Команда)

	ИмяЭлемента = ИмяКолонкиПоля();
	Если ПустаяСтрока(ИмяЭлемента) Тогда
		Возврат;
	КонецЕсли;

	Поле = СсылкаПоляКолонки(ИмяЭлемента);
	Если НЕ ЗначениеЗаполнено(Поле) Тогда
		Возврат;
	КонецЕсли;

	ЗначенияЗаполнения = Новый Структура("Ключ", Поле);
	ОткрытьФорму("Справочник.ПоляЗамеров.ФормаОбъекта", ЗначенияЗаполнения, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура КомандаВПрайс(Команда)

	ИмяЭлемента = ИмяКолонкиПоля();
	Если ПустаяСтрока(ИмяЭлемента) Тогда
		Возврат;
	КонецЕсли;

	ПереключитьВПрайсНаСервере(ИмяЭлемента);

КонецПроцедуры

&НаСервере
Процедура ПереключитьВПрайсНаСервере(Знач ИмяЭлемента)

	СтрокаПоля = ПолеТекущейКолонки(ИмяЭлемента);
	Если СтрокаПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Включено = ЗамерыНоменклатуры.ПереключитьВПрайс(ТипИзделия, СтрокаПоля.Поле);

	СообщитьНаСервере("Поле """ + СокрЛП(СтрокаПоля.Наименование) + """ "
		+ ?(Включено, "включено в прайс.", "убрано из прайса."));

КонецПроцедуры

&НаКлиенте
Процедура КомандаЛевее(Команда)

	СдвинутьТекущуюКолонку(-1);

КонецПроцедуры

&НаКлиенте
Процедура КомандаПравее(Команда)

	СдвинутьТекущуюКолонку(1);

КонецПроцедуры

&НаКлиенте
Процедура СдвинутьТекущуюКолонку(Сдвиг)

	ИмяЭлемента = ИмяКолонкиПоля();
	Если ПустаяСтрока(ИмяЭлемента) Тогда
		Возврат;
	КонецЕсли;

	СдвинутьПолеНаСервере(ИмяЭлемента, Сдвиг);

КонецПроцедуры

&НаСервере
Процедура СдвинутьПолеНаСервере(Знач ИмяЭлемента, Знач Сдвиг)

	СтрокаПоля = ПолеТекущейКолонки(ИмяЭлемента);
	Если СтрокаПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьМатрицуНаСервере();
	ЗамерыНоменклатуры.СдвинутьПоле(ТипИзделия, СтрокаПоля.Поле, Сдвиг);
	ЗаполнитьМатрицуНаСервере();

КонецПроцедуры

&НаСервере
Функция СсылкаПоляКолонки(Знач ИмяЭлемента)

	СтрокаПоля = ПолеТекущейКолонки(ИмяЭлемента);

	Возврат ?(СтрокаПоля = Неопределено, Неопределено, СтрокаПоля.Поле);

КонецФункции

// Активная колонка запоминается здесь, а не читается в момент нажатия кнопки:
// при нажатии фокус уходит из таблицы и ТекущийЭлемент уже не тот.
&НаКлиенте
Процедура ТабЗамерыПриАктивизацииПоля(Элемент)

	ТекущаяКолонка = Элементы.ТабЗамеры.ТекущийЭлемент;
	ИмяТекущейКолонки = ?(ТекущаяКолонка = Неопределено, "", ТекущаяКолонка.Имя);

КонецПроцедуры

// Имя элемента текущей колонки, если это колонка поля замера, иначе пустая строка.
&НаКлиенте
Функция ИмяКолонкиПоля()

	Если ПустаяСтрока(ИмяТекущейКолонки) Тогда
		ПоказатьПредупреждение(, "Сначала щёлкните по колонке нужного замера в таблице.");
		Возврат "";
	КонецЕсли;

	Если ИмяТекущейКолонки = "ТабЗамерыРазмер" ИЛИ ИмяТекущейКолонки = "ТабЗамерыПолнота" Тогда
		ПоказатьПредупреждение(, "Это служебная колонка. Щёлкните по колонке замера.");
		Возврат "";
	КонецЕсли;

	Возврат ИмяТекущейКолонки;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Разовый перенос старых данных

&НаКлиенте
Процедура КомандаПеренестиСтарыеДанные(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеВопросаПеренести", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Перенести старые замеры на справочник полей?
		|Названия из регистра ЗамерыПоля станут элементами справочника ПоляЗамеров,
		|а записи замеров получат ссылку на них.
		|Запускается один раз, повторный запуск ничего не портит.",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаПеренести(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Протокол = ПеренестиСтарыеДанныеНаСервере();
	ПоказатьПредупреждение(, Протокол);

КонецПроцедуры

&НаСервере
Функция ПеренестиСтарыеДанныеНаСервере()

	Протокол = ЗамерыНоменклатуры.ПеренестиСтарыеДанные();
	ЗаполнитьМатрицуНаСервере();

	Возврат Протокол;

КонецФункции
