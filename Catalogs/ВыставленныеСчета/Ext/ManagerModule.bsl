Процедура ОбновитьВсеСчетаИДокиРезерва() Экспорт
	
	// Полная очистка регистра: записи по контрагентам, у которых резервов уже нет,
	// иначе остались бы висеть и съедать лимиты банковских счетов.
	НаборЗаписей = РегистрыСведений.ВыставленныеСчетаКонтрагентов.СоздатьНаборЗаписей();
	НаборЗаписей.Записать();


	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Контрагент КАК Контрагент,
	               |	СУММА(ВЫБОР
	               |			КОГДА ТоварыВРезервеНаСкладахОстатки.Склад.СтатусГотовности = ""Виготовленно""
	               |				ТОГДА ТоварыВРезервеНаСкладахОстатки.КоличествоОстаток
	               |			ИНАЧЕ 0
	               |		КОНЕЦ) КАК КоличествоОстаток
	               |ИЗ
	               |	РегистрНакопления.ТоварыВРезервеНаСкладах.Остатки(, ) КАК ТоварыВРезервеНаСкладахОстатки
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТоварыВРезервеНаСкладахОстатки.ДокументРезерва.Контрагент
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КоличествоОстаток УБЫВ";
				   
	Контрагенты = Запрос.Выполнить().Выгрузить();
	Контрагенты.Свернуть("Контрагент");	
	
	Для Каждого Стр Из Контрагенты Цикл 
		//Биас.СформироватьФайлыPDFXMLРезервовВФоне(Стр.Контрагент); 
		
		СтруктураПараметров = Новый Структура;
	
		СтруктураПараметров.Вставить("Контрагент"        , Стр.Контрагент);
		СтруктураПараметров.Вставить("СуммаКорректировки", 0);
		
		//Биас.СформироватьФайлыPDFXMLРезервов(СтруктураПараметров) 
		Биас.СформироватьФайлыHTMLXMLРезервов(СтруктураПараметров);

	КонецЦикла;

	//Справочники.БанковскиеСчета.ПолучитьВыставленныйСчет(10000,)
КонецПроцедуры

// Разовая перегонка данных справочника в регистр ВыставленныеСчетаКонтрагентов.
//
// Запускается один раз после загрузки конфигурации, например из консоли:
//   Справочники.ВыставленныеСчета.ПеренестиДанныеВРегистр();
//
// Повторный запуск безопасен: регистр перезаписывается целиком. Дубли по одному
// контрагенту, накопившиеся в справочнике, сворачиваются в одну запись - берётся
// самая свежая по дате. Сам справочник не изменяется: он остаётся как архив.
//
Процедура ПеренестиДанныеВРегистр() Экспорт

	Запрос = Новый Запрос;

	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВыставленныеСчета.Контрагент КАК Контрагент,
	|	ВыставленныеСчета.БанковскийСчет КАК БанковскийСчет,
	|	ВыставленныеСчета.Сумма КАК Сумма,
	|	ВыставленныеСчета.Дата КАК Дата
	|ИЗ
	|	Справочник.ВыставленныеСчета КАК ВыставленныеСчета
	|ГДЕ
	|	НЕ ВыставленныеСчета.ПометкаУдаления
	|	И ВыставленныеСчета.Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";

	Выборка = Запрос.Выполнить().Выбрать();

	Перенесено = 0;

	Пока Выборка.Следующий() Цикл

		НаборЗаписей = РегистрыСведений.ВыставленныеСчетаКонтрагентов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Контрагент.Установить(Выборка.Контрагент);

		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);

		// Упорядочивание по дате плюс замещение набора по контрагенту оставляют
		// от дублей последнюю запись.
		НаборЗаписей.Записать();

		Перенесено = Перенесено + 1;

	КонецЦикла;

	Сообщить("Перенесено записей из справочника ВыставленныеСчета: " + Перенесено);

КонецПроцедуры
