Функция ЭтоГруппаДоговоров(Знач Договор)

	Возврат Договор.ЭтоГруппа;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ОСНОВНОЙ ДОГОВОР

// Перенос ПроверитьОсновнойДоговорКонтрагента с обычной формы: у нового контрагента
// должен быть договор, иначе по нему нельзя провести ни один документ. Договор
// создаётся уже после записи контрагента (раньше не на кого его повесить), поэтому
// карточку приходится дописывать вторым проходом.
//
&НаСервере
Процедура СоздатьОсновнойДоговорПриНеобходимости(ТекущийОбъект, Отказ)

	Если ЗначениеЗаполнено(ТекущийОбъект.ОсновнойДоговорКонтрагента) Тогда

		Возврат;

	КонецЕсли;

	ВыборкаДоговоров = Справочники.ДоговорыКонтрагентов.Выбрать( , ТекущийОбъект.Ссылка);

	Если ВыборкаДоговоров.Следующий() Тогда

		ТекущийОбъект.ОсновнойДоговорКонтрагента = ВыборкаДоговоров.Ссылка;
		ТекущийОбъект.Записать();
		Возврат;

	КонецЕсли;

	ТекущийПользователь = глЗначениеПеременной("глТекущийПользователь");

	Договор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();

	Договор.Наименование = "Основной договор";
	Договор.Владелец     = ТекущийОбъект.Ссылка;

	Договор.ВалютаВзаиморасчетов =
		УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ТекущийПользователь, "ОсновнаяВалютаВзаиморасчетов");

	Если НЕ ЗначениеЗаполнено(Договор.ВалютаВзаиморасчетов) Тогда

		Договор.ВалютаВзаиморасчетов = глЗначениеПеременной("ВалютаРегламентированногоУчета");

	КонецЕсли;

	Договор.УстановитьСхемуНалогообложения();

	Если ТекущийОбъект.НеЯвляетсяРезидентом Тогда

		Договор.Внешнеэкономический = Истина;

		Если Договор.ВалютаВзаиморасчетов = глЗначениеПеременной("ВалютаРегламентированногоУчета") Тогда

			Договор.ВалютаВзаиморасчетов = глЗначениеПеременной("ВалютаУправленческогоУчета");

		КонецЕсли;

	КонецЕсли;

	Договор.Организация = УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ТекущийПользователь, "ОсновнаяОрганизация");

	Если НЕ ЗначениеЗаполнено(Договор.Организация) Тогда

		Договор.Организация = ПерваяОрганизация();

		Если НЕ ЗначениеЗаполнено(Договор.Организация) Тогда

			ОбщегоНазначения.СообщитьОбОшибке(
				"Не удалось записать основной договор контрагента (не найдена организация).", Отказ);
			Возврат;

		КонецЕсли;

	КонецЕсли;

	Договор.ВидУсловийДоговора = Перечисления.ВидыУсловийДоговоровВзаиморасчетов.БезДополнительныхУсловий;

	Если ТекущийОбъект.Покупатель Тогда

		Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
		Договор.ТипЦен      = Справочники.ТипыЦенНоменклатуры.ПустаяСсылка();

	ИначеЕсли ТекущийОбъект.Поставщик Тогда

		Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		Договор.ТипЦен      = Справочники.ТипыЦенНоменклатурыКонтрагентов.ПустаяСсылка();

	Иначе

		Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее;

	КонецЕсли;

	Если Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее Тогда

		Договор.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом;

	Иначе

		Договор.ВедениеВзаиморасчетов =
			УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ТекущийПользователь, "ОсновноеВедениеВзаиморасчетовПоДоговорам");

		Если НЕ ЗначениеЗаполнено(Договор.ВедениеВзаиморасчетов) Тогда

			Договор.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом;

			Договор.ВестиПоДокументамРасчетовСКонтрагентом =
				УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ТекущийПользователь, "ОсновныеРасчетыПоДокументамСКонтрагентами");

		КонецЕсли;

	КонецЕсли;

	Если Договор.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоДоговоруВЦелом
		Или Договор.ВедениеВзаиморасчетов = Перечисления.ВедениеВзаиморасчетовПоДоговорам.ПоЗаказам Тогда

		Договор.ОбособленныйУчетТоваровПоЗаказамПокупателей =
			УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ТекущийПользователь, "ОсновнойОбособленныйУчетТоваровПоЗаказамПокупателей");

	КонецЕсли;

	Если Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда

		Договор.ПроцентПредоплаты =
			УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ТекущийПользователь, "ОсновнойРазмерПредоплатыПоЗаказуПокупателя");

	КонецЕсли;

	Договор.СложныйНалоговыйУчет =
		УправлениеПользователями.ПолучитьЗначениеПоУмолчанию(ТекущийПользователь, "ОсновноеЗначениеСложныйНалоговыйУчет");

	Если Договор.Внешнеэкономический Тогда

		Договор.СхемаНалоговогоУчета = Справочники.СхемыНалоговогоУчетаПоДоговорамКонтрагентов.ВЭД;

	Иначе

		Договор.СхемаНалоговогоУчета = Справочники.СхемыНалоговогоУчетаПоДоговорамКонтрагентов.ПоПервомуСобытию;

	КонецЕсли;

	Договор.СхемаНалоговогоУчетаПоТаре = Справочники.СхемыНалоговогоУчетаПоДоговорамКонтрагентов.ПоПервомуСобытию;

	Договор.ВыводитьИнформациюОСделкеПриПечатиДокументов = Истина;

	Попытка

		Договор.Записать();

	Исключение

		ОбщегоНазначения.СообщитьОбОшибке(ОписаниеОшибки(), Отказ, "Не удалось записать основной договор контрагента.");
		Возврат;

	КонецПопытки;

	ТекущийОбъект.ОсновнойДоговорКонтрагента = Договор.Ссылка;
	ТекущийОбъект.Записать();

КонецПроцедуры

&НаСервере
Функция ПерваяОрганизация()

	Запрос = Новый Запрос;

	Запрос.Текст =

		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации";

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда

		Возврат Выборка.Ссылка;

	КонецЕсли;

	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

////////////////////////////////////////////////////////////////////////////////
