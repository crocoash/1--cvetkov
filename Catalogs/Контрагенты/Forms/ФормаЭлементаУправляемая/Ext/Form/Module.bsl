////////////////////////////////////////////////////////////////////////////////
// СОБЫТИЯ

// Читает то же, что таблица событий обычной формы: документы Событие из регистра
// СобытияКалендаряПользователяОбобщенные плюс заказы, отгрузки и оплаты
// контрагента за период. Запрос перенесён из ОбновитьСобытия обычной формы
// без изменений.
//
&НаСервере
Процедура ОбновитьТаблицуСобытий(Знач Контрагент)

	ТабСобытия.Очистить();

	// ПриЧтенииНаСервере срабатывает раньше ПриСозданииНаСервере, поэтому период
	// по умолчанию ставится здесь: иначе первое чтение пошло бы без ограничения
	// по дате и подняло всю историю заказов, отгрузок и оплат контрагента.
	Если НЕ ЗначениеЗаполнено(КонПериода) Тогда

		КонПериода = НачалоДня(ТекущаяДатаСеанса());
		НачПериода = ДобавитьМесяц(КонПериода, -12);

	КонецЕсли;

	Если Контрагент.Пустая() Тогда

		Возврат;

	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст = "ВЫБРАТЬ
		|	СобытияКалендаряПользователяОбобщенные.Событие.Дата КАК Дата,
		|	СобытияКалендаряПользователяОбобщенные.Событие КАК Документ,
		|	СобытияКалендаряПользователяОбобщенные.ВидСобытия КАК ВидСобытия,
		|	СобытияКалендаряПользователяОбобщенные.Контрагент КАК Контрагент,
		|	СобытияКалендаряПользователяОбобщенные.КонтактноеЛицо КАК КонтактноеЛицо,
		|	СобытияКалендаряПользователяОбобщенные.ОписаниеСобытия КАК ОписаниеСобытия,
		|	СобытияКалендаряПользователяОбобщенные.Важность КАК Важность,
		|	СобытияКалендаряПользователяОбобщенные.СостояниеСобытия КАК СостояниеСобытия,
		|	"""" КАК ТипСобытия,
		|	СобытияКалендаряПользователяОбобщенные.Событие.СодержаниеСобытия КАК Содержание
		|ИЗ
		|	РегистрСведений.СобытияКалендаряПользователяОбобщенные КАК СобытияКалендаряПользователяОбобщенные
		|ГДЕ
		|	СобытияКалендаряПользователяОбобщенные.Контрагент = &Контрагент
		|	И (СобытияКалендаряПользователяОбобщенные.Событие.Дата >= &НачДата
		|			ИЛИ &НачДатаВыбран)
		|	И (СобытияКалендаряПользователяОбобщенные.Событие.Дата <= &КонДата
		|			ИЛИ &КонДатаВыбран)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказПокупателя.Дата,
		|	ЗаказПокупателя.Ссылка,
		|	NULL,
		|	ЗаказПокупателя.Контрагент,
		|	NULL,
		|	ЗаказПокупателя.Комментарий,
		|	NULL,
		|	NULL,
		|	""Заказ"",
		|	NULL
		|ИЗ
		|	Документ.ЗаказПокупателя КАК ЗаказПокупателя
		|ГДЕ
		|	ЗаказПокупателя.Контрагент = &Контрагент
		|	И (ЗаказПокупателя.Дата >= &НачДата
		|			ИЛИ &НачДатаВыбран)
		|	И (ЗаказПокупателя.Дата <= &КонДата
		|			ИЛИ &КонДатаВыбран)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Дата,
		|	РеализацияТоваровУслуг.Ссылка,
		|	NULL,
		|	РеализацияТоваровУслуг.Контрагент,
		|	NULL,
		|	РеализацияТоваровУслуг.Комментарий,
		|	NULL,
		|	NULL,
		|	""Отгрузка"",
		|	NULL
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.Контрагент = &Контрагент
		|	И (РеализацияТоваровУслуг.Дата >= &НачДата
		|			ИЛИ &НачДатаВыбран)
		|	И (РеализацияТоваровУслуг.Дата <= &КонДата
		|			ИЛИ &КонДатаВыбран)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПлатежноеПоручениеВходящее.Дата,
		|	ПлатежноеПоручениеВходящее.Ссылка,
		|	NULL,
		|	ПлатежноеПоручениеВходящее.Контрагент,
		|	NULL,
		|	ПлатежноеПоручениеВходящее.Комментарий,
		|	NULL,
		|	NULL,
		|	""Оплата"",
		|	NULL
		|ИЗ
		|	Документ.ПлатежноеПоручениеВходящее КАК ПлатежноеПоручениеВходящее
		|ГДЕ
		|	ПлатежноеПоручениеВходящее.Контрагент = &Контрагент
		|	И (ПлатежноеПоручениеВходящее.Дата >= &НачДата
		|			ИЛИ &НачДатаВыбран)
		|	И (ПлатежноеПоручениеВходящее.Дата <= &КонДата
		|			ИЛИ &КонДатаВыбран)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПриходныйКассовыйОрдер.Дата,
		|	ПриходныйКассовыйОрдер.Ссылка,
		|	NULL,
		|	ПриходныйКассовыйОрдер.Контрагент,
		|	NULL,
		|	ПриходныйКассовыйОрдер.Комментарий,
		|	NULL,
		|	NULL,
		|	""Оплата"",
		|	NULL
		|ИЗ
		|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
		|ГДЕ
		|	ПриходныйКассовыйОрдер.Контрагент = &Контрагент
		|	И (ПриходныйКассовыйОрдер.Дата >= &НачДата
		|			ИЛИ &НачДатаВыбран)
		|	И (ПриходныйКассовыйОрдер.Дата <= &КонДата
		|			ИЛИ &КонДатаВыбран)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата";

	Запрос.УстановитьПараметр("Контрагент",    Контрагент);
	Запрос.УстановитьПараметр("НачДата",       НачПериода);
	Запрос.УстановитьПараметр("НачдатаВыбран", НЕ ЗначениеЗаполнено(НачПериода));
	Запрос.УстановитьПараметр("КонДата",       КонецДня(КонПериода));
	Запрос.УстановитьПараметр("КонДатаВыбран", НЕ ЗначениеЗаполнено(КонПериода));

	Результат = Запрос.Выполнить().Выгрузить();
	Результат.Сортировать("Дата Убыв");

	// Ветки объединения по заказам, отгрузкам и оплатам подставляют NULL вместо
	// реквизитов события, а колонки таблицы формы типизированы - присваиваем поля
	// по одному, снимая NULL, иначе первая же строка заказа роняет форму.
	Для Каждого СтрокаРезультата Из Результат Цикл

		НоваяСтрока = ТабСобытия.Добавить();

		НоваяСтрока.Дата             = СтрокаРезультата.Дата;
		НоваяСтрока.Документ         = СтрокаРезультата.Документ;
		НоваяСтрока.КонтактноеЛицо   = БезNULL(СтрокаРезультата.КонтактноеЛицо);
		НоваяСтрока.Важность         = БезNULL(СтрокаРезультата.Важность);
		НоваяСтрока.СостояниеСобытия = БезNULL(СтрокаРезультата.СостояниеСобытия);
		НоваяСтрока.ОписаниеСобытия  = СокрЛП(БезNULL(СтрокаРезультата.ОписаниеСобытия, ""));
		НоваяСтрока.Содержание       = СтрЗаменить(СокрЛП(БезNULL(СтрокаРезультата.Содержание, "")), Символы.ПС, " ");

		// ВидСобытия у документа Событие - перечисление, у заказов и оплат его нет:
		// там подставляется тип строкой, поэтому колонка на форме строковая.
		ВидСтрокой = СокрЛП(Строка(БезNULL(СтрокаРезультата.ВидСобытия, "")));

		Если ПустаяСтрока(ВидСтрокой) Тогда

			ВидСтрокой = СокрЛП(БезNULL(СтрокаРезультата.ТипСобытия, ""));

		КонецЕсли;

		НоваяСтрока.ВидСобытия = ВидСтрокой;

	КонецЦикла;

КонецПроцедуры

// Значение из левого соединения запроса, приведённое к пригодному для записи в
// типизированную колонку таблицы формы.
//
// Параметры:
//  Значение            - Произвольный - что вернул запрос.
//  ЗначениеПоУмолчанию - Произвольный - чем заменить NULL.
//
// Возвращаемое значение:
//  Произвольный - значение без NULL.
//
&НаСервереБезКонтекста
Функция БезNULL(Знач Значение, Знач ЗначениеПоУмолчанию = Неопределено)

	Возврат ?(Значение = NULL, ЗначениеПоУмолчанию, Значение);

КонецФункции

&НаКлиенте
Процедура КомандаОбновитьСобытия(Команда)

	ОбновитьТаблицуСобытий(Объект.Ссылка);

КонецПроцедуры

&НаКлиенте
Процедура ТабСобытияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	КомандаОткрытьСобытие(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура КомандаОткрытьСобытие(Команда)

	ТекущиеДанные = Элементы.ТабСобытия.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда

		Возврат;

	КонецЕсли;

	ОткрытьОбъект(ТекущиеДанные.Документ);

КонецПроцедуры

// Вид события в обычной форме выбирал РаботаСДиалогами.ВыбратьВидНовогоСобытия -
// это клиент обычного приложения. Список перечисления собираем на сервере, выбор
// показываем сами, документ пишем и открываем по ссылке.
//
&НаКлиенте
Процедура КомандаНовоеСобытие(Команда)

	Если Объект.Ссылка.Пустая() Тогда

		Предупреждение("Сначала запишите контрагента - событие вводится по записанному элементу.");
		Возврат;

	КонецЕсли;

	Если Модифицированность И НЕ Записать() Тогда

		Возврат;

	КонецЕсли;

	ВыбранныйВид = ВидыСобытий().ВыбратьЭлемент("Выберите вид события");

	Если ВыбранныйВид = Неопределено Тогда

		Возврат;

	КонецЕсли;

	НовоеСобытие = СоздатьСобытие(Объект.Ссылка, ВыбранныйВид.Значение);

	Если НЕ ЗначениеЗаполнено(НовоеСобытие) Тогда

		Возврат;

	КонецЕсли;

	ОбновитьТаблицуСобытий(Объект.Ссылка);
	ОткрытьОбъект(НовоеСобытие);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ВидыСобытий()

	Список = Новый СписокЗначений;

	Для Каждого ВидСобытия Из Перечисления.ВидыСобытий Цикл

		Список.Добавить(ВидСобытия, Строка(ВидСобытия));

	КонецЦикла;

	Возврат Список;

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьСобытие(Знач Контрагент, Знач ВидСобытия)

	Событие = Документы.Событие.СоздатьДокумент();

	Событие.Дата           = ТекущаяДатаСеанса();
	Событие.ВидСобытия     = ВидСобытия;
	Событие.Контрагент     = Контрагент;
	Событие.КонтактноеЛицо = Контрагент.ОсновноеКонтактноеЛицо;
	Событие.ВидОбъекта     = Перечисления.ВидыОбъектовСобытия.Контрагент;
	Событие.НачалоСобытия  = ТекущаяДатаСеанса();

	Попытка

		Событие.Записать();

	Исключение

		ОбщегоНазначения.СообщитьОбОшибке(ОписаниеОшибки(), , "Событие не создано.");
		Возврат Неопределено;

	КонецПопытки;

	Возврат Событие.Ссылка;

КонецФункции

&НаКлиенте
Процедура КомандаУдалитьСобытие(Команда)

	ТекущиеДанные = Элементы.ТабСобытия.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено
		Или НЕ ЗначениеЗаполнено(ТекущиеДанные.Документ) Тогда

		Возврат;

	КонецЕсли;

	Если Вопрос("Удалить " + Строка(ТекущиеДанные.Документ) + "?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда

		Возврат;

	КонецЕсли;

	Если УдалитьДокумент(ТекущиеДанные.Документ) Тогда

		ОбновитьТаблицуСобытий(Объект.Ссылка);

	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция УдалитьДокумент(Знач Документ)

	Попытка

		Документ.ПолучитьОбъект().Удалить();

	Исключение

		ОбщегоНазначения.СообщитьОбОшибке(ОписаниеОшибки(), , "Документ не удалён.");
		Возврат Ложь;

	КонецПопытки;

	Возврат Истина;

КонецФункции

// Форма "Задачи и события" у справочника обычная, поэтому открываем её тем же
// способом, что и остальные обычные формы - см. ОткрытьСтаруюФорму.
//
&НаКлиенте
Процедура КомандаЗадачиИСобытия(Команда)

	ОткрытьСтаруюФорму("ЗадачиИСобытия",
		"Задачи и события открываются обычной формой справочника.");

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ЗВОНКИ

&НаКлиенте
Процедура КомандаЖурналЗвонков(Команда)

	Если Объект.Ссылка.Пустая() Тогда

		Предупреждение("Сначала запишите контрагента - журнал открывается по записанному элементу.");
		Возврат;

	КонецЕсли;

	ПараметрыФормы = Новый Структура("Контакт", Объект.Ссылка);

	ОткрытьФорму("Обработка.МИКО_стЖурналЗвонков.Форма", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СВОЙСТВА И КАТЕГОРИИ

// Обычная форма показывала свойства через расширение таблицы значений
// (Свойства.ПрочитатьЗаполнитьСвойстваИЗначения) - в управляемой форме такого
// расширения нет, поэтому читаем регистры напрямую.
//
// Набор свойств берём шире, чем обычная форма: и назначенные виду объекта
// (НазначениеСвойства = Справочник_Контрагенты), и назначенные конкретному
// контрагенту в регистре НазначенияСвойствОбъектов. Лишняя пустая строка
// безобиднее, чем спрятанное заполненное свойство.
//
&НаСервере
Процедура ПрочитатьСвойстваОбъекта(Знач Контрагент)

	Свойства.Очистить();

	Запрос = Новый Запрос;

	Запрос.Текст =

		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СвойстваОбъектов.Ссылка КАК Свойство
		|ПОМЕСТИТЬ ДоступныеСвойства
		|ИЗ
		|	ПланВидовХарактеристик.СвойстваОбъектов КАК СвойстваОбъектов
		|ГДЕ
		|	НЕ СвойстваОбъектов.ПометкаУдаления
		|	И НЕ СвойстваОбъектов.Категория
		|	И СвойстваОбъектов.НазначениеСвойства = &Назначение
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	НазначенияСвойствОбъектов.Свойство
		|ИЗ
		|	РегистрСведений.НазначенияСвойствОбъектов КАК НазначенияСвойствОбъектов
		|ГДЕ
		|	НазначенияСвойствОбъектов.Объект = &Объект
		|	И НЕ НазначенияСвойствОбъектов.Свойство.ПометкаУдаления
		|	И НЕ НазначенияСвойствОбъектов.Свойство.Категория
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДоступныеСвойства.Свойство КАК Свойство,
		|	ЗначенияСвойствОбъектов.Значение КАК Значение,
		|	ДоступныеСвойства.Свойство.ОбязательноеДляТовара КАК Обязательное
		|ИЗ
		|	ДоступныеСвойства КАК ДоступныеСвойства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|		ПО ДоступныеСвойства.Свойство = ЗначенияСвойствОбъектов.Свойство
		|			И ЗначенияСвойствОбъектов.Объект = &Объект
		|
		|УПОРЯДОЧИТЬ ПО
		|	Свойство";

	Запрос.УстановитьПараметр("Назначение",
		ПланыВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Справочник_Контрагенты);
	Запрос.УстановитьПараметр("Объект", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		НоваяСтрока = Свойства.Добавить();

		НоваяСтрока.Свойство     = Выборка.Свойство;
		НоваяСтрока.Обязательное = Выборка.Обязательное;
		// Значение приходит левым соединением: у незаполненного свойства там NULL.
		НоваяСтрока.Значение     = БезNULL(Выборка.Значение);

	КонецЦикла;

КонецПроцедуры

// Записываем только те свойства, что показаны на форме: у контрагента могут быть
// значения свойств другого назначения, и полная перезапись набора их бы стёрла.
//
&НаСервере
Процедура ЗаписатьСвойстваОбъекта(Знач Контрагент)

	Набор = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();

	Набор.Отбор.Объект.Значение      = Контрагент;
	Набор.Отбор.Объект.Использование = Истина;
	Набор.Прочитать();

	Таблица = Набор.Выгрузить();

	Для Каждого СтрокаТаблицы Из Свойства Цикл

		Найденные = Таблица.НайтиСтроки(Новый Структура("Свойство", СтрокаТаблицы.Свойство));

		Если ЗначениеЗаполнено(СтрокаТаблицы.Значение) Тогда

			Если Найденные.Количество() = 0 Тогда

				Запись = Таблица.Добавить();
				Запись.Объект   = Контрагент;
				Запись.Свойство = СтрокаТаблицы.Свойство;

			Иначе

				Запись = Найденные[0];

			КонецЕсли;

			Запись.Значение = СтрокаТаблицы.Значение;

		Иначе

			Для Каждого Лишняя Из Найденные Цикл

				Таблица.Удалить(Лишняя);

			КонецЦикла;

		КонецЕсли;

	КонецЦикла;

	Набор.Загрузить(Таблица);
	Набор.Записать();

КонецПроцедуры

&НаСервере
Процедура ПрочитатьКатегорииОбъекта(Знач Контрагент)

	Категории.Очистить();

	Запрос = Новый Запрос;

	Запрос.Текст =

		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КатегорииОбъектов.Ссылка КАК Категория,
		|	ВЫБОР
		|		КОГДА ЗначенияКатегорий.Категория ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Принадлежность
		|ИЗ
		|	Справочник.КатегорииОбъектов КАК КатегорииОбъектов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КатегорииОбъектов КАК ЗначенияКатегорий
		|		ПО КатегорииОбъектов.Ссылка = ЗначенияКатегорий.Категория
		|			И ЗначенияКатегорий.Объект = &Объект
		|ГДЕ
		|	НЕ КатегорииОбъектов.ПометкаУдаления
		|	И КатегорииОбъектов.НазначениеКатегории = &Назначение
		|
		|УПОРЯДОЧИТЬ ПО
		|	Категория";

	Запрос.УстановитьПараметр("Назначение",
		ПланыВидовХарактеристик.НазначенияСвойствКатегорийОбъектов.Справочник_Контрагенты);
	Запрос.УстановитьПараметр("Объект", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		НоваяСтрока = Категории.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьКатегорииОбъекта(Знач Контрагент)

	Набор = РегистрыСведений.КатегорииОбъектов.СоздатьНаборЗаписей();

	Набор.Отбор.Объект.Значение      = Контрагент;
	Набор.Отбор.Объект.Использование = Истина;
	Набор.Прочитать();

	Таблица = Набор.Выгрузить();

	Для Каждого СтрокаТаблицы Из Категории Цикл

		Найденные = Таблица.НайтиСтроки(Новый Структура("Категория", СтрокаТаблицы.Категория));

		Если СтрокаТаблицы.Принадлежность Тогда

			Если Найденные.Количество() = 0 Тогда

				Запись = Таблица.Добавить();
				Запись.Объект    = Контрагент;
				Запись.Категория = СтрокаТаблицы.Категория;

			КонецЕсли;

		Иначе

			Для Каждого Лишняя Из Найденные Цикл

				Таблица.Удалить(Лишняя);

			КонецЦикла;

		КонецЕсли;

	КонецЦикла;

	Набор.Загрузить(Таблица);
	Набор.Записать();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// КОНТРОЛЬ ПРОДАЖИ ЦЕНОВЫХ ГРУПП

&НаСервере
Процедура ПрочитатьЦеновыеГруппы(Знач Контрагент)

	ЦеновыеГруппы.Очистить();

	Запрос = Новый Запрос;

	Запрос.Текст =

		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЦеновыеГруппы.Ссылка КАК ЦеноваяГруппа,
		|	ВЫБОР
		|		КОГДА Контроль.ЦеноваяГруппа ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Монополия
		|ИЗ
		|	Справочник.ЦеновыеГруппы КАК ЦеновыеГруппы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтрольПродажиЦеновыхГруппПоРегионам КАК Контроль
		|		ПО ЦеновыеГруппы.Ссылка = Контроль.ЦеноваяГруппа
		|			И Контроль.Монополия = &Контрагент
		|ГДЕ
		|	НЕ ЦеновыеГруппы.ЭтоГруппа
		|	И НЕ ЦеновыеГруппы.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЦеноваяГруппа";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		НоваяСтрока = ЦеновыеГруппы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);

	КонецЦикла;

КонецПроцедуры

// Флажок пишется в регистр сразу, а не при записи карточки - так же, как в
// обычной форме: запись проверяет менеджер регистра, он и решает, можно ли
// назначить монополию.
//
&НаКлиенте
Процедура ЦеновыеГруппыМонополияПриИзменении(Элемент)

	ТекущиеДанные = Элементы.ЦеновыеГруппы.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда

		Возврат;

	КонецЕсли;

	ТекущиеДанные.Монополия = ПереключитьМонополию(
		Объект.Ссылка, ТекущиеДанные.ЦеноваяГруппа, ТекущиеДанные.Монополия);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПереключитьМонополию(Знач Контрагент, Знач ЦеноваяГруппа, Знач Включить)

	СтруктураЗаписи = Новый Структура("ЦеноваяГруппа, Монополия", ЦеноваяГруппа, Контрагент);

	Запись = РегистрыСведений.КонтрольПродажиЦеновыхГруппПоРегионам.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, СтруктураЗаписи);

	Если НЕ Включить Тогда

		Запись.Прочитать();

		Если Запись.Выбран() Тогда

			Запись.Удалить();

		КонецЕсли;

		Возврат Ложь;

	КонецЕсли;

	Отказ = Ложь;

	ТекстОшибки = РегистрыСведений.КонтрольПродажиЦеновыхГруппПоРегионам.ПроверитьЗапись(СтруктураЗаписи, Отказ);

	Если Отказ Тогда

		Сообщить(ТекстОшибки);
		Возврат Ложь;

	КонецЕсли;

	Запись.Записать();

	Возврат Истина;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// WEB-ДОСТУП

&НаСервере
Процедура ПрочитатьWEBДоступ(Знач Контрагент)

	РазрешенДоступКWEBЗаказам = Ложь;
	Логин                     = "";
	Пароль                    = "";
	ЛогинДо                   = "";

	Если Контрагент.Пустая() Тогда

		Возврат;

	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =

		"ВЫБРАТЬ
		|	УчетныеЗаписи.Логин КАК Логин,
		|	УчетныеЗаписи.Пароль КАК Пароль
		|ИЗ
		|	РегистрСведений.УчетныеЗаписиИнтернетПользователей КАК УчетныеЗаписи
		|ГДЕ
		|	УчетныеЗаписи.Контрагент = &Контрагент";

	Запрос.УстановитьПараметр("Контрагент", Контрагент);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда

		Логин                     = Выборка.Логин;
		Пароль                    = Выборка.Пароль;
		ЛогинДо                   = Выборка.Логин;
		РазрешенДоступКWEBЗаказам = Истина;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьWEBДоступ(ТекущийОбъект, Отказ)

	// Логин - измерение регистра: смена логина создаёт новую запись, старую
	// нужно удалить руками, иначе у контрагента останутся две учётные записи.
	Если ЗначениеЗаполнено(ЛогинДо)
		И (НЕ РазрешенДоступКWEBЗаказам Или ЛогинДо <> Логин) Тогда

		Старая = РегистрыСведений.УчетныеЗаписиИнтернетПользователей.СоздатьМенеджерЗаписи();
		Старая.Логин = ЛогинДо;
		Старая.Прочитать();

		Если Старая.Выбран() И Старая.Контрагент = ТекущийОбъект.Ссылка Тогда

			Старая.Удалить();

		КонецЕсли;

	КонецЕсли;

	Если НЕ РазрешенДоступКWEBЗаказам Тогда

		ЛогинДо = "";
		Возврат;

	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Логин) Тогда

		ОбщегоНазначения.СообщитьОбОшибке("Не заполнен логин WEB-доступа.", Отказ, "Элемент не записан.");
		Возврат;

	КонецЕсли;

	Запись = РегистрыСведений.УчетныеЗаписиИнтернетПользователей.СоздатьМенеджерЗаписи();

	Запись.Логин      = Логин;
	Запись.Пароль     = Пароль;
	Запись.Контрагент = ТекущийОбъект.Ссылка;

	Попытка

		Запись.Записать();

	Исключение

		ОбщегоНазначения.СообщитьОбОшибке(ОписаниеОшибки(), Отказ, "Элемент не записан.");
		Возврат;

	КонецПопытки;

	ЛогинДо = Логин;

КонецПроцедуры

&НаКлиенте
Процедура РазрешенДоступКWEBЗаказамПриИзменении(Элемент)

	Если РазрешенДоступКWEBЗаказам Тогда

		Если ПустаяСтрока(Логин) Тогда

			Логин = СокрЛП(Объект.Код);

		КонецЕсли;

		Если ПустаяСтрока(Пароль) Тогда

			Пароль = СгенерироватьПароль();

		КонецЕсли;

	КонецЕсли;

	НастроитьЭлементы();

КонецПроцедуры

&НаКлиенте
Процедура КомандаСгенерироватьПароль(Команда)

	Пароль = СгенерироватьПароль();

КонецПроцедуры

&НаСервереБезКонтекста
Функция СгенерироватьПароль()

	Возврат УправлениеПользователями.СгенерироватьПароль();

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ОБЫЧНЫЕ ФОРМЫ, ПЕЧАТЬ И ОТЧЁТЫ

// Печать через УниверсальныеМеханизмы (Новый Действие), отчёты на
// УниверсальныйОтчет, электронные письма, файлы, поиск дублей и помощник ввода
// новых контрагентов - это код клиента обычного приложения: ни Отчеты.*, ни
// ПолучитьФорму() в клиенте управляемой формы не компилируются. Поэтому карточка
// умеет открыть саму себя в старой форме, где всё это на месте.
//
&НаКлиенте
Процедура КомандаСтараяКарточка(Команда)

	ОткрытьСтаруюФорму("ФормаЭлемента",
		"Печать, отчёты, письма, файлы и поиск дублей остались в обычной карточке.");

КонецПроцедуры

// Обычные формы из управляемой открываются только через Выполнить: имена
// ОткрытьЗначение и ПолучитьФорму в управляемом контексте не компилируются, но
// в толстом клиенте обычного приложения работают. Тот же приём используют
// управляемые формы МИКО в этой конфигурации.
//
&НаКлиенте
Процедура ОткрытьСтаруюФорму(Знач ИмяФормы, Знач Пояснение = "")

	Если Объект.Ссылка.Пустая() Тогда

		Предупреждение("Сначала запишите контрагента - обычная форма открывается по записанному элементу.");
		Возврат;

	КонецЕсли;

	Если Модифицированность И НЕ Записать() Тогда

		Возврат;

	КонецЕсли;

	Если НЕ ПустаяСтрока(Пояснение) Тогда

		Сообщить(Пояснение);

	КонецЕсли;

	Ссылка  = Объект.Ссылка;
	Открыто = Ложь;

	Попытка

		Выполнить("Ссылка.ПолучитьФорму(ИмяФормы).Открыть()");
		Открыто = Истина;

	Исключение

		Открыто = Ложь;

	КонецПопытки;

	Если НЕ Открыто Тогда

		Предупреждение("Не удалось открыть обычную форму """ + ИмяФормы + """ из управляемой карточки."
			+ " Откройте контрагента из списка старой формой.");

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбъект(Знач Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда

		Возврат;

	КонецЕсли;

	Открыто = Ложь;

	Попытка

		Выполнить("ОткрытьЗначение(Значение)");
		Открыто = Истина;

	Исключение

		Открыто = Ложь;

	КонецПопытки;

	Если НЕ Открыто Тогда

		Попытка

			Выполнить("ПоказатьЗначение(, Значение)");
			Открыто = Истина;

		Исключение

			Открыто = Ложь;

		КонецПопытки;

	КонецЕсли;

	Если НЕ Открыто Тогда

		Предупреждение("Не удалось открыть " + Строка(Значение) + ".");

	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// САЙТ

// Ссылка на страницу готовности заказов - то же, что СсылкаНаРезерв в модуле
// объекта. Буфер обмена живёт на клиенте, поэтому COM-объект создаётся здесь,
// а не в модуле объекта, который в управляемой форме исполняется на сервере.
//
&НаКлиенте
Процедура КомандаСсылкаНаРезерв(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Код) Тогда

		Предупреждение("У контрагента нет кода - ссылку собрать не из чего.");
		Возврат;

	КонецЕсли;

	Текст = "За цим посиланням ви можете відслідковувати готовність ваших замовлень."
		+ Символы.ПС + "Інформація оновлюється автоматично ." + Символы.ПС + Символы.ПС + Символы.ПС
		+ "https://cvetkovtm.com/assets/shop/sync/reserves/invoice_" + СокрЛП(Объект.Код) + ".html";

	// Буфер обмена берётся через htmlfile, как в модуле объекта: клиент 1С здесь
	// только windows-овый, аналог под Unix не нужен.
	// BSLLS:UsingObjectNotAvailableUnix-off
	Попытка

		HTML = Новый COMОбъект("htmlfile");
		HTML.ParentWindow.ClipboardData.SetData("Text", Текст);

	Исключение

		Сообщить("Не удалось положить ссылку в буфер обмена: " + ОписаниеОшибки());
		Сообщить(Текст);

	КонецПопытки;
	// BSLLS:UsingObjectNotAvailableUnix-on

КонецПроцедуры

&НаКлиенте
Процедура КомандаУдалитьИсториюПокупок(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Код) Тогда

		Возврат;

	КонецЕсли;

	Если Вопрос("Удалить с сайта файлы истории покупок этого контрагента?", РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда

		Возврат;

	КонецЕсли;

	Сообщить(УдалитьИсториюПокупокНаСервере(Объект.Код));

КонецПроцедуры

// Перенос УдалитьИсториюНажатие обычной формы. Работа с FTP ушла на сервер:
// в управляемой форме константы читаются только там.
//
&НаСервереБезКонтекста
Функция УдалитьИсториюПокупокНаСервере(Знач Код)

	Протокол = "";

	Попытка

		Соединение = Новый FTPСоединение(
			Константы.ФТПСервер.Получить(), ,
			Константы.ФТПЛогин.Получить(),
			Константы.ФТППароль.Получить(), , Истина, 120);

	Исключение

		Возврат "Не удалось установить соединение с FTP-сервером: " + ОписаниеОшибки();

	КонецПопытки;

	ПутьККаталогу = "/cvetkovtm.com/www/assets/shop/sync/buy-history/" + СокрЛП(Код);

	Попытка

		Соединение.УстановитьТекущийКаталог(ПутьККаталогу);

	Исключение

		Возврат "Не удалось установить текущий каталог на FTP-сервере: " + ОписаниеОшибки();

	КонецПопытки;

	Попытка

		СписокФайлов = Соединение.НайтиФайлы(ПутьККаталогу, "*.*");

	Исключение

		Возврат "Не удалось получить список файлов: " + ОписаниеОшибки();

	КонецПопытки;

	Для Каждого Файл Из СписокФайлов Цикл

		Попытка

			Соединение.Удалить(Файл.ПолноеИмя);

		Исключение

			Протокол = Протокол + "Не удалось удалить файл " + Файл.ПолноеИмя + ": " + ОписаниеОшибки() + Символы.ПС;

		КонецПопытки;

	КонецЦикла;

	Возврат Протокол + "Все файлы удалены из " + ПутьККаталогу;

КонецФункции
