&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Помеченные на удаление отделения в выборе только мешают: по одному запросу в поиске
	// выпадали два "Відділення №3" - работающее и давно закрытое.
	//
	// ВНИМАНИЕ. Пометку в этом справочнике ставит загрузчик Новой Почты, а не человек, и
	// на 20.08.2026 она стояла примерно на 1 600 живых отделениях: загрузчик получал список
	// не целиком. Режим отображения оставлен обычным (по умолчанию): отбор виден в
	// "Все действия - Настроить список" и снимается руками, если отделение не находится.
	Для Каждого ТекЭлемент Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(ТекЭлемент) = Тип("ЭлементОтбораКомпоновкиДанных")
			И ТекЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПометкаУдаления") Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;
	ЭлементОтбора.Использование = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПоискАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	ТекЭлементОтбораНаим = Неопределено;
	ДЛя Каждого ТекЭлементОтбора Из Список.Отбор.Элементы Цикл
		Если ТекЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка") Тогда
			ТекЭлементОтбораНаим = ТекЭлементОтбора;
		КонецЕсли;	
	КонецЦикла; 	
	Если ТекЭлементОтбораНаим = Неопределено ТОгда
		ТекЭлементОтбораНаим = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ТекЭлементОтбораНаим.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	КонецЕсли;	
	ТекЭлементОтбораНаим.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Сп = Новый СписокЗначений;
	Сп.ЗагрузитьЗначения(ПолучитьМассивСсылок(Текст));
	ТекЭлементОтбораНаим.ПравоеЗначение = Сп;
	ТекЭлементОтбораНаим.Использование = истина;

КонецПроцедуры

&НаСервере
Функция ПолучитьМассивСсылок(Текст)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛМ_Отделения.Ссылка
	|ИЗ
	|	Справочник.ЛМ_Отделения КАК ЛМ_Отделения
	|ГДЕ
	|	НЕ ЛМ_Отделения.ПометкаУдаления
	|	И (ЛМ_Отделения.Наименование ПОДОБНО &Наименование
	|		ИЛИ ЛМ_Отделения.Наименование ПОДОБНО &Наименование_)";
	Запрос.УстановитьПараметр("Наименование", ВРег(Лев(Текст, 1)) + НРег(Сред(Текст,2)) + "%");
	Запрос.УстановитьПараметр("Наименование_", "%[ -.]" + ВРег(Лев(Текст, 1)) + НРег(Сред(Текст,2)) + "%");
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции	

