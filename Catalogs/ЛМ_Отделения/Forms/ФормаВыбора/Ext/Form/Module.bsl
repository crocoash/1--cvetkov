	ТекЭлементОтбораНаим.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Сп = Новый СписокЗначений;
	Сп.ЗагрузитьЗначения(ПолучитьМассивСсылок(Поиск));
	ТекЭлементОтбораНаим.ПравоеЗначение = Сп;
