////////////////////////////////////////////////////////////////////////////////
// Склейка полей-дублей: замеры и привязки к типам изделия переезжают
// на оставляемое поле, дубль помечается на удаление.
//
// Логика в общем модуле ЗамерыНоменклатуры.СклеитьПоля.
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Процедура КомандаПроверить(Команда)

	Если НЕ ПоляЗаданы() Тогда
		Возврат;
	КонецЕсли;

	Протокол = СклеитьНаСервере(Истина);

КонецПроцедуры

&НаКлиенте
Процедура КомандаСклеить(Команда)

	Если НЕ ПоляЗаданы() Тогда
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеВопросаСклеить", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Склеить поле """ + Строка(Дубль) + """ с полем """ + Строка(Основное) + """?
		|Замеры по первому полю перейдут на второе, само оно будет помечено на удаление.
		|Если по одному размеру заполнены оба поля, останется значение того, которое оставляем.",
		РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаСклеить(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Протокол = СклеитьНаСервере(Ложь);
	Дубль = ПредопределенноеЗначение("Справочник.ПоляЗамеров.ПустаяСсылка");

КонецПроцедуры

&НаКлиенте
Функция ПоляЗаданы()

	Если НЕ ЗначениеЗаполнено(Дубль) ИЛИ НЕ ЗначениеЗаполнено(Основное) Тогда
		ПоказатьПредупреждение(, "Укажите оба поля: какое убираем и какое оставляем.");
		Возврат Ложь;
	КонецЕсли;

	Если Дубль = Основное Тогда
		ПоказатьПредупреждение(, "Это одно и то же поле.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция СклеитьНаСервереБезКонтекста(Дубль, Основное, ТолькоПроверка)

	Возврат ЗамерыНоменклатуры.СклеитьПоля(Дубль, Основное, ТолькоПроверка);

КонецФункции

&НаКлиенте
Функция СклеитьНаСервере(ТолькоПроверка)

	Возврат СклеитьНаСервереБезКонтекста(Дубль, Основное, ТолькоПроверка);

КонецФункции
