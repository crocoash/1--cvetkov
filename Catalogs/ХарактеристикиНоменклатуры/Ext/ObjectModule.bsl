		 ЗначениеОбъект.Транслитирация = ОбщегоНазначения.Транслитерация(Значение.НаименованиеРус);
		 ЗначениеОбъект.Записать();
		 ЦветТранс = ЗначениеОбъект.Транслитирация;		 
	 КонецЕсли;
	 
	 НоменклатураТранс = Владелец.Транслитирация;
	 
	 Если НоменклатураТранс = "" Тогда 
		ВладелецОбъект = Владелец.ПолучитьОбъект();
		ВладелецОбъект.Транслитирация = ОбщегоНазначения.Транслитерация(Владелец.НаименованиеПолноеРус);
		ВладелецОбъект.Записать();
		НоменклатураТранс = ВладелецОбъект.Транслитирация;
     КонецЕсли;

	Возврат "https://cvetkovtm.com/ua/" + НоменклатураТранс + "-" + ЦветТранс + "-" + Владелец.ПолучитьОбъект().КодБезНоликов() + "/?opt&calc";
	
