Функция ПолучитьКоличествоКВыгрузкеСУчетомРазбитияРостовкок(ОстатокПоВсемСкладам = Неопределено, ГруппаСкладов = Неопределено) Экспорт
		

	Ростовка = ПолучитьРостовку(Истина);	
	
	Группа = ?(ГруппаСкладов=Неопределено,Справочники.Склады.НайтиПоКоду("000000053"),ГруппаСкладов); //Наши склады + реализация                
	МассивСкладов = Справочники.Склады.ПолучитьМассивСкладов(Группа); 
			
	Остаток = СвободныйОстаток(МассивСкладов);
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Характеристика");
	ТЗ.Колонки.Добавить("Остаток");
	ТЗ.Колонки.Добавить("Доступна");
	ОстатокРозница = 0;
	
	Если Ростовка <> Неопределено Тогда
		
		Для Каждого Стр Из Ростовка.Характеристики Цикл
			Характеристика = Стр.Характеристика;
			ХарактеристикаиОбъект = Характеристика.ПолучитьОбъект();
						
			Остаток = ХарактеристикаиОбъект.СвободныйОстаток(МассивСкладов);
														   
			НС = ТЗ.Добавить();
			НС.Характеристика = Характеристика;
			НС.Остаток = Остаток;//?(Остаток<0,0,Остаток);

			////// Розница
			//Если Характеристика = Ссылка Тогда
			//	Реализация = Справочники.Склады.НайтиПоКоду("000000037"); // Группа Реализация 
			//	МассРеализация = Справочники.Склады.ПолучитьМассивСкладов(Реализация);
			//
			//	ОстатокРозница = ХарактеристикаиОбъект.СвободныйОстаток(МассРеализация);
			//КонецЕсли;
						
		КонецЦикла;
		
		Мин = 1000; Макс = 0;
		Для Каждого Стр Из ТЗ Цикл
			Если Стр.Остаток > Макс Тогда
				Макс = Стр.Остаток;
			КонецЕсли;
			Если Стр.Остаток < Мин Тогда
				Мин = Стр.Остаток;
			КонецЕсли;
		КонецЦикла;
		
		МожноРаспаковатьРостовок = Ростовка.РаспаковатьРостовок;  // можно ли распаковать ростовки?
		Для Каждого Стр Из ТЗ Цикл
			Если НЕ Стр.Характеристика = Ссылка Тогда Продолжить; КонецЕсли;
			ММ = Макс-Мин;
			Если НЕ ((Макс-Мин)=0 И МожноРаспаковатьРостовок=0) И НЕ Мин<0 Тогда
				Если Мин=0 Тогда
					МВ = 0;
				ИначеЕсли Мин = Макс И МожноРаспаковатьРостовок>0 Тогда
					МВ = Мин-МожноРаспаковатьРостовок;
					Если МВ<0 Тогда
						МВ = 0;
					КонецЕсли;
				Иначе
					Если ММ>=МожноРаспаковатьРостовок Тогда
						МВ = Мин;
					Иначе
						МВ = Макс-МожноРаспаковатьРостовок; 
					КонецЕсли;
				КонецЕсли;
				
				//анализируем
				Если Стр.Остаток>МВ Тогда
					Возврат Стр.Остаток; //+ ОстатокРозница; // -МВ
				Иначе
					Возврат 0;// + ОстатокРозница;
				КонецЕсли;
			Иначе
				Возврат 0; //+ ОстатокРозница; 
			КонецЕсли;
		КонецЦикла;
	Иначе
		Попытка
			Возврат Остаток;
		Исключение
			Возврат 0;
		КонецПопытки;
	КонецЕсли;
	
КонецФункции

функция ПолучитьЦену(ТипЦены, Дата = Неопределено) Экспорт
	
	Дата = ?(Дата = Неопределено,ТекущаяДата(),Дата); 
	
	Если ЭтоНаборКомплектРучной() Тогда
			
		Цена = 0;
			
		Комлектующие = Комплектующие_НК();
			
		Для Каждого СтрокаТЗ Из Комлектующие Цикл
			
			ЦенаКомплекта = Ценообразование.ПолучитьЦенуНоменклатуры(СтрокаТЗ.Комплектующая, СтрокаТЗ.ХарактеристикаКомплектующей, ТипЦены, Дата);
			ЦенаКомплекта = ?(ЦенаКомплекта = Неопределено,0, ЦенаКомплекта);
			Цена = Цена + СтрокаТЗ.Количество * ЦенаКомплекта;
				
		КонецЦикла;
			
	Иначе
			
		Цена = Ценообразование.ПолучитьЦенуНоменклатуры(Владелец, Ссылка, ТипЦены, Дата);
			
	КонецЕсли;
	
	Возврат Цена;	
	
КонецФункции

функция ПолучитьЦенуПервую(ТипЦены, Наценка = Неопределено) Экспорт 
	
	Дата = ?(Дата = Неопределено,ТекущаяДата(),Дата);
	
	Если ЭтоНаборКомплектРучной() Тогда
			
		Цена = 0;
			
		Комлектующие = Комплектующие_НК();
			
		Для Каждого СтрокаТЗ Из Комлектующие Цикл
				
			Цена = Цена + СтрокаТЗ.Количество * Ценообразование.ПолучитьЦенуНоменклатуры(СтрокаТЗ.Комплектующая, СтрокаТЗ.ХарактеристикаКомплектующей, ТипЦены, Дата,,,,,,,,Истина);
				
		КонецЦикла;
			
	Иначе
			
		Цена = Ценообразование.ПолучитьЦенуНоменклатуры(Владелец, Ссылка, ТипЦены, Дата,,,,,,,,Истина, Наценка);
			
	КонецЕсли;
	
	Возврат ?(Цена = 0,1,Цена);	
