	ПараметрыОтбора.Вставить("Код"           , Владелец.Код);
	ПараметрыОтбора.Вставить("Цвет"          , ЦветХарактеристики());
	ПараметрыОтбора.Вставить("Ткань"         , ОбщегоНазначения.ТканьХарактеристики(Ссылка));
	ПараметрыОтбора.Вставить("Подкладка"     , ОбщегоНазначения.ПодкладкаХарактеристики(Ссылка));

	НайденныеСтроки = ТаблицаИДГрупп.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество()>0 Тогда
		Возврат Формат(НайденныеСтроки[0].ИД, "ЧГ=0");
	Иначе
	
		//Ссылка.ПолучитьОбъект().Записать();
		Записать();
		ТаблицаИДГрупп = Константы.ТаблицаИД.Получить().Получить();
		НайденныеСтроки = ТаблицаИДГрупп.НайтиСтроки(ПараметрыОтбора);

		Если НайденныеСтроки.Количество()>0 Тогда
			Возврат Формат(НайденныеСтроки[0].ИД, "ЧГ=0");
		Иначе
			Возврат "";
		КонецЕсли
	КонецЕсли;	
	
