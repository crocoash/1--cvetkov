функция РазмерЕстьВКрое(Крой,ТекущийРазмер)
	
	Если Не ПустаяСтрока(Крой) Тогда
				
		Размеры = ИзСтрокиВМассив(Крой,",");
				
		Для Каждого Разм из Размеры Цикл	
			Если Разм = ТекущийРазмер Тогда
		          Возврат Истина;				  
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
КонецФункции


функция ПолучитьХарактеристикуДляПолученияДаты() Экспорт 
	
	СкладРезерва = Справочники.Склады.ПустаяСсылка();
	ХарКа        = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	
	СхемаОпт = Справочники.СхемыРезервирования.НайтиПоНаименованию("Опт");
	
	СтрНоменклатуры = Новый Структура;
	СтрНоменклатуры.Вставить("Номенклатура", Владелец);
	СтрНоменклатуры.Вставить("Количество", 1);
	СтрНоменклатуры.Вставить("ХарактеристикаНоменклатуры", ХарКа);

	Если ЭтоХарактеристикаРучнойНК() Тогда		
		Комплектующие = Комплектующие_НК();
		
		Для Каждого комплектущая Из Комплектующие Цикл			
			Хар = комплектущая.ХарактеристикаКомплектующей;
			СтрНоменклатуры.ХарактеристикаНоменклатуры = Хар;
			СтрНоменклатуры.Номенклатура = Хар.Владелец;
			СкладРезерва = ОбщегоНазначения.СкладРезерваПолучить(СтрНоменклатуры, СхемаОпт);
			Если СкладРезерва.Качество.Код <> "000000001" Тогда
				Возврат Хар;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;	
			
	Возврат Ссылка;

КонецФункции

Функция ПолучитьСкладРезерва(Опт) Экспорт 
	
	СкладРезерва = Справочники.Склады.ПустаяСсылка();
	ХарКа = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
	
	СхемаОпт = Справочники.СхемыРезервирования.НайтиПоНаименованию("Опт");
	СхемаРозн = Справочники.СхемыРезервирования.НайтиПоНаименованию("Розн");
	СхемаРезерва = ?(Опт, СхемаОпт, СхемаРозн);
	
	СтрНоменклатуры = Новый Структура;
	СтрНоменклатуры.Вставить("Номенклатура", Владелец);
	СтрНоменклатуры.Вставить("Количество", 1);
	СтрНоменклатуры.Вставить("ХарактеристикаНоменклатуры", ХарКа);

	Если ЭтоХарактеристикаРучнойНК() ИЛИ ЭтоХарактеристикаНК() Тогда		
		
		Комплектующие = Комплектующие_НК();
		
		// Проверяем, если хотя бы одна комплектующая не найдена/попала на плохой склад
		Для Каждого Комплектующая Из Комплектующие Цикл			
			
			ХарКа = Комплектующая.ХарактеристикаКомплектующей;
			
			СтрНоменклатуры.Номенклатура = ХарКа.Владелец;
			СтрНоменклатуры.ХарактеристикаНоменклатуры = ХарКа;
			
			СкладРезерва = ОбщегоНазначения.СкладРезерваПолучить(СтрНоменклатуры, СхемаРезерва);
			
			Если СкладРезерва = Неопределено
				ИЛИ СкладРезерва = Справочники.Склады.ПустаяСсылка()
				ИЛИ СкладРезерва.Код = "000000023" Тогда
				
				Возврат СкладРезерва;
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Проверяем качество складов комплектующих
		Для Каждого Комплектующая Из Комплектующие Цикл			
			
			ХарКа = Комплектующая.ХарактеристикаКомплектующей;
			
			СтрНоменклатуры.Номенклатура = ХарКа.Владелец;
			СтрНоменклатуры.ХарактеристикаНоменклатуры = ХарКа;
			
			СкладРезерва = ОбщегоНазначения.СкладРезерваПолучить(СтрНоменклатуры, СхемаРезерва);
			
			Если СкладРезерва = Неопределено
				ИЛИ СкладРезерва = Справочники.Склады.ПустаяСсылка()
				ИЛИ СкладРезерва.Качество.Код <> "000000001" Тогда
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе 
		
		ХарКа = Ссылка;
		
	КонецЕсли;	
	
	СтрНоменклатуры.Номенклатура = ХарКа.Владелец;
	СтрНоменклатуры.ХарактеристикаНоменклатуры = ХарКа;
	
	Возврат ОбщегоНазначения.СкладРезерваПолучить(СтрНоменклатуры, СхемаРезерва);		
	
КонецФункции

Функция ИзСтрокиВМассив(НачальнаяСтрока,Разделитель) экспорт
    
    СтрокаПреобразованнаяВМногострочныйТекст     = СтрЗаменить(НачальнаяСтрока,Разделитель,Символы.ПС);
    ТекстовыйДокументИзСтроки                    = Новый ТекстовыйДокумент;
    Результат                                    = Новый Массив;
    ТекстовыйДокументИзСтроки.УстановитьТекст(СтрокаПреобразованнаяВМногострочныйТекст);
    Для СчетчикСтрок = 1 по ТекстовыйДокументИзСтроки.КоличествоСтрок() цикл
        Результат.Добавить(СокрЛП(ТекстовыйДокументИзСтроки.ПолучитьСтроку(СчетчикСтрок)));
    КонецЦикла;
    Возврат Результат;
    
КонецФункции

Функция ЦветХарактеристики(РусЯзык = Ложь, ПереводитьНазвание = Ложь) Экспорт
	СвойствоЦвет = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду("000000069"); // Обычный цвет
	ТабСвойства = ОбщегоНазначения.СвойстваЗначенияНоменклатураЗн(СвойствоЦвет,Ссылка);
	
	ЦветС = ОбщегоНазначения.ПолучитьЗначениеСвойстваХаракетристики(ТабСвойства,Ссылка,РусЯзык,, ПереводитьНазвание);
	
	Если Не ЗначениеЗаполнено(ЦветС) Тогда
		СвойствоЦвет = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду("000000072"); //2Цвет школьная
		ТабСвойства = ОбщегоНазначения.СвойстваЗначенияНоменклатураЗн(СвойствоЦвет,Ссылка);

		ЦветС = ОбщегоНазначения.ПолучитьЗначениеСвойстваХаракетристики(ТабСвойства,Ссылка,Не РусЯзык,,ПереводитьНазвание);
	КонецЕсли;
	Возврат СокрЛП(ЦветС);
	
КонецФункции

