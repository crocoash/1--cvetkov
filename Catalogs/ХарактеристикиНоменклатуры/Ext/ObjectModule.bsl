Функция ПолучитьДиапазонИзготовления(Опт) Экспорт 
	
	Если ЭтоХарактеристикаНК() Тогда
		
		Комплектующие = Комплектующие_НК();
		
		СтруктураСроков = Новый Структура;
		СтруктураСроков.Вставить("ДатаПошиваНачало", Дата(1, 1, 1));
		СтруктураСроков.Вставить("ДатаПошиваКонец", Дата(1, 1, 1));
		
		Для Каждого Компл Из Комплектующие Цикл
			
			СтруктураСроков1 = Компл.ХарактеристикаКомплектующей
				.ПолучитьОбъект()
				.ПолучитьДатуИзготовления(Опт);
			
			Если ЗначениеЗаполнено(СтруктураСроков1) Тогда
				
				Если СтруктураСроков1.ДатаПошиваНачало > СтруктураСроков.ДатаПошиваНачало Тогда
					СтруктураСроков.ДатаПошиваНачало = СтруктураСроков1.ДатаПошиваНачало;
				КонецЕсли;
				
				Если СтруктураСроков1.ДатаПошиваКонец > СтруктураСроков.ДатаПошиваКонец Тогда
					СтруктураСроков.ДатаПошиваКонец = СтруктураСроков1.ДатаПошиваКонец;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтруктураСроков.ДатаПошиваНачало = Дата(1, 1, 1) Тогда
			Возврат "";
		КонецЕсли;
		
	Иначе 
		
		СтруктураСроков = ПолучитьДатуИзготовления(Опт);
		
		Если Не ЗначениеЗаполнено(СтруктураСроков) Тогда
			Возврат "";
		КонецЕсли;
		
	КонецЕсли;
	
	
	ДатаПошиваНачало = Формат(СтруктураСроков.ДатаПошиваНачало, "ДФ=dd.MM"); 
	ДатаПошиваКонец = Формат(СтруктураСроков.ДатаПошиваКонец, "ДФ=dd.MM");
	
	Если ДатаПошиваНачало = ДатаПошиваКонец Тогда
		Возврат ДатаПошиваНачало;
	Иначе 
		Возврат ДатаПошиваНачало + " - " + ДатаПошиваКонец;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДатуИзготовления(Опт) Экспорт 
	
	Если Владелец.ВидНоменклатуры.Код = "000000010"  Тогда
		
		Комплектующие = Комплектующие_НК();
		
		СтруктураСроков = Новый Структура;
		
		СтруктураСроков.Вставить("ДатаПошиваНачало", Дата(1,1,1));
		
		СтруктураСроков.Вставить("ДатаПошиваКонец", Дата(1,1,1));
		
		Для Каждого Компл Из Комплектующие Цикл
			
			
			СтруктураСроков1 = Компл.ХарактеристикаКомплектующей
			.ПолучитьОбъект()
			.ПолучитьДатуИзготовления(Опт);
			
			Если СтруктураСроков1 <> Неопределено Тогда
				
				// максимальная дата начала
				Если СтруктураСроков1.ДатаПошиваНачало 
					> СтруктураСроков.ДатаПошиваНачало Тогда
					
					СтруктураСроков.ДатаПошиваНачало =
					СтруктураСроков1.ДатаПошиваНачало;
					
				КонецЕсли;
				
				
				// максимальная дата конца
				Если СтруктураСроков1.ДатаПошиваКонец 
					> СтруктураСроков.ДатаПошиваКонец Тогда
					
					СтруктураСроков.ДатаПошиваКонец =
					СтруктураСроков1.ДатаПошиваКонец;
					
				КонецЕсли;
				
			КонецЕсли;
			
			
		КонецЦикла;
		
		Возврат СтруктураСроков;
		
	Иначе
		
		Ростовка = ПолучитьРостовку(Истина);
		
		Если Ростовка = Неопределено Тогда 
			Возврат Неопределено;
		КонецЕсли; 
		
		Склад = ПолучитьСкладРезерва(Опт);
		Если (Склад <> Неопределено И (Склад.Код = "000000026" ИЛИ Склад.Код = "000000128")) Тогда
			Возврат ПолучитьДатуСНеПошит(); 
		Иначе	
			Если Ростовка.ИгнорироватьНоль Тогда
				Если ЗначениеЗаполнено(Ростовка.ДатаПошиваНачало) Тогда
					
					Попытка
						
						ДатаПошиваНачало = Ростовка.ДатаПошиваНачало;
						ДатаПошиваКонец  = Ростовка.ДатаПошиваКонец;
						
						Если Не ЗначениеЗаполнено(ДатаПошиваКонец) Тогда
							ДатаПошиваКонец = ДатаПошиваНачало;
						КонецЕсли;
						
						Если ДатаПошиваКонец < ДатаПошиваНачало Тогда
							
							ЗаписьЖурналаРегистрации(
							"Некоректний діапазон пошиву. Характеристика: "
							+ Ссылка.Наименование
							+ ". Початок: "
							+ Формат(ДатаПошиваНачало, "ДФ=dd.MM.yyyy")
							+ ", кінець: "
							+ Формат(ДатаПошиваКонец, "ДФ=dd.MM.yyyy"),
							УровеньЖурналаРегистрации.Ошибка
							);
							
							// Меняем даты местами.
							ВременнаяДата = ДатаПошиваНачало;
							ДатаПошиваНачало = ДатаПошиваКонец;
							ДатаПошиваКонец = ВременнаяДата;
							
						КонецЕсли;
						
						СтруктураСроков = Новый Структура;
						СтруктураСроков.Вставить(
						"ДатаПошиваНачало",
						ДатаПошиваНачало
						);
						СтруктураСроков.Вставить(
						"ДатаПошиваКонец",
						ДатаПошиваКонец
						);
						
					Исключение
						
						ЗаписьЖурналаРегистрации(
						ОписаниеОшибки() + " " + Ссылка.Наименование,
						УровеньЖурналаРегистрации.Ошибка
						);
						
						Возврат Неопределено;
						
					КонецПопытки;
					
					Возврат СтруктураСроков;
					
				Иначе
					
					Если ЭтоХарактеристикаРучнойНК() Тогда
						
						Комплектующие = Комплектующие_НК();
						
						Если Комплектующие.Количество() = 0 Тогда
							Возврат Неопределено;
						КонецЕсли;
						
						Номенклатура =
						Комплектующие[0]
						.ХарактеристикаКомплектующей
						.Владелец;
						
					Иначе
						
						Номенклатура = Владелец;
						
					КонецЕсли;
					
					Крой1 = Номенклатура.РазмерыНовогоКроя1;
					Крой2 = Номенклатура.РазмерыНовогоКроя2;
					ТекущийРазмер = ПолучитьРазмер();
					
					СрокИсполнения = Неопределено;
					
					Если РазмерЕстьВКрое(Крой1, ТекущийРазмер) Тогда
						
						СрокИсполнения = Номенклатура.СрокИсполнения1;
						
					ИначеЕсли РазмерЕстьВКрое(Крой2, ТекущийРазмер) Тогда
						
						СрокИсполнения = Номенклатура.СрокИсполнения2;
						
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(СрокИсполнения) Тогда
						Возврат Неопределено;
					КонецЕсли;
					
					Попытка
						
						СтруктураСроков = Новый Структура;
						СтруктураСроков.Вставить(
						"ДатаПошиваНачало",
						СрокИсполнения
						);
						СтруктураСроков.Вставить(
						"ДатаПошиваКонец",
						СрокИсполнения + 60 * 60 * 24 * 3
						);
						
					Исключение
						
						ЗаписьЖурналаРегистрации(
						ОписаниеОшибки() + " " + Ссылка.Наименование,
						УровеньЖурналаРегистрации.Ошибка
						);
						
						Возврат Неопределено;
						
					КонецПопытки;
					
					Возврат СтруктураСроков;
					
				КонецЕсли;				
			Иначе	
			КонецЕсли;
		КонецЕсли;  
	КонецЕсли;
	
КонецФункции      

Функция ПолучитьДатуСНеПошит() Экспорт
	
	Характеристика = ПолучитьХарактеристикуДляПолученияДаты();
	
	Если Не ЗначениеЗаполнено(Характеристика) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОтчетПроизводстваЗаСменуПродукция.ДатаПошиваНачало КАК ДатаПошиваНачало,
	|	ОтчетПроизводстваЗаСменуПродукция.ДатаПошиваКонец КАК ДатаПошиваКонец,
	|	ОтчетПроизводстваЗаСменуПродукция.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.ОтчетПроизводстваЗаСмену.Продукция КАК ОтчетПроизводстваЗаСменуПродукция
	|ГДЕ
	|	ОтчетПроизводстваЗаСменуПродукция.ХарактеристикаНоменклатуры =
	|		&ХарактеристикаНоменклатуры
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр(
		"ХарактеристикаНоменклатуры",
		Характеристика
	);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Не Результат.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДатаПошиваНачало = Результат.ДатаПошиваНачало;
	ДатаПошиваКонец  = Результат.ДатаПошиваКонец;
	
	Если Не ЗначениеЗаполнено(ДатаПошиваНачало)
		Или ДатаПошиваНачало = Дата(1, 1, 1) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	// У тебя было название "Плюс3", но фактически прибавлялось 2 дня.
	ТекущаяДатаПлюс3 =
		НачалоДня(ТекущаяДата())
		+ 60 * 60 * 24 * 3;
	
	Если ДатаПошиваНачало < ТекущаяДатаПлюс3 Тогда
		ДатаПошиваНачало = ТекущаяДатаПлюс3;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаПошиваКонец)
		Или ДатаПошиваКонец = Дата(1, 1, 1) Тогда
		
		ДатаПошиваКонец = ДатаПошиваНачало;
		
	ИначеЕсли ДатаПошиваКонец < ТекущаяДатаПлюс3 Тогда
		
		ДатаПошиваКонец = ТекущаяДатаПлюс3;
		
	КонецЕсли;
	
	// Ключевая защита: конец не может быть раньше начала.
	Если ДатаПошиваКонец < ДатаПошиваНачало Тогда
		
		ЗаписьЖурналаРегистрации(
			"Некоректний діапазон пошиву для характеристики "
			+ Строка(Характеристика)
			+ ". Початок: "
			+ Формат(ДатаПошиваНачало, "ДФ=dd.MM.yyyy")
			+ ", кінець: "
			+ Формат(ДатаПошиваКонец, "ДФ=dd.MM.yyyy")
			+ ". Дату завершення встановлено за датою початку.",
			УровеньЖурналаРегистрации.Предупреждение
		);
		
		ДатаПошиваКонец = ДатаПошиваНачало;
		
	КонецЕсли;
	
	Возврат Новый Структура(
		"ДатаПошиваНачало,ДатаПошиваКонец",
		ДатаПошиваНачало,
		ДатаПошиваКонец
	);
	
КонецФункции

