КонецФункции 


Функция ПолучитьРостовки(ПроверятьОсновную = Ложь) Экспорт
	Если ЭтоХарактеристикаНК() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =     "ВЫБРАТЬ
		                   |	ГруппыХарактеристикХарактеристики.Ссылка КАК Ссылка
		                   |ИЗ
		                   |	Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
		                   |ГДЕ
		                   |	(ГруппыХарактеристикХарактеристики.Ссылка.Владелец.Код = &Код
		                   |			ИЛИ ГруппыХарактеристикХарактеристики.Ссылка.Владелец.Код = &КодВладельца)
		                   |	И ГруппыХарактеристикХарактеристики.Ссылка.Наименование = &Наименование";
		
		Запрос.УстановитьПараметр("Код",Владелец.Нк);
		Запрос.УстановитьПараметр("КодВладельца",Владелец.ГруппаХарактеристик.Владелец.Код);
		Запрос.УстановитьПараметр("Наименование",Наименование);	
		
		Возврат Запрос.Выполнить().Выгрузить();	
		
	Иначе 
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ГруппыХарактеристикХарактеристики.Ссылка.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
		               |ГДЕ
		               |	ГруппыХарактеристикХарактеристики.Характеристика = &Характеристика"; 
					   
		Если ПроверятьОсновную Тогда  
			
			Запрос.Текст = Запрос.Текст + " 
				 |	И НЕ ГруппыХарактеристикХарактеристики.Ссылка.НеОсновная";  
		КонецЕсли;
		              		
		Запрос.УстановитьПараметр("Характеристика",Ссылка);
		
		Рез = Запрос.Выполнить().Выгрузить();  
		
		Если Рез.Количество() <> 0 Тогда
			Возврат Рез;	
		Иначе      
			Если ПроверятьОсновную Тогда
				Возврат ПолучитьРостовки();
			Иначе 
				Возврат Рез;  
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	

КонецФункции

Функция ПолучитьРостовку(ПроверятьОсновную = Ложь) Экспорт // группа характеристик
	
	Ростовки = ПолучитьРостовки(ПроверятьОсновную);	
	
	Если Ростовки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Ростовки.Количество() > 1 Тогда
		
		ИндексИгНоль = 0;
		ИндексГруппысИгНоль = 0;
		
		Для Каждого Ростовка Из Ростовки Цикл
			ИндексИгНоль = ИндексИгНоль + 1;
			
			Если Ростовка.Ссылка.ИгнорироватьНоль Тогда
				 ИндексГруппысИгНоль = ИндексИгНоль - 1; 			
			КонецЕсли;
		КонецЦикла;
		
		Если ИндексГруппысИгНоль <> 0 Тогда
			Возврат Ростовки[ИндексГруппысИгНоль].Ссылка;
		КонецЕсли;
		
		Индекс = 0;
		ИндексГруппы = 0;
		КолВоХарИк = 0;
				
		Для Каждого Ростовка Из Ростовки Цикл
			Индекс = Индекс + 1;
			Если КолВоХарИк = 0 Тогда
				КолВоХарИк = Ростовка.Ссылка.Характеристики.Количество();
			Иначе 
				Если КолВоХарИк > Ростовка.Ссылка.Характеристики.Количество() Тогда
					КолВоХарИк = Ростовка.Ссылка.Характеристики.Количество();
					ИндексГруппы = Индекс - 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
			
		Возврат Ростовки[ИндексГруппы].Ссылка;
	Иначе
		Возврат Ростовки[0].Ссылка;
	КонецЕсли;	
			
КонецФункции

