////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

// Обработчик события ПередЗаписью объекта.
//
Процедура ПередЗаписью(Отказ)

	Если НЕ ОбменДанными.Загрузка
	   И НЕ Владелец.ВестиУчетПоХарактеристикам Тогда
		//ОбщегоНазначения.СообщитьОбОшибке(
		//"Для номенклатуры """ + Владелец + """ не ведется учет по характеристикам.
		//|Характеристика """ + Наименование + """ не может быть записана.", 
		//Отказ);

	КонецЕсли;
	
	
	Если Не ЗначениеЗаполнено(ОбщегоНазначения.УбратьНоликиСлева(Код)) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	ХарактеристикиНоменклатуры.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
		               |ГДЕ
		               |	НЕ ХарактеристикиНоменклатуры.ПометкаУдаления
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ХарактеристикиНоменклатуры.Код УБЫВ";
		Рез = Запрос.Выполнить().Выбрать();
		
		Если Рез.Следующий() Тогда
			ПослКод= Число(Рез.Ссылка.Код);
		Иначе
			ПослКод = 0;
		КонецЕсли;
		ПослКод = ПослКод+1;
		Код = ОбщегоНазначения.ДополнитьНомерНулями(ОбщегоНазначения.НормальноеЧисло(ПослКод),9);
	КонецЕсли;
	

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
		
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("СвойстваИЗначения") Тогда
		
		ОбработкаОбъект = Обработки.ЗначенияСвойствОбъекта.Создать();
		
		ОбработкаОбъект.ОбъектОтбораЗначений = Ссылка;
		
		ОбработкаОбъект.СвойстваИЗначения.Загрузить(ЭтотОбъект.ДополнительныеСвойства.СвойстваИЗначения);
		
		Отказ = Не ОбработкаОбъект.ЗаписатьЗначенияСвойств();
	КонецЕсли;
	
	ТаблицаИДГрупп = Константы.ТаблицаИД.Получить().Получить();
	
	Если ТипЗнч(ТаблицаИДГрупп) <> Тип("ТаблицаЗначений") Тогда
		
		ТаблицаИДГрупп = Новый ТаблицаЗначений;
		
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	
	Если ЦветХарактеристики() = Неопределено Или
		 ЦветХарактеристики() = "" 
		Тогда
		 Возврат;
	КонецЕсли;
	
	ПараметрыОтбора.Вставить("Характеристика", Ссылка);
	ПараметрыОтбора.Вставить("Код"           , Ссылка.Владелец.Код);
	ПараметрыОтбора.Вставить("Цвет"          , ЦветХарактеристики());
	ПараметрыОтбора.Вставить("Ткань"         , ОбщегоНазначения.ТканьХарактеристики(Ссылка));
	ПараметрыОтбора.Вставить("Подкладка"     , ОбщегоНазначения.ПодкладкаХарактеристики(Ссылка));
	
	НайденныеСтроки = ТаблицаИДГрупп.НайтиСтроки(ПараметрыОтбора);

	Дубль = 3098;
	Дубль1 = 3096;
	
	 Если НайденныеСтроки.Количество() = 0 Тогда // Или Ид = Дубль Или Ид = Дубль1 Тогда //
				
		НайденныеСтроки = ТаблицаИДГрупп.НайтиСтроки(Новый Структура("Характеристика", Ссылка));
		
		Если НайденныеСтроки.Количество() = 0 Тогда                                                                   			
			СтрокаТЗ = ТаблицаИДГрупп.Добавить();
			
		Иначе
			
			СтрокаТЗ = НайденныеСтроки[0];
			
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТЗ, ПараметрыОтбора);
		
		СтрокаТЗ.Владелец = Ссылка.Владелец;
		
		ПараметрыОтбора.Удалить("Характеристика");
		
		НайденныеСтроки = ТаблицаИДГрупп.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() = 0 Или НайденныеСтроки[0].Цвет = "" Тогда
			
			Если ТаблицаИДГрупп.Количество() > 0 Тогда
				
				ТаблицаКопия = ТаблицаИДГрупп.Скопировать();
				
				ТаблицаКопия.Сортировать("ИД Убыв");
				
				СтрокаТЗ.ИД = ТаблицаКопия[0].ИД + 1;
				
			Иначе                                                                      
				
				СтрокаТЗ.ИД = 1;
				
			КонецЕсли;
			
		Иначе
			
			Если НайденныеСтроки[0].ИД = 0 Тогда // Или ИД = Дубль ИЛИ Ид = Дубль1 Тогда   
		
				
				Если ТаблицаИДГрупп.Количество() > 0 Тогда
					
					ТаблицаКопия = ТаблицаИДГрупп.Скопировать();
					
					ТаблицаКопия.Сортировать("ИД Убыв");
					
					ИД = ТаблицаКопия[0].ИД + 1;
					
				Иначе
					
					ИД = 1;
					
				КонецЕсли;
				
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					
					НайденнаяСтрока.ИД = ИД;
					
				КонецЦикла;
				
			КонецЕсли; //
			
			СтрокаТЗ.ИД = НайденныеСтроки[0].ИД;


		КонецЕсли;
		
		Константы.ТаблицаИД.Установить(Новый ХранилищеЗначения(ТаблицаИДГрупп));
	Иначе 
		
		//ТаблИД = НайденныеСтроки[0].ИД;

	КонецЕсли;   //
	
	
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ЭКСПОРТИРУЕМЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Функция устанавливает новое наименование характеристики по значениям свойств.
//
// Параметры:
//  КоллекцияЗначенийСвойств - коллекция значений, имеющая свойство Значение.
//
// Возвращаемое значение:
//  Строка - сформированное наименование.
//
Функция СформироватьНаименование(КоллекцияЗначенийСвойств) Экспорт

	Строка = "";

	Для каждого ЭлементКоллекции Из КоллекцияЗначенийСвойств Цикл
		
		Если ЗначениеЗаполнено(ЭлементКоллекции.Значение) Тогда
			
			Если ТипЗнч(ЭлементКоллекции.Значение) = Тип("Дата") Тогда
				
				Если ЭлементКоллекции.Свойство.ТипЗначения.КвалификаторыДаты.ЧастиДаты = ЧастиДаты.Дата Тогда
					Строка = Строка + Формат(ЭлементКоллекции.Значение, "ДФ=dd.MM.yyyy") + ", ";
				ИначеЕсли ЭлементКоллекции.Свойство.ТипЗначения.КвалификаторыДаты.ЧастиДаты = ЧастиДаты.Время Тогда
					Строка = Строка + Формат(ЭлементКоллекции.Значение, "ДФ=ЧЧ:мм:сс") + ", ";
				Иначе
					Строка = Строка + ЭлементКоллекции.Значение + ", ";
				КонецЕсли;
				
			Иначе
				
				Строка = Строка + ЭлементКоллекции.Значение + ", ";
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

	Строка = Лев(Строка, СтрДлина(Строка) - 2);

	Если ПустаяСтрока(Строка) Тогда
		Строка = "<Свойства не назначены>";
	КонецЕсли;

	Возврат Строка;

КонецФункции

функция ПолучитьКодыСвойств() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	СвойстваОбъектов.Код КАК Код
	|ИЗ
	|	ПланВидовХарактеристик.СвойстваОбъектов КАК СвойстваОбъектов
	|ГДЕ
	|	СвойстваОбъектов.НазначениеСвойства.Код = ""000000103"" ";
		
	Рез = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Код");
	
	Возврат Рез 
	
конецФункции

Функция СвободныйОстаток(Склад) Экспорт  
	Если ЭтоНаборКомплектРучной() Тогда  
		
		
		Склады = Новый Массив;
		Запрос = Новый Запрос(ОбщегоНазначения.ПолучитьЗапросДляНаборКомплект());   
		Запрос.УстановитьПараметр("НаДату"                           , ТекущаяДата());
		Запрос.УстановитьПараметр("Номенклатура"                     , Владелец);
		Запрос.УстановитьПараметр("ХарактеристикаНоменклатуры"       , Ссылка);
		Запрос.УстановитьПараметр("ХарактеристикаНоменклатурыВыбрана", СокрЛП(Ссылка) = "<без характеристики>");
		Запрос.УстановитьПараметр("Склад"                            , Склады);
		Запрос.УстановитьПараметр("СкладнеВыбран"                    , Истина);		
		Рез = Запрос.Выполнить().Выгрузить();
		
		Возврат Рез.Итог("Остаток");
	Иначе
		Возврат Остаток(Склад) - Резерв(Склад);	
	КОнецесли;
КонецФункции

Функция Остаток(Склад) Экспорт 
		
	Возврат ОбщегоНазначения.ОстатокНоменклатуры(Владелец, Склад, Ссылка, ТекущаяДата());
		
КонецФункции

