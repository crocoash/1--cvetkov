функция ПолучитьКодаЦвета() Экспорт 
	
	Структура = Новый Структура("colorPath, colorCode, color");
	
	ЦвХ = ПолучитьЗначениеЦвета();
	
	Если ТипЗнч(ЦвХ)= Тип("СправочникСсылка.АСБ_ЦветаНоменклатуры") Тогда
		Цв1 = ""; Цв2 = ""; ЦвФ1="";ЦвФ2="";
		Если ЦвХ.ТипЦвета1 = "RGB" Тогда
			Если (ЦвХ.Красный+ЦвХ.Зеленый+ЦвХ.Голубой)>0 Тогда
				Цв1 = ОбщегоНазначения.Код16(ЦвХ.Красный,ЦвХ.Зеленый,ЦвХ.Голубой);
			Иначе
				Цв1="#000000";
			КонецЕсли;
		ИначеЕсли   ЦвХ.ТипЦвета1 = "HEX" Тогда
			Если СокрЛП(ЦвХ.ЦветХекс) = "" Тогда
				Цв1 = "";
			Иначе
				Цв1 = "#"+ЦвХ.ЦветХекс;
			КонецЕсли;
		ИначеЕсли   ЦвХ.ТипЦвета1 = "RAL" Тогда
			Если ЗначениеЗаполнено(ЦвХ.Цвет.Код16) Тогда
				Цв1 = ЦвХ.Цвет.Код16;
			Иначе 
				Цв1 = "";
			КонецЕсли;
		Иначе
			Карт = ЦвХ.ЦветФайл.Получить();
			Если НЕ Карт = Неопределено Тогда
				ЦвФ1 = "http://cvetkovtm.com/assets/shop/sync/imgJpg/color"+ЦвХ.Код+"_1.jpg";
			Иначе
				ЦвФ1 = "";
			КонецЕсли;
		КонецЕсли;
		
		Если ЦвХ.ТипЦвета2 = "RGB" Тогда
			Если (ЦвХ.Красный1+ЦвХ.Зеленый1+ЦвХ.Голубой1)>0 Тогда
				Цв2 = ОбщегоНазначения.Код16(ЦвХ.Красный1,ЦвХ.Зеленый1,ЦвХ.Голубой1);
			Иначе
				Цв2="#000000";
			КонецЕсли;
		ИначеЕсли   ЦвХ.ТипЦвета2 = "HEX" Тогда
			Если СокрЛП(ЦвХ.ЦветХекс1) = "" Тогда
				Цв2 = "";
			Иначе
				Цв2 = "#"+ЦвХ.ЦветХекс1;
			КонецЕсли;
		ИначеЕсли   ЦвХ.ТипЦвета2 = "RAL" Тогда
			Если ЗначениеЗаполнено(ЦвХ.Цвет1.Код16) >0 Тогда
				Цв2 =  ЦвХ.Цвет1.Код16;
			Иначе 
				Цв2 = "";
			КонецЕсли;
		Иначе
			Карт = ЦвХ.ЦветФайл1.Получить();
			Если НЕ Карт = Неопределено Тогда
				ЦвФ2 = "http://cvetkovtm.com/assets/shop/sync/imgJpg/color"+ЦвХ.Код+"_2.jpg";
			Иначе
				ЦвФ2 = "";
			КонецЕсли;
		КонецЕсли;
		
		ИтЦв = "";
		Если НЕ СокрЛП(Цв1)="" Тогда
			ИтЦв = ИтЦв+Цв1;
		КонецЕсли;
		
		Если НЕ СокрЛП(Цв1)="" И НЕ СокрЛП(Цв2)=""  Тогда
			ИтЦв = ИтЦв+"|"+Цв2;
		КонецЕсли;
		
		Если СокрЛП(Цв1)="" И НЕ СокрЛП(Цв2)=""  Тогда
			ИтЦв = Цв2;
		КонецЕсли;
		
		Если  СокрЛП(ИтЦв) = "" Тогда  // просто RAL
			ИтЦв = ЦвХ.Цвет.Код16;
		КонецЕсли;
		
		Структура.colorCode = ИтЦв; 
		
		Если ЗначениеЗаполнено(ЦвФ1) Тогда
			Структура.colorPath = ЦвФ1;	
		КонецЕсли;
		Если ЗначениеЗаполнено(ЦвФ2) Тогда
			Структура.colorPath = ЦвФ2;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ЦвХ) = Тип("СправочникСсылка.ЗначенияСвойствОбъектов") И
		Не ПустаяСтрока(ЦвХ.КодЦвета) Тогда
			 Структура.colorCode = СокрЛП(ЦвХ.КодЦвета);
	КонецЕсли;
	
	Структура.color = СокрЛП(ЦвХ); 	
	
	Возврат Структура;
	
КонецФункции
