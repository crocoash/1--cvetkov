Функция ХарактеристикаРостовки() Экспорт 

	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ХарактеристикиНоменклатуры.Ссылка КАК Характеристика,
	               |	ВЫБОР
	               |		КОГДА основная.Ссылка ЕСТЬ NULL
	               |			ТОГДА неосновная.Ссылка
	               |		ИНАЧЕ основная.Ссылка
	               |	КОНЕЦ КАК Ростовка
	               |ПОМЕСТИТЬ ВТРостовка
	               |ИЗ
	               |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МАКСИМУМ(ГруппыХарактеристикХарактеристики.Ссылка) КАК Ссылка,
	               |			ГруппыХарактеристикХарактеристики.Характеристика КАК Характеристика
	               |		ИЗ
	               |			Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
	               |		ГДЕ
	               |			ГруппыХарактеристикХарактеристики.Ссылка.НеОсновная
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ГруппыХарактеристикХарактеристики.Характеристика) КАК неосновная
	               |		ПО ХарактеристикиНоменклатуры.Ссылка = неосновная.Характеристика
	               |		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			МАКСИМУМ(ГруппыХарактеристикХарактеристики.Ссылка) КАК Ссылка,
	               |			ГруппыХарактеристикХарактеристики.Характеристика КАК Характеристика
	               |		ИЗ
	               |			Справочник.ГруппыХарактеристик.Характеристики КАК ГруппыХарактеристикХарактеристики
	               |		ГДЕ
	               |			НЕ ГруппыХарактеристикХарактеристики.Ссылка.НеОсновная
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ГруппыХарактеристикХарактеристики.Характеристика) КАК основная
	               |		ПО ХарактеристикиНоменклатуры.Ссылка = основная.Характеристика
	               |ГДЕ
	               |	ХарактеристикиНоменклатуры.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПолучимХарактеристикуНк.Ссылка КАК ХарактеристикаНк
	               |ИЗ
	               |	Справочник.ХарактеристикиНоменклатуры КАК ХарактеристикиНоменклатуры
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТРостовка КАК ВТРостовка
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ХарактеристикиНоменклатуры КАК ПолучимХарактеристикуНк
	               |			ПО ВТРостовка.Ростовка.Наименование = ПолучимХарактеристикуНк.Наименование
	               |				И (ВТРостовка.Характеристика.Владелец.Код = ПолучимХарактеристикуНк.Владелец.Нк
	               |					ИЛИ ПолучимХарактеристикуНк.Владелец.ГруппаХарактеристик.Владелец = ВТРостовка.Характеристика.Владелец)
	               |		ПО ХарактеристикиНоменклатуры.Ссылка = ВТРостовка.Характеристика
	               |ГДЕ
	               |	ХарактеристикиНоменклатуры.Ссылка = &Ссылка";
	
	
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
        Возврат Выборка.ХарактеристикаНк; // вернём сразу ссылку
	КонецЕсли;
	Попытка
		Форма = ПолучитьРостовку().ПолучитьОбъект().ПолучитьФорму("ФормаЭлемента");
		Форма.Открыть();
	Исключение
	КонецПопытки;
		
    Возврат неопределено;
		
КонецФункции

функция ЭтоХарактеристикаНК() Экспорт
