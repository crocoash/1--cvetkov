	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДанные(Команда)
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		МИКО_стОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнено наименование линии!");
		Возврат;
	КонецЕсли; 
	
	ЗаписатьДанныеСервер();
	Оповестить("PT1C_NewOutLine", OutLine, ЭтаФорма);
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаСервере 
Процедура ЗаписатьДанныеСервер()

	Если ЗначениеЗаполнено(OutLine) Тогда
		врОбъект = OutLine.ПолучитьОбъект();	
	Иначе	
	    врОбъект = Справочники.МИКО_стУчетныеЗаписиАТС.СоздатьЭлемент();
	КонецЕсли; 

	ЗаполнитьЗначенияСвойств(врОбъект, ЭтаФорма);
	врОбъект.Записать();
	OutLine = врОбъект.Ссылка;
	
КонецПроцедуры

