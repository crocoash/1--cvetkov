// Карточка статуса заказа - управляемая форма элемента справочника СтатусыЗаказов.
//
// Перенесена с обычной формы (Forms/ФормаЭлемента, Form.bin) один в один по логике,
// изменилась только раскладка: правила разложены по страницам Основное / Документы /
// СМС / Телеграм / Задачи. Обычная форма из конфигурации не удалена - чтобы вернуться,
// достаточно переключить DefaultObjectForm в Catalogs/СтатусыЗаказов.xml обратно.
//
// Исполнитель задачи по просрочке статуса задаётся одним из трёх взаимно исключающих
// способов: конкретный пользователь (Пользователь1), группа пользователей
// (ЗадачаГруппеПользователей) или ответственный за заказ
// (ФормироватьЗадачуНаОтветственного). Читает их БИАС.ПроверкаЗадачь именно в этом
// порядке, поэтому заполненный вариант блокирует остальные - иначе два заполненных
// поля означали бы, что второе молча не работает.
//
// После записи исполнитель переставляется у уже созданных незакрытых задач
// (ПереназначитьЗадачиПросрочки): без этого смена ответственного в карточке статуса
// не доходила бы до задач, которые уже висят на прежнем человеке.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИсполнительПросрочкиПриОткрытии = ИсполнительПросрочки(Объект);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ИсполнительПросрочкиПриОткрытии = ИсполнительПросрочки(ТекущийОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	НастроитьЭлементы();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	ПереназначитьЗадачиПросрочки(ТекущийОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОтправлятьСМСПоШаблонуПриИзменении(Элемент)

	НастроитьЭлементы();

КонецПроцедуры

// Один способ выдачи задачи по просрочке исключает два других: заполнили поле -
// остальные очищаются и становятся недоступными.
//
&НаКлиенте
Процедура ИсполнительПросрочкиПриИзменении(Элемент)

	ПустойПользователь = ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка");

	Если ЗначениеЗаполнено(Объект.Пользователь1) Тогда

		Объект.ЗадачаГруппеПользователей         = ПустойПользователь;
		Объект.ФормироватьЗадачуНаОтветственного = Ложь;

	ИначеЕсли ЗначениеЗаполнено(Объект.ЗадачаГруппеПользователей) Тогда

		Объект.Пользователь1                     = ПустойПользователь;
		Объект.ФормироватьЗадачуНаОтветственного = Ложь;

	ИначеЕсли Объект.ФормироватьЗадачуНаОтветственного Тогда

		Объект.Пользователь1             = ПустойПользователь;
		Объект.ЗадачаГруппеПользователей = ПустойПользователь;

	КонецЕсли;

	НастроитьЭлементы();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьНовыеЧаты(Команда)

	Сообщить(НовыеЧатыБота());

КонецПроцедуры

&НаКлиенте
Процедура НастроитьЭлементы()

	Элементы.ШаблонСМС.Видимость = Объект.ОтправлятьСМСПоШаблону;

	Элементы.Пользователь1.Доступность =
		(Не ЗначениеЗаполнено(Объект.ЗадачаГруппеПользователей) И Не Объект.ФормироватьЗадачуНаОтветственного);

	Элементы.ЗадачаГруппеПользователей.Доступность =
		(Не ЗначениеЗаполнено(Объект.Пользователь1) И Не Объект.ФормироватьЗадачуНаОтветственного);

	Элементы.ФормироватьЗадачуНаОтветственного.Доступность =
		(Не ЗначениеЗаполнено(Объект.Пользователь1) И Не ЗначениеЗаполнено(Объект.ЗадачаГруппеПользователей));

КонецПроцедуры

// Кому уходит задача по просрочке статуса. Порядок проверок - как в БИАС.ПроверкаЗадачь.
//
// Параметры:
//  Статус - СправочникОбъект.СтатусыЗаказов - карточка статуса.
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи, Строка, Неопределено - пользователь или группа,
//  "НаОтветственного" для ответственного за заказ, Неопределено - задачу не выдаём.
//
&НаСервере
Функция ИсполнительПросрочки(Знач Статус)

	Если ЗначениеЗаполнено(Статус.Пользователь1) Тогда

		Возврат Статус.Пользователь1;

	ИначеЕсли ЗначениеЗаполнено(Статус.ЗадачаГруппеПользователей) Тогда

		Возврат Статус.ЗадачаГруппеПользователей;

	ИначеЕсли Статус.ФормироватьЗадачуНаОтветственного Тогда

		Возврат "НаОтветственного";

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Переставить исполнителя у незакрытых задач по просрочке этого статуса.
// "НаОтветственного" разворачивается в ответственного самого заказа, поэтому
// сравнивать приходится уже развёрнутые значения - иначе задача переписывалась бы
// каждый раз при записи карточки.
//
&НаСервере
Процедура ПереназначитьЗадачиПросрочки(ТекущийОбъект)

	Исполнитель = ИсполнительПросрочки(ТекущийОбъект);

	Если Не ЗначениеЗаполнено(Исполнитель)
		Или Исполнитель = ИсполнительПросрочкиПриОткрытии Тогда

		ИсполнительПросрочкиПриОткрытии = Исполнитель;
		Возврат;

	КонецЕсли;

	Запрос = Новый Запрос;

	Запрос.Текст =

		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗадачиПользователя.Ссылка КАК Ссылка,
		|	ЗадачиПользователя.Объект.Ответственный КАК Ответственный
		|ИЗ
		|	Задача.ЗадачиПользователя КАК ЗадачиПользователя
		|ГДЕ
		|	НЕ ЗадачиПользователя.Выполнена
		|	И ЗадачиПользователя.ИдентификаторСобытия = &Идентификатор";

	Запрос.УстановитьПараметр("Идентификатор", "ПросрочкаСтатуса_" + ТекущийОбъект.Код);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ИсполнительДо = ИсполнительПросрочкиПриОткрытии;

		Если ИсполнительПросрочкиПриОткрытии = "НаОтветственного" Тогда

			ИсполнительДо = Выборка.Ответственный;

		КонецЕсли;

		ИсполнительПосле = Исполнитель;

		Если Исполнитель = "НаОтветственного" Тогда

			ИсполнительПосле = Выборка.Ответственный;

		КонецЕсли;

		Если ИсполнительПосле = ИсполнительДо Тогда

			Продолжить;

		КонецЕсли;

		ЗадачаОбъект = Выборка.Ссылка.ПолучитьОбъект();

		ЗадачаОбъект.Исполнитель = ИсполнительПосле;

		ЗадачаОбъект.Записать();

	КонецЦикла;

	ИсполнительПросрочкиПриОткрытии = Исполнитель;

КонецПроцедуры

// Чаты, которые уже написали боту: их ID и вставляются в поля выше.
//
&НаСервереБезКонтекста
Функция НовыеЧатыБота()

	Возврат ТелеграмБот.ПоказатьНовыеЧаты();

КонецФункции
