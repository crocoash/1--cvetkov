Функция ПолучитьМассивСкладов(ГруппаСкладов) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Склады.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Склады КАК Склады
		|ГДЕ
		|	Склады.Ссылка В ИЕРАРХИИ(&ГруппаСкладов)
		|	И НЕ Склады.ПометкаУдаления
		|	И НЕ Склады.ЭтоГруппа";
	
	
	Запрос.УстановитьПараметр("ГруппаСкладов", ГруппаСкладов);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции


функция ПолучитьСтатус(этоОпт, Ссылка, Предзаказ) Экспорт 	
	
	НетСклада = (ссылка = Справочники.Склады.ПустаяСсылка() ИЛИ Ссылка = Неопределено);
	
	Если НетСклада И Предзаказ Тогда 
		Возврат "3";
	ИначеЕсли НетСклада Тогда 
		Возврат "0";
	КонецЕсли;
			
	// Качество склада, на котором лежит резерв, и есть источник статуса.
	// «Упакованный» и «Пошит»: вещь физически сшита и лежит на складе, а её
	// остаток и так уходит на сайт как доступный (ВТСкладыРозн - все активные
	// склады). Без «Пошит» размеры со складов «Выставка» и «Упакован» уезжали
	// со статусом 0, и сайт подписывал живой остаток «Немає на складі»
	// (ловилось на ШДП 27935: 1 шт на «Выставка», размер зелёный и в корзину
	// кладётся, а подпись - «немає»).
	//
	// «не готов» и «Крой» - это производство: «Не пошит», «Не Кроился», «Брак».
	// Крой добавлен сюда, чтобы такой остаток не падал в «прочее»: сайт
	// теперь при живом остатке считает «прочее» наличием.
	Если Ссылка.Качество = Справочники.Качество.НайтиПокоду("000000001")
		ИЛИ Ссылка.Качество = Справочники.Качество.НайтиПокоду("000000005") Тогда
		Возврат "1";
	ИначеЕсли Ссылка.Качество = Справочники.Качество.НайтиПокоду("000000002")
		ИЛИ Ссылка.Качество = Справочники.Качество.НайтиПокоду("000000006") Тогда
		Возврат "2";
	ИначеЕсли Предзаказ Тогда
		Возврат "3";
	Иначе
		Возврат "0";
	КонецЕсли;
					
	//Не в наявності 0
	//в    наявності 1
	//На виробництві 2	
	//Предзамовлення 3
КонецФункции

Функция ПолучитьСкладыОпт() Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |	Склады.Ссылка КАК Ссылка
        |ИЗ
        |	Справочник.Склады КАК Склады
        |ГДЕ
        |	Склады.Активный
        |	И НЕ Склады.Розница";
    
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции
 
