
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВидОбъекта		         = Параметры.ВидОбъекта;
	ОтображатьТабличныеЧасти = Параметры.ОтображатьТабличныеЧасти;
	Если Параметры.Свойство("ТипРеквизита") Тогда
		ТипРеквизита = Параметры.ТипРеквизита;
		ОтборПоТипу = Истина;
	КонецЕсли;
	
	ЗаполнитьРеквизитыОбъектаМетаданных(ВидОбъекта);
	
КонецПроцедуры // ПриСозданииНаСервере()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура РеквизитыОбъектаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элементы.РеквизитыОбъекта.ТекущиеДанные.ЭтоРеквизит Тогда
		
		РезультатВыбора = Новый Структура("Имя,Тип", 
			Элементы.РеквизитыОбъекта.ТекущиеДанные.ИмяРеквизита,
			Элементы.РеквизитыОбъекта.ТекущиеДанные.Тип,
		);
		ОповеститьОВыборе(РезультатВыбора);
		
	КонецЕсли;
	
КонецПроцедуры // РеквизитыОбъектаВыбор()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ


////////////////////////////////////////////////////////////////////////////////
// ПРОЧЕЕ

&НаСервере 
Процедура ЗаполнитьРеквизитыОбъектаМетаданных(ВидОбъекта)
	
	дзРеквизитыОбъекта = РеквизитФормыВЗначение("РеквизитыОбъекта");
	МетаданныеОбъекта  = Метаданные.Документы[ВидОбъекта];
	
	ВсеРеквизитыОбъекта = МИКО_мвМаршрутизацияЗвонковПовтИсп.РеквизитыОбъекта(ВидОбъекта);
	
	// Выберем реквизиты подходящие по типу.
	Для Каждого Реквизит Из ВсеРеквизитыОбъекта Цикл
		
		Если Не ОтборПоТипу
		 Или ПроверитьСоответствиеТипа(Реквизит.Тип, ТипРеквизита)
		 Или Реквизит.Тип = ТипРеквизита
		 Или Реквизит.Тип.ПривестиЗначение() = ТипРеквизита.ПривестиЗначение() Тогда
		 
		 	СтрокаРеквизита = дзРеквизитыОбъекта.Строки.Добавить();
			ЗаполнитьОписаниеРеквизита(СтрокаРеквизита, Реквизит.Имя, Реквизит.Имя, Реквизит.Тип);
		 
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОтображатьТабличныеЧасти Тогда
	
		Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		
			ВсеРеквизитыТабличнойЧасти = МИКО_мвМаршрутизацияЗвонковПовтИсп.РеквизитыТабличнойЧасти(ВидОбъекта, ТабличнаяЧасть.Имя);
			
			СтрокаТабличнойЧасти = дзРеквизитыОбъекта.Строки.Добавить();
			СтрокаТабличнойЧасти.Представление = ТабличнаяЧасть.Представление();
			СтрокаТабличнойЧасти.Картинка      = БиблиотекаКартинок.ВложеннаяТаблица;
			
			// Выберем реквизиты подходящие по типу.
			Для Каждого Реквизит Из ВсеРеквизитыТабличнойЧасти Цикл
				
				Если Не ОтборПоТипу
				 Или ПроверитьСоответствиеТипа(Реквизит.Тип, ТипРеквизита)
				 Или Реквизит.Тип = ТипРеквизита
				 Или Реквизит.Тип.ПривестиЗначение() = ТипРеквизита.ПривестиЗначение() Тогда
				 
				 	СтрокаРеквизита = СтрокаТабличнойЧасти.Строки.Добавить();
					ЗаполнитьОписаниеРеквизита(СтрокаРеквизита, ТабличнаяЧасть.Имя + "." + Реквизит.Имя, Реквизит.Имя, Реквизит.Тип);
				 
				КонецЕсли;
				
			КонецЦикла;
			
			Если СтрокаТабличнойЧасти.Строки.Количество() = 0 Тогда
				дзРеквизитыОбъекта.Строки.Удалить(СтрокаТабличнойЧасти);
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(дзРеквизитыОбъекта, "РеквизитыОбъекта");
	
КонецПроцедуры // ЗаполнитьРеквизитыОбъектаМетаданных()

&НаСервереБезКонтекста 
Процедура ЗаполнитьОписаниеРеквизита(РеквизитСтрока, Имя, Представление, Тип)
	
	РеквизитСтрока.ИмяРеквизита        = Имя;
	РеквизитСтрока.Представление       = Представление;
	РеквизитСтрока.Тип                 = Тип;
	//РеквизитСтрока.ПолноеИмяРеквизита  = РеквизитМетаданные.ПолноеИмя();
	РеквизитСтрока.ЭтоРеквизит         = Истина;
	РеквизитСтрока.Картинка            = БиблиотекаКартинок.Реквизит;
	
КонецПроцедуры // ЗаполнитьОписаниеРеквизита()

&НаСервереБезКонтекста 
Функция ПроверитьСоответствиеТипа(Знач ОписаниеТипа, Знач ДопустимыеТипы)

	Для каждого Тип Из ДопустимыеТипы.Типы() Цикл
		Если ОписаниеТипа.СодержитТип(Тип) Тогда
			Возврат Истина;
		КонецЕсли; 
	КонецЦикла; 	

	Возврат Ложь;
	
КонецФункции // ПроверитьСоответствиеТипа()

