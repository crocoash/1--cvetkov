// #Область СлужебныеПроцедурыИФункции

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипОбъектов		 = Параметры.ТипОбъектов;
	
	ЗаполнитьОбъектыМетаданных();
	
КонецПроцедуры // ПриСозданииНаСервере()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ОбъектыМетаданныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОповеститьОВыборе(Элементы.ОбъектыМетаданных.ТекущиеДанные.ИмяОбъектаМетаданных);
	
КонецПроцедуры // ОбъектыМетаданныхВыбор()


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ


////////////////////////////////////////////////////////////////////////////////
// ПРОЧЕЕ

Процедура ЗаполнитьОбъектыМетаданных()
	
	ПриоритетныеОбъекты = Новый Массив;
	
	Если ТипОбъектов = "Справочник" Тогда
		КартинкаСтрок = БиблиотекаКартинок.Справочник;
		ГруппаОбъектовМетаданных = Метаданные.Справочники;
	ИначеЕсли ТипОбъектов = "Документ" Тогда
		КартинкаСтрок = БиблиотекаКартинок.Документ;
		ГруппаОбъектовМетаданных = Метаданные.Документы;		
	ИначеЕсли ТипОбъектов = "Регистр сведений" Тогда
		КартинкаСтрок = БиблиотекаКартинок.РегистрСведений;
		ГруппаОбъектовМетаданных = Метаданные.РегистрыСведений;
	КонецЕсли;
	
	Элементы.ОбъектыМетаданныхПредставление.Заголовок = ТипОбъектов;
	Элементы.ОбъектыМетаданных.КартинкаСтрок = КартинкаСтрок;
	
	ОбъектыМетаданныхДЗ = РеквизитФормыВЗначение("ОбъектыМетаданных");
	
	Для Каждого ОбъектМетаданных Из ГруппаОбъектовМетаданных Цикл
		
		НоваяСтрока = ОбъектыМетаданныхДЗ.Строки.Добавить();
		НоваяСтрока.ИмяОбъектаМетаданных = ОбъектМетаданных.Имя;
		НоваяСтрока.Представление = ОбъектМетаданных.Представление();
		НоваяСтрока.ПолноеИмяМетаданных = ОбъектМетаданных.ПолноеИмя();
		НоваяСтрока.Пометка = (ПриоритетныеОбъекты.Найти(ОбъектМетаданных.Имя) <> Неопределено);
		НоваяСтрока.Картинка = КартинкаСтрок;
		
		Если ГруппаОбъектовМетаданных = Метаданные.Справочники Тогда
			
			Для Каждого ОбъектМетаданныхТЧ Из ОбъектМетаданных.ТабличныеЧасти Цикл
				НоваяПодСтрока = НоваяСтрока.Строки.Добавить();
				НоваяПодСтрока.ИмяОбъектаМетаданных = НоваяСтрока.ИмяОбъектаМетаданных + "." + ОбъектМетаданныхТЧ.Имя;
				НоваяПодСтрока.Представление = ОбъектМетаданныхТЧ.Представление();
				НоваяПодСтрока.ПолноеИмяМетаданных = ОбъектМетаданныхТЧ.ПолноеИмя();
				НоваяПодСтрока.Пометка = (ПриоритетныеОбъекты.Найти(ОбъектМетаданныхТЧ.Имя) <> Неопределено);
				НоваяПодСтрока.Картинка = Вычислить("БиблиотекаКартинок.ВложеннаяТаблица");
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбъектыМетаданныхДЗ.Строки.Сортировать("Пометка Убыв, Представление Возр", Истина);
	ЗначениеВРеквизитФормы(ОбъектыМетаданныхДЗ, "ОбъектыМетаданных");
	
КонецПроцедуры // ЗаполнитьОбъектыМетаданных()
// #КонецОбласти